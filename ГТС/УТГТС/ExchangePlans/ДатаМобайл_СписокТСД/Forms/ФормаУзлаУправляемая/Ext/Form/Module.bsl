&НаКлиенте
Функция СформироватьОписание()
	
	ТД=Элементы.ШаблоныШтрихкодов.ТекущиеДанные;
	ТД.Описание = "";	
	
	Если ТД.Префикс<>"" тогда
		ТД.Описание = ТД.Описание + "Префикс "+ТД.Префикс + Символы.ПС;	
	КонецЕсли;
	
	Если ТД.ОбщаяДлина<>0 тогда
		ТД.Описание = ТД.Описание + "Общая длина "+ТД.ОбщаяДлина + Символы.ПС;	
	КонецЕсли;
	
	Если ТД.НачальныйСимволШтрихкода<>0 или ТД.КонечныйСимволШтрихкода<>0 тогда
		ТД.Описание = ТД.Описание + "Штрихкод с "+ТД.НачальныйСимволШтрихкода + " по "+ТД.КонечныйСимволШтрихкода + Символы.ПС;	
	КонецЕсли;
	
	Если ТД.НачальныйСимволКилограмм<>0 или ТД.КонечныйСимволКилограмм<>0 тогда
		ТД.Описание = ТД.Описание + "Килограммы с "+ТД.НачальныйСимволКилограмм + " по "+ТД.КонечныйСимволКилограмм + Символы.ПС;	
	КонецЕсли;
	
	Если ТД.НачальныйСимволГрамм<>0 или ТД.КонечныйСимволГрамм<>0 тогда
		ТД.Описание = ТД.Описание + "Граммы с "+ТД.НачальныйСимволГрамм + " по "+ТД.КонечныйСимволГрамм + Символы.ПС;	
	КонецЕсли;
	
	Если ТД.НачальныйСимволСерийныйНомер<>0 или ТД.КонечныйСимволСерийныйНомер<>0 тогда
		ТД.Описание = ТД.Описание + "Серийный номер с "+ТД.НачальныйСимволСерийныйНомер + " по "+ТД.КонечныйСимволСерийныйНомер + Символы.ПС;	
	КонецЕсли;
	
	Если ТД.НачальныйСимволКоличество<>0 или ТД.КонечныйСимволКоличество<>0 тогда
		ТД.Описание = ТД.Описание + "Количество с "+ТД.НачальныйСимволКоличество + " по "+ТД.КонечныйСимволКоличество + Символы.ПС;	
	КонецЕсли;
	
КонецФункции

