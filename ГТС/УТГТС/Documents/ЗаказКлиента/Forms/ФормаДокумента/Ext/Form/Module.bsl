&НаСервере
Функция ПроверкаСкладскогоЗапаса() Экспорт      
	//++ASP_Crow 11.03.2026 000029567 в расширение
	Товары = Объект.Товары.Выгрузить();
	СкладТалдом = Справочники.Склады.НайтиПоНаименованию("Склад временного хранения г.ТАЛДОМ", Истина);
	СкладПодольск = Справочники.Склады.НайтиПоНаименованию("Склад Подольск", Истина);
	ЛегкиеСтеллажи = Справочники.ГруппыАналитическогоУчетаНоменклатуры.НайтиПоНаименованию("Легкие стеллажи", Истина);
	ТяжелыеСтеллажи = Справочники.ГруппыАналитическогоУчетаНоменклатуры.НайтиПоНаименованию("Тяжелые стеллажи", Истина);

	ЕстьОтгрузка = Ложь;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		Если СтрокаТоваров.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить 
			ИЛИ СтрокаТоваров.КОтгрузкеСкладом = Истина Тогда
			ЕстьОтгрузка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество
	|ПОМЕСТИТЬ ТоварыДокумента
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварыДокумента.Номенклатура КАК Номенклатура,
	|	СУММА(ТоварыДокумента.Количество) КАК Количество,
	|	НоменклатураСправочник.ГруппаАналитическогоУчета КАК ГруппаАналитическогоУчета,
	|	НоменклатураСправочник.ASP_РазрешеноОтгружатьВышеЛимита КАК РазрешенаОтгрузкаСвышеЛимита
	|ПОМЕСТИТЬ СуммированиеНоменклатуры
	|ИЗ
	|	ТоварыДокумента КАК ТоварыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочник
	|		ПО ТоварыДокумента.Номенклатура = НоменклатураСправочник.Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ТоварыДокумента.Номенклатура,
	|	НоменклатураСправочник.ГруппаАналитическогоУчета,
	|	НоменклатураСправочник.ASP_РазрешеноОтгружатьВышеЛимита
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СуммированиеНоменклатуры.Номенклатура КАК НоменклатураПоЗаказу,
	|	СуммированиеНоменклатуры.Количество КАК Количество,
	|	СуммированиеНоменклатуры.РазрешенаОтгрузкаСвышеЛимита КАК РазрешенаОтгрузкаСвышеЛимита,
	|	ЕСТЬNULL(ОграниченияТалдом.МинимальноеКоличествоЗапаса, 0) КАК МинимальноеКоличествоЗапаса,
	|	ЕСТЬNULL(ОграниченияПодольск.МинимальноеКоличествоЗапаса, 0) КАК МинимальноеКоличествоЗапасаПодольск
	|ИЗ
	|	СуммированиеНоменклатуры КАК СуммированиеНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварныеОграничения КАК ОграниченияТалдом
	|		ПО СуммированиеНоменклатуры.Номенклатура = ОграниченияТалдом.Номенклатура
	|			И ОграниченияТалдом.Склад = &СкладТалдом
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварныеОграничения КАК ОграниченияПодольск
	|		ПО СуммированиеНоменклатуры.Номенклатура = ОграниченияПодольск.Номенклатура
	|			И ОграниченияПодольск.Склад = &СкладПодольск
	|ГДЕ
	|	СуммированиеНоменклатуры.ГруппаАналитическогоУчета В ИЕРАРХИИ (&ЛегкиеСтеллажи)
	|	ИЛИ СуммированиеНоменклатуры.ГруппаАналитическогоУчета В ИЕРАРХИИ (&ТяжелыеСтеллажи)";

	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("СкладТалдом", СкладТалдом);
	Запрос.УстановитьПараметр("СкладПодольск", СкладПодольск);
	Запрос.УстановитьПараметр("ЛегкиеСтеллажи", ЛегкиеСтеллажи);
	Запрос.УстановитьПараметр("ТяжелыеСтеллажи", ТяжелыеСтеллажи);

	ВышеЛимита = Ложь;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		Если Объект.Склад = СкладПодольск
			И Выборка.МинимальноеКоличествоЗапасаПодольск > 0
			И Выборка.Количество > Выборка.МинимальноеКоличествоЗапасаПодольск * 0.25
			И Не Выборка.РазрешенаОтгрузкаСвышеЛимита Тогда
			Сообщить("Позиция " + Выборка.НоменклатураПоЗаказу + " превышает 25% от складской программы Подольска, закажите перемещение из Талдома");
		КонецЕсли;

		Если Выборка.МинимальноеКоличествоЗапаса > 0
			И Выборка.Количество > Выборка.МинимальноеКоличествоЗапаса * 0.25
			И Не Выборка.РазрешенаОтгрузкаСвышеЛимита Тогда
			Сообщить("Позиция " + Выборка.НоменклатураПоЗаказу + " превышает лимит отгрузки, этот заказ потребует оформления заказа поставщику");
			ВышеЛимита = Истина;
		ИначеЕсли Выборка.МинимальноеКоличествоЗапаса = 0 Тогда
			Сообщить("Позиция " + Выборка.НоменклатураПоЗаказу + " не входит в складскую программу, этот заказ потребует оформления заказа поставщику");
		КонецЕсли;

	КонецЦикла;

	Возврат Не Объект.РазрешениеРезервирования
		И Не ЗначениеЗаполнено(Объект.НомерЦикла)
		И ВышеЛимита
		И ЕстьОтгрузка;
КонецФункции	



&НаСервере
Функция ПроверкаСпособДоставки() Экспорт 
	//++ASP_Crow 11.03.2026 000029567 в расширение

	ЕстьОтгрузка = Ложь;
	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		Если СтрокаТоваров.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить 
			ИЛИ СтрокаТоваров.КОтгрузкеСкладом = ИСТИНА Тогда
			ЕстьОтгрузка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если Не ЕстьОтгрузка Или Объект.Дата <= '20210317' Тогда
		Возврат Ложь;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаявкаНаТранспорт.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаявкаНаТранспорт КАК ЗаявкаНаТранспорт
	|ГДЕ
	|	ЗаявкаНаТранспорт.ДокументОснование = &ДокументОснование
	|	И НЕ ЗаявкаНаТранспорт.ПометкаУдаления";
	Запрос.УстановитьПараметр("ДокументОснование", Объект.Ссылка);

	Если Не Запрос.Выполнить().Пустой() Тогда
		Если Не ЗначениеЗаполнено(Объект.СпособДоставки) Тогда
			Объект.СпособДоставки = Перечисления.СпособыДоставки.ДоКлиента;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	Возврат Объект.СпособДоставки <> Перечисления.СпособыДоставки.Самовывоз;
КонецФункции	

&НаСервере
Функция ПроверкаИзмененияРезерва()  Экспорт 
	//++ASP_Crow 11.03.2026 000029567 в расширение
	Если Не (Объект.КонтрольРезерва Или Объект.ЗапретРезервирования)
		Или РольДоступна("ASP_ОтметкаСклада")
		Или РольДоступна("ASP_НеограниченныйСрокРезервирования")
		Или РольДоступна("ПолныеПрава") Тогда
		Возврат Ложь;
	КонецЕсли;

	Товары = Объект.Товары.Выгрузить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество
	|ПОМЕСТИТЬ СтарыйРезерв
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Заказ
	|	И ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.ВариантОбеспечения КАК ВариантОбеспечения,
	|	СУММА(Товары.Количество) КАК Количество
	|ПОМЕСТИТЬ НовыйРезерв
	|ИЗ
	|	&Товары КАК Товары
	|ГДЕ
	|	Товары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
	|	ИЛИ Товары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура,
	|	Товары.ВариантОбеспечения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(СтарыйРезерв.Номенклатура, НовыйРезерв.Номенклатура) КАК Номенклатура,
	|	ЕСТЬNULL(СтарыйРезерв.Количество, 0) КАК КоличествоСтарое,
	|	ЕСТЬNULL(НовыйРезерв.Количество, 0) КАК КоличествоНовое,
	|	НовыйРезерв.ВариантОбеспечения КАК ВариантОбеспеченияНовый,
	|	ВЫБОР
	|		КОГДА СтарыйРезерв.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьСтарыйРезерв,
	|	ВЫБОР
	|		КОГДА НовыйРезерв.Номенклатура ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьНовыйРезерв
	|ИЗ
	|	НовыйРезерв КАК НовыйРезерв
	|		ПОЛНОЕ СОЕДИНЕНИЕ СтарыйРезерв КАК СтарыйРезерв
	|		ПО НовыйРезерв.Номенклатура = СтарыйРезерв.Номенклатура";

	Запрос.УстановитьПараметр("Заказ", Объект.Ссылка);
	Запрос.УстановитьПараметр("Товары", Товары);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл

		// Удаление ранее существовавшего резерва эквивалентно уменьшению до нуля.
		Если Выборка.ЕстьСтарыйРезерв И Не Выборка.ЕстьНовыйРезерв Тогда
			Возврат Истина;
		КонецЕсли;

		// Новая строка с вариантом "Со склада" создаёт новый резерв.
		Если Не Выборка.ЕстьСтарыйРезерв И Выборка.ЕстьНовыйРезерв Тогда
			Если Выборка.ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.СоСклада Тогда
				Возврат Истина;
		КонецЕсли;
			Продолжить;
		КонецЕсли;

		Если Выборка.КоличествоСтарое > Выборка.КоличествоНовое Тогда
			Возврат Истина;
		КонецЕсли;

		Если Выборка.ВариантОбеспеченияНовый = Перечисления.ВариантыОбеспечения.СоСклада
			И Выборка.КоличествоСтарое <> Выборка.КоличествоНовое Тогда
			Возврат Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ложь;
КонецФункции

&НаСервере
Функция ПроверкаЦеновойКолонки(ПараметрыЗаписи)  Экспорт  
	//++ASP_Crow 11.03.2026 000029567 в расширение

	ДатаПроверки = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());

	Если Объект.РазрешенаЦенаНижеКолонки
		Или ПараметрыЗаписи.РежимЗаписи <> РежимЗаписиДокумента.Проведение
		Или ДатаПроверки <= '20210504'
		Или РольДоступна("ASP_ОтметкаСклада")
		Или РольДоступна("ASP_НеограниченныйСрокРезервирования")
		Или РольДоступна("ПолныеПрава")
		Или Объект.Соглашение.ASP_Одобрено Тогда
		Возврат Ложь;
	КонецЕсли;

	Товары = Объект.Товары.Выгрузить();
	ТоварыДляПроверки = ПолучитьТоварыДляПроверкиЦеновойКолонки(Товары);
	Если ТоварыДляПроверки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ПродажаОблагаетсяНДС = Объект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;
	ВидОсновнойЦены = ?(ПродажаОблагаетсяНДС,
		Справочники.ВидыЦен.МаксСкидка,
		Справочники.ВидыЦен.НайтиПоНаименованию("Цена СНГ", Истина));
	ВидЦеныДилерскаяCNY = Справочники.ВидыЦен.НайтиПоНаименованию("Дилерская в CNY", Истина);
	ВидЦеныСпецCNY = Справочники.ВидыЦен.НайтиПоНаименованию("Спеццена в CNY", Истина);
	ВидЦеныСпец2CNY = Справочники.ВидыЦен.НайтиПоНаименованию("Спеццена 2 в CNY", Истина);

	ВидыЦен = Новый Массив;
	ВидыЦен.Добавить(ВидОсновнойЦены);
	ВидыЦен.Добавить(ВидЦеныДилерскаяCNY);
	ВидыЦен.Добавить(ВидЦеныСпецCNY);
	ВидыЦен.Добавить(ВидЦеныСпец2CNY);

	ТаблицаЦен = ПолучитьЦеныДляПроверкиЦеновойКолонки(ТоварыДляПроверки, ДатаПроверки, ВидыЦен);
	ТаблицаЦен.Индексы.Добавить("Номенклатура, ВидЦены");

	ТекущийПользователь = Пользователи.ТекущийПользователь();
	ПодразделениеПользователя = ЗначениеНастроекПовтИсп.ПодразделениеПользователя(ТекущийПользователь);
	ИспользоватьСпеццену2 = ЭтоДилерскийОтделИлиОтделСПБ(ПодразделениеПользователя);

	КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.Валюта, ДатаПроверки);
	Если КурсВалюты.Кратность = 0 Тогда
		МножительКурсаДокумента = 0;
	Иначе
		МножительКурсаДокумента = КурсВалюты.Курс / КурсВалюты.Кратность;
	КонецЕсли;

	Ошибка = Ложь;
	Для Каждого СтрокаТоваров Из ТоварыДляПроверки Цикл

		Если СтрокаТоваров.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;

		Если Объект.Соглашение.Типовое Тогда
			ЦенаПоСчету = (СтрокаТоваров.СуммаСНДС + СтрокаТоваров.СуммаАвтоматическойСкидки)
				/ СтрокаТоваров.Количество * МножительКурсаДокумента;
		Иначе
			ЦенаПоСчету = СтрокаТоваров.СуммаСНДС
				/ СтрокаТоваров.Количество * МножительКурсаДокумента;
		КонецЕсли;

		Цена = Макс(
			ЦенаПоВидуЦены(ТаблицаЦен, СтрокаТоваров.Номенклатура, ВидОсновнойЦены),
			ЦенаПоВидуЦены(ТаблицаЦен, СтрокаТоваров.Номенклатура, ВидЦеныДилерскаяCNY));

		СпециальнаяЦена = ЦенаПоВидуЦены(ТаблицаЦен, СтрокаТоваров.Номенклатура, ВидЦеныСпецCNY, Истина);
		Если СпециальнаяЦена > 0 И Цена <> 0 И СпециальнаяЦена < Цена Тогда
			Цена = СпециальнаяЦена;
		КонецЕсли;

		Если ИспользоватьСпеццену2 Тогда
			СпециальнаяЦена = ЦенаПоВидуЦены(ТаблицаЦен, СтрокаТоваров.Номенклатура, ВидЦеныСпец2CNY, Истина);
			Если СпециальнаяЦена > 0 И Цена <> 0 И СпециальнаяЦена < Цена Тогда
				Цена = СпециальнаяЦена;
			КонецЕсли;
		КонецЕсли;

		Если АльтерЛого.РасчитатьЦенуПоКомплекту(СтрокаТоваров.Номенклатура) Тогда
			Коэффициент = КоэффициентНаценки(СтрокаТоваров.Номенклатура);
			ЦенаРасчет = АльтерЛого.ЦенаНоменклатурыПоКомплекту(
				СтрокаТоваров.Номенклатура,
				ДатаПроверки,
				ВидОсновнойЦены,
				Цена,
				Коэффициент);
			Если Цена < ЦенаРасчет Тогда
				Цена = ЦенаРасчет;
			КонецЕсли;
		КонецЕсли;

		Если ЦенаПоСчету < Цена - Цена * 0.01 Тогда
			Сообщить("Итоговая цена со скидкой на " + СтрокаТоваров.Номенклатура
				+ " ниже минимальной на "
				+ Строка(Цена - СтрокаТоваров.СуммаСНДС / СтрокаТоваров.Количество));
			Ошибка = Истина;
		КонецЕсли;

	КонецЦикла;

	Возврат Ошибка;
КонецФункции

&НаСервере
Функция ПолучитьТоварыДляПроверкиЦеновойКолонки(Товары)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Номенклатура КАК Номенклатура,
	|	Товары.Количество КАК Количество,
	|	Товары.СуммаСНДС КАК СуммаСНДС,
	|	Товары.СуммаАвтоматическойСкидки КАК СуммаАвтоматическойСкидки
	|ПОМЕСТИТЬ ТоварыДокумента
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(Товары.Количество) КАК Количество,
	|	СУММА(Товары.СуммаСНДС) КАК СуммаСНДС,
	|	СУММА(Товары.СуммаАвтоматическойСкидки) КАК СуммаАвтоматическойСкидки
	|ИЗ
	|	ТоварыДокумента КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК НоменклатураСправочник
	|		ПО Товары.Номенклатура = НоменклатураСправочник.Ссылка
	|ГДЕ
	|	НоменклатураСправочник.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|СГРУППИРОВАТЬ ПО
	|	Товары.Номенклатура";
	Запрос.УстановитьПараметр("Товары", Товары);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция ПолучитьЦеныДляПроверкиЦеновойКолонки(Товары, ДатаПроверки, ВидыЦен)
 
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Товары.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ НоменклатураЗаказа
	|ИЗ
	|	&Товары КАК Товары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатуры.ВидЦены КАК ВидЦены,
	|	ЕСТЬNULL(ЦеныНоменклатуры.Цена, 0) *
	|		ВЫБОР
	|			КОГДА КурсыВалют.Валюта ЕСТЬ NULL
	|				ТОГДА 1
	|			КОГДА ЕСТЬNULL(КурсыВалют.Кратность, 0) = 0
	|				ТОГДА 0
	|			ИНАЧЕ КурсыВалют.Курс / КурсыВалют.Кратность
	|		КОНЕЦ КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаПроверки, ВидЦены В (&ВидыЦен)) КАК ЦеныНоменклатуры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НоменклатураЗаказа КАК НоменклатураЗаказа
	|		ПО ЦеныНоменклатуры.Номенклатура = НоменклатураЗаказа.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&ДатаПроверки, ) КАК КурсыВалют
	|		ПО ЦеныНоменклатуры.Валюта = КурсыВалют.Валюта";

	Запрос.УстановитьПараметр("Товары", Товары);
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	Запрос.УстановитьПараметр("ВидыЦен", ВидыЦен);

	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

&НаСервере
Функция ЦенаПоВидуЦены(ТаблицаЦен, Номенклатура, ВидЦены, МинимальнаяПоложительная = Ложь)

	СтрокиЦен = ТаблицаЦен.НайтиСтроки(Новый Структура(
		"Номенклатура, ВидЦены",
		Номенклатура,
		ВидЦены));

	Результат = 0;
	Для Каждого СтрокаЦены Из СтрокиЦен Цикл
		Если МинимальнаяПоложительная Тогда
			Если СтрокаЦены.Цена > 0 И (Результат = 0 Или СтрокаЦены.Цена < Результат) Тогда
				Результат = СтрокаЦены.Цена;
			КонецЕсли;
		ИначеЕсли СтрокаЦены.Цена > Результат Тогда
			Результат = СтрокаЦены.Цена;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

