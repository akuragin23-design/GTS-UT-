&НаСервере
Процедура ПродлитьРезервНаСервере(ДатаРезерва = Неопределено)  
	//++ASP_Crow 11.03.2026 000029567 в расширение
	ПравоПродления = (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава"));
	
	//Получаем 5 дней	
		ТекДатаОкончания = РегистрыСведений.СрокиРезервирования.Получить(Новый Структура("ЗаказКлиента", Объект.Ссылка)).ОкончаниеРезервирования;
		ТекПродлений = РегистрыСведений.СрокиРезервирования.Получить(Новый Структура("ЗаказКлиента", Объект.Ссылка)).Продлено;
		ТекНачальнаяДатаРезерва=РегистрыСведений.СрокиРезервирования.Получить(Новый Структура("ЗаказКлиента", Объект.Ссылка)).НачальнаяДатаРезерва;
		ТекДнейМакс=РегистрыСведений.СрокиРезервирования.Получить(Новый Структура("ЗаказКлиента", Объект.Ссылка)).ДнейМакс;
		ТекСуммаНачислено=РегистрыСведений.СрокиРезервирования.Получить(Новый Структура("ЗаказКлиента", Объект.Ссылка)).СуммаНачислено;

		Запрос1 = Новый Запрос;
		Запрос1.Текст = "ВЫБРАТЬ ПЕРВЫЕ 5
		                |	КалендарныеГрафики.Календарь КАК Календарь,
		                |	КалендарныеГрафики.Год КАК Год,
		                |	КалендарныеГрафики.ДатаГрафика КАК ДатаГрафика,
		                |	КалендарныеГрафики.ДеньВключенВГрафик КАК ДеньВключенВГрафик,
		                |	КалендарныеГрафики.КоличествоДнейВГрафикеСНачалаГода КАК КоличествоДнейВГрафикеСНачалаГода
		                |ИЗ
		                |	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
		                |ГДЕ
		                |	КалендарныеГрафики.ДеньВключенВГрафик
		                |	И КалендарныеГрафики.ДатаГрафика > &ДатаГрафика";
		Запрос1.УстановитьПараметр("ДатаГрафика",МАКС(ТекущаяДата(),ТекДатаОкончания));
		РабочиеДни = Запрос1.Выполнить().Выгрузить();
		СНачалаДня = ТекущаяДата()-НачалоДня(ТекущаяДата());
		Если СНачалаДня<39600 И конецдня(ТекДатаОкончания)<ТекущаяДата() Тогда
		ДатаКалендаря=ТекущаяДата();
		Иначе
		ДатаКалендаря=НачалоДня(РабочиеДни[0].ДатаГрафика);
		КонецЕсли;
		ДатаРезервирования = Макс(ДатаКалендаря,ТекДатаОкончания);			
		Продлений = Макс(1,ТекПродлений+1);
		Если (ПравоПродления=Истина или Продлений <= 2) И ДатаРезерва=неопределено Тогда
		МЗ = РегистрыСведений.СрокиРезервирования.СоздатьМенеджерЗаписи();
		МЗ.ЗаказКлиента = Объект.Ссылка;
		МЗ.ОкончаниеРезервирования = ДатаРезервирования; 
		МЗ.Продлено = Продлений;
		МЗ.ПоследняяДатаРезерва=ТекущаяДата();
		МЗ.НачальнаяДатаРезерва=?(ЗначениеЗаполнено(ТекНачальнаяДатаРезерва),ТекНачальнаяДатаРезерва,ТекущаяДата());
		МЗ.ДнейМакс=?(ЗначениеЗаполнено(ТекДнейМакс),ТекДнейМакс,0);
		МЗ.СуммаНачислено=?(ЗначениеЗаполнено(ТекСуммаНачислено),ТекСуммаНачислено,0);
		МЗ.Записать(Истина);
		Сообщить("Срок резервирования установлен до " + Формат(ДатаРезервирования, "ДЛФ=Д") + " включительно");
		Объект.Комментарий=Объект.Комментарий + Символы.ПС + ТекущаяДата() + " Продлен резерв на 1 день "+ ПользователиКлиентСервер.ТекущийПользователь();
					Запрос2 = Новый Запрос;
					Запрос2.Текст = 
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	ЗаказКлиентаЭтапыГрафикаОплаты.ДатаПлатежа КАК ДатаПлатежа,
					|	ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка КАК Ссылка,
					|	ЗаказКлиентаЭтапыГрафикаОплаты.НомерСтроки КАК НомерСтроки
					|ИЗ
					|	Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК ЗаказКлиентаЭтапыГрафикаОплаты
					|ГДЕ
					|	ЗаказКлиентаЭтапыГрафикаОплаты.ДатаПлатежа <= &ДатаПлатежа
					|	И ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка = &Ссылка
					|
					|УПОРЯДОЧИТЬ ПО
					|	ДатаПлатежа";
					Запрос2.УстановитьПараметр("ДатаПлатежа",ДатаРезервирования);
					Запрос2.УстановитьПараметр("Ссылка",Объект.Ссылка);
					РезультатЗапроса2 = Запрос2.Выполнить();
					
					ВыборкаДетальныеЗаписи2 = РезультатЗапроса2.Выбрать();
					
					Пока ВыборкаДетальныеЗаписи2.Следующий() Цикл
						Объект.ЭтапыГрафикаОплаты[ВыборкаДетальныеЗаписи2.НомерСтроки-1].ДатаПлатежа = ДатаРезервирования; 
					КонецЦикла;

		ИначеЕсли ЗначениеЗаполнено(ДатаРезерва) и ПравоПродления=Истина Тогда
		МЗ = РегистрыСведений.СрокиРезервирования.СоздатьМенеджерЗаписи();
