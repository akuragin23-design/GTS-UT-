Процедура ЗаполнитьДокументНаСервере(СтарыйЗаказ)  
	//++ASP_Crow 11.03.2026 000029567 в расширение
	ТаблицаТоваров = СтарыйЗаказ.Товары.Выгрузить();
	
	
	//ОперацииПередачи = ПродажиСервер.ОперацииПередачиТоваров();
	//
	//Если ОперацииПередачи.Найти(Объект.ХозяйственнаяОперация) <> Неопределено Тогда
	//	ПараметрыОтбора = Новый Структура();
	//	ПараметрыОтбора.Вставить("ОтборПоТипуНоменклатуры",НоменклатураКлиентСервер.ОтборПоТоваруМногооборотнойТаре());
	//	ТаблицаТоваров = КопированиеСтрокСервер.ПолучитьСтрокиИзБуфераОбмена(ПараметрыОтбора);
	//Иначе
	//	ТаблицаТоваров = КопированиеСтрокСервер.ПолучитьСтрокиИзБуфераОбмена();
	//КонецЕсли;
	МаксимальнаяТекущаяСтрока=Объект.Товары.Количество();
	
	Для каждого СтрокаТовара Из ТаблицаТоваров Цикл
		
		ТекущаяСтрока = Объект.Товары.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара);
		МаксимальнаяТекущаяСтрока=МаксимальнаяТекущаяСтрока+1;
		ТекущаяСтрока.КодСтроки=0;
		ТекущаяСтрока.ИндексНабора = ?(ЗначениеЗаполнено(ТекущаяСтрока.НоменклатураНабора), 1, 0);
		Если НЕ ИспользоватьРучныеСкидкиВПродажах Тогда
			ТекущаяСтрока.ПроцентРучнойСкидки = 0;
			ТекущаяСтрока.СуммаРучнойСкидки = 0;
		КонецЕсли;
		
		Если Объект.НеОтгружатьЧастями Тогда
			ТекущаяСтрока.ДатаОтгрузки = Объект.ДатаОтгрузки;
		КонецЕсли;
		
		СтруктураДействий = Новый Структура;
		СтруктураДействий.Вставить("ЗаполнитьПризнакТипНоменклатуры", Новый Структура("Номенклатура", "ТипНоменклатуры"));
		СтруктураДействий.Вставить("ЗаполнитьПризнакАртикул", Новый Структура("Номенклатура", "Артикул"));
		СтруктураДействий.Вставить("ПроверитьЗаполнитьСклад", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСкладаВСтрокеТЧ(Объект, СкладГруппа));
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата, ПоДатеОтгрузки, Организация", Объект.НалогообложениеНДС, Объект.Дата, Истина, Объект.Организация));
		СтруктураДействий.Вставить("ЗаполнитьСтавкуНДСВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ЗаполнитьПризнакБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ЗаполнитьПризнакОтмененоБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
		СтруктураДействий.Вставить("ЗаполнитьСодержание", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСодержанияУслугиВСтрокеТЧ(Объект, Ложь));
		ПараметрыДействия = ОбеспечениеКлиентСервер.ПараметрыДействияПроверитьЗаполнитьОбеспечение(ВариантОбеспеченияИФлагОбособленно);
		ПараметрыДействия.Вставить("Форма", ЭтаФорма);
		ПараметрыДействия.Вставить("ПараметрыВстраивания", ЭтаФорма.ДоступныеОстаткиПараметрыВстраивания);
		ПараметрыДействия.Вставить("ВариантОбеспеченияИФлагОбособленно", Неопределено);

		СтруктураДействий.Вставить("ПроверитьЗаполнитьОбеспечениеВДокументеПродажи", ПараметрыДействия);
		СтруктураДействий.Вставить("ПоместитьОбработанныеСтрокиВКэшированныеЗначения");
		СтруктураДействий.Вставить("ПриИзмененииТипаНоменклатурыИлиВариантаОбеспечения",
		Новый Структура("ЕстьРаботы, ЕстьОтменено, ПараметрыВстраивания, Форма", Истина, Истина, ЭтаФорма.ДоступныеОстаткиПараметрыВстраивания, ЭтаФорма));
		ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий,Объект);
		
		КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(ТекущаяСтрока, СтруктураДействий, КэшированныеЗначения);
		
	КонецЦикла;
	ОбеспечениеСервер.РассчитатьДатуОтгрузкиВСтрокахТабличнойЧасти(КэшированныеЗначения.ОбработанныеСтроки, Объект, Объект.Товары);
	
	ЗаполнитьСлужебныеРеквизитыПоНоменклатуре();
	
	НоменклатураСервер.ЗаполнитьСтатусыУказанияСерий(Объект, ПараметрыУказанияСерий);
	
	ПриИзмененииДатыОтгрузкиВТабЧасти();
	СкладыСервер.ПриИзмененииСкладаВТабличнойЧасти(Объект.Товары, ТаблицаСкладов, СкладГруппа);
	ВсегоСкладов = ТаблицаСкладов.Количество();
	СкладыКлиентСервер.ОбновитьКартинкуГруппыСкладов(НадписьНесколькоСкладов, Элементы.КартинкаНесколькоСкладов, ВсегоСкладов);
	
	РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
	МногооборотнаяТараСервер.ОбновитьСостояниеЗаполненияМногооборотнойТары(Объект.СостояниеЗаполненияМногооборотнойТары);
	
	//ГТС снимаем параметр рассчитанности скидок и считаем вес
	Объект.СкидкиРассчитаны=Ложь;
	Товары1=Объект.Товары;
	ASP_ТоварыВес = ОпределитьВесТовара(Товары1);
	//ГТС
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДатыОтгрузкиВТабЧасти()   
	//++ASP_Crow 11.03.2026 000029567 в расширение
	
	Если Объект.НеОтгружатьЧастями Тогда
		МаксимальнаяДата = ОбеспечениеСервер.МаксимальноеЗначениеВКоллекции(Объект.Товары, "ДатаОтгрузки", '00010101');
		Объект.ДатаОтгрузки = ?(ЗначениеЗаполнено(МаксимальнаяДата), МаксимальнаяДата, Объект.ДатаОтгрузки);
		ОбеспечениеСервер.ЗаполнитьРеквизитВКоллекции(Объект.Товары, "ДатаОтгрузки", Объект.ДатаОтгрузки);
	КонецЕсли;
КонецПроцедуры	
		

//ГТС выполняем проверку на обеспечение обособленно перекупной продукции для дилерского отдела
&НаСервере
Функция ВыполнитьПроверкуПередЗаписьюГТС(Отказ,ТекущийОбъект)  
	//++ASP_Crow 11.03.2026 000029567 в расширение
	Если Отказ=Ложь Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	СтруктураПредприятия.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
				|ГДЕ
				|	СтруктураПредприятия.Наименование = ""Отдел дилерских продаж""";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаПодразделения = РезультатЗапроса.Выбрать();

			
			Если ВыборкаПодразделения.Следующий() И  ПользователиКлиентСервер.ТекущийПользователь().Подразделение=ВыборкаПодразделения.Ссылка Тогда 			
				
			//Генерим массив перекупки
				НоменклатураПерекупки = Новый Массив;
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0-000009691"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0--00008217"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0--00008461"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0-000000941"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0-000000004"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0-000000408"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0-000008752"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0--00019516"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0-000000434"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0--00023129"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0--00023614"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0--00019518"));
				НоменклатураПерекупки.Добавить(Справочники.Номенклатура.НайтиПоКоду("0--00023011"));	
				
			//Проверяем что заказ оплачен
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	СостоянияЗаказовКлиентов.ПроцентОплаты КАК ПроцентОплаты,
			|	СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты,
			|	СостоянияЗаказовКлиентов.СуммаОтгрузки КАК СуммаОтгрузки
			|ИЗ
			|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
			|ГДЕ
			|	СостоянияЗаказовКлиентов.Заказ = &Заказ";
			
			Запрос.УстановитьПараметр("Заказ", Объект.ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				//предоплачен или стоит галка на отгрузку - всё хорошо
			Если ВыборкаДетальныеЗаписи.ПроцентОплаты > 99 или  ТекущийОбъект.ЗакупкаПерекупнойПродукцииРазрешена =Истина тогда
			Возврат Отказ;
			КонецЕсли;
		    КонецЦикла;
		
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТЧ.Номенклатура КАК Номенклатура,
					|	ТЧ.ВариантОбеспечения КАК ВариантОбеспечения,
					|	ТЧ.Обособленно КАК Обособленно
					|ПОМЕСТИТЬ ТЧ
					|ИЗ
					|	&ТЧ КАК ТЧ
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ТЧ.Номенклатура КАК Номенклатура,
					|	ТЧ.ВариантОбеспечения КАК ВариантОбеспечения,
					|	ТЧ.Обособленно КАК Обособленно
					|ИЗ
					|	ТЧ КАК ТЧ
					|ГДЕ
					|	ТЧ.Номенклатура В ИЕРАРХИИ(&НоменклатураПерекупки)
					|	И ТЧ.ВариантОбеспечения = ЗНАЧЕНИЕ(перечисление.ВариантыОбеспечения.КОбеспечению)
					|	И ТЧ.Обособленно = ИСТИНА
					|
					|СГРУППИРОВАТЬ ПО
					|	ТЧ.Номенклатура,
					|	ТЧ.ВариантОбеспечения,
					|	ТЧ.Обособленно";
					
					Запрос.УстановитьПараметр("НоменклатураПерекупки", НоменклатураПерекупки);
					Запрос.УстановитьПараметр("ТЧ", Текущийобъект.Товары);
										
					РезультатЗапроса = Запрос.Выполнить();
					
					ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
					
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							Отказ=Истина;
							Ошибка="Ошибка. По данному заказу не найдена оплата или не установлена галка для обособленного обеспечения перекупной продукции. Обратитесь к начальнику отдела или ассистенту за информацией и разрешением";
					КонецЦикла;
	 		
				
				Если отказ=истина тогда
					сообщить (Ошибка);
				Конецесли;
			конецесли;
		конецесли;
	  Возврат отказ;
КонецФункции


