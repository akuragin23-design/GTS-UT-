&НаСервере
Функция СписокТиповДокументовНавигационнойСсылки()  
	//++ASP_Crow 11.03.2026 000029567 в расширение
	
	СписокДокументов = Новый СписокЗначений;
	
	Если Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.РеализацияКлиенту Тогда
		СписокДокументов.Добавить(Тип("ДокументСсылка.АктВыполненныхРабот"));
		СписокДокументов.Добавить(Тип("ДокументСсылка.РеализацияТоваровУслуг"));
		Если Объект.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоЗаказам 
			И (Объект.ФормаОплаты = Перечисления.ФормыОплаты.Наличная 
				ИЛИ Объект.ФормаОплаты = Перечисления.ФормыОплаты.ПустаяСсылка()) Тогда
			СписокДокументов.Добавить(Тип("ДокументСсылка.ПриходныйКассовыйОрдер"));
		КонецЕсли;
		
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаХранениеСПравомПродажи Тогда
		СписокДокументов.Добавить(Тип("ДокументСсылка.ПередачаТоваровХранителю"));
		
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОтгрузкаПринятыхСПравомПродажиТоваровСХранения Тогда
		СписокДокументов.Добавить(Тип("ДокументСсылка.ОтгрузкаТоваровСХранения"));
		
	ИначеЕсли Объект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПередачаНаКомиссию 
		И КомиссионныеПродажи25 Тогда
		СписокДокументов.Добавить(Тип("ДокументСсылка.ПередачаТоваровХранителю"));
		
	КонецЕсли; 
	
	Возврат СписокДокументов;
	
КонецФункции
