&НаСервере
Функция ASP_РаспределитьПоЗаказамПоставщикуНаСервере(СтрокиТоваров)
	//++ASP_Crow 11.03.2026 000029567 в расширение
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатуры.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Для каждого Строка из СтрокиТоваров Цикл
		стр = ТаблицаНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(стр, Объект.Товары[Строка]);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =                                  
		"ВЫБРАТЬ
		|	ВыбраннаяНоменклатура.Номенклатура КАК Номенклатура,
		|	ВыбраннаяНоменклатура.Количество КАК Количество
		|ПОМЕСТИТЬ втНоменклатура
		|ИЗ
		|	&ВыбраннаяНоменклатура КАК ВыбраннаяНоменклатура
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказПоставщикуТовары.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|ГДЕ
		|	ЗаказПоставщикуТовары.Номенклатура В
		|			(ВЫБРАТЬ
		|				тч.Номенклатура
		|			ИЗ
		|				втНоменклатура КАК тч)
		|	И ЗаказПоставщикуТовары.Ссылка.Статус <> &Статус
		|	И ЗаказПоставщикуТовары.Назначение = &Заказ
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказПоставщикуТовары.Ссылка";
	
	Запрос.УстановитьПараметр("Заказ", Справочники.Назначения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВыбраннаяНоменклатура", ТаблицаНоменклатуры);
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказовПоставщикам.Закрыт);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
   	СтрукутраВозврата = Новый Структура;
	СтрукутраВозврата.Вставить("Ссылки", РезультатЗапроса.ВыгрузитьКолонку("Ссылка"));
	СтрукутраВозврата.Вставить("Товары", ТаблицаНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	ВОзврат СтрукутраВозврата;
КонецФункции

&НаКлиенте
Процедура ASP_РаспределитьПоЗаказамПоставщику(Команда)  
	//++ASP_Crow 11.03.2026 000029567 в расширение
	СтрокиТоваров = Элементы.Товары.ВыделенныеСтроки;
	МассивЗаказовПоставщику = ASP_РаспределитьПоЗаказамПоставщикуНаСервере(СтрокиТоваров);
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Ссылка", МассивЗаказовПоставщику.Ссылки);
	ПараметрыОтбораТовары = Новый Структура("Номенклатура", МассивЗаказовПоставщику.Товары);
	ПараметрыОтбора.Вставить("Товары", ПараметрыОтбораТовары);
	ПараметрыОткрытия = Новый Структура("Отбор, МножественныйВыбор, РежимВыбора", ПараметрыОтбора, Ложь, Истина);
	ОбработкаВыбораОповещение = Новый ОписаниеОповещения("ПриЗакрытииФормыВыборазаказаПоставщику", ЭтотОбъект, СтрокиТоваров);
	ОткрытьФорму("Документ.ЗаказПоставщику.ФормаВыбора", ПараметрыОткрытия, ЭтотОбъект, , , , ОбработкаВыбораОповещение);
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытииФормыВыборазаказаПоставщику(Значение, ДопПараметры) Экспорт   
	//++ASP_Crow 11.03.2026 000029567 в расширение
    Если Значение = Неопределено Тогда
        Возврат;
    КонецЕсли;
	ОбработатьЗаказПоставщикуНаСервере(Значение, ДопПараметры);
КонецПроцедуры   

Функция ASP_ПроверкаОстаткаБезНазначения(КодСтроки, Ссылка)
	//++ASP_Crow 11.03.2026 000029567 в расширение
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК ЗаказаноОстаток
		|ИЗ
		|	РегистрНакопления.ЗаказыПоставщикам.Остатки(
		|			,
		|			КодСтроки = &КодСтроки
		|				И ЗаказПоставщику = &ЗаказПоставщику) КАК ЗаказыПоставщикамОстатки";
	
	Запрос.УстановитьПараметр("ЗаказПоставщику", Ссылка);
	Запрос.УстановитьПараметр("КодСтроки", КодСтроки);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
         Остаток = ВыборкаДетальныеЗаписи.ЗаказаноОстаток;
		 Возврат Остаток;
	КонецЕсли;
	
	Возврат 0;

КонецФункции

&НаСервере 
Процедура ОбработатьЗаказПоставщикуНаСервере(Значение, ДопПараметры) 
	//++ASP_Crow 11.03.2026 000029567 в расширение
	МассивОшибок = Новый Массив; 
	МассивУспешно = Новый Массив;
	ЗакПостОб = Значение.ПолучитьОбъект();
	//++ASP_Crow 29.11.2024 000025383 Нужен расчет максимального кода строки
	МаксимальныйКодСтроки = ЗакПостОб.МаксимальныйКодСтроки;                
	//--ASP_Crow 29.11.2024 000025383
	Назначение = Справочники.Назначения.НайтиПоРеквизиту("Заказ", Объект.Ссылка);   
	Если Назначение = Справочники.Назначения.ПустаяСсылка() Тогда 
		ОбщегоНазначения.СообщитьПользователю("Не удалось найти назначение по текущему заказу");
	Иначе	
		Для каждого СтрокаИД из ДопПараметры Цикл
			СтрокаТовара = Объект.Товары[СтрокаИД];
			СтруктураОтбора = Новый Структура("Номенклатура, Характеристика, Назначение,ASP_ЗаказКлиента", 
							СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, Справочники.Назначения.ПустаяСсылка(), Документы.ЗаказКлиента.ПустаяСсылка());
			МассивЗаказаПост = ЗакПостОб.Товары.НайтиСтроки(СтруктураОтбора); 
			//ASP 27,11,24 000025350 Коваленко провека если ли такая номенклатура, характеристика, назначение или заказ клиента в выбранном заказе поставщику
			СтруктураОтбораНазначение = Новый Структура("Номенклатура, Характеристика, Назначение, ASP_ЗаказКлиента",	СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, Назначение, Документы.ЗаказКлиента.ПустаяСсылка());
			СтруктураОтбораЗаказКлиента = Новый Структура("Номенклатура, Характеристика, ASP_ЗаказКлиента, Назначение", СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, Объект.Ссылка, Справочники.Назначения.ПустаяСсылка());
						
			МассивНазначение = ЗакПостОб.Товары.НайтиСтроки(СтруктураОтбораНазначение);
			МассивЗаказКлиента = ЗакПостОб.Товары.НайтиСтроки(СтруктураОтбораЗаказКлиента);
			
			//++ ASP_Спиряева 26.12.2024 000025620 Изменена структура проверки ASP_ЗаказКлиента в заказе поставщика
			
			//Если МассивНазначение.Количество()>0 ИЛИ МассивЗаказКлиента.Количество()>0 тогда 
			//	МассивОшибок.Добавить("Номенклатура " + СтрокаТовара.Номенклатура + " с характеристикой " + СтрокаТовара.Характеристика + " и назначением " + Назначение + " (или заказом клиента " + Объект.Ссылка +") уже есть в документе");
			//	Продолжить;				
			//КонецЕсли;	
			///////////////////////////////////////////////////
			//Если МассивЗаказаПост.Количество() = 0 Тогда
			//	МассивОшибок.Добавить("Не найдена номенклатура " + СтрокаТовара.Номенклатура + " с характеристикой " + СтрокаТовара.Характеристика + " в выбранном заказе поставщику");
			//КонецЕсли; 
			
			//Добавлена проверка если ASP_ЗаказКлиента в Заказе поставщека имеет тип неопределено
			СтруктураОтбораНазначениеЗаказКлиентаНеопределено = Новый Структура("Номенклатура, Характеристика, Назначение, ASP_ЗаказКлиента",	СтрокаТовара.Номенклатура, СтрокаТовара.Характеристика, Назначение, Неопределено);
			
			МассивНазначениеЗаказКлиентаНеопределено = ЗакПостОб.Товары.НайтиСтроки(СтруктураОтбораНазначениеЗаказКлиентаНеопределено);

			Если МассивНазначение.Количество()>0 ИЛИ МассивЗаказКлиента.Количество()>0 ИЛИ МассивНазначениеЗаказКлиентаНеопределено.Количество()>0 тогда 
				МассивОшибок.Добавить("Номенклатура " + СтрокаТовара.Номенклатура + " с характеристикой " + СтрокаТовара.Характеристика + " и назначением " + Назначение + " (или заказом клиента " + Объект.Ссылка +") уже есть в документе");
				Продолжить;				
			КонецЕсли;		
			/////////////////////////////////////////////////// 	
			//Проверка в Заказе поставщика ASP_ЗаказКлиент Значение: неопределено или ЗаказКлиента.ПустаяСсылка 
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаказПоставщикуТовары.Ссылка КАК Ссылка,
			|	ЗаказПоставщикуТовары.НомерСтроки КАК НомерСтроки,
			|	ЗаказПоставщикуТовары.НоменклатураПартнера КАК НоменклатураПартнера,
			|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
			|	ЗаказПоставщикуТовары.Характеристика КАК Характеристика,
			|	ЗаказПоставщикуТовары.Упаковка КАК Упаковка,
			|	ЗаказПоставщикуТовары.КоличествоУпаковок КАК КоличествоУпаковок,
			|	ЗаказПоставщикуТовары.Количество КАК Количество,
			|	ЗаказПоставщикуТовары.ДатаПоступления КАК ДатаПоступления,
			|	ЗаказПоставщикуТовары.ВидЦеныПоставщика КАК ВидЦеныПоставщика,
			|	ЗаказПоставщикуТовары.Цена КАК Цена,
			|	ЗаказПоставщикуТовары.Сумма КАК Сумма,
			|	ЗаказПоставщикуТовары.ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
			|	ЗаказПоставщикуТовары.СуммаРучнойСкидки КАК СуммаРучнойСкидки,
			|	ЗаказПоставщикуТовары.УдалитьСтавкаНДС КАК УдалитьСтавкаНДС,
			|	ЗаказПоставщикуТовары.СтавкаНДС КАК СтавкаНДС,
			|	ЗаказПоставщикуТовары.СуммаНДС КАК СуммаНДС,
			|	ЗаказПоставщикуТовары.СуммаСНДС КАК СуммаСНДС,
			|	ЗаказПоставщикуТовары.КодСтроки КАК КодСтроки,
			|	ЗаказПоставщикуТовары.Отменено КАК Отменено,
			|	ЗаказПоставщикуТовары.СтатьяРасходов КАК СтатьяРасходов,
			|	ЗаказПоставщикуТовары.АналитикаРасходов КАК АналитикаРасходов,
			|	ЗаказПоставщикуТовары.ПричинаОтмены КАК ПричинаОтмены,
			|	ЗаказПоставщикуТовары.Склад КАК Склад,
			|	ЗаказПоставщикуТовары.Назначение КАК Назначение,
			|	ЗаказПоставщикуТовары.Подразделение КАК Подразделение,
			|	ЗаказПоставщикуТовары.ЗаказКлиента КАК ЗаказКлиента,
			|	ЗаказПоставщикуТовары.ASP_ЗаказКлиента КАК ASP_ЗаказКлиента,
			|	ЗаказПоставщикуТовары.СписатьНаРасходы КАК СписатьНаРасходы,
			|	ЗаказПоставщикуТовары.ИдентификаторСтроки КАК ИдентификаторСтроки,
			|	ЗаказПоставщикуТовары.ДатаОтгрузки КАК ДатаОтгрузки
			|ИЗ
			|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
			|ГДЕ
			|	ЗаказПоставщикуТовары.Ссылка = &ЗакПостОб
			|	И (ЗаказПоставщикуТовары.ASP_ЗаказКлиента = НЕОПРЕДЕЛЕНО
			|			ИЛИ ЗаказПоставщикуТовары.ASP_ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка))
			|	И ЗаказПоставщикуТовары.Номенклатура = &Номенклатура
			|	И ЗаказПоставщикуТовары.Характеристика = &Характеристика
			|	И ЗаказПоставщикуТовары.Назначение = &Назначение";
			
			Запрос.УстановитьПараметр("ЗакПостОб", ЗакПостОб.Ссылка);
			Запрос.УстановитьПараметр("Номенклатура", СтрокаТовара.Номенклатура);
			Запрос.УстановитьПараметр("Характеристика", СтрокаТовара.Характеристика);
			Запрос.УстановитьПараметр("Назначение", Справочники.Назначения.ПустаяСсылка());
			
			МассивЗаказаПост = Запрос.Выполнить().Выгрузить();
			
			Если НЕ ЗначениеЗаполнено(МассивЗаказаПост) Тогда
				МассивОшибок.Добавить("Не найдена номенклатура " + СтрокаТовара.Номенклатура + " с характеристикой " + СтрокаТовара.Характеристика + " в выбранном заказе поставщику");
				Продолжить;	
			КонецЕсли;
			//-- ASP_Спиряева 26.12.2024 000025620
			Остаток = СтрокаТовара.Количество;
			Для каждого Строка из МассивЗаказаПост Цикл
				Если Остаток = 0 Тогда 
					Прервать;
				КонецЕсли;
				//++ ASP_Спиряева 26.12.2024 000025620 получение строки из ЗаказаПоставщика для записи
				СтрокаТовараПост = ЗакПостОб.Товары.Найти(Строка.НомерСтроки, "НомерСтроки");
                //-- ASP_Спиряева 26.12.2024 000025620  
				
				//++ASP_ТрунькинБ 16/12/2024 000025514 
				Если ASP_ПроверкаОстаткаБезНазначения(СтрокаТовараПост.КодСтроки, ЗакПостОб.Ссылка) = 0 Тогда
					Продолжить;
				КонецЕсли;
				//--ASP_ТрунькинБ 16/12/2024 000025514 
				
				Если СтрокаТовараПост.КоличествоУпаковок <= Остаток Тогда
					СтрокаТовараПост.Назначение = Назначение;
					Остаток = Остаток - СтрокаТовараПост.КоличествоУпаковок;
				Иначе
					НоваяСтрока = ЗакПостОб.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТовараПост);
					ТаблКодСтроки = ЗакПостОб.Товары.Выгрузить();
					ТаблКодСтроки.Сортировать("КодСтроки Убыв");
					НоваяСтрока.КодСтроки = ТаблКодСтроки[0].КодСтроки + 1;
					//++ASP_Crow 29.11.2024 000025383 Добавляем расчет максимального кода строки
					МаксимальныйКодСтроки = МаксимальныйКодСтроки + 1; 
					//--ASP_Crow 29.11.2024 000025383   
					
					//++ ASP_Спиряева 27.01.2025 000025933
					//НоваяСтрока.КоличествоУпаковок = СтрокаТовараПост.КоличествоУпаковок - Остаток; старый код 000025933
					//СтрокаТовараПост.КоличествоУпаковок = Остаток; 000025933 
					//СтрокаТовараПост.Назначение = Назначение;  000025933
					НоваяСтрока.КоличествоУпаковок      =  Остаток;
					СтрокаТовараПост.КоличествоУпаковок = СтрокаТовараПост.КоличествоУпаковок - Остаток;
					НоваяСтрока.Назначение = Назначение;
					//-- ASP_Спиряева 27.01.2025 000025933  
					
   					Остаток = 0;
					СтруктураДействий = Новый Структура;
					ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковокЗП(СтруктураДействий, Значение);
					ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовараПост, СтруктураДействий, Неопределено); 
					ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(НоваяСтрока, СтруктураДействий, Неопределено);
				КонецЕсли;
			КонецЦикла;  
			Если Остаток > 0 Тогда   
				МассивОшибок.Добавить("По номенклатуре " + СтрокаТовара.Номенклатура + " с характеристикой " + СтрокаТовара.Характеристика + " распределено " + (СтрокаТовара.Количество - Остаток)
				+ ", не удалось распределить " + Остаток);  
			Иначе
				МассивУспешно.Добавить("" + СтрокаТовара.Номенклатура + " " + СтрокаТовара.Характеристика + " в количестве " + СтрокаТовара.Количество);
			КонецЕсли;
			
		КонецЦикла;
		//++ASP_Crow 29.11.2024 000025383 
		ЗакПостОб.МаксимальныйКодСтроки = МаксимальныйКодСтроки;
		//--ASP_Crow 29.11.2024 000025383
		ЗакПостОб.Записать(РежимЗаписиДокумента.Проведение);
		Ошибки = Истина;
		Если МассивОшибок.Количество() = 0 Тогда  
			Сообщение =  "Успешно проставлено назначение для следующей номенклатуры:" + Символы.ПС;
			Для каждого СтрокаИД из ДопПараметры Цикл
				СтрокаТовара = Объект.Товары[СтрокаИД];
				Сообщение = Сообщение + СтрокаТовара.Номенклатура + " " + СтрокаТовара.Характеристика + " в количестве " + СтрокаТовара.Количество + Символы.ПС; 
			КонецЦикла;     
			ОбщегоНазначения.СообщитьПользователю(Сообщение); 
			Ошибки = Ложь;
		Иначе
			ОбщегоНазначения.СообщитьПользователю("Не удалось распределить по заказу поставщика");
			Для каждого СтрокаОшибки из МассивОшибок Цикл
				ОбщегоНазначения.СообщитьПользователю(СтрокаОшибки);
			КонецЦикла;
			Ошибки = Истина;
		КонецЕсли; 
		Если Ошибки и МассивУспешно.Количество() > 0 Тогда  
			ОбщегоНазначения.СообщитьПользователю("Успешно проставлено назначение для следующей номенклатуры:");
			Для каждого СтрокаУспешно из МассивУспешно Цикл
				ОбщегоНазначения.СообщитьПользователю(СтрокаУспешно);
			КонецЦикла;	  
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
