Функция ПолучитьВидыЦенГТС(Номенклатура);  
	//++ASP_Crow 11.03.2026 000029567 в расширение
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.ВидЦены
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыЦен КАК ВидыЦен
	|		ПО ЦеныНоменклатурыСрезПоследних.ВидЦены = ВидыЦен.Ссылка
	|ГДЕ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура
	|	И ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) > 0
	|	И ВидыЦен.ИспользоватьПриПродаже = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныНоменклатурыСрезПоследних.ВидЦены";
	
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	СписокОтбора = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидЦены");
	СписокОтбора.Добавить(Справочники.ВидыЦен.НайтиПоНаименованию("Цена продажи",1));
	Возврат СписокОтбора;
