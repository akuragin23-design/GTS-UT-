Процедура ASP_Остаток(Команда)  
	//++ASP_Crow 11.03.2026 000029567 в расширение
	ВыбраннаяСтрока = Элементы.Товары.ТекущаяСтрока;
	
	Если ВыбраннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Дата", ТекущаяДата());
	ПараметрыФормы.Вставить("Номенклатура", ТекущаяСтрока.Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
	
	ОткрытьФорму("Обработка.ПодборТоваровВДокументПродажи.Форма.ОстаткиТоваровНаСкладах", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ASP_СнятьОтменуСтрок(Команда)  
	//++ASP_Crow 11.03.2026 000029567 в расширение
		
	
	Если Объект.Товары.Количество() = 0 Тогда
		Предупреждение("В документе не заполнена таблица ""Товары""!");
		Возврат
	КонецЕсли;	
	
	Для Каждого Стр из Объект.Товары Цикл
			Стр.ПричинаОтмены=Неопределено;
			Стр.Отменено=Ложь;
			
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ЗаполнитьПризнакОтмененоБезВозвратнойТары", Объект.ВернутьМногооборотнуюТару);
			СтруктураДействий.Вставить("ЗаполнитьДубликатыЗависимыхРеквизитов", ЗависимыеРеквизиты());
			СтруктураДействий.Вставить("ПроверитьСериюРассчитатьСтатус", Новый Структура("Склад, ПараметрыУказанияСерий", Стр.Склад, ПараметрыУказанияСерий));
			СтруктураДействий.Вставить("ПриИзмененииТипаНоменклатурыИлиВариантаОбеспечения",
			Новый Структура("ЕстьРаботы, ЕстьОтменено, Форма, ПараметрыВстраивания", Истина, Ложь, ЭтаФорма, ЭтаФорма.ДоступныеОстаткиПараметрыВстраивания));
			ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(Стр, СтруктураДействий, КэшированныеЗначения);
			
		КонецЦикла;
		//ОбновитьЗависимыеРеквизитыФормы();
		
		
		ОбеспечениеКлиент.ЗаполнитьСлужебныеРеквизиты(Объект.Товары, ДатаОтгрузкиОбязательна, СкладОбязателен);
		
		РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
		
		УстановитьСтатусЗакрыт(Истина);
		ЭтаФорма.Модифицированность = Истина;
	
	

КонецПроцедуры

&НаСервере
Функция ОпределитьВесТовара(Товары)   
	//++ASP_Crow 11.03.2026 000029567 в расширение
	Вес = 0;
	Для каждого Товар из Товары Цикл
		//Если Товар.ЭтоГруппа=Ложь Тогда
		если ?(ЗначениеЗаполнено(Товар.Номенклатура.ВесЗнаменатель),Товар.Номенклатура.ВесЗнаменатель,0) > 0 Тогда	
			Вес = Вес + Товар.Номенклатура.ВесЧислитель/Товар.Номенклатура.ВесЗнаменатель*Товар.Количество;
		иначе
			Вес = Вес + Товар.Номенклатура.ВесЧислитель/1;
		Конецесли;
		//Иначе
		//КонецЕсли;
	КонецЦикла;
	Возврат Вес;
КонецФункции

//ASP_Hlopkov 16.10.2020+
&НаСервере
Функция ASP_ПересчитатьДатуОтгрузки(Таблица, МассивВыбранныхЗначений) 
	//++ASP_Crow 11.03.2026 000029567 в расширение

	Отказ = Истина;
	
	Для Каждого ВыбранноеЗначение Из МассивВыбранныхЗначений Цикл
		Если ВыбранноеЗначение = Перечисления.ВариантыОбеспечения.Обособленно ИЛИ ВыбранноеЗначение = Перечисления.ВариантыОбеспечения.НеТребуется ИЛИ ВыбранноеЗначение = Перечисления.ВариантыОбеспечения.Требуется Тогда
			Отказ = Ложь;
			Прервать;
		Иначе 
			Отказ = Истина;	
		КонецЕсли;	
	КонецЦикла;	
	
	Если НЕ Отказ Тогда
	
		ТЗДляОбработки = Новый ТаблицаЗначений;
		
		ТЗДляОбработки.Колонки.Добавить("Номенклатура", 			Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
		ТЗДляОбработки.Колонки.Добавить("ТипНоменклатуры", 			Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНоменклатуры"));
		ТЗДляОбработки.Колонки.Добавить("Количество", 				Новый ОписаниеТипов("Число"));
		ТЗДляОбработки.Колонки.Добавить("ДатаДоступности", 			Новый ОписаниеТипов("Дата"));
		ТЗДляОбработки.Колонки.Добавить("Идентификатор", 			Новый ОписаниеТипов("Число"));
		ТЗДляОбработки.Колонки.Добавить("Склад", 					Новый ОписаниеТипов("СправочникСсылка.Склады"));
		ТЗДляОбработки.Колонки.Добавить("ПриоритетТипаОбеспечения", Новый ОписаниеТипов("Число"));
		
		Для Каждого Строка Из Таблица Цикл
			
			Попытка
				СтрокаТовара = Объект.Товары[Строка.Идентификатор];
				
				НоваяСтрокаТЗ = ТЗДляОбработки.Добавить();
			
				НоваяСтрокаТЗ.Номенклатура 	  			= СтрокаТовара.Номенклатура;
				НоваяСтрокаТЗ.ТипНоменклатуры 			= СтрокаТовара.Номенклатура.ТипНоменклатуры;
				НоваяСтрокаТЗ.Количество 	  			= СтрокаТовара.Количество;
				НоваяСтрокаТЗ.ДатаДоступности 			= Строка.ДатаОтгрузки;
				НоваяСтрокаТЗ.Идентификатор   			= Строка.Идентификатор;
				НоваяСтрокаТЗ.Склад 		  			= Объект.Склад;
				НоваяСтрокаТЗ.ПриоритетТипаОбеспечения 	= Строка.ПриоритетТипаОбеспечения;
				
			Исключение
				ЗаписьЖурналаРегистрации("Данные.Изменение", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаказКлиента, Объект.Ссылка, ОписаниеОшибки());
			КонецПопытки;
			
		КонецЦикла;	

		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ПлановыеПоставки", ТЗДляОбработки);
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПлановыеПоставки.Номенклатура КАК Ном,
			|	ПлановыеПоставки.Идентификатор КАК Идентификатор,
			|	ПлановыеПоставки.ПриоритетТипаОбеспечения КАК ПриоритетТипаОбеспечения,
			|	ПлановыеПоставки.Склад КАК Склад
			|ПОМЕСТИТЬ ВТПлановыеПоставки
			|ИЗ
			|	&ПлановыеПоставки КАК ПлановыеПоставки
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Ном
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СпособыОбеспечения.Ссылка КАК Ссылка,
			|	СпособыОбеспечения.ТипОбеспечения КАК ТипОбеспечения,
			|	СпособыОбеспечения.ИсточникОбеспеченияПотребностей КАК ИсточникОбеспеченияПотребностей,
			|	СпособыОбеспечения.ГарантированныйСрокОтгрузки КАК ГарантированныйСрокОтгрузки,
			|	СпособыОбеспечения.ОбеспечиваемыйПериод КАК ОбеспечиваемыйПериод,
			|	СпособыОбеспечения.ФормироватьПлановыеЗаказы КАК ФормироватьПлановыеЗаказы,
			|	СпособыОбеспечения.ПлановаяДатаПоставки КАК ПлановаяДатаПоставки,
			|	ВТПлановыеПоставки.Ном КАК Ном,
			|	ВТПлановыеПоставки.Идентификатор КАК Идентификатор,
			|	СхемыОбеспеченияЗакупок.Склад КАК Склад
			|ПОМЕСТИТЬ ВТСхемыПеремещений
			|ИЗ
			|	Справочник.Номенклатура КАК Номенклатура
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПлановыеПоставки КАК ВТПлановыеПоставки
			|		ПО Номенклатура.Ссылка = ВТПлановыеПоставки.Ном
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СхемыОбеспечения КАК СхемыОбеспеченияЗакупок
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпособыОбеспеченияПотребностей КАК СпособыОбеспечения
			|			ПО СхемыОбеспеченияЗакупок.СпособОбеспеченияПотребностей = СпособыОбеспечения.Ссылка
			|		ПО Номенклатура.СхемаОбеспечения = СхемыОбеспеченияЗакупок.СхемаОбеспечения
			|ГДЕ
			|	СпособыОбеспечения.ТипОбеспечения = &ТипОбеспечения
			|	И НЕ ВТПлановыеПоставки.Идентификатор В
			|				(ВЫБРАТЬ
			|					ВТПлановыеПоставки.Идентификатор КАК Идентификатор
			|				ИЗ
			|					ВТПлановыеПоставки КАК ВТПлановыеПоставки
			|				ГДЕ
			|					(ВТПлановыеПоставки.ПриоритетТипаОбеспечения = 5 ИЛИ ВТПлановыеПоставки.ПриоритетТипаОбеспечения = 0))
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТСхемыПеремещений.Ссылка КАК Ссылка,
			|	ВТСхемыПеремещений.ТипОбеспечения КАК ТипОбеспечения,
			|	ВТСхемыПеремещений.ИсточникОбеспеченияПотребностей КАК ИсточникОбеспеченияПотребностей,
			|	ВТСхемыПеремещений.ГарантированныйСрокОтгрузки КАК ГарантированныйСрокОтгрузки,
			|	ВТСхемыПеремещений.ОбеспечиваемыйПериод КАК ОбеспечиваемыйПериод,
			|	ВТСхемыПеремещений.ФормироватьПлановыеЗаказы КАК ФормироватьПлановыеЗаказы,
			|	ВТСхемыПеремещений.ПлановаяДатаПоставки КАК ПлановаяДатаПоставки,
			|	ВТСхемыПеремещений.Ном КАК Ном,
			|	ВТСхемыПеремещений.Идентификатор КАК Идентификатор
			|ИЗ
			|	ВТПлановыеПоставки КАК ВТПлановыеПоставки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСхемыПеремещений КАК ВТСхемыПеремещений
			|		ПО ВТПлановыеПоставки.Ном = ВТСхемыПеремещений.Ном
			|			И ВТПлановыеПоставки.Склад = ВТСхемыПеремещений.Склад";
		
		Запрос.УстановитьПараметр("ТипОбеспечения", Перечисления.ТипыОбеспечения.Перемещение);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			
			ТЗСхемПеремещений = РезультатЗапроса.Выгрузить();
			
			Для Каждого СтрокаПеремещения Из ТЗСхемПеремещений Цикл
				
				Если НЕ СтрокаПеремещения.ФормироватьПлановыеЗаказы Тогда
					УстановитьПривилегированныйРежим(Истина);
					
					СтруктураДатаПоставки = ОпределитьДатуПоставкиПоДатеЗаказа(СтрокаПеремещения.ГарантированныйСрокОтгрузки, СтрокаПеремещения.ОбеспечиваемыйПериод);
					
					СтрокаДатаПоставки = СтруктураДатаПоставки.ДатаПоставки;
					
					День  = Лев(СтрокаДатаПоставки, 2);
					Месяц = Сред(СтрокаДатаПоставки, 4, 2);
					Год   = Сред(СтрокаДатаПоставки, 7, 4);
					
					ДатаПоставки = Дата(Год+Месяц+День+"000000");
					
				Иначе
					ДатаПоставки = СтрокаПеремещения.ПлановаяДатаПоставки;
				КонецЕсли;
				
				ПрибавитьКДатеДоступности = (НачалоДня(ДатаПоставки) - НачалоДня(ТекущаяДата()));
				
				МассивСтроки = Таблица.НайтиСтроки(Новый Структура("Идентификатор", СтрокаПеремещения.Идентификатор));
				
				Если МассивСтроки.Количество() > 0 Тогда
					Строка = МассивСтроки[0];
					
					Строка.ДатаОтгрузки = Строка.ДатаОтгрузки + ПрибавитьКДатеДоступности;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
			
		Если ТЗДляОбработки.Количество() > 0 Тогда
			
			Запрос = Новый Запрос;
			
			Запрос.УстановитьПараметр("ПлановыеПоставки", ТЗДляОбработки);
			
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПлановыеПоставки.Номенклатура КАК Номенклатура,
				|	ПлановыеПоставки.Склад КАК Склад,
				|	ПлановыеПоставки.Количество КАК Количество,
				|	ПлановыеПоставки.ДатаДоступности КАК ДатаДоступности,
				|	ПлановыеПоставки.ТипНоменклатуры КАК ТипНоменклатуры,
				|	ПлановыеПоставки.ПриоритетТипаОбеспечения КАК ПриоритетТипаОбеспечения,
				|	ПлановыеПоставки.Идентификатор КАК Идентификатор
				|ПОМЕСТИТЬ ВТПлановыеПоставки
				|ИЗ
				|	&ПлановыеПоставки КАК ПлановыеПоставки
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Номенклатура,
				|	Склад
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТПлановыеПоставки.Номенклатура КАК Номенклатура,
				|	ВТПлановыеПоставки.Склад КАК Склад,
				|	ВТПлановыеПоставки.Количество КАК Количество,
				|	ВТПлановыеПоставки.ДатаДоступности КАК ДатаДоступности,
				|	ВТПлановыеПоставки.ТипНоменклатуры КАК ТипНоменклатуры,
				|	ВТПлановыеПоставки.ПриоритетТипаОбеспечения КАК ПриоритетТипаОбеспечения,
				|	ВТПлановыеПоставки.Идентификатор КАК Идентификатор
				|ПОМЕСТИТЬ ВТПлановыеПоставкиТоваров
				|ИЗ
				|	ВТПлановыеПоставки КАК ВТПлановыеПоставки
				|ГДЕ
				|	ВТПлановыеПоставки.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.типыНоменклатуры.Товар)
				|	И НЕ ВТПлановыеПоставки.Идентификатор В
				|				(ВЫБРАТЬ
				|					ВТПлановыеПоставки.Идентификатор КАК Идентификатор
				|				ИЗ
				|					ВТПлановыеПоставки КАК ВТПлановыеПоставки
				|				ГДЕ
				|					(ВТПлановыеПоставки.ПриоритетТипаОбеспечения = 4
				|						ИЛИ ВТПлановыеПоставки.ПриоритетТипаОбеспечения = 0))
				|
				|ИНДЕКСИРОВАТЬ ПО
				|	Номенклатура,
				|	Склад
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ЕСТЬNULL(СвободныеОстаткиОстатки.ВНаличииОстаток, 0) - ВТПлановыеПоставкиТоваров.Количество КАК РезультатСписания,
				|	ВТПлановыеПоставкиТоваров.Номенклатура КАК Номенклатура,
				|	ВТПлановыеПоставкиТоваров.ДатаДоступности КАК ДатаДоступности,
				|	ВТПлановыеПоставкиТоваров.Идентификатор КАК Идентификатор,
				|	ВТПлановыеПоставкиТоваров.ПриоритетТипаОбеспечения КАК ПриоритетТипаОбеспечения,
				|	ВТПлановыеПоставкиТоваров.Склад КАК Склад
				|ПОМЕСТИТЬ ВТСвободныеОстатки
				|ИЗ
				|	ВТПлановыеПоставкиТоваров КАК ВТПлановыеПоставкиТоваров
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СвободныеОстатки.Остатки КАК СвободныеОстаткиОстатки
				|		ПО ВТПлановыеПоставкиТоваров.Номенклатура = СвободныеОстаткиОстатки.Номенклатура
				|			И ВТПлановыеПоставкиТоваров.Склад = СвободныеОстаткиОстатки.Склад
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВТСвободныеОстатки.Номенклатура КАК Номенклатура,
				|	ВТСвободныеОстатки.Идентификатор КАК Идентификатор,
				|	ВТСвободныеОстатки.ПриоритетТипаОбеспечения КАК ПриоритетТипаОбеспечения,
				|	ВТСвободныеОстатки.Склад КАК Склад,
				|	ВТСвободныеОстатки.ДатаДоступности КАК ДатаДоступности
				|ИЗ
				|	ВТСвободныеОстатки КАК ВТСвободныеОстатки
				|ГДЕ
				|	ВТСвободныеОстатки.РезультатСписания < 0";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
				
				ТЗСвободныхОстатков = РезультатЗапроса.Выгрузить();
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("СвободныеОстатки", ТЗСвободныхОстатков);
			
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	СвободныеОстатки.Номенклатура КАК Ном,
					|	СвободныеОстатки.Идентификатор КАК Идентификатор
					|ПОМЕСТИТЬ ВТСвободныхОстатков
					|ИЗ
					|	&СвободныеОстатки КАК СвободныеОстатки
					|
					|ИНДЕКСИРОВАТЬ ПО
					|	Ном
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	СпособыОбеспечения.Ссылка КАК Ссылка,
					|	СпособыОбеспечения.ТипОбеспечения КАК ТипОбеспечения,
					|	СпособыОбеспечения.ИсточникОбеспеченияПотребностей КАК ИсточникОбеспеченияПотребностей,
					|	СпособыОбеспечения.ГарантированныйСрокОтгрузки КАК ГарантированныйСрокОтгрузки,
					|	СпособыОбеспечения.ОбеспечиваемыйПериод КАК ОбеспечиваемыйПериод,
					|	СпособыОбеспечения.ФормироватьПлановыеЗаказы КАК ФормироватьПлановыеЗаказы,
					|	СпособыОбеспечения.ПлановаяДатаПоставки КАК ПлановаяДатаПоставки,
					|	ВТСвободныхОстатков.Ном КАК Ном,
					|	ВТСвободныхОстатков.Идентификатор КАК Идентификатор
					|ИЗ
					|	Справочник.Номенклатура КАК Номенклатура
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСвободныхОстатков КАК ВТСвободныхОстатков
					|		ПО Номенклатура.Ссылка = ВТСвободныхОстатков.Ном
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СхемыОбеспечения КАК СхемыОбеспеченияЗакупок
					|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпособыОбеспеченияПотребностей КАК СпособыОбеспечения
					|			ПО СхемыОбеспеченияЗакупок.СпособОбеспеченияПотребностей = СпособыОбеспечения.Ссылка
					|		ПО Номенклатура.СхемаОбеспечения = СхемыОбеспеченияЗакупок.СхемаОбеспечения
					|ГДЕ
					|	СпособыОбеспечения.ТипОбеспечения = &ТипОбеспечения";
				
				Запрос.УстановитьПараметр("ТипОбеспечения", Перечисления.ТипыОбеспечения.Покупка);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ТЗСхемПокупок = РезультатЗапроса.Выгрузить();
				
				Если НЕ РезультатЗапроса.Пустой() Тогда
					
					ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
					
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						Если НЕ ВыборкаДетальныеЗаписи.ФормироватьПлановыеЗаказы Тогда
							УстановитьПривилегированныйРежим(Истина);
							
							СтруктураДатаПоставки = ОпределитьДатуПоставкиПоДатеЗаказа(ВыборкаДетальныеЗаписи.ГарантированныйСрокОтгрузки, ВыборкаДетальныеЗаписи.ОбеспечиваемыйПериод);
							
							СтрокаДатаПоставки = СтруктураДатаПоставки.ДатаПоставки;
							
							Если СтрокаДатаПоставки = "не заполнен график работы предприятия" Тогда
								СтрокаТЧ = Объект.Товары.НайтиПоИдентификатору(ВыборкаДетальныеЗаписи.Идентификатор);
								Если СтрокаТЧ <> Неопределено Тогда
									ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не пересчитана дата отгрузки для номенклатуры "
										+ Строка(СтрокаТЧ.Номенклатура) + " по причине:" + СтрокаДатаПоставки, , "Объект.Товары[" + (СтрокаТЧ.НомерСтроки - 1) + "].ТоварыДатаОтгрузки");
								КонецЕсли;
								Продолжить;
							КонецЕсли;
							
							День  = Лев(СтрокаДатаПоставки, 2);
							Месяц = Сред(СтрокаДатаПоставки, 4, 2);
							Год   = Сред(СтрокаДатаПоставки, 7, 4);
							
							ДатаПоставки = Дата(Год+Месяц+День+"000000");
							
						Иначе
							ДатаПоставки = ВыборкаДетальныеЗаписи.ПлановаяДатаПоставки;
						КонецЕсли;
						
						ПрибавитьКДатеДоступности = (НачалоДня(ДатаПоставки) - НачалоДня(ТекущаяДата()));
						
						МассивСтроки = Таблица.НайтиСтроки(Новый Структура("Идентификатор", ВыборкаДетальныеЗаписи.Идентификатор));
						
						Если МассивСтроки.Количество() > 0 Тогда
							Строка = МассивСтроки[0];
							
							Строка.ДатаОтгрузки = Строка.ДатаОтгрузки + ПрибавитьКДатеДоступности;
						КонецЕсли;	
					КонецЦикла;	
						
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
		
	Возврат Таблица;
	
КонецФункции

Функция ОпределитьДатуПоставкиПоДатеЗаказа(СрокИсполненияЗаказа, ОбеспечиваемыйПериод) 
	//++ASP_Crow 11.03.2026 000029567 в расширение

	ДатаЗаказа = НачалоДня(ТекущаяДатаСеанса());
	Результат = Новый Структура("ДатаПоставки, ГраницаПериода");

	КалендарьПредприятия = Константы.ОсновнойКалендарьПредприятия.Получить();

	Если ЗначениеЗаполнено(КалендарьПредприятия) Тогда

		Результат.ДатаПоставки = КалендарныеГрафики.ДатаПоКалендарю(
			КалендарьПредприятия, ДатаЗаказа, СрокИсполненияЗаказа, Ложь);

	Иначе

		Результат.ДатаПоставки = ДатаЗаказа + СрокИсполненияЗаказа * 86400; //86400 - длительность суток в секундах

	КонецЕсли;

	Если Результат.ДатаПоставки = Неопределено Тогда

		Результат.ДатаПоставки   = НСтр("ru = 'не заполнен график работы предприятия'");
		Результат.ГраницаПериода = НСтр("ru = 'не заполнен график работы предприятия'");

	Иначе

		Если ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоСкладов") Тогда

			Результат.ДатаПоставки = Формат(Результат.ДатаПоставки, "ДЛФ=D");
			Результат.ГраницаПериода = НСтр("ru = '<варьируется по складам>'");

		ИначеЕсли ОбеспечиваемыйПериод = 0 Тогда

			Результат.ДатаПоставки = Формат(Результат.ДатаПоставки, "ДЛФ=D");
			Результат.ГраницаПериода = НСтр("ru = 'не ограничена'");

		Иначе

			СкладПоУмолчанию = Справочники.Склады.СкладПоУмолчанию();
			Если ЗначениеЗаполнено(СкладПоУмолчанию) Тогда

				КалендарьСклада = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СкладПоУмолчанию, "Календарь");
				Если Не ЗначениеЗаполнено(КалендарьСклада) Тогда
					КалендарьСклада = КалендарьПредприятия;
				КонецЕсли;

				Если ЗначениеЗаполнено(КалендарьСклада) Тогда

					Результат.ГраницаПериода = КалендарныеГрафики.ДатаПоКалендарю(
						КалендарьСклада, Результат.ДатаПоставки, ОбеспечиваемыйПериод, Ложь);

					Если Результат.ГраницаПериода = Неопределено Тогда
						Результат.ГраницаПериода = НСтр("ru = 'не заполнен график работы склада'");
					Иначе
						Результат.ГраницаПериода = Формат(Результат.ГраницаПериода, "ДЛФ=D");
					КонецЕсли;

				Иначе

					Результат.ГраницаПериода = Результат.ДатаПоставки + ОбеспечиваемыйПериод * 86400; //86400 - длительность суток в секундах
					Результат.ГраницаПериода = Формат(Результат.ГраницаПериода, "ДЛФ=D");

				КонецЕсли;

			Иначе

				Результат.ГраницаПериода = НСтр("ru = '<варьируется по складам>'");

			КонецЕсли;

			Результат.ДатаПоставки = Формат(Результат.ДатаПоставки, "ДЛФ=D");

		КонецЕсли;

	КонецЕсли;

	Возврат Результат;

КонецФункции

