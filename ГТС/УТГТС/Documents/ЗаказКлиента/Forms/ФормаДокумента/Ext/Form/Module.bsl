	НаименованияПодразделений.Добавить("Отдел дилерских продаж");
	НаименованияПодразделений.Добавить("Отдел продаж СПБ");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СтруктураПредприятия.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК СтруктураПредприятия
	|ГДЕ
	|	СтруктураПредприятия.Ссылка = &Подразделение
	|	И СтруктураПредприятия.Наименование В (&НаименованияПодразделений)";
