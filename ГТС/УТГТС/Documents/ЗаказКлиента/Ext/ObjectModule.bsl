// Альтер ЛОГО+:	Заполняет заказ клиента на основании поступления товаров
Процедура ЗаполнитьДокументНаОснованииПоступления(Знач Основание)      
	//ASP_Crow 11.03.2026 000029567 в расширение
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ПоступлениеТоваровУслуг.Ссылка КАК ДокументОснование,
	|	ПоступлениеТоваровУслуг.Партнер КАК Партнер,
	|	ПоступлениеТоваровУслуг.Валюта КАК Валюта,
	|	ПоступлениеТоваровУслуг.СуммаДокумента КАК СуммаДокумента,
	|	ПоступлениеТоваровУслуг.Организация КАК Организация,
	|	ПоступлениеТоваровУслуг.Соглашение КАК Соглашение,
	|	ПоступлениеТоваровУслуг.ЦенаВключаетНДС КАК ЦенаВключаетНДС,
	|	ПоступлениеТоваровУслуг.НалогообложениеНДС КАК НалогообложениеНДС,
	|	ПоступлениеТоваровУслуг.ФормаОплаты КАК ФормаОплаты,
	|	ПоступлениеТоваровУслуг.ХозяйственнаяОперация КАК ХозяйственнаяОперация,
	|	ПоступлениеТоваровУслуг.Склад КАК Склад,
	|	НЕ ПоступлениеТоваровУслуг.Проведен КАК ЕстьОшибкиПроведен,
	|	ПоступлениеТоваровУслуг.Товары.(
	|		НомерСтроки КАК НомерСтроки,
	|		Номенклатура КАК Номенклатура,
	|		Характеристика КАК Характеристика,
	|		Упаковка КАК Упаковка,
	|		КоличествоУпаковок КАК КоличествоУпаковок,
	|		Количество КАК Количество,
	|		СтавкаНДС КАК СтавкаНДС,
	|		СуммаНДС КАК СуммаНДС,
	|		Цена,
	|		Сумма,
	|		СуммаСНДС
	|	) КАК Товары
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Ссылка = &Основание");
	
	Запрос.УстановитьПараметр("Основание",Основание);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	//  ПараметрыОтбора = Новый Структура;
	//ПараметрыОтбора.Вставить("Активность", Истина);
	
	ТаблицаТовары = Выборка.Товары.Выгрузить();
	//ТаблицаТовары = ТаблицаТовары.Скопировать(ПараметрыОтбора);
	ТаблицаТовары.Сортировать("НомерСтроки Возр");
	
	Товары.Загрузить(ТаблицаТовары);
	
	
	
	Если Альтерлого.УстановитьСделку(ЭтотОбъект.Партнер) = Неопределено Тогда
		Сообщить("Для выбранного партнера не обнаружено сделок!");
	Иначе
		ЭтотОбъект.Сделка = Альтерлого.УстановитьСделку(ЭтотОбъект.Партнер);
	КонецЕсли;
	ВариантПечатиНаборов=Перечисления.ВариантыПредставленияНаборовВПечатныхФормах.НаборИКомплектующие;
	
КонецПроцедуры // ЗаполнитьДокументНаОснованииКоммерческогоПредложенияКлиенту()
