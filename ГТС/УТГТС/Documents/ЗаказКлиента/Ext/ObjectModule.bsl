	                      |ПОМЕСТИТЬ ТаблицаДанных
	                      |ИЗ
	                      |	Документ.ОперацииОтделаСервиса.ВыполненныеРаботы КАК ТабЧасть
	                      |ГДЕ
	                      |	ТабЧасть.Ссылка = &Ссылка
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	ТаблицаДанных.Номенклатура КАК Номенклатура,
	                      |	ТаблицаДанных.КоличествоУпаковок КАК КоличествоУпаковок,
	                      |	Цены.Цена КАК Цена,
	                      |	&ВидЦены КАК ВидЦены,
	                      |	ВЫБОР
	                      |		КОГДА &НалогообложениеНДС = ЗНАЧЕНИЕ(Перечисление.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС)
	                      |				ИЛИ &НалогообложениеНДС = НЕОПРЕДЕЛЕНО
	                      |			ТОГДА ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	                      |		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	                      |	КОНЕЦ КАК СтавкаНДС
	                      |ИЗ
	                      |	ТаблицаДанных КАК ТаблицаДанных
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	                      |				&ДатаДокумента,
	                      |				ВидЦены = &ВидЦены
	                      |					И Номенклатура В
	                      |						(ВЫБРАТЬ
	                      |							Вт.Номенклатура
	                      |						ИЗ
	                      |							ТаблицаДанных КАК Вт)) КАК Цены
	                      |		ПО ТаблицаДанных.Номенклатура = Цены.Номенклатура";
	
	ЗапросТоваров.УстановитьПараметр("Ссылка", Основание);
	//Если Не ПустаяСтрока(Соглашение) Тогда
	//	ЗапросТоваров.УстановитьПараметр("НалогообложениеНДС", Соглашение.НалогообложениеНДС);
	//Иначе
		ЗапросТоваров.УстановитьПараметр("НалогообложениеНДС", Неопределено);
		
	//КонецЕсли;
	ЗапросТоваров.УстановитьПараметр("ВидЦены", ВидЦены);
	ЗапросТоваров.УстановитьПараметр("ДатаДокумента", Дата);
	ТоварыОснования = ЗапросТоваров.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТЗ Из ТоварыОснования Цикл
		НоваяСтрока = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЗ);		
	КонецЦикла;				
	
	СтруктураТЧ = Новый Структура;
	СтруктураТЧ.Вставить("СтрокиТЧ" , Товары);
	
	СтруктураДействий = Новый Структура;
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС",  Новый Структура("НеобходимоОбработатьВсюТЧ, ЦенаВключаетНДС", Истина, ЦенаВключаетНДС));
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС",  Новый Структура("ЦенаВключаетНДС",  ЦенаВключаетНДС));
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТовары, СтруктураДействий, Неопределено);
		
		
	КонецЦикла;
	
	
	
	
КонецПроцедуры


// Альтер ЛОГО+:	проверка заполненности складов в таб.части Товары
Процедура ПроверитьЗаполнениеСкладовВТабличнойЧастиТовары()
	//ASP_Crow 19.03.2026 000029567 В расширение
	Для каждого СтрокаТЧ из Товары цикл
		Если СтрокаТЧ.Склад.Пустая() и Не Склад.ЭтоГруппа тогда
			СтрокаТЧ.Склад = Склад;
		Конецесли;
	Конеццикла;
КонецПроцедуры

//ГТС Проверка цены продажи > цены закупки
Процедура ПроверитьЦенуПродажи(Товары) 
	//ASP_Crow 19.03.2026 000029567 В расширение
	ДатаПроверки=?(ЗначениеЗаполнено(Дата),Дата,ТекущаяДата());
    Курс=РегистрыСведений.КурсыВалют.ПолучитьПоследнее(ДатаПроверки, Новый Структура("Валюта",Валюта));

	Для каждого СтрокаТЧ из Товары цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
		|	ЦеныНоменклатурыСрезПоследних.ВидЦены,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатурыСрезПоследних
		|ГДЕ
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура = &Номенклатура";
		
		Запрос.УстановитьПараметр("Номенклатура", СтрокаТЧ.Номенклатура);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
			ЕСЛИ ВыборкаДетальныеЗаписи.ВидЦены = Справочники.ВидыЦен.Закупочная И ВыборкаДетальныеЗаписи.Цена>0 И ВыборкаДетальныеЗаписи.Цена>(СтрокаТЧ.Сумма/СтрокаТЧ.Количество)*Курс.Курс ТОГДА
				Сообщить(Строка(СтрокаТЧ.Номенклатура) + " имеет цену ниже последней зарегистрированной закупочной.");
				
			КонецЕсли;
		КонецЦикла;
		
	Конеццикла;
КонецПроцедуры
//гтс заполняем сумму отменено  21.05.2019
Процедура ЗаполнитьСуммуОтменено();    
	//ASP_Crow 11.03.2026 000029567 в расширение
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ЗаказКлиентаТовары.СуммаСНДС) КАК СуммаСНДС,
	|	ЗаказКлиентаТовары.Отменено КАК Отменено,
	|	ЗаказКлиентаТовары.ПричинаОтмены КАК ПричинаОтмены,
	|	ASP_СоответствиеПричинЗакрытия.ПричинаЗакрытияСделок КАК ПричинаЗакрытияСделок
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ASP_СоответствиеПричинЗакрытия КАК ASP_СоответствиеПричинЗакрытия
	|		ПО ЗаказКлиентаТовары.ПричинаОтмены = ASP_СоответствиеПричинЗакрытия.ПричинаЗакрытияЗаказов
	|ГДЕ
	|	ЗаказКлиентаТовары.Отменено = &Отменено
	|	И ЗаказКлиентаТовары.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Отменено,
	|	ЗаказКлиентаТовары.ПричинаОтмены,
	|	ASP_СоответствиеПричинЗакрытия.ПричинаЗакрытияСделок";
	Запрос.УстановитьПараметр("Отменено", ИСТИНА);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Счт=0;
	Пока ВыборкаДетальныеЗаписи.Следующий() И Счт<1 Цикл
		Счт=Счт+1;
		СуммаОтменено = ВыборкаДетальныеЗаписи.СуммаСНДС;
		СделкаОб = Ссылка.Сделка.ПолучитьОбъект();
		СделкаОб.ПричинаПроигрышаСделки=ВыборкаДетальныеЗаписи.ПричинаЗакрытияСделок;
		СделкаОб.Записать();
	КонецЦикла;
	
	
	
КонецПроцедуры

Процедура ASP_ПоискОдинаковыхКодовСтроки()                        
	//ASP_Crow 11.03.2026 000029567 в расширение
	Если Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда 
		Возврат;
	КонецЕсли;
	//ASP_Dante 12/08/19 Ищим дубли строк
	МассивДублей = Новый Массив;
	Для каждого Строка Из Товары Цикл
	
		Для каждого Строка2 Из Товары Цикл
		
			Если Строка2.КодСтроки = Строка.КодСтроки И НЕ Строка2.НомерСтроки = Строка.НомерСтроки И (МассивДублей.Найти(Строка2) = Неопределено ИЛИ МассивДублей.Найти(Строка) = Неопределено) Тогда
				МассивДублей.Добавить(Строка2);
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЦикла;
	//ASP_Dante 12/08/19 перезаполняем код строки и увеличиваем на 1 макс код строки
	Если МассивДублей.Количество() > 0 Тогда
		Для каждого Строка Из МассивДублей Цикл
			
			МаксимальныйКодСтроки = МаксимальныйКодСтроки + 1;
			Строка.КодСтроки = МаксимальныйКодСтроки;
		
		КонецЦикла;
	КонецЕсли;
	//ASP_Dante 12/08/19
КонецПроцедуры

//ASP_Андреева 24.06.21
Процедура ASP_ПрослеживаемыйТовар()    
	//ASP_Crow 11.03.2026 000029567 в расширение
	Текст = "В документе имеются прослеживаемые товары:" + Символы.ПС;
	Для каждого Элемент Из Товары Цикл
		Если Элемент.Номенклатура.ASP_Прослеживаемый Тогда
			Текст = Текст + Элемент.Номенклатура.Наименование + Символы.ПС;
		КонецЕсли;
	КонецЦикла;
	Если Текст <> "В документе имеются прослеживаемые товары:" + Символы.ПС Тогда
		Сообщить(Текст);
	КонецЕсли;
КонецПроцедуры
