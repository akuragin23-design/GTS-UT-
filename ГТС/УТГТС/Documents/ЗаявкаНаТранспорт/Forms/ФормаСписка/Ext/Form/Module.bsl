//ГТС Получаем номера УПД для заявок на транспорт
&НаСервереБезКонтекста
&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	КлючиСтрок = Строки.ПолучитьКлючи();
	ЗаявкиНаТранспорт = Новый Массив;
	
	Для Каждого КлючСтроки Из КлючиСтрок Цикл
		СтрокаСписка = Строки[КлючСтроки];
		Попытка
			СтрокаСписка.Данные.НомерСФ = "";
			Если ЗначениеЗаполнено(СтрокаСписка.Данные.Ссылка) Тогда
				ЗаявкиНаТранспорт.Добавить(СтрокаСписка.Данные.Ссылка);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Если ЗаявкиНаТранспорт.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СчетФактураВыданный.Номер КАК Номер,
		|	РеализацияТоваровУслуг.ЗаявкаНаТранспорт КАК ЗаявкаНаТранспорт
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|		ПО РеализацияТоваровУслуг.Ссылка = СчетФактураВыданный.ДокументОснование
		|ГДЕ
		|	РеализацияТоваровУслуг.ЗаявкаНаТранспорт В (&ЗаявкиНаТранспорт)
		|	И РеализацияТоваровУслуг.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ЗаявкиНаТранспорт", ЗаявкиНаТранспорт);
	Выборка = Запрос.Выполнить().Выбрать();
	НомераПоЗаявкам = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		Номера = НомераПоЗаявкам.Получить(Выборка.ЗаявкаНаТранспорт);
		Если Номера = Неопределено Тогда
			Номера = "";
		КонецЕсли;
		Номера = Номера + " "
			+ Строка(ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Выборка.Номер, Истина, Истина));
		НомераПоЗаявкам.Вставить(Выборка.ЗаявкаНаТранспорт, Номера);
	КонецЦикла;
	
	Для Каждого КлючСтроки Из КлючиСтрок Цикл
		СтрокаСписка = Строки[КлючСтроки];
		Попытка
			Номера = НомераПоЗаявкам.Получить(СтрокаСписка.Данные.Ссылка);
			Если Номера <> Неопределено Тогда
				СтрокаСписка.Данные.НомерСФ = Номера;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВзятьВРаботуНаСервере()
	Если ЗначениеЗаполнено(Элементы.Список.ВыделенныеСтроки)  Тогда 
		ВзятоКол=0;
		Для Каждого ВыделеннаяСтрока из Элементы.Список.ВыделенныеСтроки Цикл
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			|ГДЕ
			|	РеализацияТоваровУслуг.ЗаявкаНаТранспорт = &ЗаявкаНаТранспорт";
			
			Запрос.УстановитьПараметр("ЗаявкаНаТранспорт", ВыделеннаяСтрока.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				РеализацияОбъект=ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
				РеализацияОбъект.ПринятоВРаботу=ТекущаяДата();
				РеализацияОбъект.Записать();
				ВзятоКол=ВзятоКол+1;
			КонецЦикла;
			
			
			
		КонецЦикла;
		Сообщить("Взято в работу документов: " + ВзятоКол);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВзятьВРаботу(Команда)
	ВзятьВРаботуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтметкаСкладаНаСервере() 
	
	Если ЗначениеЗаполнено(Элементы.Список.ВыделенныеСтроки) И (РольДоступна("ASP_ОтметкаСклада") или РольДоступна("ПолныеПрава")) Тогда 
		ВзятоКол=0;
		Для Каждого ВыделеннаяСтрока из Элементы.Список.ВыделенныеСтроки Цикл
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
			|ГДЕ
			|	РеализацияТоваровУслуг.ЗаявкаНаТранспорт = &ЗаявкаНаТранспорт";
			
			Запрос.УстановитьПараметр("ЗаявкаНаТранспорт", ВыделеннаяСтрока.Ссылка);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл      
				Если ВыполнитьПроверкуНаличияГарантии(ВыборкаДетальныеЗаписи.Ссылка) Тогда
				РеализацияОбъект=ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
				РеализацияОбъект.ОтметкаСклада=ТекущаяДата();
				РеализацияОбъект.Записать();
				ВзятоКол=ВзятоКол+1;  
				Иначе Сообщить ("По реализации " + ВыборкаДетальныеЗаписи.Ссылка + " требуется оформление и заполнение серийным номером гарантии");
				КонецЕсли;
					
				КонецЦикла;
			
			
			
		КонецЦикла;
		Сообщить("Отметка склада установлена в документах: " + ВзятоКол);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтметкаСклада(Команда)
	ОтметкаСкладаНаСервере();
КонецПроцедуры        

&НаСервере
Функция ВыполнитьПроверкуНаличияГарантии(ДокументРеализации) 
	Итог=истина;
	Если ДокументРеализации.Дата>='20231001' 
		Тогда
		//ОбъектФормы = РеквизитФормыВЗначение("Объект");
		Товары=ДокументРеализации.Товары.Выгрузить();
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТЧ.Номенклатура КАК Номенклатура
		               |ПОМЕСТИТЬ ТЧ
		               |ИЗ
		               |	&ТЧ КАК ТЧ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТЧ.Номенклатура КАК Номенклатура,
		               |	Номенклатура1.ВидНоменклатуры.ИспользоватьСерии КАК ИспользоватьСерии
		               |ИЗ
		               |	ТЧ КАК ТЧ
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура1
		               |		ПО ТЧ.Номенклатура = Номенклатура1.Ссылка
		               |ГДЕ
		               |	Номенклатура1.ВидНоменклатуры.ИспользоватьСерии = ИСТИНА
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТЧ.Номенклатура,
		               |	Номенклатура1.ВидНоменклатуры.ИспользоватьСерии";
		Запрос.УстановитьПараметр("ТЧ", Товары);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл   
			Итог=Ложь;
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ASP_ГарантийныеТалоны.Номенклатура КАК Номенклатура,
				|	ASP_ГарантийныеТалоны.СерийныйНомер КАК СерийныйНомер,
				|	ASP_ГарантийныеТалоны.Реализация КАК Реализация
				|ИЗ
				|	РегистрСведений.ASP_ГарантийныеТалоны КАК ASP_ГарантийныеТалоны
				|ГДЕ
				|	ASP_ГарантийныеТалоны.Реализация = &Реализация
				|	И ASP_ГарантийныеТалоны.Номенклатура = &Номенклатура
				|
				|УПОРЯДОЧИТЬ ПО
				|	СерийныйНомер";
			
			Запрос.УстановитьПараметр("Номенклатура", Выборка.Номенклатура);
			Запрос.УстановитьПараметр("Реализация", ДокументРеализации);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если Не ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СерийныйНомер) Тогда
				Итог=Ложь;
				Прервать; 
				Иначе 
				Итог=Истина;
				Прервать;
				КонецЕсли;	
			КонецЦикла;
	

	
		КонецЦикла;
        Возврат Итог;
