	ОтборСтатус = Настройки.Получить("ОтборСтатус");
	Подразделение  = Настройки.Получить("Подразделение");
	ОтборСклад  = Настройки.Получить("ОтборСклад");
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Менеджер",  ОтборМенеджер, , , ЗначениеЗаполнено(ОтборМенеджер));
