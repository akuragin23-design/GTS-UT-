&НаСервере
Функция СформироватьРеестрДокументовНаСевере()
	Отчет = Отчеты.РеестрЗаявокНаТранспорт.Создать();
	
	Для каждого ПараметрОтчета Из Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.Элементы Цикл
		//Если СокрЛП(ПараметрОтчета.Параметр) = "НачДата" Тогда
		//	Если ЗначениеЗаполнено(ЭтаФорма.ПодчиненныеЭлементы.Список.Период.ДатаНачала) Тогда
		//		ПараметрОтчета.Значение = ЭтаФорма.ПодчиненныеЭлементы.Список.Период.ДатаНачала;
		//	КонецЕсли;	
		//ИначеЕсли СокрЛП(ПараметрОтчета.Параметр) = "КонДата" Тогда
		//	Если ЗначениеЗаполнено(ЭтаФорма.ПодчиненныеЭлементы.Список.Период.ДатаОкончания) Тогда
		//		ПараметрОтчета.Значение = ЭтаФорма.ПодчиненныеЭлементы.Список.Период.ДатаОкончания;
		//	КонецЕсли;	
		//КонецЕсли;
		Если СокрЛП(ПараметрОтчета.Параметр) = "Период" Тогда
			Если ЗначениеЗаполнено(ЭтаФорма.ПодчиненныеЭлементы.Список.Период.ДатаНачала) ИЛИ ЗначениеЗаполнено(ЭтаФорма.ПодчиненныеЭлементы.Список.Период.ДатаОкончания) Тогда
				ПараметрОтчета.Значение = ЭтаФорма.ПодчиненныеЭлементы.Список.Период;
				ПараметрОтчета.Использование = Истина;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
		
	Отбор = Отчет.КомпоновщикНастроек.Настройки.Отбор;
	
	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
		Если СокрЛП(ЭлементОтбора.ЛевоеЗначение) = "Менеджер" И ЗначениеЗаполнено(ОтборМенеджер) Тогда
			ЭлементОтбора.ПравоеЗначение = ОтборМенеджер;
			ЭлементОтбора.Использование = Истина;
		ИначеЕсли СокрЛП(ЭлементОтбора.ЛевоеЗначение) = "Статус" И ЗначениеЗаполнено(ОтборСтатус) Тогда
			ЭлементОтбора.ПравоеЗначение = ОтборСтатус;
			ЭлементОтбора.Использование = Истина;
		КонецЕсли;	
	КонецЦикла;	
	
	// Компоновка макета компоновки данных.
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(Отчет.СхемаКомпоновкиДанных, Отчет.КомпоновщикНастроек.Настройки);
	
	// Построение табличного документа.
	ТабДок = Новый ТабличныйДокумент;
	
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(МакетКомпоновкиДанных);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
    ПроцессорВывода.УстановитьДокумент(ТабДок);
    ПроцессорВывода.Вывести(Процессор);

	Возврат ТабДок;
	
КонецФункции//СформироватьРеестрДокументовНаСевере()	

