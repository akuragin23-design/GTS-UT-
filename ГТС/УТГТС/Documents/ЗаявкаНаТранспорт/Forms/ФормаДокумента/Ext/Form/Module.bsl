// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Обработчик механизма "ВерсионированиеОбъектов"
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	//Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
	//	Отказ = Истина;
	//	Возврат;
	//КонецЕсли;
	Элементы.Сумма.ТолькоПросмотр = ЗначениеЗаполнено(Объект.ДокументОснование) И ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ЗаказКлиента") И Права()=Ложь;
	Если НЕ ЗначениеЗаполнено(Параметры.Ключ) Тогда
		Объект.Менеджер = ПараметрыСеанса.ТекущийПользователь;
		Элементы.СуммаЗаСчетКомпании.ТолькоПросмотр=Ложь;
	КонецЕсли;
	Если Объект.ВариантЗаЧейСчетДоставка=Перечисления.ВариантыЗаЧейСчетДоставка.ЗаСчетКлиента И Права()=Ложь Тогда
		Элементы.ПодразделениеПлательщик.ТолькоПросмотр=Истина;
		Элементы.СуммаЗаСчетКомпании.ТолькоПросмотр=Истина; 
	КонецЕсли;
	Если Объект.ВариантЗаЧейСчетДоставка=Перечисления.ВариантыЗаЧейСчетДоставка.ЗаСчетПодразделения И Права()=Ложь Тогда
	Элементы.ВариантЗаЧейСчетДоставка.ТолькоПросмотр=Истина;
	Элементы.ПодразделениеПлательщик.ТолькоПросмотр=Истина;
	Элементы.СуммаЗаСчетКомпании.ТолькоПросмотр=Истина;
	КонецЕсли;
		
	Если Права() Тогда
	Элементы.СуммаЗаСчетКомпании.ТолькоПросмотр=Ложь;
	Элементы.Сумма.ТолькоПросмотр=Ложь;
	КонецЕсли;
	
	Элементы.ГруппаОснование.Видимость = ЗначениеЗаполнено(Объект.ДокументОснование);
	
	
	// СтандартныеПодсистемы.РаботаСФайлами
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		ГиперссылкаФайлов = МодульРаботаСФайлами.ГиперссылкаФайлов();
		ГиперссылкаФайлов.Размещение = "КоманднаяПанель";
		МодульРаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ГиперссылкаФайлов);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.РаботаСФайлами

		//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаявкаНаТранспортПрисоединенныеФайлы.Ссылка) КАК ЧислоФайлов,
		|	ЗаявкаНаТранспортПрисоединенныеФайлы.ВладелецФайла КАК ВладелецФайла
		|ИЗ
		|	Справочник.ЗаявкаНаТранспортПрисоединенныеФайлы КАК ЗаявкаНаТранспортПрисоединенныеФайлы
		|ГДЕ
		|	ЗаявкаНаТранспортПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайла
		|	И ЗаявкаНаТранспортПрисоединенныеФайлы.ПометкаУдаления = &ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаявкаНаТранспортПрисоединенныеФайлы.ВладелецФайла";
	
	Запрос.УстановитьПараметр("ВладелецФайла", Объект.Ссылка);
	Запрос.УстановитьПараметр("ПометкаУдаления", ложь);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ФайловВложено=0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ФайловВложено=ВыборкаДетальныеЗаписи.ЧислоФайлов;
	КонецЦикла;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА      
	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);


	
КонецПроцедуры

