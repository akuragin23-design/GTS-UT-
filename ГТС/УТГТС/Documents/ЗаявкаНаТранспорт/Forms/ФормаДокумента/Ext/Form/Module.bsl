&НаСервере
Функция ПолучитьРеквизитЭлементаСервер(Элемент,ИмяРеквизита)
	Возврат Элемент[ИмяРеквизита];
КонецФункции

&НаСервере
Процедура РассчитатьВесНаСервере()
	СтрокаТЧ = Объект.Товары[Элементы.Товары.ТекущаяСтрока];
	Вес = СтрокаТЧ.Номенклатура.ВесЧислитель/?(СтрокаТЧ.Номенклатура.ВесЗнаменатель=0, 1, СтрокаТЧ.Номенклатура.ВесЗнаменатель);
	Если ЗначениеЗаполнено(СтрокаТЧ.Упаковка) Тогда
		Вес = СтрокаТЧ.Упаковка.Вес;
	КонецЕсли;	
	СтрокаТЧ.Вес = СтрокаТЧ.Количество * Вес;
	
КонецПроцедуры//РассчитатьВесСервер	

&НаСервере
Процедура РассчитатьОбъемНаСервере() 
	
	СтрокаТЧ = Объект.Товары[Элементы.Товары.ТекущаяСтрока];
	Объем = 0;
	Если ЗначениеЗаполнено(СтрокаТЧ.Упаковка) Тогда
		Объем = СтрокаТЧ.Упаковка.Объем;
	Иначе
		Объем = СтрокаТЧ.Номенклатура.ОбъемЧислитель/?(СтрокаТЧ.Номенклатура.ОбъемЗнаменатель=0, 1, СтрокаТЧ.Номенклатура.ОбъемЗнаменатель);
	КонецЕсли;	
	Если ЗначениеЗаполнено(СтрокаТЧ.Упаковка) Тогда
		Объем = СтрокаТЧ.Упаковка.Объем;
	КонецЕсли;
	СтрокаТЧ.Объем = СтрокаТЧ.Количество * Объем;
	
КонецПроцедуры	//РассчитатьОбъемСервер

