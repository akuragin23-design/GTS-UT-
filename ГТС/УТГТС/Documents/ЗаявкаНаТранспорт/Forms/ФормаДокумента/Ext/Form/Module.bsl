	Если Пользователи.ТекущийПользователь()=Справочники.Пользователи.НайтиПоНаименованию("Комяков Борис") или
		Пользователи.ТекущийПользователь()=Справочники.Пользователи.НайтиПоНаименованию("Вирзин Дмитрий") или
		Пользователи.ТекущийПользователь()=Справочники.Пользователи.НайтиПоНаименованию("Крайнев Сергей Анатольевич") или
		Пользователи.ТекущийПользователь()=Справочники.Пользователи.НайтиПоНаименованию("Воротилов Александр Юрьевич") или
		Пользователи.ТекущийПользователь() = Справочники.Пользователи.НайтиПоНаименованию("Андрианов Дмитрий Николаевич") или
		Пользователи.ТекущийПользователь() = Справочники.Пользователи.НайтиПоНаименованию("Гришин Даниил")  или
		Пользователи.ТекущийПользователь() = Справочники.Пользователи.НайтиПоНаименованию("Пазухин Даниил Алексеевич")
		Тогда
	Возврат Истина;
	Иначе Возврат Ложь;
	КонецЕсли;

