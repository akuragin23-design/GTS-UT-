&НаСервере
Процедура ЗаполнитьПоОснованиюНаСервере()
	
	об = Объект.Ссылка.ПолучитьОбъект();
	об.Товары.Очистить();
	об.Заполнить(Объект.ДокументОснование);
	об.Записать(РежимЗаписиДокумента.Запись);
	ЭтаФорма.Прочитать();
	
КонецПроцедуры//ЗаполнитьПоОснованиюНаСервере()	

