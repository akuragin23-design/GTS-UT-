&НаСервере
Функция НайтиДокументРеализацииНаСервере(Заявка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеализацияТоваровУслуг.Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
	|ГДЕ
	|	РеализацияТоваровУслуг.Проведен
	|	И РеализацияТоваровУслуг.ЗаявкаНаТранспорт = &ЗаявкаНаТранспорт";

	Запрос.УстановитьПараметр("ЗаявкаНаТранспорт", Заявка);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	МассивДокументов = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивДокументов.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;	
	
	Возврат МассивДокументов;
	
КонецФункции//НайтиДокументРеализацииНаСервере

// Процедура - обработчик события "ОбработкаКоманды".
//
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ДокРеализации = НайтиДокументРеализацииНаСервере(ПараметрКоманды);
		
	Если ДокРеализации.Количество() = 0 Тогда
		Сообщить("Не найдено связанных с заявкой (" + ПараметрКоманды + ") документов реализации!");	
		Возврат;
	КонецЕсли;
	
	Если УправлениеПечатьюКлиент.ПроверитьДокументыПроведены(ДокРеализации) Тогда
	
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			"Документ.РеализацияТоваровУслуг",
			"Накладная",
			ДокРеализации,
			Неопределено,
			Новый Структура("ВыводитьКомплектующие", Ложь)
		);
	
	КонецЕсли;

КонецПроцедуры // ОбработкаКоманды()
