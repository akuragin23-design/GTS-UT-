&НаКлиенте
Процедура СоглашениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	//	
	Если НЕ ЗначениеЗаполнено(Объект.Партнер) тогда
		ПоказатьПредупреждение(Неопределено, "Не выбран партнер!");
		возврат;
	КонецЕсли;
	Выбор = Неопределено;

	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СоглашениеВыборИзСпискаЗавершение", ЭтотОбъект), СписокВариантовСоглашений(), Элемент);
КонецПроцедуры

&НаКлиенте
Процедура СоглашениеВыборИзСпискаЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	// 
	
	Выбор = ВыбранныйЭлемент;
	Если Выбор = неопределено тогда возврат конецесли;
	
	Если Выбор.Значение = 0 тогда
		Форма = "Справочник.СоглашенияСКлиентами.ФормаВыбора";
	Иначе
		Форма = "Справочник.СоглашенияСПоставщиками.ФормаВыбора";
	КонецЕсли;
	ОткрытьФорму(Форма, Новый Структура("Партнер, ДатаДокумента", Объект.Партнер, Объект.Дата),,,,, Новый ОписаниеОповещения("ОткрытьФормуЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	//
	Выбор = Результат;
	Если НЕ ЗначениеЗаполнено(Выбор) тогда возврат конецесли;
	Объект.Соглашение = Выбор;

КонецПроцедуры

&НаКлиенте
Функция СписокВариантовСоглашений()
	
	Список = Новый СписокЗначений();
	Список.Добавить(0, "Соглашения с клиентами");
	Список.Добавить(1, "Соглашения с поставщиками");
	
	возврат Список;
	
КонецФункции
