
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

// Процедура - обработчик события ОбработкаЗаполнения.
//
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказПоставщику") ИЛИ ТипЗНЧ(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") ИЛИ ТипЗНЧ(ДанныеЗаполнения) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
	
		// Заполнение шапки документа.
		ЭтотОбъект.ДокументОснование = ДанныеЗаполнения.Ссылка;
		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Контрагент;
		ПоДокументу = ДанныеЗаполнения.Ссылка;
		НаПолучениеОт = ДанныеЗаполнения.Контрагент.НаименованиеПолное;
		СтруктураПараметров = новый Структура("Организация, ФормаОплаты, БанковскийСчет, Валюта, НаправлениеДеятельности, НаправлениеДеятельности");
		СтруктураПараметров.Организация = Организация;
		СтруктураПараметров.БанковскийСчет = БанковскийСчет;
		БанковскийСчет = ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(СтруктураПараметров);
		ДатаДействия = ТекущаяДата() + 5 * 24 * 60 * 60;
		
		// Заполнение табличной части документа.	
		Запасы.Очистить();
		
		Для каждого СтрокаТабличнойЧасти Из ДанныеЗаполнения.Товары Цикл
			
			НоваяСтрока = Запасы.Добавить();
			НоваяСтрока.НаименованиеТовара = СтрокаТабличнойЧасти.Номенклатура.НаименованиеПолное;
			НоваяСтрока.ЕдиницаИзмерения = СтрокаТабличнойЧасти.Упаковка;
			Если ПустаяСтрока(НоваяСтрока.ЕдиницаИзмерения) Тогда
				НоваяСтрока.ЕдиницаИзмерения = СтрокаТабличнойЧасти.Номенклатура.ЕдиницаИзмерения;
			КонецЕсли;	
			НоваяСтрока.Количество = СтрокаТабличнойЧасти.КоличествоУпаковок;
						
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		
		ПаспортСерия = "";
		ПаспортНомер = "";
		ПаспортВыдан = "";
		ПаспортДатаВыдачи = "";
		ПаспортныеДанные = "";
		
		// Заполнение шапки документа.
		ЭтотОбъект.ДокументОснование = ДанныеЗаполнения.Ссылка;
		ФизЛицо = ДанныеЗаполнения.Водитель;
		Организация = ДанныеЗаполнения.Организация;
		Контрагент = ДанныеЗаполнения.Контрагент;
		НаПолучениеОт = ДанныеЗаполнения.Контрагент.НаименованиеПолное;
		СтруктураПараметров = новый Структура("Организация, ФормаОплаты, БанковскийСчет, Валюта, НаправлениеДеятельности, НаправлениеДеятельности");
		СтруктураПараметров.Организация = Организация;
		СтруктураПараметров.БанковскийСчет = БанковскийСчет;
		БанковскийСчет = ЗначениеНастроекПовтИсп.ПолучитьБанковскийСчетОрганизацииПоУмолчанию(СтруктураПараметров);
		ДатаДействия = ТекущаяДата() + 5 * 24 * 60 * 60;
		
		Если ЗначениеЗаполнено(ФизЛицо) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ДокументыФизическихЛицСрезПоследних.ВидДокумента,
			|	ДокументыФизическихЛицСрезПоследних.Серия,
			|	ДокументыФизическихЛицСрезПоследних.Номер,
			|	ДокументыФизическихЛицСрезПоследних.КемВыдан,
			|	ДокументыФизическихЛицСрезПоследних.ДатаВыдачи,
			|	ДокументыФизическихЛицСрезПоследних.Представление
			|ИЗ
			|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
			|			&ДатаСреза,
			|			Физлицо = &ФизЛицо
			|				И ВидДокумента.Наименование ПОДОБНО ""%паспорт%"") КАК ДокументыФизическихЛицСрезПоследних";
			Запрос.УстановитьПараметр("ДатаСреза", Дата);
			Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ПаспортСерия = СокрЛП(Выборка.Серия);
				ПаспортНомер = СокрЛП(Выборка.Номер);
				ПаспортВыдан = СокрЛП(Выборка.КемВыдан);
				ПаспортДатаВыдачи = Выборка.ДатаВыдачи;
				ПаспортныеДанные = СокрЛП(Выборка.Представление);
			КонецЕсли;	
		КонецЕсли;
		
		// Заполнение табличной части документа.	
		Запасы.Очистить();
		
		НовСтрока = Запасы.Добавить();
		НовСтрока.НаименованиеТовара = "Денежные ср-ва";
		НовСтрока.ЕдиницаИзмерения = "руб.";
	КонецЕсли;
		
КонецПроцедуры // ОбработкаЗаполнения()

