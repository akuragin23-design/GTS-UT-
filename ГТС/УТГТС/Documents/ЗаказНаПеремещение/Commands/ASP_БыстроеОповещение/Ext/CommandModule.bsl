Функция ПолучениеДанных(Документ,Параметр);
		Если параметр = "ссылка" тогда
		Возврат Документ.Ссылка;
	ИначеЕсли параметр = "складотправитель" тогда
		Возврат Документ.СкладОтправитель;
	ИначеЕсли параметр = "складполучатель" тогда
		Возврат Документ.СкладПолучатель;
	ИначеЕсли параметр = "партнер" тогда
		Возврат Документ.Партнер;
	ИначеЕсли параметр = "ответственный" тогда
		Возврат Документ.Ответственный;
	ИначеЕсли параметр = "комментарий" тогда
		Возврат Документ.Комментарий;
	ИначеЕсли параметр = "статус" тогда
		Возврат Документ.Статус;
	
	КонецЕсли;
КонецФункции

Функция ПолучениеТЧ(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЗаказНаПеремещениеТовары.НомерСтроки КАК НомерСтроки,
	|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
	|	ЗаказНаПеремещениеТовары.Количество КАК Количество,
	|	ЗаказНаПеремещениеТовары.Упаковка КАК Упаковка,
	|	ЗаказНаПеремещениеТовары.Назначение КАК Назначение,
	|	ЗаказНаПеремещениеТовары.НачалоОтгрузки КАК ДатаОтгрузки
	|ИЗ
	|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
	|ГДЕ
	|	ЗаказНаПеремещениеТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЗаказНаПеремещениеТовары.Номенклатура.Наименование";
	Запрос.УстановитьПараметр("Ссылка", Документ);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Текст= "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Текст= Текст + ВыборкаДетальныеЗаписи.Количество  + Символы.Таб + "шт." + Символы.Таб + ВыборкаДетальныеЗаписи.Номенклатура + Символы.Таб + ВыборкаДетальныеЗаписи.Назначение + Символы.Таб + Формат(ВыборкаДетальныеЗаписи.ДатаОтгрузки, "ДЛФ=Д") + Символы.ПС;
	КонецЦикла;
	
	
	Возврат Текст;
КонецФункции



Функция ТаблицаЗначенийВМассив(ТаблицаЗначений) Экспорт
	
	Массив = Новый Массив();
	СтруктураСтрокой = "";
	НужнаЗапятая = Ложь;
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если НужнаЗапятая Тогда
			СтруктураСтрокой = СтруктураСтрокой + ",";
		КонецЕсли;
		СтруктураСтрокой = СтруктураСтрокой + Колонка.Имя;
		НужнаЗапятая = Истина;
	КонецЦикла;
	Для Каждого Строка Из ТаблицаЗначений Цикл
		НоваяСтрока = Новый Структура(СтруктураСтрокой);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		Массив.Добавить(НоваяСтрока);
	КонецЦикла;
	Возврат Массив;
	
КонецФункции
