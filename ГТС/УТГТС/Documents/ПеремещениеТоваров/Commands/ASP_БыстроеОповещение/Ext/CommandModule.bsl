	"Склад отправитель: " + ПолучениеДанных(ПараметрКоманды,"складотправитель") + Символы.ПС +
	"Склад получатель: " + ПолучениеДанных(ПараметрКоманды,"складполучатель") + Символы.ПС +
	"Статус: " + ПолучениеДанных(ПараметрКоманды,"статус") + Символы.ПС +
