	//ПараметрыПисьма.Вставить("Предмет", ПараметрКоманды);
	
	ОткрытьФорму("Документ.ЭлектронноеПисьмоИсходящее.Форма.ФормаДокумента", ПараметрыПисьма, , , , , );

КонецПроцедуры

&НаСервере
Функция ПолучениеДанных(Документ,Параметр);
	Если параметр = "ссылка" тогда
	Возврат Документ.Ссылка;
	ИначеЕсли параметр = "складотправитель" тогда
	Возврат Документ.СкладОтправитель;
	ИначеЕсли параметр = "складполучатель" тогда
	Возврат Документ.СкладПолучатель;
	ИначеЕсли параметр = "статус" тогда
	Возврат Документ.статус;
	ИначеЕсли параметр = "ответственный" тогда
	Возврат Документ.ответственный;
	ИначеЕсли параметр = "комментарий" тогда
	Возврат Документ.Комментарий;

	КонецЕсли;

КонецФункции

&НаСервере
Функция ПолучениеТЧ(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПеремещениеТоваровТовары.НомерСтроки КАК НомерСтроки,
		|	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
		|	ПеремещениеТоваровТовары.Количество КАК Количество,
		|	ПеремещениеТоваровТовары.Упаковка КАК Упаковка,
		|	ПеремещениеТоваровТовары.Назначение КАК Назначение,
		|	ПеремещениеТоваровТовары.ASP_ЗаказКлиента КАК ASP_ЗаказКлиента,
		|	ПеремещениеТоваровТовары.ASP_ЗаказКлиента.Менеджер КАК Менеджер
		|ИЗ
		|	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
		|ГДЕ
		|	ПеремещениеТоваровТовары.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПеремещениеТоваровТовары.Номенклатура.Наименование";
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Текст= "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	Текст= Текст + ВыборкаДетальныеЗаписи.Количество  + Символы.Таб + "шт." + Символы.Таб + ВыборкаДетальныеЗаписи.Номенклатура + Символы.Таб + ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Назначение),ВыборкаДетальныеЗаписи.Назначение,строка(строка(ВыборкаДетальныеЗаписи.ASP_ЗаказКлиента) + " " + строка(ВыборкаДетальныеЗаписи.Менеджер))) + Символы.ПС;
	КонецЦикла;
	
		
	Возврат Текст;
КонецФункции

&НаСервере
Функция ТаблицаЗначенийВМассив(ТаблицаЗначений) Экспорт
    
    Массив = Новый Массив();
    СтруктураСтрокой = "";
    НужнаЗапятая = Ложь;
    Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
        Если НужнаЗапятая Тогда
            СтруктураСтрокой = СтруктураСтрокой + ",";
        КонецЕсли;
        СтруктураСтрокой = СтруктураСтрокой + Колонка.Имя;
        НужнаЗапятая = Истина;
    КонецЦикла;
    Для Каждого Строка Из ТаблицаЗначений Цикл
        НоваяСтрока = Новый Структура(СтруктураСтрокой);
        ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
        Массив.Добавить(НоваяСтрока);
    КонецЦикла;
    Возврат Массив;

КонецФункции

&НаСервере
Функция ПолучитьПолучателя(ПараметрКоманды)
	Если ПараметрКоманды.ЗаказКлиента <> Неопределено И ПараметрКоманды.ЗаказКлиента <> Документы.ЗаказКлиента.ПустаяСсылка() 
		Тогда Менеджер=ПараметрКоманды.ЗаказКлиента.Менеджер;
	ИначеЕсли
		ПараметрКоманды.ЗаказНаПеремещение <> Неопределено И ПараметрКоманды.ЗаказНаПеремещение <> Документы.ЗаказНаПеремещение.ПустаяСсылка()
		Тогда Менеджер=ПараметрКоманды.ЗаказНаПеремещение.Ответственный;
	Иначе 
		Возврат "manager@gortorgsnab.ru";
	КонецЕсли; 
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Адрес= "manager@gortorgsnab.ru";
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПользователиКонтактнаяИнформация.Представление КАК АдресЭП
		|ИЗ
		|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
		|		ПО ПользователиКонтактнаяИнформация.Ссылка = Пользователи.Ссылка
		|ГДЕ
		|	Пользователи.Ссылка = &Ссылка
		|	И ПользователиКонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Ссылка", Менеджер);  
	Запрос.УстановитьПараметр("Вид", ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailПользователя"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Адрес=ВыборкаДетальныеЗаписи.АдресЭП + "; sklad-t@gortorgsnab.ru; spv@gortorgsnab.ru; 211@gortorgsnab.ru" ;
	КонецЦикла;
	Возврат Адрес;	
	
	
КонецФункции