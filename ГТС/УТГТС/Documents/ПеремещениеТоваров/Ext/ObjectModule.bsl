		СтрокаТЧ = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
		СтрокаТЧ.КоличествоУпаковок = СтрокаТЧ.Количество;
	КонецЦикла;
	
КонецПроцедуры

Процедура ASP_КонтрольПоЗапасамИПотребностям(Ссылка, Отказ) 
	//++ASP_Crow 11.03.2026 000029567 в расширение

	Запрос = новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПеремещениеТоваровТовары.Номенклатура КАК Номенклатура,
	               |	ПеремещениеТоваровТовары.Характеристика КАК Характеристика,
	               |	ПеремещениеТоваровТовары.Ссылка.СкладОтправитель КАК СкладОтправитель
	               |ПОМЕСТИТЬ ВТ_Товары
	               |ИЗ
	               |	Документ.ПеремещениеТоваров.Товары КАК ПеремещениеТоваровТовары
	               |ГДЕ
	               |	ПеремещениеТоваровТовары.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗапасыИПотребностиОстатки.Номенклатура КАК Номенклатура,
	               |	ЗапасыИПотребностиОстатки.Характеристика КАК Характеристика,
	               |	ЗапасыИПотребностиОстатки.Склад КАК Склад,
	               |	ЕСТЬNULL(ЗапасыИПотребностиОстатки.ВНаличииОстаток, 0) - (ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) + ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьПоМереПоступленияОстаток, 0)) КАК СвободныйОстаток
	               |ИЗ
	               |	ВТ_Товары КАК ВТ_Товары
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
	               |		ПО ВТ_Товары.Номенклатура = ЗапасыИПотребностиОстатки.Номенклатура
	               |			И (ЗапасыИПотребностиОстатки.Характеристика = ВТ_Товары.Характеристика)
	               |			И ВТ_Товары.СкладОтправитель = ЗапасыИПотребностиОстатки.Склад";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Результат = Запрос.Выполнить().ВЫгрузить();
	ТекстОшибки = "После проведения документа образуется отрицательный свободный остаток по регистру Запасы и потребности:";
	Для каждого СтрокаРез из Результат Цикл
		Если СтрокаРез.СвободныйОстаток < 0 тогда
			Отказ = Истина;
			ТекстОшибки = ТекстОшибки + Символы.ПС + СтрокаРез.Номенклатура + " Остаток: " + СтрокаРез.СвободныйОстаток;
		КонецЕсли;
	КонецЦикла;
	
	Если Отказ Тогда
		Сообщить(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти