// Альтер ЛОГО+: Заполняет документ на основании заказа клиента
Процедура ЗаполнитьДокументНаОснованииЗаказаКлиента(Знач Основание) 
	//++ASP_Crow 11.03.2026 000029567 в расширение
	
	//Если Основание.Статус <> Перечисления.СтатусыЗаказовКлиентов.КОбеспечению
	//	И Основание.Статус <> Перечисления.СтатусыЗаказовКлиентов.КОтгрузке Тогда
	//	Сообщить("Статус заказа клиента должен быть 'К обеспечению' ИЛИ 'К отгрузке'!");
	//	Возврат;
	//КонецЕсли;
	
	ЗаказКлиента = Основание;
	Организация = Основание.Организация;
	СкладПолучатель = Основание.Склад;
	Валюта = Основание.Валюта;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиентаТовары.Номенклатура,
	|	ЗаказКлиентаТовары.Характеристика,
	|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	|	ЗаказКлиентаТовары.СтавкаНДС
	|ПОМЕСТИТЬ ТоварыВЗаказе
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	|ГДЕ
	|	ЗаказКлиентаТовары.Ссылка = &Основание
	|	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)
	|	И НЕ ЗаказКлиентаТовары.Отменено
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказКлиентаТовары.Номенклатура,
	|	ЗаказКлиентаТовары.Характеристика,
	|	ЗаказКлиентаТовары.СтавкаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗаказыКлиентовОстатки.Номенклатура,
	|	ЗаказыКлиентовОстатки.Характеристика,
	|	СУММА(ЗаказыКлиентовОстатки.ЗаказаноОстаток) КАК Количество,
	|	ТоварыВЗаказе.СтавкаНДС
	|ИЗ
	|	РегистрНакопления.ЗаказыКлиентов.Остатки(
	|			,
	|			ЗаказКлиента = &Основание
	|				И Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)) КАК ЗаказыКлиентовОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТоварыВЗаказе КАК ТоварыВЗаказе
	|		ПО ЗаказыКлиентовОстатки.Номенклатура = ТоварыВЗаказе.Номенклатура
	|			И ЗаказыКлиентовОстатки.Характеристика = ТоварыВЗаказе.Характеристика
	|ГДЕ
	|	ЗаказыКлиентовОстатки.ЗаказаноОстаток > 0
	|	И ЕСТЬNULL(ТоварыВЗаказе.Количество, 0) > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаказыКлиентовОстатки.Номенклатура,
	|	ЗаказыКлиентовОстатки.Характеристика,
	|	ТоварыВЗаказе.СтавкаНДС";
	Запрос.УстановитьПараметр("Основание", Основание);
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаТЧ = Товары.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
		СтрокаТЧ.КоличествоУпаковок = СтрокаТЧ.Количество;
	КонецЦикла;
	
КонецПроцедуры//ЗаполнитьДокументНаОснованииЗаказаКлиента(Основание)	
