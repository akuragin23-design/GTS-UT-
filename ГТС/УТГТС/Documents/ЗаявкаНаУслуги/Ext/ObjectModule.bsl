
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ДанныеЗаполнения) И ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
		
		ЗаказКлиента = ДанныеЗаполнения;
		
		Если НЕ ЗаказКлиента.Проведен Тогда
			ЗаказКлиента = "";
			Сообщить("Заказ клиента не проведен!");
			Возврат;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаявкаНаУслуги.Ссылка
		|ИЗ
		|	Документ.ЗаявкаНаУслуги КАК ЗаявкаНаУслуги
		|ГДЕ
		|	(НЕ ЗаявкаНаУслуги.ПометкаУдаления)
		|	И ЗаявкаНаУслуги.ЗаказКлиента = &ЗаказКлиента
		|	И ЗаявкаНаУслуги.Ссылка <> &Ссылка";
		Запрос.УстановитьПараметр("ЗаказКлиента", ЗаказКлиента);
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Сообщить("Внимание! На основании заказа клиента: " + ЗаказКлиента + " уже введены заявки на услуги: ");
			Выборка = Результат.Выбрать();
			Пока Выборка.Следующий() Цикл
				Сообщить(Выборка.Ссылка);
			КонецЦикла;
		КонецЕсли;	
		
		Товары.Очистить();
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Номенклатура,
		|	ЗаказКлиентаТовары.Упаковка,
		|	ЗаказКлиентаТовары.КоличествоУпаковок,
		|	ЗаказКлиентаТовары.Количество,
		|	ЗаказКлиентаТовары.Сумма КАК Сумма,
		|	ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры КАК ТипНоменклатуры
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка = &ЗаказКлиента
		|	И (НЕ ЗаказКлиентаТовары.Отменено)
		|	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)";
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СтрокаТЧ = Товары.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, Выборка);
			СтрокаТЧ.Цена = СтрокаТЧ.Сумма / СтрокаТЧ.Количество;
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(ЗаказКлиента.АдресДоставки) Тогда
			Адрес = ЗаказКлиента.АдресДоставки;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ЗаказКлиента.ДатаОтгрузки) Тогда
			ПланируемаяДатаВыполнения = ЗаказКлиента.ДатаОтгрузки;
		КонецЕсли;	
		Менеджер = ПараметрыСеанса.ТекущийПользователь;
		Организация = ЗаказКлиента.Организация;
	КонецЕсли;	
КонецПроцедуры
