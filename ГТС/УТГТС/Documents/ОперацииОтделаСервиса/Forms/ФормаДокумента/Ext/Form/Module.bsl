		УстановитьВидимость();	
		//Элементы.Группа1.Видимость = Ложь;
		//Элементы.Группа2.Видимость = Истина;
		//Элементы.ГруппаВыполненныеРаботы.Видимость= Истина;
		//
		//Элементы.ЗатраченноеВремя.Видимость = Истина;
		//Элементы.ГруппаРемонтируемаяНоменклатура.Видимость = Ложь; 		
