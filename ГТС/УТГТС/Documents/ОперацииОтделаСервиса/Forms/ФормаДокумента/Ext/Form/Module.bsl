КонецПроцедуры

&НаКлиенте
Процедура ПодборТоваров(Команда)
	
	СтруктураПараметров = ПолучитьСтруктуруПараметров();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Документ",   Объект.Ссылка);
	ПараметрыФормы.Вставить("Партнер",    Объект.Партнер);
	ПараметрыФормы.Вставить("Соглашение", СтруктураПараметров.Соглашение);
	ПараметрыФормы.Вставить("Склад",      Объект.Склад);
	ПараметрыФормы.Вставить("Валюта",     СтруктураПараметров.Валюта);
	ПараметрыФормы.Вставить("Дата",       Объект.Дата);
	ПараметрыФормы.Вставить("РежимПодбораБезСуммовыхПараметров",				Ложь);
	ПараметрыФормы.Вставить("РегистрироватьЦеныПоУсловиям",                 	Ложь);
	ПараметрыФормы.Вставить("РежимПодбораИспользоватьСкладыВТабличнойЧасти", 	Ложь);
	ПараметрыФормы.Вставить("РежимПодбораИсключитьГруппыДоступныеВЗаказах",  	Ложь);
	ПараметрыФормы.Вставить("РежимПодбораБезУслуг",                          	Ложь);
	Если Элементы.ВидРаботы.ТекстРедактирования ="Продажа запчастей" Тогда
		Элементы.Страницы.ТекущаяСтраница=Элементы.ГруппаВыполненныеРаботы;
	ИначеЕсли Элементы.ВидРаботы.ТекстРедактирования ="Подготовка техники" Тогда
		Элементы.Страницы.ТекущаяСтраница=Элементы.ГруппаТехника;
		
		
	КонецЕсли;
	
	ОткрытьФорму("Обработка.ПодборТоваровВДокументПродажи.Форма", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры

Функция ПолучитьСтруктуруПараметров()
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("Соглашение", Справочники.СоглашенияСКлиентами.НайтиПоНаименованию("СЛУЖЕБНОЕ",Истина));
	СтруктураПараметров.Вставить("Склад",      Справочники.Склады.ПустаяСсылка());
	СтруктураПараметров.Вставить("Валюта",     Константы.ВалютаРегламентированногоУчета.Получить());
	
	Возврат СтруктураПараметров
	
КонецФункции	

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	ИмяТабличнойЧасти = ЭтаФорма.ТекущийЭлемент.Имя;
	Адрес = ВыбранноеЗначение.АдресТоваровВХранилище;
	Если Элементы.Страницы.ТекущаяСтраница.Имя = "ГруппаРемонтируемаяНоменклатура" Тогда
		ИмяТабличнойЧасти = "РемонтируемаяНоменклатура";
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница.Имя = "ГруппаВыполненныеРаботы" Тогда	
		ИмяТабличнойЧасти = "ВыполненныеРаботы";
	КонецЕсли;	
	ЗаполнитьТЧИзВыбора(Адрес, ИмяТабличнойЧасти);	
КонецПроцедуры

Процедура ЗаполнитьТЧИзВыбора(Адрес, ИмяТЧ)
	Товары = ПолучитьИзВременногоХранилища(Адрес);
	Для Каждого СтрокаТЧ Из Товары Цикл
		НоваяСтрока = Объект[ИмяТЧ].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
	КонецЦикла;	
КонецПроцедуры	

