			Элементы.Группа8.Доступность=Истина;
			Элементы.Группа9.Доступность=Истина;
		ИначеЕсли Объект.СтатусЗаданияСервису=ПредопределенноеЗначение("Перечисление.СтатусыЗаданийСервиса.Отложено") Тогда
			Элементы.Группа9.Доступность=Истина;
