&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ТекущийОбъект.ВидРаботы=Справочники.ВидыРаботСервиса.Ремонт И НЕ ЗначениеЗаполнено(Объект.ПричинаОбращения) Тогда
		Сообщить ("Заполните причину обращения"); 
		Отказ=Истина;
	КонецЕсли;
    Если ТекущийОбъект.ВидРаботы=Справочники.ВидыРаботСервиса.Ремонт И НЕ ЗначениеЗаполнено(Объект.ВидРемонтаОбслуживания) Тогда
		Сообщить ("Выберите вид Ремонта/ТО");
		Отказ=Истина;
	КонецЕсли; 
	
	 Если ТекущийОбъект.ВидРаботы=Справочники.ВидыРаботСервиса.Ремонт И НЕ ЗначениеЗаполнено(Объект.СтатусЗаданияСервису) Тогда
		Сообщить ("Выберите статус ремонта");
		Отказ=Истина;
	КонецЕсли;
    Если ТекущийОбъект.ВидРаботы=Справочники.ВидыРаботСервиса.Ремонт И НЕ ЗначениеЗаполнено(Объект.КонтактноеЛицо) И Объект.Партнер.ЮрФизЛицо=Перечисления.КомпанияЧастноеЛицо.Компания Тогда
		Сообщить ("Выберите контактное лицо");
		Отказ=Истина;
	КонецЕсли;
	 Если ТекущийОбъект.ВидРаботы=Справочники.ВидыРаботСервиса.Ремонт И НЕ ЗначениеЗаполнено(Объект.Комментарий) Тогда
		Сообщить ("Укажите комментарий");
		Отказ=Истина;
	КонецЕсли;  
	 Если ТекущийОбъект.ВидРаботы=Справочники.ВидыРаботСервиса.Ремонт И Объект.НаличиеГарантии И НЕ ЗначениеЗаполнено(Объект.ДатаВыдачи) Тогда
		Сообщить ("Укажите дату выдачи гарантии");
		Отказ=Истина;
	КонецЕсли;
	Если ТекущийОбъект.ВидРаботы=Справочники.ВидыРаботСервиса.Ремонт И Объект.СтатусЗаданияСервису=перечисления.СтатусыЗаданийСервиса.Выполнено Тогда 
		Если НЕ ВыполнитьПроверкуНаличияГарантии() Тогда
			Отказ=Истина;
			Сообщить ("Укажите серийный номер ремонтируемой техники");
		КонецЕсли;  
		Если НЕ ЗначениеЗаполнено(Объект.МестоВыполненияРабот) Тогда
			Отказ=Истина;
			Сообщить ("Заполните место выполнения работы");
		КонецЕсли;
		Если Объект.МестоВыполненияРабот="На выезде" И Объект.ВремяНаДорогу=0 Тогда
			Отказ=Истина;
			Сообщить ("Укажите время на дорогу");
		КонецЕсли;
    КонецЕсли;
	Если ТекущийОбъект.СтатусЗаданияСервису=Перечисления.СтатусыЗаданийСервиса.Выполнено И Объект.Мастера.Количество()=0 Тогда
		Отказ=Истина;
		Сообщить ("Укажите мастеров выполнявших работу")	
	КонецЕсли;
	Если ТекущийОбъект.СтатусЗаданияСервису=Перечисления.СтатусыЗаданийСервиса.Выполнено И НЕ ЗначениеЗаполнено(Объект.ДатаЗавершенияРабот) Тогда
		Отказ=Истина;
		Сообщить ("Укажите дату завершения работ")	
	КонецЕсли; 
	Если ТекущийОбъект.СтатусЗаданияСервису=Перечисления.СтатусыЗаданийСервиса.Выполнено И НЕ ЗначениеЗаполнено(Объект.ЗатраченноеВремя) Тогда
		Отказ=Истина;
		Сообщить ("Укажите время на работу")	
	КонецЕсли;
	СвойствоНормочасы = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Количество нормо-часов (Услуга)");
	ТекущийОбъект.Мастера.Свернуть("Мастер");	
КонецПроцедуры

