&НаСервере
Функция ВыполнитьПроверкуНаличияГарантии()    
	
	Итог=Истина;
	Если Объект.Дата>='20231001' 
		Тогда
		ОбъектФормы = РеквизитФормыВЗначение("Объект");
		Товары=ОбъектФормы.РемонтируемаяНоменклатура.Выгрузить();
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТЧ.Номенклатура КАК Номенклатура,
		               |	ТЧ.СерийныйНомер КАК СерийныйНомер
		               |ПОМЕСТИТЬ ТЧ
		               |ИЗ
		               |	&ТЧ КАК ТЧ
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТЧ.Номенклатура КАК Номенклатура,
		               |	Номенклатура1.ВидНоменклатуры.ИспользоватьСерии КАК ИспользоватьСерии,
		               |	ТЧ.СерийныйНомер КАК СерийныйНомер
		               |ИЗ
		               |	ТЧ КАК ТЧ
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура1
		               |		ПО ТЧ.Номенклатура = Номенклатура1.Ссылка
		               |ГДЕ
		               |	Номенклатура1.ВидНоменклатуры.ИспользоватьСерии = ИСТИНА
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ТЧ.Номенклатура,
		               |	Номенклатура1.ВидНоменклатуры.ИспользоватьСерии,
		               |	ТЧ.СерийныйНомер";
		Запрос.УстановитьПараметр("ТЧ", Товары);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Выборка.СерийныйНомер) И Выборка.ИспользоватьСерии=Истина Тогда
				Итог=Ложь;
				Прервать; 
				Иначе 
				Итог=Истина;
				Прервать;
		КонецЕсли;	
        КонецЦикла;
        Возврат Итог;
	КонецЕсли;  
	Возврат Итог;
КонецФункции


