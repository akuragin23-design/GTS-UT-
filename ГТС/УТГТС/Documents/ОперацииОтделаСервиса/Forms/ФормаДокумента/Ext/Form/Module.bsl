&НаКлиенте
Процедура Отложено(Команда)
	Если Элементы.ДатаПланируемойГотовности.ВыделенныйТекст="  .  .    " Тогда
		Сообщ=Новый СообщениеПользователю;
		Сообщ.Текст="Укажите дату планируемой готовности";
		Сообщ.Сообщить();
	Иначе
		ОтложеноНаСервере();
		ОбновитьОтображениеДанных(); 
		УстановитьДоступность();
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Выполнено(Команда)
	
	//АСист-Про       
	Если НЕ ПроверитьДатуЗавершенияНаСервере() Тогда
		// Если она не заполнена, сообщим об этом пользователю
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнена дата завершения работ или время на работу !";
		Сообщение.Поле = "ДатаЗавершенияРабот1";
		Сообщение.УстановитьДанные(ЭтаФорма);
		
		Сообщение.Сообщить();
		
		Возврат
	КонецЕсли;
	Если НЕ ПроверитьЗаполненностьСкладаГотовностиНаСервере() Тогда
		// Если он не заполнен, сообщим об этом пользователю
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не указан ""Склад готовности"" !";
		Сообщение.Поле = "СкладГотовности";
		Сообщение.УстановитьДанные(ЭтаФорма);
		
		Сообщение.Сообщить();
		
		Возврат
	КонецЕсли;
	
	ВыполненоСервисомНаСервере();
	ОбновитьОтображениеДанных(); 
	УстановитьДоступность();
	
КонецПроцедуры


&НаСервере
Функция ПроверитьДатуЗавершенияНаСервере() 
	Если Не ЗначениеЗаполнено(Объект.ДатаЗавершенияРабот) ИЛИ НЕ ЗначениеЗаполнено(Объект.ЗатраченноеВремя)  Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

  КонецФункции

&НаКлиенте
Процедура ОтправитьВСервис(Команда)
	Если Элементы.ДатаПлановойГотовности.ВыделенныйТекст="  .  .    " Тогда
		Сообщ=Новый СообщениеПользователю;
		Сообщ.Текст="Укажите дату плановой готовности";
		Сообщ.Сообщить();
	ИначеЕсли КомментарийМенеджера="" И Объект.Комментарий="" И Объект.КомментарийМенеджера="" Тогда
		Сообщ=Новый СообщениеПользователю;
		Сообщ.Текст="Укажите комментарий по подготовке техники";
		Сообщ.Сообщить(); 
	ИначеЕсли строка(Элементы.СкладГотовности)="" Тогда
		Сообщ=Новый СообщениеПользователю;
		Сообщ.Текст="Укажите склад по подготовке техники";
		Сообщ.Сообщить();
	ИначеЕсли НЕ ПроверитьРезервТехники() Тогда
		Сообщ=Новый СообщениеПользователю;
		Сообщ.Текст="Техника должна быть в резерве на складе готовности";
		Сообщ.Сообщить();
	Иначе
		ОтправитьВСервисНаСервере();
		ОбновитьОтображениеДанных(); 
		УстановитьДоступность() ;
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьЗаполненностьСкладаГотовностиНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.СкладГотовности) И (Объект.ВидРаботы = Справочники.ВидыРаботСервиса.ПодготовкаТехники ИЛИ  Объект.ВидРаботы = Справочники.ВидыРаботСервиса.УстановкаДопоборудования ИЛИ Объект.ВидРаботы=Справочники.ВидыРаботСервиса.СборкаТехникиНаВыезде) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	
КонецФункции

&НаСервере
Функция ПроверитьРезервТехники() 
	Если ЗначениеЗаполнено(Объект.ДокументОснование) И Объект.ВидРаботы<>Справочники.ВидыРаботСервиса.СборкаТехникиНаВыезде Тогда
		Для каждого СтрТехника из Объект.Техника Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
			|	ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения,
			|	ЗаказКлиентаТовары.Склад КАК Склад
			|ИЗ
			|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
			|ГДЕ
			|	ЗаказКлиентаТовары.Номенклатура = &Номенклатура
			|	И ЗаказКлиентаТовары.ВариантОбеспечения = &ВариантОбеспечения
			|	И ЗаказКлиентаТовары.Склад = &Склад
			|	И ЗаказКлиентаТовары.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", Объект.ДокументОснование);
		Запрос.УстановитьПараметр("Номенклатура", СтрТехника.Номенклатура);
		Запрос.УстановитьПараметр("ВариантОбеспечения", Перечисления.ВариантыОбеспечения.СоСклада);
		Запрос.УстановитьПараметр("Склад", Объект.СкладГотовности);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Возврат Истина;
		КонецЦикла;
		
		Возврат Ложь;
		КонецЦикла;  
	Иначе 
		Возврат Истина; 
	КонецЕсли;
		
КонецФункции


&НаСервере
Процедура ОтправитьВСервисНаСервере()
	Об=РеквизитФормыВЗначение("Объект");
	Об.МенеджерСервис=ПараметрыСеанса.ТекущийПользователь;
	Об.ДатаиВремяОтправкиЗадания=ТекущаяДата();
	Об.СтатусЗаданияСервису=Перечисления.СтатусыЗаданийСервиса.Отправлено;
	Об.Записать();
	ЗначениеВРеквизитФормы(Об,"Объект");
	
	БП = БизнесПроцессы.Задание.СоздатьБизнесПроцесс();
	БП.Автор = ПараметрыСеанса.ТекущийПользователь;
	БП.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
