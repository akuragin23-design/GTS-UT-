Функция СформироватьПечатнуюФормуНакладной(МассивОбъектов, ОбъектыПечати)
	
	Документ = МассивОбъектов[0];
	
	Макет = ПолучитьМакет("НакладнаяСервиса");
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ЗапросШапки = Новый Запрос;
	ЗапросШапки.УстановитьПараметр("Ссылка", Документ);
	
	ЗапросШапки.Текст = "ВЫБРАТЬ
	                    |	ОперацииОтделаСервиса.Номер КАК НомерДокумента,
	                    |	ОперацииОтделаСервиса.Контрагент.НаименованиеПолное Как Контрагент,
	                    |	КонтрагентыКонтактнаяИнформация.НомерТелефона КАК Контакты,
	                    |	КонтрагентыКонтактнаяИнформация.АдресЭП КАК АдресЭП,
	                    |	ОперацииОтделаСервиса.Менеджер КАК МенеджерСервис,
	                    |	ОперацииОтделаСервиса.ПричинаОбращения КАК ПричинаОбращения
	                    |ИЗ
	                    |	Документ.ОперацииОтделаСервиса КАК ОперацииОтделаСервиса
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	                    |		ПО ОперацииОтделаСервиса.Контрагент = КонтрагентыКонтактнаяИнформация.Ссылка
	                    |ГДЕ
	                    |	ОперацииОтделаСервиса.Ссылка = &Ссылка";
				   
	ВыборкаШапки = ЗапросШапки.Выполнить().Выбрать();
	ВыборкаШапки.Следующий();
	
	ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапки.Параметры.Заполнить(ВыборкаШапки);
	ОбластьШапки.Параметры.Гарантия=?(Документ.НаличиеГарантии=Истина,"!ГАРАНТИЯ!","");
	
	ТабличныйДокумент.Вывести(ОбластьШапки);
	
	ЗапросТоваров = Новый Запрос;
	ЗапросТоваров.УстановитьПараметр("Ссылка", Документ);
	
	ЗапросТоваров.Текст = "ВЫБРАТЬ
	                      |	ОперацииОтделаСервисаРемонтируемаяНоменклатура.Номенклатура,
	                      |	ОперацииОтделаСервисаРемонтируемаяНоменклатура.Количество
	                      |ИЗ
	                      |	Документ.ОперацииОтделаСервиса.РемонтируемаяНоменклатура КАК ОперацииОтделаСервисаРемонтируемаяНоменклатура
	                      |ГДЕ
	                      |	ОперацииОтделаСервисаРемонтируемаяНоменклатура.Ссылка = &Ссылка";
						  
	ВыборкаТоваров = ЗапросТоваров.Выполнить().Выбрать();
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Пока ВыборкаТоваров.Следующий() Цикл
		ОбластьСтрока.Параметры.Заполнить(ВыборкаТоваров);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;	
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.Заполнить(ВыборкаШапки);
	ОбластьПодвал.Параметры.Дата = Формат(Документ.Дата, "ДЛФ=Д");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьУсловия = Макет.ПолучитьОбласть("УсловияПриемаХранения");
	ОбластьУсловия.Параметры.Заполнить(ВыборкаШапки);
	ТабличныйДокумент.Вывести(ОбластьУсловия);

	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // СформироватьПечатнуюФорму()

Функция СформироватьПечатнуюФормуАкта(МассивОбъектов, ОбъектыПечати)
	
	Документ = МассивОбъектов[0];
	Макет = ПолучитьМакет("АктГарантия");
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ЗапросШапки = Новый Запрос;
	ЗапросШапки.УстановитьПараметр("Ссылка", Документ);
	
	ЗапросШапки.Текст = "ВЫБРАТЬ
	                    |	ОперацииОтделаСервиса.Номер,
	                    |	ОперацииОтделаСервиса.Контрагент.НаименованиеПолное Как Контрагент
	                    |ИЗ
	                    |	Документ.ОперацииОтделаСервиса КАК ОперацииОтделаСервиса
	                    |ГДЕ
	                    |	ОперацииОтделаСервиса.Ссылка = &Ссылка";
						
	ВыборкаШапки = ЗапросШапки.Выполнить().Выбрать();
	ВыборкаШапки.Следующий();
	
	ОбластьШапки = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапки.Параметры.Заполнить(ВыборкаШапки);
	ОбластьШапки.Параметры.Дата = Формат(Документ.Дата, "ДЛФ=Д");
	
	ТабличныйДокумент.Вывести(ОбластьШапки);
	
	ЗапросНоменклатуры = Новый Запрос;
	ЗапросНоменклатуры.УстановитьПараметр("Ссылка", Документ);
	
	ЗапросНоменклатуры.Текст = "ВЫБРАТЬ
	                           |	ОперацииОтделаСервисаВыполненныеРаботы.НомерСтроки,
	                           |	ОперацииОтделаСервисаВыполненныеРаботы.Номенклатура,
	                           |	ОперацииОтделаСервисаВыполненныеРаботы.Номенклатура.ЕдиницаИзмерения КАК ЕдИзм,
	                           |	ОперацииОтделаСервисаВыполненныеРаботы.Количество
	                           |ИЗ
	                           |	Документ.ОперацииОтделаСервиса.ВыполненныеРаботы КАК ОперацииОтделаСервисаВыполненныеРаботы
	                           |ГДЕ
	                           |	ОперацииОтделаСервисаВыполненныеРаботы.Ссылка = &Ссылка";
							   
	ВыборкаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выбрать();
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Пока ВыборкаНоменклатуры.Следующий() Цикл
		ОбластьСтрока.Параметры.Заполнить(ВыборкаНоменклатуры);
		ТабличныйДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;	

	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
	Возврат ТабличныйДокумент;
	
КонецФункции	         

