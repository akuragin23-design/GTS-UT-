Функция ПолучениеДанных(Документ,Параметр);
	Если параметр = "ссылка" тогда
		Возврат Документ.Ссылка;
	ИначеЕсли параметр = "склад" тогда
		Возврат Документ.Склад;
	ИначеЕсли параметр = "партнер" тогда
		Возврат Документ.Партнер;
	ИначеЕсли параметр = "ответственный" тогда
		Возврат Документ.Менеджер;
	ИначеЕсли параметр = "комментарий" тогда
		Возврат Документ.Комментарий;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучениеТЧ(Документ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПриобретениеТоваровУслугТовары.НомерСтроки КАК НомерСтроки,
	|	ПриобретениеТоваровУслугТовары.Номенклатура КАК Номенклатура,
	|	ПриобретениеТоваровУслугТовары.Количество КАК Количество,
	|	ПриобретениеТоваровУслугТовары.Упаковка КАК Упаковка,
	|	ПриобретениеТоваровУслугТовары.Назначение КАК Назначение,
	|	ПриобретениеТоваровУслугТовары.ASP_ЗаказКлиента КАК ЗаказКлиента,
	|	ПриобретениеТоваровУслугТовары.ASP_ЗаказКлиента.Менеджер КАК Менеджер
	|ИЗ
	|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
	|ГДЕ
	|	ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПриобретениеТоваровУслугТовары.Номенклатура.Наименование";
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Текст= "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Текст= Текст + ВыборкаДетальныеЗаписи.Количество  + Символы.Таб + "шт." + Символы.Таб + ВыборкаДетальныеЗаписи.Номенклатура + Символы.Таб + ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Назначение),ВыборкаДетальныеЗаписи.Назначение,строка(строка(ВыборкаДетальныеЗаписи.ЗаказКлиента) + " " + строка(ВыборкаДетальныеЗаписи.Менеджер))) +  Символы.ПС;
	КонецЦикла;
	
	
	Возврат Текст;
КонецФункции



Функция ТаблицаЗначенийВМассив(ТаблицаЗначений) Экспорт
	
	Массив = Новый Массив();
	СтруктураСтрокой = "";
	НужнаЗапятая = Ложь;
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		Если НужнаЗапятая Тогда
			СтруктураСтрокой = СтруктураСтрокой + ",";
		КонецЕсли;
		СтруктураСтрокой = СтруктураСтрокой + Колонка.Имя;
		НужнаЗапятая = Истина;
	КонецЦикла;
	Для Каждого Строка Из ТаблицаЗначений Цикл
		НоваяСтрока = Новый Структура(СтруктураСтрокой);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		Массив.Добавить(НоваяСтрока);
	КонецЦикла;
	Возврат Массив;
	
КонецФункции
