
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		Объект.Ответственный = ПараметрыСеанса.ТекущийПользователь;
		Объект.Подразделение = ПараметрыСеанса.ТекущийПользователь.Подразделение;
		
	КонецЕсли; 
	Объект.СтатусСклада=Перечисления.СтатусыЗаявокНаВывоз.НеПодтверждено;
	Если НЕ (РольДоступна("ASP_УправлениеЗаявкамиНаВывоз") ИЛИ РольДоступна("ПолныеПрава")) Тогда
		Элементы.ДокументыВзятьВРаботу.Видимость=ложь; 
		
	КонецЕсли;
	ДатаГрафика=ПолучитьСледующийРабочийДень();
	Если ЗначениеЗаполнено(Объект.Ссылка) и 
		//НачалоДня(Объект.ДатаВывоза)<=ДатаГрафика И ТекущаяДата()>ДатаГрафика-60*60*8 И 
		ЗначениеЗаполнено(Объект.ДатаВывоза) И НЕ РольДоступна("ASP_УправлениеЗаявкамиНаВывоз") Тогда
		Элементы.ДатаВывоза.ТолькоПросмотр=Истина;
	КонецЕсли;
	//Вес = ПересчитатьВес();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	если НЕ 
		(РольДоступна("ASP_УправлениеЗаявкамиНаВывоз") ИЛИ РольДоступна("ПолныеПрава")) и НЕ Параметры.Ключ.Пустая() Тогда
		ДатаГрафика=ПолучитьСледующийРабочийДень();     
		Если (НачалоДня(Объект.ДатаВывоза)<=ДатаГрафика И ТекущаяДата()>ДатаГрафика-60*60*8) ИЛИ (ТекущаяДата()>НачалоДня(Объект.ДатаВывоза)-60*60*8) Тогда
			
			Элементы.Документы.ТолькоПросмотр=Истина;
			Элементы.Документы.КоманднаяПанель.Видимость=Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если (РольДоступна("ASP_УправлениеЗаявкамиНаВывоз") ИЛИ РольДоступна("ПолныеПрава"))  Тогда
		Элементы.СтатусСклада.ТолькоПросмотр=Ложь;
		Элементы.ТранспортныеЗатраты.Видимость=Истина;
	КонецЕсли;                                       
	
	//Добавлено 27.04.2025
	Если НЕ ЗначениеЗаполнено(Объект.СкладВывоза) Тогда
		Объект.СкладВывоза=Справочники.Склады.НайтиПоНаименованию("Склад временного хранения г.ТАЛДОМ",Истина,,);
	КонецЕсли;
	
	// СтандартныеПодсистемы.РаботаСФайлами
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСФайлами") Тогда
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		ГиперссылкаФайлов = МодульРаботаСФайлами.ГиперссылкаФайлов();
		ГиперссылкаФайлов.Размещение = "КоманднаяПанель";
		МодульРаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ГиперссылкаФайлов);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	
	//ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	//СобытияФорм.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	
КонецПроцедуры

