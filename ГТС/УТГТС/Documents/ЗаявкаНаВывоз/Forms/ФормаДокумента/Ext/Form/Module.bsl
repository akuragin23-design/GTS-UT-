	//Вес = ПересчитатьВес();
	Объект.ВесПоДокументам=ПересчитатьВес();
	
КонецПроцедуры

&НаСервере
Функция ПересчитатьВес();
	тз = Объект.Документы.Выгрузить();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	тз.Документ КАК Документ
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&тз КАК тз
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Документ КАК Документ
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("тз", тз);
	
	//Запрос = Новый Запрос;
	//Запрос.Текст =
	//"ВЫБРАТЬ
	//|	ЗаявкаНаВывозДокументы.Документ КАК Документ
	//|ИЗ
	//|	Документ.ЗаявкаНаВывоз.Документы КАК ЗаявкаНаВывозДокументы
	//|ГДЕ
	//|	ЗаявкаНаВывозДокументы.Ссылка В (&Ссылка)";
	//Запрос.Параметры.Вставить("Ссылка", Объект.Ссылка);
	СписокДокументов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Документ");
	
	
	
	Запрос1 = Новый Запрос;
	Запрос1.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ТоварыКОтгрузке.КОтгрузке) КАК Количество,
	|	ТоварыКОтгрузке.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыКОтгрузке.Номенклатура.ВесЗнаменатель, 1) > 0
	|			ТОГДА ТоварыКОтгрузке.Номенклатура.ВесЧислитель / ЕСТЬNULL(ТоварыКОтгрузке.Номенклатура.ВесЗнаменатель, 1)
	|		ИНАЧЕ ТоварыКОтгрузке.Номенклатура.ВесЧислитель
	|	КОНЕЦ КАК Вес
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке КАК ТоварыКОтгрузке
	|ГДЕ
	|	ТоварыКОтгрузке.Регистратор В(&СписокДокументов)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыКОтгрузке.Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ТоварыКОтгрузке.Номенклатура.ВесЗнаменатель, 1) > 0
	|			ТОГДА ТоварыКОтгрузке.Номенклатура.ВесЧислитель / ЕСТЬNULL(ТоварыКОтгрузке.Номенклатура.ВесЗнаменатель, 1)
	|		ИНАЧЕ ТоварыКОтгрузке.Номенклатура.ВесЧислитель
	|	КОНЕЦ";
	
	Запрос1.УстановитьПараметр("СписокДокументов", СписокДокументов);
	
	РезультатЗапроса1 = Запрос1.Выполнить();
	
	ВыборкаДетальныеЗаписи1 = РезультатЗапроса1.Выбрать();
	Вес = 0;
	Пока ВыборкаДетальныеЗаписи1.Следующий() Цикл
		Вес = Вес+ВыборкаДетальныеЗаписи1.Вес*ВыборкаДетальныеЗаписи1.Количество;
	КонецЦикла;
	Возврат Вес;
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.ВесПоДокументам=ПересчитатьВес();
	Объект.ВесПоДокументам=ПересчитатьВес();
	если НЕ 
		(РольДоступна("ASP_УправлениеЗаявкамиНаВывоз") ИЛИ РольДоступна("ПолныеПрава")) Тогда
		Отказ = ПроверитьДокументы(Объект.Документы.Выгрузить(,"Документ"));
		ДатаГрафика=ПолучитьСледующийРабочийДень();
		ТестоваяДата=ДатаГрафика-60*60*8;
		Если (НачалоДня(Объект.ДатаВывоза)<=ДатаГрафика И ТекущаяДата()>ДатаГрафика-60*60*8) ИЛИ (ТекущаяДата()>НачалоДня(Объект.ДатаВывоза)-60*60*8) Тогда
			Сообщить("Заявку нельзя менять позднее 16.00 дня накануне вывоза");
			Отказ = Истина;
		КонецЕсли; 
		Если  НЕ 
			(РольДоступна("ASP_УправлениеЗаявкамиНаВывоз") ИЛИ РольДоступна("ПолныеПрава")) И ПолучитьВесУжеСуществующихЗаявок(Объект.ДатаВывоза)+?(Объект.Ссылка.Пустая(),Объект.Вес,0)>61000 
			Тогда Отказ = Истина;  
			Сообщить("На данный период нельзя записать более 60 тонн для вывоза, свяжитесь с ответственным по складу или скорректируйте количество и вес вывозимого товара.");
		Иначе    
		КонецЕсли;
	Иначе  
		если НЕ Объект.Статус=Перечисления.СтатусыЗаявокНаТранспорт.Отменено Тогда
			Отказ = ПроверитьДокументы(Объект.Документы.Выгрузить(,"Документ"));
		КонецЕсли;
	Конецесли;
	//
	//Отказ = ПроверитьДокументы(Объект.Документы.Выгрузить(,"Документ"));
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДокументы(ДокументыЗаявки);
	если ДокументыЗаявки.Количество()>0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаВывозДокументы.Документ КАК Документ
		|ИЗ
		|	Документ.ЗаявкаНаВывоз.Документы КАК ЗаявкаНаВывозДокументы
		|ГДЕ
		|	ЗаявкаНаВывозДокументы.Документ В(&Документы)
		|	И ЗаявкаНаВывозДокументы.Ссылка <> &Ссылка
		|	И ЗаявкаНаВывозДокументы.Ссылка.Статус = &Статус";
		
		Запрос.УстановитьПараметр("Документы", ДокументыЗаявки);
		Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
		Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаявокНаТранспорт.КВыполнению);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			сообщить("Нельзя один документ отгрузки привязывать к нескольким заявкам на вывоз, если они имеют статус к выполнению.");
			Возврат Истина;
		КонецЦикла;
		
		Возврат ложь;
	Иначе
		Возврат ложь;
	КонецЕсли
	
КонецФункции

Функция ПолучитьВесУжеСуществующихЗаявок(ДатаВывоза)
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ЗаявкаНаВывоз.Вес) КАК Вес,
	|	НАЧАЛОПЕРИОДА(ЗаявкаНаВывоз.ДатаВывоза, ДЕНЬ) КАК ДатаВывоза
	|ИЗ
	|	Документ.ЗаявкаНаВывоз КАК ЗаявкаНаВывоз
	|ГДЕ
	|	ЗаявкаНаВывоз.ДатаВывоза = &ДатаВывоза
	|	И ЗаявкаНаВывоз.Ссылка <> &Ссылка
	|	И ЗаявкаНаВывоз.Статус = &Статус
	|	И ЗаявкаНаВывоз.Проведен = ИСТИНА
	|	И ЗаявкаНаВывоз.СтатусСклада <> &СтатусСклада
	|	И ЗаявкаНаВывоз.СкладВывоза = &СкладВывоза
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗаявкаНаВывоз.ДатаВывоза";
	
	Запрос.УстановитьПараметр("ДатаВывоза", НачалоДня(ДатаВывоза));
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка); 
	Запрос.УстановитьПараметр("Статус", Перечисления.СтатусыЗаявокНаТранспорт.КВыполнению); 
	Запрос.УстановитьПараметр("СтатусСклада", Перечисления.СтатусыЗаявокНаВывоз.Отменено);
	Запрос.УстановитьПараметр("СкладВывоза", Справочники.Склады.НайтиПоНаименованию("Склад временного хранения г.ТАЛДОМ",Истина,,));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СуммаВесаДляВывоза=0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СуммаВесаДляВывоза=СуммаВесаДляВывоза+ВыборкаДетальныеЗаписи.Вес;
	КонецЦикла;
	Возврат СуммаВесаДляВывоза;
	
КонецФункции

&НаСервере
Процедура ВзятьВРаботуНаСервере()
	Для каждого Стр из Объект.Документы Цикл
		Если НЕ значениезаполнено(Стр.Документ.ПринятоВРаботу) тогда
			ДокОбъект = Стр.Документ.ПолучитьОбъект();
			ДокОбъект.ПринятоВРаботу = текущаядата();
			ДокОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


