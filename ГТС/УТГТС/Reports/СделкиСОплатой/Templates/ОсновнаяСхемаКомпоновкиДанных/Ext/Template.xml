		<query>ВЫБРАТЬ
	СделкиСКлиентами.Ссылка КАК Ссылка,
	СделкиСКлиентами.ДатаНачала КАК ДатаНачала,
	СделкиСКлиентами.Статус КАК Статус,
	СделкиСКлиентами.Ответственный КАК Ответственный,
	СделкиСКлиентами.Ответственный.Подразделение КАК ОтветственныйТекущееПодразделение,
	СделкиСКлиентами.ПотенциальнаяСуммаПродажи КАК ПотенциальнаяСуммаПродажи,
	ИсточникиПервичногоИнтереса.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
	ИсточникиПервичногоИнтереса.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
	МаркетинговыеМероприятия.Ссылка КАК МаркетинговыеМероприятия,
	СделкиСКлиентами.Комментарий КАК Комментарий,
	СделкиСКлиентами.ПричинаПроигрышаСделки КАК ПричинаПроигрышаСделки,
	СделкиСКлиентами.СпособОбращения КАК СпособОбращения,
	СделкиСКлиентами.КодКлиента КАК КодКлиента,
	СделкиСКлиентами.Проектировщик КАК Проектировщик,
	СделкиСКлиентами.БизнесРегион КАК БизнесРегион,
	ПромокодСрезПоследних.promocode КАК promocode,
	ПромокодСрезПоследних.campaign КАК campaign,
	ПромокодСрезПоследних.source КАК source,
	ПромокодСрезПоследних.medium КАК medium,
	ПромокодСрезПоследних.keyword КАК keyword,
	СделкиСКлиентами.ТелефонныйЗвонок.АбонентКакСвязаться КАК НомерТелефона
ПОМЕСТИТЬ Сделки
ИЗ
	Справочник.СделкиСКлиентами КАК СделкиСКлиентами
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсточникиПервичногоИнтереса КАК ИсточникиПервичногоИнтереса
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МаркетинговыеМероприятия КАК МаркетинговыеМероприятия
			ПО ИсточникиПервичногоИнтереса.ИсточникПервичногоИнтереса = МаркетинговыеМероприятия.Ссылка
		ПО СделкиСКлиентами.Ссылка = ИсточникиПервичногоИнтереса.Сделка
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Промокод.СрезПоследних(&amp;ДатаОкончания {(&amp;ДатаОкончания)}, Период &gt; ДОБАВИТЬКДАТЕ(&amp;ДатаНачала, МЕСЯЦ, -2)) КАК ПромокодСрезПоследних
		ПО СделкиСКлиентами.КодКлиента = ПромокодСрезПоследних.promocode
ГДЕ
	СделкиСКлиентами.ДатаНачала МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ссылка КАК Ссылка,
	ЗаказКлиента.Сделка КАК Сделка,
	ЗаказКлиента.СуммаДокумента КАК СуммаДокумента
ПОМЕСТИТЬ Заказы
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Дата &gt; &amp;ДатаНачала
	И ЗаказКлиента.Сделка В
			(ВЫБРАТЬ
				Сделки.Ссылка
			ИЗ
				Сделки КАК Сделки)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РасчетыСКлиентами.УдалитьЗаказКлиента КАК ЗаказКлиента,
	СУММА(РасчетыСКлиентами.Сумма) КАК Сумма
ПОМЕСТИТЬ Расчеты
ИЗ
	РегистрНакопления.РасчетыСКлиентами КАК РасчетыСКлиентами
ГДЕ
	РасчетыСКлиентами.Период &gt; &amp;ДатаНачала
	И РасчетыСКлиентами.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента)
	И РасчетыСКлиентами.Сумма &gt; 0
	И РасчетыСКлиентами.УдалитьЗаказКлиента В
			(ВЫБРАТЬ
				Заказы.Ссылка
			ИЗ
				Заказы КАК Заказы)

СГРУППИРОВАТЬ ПО
	РасчетыСКлиентами.УдалитьЗаказКлиента
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СделкиСКлиентамиИнтересПоСегментамНоменклатуры.СегментНоменклатуры КАК СегментНоменклатуры,
	СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка КАК Ссылка
ПОМЕСТИТЬ СегментыНом
ИЗ
	Справочник.СделкиСКлиентами.ИнтересПоСегментамНоменклатуры КАК СделкиСКлиентамиИнтересПоСегментамНоменклатуры
{ГДЕ
	(СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка В
				(ВЫБРАТЬ
					Сделки.Ссылка
				ИЗ
					Сделки КАК Сделки)
			И СделкиСКлиентамиИнтересПоСегментамНоменклатуры.СегментНоменклатуры В ИЕРАРХИИ (&amp;СегментыНоменклатуры))}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Сделки.Ссылка КАК Сделка,
	Сделки.ДатаНачала КАК ДатаНачала,
	Сделки.Статус КАК Статус,
	Сделки.Ответственный КАК Ответственный,
	Сделки.ПотенциальнаяСуммаПродажи КАК ПотенциальнаяСуммаПродажи,
	Сделки.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
	СУММА(Заказы.СуммаДокумента) КАК СуммаЗаказов,
	СУММА(Расчеты.Сумма) КАК СуммаОплаты,
	Сделки.ОтветственныйТекущееПодразделение КАК ОтветственныйТекущееПодразделение,
	Сделки.МаркетинговыеМероприятия КАК МаркетинговыеМероприятия,
	Сделки.ПричинаПроигрышаСделки КАК ПричинаПроигрышаСделки,
	Сделки.СпособОбращения КАК СпособОбращения,
	Сделки.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
	ВЫРАЗИТЬ(Сделки.Комментарий КАК СТРОКА(500)) КАК Комментарий,
	Сделки.КодКлиента КАК КодКлиента,
	Сделки.БизнесРегион КАК БизнесРегион,
	Сделки.campaign КАК campaign,
	Сделки.source КАК source,
	Сделки.medium КАК medium,
	Сделки.keyword КАК keyword,
	Сделки.Проектировщик КАК Проектировщик,
	Сделки.НомерТелефона КАК НомерТелефона
ИЗ
	Сделки КАК Сделки
		ЛЕВОЕ СОЕДИНЕНИЕ Заказы КАК Заказы
			ЛЕВОЕ СОЕДИНЕНИЕ Расчеты КАК Расчеты
			ПО Заказы.Ссылка = Расчеты.ЗаказКлиента
		ПО Сделки.Ссылка = Заказы.Сделка
ГДЕ
	Сделки.Ссылка В
			(ВЫБРАТЬ
				СегментыНом.Ссылка
			ИЗ
				СегментыНом КАК СегментыНом)

СГРУППИРОВАТЬ ПО
	Сделки.Ссылка,
	Сделки.ДатаНачала,
	Сделки.Статус,
	Сделки.Ответственный,
	Сделки.ПотенциальнаяСуммаПродажи,
	Сделки.ИсточникПервичногоИнтереса,
	Сделки.ОтветственныйТекущееПодразделение,
	Сделки.МаркетинговыеМероприятия,
	Сделки.ПричинаПроигрышаСделки,
	Сделки.СпособОбращения,
	Сделки.КаналПервичногоИнтереса,
	ВЫРАЗИТЬ(Сделки.Комментарий КАК СТРОКА(500)),
	Сделки.КодКлиента,
	Сделки.БизнесРегион,
	Сделки.campaign,
	Сделки.source,
	Сделки.medium,
	Сделки.keyword,
	Сделки.Проектировщик,
	Сделки.НомерТелефона</query>
	</dataSet>
	<parameter>
		<name>ДатаНачала</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
