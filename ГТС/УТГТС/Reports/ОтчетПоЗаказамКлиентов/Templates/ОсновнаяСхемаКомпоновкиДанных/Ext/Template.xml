		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА РасчетыСКлиентамиОстаткиИОбороты.СуммаРасход &gt; 0
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Оплачен,
	ВЫБОР
		КОГДА РасчетыСКлиентамиОстаткиИОбороты.СуммаРасход &gt; 0
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоОплаченных,
	ЕСТЬNULL(РасчетыСКлиентамиОстаткиИОбороты.КОплатеКонечныйОстаток, 0) * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) КАК Долг,
	ЕСТЬNULL(РасчетыСКлиентамиОстаткиИОбороты.СуммаРасход, 0) * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) КАК СуммаОплаты,
	ЗаказыКлиентов.ЗаказКлиента КАК ЗаказКлиента,
	ЗаказыКлиентов.ОбъектРасчетов КАК ОбъектРасчетов,
	ЗаказыКлиентов.Дата КАК Дата,
	ЗаказыКлиентов.Менеджер КАК Менеджер,
	ЗаказыКлиентов.Подразделение КАК Подразделение,
	ЗаказыКлиентов.Реклама КАК Реклама,
	ЗаказыКлиентов.Сумма КАК Сумма,
	1 КАК ВсегоЗаказов,
	ЗаказыКлиентов.ЗаказКлиента.Товары.(
		Номенклатура КАК Номенклатура,
		НоменклатураНабора КАК НоменклатураНабора,
		Количество КАК Количество,
		ПроцентРучнойСкидки КАК ПроцентРучнойСкидки,
		СуммаРучнойСкидки + СуммаАвтоматическойСкидки КАК СуммаСкидки,
		Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		Номенклатура.Артикул КАК Артикул,
		НомерСтроки КАК НомерСтрокиНоменклатуры,
		Обособленно КАК Обособленно,
		Комментарий КАК НоменклатураКомментарий
	) КАК ЗаказКлиента1,
	ЕСТЬNULL(РасчетыСКлиентамиОстаткиИОбороты.КОтгрузкеПриход, 0) * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1) КАК Отгружено,
	ВЫБОР
		КОГДА РасчетыСКлиентамиОстаткиИОбороты.КОтгрузкеПриход = 0
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК КоличествоНеОтгруженных,
	МаркетинговыеМероприятия.Ссылка КАК МаркетинговыеМероприятия
ИЗ
	(ВЫБРАТЬ
		ЗаказКлиентаТовары.Ссылка.ОбъектРасчетов КАК ОбъектРасчетов,
		ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
		ЗаказКлиентаТовары.Ссылка.Дата КАК Дата,
		ЗаказКлиентаТовары.Ссылка.Менеджер КАК Менеджер,
		ЗаказКлиентаТовары.Ссылка.Менеджер.Подразделение КАК Подразделение,
		ЗаказКлиентаТовары.Ссылка.ИсточникПервичногоИнтереса КАК Реклама,
		СУММА((ВЫБОР
				КОГДА ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
					ТОГДА ЗаказКлиентаТовары.Сумма
				КОГДА ЗаказКлиентаТовары.Отменено
					ТОГДА 0
				ИНАЧЕ ЗаказКлиентаТовары.Сумма
			КОНЕЦ + ВЫБОР
				КОГДА НЕ ЗаказКлиентаТовары.Ссылка.ЦенаВключаетНДС
					ТОГДА ВЫБОР
							КОГДА ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
								ТОГДА ЗаказКлиентаТовары.СуммаНДС
							КОГДА ЗаказКлиентаТовары.Отменено
								ТОГДА 0
							ИНАЧЕ ЗаказКлиентаТовары.СуммаНДС
						КОНЕЦ
				ИНАЧЕ 0
			КОНЕЦ) * ЕСТЬNULL(КурсыВалютСрезПоследних.Курс, 1)) КАК Сумма
	ИЗ
		Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних({(&amp;ТекущаяДата)}, ) КАК КурсыВалютСрезПоследних
			ПО ЗаказКлиентаТовары.Ссылка.Валюта = КурсыВалютСрезПоследних.Валюта
	ГДЕ
		ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &amp;НачДата И &amp;КонДата
		И ЗаказКлиентаТовары.Ссылка.Проведен
	
	СГРУППИРОВАТЬ ПО
		ЗаказКлиентаТовары.Ссылка,
		ЗаказКлиентаТовары.Ссылка.Дата,
		ЗаказКлиентаТовары.Ссылка.Менеджер,
		ЗаказКлиентаТовары.Ссылка.Менеджер.Подразделение,
		ЗаказКлиентаТовары.Ссылка.ИсточникПервичногоИнтереса,
		ЗаказКлиентаТовары.Ссылка.ОбъектРасчетов) КАК ЗаказыКлиентов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентами.ОстаткиИОбороты(
				,
				,
				Период,
				ДвиженияИГраницыПериода,
				ОбъектРасчетов.Объект ССЫЛКА Документ.ЗаказКлиента
					И ОбъектРасчетов.Объект.Дата &gt;= &amp;НачДата
					И ОбъектРасчетов.Объект.Дата &lt;= &amp;КонДата) КАК РасчетыСКлиентамиОстаткиИОбороты
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних({(&amp;ТекущаяДата)}, ) КАК КурсыВалютСрезПоследних
			ПО РасчетыСКлиентамиОстаткиИОбороты.Валюта = КурсыВалютСрезПоследних.Валюта
		ПО ЗаказыКлиентов.ОбъектРасчетов = РасчетыСКлиентамиОстаткиИОбороты.ОбъектРасчетов
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МаркетинговыеМероприятия КАК МаркетинговыеМероприятия
		ПО ЗаказыКлиентов.ЗаказКлиента.ИсточникПервичногоИнтереса = МаркетинговыеМероприятия.Ссылка</query>
	</dataSet>
	<calculatedField>
		<dataPath>[% Отгрузки]</dataPath>
		<expression>(Отгружено/Сумма)*100</expression>
		<title xsi:type="v8:LocalStringType">
