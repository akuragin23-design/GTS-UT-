			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>[% Оплаты]</dataPath>
		<expression>(СуммаОплаты/Сумма)*100</expression>
		<title xsi:type="v8:LocalStringType">
