		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СУММА(Оплаты.Сумма) КАК Сумма,
	Оплаты.Регистратор КАК Регистратор,
	Оплаты.Контрагент КАК Контрагент,
	Оплаты.Период КАК Период,           
	Оплаты.ЗаказКлиента КАК ЗаказКлиента
ПОМЕСТИТЬ Расчеты
ИЗ
	(ВЫБРАТЬ
		Поступление.Сумма КАК Сумма,
		Поступление.Ссылка КАК Регистратор,
		Поступление.Ссылка.Контрагент КАК Контрагент,
		Поступление.Ссылка.Дата КАК Период,
		ВЫРАЗИТЬ(Поступление.ОснованиеПлатежа КАК Документ.ЗаказКлиента) КАК ЗаказКлиента
	ИЗ
		Документ.ПоступлениеБезналичныхДенежныхСредств.РасшифровкаПлатежа КАК Поступление
	ГДЕ
		Поступление.Ссылка.Проведен
		И Поступление.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		И Поступление.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента)
		И ТИПЗНАЧЕНИЯ(Поступление.ОснованиеПлатежа) = ТИП(Документ.ЗаказКлиента)
		И Поступление.Сумма &gt; 0
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ПКО.Сумма,
		ПКО.Ссылка,
		ПКО.Ссылка.Контрагент,
		ПКО.Ссылка.Дата,
		ВЫРАЗИТЬ(ПКО.ОснованиеПлатежа КАК Документ.ЗаказКлиента)
	ИЗ
		Документ.ПриходныйКассовыйОрдер.РасшифровкаПлатежа КАК ПКО
	ГДЕ
		ПКО.Ссылка.Проведен
		И ПКО.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		И ПКО.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиента)
		И ТИПЗНАЧЕНИЯ(ПКО.ОснованиеПлатежа) = ТИП(Документ.ЗаказКлиента)
		И ПКО.Сумма &gt; 0
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		ОперацияПоКарте.Сумма,
		ОперацияПоКарте.Ссылка,
		ОперацияПоКарте.Ссылка.Контрагент,
		ОперацияПоКарте.Ссылка.Дата,
		ВЫРАЗИТЬ(ОперацияПоКарте.ОснованиеПлатежа КАК Документ.ЗаказКлиента)
	ИЗ
		Документ.ОперацияПоПлатежнойКарте.РасшифровкаПлатежа КАК ОперацияПоКарте
	ГДЕ
		ОперацияПоКарте.Ссылка.Проведен
		И ОперацияПоКарте.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
		И ОперацияПоКарте.Ссылка.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.ПоступлениеОплатыОтКлиентаПоПлатежнойКарте)
		И ТИПЗНАЧЕНИЯ(ОперацияПоКарте.ОснованиеПлатежа) = ТИП(Документ.ЗаказКлиента)
		И ОперацияПоКарте.Сумма &gt; 0) КАК Оплаты

СГРУППИРОВАТЬ ПО
	Оплаты.Регистратор,
	Оплаты.Контрагент,
	Оплаты.Период,
	Оплаты.ЗаказКлиента

ИНДЕКСИРОВАТЬ ПО
	ЗаказКлиента
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиента.Ссылка КАК Заказ,
	ЗаказКлиента.СуммаДокумента КАК СуммаДокумента,
	ЗаказКлиента.Менеджер КАК Менеджер,
	ЗаказКлиента.Подразделение КАК Подразделение
ПОМЕСТИТЬ ЗаказыКлиентов
ИЗ
	Документ.ЗаказКлиента КАК ЗаказКлиента
ГДЕ
	ЗаказКлиента.Ссылка В
			(ВЫБРАТЬ
				Расчеты.ЗаказКлиента
			ИЗ
				Расчеты КАК Расчеты)

СГРУППИРОВАТЬ ПО
	ЗаказКлиента.Ссылка,
	ЗаказКлиента.СуммаДокумента,
	ЗаказКлиента.Менеджер,
	ЗаказКлиента.Подразделение

ИНДЕКСИРОВАТЬ ПО
	Заказ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	СУММА(ЗаказКлиентаТовары.Сумма) КАК Сумма
ПОМЕСТИТЬ НоменклатураПроцент
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
ГДЕ
	ЗаказКлиентаТовары.Ссылка В
			(ВЫБРАТЬ
				ЗаказыКлиентов.Заказ
			ИЗ
				ЗаказыКлиентов КАК ЗаказыКлиентов)

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Номенклатура,
	ЗаказКлиентаТовары.Ссылка

ИНДЕКСИРОВАТЬ ПО
	ЗаказКлиентаТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказыКлиентов.Заказ КАК Заказ,
	ЗаказыКлиентов.Подразделение КАК Подразделение,
	ЗаказыКлиентов.Менеджер КАК Менеджер,
	Расчеты.Сумма КАК СуммаОплаты,
	ЗаказыКлиентов.СуммаДокумента КАК СуммаЗаказа,
	ВЫБОР
		КОГДА ЗаказыКлиентов.СуммаДокумента &lt;&gt; 0
			ТОГДА ВЫРАЗИТЬ(Расчеты.Сумма * НоменклатураПроцент.Сумма / ЗаказыКлиентов.СуммаДокумента КАК ЧИСЛО(10, 2))
		ИНАЧЕ 0
	КОНЕЦ КАК СуммаОплатыНоменклатуры,
	НоменклатураПроцент.Номенклатура КАК Номенклатура,
	Расчеты.Контрагент КАК Контрагент,
	Расчеты.Период КАК Период
ИЗ
	НоменклатураПроцент КАК НоменклатураПроцент
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗаказыКлиентов КАК ЗаказыКлиентов
			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Расчеты КАК Расчеты
			ПО ЗаказыКлиентов.Заказ = Расчеты.ЗаказКлиента
		ПО НоменклатураПроцент.Ссылка = ЗаказыКлиентов.Заказ</query>
