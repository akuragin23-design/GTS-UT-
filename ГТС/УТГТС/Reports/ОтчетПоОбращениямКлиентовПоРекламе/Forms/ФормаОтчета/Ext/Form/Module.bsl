// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЭтоРуководительОтделаПродаж = НЕ РольДоступна("ПолныеПрава") И НЕ РольДоступна("ОтчетыМаркетолога");
	
	Элементы.ФормаПоказатьСкрытьПараметры.Видимость = НЕ ЭтоРуководительОтделаПродаж;
	Элементы.ГруппаПараметры.Видимость = НЕ ЭтоРуководительОтделаПродаж;
	
	Группировки.Добавить("Подразделения",, НЕ ЭтоРуководительОтделаПродаж);
	Группировки.Добавить("Менеджеры",, ЭтоРуководительОтделаПродаж);
	Группировки.Добавить("Сегменты", "Сегменты номенклатуры", Ложь);
	Группировки.Добавить("Регионы",, Ложь);
	Группировки.Добавить("Реклама",, Истина);
	
	Периодичность = "ПоДням";
	
	ВидОтбораМенеджеры = "НеИспользоватьОтбор";
	Если ЭтоРуководительОтделаПродаж Тогда
		ВидОтбораПодразделения = "ВСписке";
		ОтборПодразделения.Очистить();
		ОтборПодразделения.Добавить(ПараметрыСеанса.ТекущийПользователь.Подразделение);
	Иначе
		ВидОтбораПодразделения = "НеИспользоватьОтбор";
	КонецЕсли;	
	
	
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД

&НаКлиенте
Процедура ПоказатьСкрытьПараметры(Команда)
	Элементы.ГруппаПараметры.Видимость = НЕ Элементы.ГруппаПараметры.Видимость;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
КонецПроцедуры


&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	ВариантыОтчетов.ПриСохраненииПользовательскихНастроекНаСервере(ЭтотОбъект, Настройки);
КонецПроцедуры

