&НаСервере
Процедура УдалитьПустыеЗначения(Список)
	ВсегоСтрок = Список.Количество();
	i = 0;
	Пока i < ВсегоСтрок Цикл
		ТекЭлемент = Список[i];
		Если НЕ ЗначениеЗаполнено(ТекЭлемент.Значение) Тогда
			Список.Удалить(ТекЭлемент);
			ВсегоСтрок = ВсегоСтрок - 1;
		Иначе
			i = i + 1;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры//УдалитьПустыеЗначения(Список)

&НаСервере
Процедура ДобавитьВеткуВДеревоДанныхНаСервере(Выборка, СтрокиДанных)
	
	Уровень = Выборка.Уровень();
	ЭлементГруппировки = СЗ_Группировки.Получить(Уровень);
	ИмяГруппировки = ЭлементГруппировки.Значение;
	
	Если НомерГруппировкиДоРегиона = -1 И ВыводитьРегионы Тогда
		// добавляем все регионы
		Для каждого ЭлементРегион Из СЗ_Регионы Цикл
			СтрокаДанныхРегион = СтрокиДанных.Добавить();
			СтрокаДанныхРегион.Параметр = ЭлементРегион.Значение;
		КонецЦикла;
		НомерГруппировкиДоРегиона = -2;
	ИначеЕсли НомерГруппировкиДоРекламы = -1 И ВыводитьРекламу Тогда
		// добавляем все рекламы
		Для каждого СтрокаКанал Из ДЗ_Реклама.ПолучитьЭлементы() Цикл
			СтрокаДанныхКанал = СтрокиДанных.Добавить();
			СтрокаДанныхКанал.Параметр = СтрокаКанал.Параметр;	
			Для каждого СтрокаИсточник Из СтрокаКанал.ПолучитьЭлементы() Цикл
				СтрокаДанныхИсточник = СтрокаДанныхКанал.Строки.Добавить();
				СтрокаДанныхИсточник.Параметр = СтрокаИсточник.Параметр;
			КонецЦикла;
		КонецЦикла;
		НомерГруппировкиДоРекламы = -2;
	ИначеЕсли НомерГруппировкиДоСегмента = -1 И ВыводитьСегменты Тогда
		// добавляем все сегменты
		Для каждого ЭлементСегмент Из ТЗ_Сегменты Цикл
			СтрокаДанныхСегмент = СтрокиДанных.Добавить();
			СтрокаДанныхСегмент.Параметр = ЭлементСегмент.Значение;
		КонецЦикла;
		НомерГруппировкиДоСегмента = -2;
	КонецЕсли;
			
	Пока Выборка.Следующий() Цикл
		Параметр = Выборка[ИмяГруппировки];
		//Если Уровень = НомерГруппировкиСреднее Тогда
		//	ПредстПериода = Формат(Выборка.НачалоПериода, "ДФ=dd_MM_yyyy");
		//Иначе	
			ПредстПериода = Формат(Выборка.Период, "ДФ=dd_MM_yyyy");
		//КонецЕсли;
				
		//Если Уровень = НомерГруппировкиСреднее Тогда
		//	СтрокиДанных.Родитель["НачПериодаКолво_" + ПредстПериода] = Выборка.Колво;
		//	Родитель = СтрокиДанных.Родитель.Родитель;
		//	Пока Родитель <> Неопределено Цикл
		//		Родитель["НачПериодаКолво_" + ПредстПериода] = Родитель.Строки.Итог("НачПериодаКолво_" + ПредстПериода);
		//		Родитель = Родитель.Родитель;
		//	КонецЦикла;	
		//	
		//	ВыборкаНиже = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		//	ДобавитьВеткуВДеревоДанныхНаСервере(ВыборкаНиже, СтрокиДанных);
		//Иначе
			Если Уровень = НомерГруппировкиПериода Тогда
			СтрокиДанных.Родитель["Колво_" + ПредстПериода] = Выборка.Колво;
			Родитель = СтрокиДанных.Родитель.Родитель;
			Пока Родитель <> Неопределено Цикл
				Родитель["Колво_" + ПредстПериода] = Родитель.Строки.Итог("Колво_" + ПредстПериода);
				Родитель = Родитель.Родитель;
			КонецЦикла;	
		Иначе	
			СтрокаДанные = СтрокиДанных.Найти(Параметр,"Параметр");
			Если СтрокаДанные = Неопределено Тогда
				СтрокаДанные = СтрокиДанных.Добавить();
			КонецЕсли;	
			СтрокаДанные.Параметр = Параметр;
			
			
			Если ВыводитьРегионы И Уровень = НомерГруппировкиДоРегиона Тогда
				// добавляем все регионы
				Для каждого ЭлементРегион Из СЗ_Регионы Цикл
					СтрокаДанныхРегион = СтрокаДанные.Строки.Добавить();
					СтрокаДанныхРегион.Параметр = ЭлементРегион.Значение;
				КонецЦикла;
			ИначеЕсли ВыводитьРекламу И Уровень = НомерГруппировкиДоРекламы Тогда
				// добавляем все рекламы
				Для каждого СтрокаКанал Из ДЗ_Реклама.ПолучитьЭлементы() Цикл
					СтрокаДанныхКанал = СтрокаДанные.Строки.Добавить();
					СтрокаДанныхКанал.Параметр = СтрокаКанал.Параметр;
					Для каждого СтрокаИсточник Из СтрокаКанал.ПолучитьЭлементы() Цикл
						СтрокаДанныхИсточник = СтрокаДанныхКанал.Строки.Добавить();
						СтрокаДанныхИсточник.Параметр = СтрокаИсточник.Параметр;
					КонецЦикла;	
				КонецЦикла;
			ИначеЕсли ВыводитьСегменты И Уровень = НомерГруппировкиДоСегмента Тогда
				// добавляем все сегменты
				Массив_Сегменты = ТЗ_Сегменты.НайтиСтроки(Новый Структура("Подразделение",Выборка.Подразделения));
				Для каждого СтрокаСегмент Из Массив_Сегменты Цикл
					СтрокаДанныхСегмент = СтрокаДанные.Строки.Добавить();
					СтрокаДанныхСегмент.Параметр = СтрокаСегмент.Сегмент;
				КонецЦикла;
				
			КонецЕсли;	
		
			ВыборкаНиже = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Если ВыборкаНиже.Количество() > 0 Тогда
				ДобавитьВеткуВДеревоДанныхНаСервере(ВыборкаНиже, СтрокаДанные.Строки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры//ДобавитьВеткуВДеревоДанныхНаСервере(Выборка, СтрокиДанных);

&НаСервере
Процедура ВывестиВТабличныйДокументНаСервере(ВыводимыеСтроки, Колонки, Уровень, КолвоИтого)
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ОтчетОбъект.ПолучитьМакет("Макет");
	
	ОблГ_Параметр = Макет.ПолучитьОбласть("Группировка" + Уровень + "|Параметр");
	ОблГ_Период = Макет.ПолучитьОбласть("Группировка" + Уровень + "|Период");
	ОблГ_Среднее = Макет.ПолучитьОбласть("Группировка" + Уровень + "|СреднееЗаПериод");
	ОблГ_Всего = Макет.ПолучитьОбласть("Группировка" + Уровень + "|ВсегоЗаПериод");
	
	Для каждого СтрокаТЧ из ВыводимыеСтроки Цикл
		Если СтрокаТЧ.Параметр = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолвоПериодов = 0;
		КолвоЗаПериод = 0;
		ПериодовВсего = 0;
		
		
		// не выводим итогов по каналам
		ЭтоКанал = ТипЗнч(СтрокаТЧ.Параметр) = Тип("ПланВидовХарактеристикСсылка.КаналыРекламныхВоздействий") ИЛИ СтрокаТЧ.Параметр = "<<канал не указан>>";
		
		//СуммаЗаПериод = 0;
		КолвоВсего = 0;
		Для каждого Колонка Из Колонки Цикл
			Если Колонка.Имя = "Параметр" Тогда
				ОблГ_Параметр.Параметры.Группировка = СтрокаТЧ.Параметр;
				Область = ТабличныйДокумент.Вывести(ОблГ_Параметр, Уровень);
				Область.АвтоОтступ = Уровень;
			ИначеЕсли Найти(Колонка.Имя,"НачПериодаКолво") > 0 Тогда
				//Колво = 0;
				Если ЭтоКанал Тогда
					КолвоЗаПериод = 0;
				//ИначеЕсли СтрокаТЧ[Колонка.Имя] <> Неопределено Тогда
				//	Колво = Окр(СтрокаТЧ[Колонка.Имя], 2);
				КонецЕсли;	
				//ОблГ_Среднее.Параметры.Колво = Колво;
				ОблГ_Среднее.Параметры.Среднее = Окр(КолвоЗаПериод / КолвоПериодов, 2);
				ТабличныйДокумент.Присоединить(ОблГ_Среднее);
				КолвоПериодов = 0;
				КолвоЗаПериод = 0;
			ИначеЕсли Найти(Колонка.Имя,"Колво") > 0 И Найти(Колонка.Имя,"НачПериода") = 0 Тогда
				Колво = 0;
				Если ЭтоКанал Тогда
				ИначеЕсли СтрокаТЧ[Колонка.Имя] <> Неопределено Тогда
					Колво = Окр(СтрокаТЧ[Колонка.Имя], 2);
				КонецЕсли;	
				ОблГ_Период.Параметры.Колво = Колво;
				ТабличныйДокумент.Присоединить(ОблГ_Период);
				КолвоПериодов = КолвоПериодов + 1;
				ПериодовВсего = ПериодовВсего + 1;
				КолвоЗаПериод = КолвоЗаПериод + Колво;
				КолвоВсего = КолвоВсего + Колво;
			ИначеЕсли Найти(Колонка.Имя,"Колво") > 0 И Найти(Колонка.Имя,"НачПериода") = 0 Тогда
				Колво = 0;
				Если ЭтоКанал Тогда
				ИначеЕсли СтрокаТЧ[Колонка.Имя] <> Неопределено Тогда
					Колво = СтрокаТЧ[Колонка.Имя];
				КонецЕсли;	
				КолвоВсего = КолвоВсего + Колво;	
			КонецЕсли;	
		КонецЦикла;
		
		Если ЭтоКанал Тогда
		ИначеЕсли СтрокаТЧ[Колонка.Имя] <> Неопределено Тогда
			ОблГ_Всего.Параметры.Колво = КолвоВсего;
			//ОблГ_Всего.Параметры.Среднее = Окр(КолвоВсего / ПериодовВсего,2);
		КонецЕсли;
				
		ТабличныйДокумент.Присоединить(ОблГ_Всего);
		Если СтрокаТЧ.Строки.Количество() > 0 Тогда
			ВывестиВТабличныйДокументНаСервере(СтрокаТЧ.Строки, Колонки, Уровень + 1, КолвоИтого);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры//ВывестиВТабличныйДокументНаСервере

