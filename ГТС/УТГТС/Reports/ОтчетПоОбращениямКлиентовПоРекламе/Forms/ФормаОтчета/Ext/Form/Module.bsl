					ТекстГруппировокИтоги = ТекстГруппировокИтоги + Символы.ПС + "	Подразделения,";
					СЗ_Группировки.Добавить(ЭлементГрупп.Значение);
				ИначеЕсли ЭлементГрупп.Значение = "Менеджеры" Тогда
					ТекстГруппировокВыбрать = ТекстГруппировокВыбрать + Символы.ПС + "СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.Ответственный КАК Менеджеры,";
					ТекстГруппировокИтоги = ТекстГруппировокИтоги + Символы.ПС + "	Менеджеры,";
					СЗ_Группировки.Добавить(ЭлементГрупп.Значение);
				ИначеЕсли ЭлементГрупп.Значение = "Сегменты" Тогда
					ТекстГруппировокВыбрать = ТекстГруппировокВыбрать + Символы.ПС + "СделкиСКлиентамиИнтересПоСегментамНоменклатуры.СегментНоменклатуры КАК Сегменты,";	
					ТекстГруппировокИтоги = ТекстГруппировокИтоги + Символы.ПС + "	Сегменты,";
					НомерГруппировкиДоСегмента = КолвоГрупп - 2;	
					СЗ_Группировки.Добавить(ЭлементГрупп.Значение);
				ИначеЕсли ЭлементГрупп.Значение = "Регионы" Тогда
					ТекстГруппировокВыбрать = ТекстГруппировокВыбрать + Символы.ПС + "СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.БизнесРегион КАК Регионы,";	
					ТекстГруппировокИтоги = ТекстГруппировокИтоги + Символы.ПС + "	Регионы,";
					НомерГруппировкиДоРегиона = КолвоГрупп - 2;
					СЗ_Группировки.Добавить(ЭлементГрупп.Значение);
				ИначеЕсли ЭлементГрупп.Значение = "Реклама" Тогда
					
					ТекстГруппировокВыбрать = ТекстГруппировокВыбрать + Символы.ПС 
					+ "ИсточникиПервичногоИнтереса.КаналПервичногоИнтереса КАК Канал,
					|	Выразить(ИсточникиПервичногоИнтереса.ИсточникПервичногоИнтереса КАК Справочник.МаркетинговыеМероприятия) КАК Источник,";		
					ТекстГруппировокИтоги = ТекстГруппировокИтоги + Символы.ПС + "	Канал,
					| Источник,";						
					НомерГруппировкиДоРекламы = КолвоГрупп - 2;						
					НомерГруппировкиКанал = КолвоГрупп - 1;						
					НомерГруппировкиИсточник = КолвоГрупп;
					КолвоГрупп = КолвоГрупп + 1;
					
					СЗ_Группировки.Добавить("Канал");
					СЗ_Группировки.Добавить("Источник");
				КонецЕсли;	
				Отступ = Отступ + " ";
				
			КонецЕсли;	
		КонецЦикла;	
		
		//НомерГруппировкиПериода = КолвоГрупп + 1;
		НомерГруппировкиПериода = КолвоГрупп;
		НомерГруппировкиСреднее = КолвоГрупп;
		КолвоГрупп = КолвоГрупп + 2;//добавляем группировки периодов
		
		ЗапросСделки = Новый Запрос;
		
		ТекстУсловия = "";
		Если ВидОтбораМенеджеры = "ВСписке" Тогда
			ТекстУсловия = ТекстУсловия + "
			|	И СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.Ответственный В(&СписокМенеджеров)";
			ЗапросСделки.УстановитьПараметр("СписокМенеджеров", ОтборМенеджеры);
		ИначеЕсли ВидОтбораМенеджеры = "НеВСписке" Тогда
			ТекстУсловия = ТекстУсловия + "
			|	И (НЕ СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.Ответственный В(&СписокМенеджеров))";
			ЗапросСделки.УстановитьПараметр("СписокМенеджеров", ОтборМенеджеры);
		КонецЕсли;
		
		Если ВидОтбораПодразделения = "ВСписке" Тогда
			ТекстУсловия = ТекстУсловия + "
			|	И СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.Ответственный.Подразделение В(&СписокПодразделений)";
			ЗапросСделки.УстановитьПараметр("СписокПодразделений", ОтборПодразделения);
		ИначеЕсли ВидОтбораПодразделения = "НеВСписке" Тогда
			ТекстУсловия = ТекстУсловия + "
			|	И (НЕ СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.Ответственный.Подразделение В(&СписокПодразделений))";
			ЗапросСделки.УстановитьПараметр("СписокПодразделений", ОтборПодразделения);
		КонецЕсли;
		
		ЗапросСделки.Текст =
		"ВЫБРАТЬ" + ТекстГруппировокВыбрать + "
		| " + ТекстПериода + "
		|	СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка КАК Колво
		|ИЗ
		|	Справочник.СделкиСКлиентами.ИнтересПоСегментамНоменклатуры КАК СделкиСКлиентамиИнтересПоСегментамНоменклатуры
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсточникиПервичногоИнтереса КАК ИсточникиПервичногоИнтереса
		|		ПО СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка = ИсточникиПервичногоИнтереса.Сделка
		|ГДЕ
		|	(НЕ СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.ПометкаУдаления)
		|	И СделкиСКлиентамиИнтересПоСегментамНоменклатуры.Ссылка.ДатаНачала МЕЖДУ &НачДата И &КонДата" + ТекстУсловия + "
		|ИТОГИ
		|	КОЛИЧЕСТВО(Различные Колво)
		|ПО" + ТекстГруппировокИтоги + "
		//|	НачалоПериода,
		|	Период";
		
	КонецЕсли;	
	
	//СЗ_Группировки.Добавить("НачалоПериода");
	СЗ_Группировки.Добавить("Период");
	
	ЗапросСделки.УстановитьПараметр("НачДата", НачДата);
	ЗапросСделки.УстановитьПараметр("КонДата", КонецДня(КонДата));
	
	
	Выборка = ЗапросСделки.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ДобавитьВеткуВДеревоДанныхНаСервере(Выборка, СтрокаИтого.Строки);
	
	КолвоИтого = 0;
	КолвоЗаПериод = 0;
	Для каждого ЭлементСуммКолонка Из СЗ_СуммируемыеПоляПриЗаполнении Цикл
		ИмяКолонки = ЭлементСуммКолонка.Значение;
		
		СтрокаИтого[ИмяКолонки] = СтрокаИтого.Строки.Итог(ИмяКолонки);
		
		Если Найти(ИмяКолонки, "НачПериода") = 0 Тогда
			КолвоЗаПериод = КолвоЗаПериод + СтрокаИтого[ИмяКолонки];
		Иначе
			СтрокаИтого[ИмяКолонки] = КолвоЗаПериод;
			КолвоЗаПериод = 0;
		КонецЕсли;
		
		Если Найти(ИмяКолонки, "Колво") > 0 И Найти(ИмяКолонки, "НачПериода") = 0 Тогда
			КолвоИтого = КолвоИтого + СтрокаИтого[ИмяКолонки];
		КонецЕсли;
		
		Если СтрокаИтого[ИмяКолонки] = 0 Тогда
			ДеревоДанных.Колонки.Удалить(ДеревоДанных.Колонки.Индекс(ДеревоДанных.Колонки.Найти(ИмяКолонки)));
		КонецЕсли;	
	КонецЦикла;
	
	ТабличныйДокумент.Очистить();
	
	ОтчетОбъект = РеквизитФормыВЗначение("Отчет");
	Макет = ОтчетОбъект.ПолучитьМакет("Макет");
	ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОблШ_Параметр = Макет.ПолучитьОбласть("ШапкаТаблицы|Параметр");
	ОблШ_Период = Макет.ПолучитьОбласть("ШапкаТаблицы|Период");
	ОблШ_Среднее = Макет.ПолучитьОбласть("ШапкаТаблицы|СреднееЗаПериод");
	ОблШ_Итого = Макет.ПолучитьОбласть("ШапкаТаблицы|ВсегоЗаПериод");
	
	ОблЗаголовок.Параметры.Заголовок = "Отчет по обращениям клиентов по рекламе за " + ПредставлениеПериода(НачДата, КонецДня(КонДата), "ФП=истина"); 
	ТабличныйДокумент.Вывести(ОблЗаголовок);
	
	ОблШ_Параметр.Параметры.СтрПараметры = СтрПараметры;
	ТабличныйДокумент.Вывести(ОблШ_Параметр);
	
	
	Для каждого Колонка Из ДеревоДанных.Колонки Цикл
		
		Если Найти(Колонка.Имя, "НачПериодаКолво") > 0 Тогда
			//Дата = СтрЗаменить(Прав(Колонка.Имя, 10),"_",".");
			//Год = Число(Прав(Дата, 4));
			//Месяц = Число(Сред(Дата, 4, 2));
			//День = Число(Сред(Дата, 1, 2));
			//Дата = Дата(Год,Месяц,День);
			//Если Периодичность = "ПоДням" Тогда
			//	ОблШ_Среднее.Параметры.Период = "нед." + Формат(НачалоНедели(Дата), "ДФ=dd.MM.yyyy") + "-" + Формат(Мин(КонецНедели(Дата), КонДата), "ДФ=dd.MM.yyyy");
			//ИначеЕсли Периодичность = "ПоНеделям" Тогда
			//	ОблШ_Среднее.Параметры.Период = ПредставлениеПериода(НачалоМесяца(Дата), КонецМесяца(Дата), "ФП=истина");
			//ИначеЕсли Периодичность = "ПоМесяцам" Тогда
			//	ОблШ_Среднее.Параметры.Период = СокрЛП(Год) + " г.";
			//КонецЕсли;	
			ТабличныйДокумент.Присоединить(ОблШ_Среднее);
		ИначеЕсли Найти(Колонка.Имя, "Колво") > 0 Тогда	
			Дата = СтрЗаменить(Прав(Колонка.Имя, 10),"_",".");
			Год = Число(Прав(Дата, 4));
			Месяц = Число(Сред(Дата, 4, 2));
			День = Число(Сред(Дата, 1, 2));
			Дата = Дата(Год,Месяц,День);
			Если Периодичность = "ПоДням" Тогда
				ОблШ_Период.Параметры.Период = Формат(Дата, "ДФ=dd.MM.yyyy");
			ИначеЕсли Периодичность = "ПоНеделям" Тогда
				ОблШ_Период.Параметры.Период = "нед." + Формат(НачалоНедели(Дата), "ДФ=dd.MM.yyyy") + "-" + Формат(Мин(КонецНедели(Дата), КонДата), "ДФ=dd.MM.yyyy");
			ИначеЕсли Периодичность = "ПоМесяцам" Тогда
				ОблШ_Период.Параметры.Период = ПредставлениеПериода(НачалоМесяца(Дата), КонецМесяца(Дата), "ФП=истина");	
			КонецЕсли;
			ТабличныйДокумент.Присоединить(ОблШ_Период);
		КонецЕсли;	
			
	КонецЦикла;
	ТабличныйДокумент.Присоединить(ОблШ_Итого);	
	
	ТабличныйДокумент.ФиксацияСверху = 3;
	ТабличныйДокумент.ФиксацияСлева = 1;
	
	ТабличныйДокумент.НачатьАвтогруппировкуСтрок();
	Уровень = 0;
	ВывестиВТабличныйДокументНаСервере(СтрокаИтого.Строки, ДеревоДанных.Колонки, Уровень, КолвоИтого);
	
	ТабличныйДокумент.ЗакончитьАвтогруппировкуСтрок();
	
	ОблП_Параметр = Макет.ПолучитьОбласть("Подвал|Параметр");
	ОблП_Период = Макет.ПолучитьОбласть("Подвал|Период");
	ОблП_Среднее = Макет.ПолучитьОбласть("Подвал|СреднееЗаПериод");
	ОблП_Итого = Макет.ПолучитьОбласть("Подвал|ВсегоЗаПериод");
	
	ТабличныйДокумент.Вывести(ОблП_Параметр);
	
	КолвоПериодов = 0;
	КолвоЗаПериод = 0;
	ПериодовВсего = 0;	
	Для каждого Колонка Из ДеревоДанных.Колонки Цикл
		
		Если Найти(Колонка.Имя, "НачПериодаКолво") > 0 Тогда
			//ОблП_Среднее.Параметры.Колво = ДеревоДанных.Строки.Итог(Колонка.Имя);
			ОблП_Среднее.Параметры.Среднее = ДеревоДанных.Строки.Итог(Колонка.Имя) / КолвоПериодов;
			ТабличныйДокумент.Присоединить(ОблП_Среднее);
			КолвоПериодов = 0;
		ИначеЕсли Найти(Колонка.Имя, "Колво") > 0 Тогда	
			ОблП_Период.Параметры.Колво = ДеревоДанных.Строки.Итог(Колонка.Имя);
			ТабличныйДокумент.Присоединить(ОблП_Период);
			КолвоПериодов = КолвоПериодов + 1;
			КолвоЗаПериод = КолвоЗаПериод + ОблП_Период.Параметры.Колво;
			ПериодовВсего = ПериодовВсего + 1;	
		КонецЕсли;	
	КонецЦикла;
		
	ОблП_Итого.Параметры.Колво = КолвоЗаПериод;
	//ОблП_Итого.Параметры.Среднее = КолвоЗаПериод / ПериодовВсего;
	ТабличныйДокумент.Присоединить(ОблП_Итого);
	
КонецПроцедуры//сформироватьНаСервере

