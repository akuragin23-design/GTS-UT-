	СтрокаГруппировки.Представление = "Подразделения";
	СтрокаГруппировки.Пометка = Истина;
	
	СтрокаГруппировки = Группировки.Добавить();
	СтрокаГруппировки.Имя = "Менеджер";
	СтрокаГруппировки.ПутьОплаты = "ЕстьNull(ОбъектыРасчетов.Менеджер,РСв_АналитикаУчетаПоПартнерам.Партнер.ОсновнойМенеджер) КАК Менеджер,";
	СтрокаГруппировки.ПутьОтгрузки = "ЕстьNull(ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.Менеджер, РСв_АналитикаУчетаПоПартнерам.Партнер.ОсновнойМенеджер) КАК Менеджер,";
	СтрокаГруппировки.Представление = "Менеджеры";
	
	СтрокаГруппировки = Группировки.Добавить();
	СтрокаГруппировки.Имя = "ВидДеятельности";
	СтрокаГруппировки.ПутьОплаты = "ЕСТЬNULL(ПартнерыДополнительныеРеквизиты.Значение, ""<<вид деят-ти не указан>>"") КАК ВидДеятельности,";
	СтрокаГруппировки.ПутьОтгрузки = "ЕСТЬNULL(ПартнерыДополнительныеРеквизиты.Значение, ""<<вид деят-ти не указан>>"") КАК ВидДеятельности,";
	СтрокаГруппировки.Представление = "Виды деят-ти";
	
	СтрокаГруппировки = Группировки.Добавить();
	СтрокаГруппировки.Имя = "БизнесРегион";
	СтрокаГруппировки.ПутьОплаты = "ВЫБОР КОГДА ЕстьNull(ОбъектыРасчетов.Партнер.БизнесРегион, РСв_АналитикаУчетаПоПартнерам.Партнер.БизнесРегион) = ЗНАЧЕНИЕ(Справочник.БизнесРегионы.ПустаяСсылка) ТОГДА ""<<регион не указан>>"" ИНАЧЕ ЕстьNull(ОбъектыРасчетов.Партнер.БизнесРегион, РСв_АналитикаУчетаПоПартнерам.Партнер.БизнесРегион) Конец КАК БизнесРегион,";
	
	СтрокаГруппировки.ПутьОтгрузки = "Выбор когда ЕстьNull(ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.Партнер.БизнесРегион, РСв_АналитикаУчетаПоПартнерам.Партнер.БизнесРегион) = Значение(Справочник.БизнесРегионы.ПустаяСсылка) Тогда ""<<регион не указан>>"" Иначе ЕстьNull(ВыручкаИСебестоимостьПродажОбороты.ЗаказКлиента.Партнер.БизнесРегион, РСв_АналитикаУчетаПоПартнерам.Партнер.БизнесРегион) Конец КАК БизнесРегион,";
	СтрокаГруппировки.Представление = "Бизнес-регионы";
	
	СтрокаГруппировки = Группировки.Добавить();
	СтрокаГруппировки.Имя = "Реклама";
	СтрокаГруппировки.ПутьОтгрузки = "";
	СтрокаГруппировки.Представление = "Реклама";
	СтрокаГруппировки.Пометка = Истина;
	
	ВидОтбораМенеджеры = "НеИспользоватьОтбор";
	ВидОтбораПодразделения = "НеИспользоватьОтбор";
	
	Периодичность = "ПоДням";
	
	Показатель = "Оплата";
	
	Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ВидОтбораНоменклатура = "НеИспользоватьОтбор";
	ВидОтбораСегменты = "НеИспользоватьОтбор";
	
	ВидОтбораПартнеры = "НеВСписке";
	ОтборПартнеры.Очистить();
	
	Промсвязь = Справочники.Партнеры.НайтиПоНаименованию("Промсвязь");
	Если Промсвязь <> Неопределено Тогда
		ОтборПартнеры.Добавить(Промсвязь);
	КонецЕсли;
	
	Горторгснаб_Спб = Справочники.Партнеры.НайтиПоНаименованию("Горторгснаб Спб");
	Если Горторгснаб_Спб <> Неопределено Тогда
		ОтборПартнеры.Добавить(Горторгснаб_Спб);
	КонецЕсли;
	
КонецПроцедуры//ПриСозданииНаСервере

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ДобавитьУдалитьГруппировкуСегменты();
КонецПроцедуры

