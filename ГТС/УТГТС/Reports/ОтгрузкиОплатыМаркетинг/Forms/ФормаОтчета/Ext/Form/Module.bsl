			//ОблП_Среднее.Параметры.Колво = ДеревоДанных.Строки.Итог(Колонка.Имя);
			ОблП_Среднее.Параметры.Среднее = СуммаСреднее;
			ОблП_Среднее.Параметры.КолвоСреднее = СтрокаИтого[Колонка.Имя] / КолвоПериодов;
			ТабличныйДокумент.Присоединить(ОблП_Среднее);
			КолвоПериодов = 0;
			
		ИначеЕсли Найти(Колонка.Имя, "Сумма") > 0 Тогда
			Сумма = СтрокаИтого[Колонка.Имя];
		ИначеЕсли Найти(Колонка.Имя, "Колво") > 0 Тогда	
			ОблП_Период.Параметры.Сумма = Сумма;
			ОблП_Период.Параметры.Колво = СтрокаИтого[Колонка.Имя];
			ТабличныйДокумент.Присоединить(ОблП_Период);
			КолвоПериодов = КолвоПериодов + 1;
			КолвоЗаПериод = КолвоЗаПериод + ОблП_Период.Параметры.Колво;
			ПериодовВсего = ПериодовВсего + 1;	
		КонецЕсли;	
	КонецЦикла;
		
	ОблП_Итого.Параметры.Колво = КолвоЗаПериод;
	ОблП_Итого.Параметры.Сумма = СуммаИтого;
	ОблП_Итого.Параметры.Среднее = СуммаИтого / ПериодовВсего;
	ОблП_Итого.Параметры.КолвоСреднее = КолвоЗаПериод / ПериодовВсего;
	
	ТабличныйДокумент.Присоединить(ОблП_Итого);
	
	ТабличныйДокумент.ФиксацияСверху = 4;
	ТабличныйДокумент.ФиксацияСлева = 1;
	
КонецПроцедуры//сформироватьНаСервере

///////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ НА КЛИЕНТЕ

&НаКлиенте
Процедура ДобавитьУдалитьГруппировкуСегменты() 
	
	Если Показатель = "Оплата" Тогда
		Строки = Группировки.НайтиСтроки(Новый Структура("Имя", "Сегменты"));
		Если Строки.Количество() > 0 Тогда
			Группировки.Удалить(Строки[0]);
		КонецЕсли;
		Элементы.ГруппаОтборНоменклатура.Видимость = Ложь;
		Элементы.ГруппаОтборСегменты.Видимость = Ложь;
	Иначе
		Строки = Группировки.НайтиСтроки(Новый Структура("Имя", "Сегменты"));
		Если Строки.Количество() = 0 Тогда
			СтрокаГруппировки = Группировки.Добавить();
			СтрокаГруппировки.Имя = "Сегменты";
			СтрокаГруппировки.ПутьОтгрузки = "ЕСТЬNULL(НоменклатураСегмента.Сегмент, ""<<вне сегмента>>"") КАК Сегмент,
											|РСв_АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,";
			СтрокаГруппировки.Представление = "Сегменты номенклатуры, номенклатура";
		КонецЕсли;
		Элементы.ГруппаОтборНоменклатура.Видимость = Истина;
		Элементы.ГруппаОтборСегменты.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры//ДобавитьУдалитьГруппировкуСегменты()	

