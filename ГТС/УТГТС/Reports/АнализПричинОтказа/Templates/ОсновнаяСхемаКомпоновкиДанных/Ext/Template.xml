		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СУММА(ЗаказКлиентаТовары.Сумма) КАК Сумма,
	МАКСИМУМ(ЗаказКлиентаТовары.ПричинаОтмены) КАК ПричинаОтмены,
	ЗаказКлиентаТовары.Ссылка.Менеджер КАК Менеджер,
	ЗаказКлиентаТовары.Ссылка.Менеджер.Подразделение КАК Отдел,
	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.Ссылка) КАК КоличествоЗаказов,
	СУММА(ЗаказКлиентаТовары.Сумма) КАК СуммаЗаказов,
	МаркетинговыеМероприятия.Ссылка КАК ИсточникПервичногоИнтереса,
	ЗаказКлиентаТовары.Ссылка.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МаркетинговыеМероприятия КАК МаркетинговыеМероприятия
			ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.КаналыРекламныхВоздействий КАК КаналыРекламныхВоздействий
			ПО МаркетинговыеМероприятия.Владелец = КаналыРекламныхВоздействий.Ссылка
		ПО ЗаказКлиентаТовары.Ссылка.ИсточникПервичногоИнтереса = МаркетинговыеМероприятия.Ссылка
ГДЕ
	ЗаказКлиентаТовары.Ссылка.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И ЗаказКлиентаТовары.Отменено = Истина

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Ссылка,
	ЗаказКлиентаТовары.ПричинаОтмены,
	ЗаказКлиентаТовары.Ссылка.Менеджер,
	ЗаказКлиентаТовары.Ссылка.Менеджер.Подразделение,
	ЗаказКлиентаТовары.Номенклатура,
	МаркетинговыеМероприятия.Ссылка,
	ЗаказКлиентаТовары.Ссылка.КаналПервичногоИнтереса</query>
