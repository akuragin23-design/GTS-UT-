			<dataSource>ИсточникДанных</dataSource>
			<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказыКлиентовОстатки.Склад КАК Склад,
	ЗаказыКлиентовОстатки.ЗаказКлиента КАК ЗаказКлиента,
	ЗаказыКлиентовОстатки.Номенклатура КАК Номенклатура,
	ЗаказыКлиентовОстатки.Характеристика КАК Характеристика,
	ЗаказыКлиентовОстатки.ЗаказаноОстаток КАК ЗаказаноВсего,
	ВЫБОР
		КОГДА РасчетыСКлиентамиОбороты.СуммаРасход &gt; 0
			ТОГДА ЗаказыКлиентовОстатки.ЗаказаноОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК Оплачено,
	ВЫБОР
		КОГДА РасчетыСКлиентамиОбороты.СуммаРасход ЕСТЬ NULL
			ТОГДА ЗаказыКлиентовОстатки.ЗаказаноОстаток
		ИНАЧЕ 0
	КОНЕЦ КАК НеОплачено,
	ЕСТЬNULL(ТоварыКОтгрузкеОстатки.ВРезервеОстаток, 0) КАК Зарезервировано,
	ГрафикОтгрузкиТоваровОстаткиИОбороты.КоличествоНеобеспеченоПриход + ГрафикОтгрузкиТоваровОстаткиИОбороты.КоличествоПодЗаказПриход КАК КОбеспечению,
	ЗаказыКлиентовОстатки.ЗаказКлиента.Подразделение КАК ЗаказКлиентаПодразделение
ИЗ
	РегистрНакопления.УдалитьЗаказыКлиентов.Остатки(, ) КАК ЗаказыКлиентовОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентами.Обороты(, , , ) КАК РасчетыСКлиентамиОбороты
		ПО ЗаказыКлиентовОстатки.ЗаказКлиента = РасчетыСКлиентамиОбороты.УдалитьЗаказКлиента
			И (РасчетыСКлиентамиОбороты.СуммаРасход &gt; 0)
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки(, ) КАК ТоварыКОтгрузкеОстатки
		ПО ЗаказыКлиентовОстатки.ЗаказКлиента = ТоварыКОтгрузкеОстатки.ДокументОтгрузки
			И ЗаказыКлиентовОстатки.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура
			И ЗаказыКлиентовОстатки.Склад = ТоварыКОтгрузкеОстатки.Склад
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ГрафикОтгрузкиТоваров.ОстаткиИОбороты(, , Авто, , ) КАК ГрафикОтгрузкиТоваровОстаткиИОбороты
		ПО ЗаказыКлиентовОстатки.Номенклатура = ГрафикОтгрузкиТоваровОстаткиИОбороты.Номенклатура
			И ЗаказыКлиентовОстатки.ЗаказКлиента = ГрафикОтгрузкиТоваровОстаткиИОбороты.Регистратор
			И ЗаказыКлиентовОстатки.Склад = ГрафикОтгрузкиТоваровОстаткиИОбороты.Склад</query>
		</item>
