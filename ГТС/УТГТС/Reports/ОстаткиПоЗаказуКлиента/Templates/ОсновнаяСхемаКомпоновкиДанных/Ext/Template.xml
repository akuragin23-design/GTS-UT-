		<query>ВЫБРАТЬ
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
	естьnull(ТоварныеОграничения.МинимальноеКоличествоЗапаса,0) КАК ПлановыйЗапас
ПОМЕСТИТЬ Заказ
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварныеОграничения КАК ТоварныеОграничения
		ПО ЗаказКлиентаТовары.Номенклатура = ТоварныеОграничения.Номенклатура
			И (ТоварныеОграничения.Склад = &amp;Склад)
ГДЕ
	ЗаказКлиентаТовары.Ссылка.Ссылка = &amp;Ссылка
	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Номенклатура,
	ЗаказКлиентаТовары.Характеристика,
	ЗаказКлиентаТовары.Ссылка,
	естьnull(ТоварныеОграничения.МинимальноеКоличествоЗапаса,0)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(РаспределениеЗапасов.ДатаПоступления) КАК ДатаСобытия,
	СУММА(РаспределениеЗапасов.Обеспечено) КАК КоличествоЗаказано,
	Заказ.Номенклатура КАК Номенклатура1,
	Заказ.Ссылка КАК Ссылка,
	Заказ.Характеристика КАК Характеристика
ПОМЕСТИТЬ График
ИЗ
	Заказ КАК Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
		ПО Заказ.Номенклатура = РаспределениеЗапасов.Номенклатура
			И Заказ.Характеристика = РаспределениеЗапасов.Характеристика
			И Заказ.Ссылка.Назначение = РаспределениеЗапасов.Назначение
ГДЕ
	РаспределениеЗапасов.Состояние = ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОбеспеченКДате)
	И ТИПЗНАЧЕНИЯ(РаспределениеЗапасов.ЗаказНаПоступление) = ТИП(Документ.ЗаказПоставщику)

СГРУППИРОВАТЬ ПО
	Заказ.Номенклатура,
	Заказ.Ссылка,
	Заказ.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	МАКСИМУМ(РаспределениеЗапасов.ДатаПоступления) КАК ДатаСобытия2,
	СУММА(РаспределениеЗапасов.Свободно) КАК КоличествоЗаказаноПодСвободный,
	Заказ.Номенклатура КАК Номенклатура2,
	Заказ.Ссылка КАК Ссылка2,
	Заказ.Характеристика КАК Характеристика2
ПОМЕСТИТЬ ГрафикNULL
ИЗ
	Заказ КАК Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РаспределениеЗапасов КАК РаспределениеЗапасов
		ПО Заказ.Номенклатура = РаспределениеЗапасов.Номенклатура
			И Заказ.Характеристика = РаспределениеЗапасов.Характеристика
ГДЕ
	РаспределениеЗапасов.Состояние В (ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОбеспеченКДате), ЗНАЧЕНИЕ(Перечисление.РаспределениеЗапасовСостояния.ОжидаемоеПоступление))
	И РаспределениеЗапасов.Назначение = ЗНАЧЕНИЕ(Справочник.Назначения.ПустаяССылка)
	И ТИПЗНАЧЕНИЯ(РаспределениеЗапасов.ЗаказНаПоступление) = ТИП(Документ.ЗаказПоставщику)

СГРУППИРОВАТЬ ПО
	Заказ.Номенклатура,
	Заказ.Ссылка,
	Заказ.Характеристика
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура1,
	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	ТоварыНаСкладахОстатки.Склад КАК Склад,
	ТоварыНаСкладахОстатки.Помещение КАК Помещение,
	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Остаток,
	Заказ.Номенклатура.Артикул КАК Артикул,
	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК ЗаказаноПоставщику,
	Заказ.Номенклатура КАК Номенклатура,
	Заказ.Количество КАК Количество,
	ТоварыКОтгрузкеОстатки.ВРезервеОстаток КАК ВРезервеОстаток,
	График.ДатаСобытия КАК ДатаПоставки,
	График.КоличествоЗаказано КАК КоличествоЗаказано,
	ГрафикNULL.КоличествоЗаказаноПодСвободный КАК КоличествоЗаказаноПодСвободный,
	Заказ.ПлановыйЗапас КАК КоличествоПлановыйЗапас
ИЗ
	Заказ КАК Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, ) КАК ТоварыНаСкладахОстатки
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки КАК ЗаказыПоставщикамОстатки
			ПО ТоварыНаСкладахОстатки.Номенклатура = ЗаказыПоставщикамОстатки.Номенклатура
				И ТоварыНаСкладахОстатки.Характеристика = ЗаказыПоставщикамОстатки.Характеристика
				И ТоварыНаСкладахОстатки.Склад = ЗаказыПоставщикамОстатки.Склад
		ПО Заказ.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
			И Заказ.Характеристика = ТоварыНаСкладахОстатки.Характеристика
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки КАК ТоварыКОтгрузкеОстатки
		ПО (ТоварыНаСкладахОстатки.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура)
			И (ТоварыНаСкладахОстатки.Характеристика = ТоварыКОтгрузкеОстатки.Характеристика)
			И (ТоварыНаСкладахОстатки.Склад = ТоварыКОтгрузкеОстатки.Склад)
		ЛЕВОЕ СОЕДИНЕНИЕ График КАК График
		ПО Заказ.Номенклатура = График.Номенклатура1
			И Заказ.Характеристика = График.Характеристика
		ЛЕВОЕ СОЕДИНЕНИЕ ГрафикNULL КАК ГрафикNULL
		ПО Заказ.Номенклатура = ГрафикNULL.Номенклатура2
			И Заказ.Характеристика = ГрафикNULL.Характеристика2</query>
	</dataSet>
