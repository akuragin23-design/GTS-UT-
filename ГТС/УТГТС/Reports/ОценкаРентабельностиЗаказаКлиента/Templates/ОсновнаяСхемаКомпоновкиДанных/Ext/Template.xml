		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
	СУММА(ЗаказКлиентаТовары.СуммаСНДС) КАК СуммаСНДС,
	СУММА(ЗаказКлиентаТовары.СуммаСНДС / ЗаказКлиентаТовары.Количество) КАК ЦенаСУчетомСкидки,
	ЗаказКлиентаТовары.Ссылка.Дата КАК Дата,
	ЗаказКлиентаТовары.Ссылка.Ссылка КАК Ссылка,
	ЗаказКлиентаТовары.Ссылка.Валюта КАК Валюта,
	КурсыВалютСрезПоследних.Курс КАК Курс,
	КурсыВалютСрезПоследних1.Курс КАК КурсCNY
ПОМЕСТИТЬ ЗаказКлиентаТовары
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&amp;Период, ) КАК КурсыВалютСрезПоследних
		ПО ЗаказКлиентаТовары.Ссылка.Валюта = КурсыВалютСрезПоследних.Валюта,
	РегистрСведений.КурсыВалют.СрезПоследних(&amp;Период, Валюта = &amp;CNY) КАК КурсыВалютСрезПоследних1
ГДЕ
	ЗаказКлиентаТовары.Ссылка = &amp;ЗаказКлиента
	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Номенклатура,
	ЗаказКлиентаТовары.Ссылка.Дата,
	ЗаказКлиентаТовары.Ссылка.Ссылка,
	ЗаказКлиентаТовары.Ссылка.Валюта,
	КурсыВалютСрезПоследних.Курс,
	КурсыВалютСрезПоследних1.Курс
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиентаТовары.Дата КАК Дата,
	ЗаказКлиентаТовары.Количество КАК Количество,
	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	ЗаказКлиентаТовары.СуммаСНДС КАК СуммаСНДС,
	ЗаказКлиентаТовары.ЦенаСУчетомСкидки КАК ЦенаСУчетомСкидки,
	ВЫБОР
		КОГДА ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних1.Цена, 0) &gt; 0
			ТОГДА ЦеныНоменклатурыСрезПоследних1.Цена
		ИНАЧЕ ЦеныНоменклатурыСрезПоследних.Цена
	КОНЕЦ КАК ЦенаЗакупочная,
	ЗаказКлиентаТовары.Ссылка КАК ЗаказКлиента,
	ЗаказКлиентаТовары.Валюта КАК Валюта,
	ВЫБОР
		КОГДА ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних1.Цена, 0) &gt; 0
			ТОГДА ВЫБОР
					КОГДА ЕСТЬNULL(ЗаказКлиентаТовары.Курс, 0) &lt;= 1
						ТОГДА ЦеныНоменклатурыСрезПоследних1.Цена * ЗаказКлиентаТовары.Количество * ЗаказКлиентаТовары.КурсCNY
					ИНАЧЕ ЦеныНоменклатурыСрезПоследних1.Цена * ЗаказКлиентаТовары.Количество
				КОНЕЦ
		ИНАЧЕ ЦеныНоменклатурыСрезПоследних.Цена * ЗаказКлиентаТовары.Количество
	КОНЕЦ КАК Себес
ИЗ
	ЗаказКлиентаТовары КАК ЗаказКлиентаТовары
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&amp;Период, ВидЦены = ЗНАЧЕНИЕ(справочник.видыцен.закупочная)) КАК ЦеныНоменклатурыСрезПоследних
		ПО ЗаказКлиентаТовары.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&amp;Период, МЕСЯЦ), МЕСЯЦ, 1), ВидЦены = ЗНАЧЕНИЕ(справочник.видыцен.ВалютныйУчетCNY)) КАК ЦеныНоменклатурыСрезПоследних1
		ПО ЗаказКлиентаТовары.Номенклатура = ЦеныНоменклатурыСрезПоследних1.Номенклатура</query>
