		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	Вложение.Партнер КАК Партнер,
	Вложение.СуммаУслуги КАК СуммаУслуги,
	Вложение.СуммаУслугиПоЗаказу КАК СуммаУслугиПоЗаказу,
	Вложение.Оплачено КАК Оплачено,
	Вложение.Менеджер КАК Менеджер,
	Вложение.Статус КАК Статус,
	Вложение.Заявка КАК Заявка,
	Вложение.Ответственный КАК Ответственный,
	Вложение.ДатаИсполнения КАК ДатаИсполнения,
	Вложение.ДатаЗаявки КАК ДатаЗаявки,
	Вложение.СуммаЗаСложность КАК СуммаЗаСложность,
	Вложение.СуммаЗаСрочность КАК СуммаЗаСрочность,
	Вложение.Подразделение КАК Подразделение,
	Вложение.Дата КАК Дата,
	Вложение.ФактическаяДатаВыполнения КАК ФактическаяДатаВыполнения,
	Вложение.ПланируемаяДатаВыполнения КАК ПланируемаяДатаВыполнения,
	Вложение.Адрес КАК Адрес,
	Вложение.ЗаказКлиента КАК ЗаказКлиента,
	Вложение.Услуга КАК Услуга,
	Вложение.ЗаказКлиентаКонтрагент КАК ЗаказКлиентаКонтрагент
ИЗ
	(ВЫБРАТЬ
		Заявки.Партнер КАК Партнер,
		Заявки.СуммаУслуги КАК СуммаУслуги,
		Заявки.СуммаУслугиПоЗаказу КАК СуммаУслугиПоЗаказу,
		Заявки.Оплачено КАК Оплачено,
		Заявки.Менеджер КАК Менеджер,
		Заявки.Статус КАК Статус,
		Заявки.Ссылка КАК Заявка,
		Заявки.Ответственный КАК Ответственный,
		Заявки.ДокументРеализации.Дата КАК ДатаИсполнения,
		ВЫБОР
			КОГДА Заявки.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыЗаявокНаУслуги.Выполнено)
					И Заявки.ФактическаяДатаВыполнения &lt;&gt; ДАТАВРЕМЯ(1, 1, 1)
				ТОГДА Заявки.ФактическаяДатаВыполнения
			ИНАЧЕ Заявки.Дата
		КОНЕЦ КАК ДатаЗаявки,
		Заявки.СуммаЗаСложность КАК СуммаЗаСложность,
		Заявки.СуммаЗаСрочность КАК СуммаЗаСрочность,
		Заявки.Менеджер.Подразделение КАК Подразделение,
		Заявки.ЗаказКлиента.Контрагент КАК ЗаказКлиентаКонтрагент,
		Заявки.Услуга КАК Услуга,
		Заявки.ЗаказКлиента КАК ЗаказКлиента,
		Заявки.Адрес КАК Адрес,
		Заявки.ПланируемаяДатаВыполнения КАК ПланируемаяДатаВыполнения,
		Заявки.ФактическаяДатаВыполнения КАК ФактическаяДатаВыполнения,
		Заявки.Дата КАК Дата
	ИЗ
		Документ.ЗаявкаНаУслуги КАК Заявки
	ГДЕ
		НЕ Заявки.ПометкаУдаления) КАК Вложение
ГДЕ
	Вложение.ДатаЗаявки МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
