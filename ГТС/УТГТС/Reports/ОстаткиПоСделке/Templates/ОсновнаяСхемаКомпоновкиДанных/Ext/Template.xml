		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	СделкиСКлиентамиТовары.Номенклатура КАК Номенклатура,
	СУММА(СделкиСКлиентамиТовары.Количество) КАК Количество
ПОМЕСТИТЬ Заказ
ИЗ
	Справочник.СделкиСКлиентами.Товары КАК СделкиСКлиентамиТовары
ГДЕ
	СделкиСКлиентамиТовары.Ссылка.Ссылка = &amp;Ссылка
	И СделкиСКлиентамиТовары.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар)

СГРУППИРОВАТЬ ПО
	СделкиСКлиентамиТовары.Номенклатура
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура1,
	ТоварыНаСкладахОстатки.Характеристика КАК Характеристика,
	ТоварыНаСкладахОстатки.Склад КАК Склад,
	ТоварыНаСкладахОстатки.Помещение КАК Помещение,
	ТоварыНаСкладахОстатки.ВНаличииОстаток КАК Остаток,
	ТоварыНаСкладахОстатки.Номенклатура.Артикул КАК Артикул,
	ЗаказыПоставщикамОстатки.ЗаказаноОстаток КАК ЗаказаноПоставщику,
	Заказ.Номенклатура КАК Номенклатура,
	Заказ.Количество КАК Количество,
	ТоварыКОтгрузкеОстатки.ВРезервеОстаток КАК ВРезервеОстаток
ИЗ
	Заказ КАК Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(, ) КАК ТоварыНаСкладахОстатки
			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЗаказыПоставщикам.Остатки КАК ЗаказыПоставщикамОстатки
			ПО ТоварыНаСкладахОстатки.Номенклатура = ЗаказыПоставщикамОстатки.Номенклатура
				И ТоварыНаСкладахОстатки.Характеристика = ЗаказыПоставщикамОстатки.Характеристика
				И ТоварыНаСкладахОстатки.Склад = ЗаказыПоставщикамОстатки.Склад
		ПО Заказ.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки КАК ТоварыКОтгрузкеОстатки
		ПО (ТоварыНаСкладахОстатки.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура)
			И (ТоварыНаСкладахОстатки.Характеристика = ТоварыКОтгрузкеОстатки.Характеристика)
			И (ТоварыНаСкладахОстатки.Склад = ТоварыКОтгрузкеОстатки.Склад)</query>
	</dataSet>
