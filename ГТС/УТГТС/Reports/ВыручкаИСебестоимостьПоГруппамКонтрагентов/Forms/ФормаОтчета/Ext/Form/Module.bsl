        НовыйОтбор=НоваяГруппировка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        НовыйОтбор.ВидСравнения=ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
        НовыйОтбор.Использование=Истина;
        НовыйОтбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("СуммаАнализаПартнер");
        НовыйОтбор.ПравоеЗначение=Стр.Начало;
        
        НовыйОтбор=НоваяГруппировка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        НовыйОтбор.ВидСравнения=ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
        НовыйОтбор.Использование=Истина;
        НовыйОтбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("СуммаАнализаПартнер");
        НовыйОтбор.ПравоеЗначение=Стр.Конец;
        
        //Диаграмма ДиаграммаОбъемПродажПроцент
        НоваяГруппировка=ДиаграммаОбъемПродажПроцент.Точки.Добавить();
        НовоеПолеВыбора=НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
