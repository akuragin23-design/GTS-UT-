        НовоеПолеВыбора.Поле=Новый ПолеКомпоновкиДанных(НовоеПолеТ.ПутьКДанным);
        НовоеПолеВыбора.Использование=Истина;
        
        НовыйОтбор=НоваяГруппировка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        НовыйОтбор.ВидСравнения=ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
        НовыйОтбор.Использование=Истина;
        НовыйОтбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("СуммаАнализаПартнер");
        НовыйОтбор.ПравоеЗначение=Стр.Начало;
        
        НовыйОтбор=НоваяГруппировка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
        НовыйОтбор.ВидСравнения=ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
        НовыйОтбор.Использование=Истина;
        НовыйОтбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("СуммаАнализаПартнер");
        НовыйОтбор.ПравоеЗначение=Стр.Конец;
        
        //Диаграмма ДиаграммаСредниеПродажиНаЗаказ
		Если ДиаграммаСредниеПродажиНаЗаказ<>Неопределено Тогда
			НоваяГруппировка=ДиаграммаСредниеПродажиНаЗаказ.Точки.Добавить();
			НовоеПолеВыбора=НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			НовоеПолеВыбора.Поле=Новый ПолеКомпоновкиДанных(НовоеПолеТ.ПутьКДанным);
			НовоеПолеВыбора.Использование=Истина;
			
			НовыйОтбор=НоваяГруппировка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			НовыйОтбор.ВидСравнения=ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
			НовыйОтбор.Использование=Истина;
			НовыйОтбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("СуммаАнализаПартнер");
			НовыйОтбор.ПравоеЗначение=Стр.Начало;
			
			НовыйОтбор=НоваяГруппировка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			НовыйОтбор.ВидСравнения=ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
			НовыйОтбор.Использование=Истина;
			НовыйОтбор.ЛевоеЗначение=Новый ПолеКомпоновкиДанных("СуммаАнализаПартнер");
			НовыйОтбор.ПравоеЗначение=Стр.Конец;
		КонецЕсли;
    КонецЦикла;
    
    
    //Итоги
	НовоеПоле=Отчет.КомпоновщикНастроек.Настройки.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
	НовоеПоле.Заголовок="Итого";
	НовоеПоле.Использование=Истина;
	НовоеПоле.УстановитьВыражениеДетальныхЗаписей(СтрЗаменить(СтрЗаменить(ТекстДетальныхЗаписей,"#Начало",Формат(0,"ЧРД=.; ЧН=0; ЧГ=")),"#Конец",Формат(9999999999999999999999,"ЧРД=.; ЧН=0; ЧГ=")));
	НовоеПоле.УстановитьВыражениеИтоговыхЗаписей(СтрЗаменить(СтрЗаменить(ТекстИтоговыхЗаписей,"#Начало",Формат(0,"ЧРД=.; ЧН=0; ЧГ=")),"#Конец",Формат(9999999999999999999999,"ЧРД=.; ЧН=0; ЧГ=")));
	
	НоваяГруппировка=ОсновнаяТаблица.Колонки.Добавить();
	
	НовоеПолеВыбора=НоваяГруппировка.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	НовоеПолеВыбора.Поле=Новый ПолеКомпоновкиДанных(НовоеПоле.ПутьКДанным);
	НовоеПолеВыбора.Использование=Истина;
	
	ПолеОформления=УслОформлениеСумм.Поля.Элементы.Добавить();
	ПолеОформления.Поле=Новый ПолеКомпоновкиДанных(НовоеПоле.ПутьКДанным);
	ПолеОформления.Использование=Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ТипЗнч(ВыбранноеЗначение)=Тип("Структура") и ВыбранноеЗначение.Свойство("Команда") и ВыбранноеЗначение.Команда="Интервал" Тогда
		ТаблицаИнтервалов.Очистить();
		Для Каждого Стр из ВыбранноеЗначение.Данные Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаИнтервалов.Добавить(),Стр);
		КонецЦикла;
		
		ЗаполнитьНастройкиИнтерваловОтчета();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииВариантаНаСервере(Настройки)
	Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("ДополнительныеДанные", Новый ХранилищеЗначения(Новый Структура("ТаблицаИнтервалов",РеквизитФормыВЗначение("ТаблицаИнтервалов"))));
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеВариантаНаСервере(Настройки)
	Если Настройки<>Неопределено Тогда
		Пар=Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("ДополнительныеДанные"));	
		Если ТипЗнч(Пар.Значение)=Тип("ХранилищеЗначения") и ТипЗнч(Пар.Значение.Получить())=Тип("Структура") Тогда
			ЗначениеВРеквизитФормы(Пар.Значение.Получить().ТаблицаИнтервалов,"ТаблицаИнтервалов");
			ЗаполнитьНастройкиИнтерваловОтчета();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСтандартныеНастройкиНаСервере()
	ОтчетОбъект=РеквизитФормыВЗначение("Отчет");
	СКД=ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(СКД.НастройкиПоУмолчанию);
    ЗаполнитьНастройкиИнтерваловОтчета();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьСтандартныеНастройки(Команда)
	ЗагрузитьСтандартныеНастройкиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	ВариантыОтчетов.ПриСохраненииПользовательскихНастроекНаСервере(ЭтотОбъект, Настройки);
КонецПроцедуры
