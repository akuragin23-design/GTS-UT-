		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ДокументЗаказКлиента.Ссылка КАК Заказ,
	ДокументЗаказКлиента.ПометкаУдаления КАК ПометкаУдаления,
	ДокументЗаказКлиента.Номер КАК НомерСчета,
	ДокументЗаказКлиента.Дата КАК ДатаСоздания,
	ДокументЗаказКлиента.СуммаДокумента КАК СуммаСчета,
	ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОплаты, 0) КАК СуммаОплаты,
	ВЫБОР
		КОГДА ДокументЗаказКлиента.СуммаДокумента - ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОплаты, 0) &gt; 0
			ТОГДА ДокументЗаказКлиента.СуммаДокумента - ЕСТЬNULL(СостоянияЗаказовКлиентов.СуммаОплаты, 0)
		ИНАЧЕ 0
	КОНЕЦ КАК Долг,
	ДокументЗаказКлиента.ПлановаяДатаГотовности КАК ДатаГотовностиПлановая,
	ДокументЗаказКлиента.ЖелаемаяДатаОтгрузки КАК ДатаПланируемойОтгрузки,
	ДокументЗаказКлиента.НомерПоДаннымКлиента КАК НомерПоДаннымКлиента,
	ДокументЗаказКлиента.ДатаПоДаннымКлиента КАК ДатаПоДаннымКлиента
ПОМЕСТИТЬ ДанныеЗаказов
ИЗ
	Документ.ЗаказКлиента КАК ДокументЗаказКлиента
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		ПО (СостоянияЗаказовКлиентов.Заказ = ДокументЗаказКлиента.Ссылка)
ГДЕ
	ДокументЗаказКлиента.ПлановаяДатаГотовности МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания

ИНДЕКСИРОВАТЬ ПО
	Заказ
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.НомерСтроки) КАК Количество
ПОМЕСТИТЬ КоличествоНеОтмененныхСтрокЗаказов
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
ГДЕ
	ЗаказКлиентаТовары.Ссылка В
			(ВЫБРАТЬ
				ДанныеЗаказов.Заказ
			ИЗ
				ДанныеЗаказов КАК ДанныеЗаказов)
	И НЕ ЗаказКлиентаТовары.Отменено
	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗаказКлиентаТовары.НомерСтроки) КАК Количество
ПОМЕСТИТЬ КоличествоОбеспеченныхСтрокЗаказов
ИЗ
	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
ГДЕ
	ЗаказКлиентаТовары.Ссылка В
			(ВЫБРАТЬ
				ДанныеЗаказов.Заказ
			ИЗ
				ДанныеЗаказов КАК ДанныеЗаказов)
	И НЕ ЗаказКлиентаТовары.Отменено
	И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить)
			ИЛИ ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада))
	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры &lt;&gt; ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)

СГРУППИРОВАТЬ ПО
	ЗаказКлиентаТовары.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	РеализацияТоваровУслуг.ЗаказКлиента КАК Заказ,
	МИНИМУМ(РеализацияТоваровУслуг.Дата) КАК ДатаОтгрузкиФакт
ПОМЕСТИТЬ ДатыФактическойОтгрузкиПоЗаказам
ИЗ
	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
ГДЕ
	РеализацияТоваровУслуг.ЗаказКлиента В
			(ВЫБРАТЬ
				ДанныеЗаказов.Заказ
			ИЗ
				ДанныеЗаказов КАК ДанныеЗаказов)
	И РеализацияТоваровУслуг.Проведен

СГРУППИРОВАТЬ ПО
	РеализацияТоваровУслуг.ЗаказКлиента
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ДанныеЗаказов.Заказ КАК Заказ,
	ДанныеЗаказов.ПометкаУдаления КАК ПометкаУдаления,
	ДанныеЗаказов.ДатаСоздания КАК ДатаСоздания,
	ДанныеЗаказов.СуммаОплаты КАК СуммаОплаты,
	ДанныеЗаказов.Долг КАК Долг,
	ДанныеЗаказов.ДатаГотовностиПлановая КАК ДатаГотовностиПлановая,
	ДанныеЗаказов.ДатаПланируемойОтгрузки КАК ДатаПланируемойОтгрузки,
	ВЫБОР
		КОГДА ЕСТЬNULL(КоличествоНеОтмененныхСтрокЗаказов.Количество, 0) = 0
			ТОГДА 100
		ИНАЧЕ ЕСТЬNULL(КоличествоОбеспеченныхСтрокЗаказов.Количество, 0) / ЕСТЬNULL(КоличествоНеОтмененныхСтрокЗаказов.Количество, 0) * 100
	КОНЕЦ КАК НаличиеТовара,
	ДатыФактическойОтгрузкиПоЗаказам.ДатаОтгрузкиФакт КАК ДатаОтгрузкиФакт,
	ДанныеЗаказов.СуммаСчета КАК СуммаСчета,
	ДанныеЗаказов.НомерСчета КАК НомерСчета,
	ДанныеЗаказов.НомерПоДаннымКлиента КАК НомерПоДаннымКлиента,
	ДанныеЗаказов.ДатаПоДаннымКлиента КАК ДатаПоДаннымКлиента
ИЗ
	ДанныеЗаказов КАК ДанныеЗаказов
		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоНеОтмененныхСтрокЗаказов КАК КоличествоНеОтмененныхСтрокЗаказов
		ПО ДанныеЗаказов.Заказ = КоличествоНеОтмененныхСтрокЗаказов.Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоОбеспеченныхСтрокЗаказов КАК КоличествоОбеспеченныхСтрокЗаказов
		ПО ДанныеЗаказов.Заказ = КоличествоОбеспеченныхСтрокЗаказов.Заказ
		ЛЕВОЕ СОЕДИНЕНИЕ ДатыФактическойОтгрузкиПоЗаказам КАК ДатыФактическойОтгрузкиПоЗаказам
		ПО ДанныеЗаказов.Заказ = ДатыФактическойОтгрузкиПоЗаказам.Заказ</query>
