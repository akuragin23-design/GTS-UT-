		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(СделкиСКлиентами.ДатаНачала, ДЕНЬ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(СделкиСКлиентами.ДатаНачала, НЕДЕЛЯ)
				ИНАЧЕ ВЫБОР
						КОГДА &amp;ТипПериода = 3
							ТОГДА НАЧАЛОПЕРИОДА(СделкиСКлиентами.ДатаНачала, МЕСЯЦ)
						ИНАЧЕ НАЧАЛОПЕРИОДА(СделкиСКлиентами.ДатаНачала, ГОД)
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК Дат,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(СделкиСКлиентами.ДатаНачала, НЕДЕЛЯ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(СделкиСКлиентами.ДатаНачала, МЕСЯЦ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(СделкиСКлиентами.ДатаНачала, ГОД)
			КОНЕЦ
	КОНЕЦ КАК ГруппаДат,
	СделкиСКлиентами.Ответственный,
	СделкиСКлиентами.Ответственный.Подразделение КАК ОтветственныйТекущееПодразделение,
	СделкиСКлиентами.Статус,
	СделкиСКлиентами.ПричинаПроигрышаСделки,
	СделкиСКлиентами.Ссылка,
	СделкиСКлиентами.ДатаНачала,
	ИсточникиПервичногоИнтереса.КаналПервичногоИнтереса,
	ИсточникиПервичногоИнтереса.ИсточникПервичногоИнтереса,
	СделкиСКлиентами.ИнтересПоСегментамНоменклатуры.(
		Ссылка,
		НомерСтроки,
		СегментНоменклатуры
	),
	МаркетинговыеМероприятия.Ссылка КАК МаркетинговыеМероприятия
ИЗ
	Справочник.СделкиСКлиентами КАК СделкиСКлиентами
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсточникиПервичногоИнтереса КАК ИсточникиПервичногоИнтереса
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.МаркетинговыеМероприятия КАК МаркетинговыеМероприятия
			ПО ИсточникиПервичногоИнтереса.ИсточникПервичногоИнтереса = МаркетинговыеМероприятия.Ссылка
		ПО (ИсточникиПервичногоИнтереса.Сделка = СделкиСКлиентами.Ссылка)
ГДЕ
	СделкиСКлиентами.ДатаНачала МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания
	И СделкиСКлиентами.Статус &lt;&gt; ЗНАЧЕНИЕ(Перечисление.СтатусыСделок.ВРаботе)</query>
	</dataSet>
