		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	сег_ДвиженияПоСегментамОбороты.Партнер КАК Партнер,
	сег_ДвиженияПоСегментамОбороты.Сегмент КАК Сегмент,
	сег_ДвиженияПоСегментамОбороты.Подразделение КАК Подразделение,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ДЕНЬ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
			КОНЕЦ
	КОНЕЦ КАК Дат,
	сег_ДвиженияПоСегментамОбороты.БизнесРегион КАК Регион,
	сег_ДвиженияПоСегментамОбороты.Менеджер КАК Менеджер,
	сег_ДвиженияПоСегментамОбороты.Номенклатура КАК Номенклатура,
	СУММА(ВЫБОР
			КОГДА &amp;Показатель = 1
				ТОГДА 0
			ИНАЧЕ сег_ДвиженияПоСегментамОбороты.СуммаВыручкиОборот / КурсыВалютСрезПоследних.Курс
		КОНЕЦ) КАК Показатель,
	СУММА(ВЫБОР
			КОГДА &amp;Показатель = 1
				ТОГДА 0
			ИНАЧЕ сег_ДвиженияПоСегментамОбороты.СуммаВыручкиОборот / КурсыВалютСрезПоследних.Курс
		КОНЕЦ) КАК СреднийПоказатель,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ГОД)
			КОНЕЦ
	КОНЕЦ КАК ГрупДат
ИЗ
	РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &amp;ВыбВалюта) КАК КурсыВалютСрезПоследних,
	РегистрНакопления.сег_ДвиженияПоСегментам.Обороты(
			,
			,
			День,
			Сегмент В ИЕРАРХИИ (&amp;ВидСегментаПартнера)
				И ВЫБОР
					КОГДА НЕ &amp;Показатель = 2
						ТОГДА Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
					ИНАЧЕ ИСТИНА
				КОНЕЦ) КАК сег_ДвиженияПоСегментамОбороты
ГДЕ
	&amp;Показатель = 2
	И сег_ДвиженияПоСегментамОбороты.СуммаВыручкиОборот &gt; 0
	И ВЫБОР
			КОГДА &amp;ФильтрПодрОрг = 1
				ТОГДА сег_ДвиженияПоСегментамОбороты.Подразделение &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
						И НЕ сег_ДвиженияПоСегментамОбороты.Подразделение В (&amp;ПодразделениеФирма)
			ИНАЧЕ сег_ДвиженияПоСегментамОбороты.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ФильтрПодрОрг = 2
				ТОГДА НЕ сег_ДвиженияПоСегментамОбороты.ПодразделениеФирмы В (&amp;ПодразделениеФирма)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	сег_ДвиженияПоСегментамОбороты.Партнер,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ДЕНЬ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
			КОНЕЦ
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ГОД)
			КОНЕЦ
	КОНЕЦ,
	сег_ДвиженияПоСегментамОбороты.Сегмент,
	сег_ДвиженияПоСегментамОбороты.БизнесРегион,
	сег_ДвиженияПоСегментамОбороты.Менеджер,
	сег_ДвиженияПоСегментамОбороты.Номенклатура,
	сег_ДвиженияПоСегментамОбороты.Подразделение

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	сег_ДвиженияПоСегментамОбороты.Партнер,
	сег_ДвиженияПоСегментамОбороты.Сегмент,
	сег_ДвиженияПоСегментамОбороты.Подразделение,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ДЕНЬ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
			КОНЕЦ
	КОНЕЦ,
	сег_ДвиженияПоСегментамОбороты.БизнесРегион,
	сег_ДвиженияПоСегментамОбороты.Менеджер,
	NULL,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ сег_ДвиженияПоСегментамОбороты.Партнер),
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ сег_ДвиженияПоСегментамОбороты.Партнер),
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ГОД)
			КОНЕЦ
	КОНЕЦ
ИЗ
	РегистрСведений.КурсыВалют.СрезПоследних(, Валюта = &amp;ВыбВалюта) КАК КурсыВалютСрезПоследних,
	РегистрНакопления.сег_ДвиженияПоСегментам.Обороты(, , День, Сегмент В ИЕРАРХИИ (&amp;ВидСегментаПартнера)) КАК сег_ДвиженияПоСегментамОбороты
ГДЕ
	&amp;Показатель = 1
	И сег_ДвиженияПоСегментамОбороты.СуммаВыручкиОборот &gt; 0
	И ВЫБОР
			КОГДА &amp;ФильтрПодрОрг = 1
				ТОГДА сег_ДвиженияПоСегментамОбороты.Подразделение &lt;&gt; ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
						И НЕ сег_ДвиженияПоСегментамОбороты.Подразделение В (&amp;ПодразделениеФирма)
			ИНАЧЕ сег_ДвиженияПоСегментамОбороты.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка)
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ФильтрПодрОрг = 2
				ТОГДА НЕ сег_ДвиженияПоСегментамОбороты.ПодразделениеФирмы В (&amp;ПодразделениеФирма)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ДЕНЬ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
			КОНЕЦ
	КОНЕЦ,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ГОД)
			КОНЕЦ
	КОНЕЦ,
	сег_ДвиженияПоСегментамОбороты.Сегмент,
	сег_ДвиженияПоСегментамОбороты.БизнесРегион,
	сег_ДвиженияПоСегментамОбороты.Менеджер,
	сег_ДвиженияПоСегментамОбороты.Подразделение,
	сег_ДвиженияПоСегментамОбороты.Партнер

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	сег_ДвиженияПоСегментамОбороты.Партнер,
	сег_ДвиженияПоСегментамОбороты.Сегмент,
	сег_ДвиженияПоСегментамОбороты.Подразделение,
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, ДЕНЬ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
				ИНАЧЕ НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, МЕСЯЦ)
			КОНЕЦ
	КОНЕЦ,
	сег_ДвиженияПоСегментамОбороты.БизнесРегион,
	сег_ДвиженияПоСегментамОбороты.Менеджер,
	NULL,
	СУММА(сег_ДвиженияПоСегментамОбороты.СуммаОплатыОборот / КурсыВалютСрезПоследних.Курс),
	СУММА(сег_ДвиженияПоСегментамОбороты.СуммаОплатыОборот / КурсыВалютСрезПоследних.Курс),
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(сег_ДвиженияПоСегментамОбороты.Период, НЕДЕЛЯ)
		ИНАЧЕ ВЫБОР
