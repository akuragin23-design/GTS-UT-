			<dataPath>Номенклатура</dataPath>
			<field>Номенклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>РемонтируемаяНоменклатура</dataPath>
			<field>РемонтируемаяНоменклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодготовкаТехникиНоменклатура</dataPath>
			<field>ПодготовкаТехникиНоменклатура</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодготовкаТехникиКоличество</dataPath>
			<field>ПодготовкаТехникиКоличество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Подготовка техники количество</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ 	ОперацииОтделаСервиса.ВидРаботы,
	ОперацииОтделаСервиса.Ссылка,
	ОперацииОтделаСервиса.ЗатраченноеВремя,
	ОперацииОтделаСервиса.ВремяНаДорогу,
	ОперацииОтделаСервиса.ДатаВыдачи,
	ОперацииОтделаСервиса.НаличиеГарантии,
	ЕСТЬNULL(ОперацииОтделаСервисаРемонтируемаяНоменклатура.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК РемонтируемаяНоменклатура,
	ОперацииОтделаСервисаВыполненныеРаботы.Номенклатура,
	ОперацииОтделаСервисаВыполненныеРаботы.Количество,
	ОперацииОтделаСервисаТехника.Номенклатура КАК ПодготовкаТехникиНоменклатура,
	ОперацииОтделаСервисаТехника.Количество как ПодготовкаТехникиКоличество

	
ИЗ
	Документ.ОперацииОтделаСервиса КАК ОперацииОтделаСервиса
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОперацииОтделаСервиса.РемонтируемаяНоменклатура КАК ОперацииОтделаСервисаРемонтируемаяНоменклатура
		ПО (ОперацииОтделаСервисаРемонтируемаяНоменклатура.Ссылка = ОперацииОтделаСервиса.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОперацииОтделаСервиса.ВыполненныеРаботы КАК ОперацииОтделаСервисаВыполненныеРаботы
		ПО (ОперацииОтделаСервисаВыполненныеРаботы.Ссылка = ОперацииОтделаСервиса.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОперацииОтделаСервиса.Техника КАК ОперацииОтделаСервисаТехника
		ПО (ОперацииОтделаСервисаТехника.Ссылка = ОперацииОтделаСервиса.Ссылка)
ГДЕ
	ОперацииОтделаСервиса.Проведен = ИСТИНА
	И ОперацииОтделаСервиса.ПометкаУдаления = ЛОЖЬ
	И ОперацииОтделаСервиса.Дата МЕЖДУ &amp;ДатаНачала И &amp;ДатаОкончания</query>
	</dataSet>
