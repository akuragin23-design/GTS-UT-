		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	ВЫБОР
		КОГДА &amp;ТипПериода = 1
			ТОГДА НАЧАЛОПЕРИОДА(КурсыВалют.Период, ДЕНЬ)
		ИНАЧЕ ВЫБОР
				КОГДА &amp;ТипПериода = 2
					ТОГДА НАЧАЛОПЕРИОДА(КурсыВалют.Период, НЕДЕЛЯ)
				ИНАЧЕ ВЫБОР
						КОГДА &amp;ТипПериода = 3
							ТОГДА НАЧАЛОПЕРИОДА(КурсыВалют.Период, МЕСЯЦ)
						ИНАЧЕ НАЧАЛОПЕРИОДА(КурсыВалют.Период, ГОД)
					КОНЕЦ
			КОНЕЦ
	КОНЕЦ КАК ЧислоИнтервалов
ИЗ
	РегистрСведений.КурсыВалют КАК КурсыВалют
ГДЕ
	КурсыВалют.Период МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
