&НаСервере
Процедура СформироватьНаСервере()
	// В табличном документе будем заменять слова в шапке на значения отбора
	СхемаКомпоновкиДанных = Отчеты.ОтчетПоКонтактнойИнформацииПартнеров.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	ВариантыНастроек = СхемаКомпоновкиДанных.ВариантыНастроек;
	
	
	Для каждого ВариантНастройки Из ВариантыНастроек Цикл
		Если ВариантНастройки.Имя = Вариант Тогда
			Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(ВариантНастройки.Настройки);		
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Настройки = Отчет.КомпоновщикНастроек.Настройки;
	Настройки.Отбор.Элементы.Очистить(); 
	
	
	
	Если ВидОтбораПоДатам = "ПоДатеОбращения" Тогда  

		Запрос = Новый Запрос; 
		ТекстУсловия = "";
		Если ВидОтбораСегментыНоменклатуры = "ВСписке" Тогда
			ТекстУсловия = "
			|	 И СделкиСКлиентами.ИнтересПоСегментамНоменклатуры.СегментНоменклатуры В(&СегментНоменклатуры)";
			Запрос.УстановитьПараметр("СегментНоменклатуры", ОтборСегментыНоменклатуры);
		ИначеЕсли ВидОтбораСегментыНоменклатуры = "НеВСписке" Тогда
			ТекстУсловия = "
			|	И (НЕ СделкиСКлиентами.ИнтересПоСегментамНоменклатуры.СегментНоменклатуры В (&СегментНоменклатуры))";
			Запрос.УстановитьПараметр("СегментНоменклатуры", ОтборСегментыНоменклатуры);
		КонецЕсли;	 
		
		Если ВидОтбораПодразделения = "ВСписке" Тогда
			ТекстУсловия = ТекстУсловия + "
			|	И СделкиСКлиентами.Подразделение В(&Подразделения)";
			Запрос.УстановитьПараметр("Подразделения", ОтборПодразделения);
		ИначеЕсли ВидОтбораПодразделения = "НеВСписке" Тогда
			ТекстУсловия = ТекстУсловия + "
			|	И (НЕ СделкиСКлиентами.Подразделение В(&Подразделения))";
			Запрос.УстановитьПараметр("Подразделения", ОтборПодразделения);
		КонецЕсли;	

		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СделкиСКлиентами.Партнер КАК Партнер
		|ИЗ
		|	Справочник.СделкиСКлиентами КАК СделкиСКлиентами
		|ГДЕ
		|	НЕ СделкиСКлиентами.ПометкаУдаления
		|	И СделкиСКлиентами.ДатаНачала МЕЖДУ &НачДата И &КонДата
		|	И СделкиСКлиентами.Партнер <> ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)" + ТекстУсловия + " ";
		Запрос.УстановитьПараметр("НачДата", НачДата);
		Запрос.УстановитьПараметр("КонДата", КонецДня(КонДата));
				
		СписокПартнеры = Новый СписокЗначений;
		СписокПартнеры.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Партнер"));
		
		ОтборПоДате = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоДате.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Партнер"); 
		ОтборПоДате.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборПоДате.ПравоеЗначение = СписокПартнеры;
		
	ИначеЕсли ВидОтбораПоДатам = "ПоДатеОтгрузки" Тогда
		ТекстУсловия = "";
		
		Запрос = Новый Запрос;
		
		Если ВидОтбораМенеджеры = "ВСписке" Тогда
			ТекстУсловия = "
			|	ЗаказКлиента.Менеджер В(&Менеджеры)";
			Запрос.УстановитьПараметр("Менеджеры", ОтборМенеджеры);
		ИначеЕсли ВидОтбораМенеджеры = "НеВСписке" Тогда
			ТекстУсловия = "
			|	(НЕ ЗаказКлиента.Менеджер В(&Менеджеры))";
			Запрос.УстановитьПараметр("Менеджеры", ОтборМенеджеры);
		КонецЕсли;	
		
		Если ВидОтбораПодразделения = "ВСписке" Тогда
			ТекстУсловия = ТекстУсловия + ?(ПустаяСтрока(ТекстУсловия),"", " И ") + "
			|	Подразделение В(&Подразделения)";
			Запрос.УстановитьПараметр("Подразделения", ОтборПодразделения);
		ИначеЕсли ВидОтбораПодразделения = "НеВСписке" Тогда
			ТекстУсловия = ТекстУсловия + ?(ПустаяСтрока(ТекстУсловия),"", " И ") + "
			|	(НЕ Подразделение В(&Подразделения))";
			Запрос.УстановитьПараметр("Подразделения", ОтборПодразделения);
		КонецЕсли;	
		
		//Если НЕ ПустаяСтрока(ТекстУсловия) Тогда
		//	ТекстУсловия = Символы.ПС + "ГДЕ " + Символы.ПС + ТекстУсловия;
		//КонецЕсли;
		
		Если ВидОтбораНоменклатура <> "НеИспользовать" Тогда
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОбАналитикаУчетаПоПартнерам.Партнер
			|ИЗ
			|	РегистрСведений.АналитикаУчетаНоменклатуры КАК ОбАналитикаУчетаНоменклатуры
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачДата,&КонДата,," + ТекстУсловия + ") КАК ВыручкаИСебестоимостьПродажОбороты
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК ОбАналитикаУчетаПоПартнерам
			|			ПО ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам = ОбАналитикаУчетаПоПартнерам.КлючАналитики
			|		ПО ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаНоменклатуры = ОбАналитикаУчетаНоменклатуры.КлючАналитики
			| ГДЕ
			| " + ?(ВидОтбораНоменклатура = "ВСписке", "ОбАналитикаУчетаНоменклатуры.Номенклатура В Иерархии(&Номенклатура)", "(НЕ ОбАналитикаУчетаНоменклатуры.Номенклатура В Иерархии(&Номенклатура))");
			Запрос.УстановитьПараметр("Номенклатура", ОтборНоменклатура);
		Иначе	
			
			Запрос.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ОбАналитикаУчетаПоПартнерам.Партнер
			|ИЗ
			|	РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты(&НачДата,&КонДата,," + ТекстУсловия + ") КАК ВыручкаИСебестоимостьПродажОбороты
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК ОбАналитикаУчетаПоПартнерам
			|		ПО ВыручкаИСебестоимостьПродажОбороты.АналитикаУчетаПоПартнерам = ОбАналитикаУчетаПоПартнерам.КлючАналитики";
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("НачДата", НачДата);
		Запрос.УстановитьПараметр("КонДата", КонецДня(КонДата));
		
		
		СписокПартнеры = Новый СписокЗначений;
		СписокПартнеры.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Партнер"));
		
		ОтборПоДате = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоДате.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Партнер"); 
		ОтборПоДате.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборПоДате.ПравоеЗначение = СписокПартнеры;
	
	Иначе
		// по дате регистрации в ИБ
		ОтборПоДате = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоДате.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаРегистрации"); 
		ОтборПоДате.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		ОтборПоДате.ПравоеЗначение = НачДата;
		
		ОтборПоДате = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоДате.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДатаРегистрации"); 
		ОтборПоДате.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		ОтборПоДате.ПравоеЗначение = КонецДня(КонДата);
		
    КонецЕсли;
	
	Если ВидОтбораБизнесРегионы = "ВСписке" Тогда
		ОтборПоДате = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоДате.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("БизнесРегион"); 
		ОтборПоДате.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборПоДате.ПравоеЗначение = ОтборПоБизнесРегионам;
	ИначеЕсли ВидОтбораБизнесРегионы = "НЕВСписке" Тогда
		ОтборПоДате = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоДате.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("БизнесРегион"); 
		ОтборПоДате.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
		ОтборПоДате.ПравоеЗначение = ОтборПоБизнесРегионам;
	КонецЕсли;	
	//Отбор по Сегменту Клиентов
	Если ЗначениеЗаполнено(СегментКлиентов) Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПартнерыСегмента.Партнер КАК Партнер
		|ИЗ
		|	РегистрСведений.ПартнерыСегмента КАК ПартнерыСегмента
		|ГДЕ
		|	ПартнерыСегмента.Сегмент = &Сегмент";
	
		Запрос.УстановитьПараметр("Сегмент", СегментКлиентов);
	
		СписокПартнеры1 = Новый СписокЗначений;
		СписокПартнеры1.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Партнер"));
		ОтборПоДате = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборПоДате.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Партнер"); 
		ОтборПоДате.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ОтборПоДате.ПравоеЗначение = СписокПартнеры1;
	КонецЕсли;
	
	СписокВидовКИ = Новый СписокЗначений;
	Для каждого ВеткаГруппа Из ОтборПоВидамКИ.ПолучитьЭлементы() Цикл
		ПометитьВсе = Ложь;
		Если ВеткаГруппа.Пометка Тогда
			ПометитьВсе = Истина;
		КонецЕсли;
		Для каждого ВеткаЭлемент Из ВеткаГруппа.ПолучитьЭлементы() Цикл
			Если ПометитьВсе Тогда
				СписокВидовКИ.Добавить(ВеткаЭлемент.ВидКИ);
			Иначе
				Если ВеткаЭлемент.Пометка Тогда
					СписокВидовКИ.Добавить(ВеткаЭлемент.ВидКИ);
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
	ОтборВидыКИ = Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборВидыКИ.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Вид"); 
	ОтборВидыКИ.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборВидыКИ.ПравоеЗначение = СписокВидовКИ;
		
		
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки);
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);
	
	ДокРезультат.Очистить();
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокРезультат);
	
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
КонецПроцедуры//СформироватьНаСервере()

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА СправочникВидыКонтактнойИнформации.ЭтоГруппа
	|			ТОГДА 0
	|		ИНАЧЕ СправочникВидыКонтактнойИнформации.Тип.Порядок + 2
	|	КОНЕЦ КАК НомерКартинки,
	|	СправочникВидыКонтактнойИнформации.Родитель КАК Родитель,
	|	СправочникВидыКонтактнойИнформации.Ссылка КАК ВидКИ
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК СправочникВидыКонтактнойИнформации
	|ГДЕ
	|	(СправочникВидыКонтактнойИнформации.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.СправочникПартнеры))
	|			ИЛИ СправочникВидыКонтактнойИнформации.Ссылка В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.СправочникКонтактныеЛицаПартнеров)))
	|	И (НЕ СправочникВидыКонтактнойИнформации.ЭтоГруппа)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СправочникВидыКонтактнойИнформации.Тип,
	|	СправочникВидыКонтактнойИнформации.Наименование
	|ИТОГИ ПО
	|	Родитель";
	ОтборПоВидамКИ.ПолучитьЭлементы().Очистить();
	ВыборкаРодитель = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРодитель.Следующий() Цикл
		ВеткаГруппа = ОтборПоВидамКИ.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(ВеткаГруппа, ВыборкаРодитель);
		ВеткаГруппа.ВидКИ = ВыборкаРодитель.Родитель;
		
		ВыборкаСсылка = ВыборкаРодитель.Выбрать();
		Пока ВыборкаСсылка.Следующий() Цикл
			ВеткаЭлемент = ВеткаГруппа.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(ВеткаЭлемент, ВыборкаСсылка);
		КонецЦикла;
	КонецЦикла;
	
	Если ПустаяСтрока(ВидОтбораПоДатам) Тогда
		ВидОтбораПоДатам = "ПоДатеОбращения";	
	КонецЕсли;
	Элементы.ГруппаОтборНоменклатура.Видимость = (ВидОтбораПоДатам = "ПоДатеОтгрузки");
	Элементы.ГруппаОтборСегментаНоменклатуры.Видимость = (ВидОтбораПоДатам = "ПоДатеОбращения");

	
	Если ПустаяСтрока(ВидОтбораМенеджеры) Тогда
		ВидОтбораМенеджеры = "НеИспользовать";	
	КонецЕсли;
	
	Если ПустаяСтрока(ВидОтбораПартнеры) Тогда
		ВидОтбораПартнеры = "НеИспользовать";
	КонецЕсли;
	
	Если ПустаяСтрока(ВидОтбораПодразделения) Тогда
		ВидОтбораПодразделения = "НеИспользовать";	
	КонецЕсли;
	
	Если ПустаяСтрока(ВидОтбораНоменклатура) Тогда
		ВидОтбораНоменклатура = "НеИспользовать";
	КонецЕсли;
	
	Если ПустаяСтрока(ВидОтбораБизнесРегионы) Тогда
		ВидОтбораБизнесРегионы = "НеИспользовать";
	КонецЕсли;    
	
	Если ПустаяСтрока(ВидОтбораСегментыНоменклатуры) Тогда
		ВидОтбораСегментыНоменклатуры = "НеИспользовать";
	КонецЕсли;

	
	Если ПустаяСтрока(Вариант) Тогда
		Вариант = "Партнеры";
	КонецЕсли;	
	
КонецПроцедуры//ПриСозданииНаСервере

&НаКлиенте
Процедура Сформировать(Команда)
	СформироватьНаСервере();
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницы.ПодчиненныеЭлементы.ГруппаСтрРезультат;
КонецПроцедуры

&НаКлиенте
Процедура ВидОтбораПоДатамПриИзменении(Элемент)
	
	Элементы.ГруппаОтборНоменклатура.Видимость = (ВидОтбораПоДатам = "ПоДатеОтгрузки");
	Элементы.ГруппаОтборСегментаНоменклатуры.Видимость = (ВидОтбораПоДатам = "ПоДатеОбращения");

	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	ВариантыОтчетов.ПриСохраненииПользовательскихНастроекНаСервере(ЭтотОбъект, Настройки);
КонецПроцедуры
