		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	Сегменты.Номенклатура,
	Сегменты.Характеристика,
	ИСТИНА КАК ИспользуетсяОтборПоСегментуНоменклатуры,
	Сегменты.Сегмент КАК СегментНоменклатуры
ПОМЕСТИТЬ ОтборПоСегментуНоменклатуры
ИЗ
	РегистрСведений.НоменклатураСегмента КАК Сегменты
{ГДЕ
	Сегменты.Сегмент.* КАК СегментНоменклатуры,
	Сегменты.Номенклатура.* КАК Номенклатура,
	Сегменты.Характеристика.* КАК Характеристика}

ИНДЕКСИРОВАТЬ ПО
	Сегменты.Номенклатура,
	Сегменты.Характеристика,
	ИспользуетсяОтборПоСегментуНоменклатуры
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Партнеры.Ссылка КАК Партнер,
	Партнеры.ОсновнойМенеджер КАК Менеджер,
	Партнеры.БизнесРегион КАК Регион,
	МАКСИМУМ(КонтактныеЛица.Лицо) КАК КонтактноеЛицо,
	МАКСИМУМ(КИ1.Представление) КАК Почта,
	МАКСИМУМ(КИ2.Представление) КАК Телефон,
	Сегменты.Подразделение КАК Подразделение,
	Сегменты.ДилерскийСегмент,
	Сегменты.МаркетинговыйСегмент,
	Сегменты.ОборотныйСегмент,
	Сегменты.СегментПоЧастотеЗаказов,
	ВыручкаИСебестоимостьПродажОбороты.ЕстьПродажиПоСегменту,
	ВыручкаИСебестоимостьПродажОбороты.Номенклатура,
	ВыручкаИСебестоимостьПродажОбороты.СегментНоменклатуры
ИЗ
	Справочник.Партнеры КАК Партнеры
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			ап_СегментацияСгрупированные.Партнер КАК Партнер,
			ап_СегментацияСгрупированные.Подразделение КАК Подразделение,
			МАКСИМУМ(ап_СегментацияСгрупированные.ДилерскийСегмент) КАК ДилерскийСегмент,
			МАКСИМУМ(ап_СегментацияСгрупированные.МаркетинговыйСегмент) КАК МаркетинговыйСегмент,
			МАКСИМУМ(ап_СегментацияСгрупированные.ОборотныйСегмент) КАК ОборотныйСегмент,
			МАКСИМУМ(ап_СегментацияСгрупированные.СегментПоЧастотеЗаказов) КАК СегментПоЧастотеЗаказов
		ИЗ
			(ВЫБРАТЬ
				ап_СегментацияДетализация.Партнер КАК Партнер,
				ап_СегментацияДетализация.Подразделение КАК Подразделение,
				ВЫБОР
					КОГДА ап_СегментацияДетализация.Сегмент В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ДилерскийСегмент))
						ТОГДА ВЫБОР
								КОГДА &amp;РсДилерскийСегмент
									ТОГДА ап_СегментацияДетализация.Сегмент
								ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
							КОНЕЦ
					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
				КОНЕЦ КАК ДилерскийСегмент,
				ВЫБОР
					КОГДА ап_СегментацияДетализация.Сегмент В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.сег_Сегменты.МаркетинговыйСегмент))
						ТОГДА ВЫБОР
								КОГДА &amp;РсМаркетинговыйСегмент
									ТОГДА ап_СегментацияДетализация.Сегмент
								ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
							КОНЕЦ
					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
				КОНЕЦ КАК МаркетинговыйСегмент,
				ВЫБОР
					КОГДА ап_СегментацияДетализация.Сегмент В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ОборотныйСегмент))
						ТОГДА ВЫБОР
								КОГДА &amp;РсОборотныйСегмент
									ТОГДА ап_СегментацияДетализация.Сегмент
								ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
							КОНЕЦ
					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
				КОНЕЦ КАК ОборотныйСегмент,
				ВЫБОР
					КОГДА ап_СегментацияДетализация.Сегмент В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.сег_Сегменты.СегментПоЧастотеЗаказов))
						ТОГДА ВЫБОР
								КОГДА &amp;РсСегментПоЧастотеЗаказов
									ТОГДА ап_СегментацияДетализация.Сегмент
								ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
							КОНЕЦ
					ИНАЧЕ ЗНАЧЕНИЕ(Справочник.сег_Сегменты.ПустаяСсылка)
				КОНЕЦ КАК СегментПоЧастотеЗаказов
			ИЗ
				РегистрСведений.сег_СегментацияКонтрагентов.СрезПоследних КАК ап_СегментацияДетализация) КАК ап_СегментацияСгрупированные
		
		СГРУППИРОВАТЬ ПО
			ап_СегментацияСгрупированные.Партнер,
			ап_СегментацияСгрупированные.Подразделение) КАК Сегменты
		ПО (Сегменты.Партнер = Партнеры.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КонтактныеЛицаПартнеров.Владелец КАК Владелец,
			КонтактныеЛицаПартнеров.Ссылка КАК Лицо
		ИЗ
			Справочник.КонтактныеЛицаПартнеров КАК КонтактныеЛицаПартнеров) КАК КонтактныеЛица
		ПО (КонтактныеЛица.Владелец = Партнеры.Ссылка)
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			Выручка.АналитикаУчетаПоПартнерам.Партнер КАК Партнер,
			ИСТИНА КАК ЕстьПродажиПоСегменту,
			ВЫБОР
				КОГДА &amp;ИспользуетсяОтборПоСегментуНоменклатуры = ИСТИНА
					ТОГДА Выручка.АналитикаУчетаНоменклатуры.Номенклатура
				ИНАЧЕ NULL
			КОНЕЦ КАК Номенклатура,
			ВЫБОР
				КОГДА &amp;ИспользуетсяОтборПоСегментуНоменклатуры = ИСТИНА
					ТОГДА ОтборПоСегментуНоменклатуры.СегментНоменклатуры
				ИНАЧЕ NULL
			КОНЕЦ КАК СегментНоменклатуры
		ИЗ
			РегистрНакопления.ВыручкаИСебестоимостьПродаж.Обороты КАК Выручка
				ЛЕВОЕ СОЕДИНЕНИЕ ОтборПоСегментуНоменклатуры КАК ОтборПоСегментуНоменклатуры
				ПО Выручка.АналитикаУчетаНоменклатуры.Номенклатура = ОтборПоСегментуНоменклатуры.Номенклатура
		{ГДЕ
			((Выручка.АналитикаУчетаНоменклатуры.Номенклатура, Выручка.АналитикаУчетаНоменклатуры.Характеристика) В
					(ВЫБРАТЬ
						ОтборПоСегментуНоменклатуры.Номенклатура,
						ОтборПоСегментуНоменклатуры.Характеристика
					ИЗ
						ОтборПоСегментуНоменклатуры
					ГДЕ
						ОтборПоСегментуНоменклатуры.ИспользуетсяОтборПоСегментуНоменклатуры = &amp;ИспользуетсяОтборПоСегментуНоменклатуры))}) КАК ВыручкаИСебестоимостьПродажОбороты
		ПО Партнеры.Ссылка = ВыручкаИСебестоимостьПродажОбороты.Партнер
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КИ.Ссылка КАК Ссылка,
			КИ.Представление КАК Представление
		ИЗ
			Справочник.Партнеры.КонтактнаяИнформация КАК КИ
		ГДЕ
			КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
			И КИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПартнера)) КАК КИ1
		ПО Партнеры.Ссылка = КИ1.Ссылка
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			КИ.Ссылка КАК Ссылка,
			КИ.Представление КАК Представление
		ИЗ
			Справочник.Партнеры.КонтактнаяИнформация КАК КИ
		ГДЕ
			КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
			И КИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПартнера)) КАК КИ2
		ПО Партнеры.Ссылка = КИ2.Ссылка
{ГДЕ
	(ВЫБОР
			КОГДА &amp;ИспользуетсяОтборПоСегментуНоменклатуры
				ТОГДА ВыручкаИСебестоимостьПродажОбороты.ЕстьПродажиПоСегменту
			ИНАЧЕ ИСТИНА
		КОНЕЦ)}

СГРУППИРОВАТЬ ПО
	Партнеры.Ссылка,
	Партнеры.ОсновнойМенеджер,
	Партнеры.БизнесРегион,
	Сегменты.Подразделение,
	Сегменты.ДилерскийСегмент,
	Сегменты.МаркетинговыйСегмент,
	Сегменты.ОборотныйСегмент,
	Сегменты.СегментПоЧастотеЗаказов,
	ВыручкаИСебестоимостьПродажОбороты.ЕстьПродажиПоСегменту,
	ВыручкаИСебестоимостьПродажОбороты.Номенклатура,
	ВыручкаИСебестоимостьПродажОбороты.СегментНоменклатуры</query>
	</dataSet>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>ИспользуетсяОтборПоСегментуНоменклатуры</name>
