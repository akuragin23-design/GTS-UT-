		ТабличныйДокумент.Вывести(Область);
		
	КонецЕсли;
	
	// Вывести подписи
	Область = Макет.ПолучитьОбласть("ПодвалСчета");
	Область.Параметры.ФИОРуководителя = ФизическиеЛицаУТ.ФамилияИнициалыФизЛица(ДанныеПечати.Руководитель);
