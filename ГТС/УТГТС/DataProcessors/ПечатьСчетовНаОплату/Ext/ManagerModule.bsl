	 Функция ПолучитьКурсВалюты(Валюта,Дата)  
		 //ASP_Crow 20.03.2025 000023395 В расширение
		 
		 Отбор = Новый Структура("Валюта",Валюта);
		 КурсВалют = РегистрыСведений.КурсыВалют.ПолучитьПоследнее(Дата,Отбор);
		 КурсВалюты = КурсВалют.Курс;
		 Возврат КурсВалюты;		 
		 
