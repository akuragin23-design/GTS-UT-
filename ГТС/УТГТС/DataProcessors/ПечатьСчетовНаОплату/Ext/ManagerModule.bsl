	 //Получаем цену товара 
	 Функция ЦенаНаТовар(Ссылка, ВидЦены, Дата)
		 //ASP_Crow 20.03.2025 000023395 В расширение
		 Запрос = Новый Запрос;
		 Запрос.Текст = 
		 "ВЫБРАТЬ
		 |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
		 |	ЦеныНоменклатурыСрезПоследних.Валюта КАК Валюта
		 |ИЗ
		 |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		 |			&Дата,
		 |			Номенклатура = &Ссылка
		 |				И ВидЦены = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних";
		 
		 Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
		 Запрос.УстановитьПараметр("Ссылка", Ссылка);
		 Запрос.УстановитьПараметр("Дата", Дата);
		 
		 РезультатЗапроса = Запрос.Выполнить();
		 Если РезультатЗапроса.Пустой()Тогда
			 ЦенаТовара = 0;
		 Иначе
			 ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			 ВыборкаДетальныеЗаписи.Следующий();
			 Если ВыборкаДетальныеЗаписи.Валюта = Справочники.Валюты.НайтиПоНаименованию("руб.") Тогда
				 ЦенаТовара = ВыборкаДетальныеЗаписи.Цена;
				 Возврат Формат(Окр(ЦенаТовара,0),"ЧДЦ=2");
			 Иначе
				 КурсВалюты = ПолучитьКурсВалюты(ВыборкаДетальныеЗаписи.Валюта,Дата);
				 ЦенаТовара = ВыборкаДетальныеЗаписи.Цена * КурсВалюты;
				 Возврат Формат((Окр(ЦенаТовара,0)),"ЧДЦ=2"); //Окр((Формат(ЦенаТовара,"ЧДЦ=2")),0);   
			 КонецЕсли;
		 КонецЕсли;
		 
