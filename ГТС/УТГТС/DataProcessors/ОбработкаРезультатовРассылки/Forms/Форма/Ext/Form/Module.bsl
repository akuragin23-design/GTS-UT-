// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.ПроверятьСуществованиеФайла = Истина;
	ДиалогВыбора.Расширение = "txt";
	ДиалогВыбора.Фильтр = "Текстовый документ(*.txt)|*.txt";
	
	Если ДиалогВыбора.Выбрать() Тогда
		ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;	
	КонецЕсли;	
	
КонецПроцедуры//ПутьКФайлуНачалоВыбора

&НаКлиенте
Процедура ЗаполнитьEmailИзФайла(Команда)
	
	ТекстовыйФайл = Новый Файл(ПутьКФайлу);
	Если НЕ ТекстовыйФайл.Существует() Тогда
		Сообщ = Новый СообщениеПользователю;
		Сообщ.Текст = "Проверьте путь к файлу!";
		Сообщ.Поле = "ПутьКФайлу";
		Сообщ.Сообщить();
		Возврат;	
	КонецЕсли;	
	
	ТекстДокумент = Новый ТекстовыйДокумент;
	
	Попытка
		ТекстДокумент.Прочитать(ПутьКФайлу);
	Исключение
		Сообщ = Новый СообщениеПользователю;
		Сообщ.Текст = "Проверьте путь к файлу или тип файла!";
		Сообщ.Поле = "ПутьКФайлу";
		Сообщ.Сообщить();
		Возврат;	
	КонецПопытки;
	
	ТаблицаСДанными.Очистить();
	
	КолвоСтрок = ТекстДокумент.КоличествоСтрок();
	Для i = 1 по КолвоСтрок Цикл
		Email = ТекстДокумент.ПолучитьСтроку(i);
		Если ПустаяСтрока(Email) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаДанные = ТаблицаСДанными.Добавить();
		СтрокаДанные.Email = Email;
	КонецЦикла;	
	
	ВариантОбработки = "";
КонецПроцедуры//ЗаполнитьEmailИзФайла

&НаКлиенте
Процедура ПодобратьПартнеровПоEmail(Команда)
	ПодобратьПартнеровНаСервере();
	ВариантОбработки = "";
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьEmailИПодобратьПартнеров(Команда)
	 ЗаполнитьEmailИзФайла("");
	 ПодобратьПартнеровПоEmail("");
КонецПроцедуры

&НаКлиенте
Процедура Обработать(Команда)
	
	Если ПустаяСтрока(ВариантОбработки) Тогда
		Сообщ = Новый СообщениеПользователю;
		Сообщ.Текст = "Укажите вариант обработки";
		Сообщ.Поле = "ВариантОбработки";
		Сообщ.Сообщить();
		Возврат;
	КонецЕсли;	
	
	ОбработатьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСДаннымиПартнерНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСДаннымиПартнерОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

