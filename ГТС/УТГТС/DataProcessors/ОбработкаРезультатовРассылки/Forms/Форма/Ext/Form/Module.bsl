// ОБРАБОТЧИКИ СЛУЖЕБНЫХ ФУНКЦИЙ И ПРОЦЕДУР НА СЕРВЕРЕ

&НаСервере
Процедура ПодобратьПартнеровНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка КАК КонтактноеЛицо,
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Владелец КАК Партнер,
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление КАК Email_КонтЛица,
		|	"""" КАК Email_Партнера 
		|ИЗ
		|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
		|ГДЕ
		|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	"""",
		|	ПартнерыКонтактнаяИнформация.Ссылка,
		|	"""",
		|	ПартнерыКонтактнаяИнформация.Представление
		|ИЗ
		|	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
		|ГДЕ
		|	ПартнерыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)";

	Результат = Запрос.Выполнить();

	ТЗ_КИ = Результат.Выгрузить();
	
	Для каждого СтрокаДанные Из ТаблицаСДанными Цикл
		Если ПустаяСтрока(СтрокаДанные.Email) Тогда
			Продолжить;
		КонецЕсли;	
		
		СтрокаКИ_КонтЛицо = ТЗ_КИ.Найти(СтрокаДанные.Email, "Email_КонтЛица");
		Если СтрокаКИ_КонтЛицо = Неопределено Тогда
			СтрокаДанные.КонтактноеЛицо = "";
			СтрокаДанные.Партнер = "";
			СтрокаДанные.Email_КонтЛица = "";
		Иначе	
			СтрокаДанные.КонтактноеЛицо = СтрокаКИ_КонтЛицо.КонтактноеЛицо;
			СтрокаДанные.Партнер = СтрокаКИ_КонтЛицо.Партнер;
			СтрокаДанные.Email_КонтЛица = СтрокаКИ_КонтЛицо.Email_КонтЛица;
		КонецЕсли;
		
		СтрокаКИ_Партнер = ТЗ_КИ.Найти(СтрокаДанные.Email, "Email_Партнера");
		Если СтрокаКИ_Партнер = Неопределено Тогда
			СтрокаДанные.Партнер = "";
			СтрокаДанные.Email_Партнера = "";
		Иначе	
			СтрокаДанные.Партнер = СтрокаКИ_Партнер.Партнер;
			СтрокаДанные.Email_Партнера = СтрокаКИ_Партнер.Email_Партнера;
		КонецЕсли;
		
		СтрокаДанные.Обработано = Ложь;
	КонецЦикла;	
	
	ТаблицаСДанными.Сортировать("Партнер, КонтактноеЛицо");
	
КонецПроцедуры//ПодобратьПартнеровНаСервере	

&НаСервере
Процедура ОбработатьНаСервере()
	
	Для каждого СтрокаДанные из ТаблицаСДанными Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаДанные.Партнер) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбрабатываемыйОбъект = Неопределено;
		Если СтрокаДанные.EMAIL_КонтЛица = СтрокаДанные.EMAIL Тогда
			ОбрабатываемыйОбъект = СтрокаДанные.КонтактноеЛицо.ПолучитьОбъект();
		ИначеЕсли СтрокаДанные.EMAIL_Партнера = СтрокаДанные.EMAIL Тогда
			ОбрабатываемыйОбъект = СтрокаДанные.Партнер.ПолучитьОбъект();
		Иначе
			Продолжить;
		КонецЕсли;	
		
		Если ВариантОбработки = "ОтказОтРассылки" Тогда
			
			СтрокаДопРекв = ОбрабатываемыйОбъект.ДополнительныеРеквизиты.Найти(?(ТипЗнч(ОбрабатываемыйОбъект) = Тип("СправочникОбъект.КонтактныеЛицаПартнеров"), ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.КонтактныеЛица_СогласиеНаРассылку,ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.Клиенты_СогласиеНаРассылку), "Свойство");
			
			Если СтрокаДопРекв <> Неопределено Тогда
				СтрокаДопРекв.Значение = Ложь;
				СтрокаДопРекв.ТекстоваяСтрока = "";
				ОбрабатываемыйОбъект.Записать();
				СтрокаДанные.Обработано = Истина;
			КонецЕсли;	
			
		Иначе
			СтрокаКИ_Объекта = ОбрабатываемыйОбъект.КонтактнаяИнформация.Найти(СтрокаДанные.Email, "Представление");
			Если СтрокаКИ_Объекта <> Неопределено Тогда
				СтрокаКИ_Объекта.Представление = "";
				СтрокаКИ_Объекта.АдресЭП = "";
				ОбрабатываемыйОбъект.Записать();
				СтрокаДанные.Обработано = Истина;
			КонецЕсли;	
			
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры//ОбработатьНаСервере()	

