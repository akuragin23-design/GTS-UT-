
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	//++//ASP_Crow 18.03.2026 000029567 В расширение
	//ASP_Dante 12/07/21 Задача 000011492 перенос доработок
	АрхивнаяПозиция=Параметры.Номенклатура.ASP_АрхивнаяПозиция;
	Если АрхивнаяПозиция=Истина Тогда
		Элементы.АрхивнаяПозицияКартинка.Видимость=Истина;
	КонецЕсли;
	//ASP_Dante 12/07/21
	Заголовок = Заголовок + ": "+ Параметры.Номенклатура;
	//ASP_Dante 12/07/21 Задача 000011492 перенос доработок
	Артикул = Параметры.Номенклатура.Артикул;
	Номенклатура=Параметры.Номенклатура;
	//ASP_Dante 12/07/21
	//--//ASP_Crow 18.03.2026 000029567 В расширение
	Если ЗначениеЗаполнено(Параметры.Характеристика) Тогда
		Элементы.СписокХарактеристика.Видимость = Ложь;
		Заголовок = Заголовок + " ("+ Параметры.Характеристика + ")";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Дата", Параметры.Дата); 
	
	//++//ASP_Crow 18.03.2026 000029567 В расширение
	//ГТС 13042021 добавляем закупочные цены
	Если РольДоступна("ПолныеПрава") ИЛИ РольДоступна("ASP_ЗакупочныеЦены") Тогда 
		ВидЦен = Новый СписокЗначений;
		ВидЦен.Добавить(Справочники.ВидыЦен.Закупочная); 
		попытка
			ВидЦен.Добавить(Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор("86430129-ae9a-4b4e-be0b-b7716059293c")));
		Исключение конецпопытки;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидЦены", ВидЦен)
	Иначе ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидЦены", Справочники.ВидыЦен.ПустаяСсылка()) ;
	КонецЕсли; 
	//--//ASP_Crow 18.03.2026 000029567 В расширение
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Номенклатура",
		Параметры.Номенклатура,
		ВидСравненияКомпоновкиДанных.Равно,,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список,
		"Характеристика",
		Параметры.Характеристика,
		ВидСравненияКомпоновкиДанных.Равно,,ЗначениеЗаполнено(Параметры.Характеристика)); 
		
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЦеныНоменклатуры.ВидЦены КАК ВидЦены,
	               |	ЦеныНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ЦеныНоменклатуры.Характеристика КАК Характеристика,
	               |	МАКСИМУМ(ЦеныНоменклатуры.Период) КАК Период
	               |ПОМЕСТИТЬ ВТДатыЦен
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	               |ГДЕ
	               |	(ЦеныНоменклатуры.ВидЦены В (&ВидЦены)
	               |			ИЛИ ЦеныНоменклатуры.ВидЦены.ИспользоватьПриПродаже = ИСТИНА)
	               |	И ЦеныНоменклатуры.Период <= &Дата
	               |	И ЦеныНоменклатуры.Номенклатура = &Номенклатура
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЦеныНоменклатуры.ВидЦены,
	               |	ЦеныНоменклатуры.Номенклатура,
	               |	ЦеныНоменклатуры.Характеристика
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТДатыЦен.ВидЦены КАК ВидЦены,
	               |	ВТДатыЦен.Номенклатура КАК Номенклатура,
	               |	ВТДатыЦен.Характеристика КАК Характеристика,
	               |	ВТДатыЦен.Период КАК Период,
	               |	ЦеныНоменклатуры.Цена КАК Цена,
	               |	ЦеныНоменклатуры.Упаковка КАК Упаковка,
	               |	ЦеныНоменклатуры.Валюта КАК Валюта
	               |ИЗ
	               |	ВТДатыЦен КАК ВТДатыЦен
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры КАК ЦеныНоменклатуры
	               |		ПО (ЦеныНоменклатуры.Период = ВТДатыЦен.Период)
	               |			И (ЦеныНоменклатуры.Номенклатура = ВТДатыЦен.Номенклатура)
	               |			И (ЦеныНоменклатуры.Характеристика = ВТДатыЦен.Характеристика)
	               |			И (ЦеныНоменклатуры.ВидЦены = ВТДатыЦен.ВидЦены)
	               |ГДЕ
	               |	ЦеныНоменклатуры.Цена > 0";
	
	//ГТС 13042021 добавляем закупочные цены
	Если РольДоступна("ПолныеПрава") ИЛИ РольДоступна("ASP_ЗакупочныеЦены") Тогда 
		ВидЦен = Новый СписокЗначений;
		ВидЦен.Добавить(Справочники.ВидыЦен.Закупочная); 
		попытка
			ВидЦен.Добавить(Справочники.ВидыЦен.ПолучитьСсылку(Новый УникальныйИдентификатор("86430129-ae9a-4b4e-be0b-b7716059293c")));
		Исключение конецпопытки;
		Запрос.УстановитьПараметр("ВидЦены", ВидЦен);
	Иначе 
		Запрос.УстановитьПараметр("ВидЦены", Справочники.ВидыЦен.ПустаяСсылка());
	КонецЕсли; 
	//
	
	Запрос.УстановитьПараметр("Номенклатура", Параметры.Номенклатура); 
	Запрос.УстановитьПараметр("Дата", Параметры.Дата);
	рез = Запрос.Выполнить().ВЫгрузить();
	Для каждого СтрРез из Рез Цикл
		НовСтр = СписокНетип.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр , СтрРез);
		НовСтр.ЕдИзм = НовСтр.Номенклатура.ЕдиницаИзмерения;
	КонецЦикла;
		
		
	//++//ASP_Crow 18.03.2026 000029567 В расширение
	//+ГТС суммируем цены комплектов 02062019
	если Параметры.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор Тогда
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВариантыКомплектацииНоменклатурыТовары.Номенклатура) КАК Номенклатура,
		|	СУММА(ВариантыКомплектацииНоменклатурыТовары.Количество) КАК Количество,
		|	СУММА(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0)) КАК Цена,
		|	ЦеныНоменклатурыСрезПоследних.ВидЦены КАК ВидЦены,
		|	ВариантыКомплектацииНоменклатуры.Владелец КАК Владелец,
		|	СУММА(ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) * ВариантыКомплектацииНоменклатурыТовары.Количество) КАК ЦенаИтог,
		|	МАКСИМУМ(ЦеныНоменклатурыСрезПоследних.Период) КАК Дата
		|ИЗ
		|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(КОНЕЦПЕРИОДА(&Дата, ДЕНЬ), {(Номенклатура).* КАК Номенклатура, (Характеристика).* КАК Характеристика}) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ВариантыКомплектацииНоменклатурыТовары.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|			И ВариантыКомплектацииНоменклатурыТовары.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
		|		ПО ВариантыКомплектацииНоменклатурыТовары.Ссылка = ВариантыКомплектацииНоменклатуры.Ссылка
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец = &Владелец
		|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Основной = ИСТИНА
		|	И (ЦеныНоменклатурыСрезПоследних.ВидЦены.ИспользоватьПриПродаже = ИСТИНА
		|			ИЛИ ЦеныНоменклатурыСрезПоследних.ВидЦены = &ВидЦены)
		|	И ЦеныНоменклатурыСрезПоследних.ВидЦены.ПометкаУдаления <> ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	ЦеныНоменклатурыСрезПоследних.ВидЦены,
		|	ВариантыКомплектацииНоменклатуры.Владелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидЦены
		|АВТОУПОРЯДОЧИВАНИЕ";
	  	Запрос.УстановитьПараметр("Владелец", Параметры.Номенклатура);
		Запрос.УстановитьПараметр("Дата", Параметры.Дата);
		//ГТС 13042021 добавляем закупочные цены
		Если РольДоступна("ПолныеПрава") ИЛИ РольДоступна("ASP_ЗакупочныеЦены") Тогда 
			ВидЦены=Справочники.ВидыЦен.Закупочная;
		Иначе 
			ВидЦены=Справочники.ВидыЦен.ПустаяСсылка();
		КонецЕсли;
		Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
		
	
		РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Количество()>0 Тогда
	    ЭтаФорма.Элементы.ГруппаЦенаНабора.Видимость = ИСТИНА;
		ЭтаФорма.Элементы.Список.Видимость = Ложь;
	КонецЕсли;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ЦенаИтог>0 Тогда
		новаяСтрока = ЦенаНабора.Добавить();
		ЗаполнитьЗначенияСвойств(новаяСтрока , ВыборкаДетальныеЗаписи);		
		Иначе
		КонецЕсли;
	КонецЦикла;
	
	КонецЕсли;
	// +ГТС суммируем цены комплектов 02062019 
	//--//ASP_Crow 18.03.2026 000029567 В расширение
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Остатки(Команда)
	// Вставить содержимое обработчика.
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Дата", ТекущаяДата());
	ПараметрыФормы.Вставить("Номенклатура", Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
	
	ОткрытьФорму("Обработка.ПодборТоваровВДокументПродажи.Форма.ОстаткиТоваровНаСкладах", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура НаСайте(Команда)
	ЗапуститьПриложение("https://gortorgsnab.ru/search/?q="+Артикул);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточку(Команда)
	ПараметрыФормы = Новый Структура;
	//ПараметрыФормы.Вставить("Дата", ТекущаяДата());
	ПараметрыФормы.Вставить("Ключ", Номенклатура);
	ПараметрыФормы.Вставить("Характеристика", ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма)

КонецПроцедуры

#КонецОбласти