	|	РегистрНакопления.ЗапасыИПотребности.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика) КАК ЗапасыИПотребностиОстатки";
	ЗапросОстатокРезервов.УстановитьПараметр("Номенклатура", Номенклатура);
	ЗапросОстатокРезервов.УстановитьПараметр("Характеристика", Характеристика);
	
	ТЗ_ОстаткиРезервов = ЗапросОстатокРезервов.Выполнить().Выгрузить();
	
	УстановитьПривилегированныйРежим(Истина);
	ЗапросРезервыПоЗаказам = Новый Запрос;
	ЗапросРезервыПоЗаказам.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЗаказыКлиентовОстатки.ДокументОтгрузки КАК ЗаказКлиента,
	|	ЗаказыКлиентовОстатки.Номенклатура КАК Номенклатура,
	|	ЗаказыКлиентовОстатки.Характеристика КАК Характеристика,
	|	ЗаказыКлиентовОстатки.Склад КАК Склад,
	// Добавлена часть для заказов на перемещение, на проверке. 15.12.2022
	//|	ЗаказыКлиентовОстатки.ВРезервеОстаток КАК ЗаказаноОстаток,
	|Выбор когда ДвижениеТоваров.ПланируемоеПоступлениеПодЗаказ>0 И ТИПЗНАЧения(ЗаказыКлиентовОстатки.ДокументОтгрузки)=ТИП(Документ.ЗаказНаПеремещение) Тогда ДвижениеТоваров.ПланируемоеПоступлениеПодЗаказ 
	|Когда ДвижениеТоваров.ПланируемоеПоступление>0 И ТИПЗНАЧения(ЗаказыКлиентовОстатки.ДокументОтгрузки)=ТИП(Документ.ЗаказНаПеремещение) Тогда ДвижениеТоваров.ПланируемоеПоступление
	|Иначе
	|ЗаказыКлиентовОстатки.ВРезервеОстаток
	|Конец	
	|КАК ЗаказаноОстаток,
    //Конец добавленной 15.12.2022 части
	|	ВЫБОР
	|		КОГДА РасчетыСКлиентамиПоДокументамОбороты.РасчетныйДокумент ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОплата,
	|	ВЫБОР
	|		КОГДА ЗаказыКлиентовОстатки.ДокументОтгрузки.Менеджер ЕСТЬ NULL
	|			ТОГДА ЗаказыКлиентовОстатки.ДокументОтгрузки.Ответственный
	|		ИНАЧЕ ЗаказыКлиентовОстатки.ДокументОтгрузки.Менеджер
	|	КОНЕЦ КАК Менеджер,
	|	ДвижениеТоваров.Назначение КАК Назначение
	|ИЗ
	|	РегистрНакопления.ТоварыКОтгрузке.Остатки(
	|			,
	|			Номенклатура = &Номенклатура
	|				И Характеристика = &Характеристика) КАК ЗаказыКлиентовОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентамиПоДокументам.Обороты(, , Регистратор, ) КАК РасчетыСКлиентамиПоДокументамОбороты
	|		ПО ЗаказыКлиентовОстатки.ДокументОтгрузки = РасчетыСКлиентамиПоДокументамОбороты.ЗаказКлиента.Объект
	|			И (РасчетыСКлиентамиПоДокументамОбороты.РасчетныйДокумент ССЫЛКА Документ.ПриходныйКассовыйОрдер
	|				ИЛИ РасчетыСКлиентамиПоДокументамОбороты.РасчетныйДокумент ССЫЛКА Документ.ПоступлениеБезналичныхДенежныхСредств)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДвижениеТоваров КАК ДвижениеТоваров
	|		ПО (ЗаказыКлиентовОстатки.ДокументОтгрузки = ДвижениеТоваров.Регистратор И ЗаказыКлиентовОстатки.Номенклатура = ДвижениеТоваров.Номенклатура)
	|ГДЕ
	|	ЗаказыКлиентовОстатки.ВРезервеОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕстьОплата,
	|	ЗаказыКлиентовОстатки.ДокументОтгрузки
	|АВТОУПОРЯДОЧИВАНИЕ";
	ЗапросРезервыПоЗаказам.УстановитьПараметр("Номенклатура", Номенклатура);
	ЗапросРезервыПоЗаказам.УстановитьПараметр("Характеристика", Характеристика);
	
	ВыборкаРезервыПоЗаказам = ЗапросРезервыПоЗаказам.Выполнить().Выбрать();
	ОтборСтрок = Новый Структура("Номенклатура, Характеристика,Склад");
	Пока ВыборкаРезервыПоЗаказам.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОтборСтрок, ВыборкаРезервыПоЗаказам);
		СтрокиОстатокРезерва = ТЗ_ОстаткиРезервов.НайтиСтроки(ОтборСтрок);
		Если СтрокиОстатокРезерва.Количество() > 0 Тогда
			СтрокаОстатокРезерва = СтрокиОстатокРезерва[0];
			Осталось = СтрокаОстатокРезерва.ВРезервеОстаток;
			Если Осталось <= 0 Тогда
				ТЗ_ОстаткиРезервов.Удалить(СтрокаОстатокРезерва);
				Продолжить;
			КонецЕсли;
			
			
			СтрокаРезервыПоЗаказам = РезервыПоЗаказам.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРезервыПоЗаказам, ВыборкаРезервыПоЗаказам);
			Списать = Мин(СтрокаОстатокРезерва.ВРезервеОстаток, ВыборкаРезервыПоЗаказам.ЗаказаноОстаток);
			Если ВыборкаРезервыПоЗаказам.ЕстьОплата Тогда
				СтрокаРезервыПоЗаказам.Оплачено = Списать;
			Иначе
				СтрокаРезервыПоЗаказам.НеОплачено = Списать;
			КонецЕсли;	
			
			СтрокаОстатокРезерва.ВРезервеОстаток = СтрокаОстатокРезерва.ВРезервеОстаток - Списать;
		КонецЕсли;	
	КонецЦикла;
	
	Элементы.НадписьВсегоНеОплаченныхРезервов.Заголовок = "Всего неоплаченных резервов по заказам клиентов: " + РезервыПоЗаказам.Итог("НеОплачено");
	
	Элементы.НадписьВсегоОплаченныхРезервов.Заголовок = "Всего оплаченных резервов по заказам клиентов: " + РезервыПоЗаказам.Итог("Оплачено");
	// /tise добавил 2010-12-07
	
	//Попытка
	ДопСвойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Срок поставки от поставщика");
	СрокПоставки = УправлениеСвойствами.ЗначениеСвойства(Номенклатура, ДопСвойство);
	ДопСвойствоПохожих = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию("Похожие модели");
	СтрокаПохожихМоделей=строка(УправлениеСвойствами.ЗначениеСвойства(Номенклатура,ДопСвойствоПохожих));
	Если ЗначениеЗаполнено(СтрокаПохожихМоделей) Тогда
	ОстаткиПохожихМоделей(Номенклатура,Характеристика,СтрокаПохожихМоделей);
	КонецЕсли;
	//Исключение
	//Сообщить("Исключение");
	//КонецПопытки;
	
	//ПараметрыСеанса.ИспользоватьОграниченияПравДоступаНаУровнеЗаписей=Истина;
КонецПроцедуры // ПриСозданииНаСервере()

