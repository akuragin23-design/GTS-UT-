&НаСервере
Процедура ОстаткиПохожихМоделей(Номенклатура,Характеристика,СтрокаПохожихМоделей);
	МассивАртикулов=СтрРазделить(СтрокаПохожихМоделей, "|" , Ложь);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК НоменклатураСсылка,
		|	Номенклатура.Артикул КАК Артикул
		|ПОМЕСТИТЬ СправочникНоменклатура
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Артикул В(&Артикул)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СправочникНоменклатура.НоменклатураСсылка КАК Номенклатура,
		|	СправочникНоменклатура.Артикул КАК Артикул,
		|	СУММА(ЗапасыИПотребностиОстатки.ВНаличииОстаток) КАК Свободно,
		|	СУММА(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток) КАК ВРезерве
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СправочникНоменклатура КАК СправочникНоменклатура
		|		ПО ЗапасыИПотребностиОстатки.Номенклатура = СправочникНоменклатура.НоменклатураСсылка
		|ГДЕ
		|	ЗапасыИПотребностиОстатки.Номенклатура В
		|			(ВЫБРАТЬ
		|				СправочникНоменклатура.НоменклатураСсылка КАК Номенклатура
		|			ИЗ
		|				СправочникНоменклатура КАК СправочникНоменклатура)
		|	И ЗапасыИПотребностиОстатки.Склад.ASP_ИспользоватьДляРасчетаОстатков = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	СправочникНоменклатура.НоменклатураСсылка,
		|	СправочникНоменклатура.Артикул";
	
	Запрос.УстановитьПараметр("Артикул", МассивАртикулов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрока=ПохожиеМодели.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,ВыборкаДетальныеЗаписи);
		Элементы.ПохожиеМодели.Видимость=Истина;
	КонецЦикла;
		
	
КонецПроцедуры

