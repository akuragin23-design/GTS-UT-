

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьПривилегированныйРежим(Истина);
	//Добавляем блок с заменой позиции если это неоригинальная карточка товара, а подмена
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НоменклатураДополнительныеРеквизиты.Свойство.Имя КАК Свойство,
		|	НоменклатураДополнительныеРеквизиты.Значение КАК Значение,
		|	НоменклатураДополнительныеРеквизиты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Номенклатура.ДополнительныеРеквизиты КАК НоменклатураДополнительныеРеквизиты
		|ГДЕ
		|	НоменклатураДополнительныеРеквизиты.Свойство.Имя = &Наименование
		|	И НоменклатураДополнительныеРеквизиты.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Наименование", "ОригинальныйАртикул");
	Запрос.УстановитьПараметр("Ссылка", Параметры.Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать(); 
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		 				
				Запрос1 = Новый Запрос;
				Запрос1.Текст = 
					"ВЫБРАТЬ
					|	Номенклатура.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.Номенклатура КАК Номенклатура
					|ГДЕ
					|	Номенклатура.Артикул = &Артикул";
				
				Запрос1.УстановитьПараметр("Артикул", ВыборкаДетальныеЗаписи.Значение);
				
				РезультатЗапроса1 = Запрос1.Выполнить();
				
				ВыборкаДетальныеЗаписи1 = РезультатЗапроса1.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи1.Следующий() Цикл
					ЗапрашиваемаяНоменклатура=Параметры.Номенклатура;
					АртикулЗапрашиваемойНоменклатуры=Параметры.Номенклатура.Артикул;
					Параметры.Номенклатура = ВыборкаДетальныеЗаписи1.Ссылка;
					Элементы.ЗапрашиваемаяНоменклатура.Видимость=Истина;
					Элементы.АртикулЗапрашиваемойНоменклатуры.Видимость=Истина;
				КонецЦикла;
			
	КонецЦикла;
	//	ПараметрыСеанса.ИспользоватьОграниченияПравДоступаНаУровнеЗаписей=Ложь;
	АрхивнаяПозиция=Параметры.Номенклатура.ASP_АрхивнаяПозиция;
	Если АрхивнаяПозиция=Истина Тогда
		Элементы.АрхивнаяПозицияКартинка.Видимость=Истина;
	КонецЕсли;
	Заголовок = Заголовок + ": "+ Параметры.Номенклатура;
	Артикул = Параметры.Номенклатура.Артикул;
	Если ЗначениеЗаполнено(Параметры.Характеристика) Тогда
		Элементы.СписокХарактеристика.Видимость = Ложь;
		Заголовок = Заголовок + " ("+ Параметры.Характеристика + ")";
	КонецЕсли;
	
	Номенклатура = Параметры.Номенклатура;
	Характеристика = Параметры.Характеристика;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Список.Отбор,
		"Номенклатура",
		Параметры.Номенклатура,
		ВидСравненияКомпоновкиДанных.Равно, , Истина
	);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Список.Отбор,
		"Характеристика",
		Параметры.Характеристика,
		ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(Параметры.Характеристика)
	);
	
	ИспользоватьХарактеристикиНоменклатуры = ПолучитьФункциональнуюОпцию("ИспользоватьХарактеристикиНоменклатуры");
	
	
	//+ ГТС 02062019 получаем комплектацию с остатками и включаем видимость если надо
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
		|	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество,
		|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика
		|ПОМЕСТИТЬ Комплект
		|ИЗ
		|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец = &Владелец
		|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Основной = &Основной
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) + ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьПоМереПоступленияОстаток, 0) КАК ВРезервеОстаток,
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.ВНаличииОстаток, 0) - (ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) + ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьПоМереПоступленияОстаток, 0)) КАК СвободныйОстаток,
		|	ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(ТоварыНаСкладахОстатки.КОтгрузкеОстаток, 0) КАК ВНаличииОстаток,
		|	ЕСТЬNULL(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток, 0) КАК КОтгрузкеОстаток,
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Склад, ТоварыНаСкладахОстатки.Склад) КАК Склад,
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Номенклатура, ТоварыНаСкладахОстатки.Номенклатура) КАК Номенклатура,
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Характеристика, ТоварыНаСкладахОстатки.Характеристика) КАК Характеристика,
		|	ТоварныеОграничения.МинимальноеКоличествоЗапаса КАК ПлановыйЗапас
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки КАК ТоварыКОтгрузкеОстатки
		|		ПО ЗапасыИПотребностиОстатки.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура
		|			И ЗапасыИПотребностиОстатки.Характеристика = ТоварыКОтгрузкеОстатки.Характеристика
		|			И ЗапасыИПотребностиОстатки.Склад = ТоварыКОтгрузкеОстатки.Склад
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
		|		ПО ЗапасыИПотребностиОстатки.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
		|			И ЗапасыИПотребностиОстатки.Характеристика = ТоварыНаСкладахОстатки.Характеристика
		|			И ЗапасыИПотребностиОстатки.Склад = ТоварыНаСкладахОстатки.Склад
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТоварныеОграничения КАК ТоварныеОграничения
		|		ПО ЗапасыИПотребностиОстатки.Номенклатура = ТоварныеОграничения.Номенклатура
		|			И ЗапасыИПотребностиОстатки.Характеристика = ТоварныеОграничения.Характеристика
		|			И ЗапасыИПотребностиОстатки.Склад = ТоварныеОграничения.Склад
		|ГДЕ
		|	(ЗапасыИПотребностиОстатки.Номенклатура В
		|				(ВЫБРАТЬ
		|					ТЗ.Номенклатура
		|				ИЗ
		|					Комплект КАК ТЗ)
		|			ИЛИ ТоварыНаСкладахОстатки.Номенклатура В
		|				(ВЫБРАТЬ
		|					ТЗ.Номенклатура
		|				ИЗ
		|					Комплект КАК ТЗ))
		|	И ТоварыНаСкладахОстатки.Склад.ИспользоватьДляСайта = &ИспользоватьДляСайта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Остатки.ВРезервеОстаток + Остатки.КОтгрузкеОстаток КАК ВРезервеОстаток,
		|	Остатки.СвободныйОстаток КАК СвободныйОстаток,
		|	Остатки.ВНаличииОстаток КАК ВНаличииОстаток,
		|	Остатки.Склад КАК Склад,
		|	Остатки.Характеристика КАК Характеристика,
		|	Комплект.Количество КАК Количество,
		|	Комплект.Номенклатура КАК Номенклатура,
		|	Остатки.ПлановыйЗапас КАК ПлановыйЗапас
		|ИЗ
		|	Комплект КАК Комплект
		|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
		|		ПО (Остатки.Номенклатура = Комплект.Номенклатура)
		|			И (Остатки.Характеристика = Комплект.Характеристика)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	Номенклатура
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Запрос.УстановитьПараметр("Основной", Истина);
	Запрос.УстановитьПараметр("ИспользоватьДляСайта", Истина);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Количество()>0 Тогда
		ЭтаФорма.Элементы.ГруппаСоставКомплекта.Видимость = ИСТИНА;
	КонецЕсли;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		новаяСтрока = СоставКомплекта.Добавить();
		ЗаполнитьЗначенияСвойств(новаяСтрока , ВыборкаДетальныеЗаписи);
	КонецЦикла;
	//-ГТС 02062019
	
	//+ГТС 08112019 получаем наличие комплектов в сборе и включаем видимость если надо
	
	Если Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Набор Тогда
	Запрос1 = Новый Запрос;
	Запрос1.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВариантыКомплектацииНоменклатурыТовары.Номенклатура) КАК Номенклатура,
		|	СУММА(ВариантыКомплектацииНоменклатурыТовары.Количество) КАК Количество
		|ИЗ
		|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец = &Владелец
		|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Основной = &Основной
		|
		|СГРУППИРОВАТЬ ПО
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец";
	Запрос1.УстановитьПараметр("Владелец", Номенклатура);
	Запрос1.УстановитьПараметр("Основной", Истина);
	
	РезультатЗапроса1 = Запрос1.Выполнить();
	
	ВыборкаДетальныеЗаписи1 = РезультатЗапроса1.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи1.Следующий() Цикл
	КолвоНоменклатурыВКомплекте=ВыборкаДетальныеЗаписи1.Номенклатура;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
		|	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество,
		|	ВариантыКомплектацииНоменклатурыТовары.Характеристика КАК Характеристика,
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец КАК Владелец
		|ПОМЕСТИТЬ Комплект
		|ИЗ
		|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец = &Владелец
		|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Основной = &Основной
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) + ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьПоМереПоступленияОстаток, 0)) КАК ВРезервеОстаток,
		|	СУММА(ЕСТЬNULL(ЗапасыИПотребностиОстатки.ВНаличииОстаток, 0) - (ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьНаСкладеОстаток, 0) + ЕСТЬNULL(ЗапасыИПотребностиОстатки.РезервироватьПоМереПоступленияОстаток, 0))) КАК СвободныйОстаток,
		|	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0) - ЕСТЬNULL(ТоварыНаСкладахОстатки.КОтгрузкеОстаток, 0)) КАК ВНаличииОстаток,
		|	СУММА(ЕСТЬNULL(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток, 0)) КАК КОтгрузкеОстаток,
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Склад, ТоварыНаСкладахОстатки.Склад) КАК Склад,
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Номенклатура, ТоварыНаСкладахОстатки.Номенклатура) КАК Номенклатура,
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Характеристика, ТоварыНаСкладахОстатки.Характеристика) КАК Характеристика
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрНакопления.ЗапасыИПотребности.Остатки КАК ЗапасыИПотребностиОстатки
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКОтгрузке.Остатки КАК ТоварыКОтгрузкеОстатки
		|		ПО ЗапасыИПотребностиОстатки.Номенклатура = ТоварыКОтгрузкеОстатки.Номенклатура
		|			И ЗапасыИПотребностиОстатки.Характеристика = ТоварыКОтгрузкеОстатки.Характеристика
		|			И ЗапасыИПотребностиОстатки.Склад = ТоварыКОтгрузкеОстатки.Склад
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки КАК ТоварыНаСкладахОстатки
		|		ПО ЗапасыИПотребностиОстатки.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
		|			И ЗапасыИПотребностиОстатки.Характеристика = ТоварыНаСкладахОстатки.Характеристика
		|			И ЗапасыИПотребностиОстатки.Склад = ТоварыНаСкладахОстатки.Склад
		|ГДЕ
		|	(ЗапасыИПотребностиОстатки.Номенклатура В
		|				(ВЫБРАТЬ
		|					ТЗ.Номенклатура
		|				ИЗ
		|					Комплект КАК ТЗ)
		|			ИЛИ ТоварыНаСкладахОстатки.Номенклатура В
		|				(ВЫБРАТЬ
		|					ТЗ.Номенклатура
		|				ИЗ
		|					Комплект КАК ТЗ))
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Склад, ТоварыНаСкладахОстатки.Склад),
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Номенклатура, ТоварыНаСкладахОстатки.Номенклатура),
		|	ЕСТЬNULL(ЗапасыИПотребностиОстатки.Характеристика, ТоварыНаСкладахОстатки.Характеристика)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СУММА(Остатки.ВРезервеОстаток + Остатки.КОтгрузкеОстаток) КАК ВРезервеОстаток,
		|	СУММА(Остатки.СвободныйОстаток) КАК СвободныйОстаток,
		|	СУММА(Остатки.ВНаличииОстаток) КАК ВНаличииОстаток,
		|	Остатки.Склад КАК Склад,
		|	Остатки.Характеристика КАК Характеристика,
		|	СУММА(Комплект.Количество) КАК Количество,
		|	Комплект.Номенклатура КАК Номенклатура,
		|	СУММА(Остатки.СвободныйОстаток) / СУММА(Комплект.Количество) КАК Свободно,
		|	Комплект.Владелец КАК Владелец,
		|	СУММА(Остатки.ВНаличииОстаток) / СУММА(Комплект.Количество) КАК ВНаличии
