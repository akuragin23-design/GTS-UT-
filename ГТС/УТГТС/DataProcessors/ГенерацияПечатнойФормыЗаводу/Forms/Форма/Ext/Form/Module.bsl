&НаСервере
Функция СформироватьНаСервере()
	Обработка =  РеквизитФормыВЗначение("Объект");
	Если ФормироватьПоФормеЗавода=Истина Тогда
	Макет = Обработка.ПолучитьМакет("МакетЗавод");
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы=ОриентацияСтраницы.Ландшафт;
	ТабДок.ПолеСверху=20;
	ТабДок.ПолеСлева=20;
	ТабДок.ПолеСнизу=10;
	ТабДок.ПолеСправа=10;
	Область = Макет.ПолучитьОбласть("Шапка");
	Область.Параметры.НомерЦикла=Объект.НомерЦикла;
	Область.Параметры.Стойки_70=ТЗ[0].Приоритет;
	Область.Параметры.Стойки_85=ТЗ[1].Приоритет;
	Область.Параметры.Стойки_100=ТЗ[2].Приоритет;
	Область.Параметры.Стойки_130=ТЗ[3].Приоритет;
	Область.Параметры.Раскосы_20=ТЗ[4].Приоритет;
	Область.Параметры.Балки_90=ТЗ[5].Приоритет;
	Область.Параметры.Балки_120=ТЗ[6].Приоритет;
	Область.Параметры.Балки_150=ТЗ[7].Приоритет;
	Область.Параметры.Балки_180=ТЗ[8].Приоритет;
	Область.Параметры.ЛОЖЕМЕНТ_=ТЗ[9].Приоритет;
	
	ЗаполнитьТЗРасчет();
	//КАЛЕНДАРЬ
	Если НЕ ЗначениеЗаполнено(ДатаНачалаЦикла) Тогда
		ДатаНачалаЦикла=ТекущаяДата();
	КонецЕсли;
	Запрос = Новый Запрос;
	Если БезВыходных=ИСТИНА Тогда
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 90
	               |	КалендарныеГрафики.Календарь КАК Календарь,
	               |	КалендарныеГрафики.Год КАК Год,
	               |	КалендарныеГрафики.ДатаГрафика КАК ДатаГрафика,
	               |	КалендарныеГрафики.ДеньВключенВГрафик КАК ДеньВключенВГрафик,
	               |	КалендарныеГрафики.КоличествоДнейВГрафикеСНачалаГода КАК КоличествоДнейВГрафикеСНачалаГода
	               |ИЗ
	               |	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	               |ГДЕ
	               |	КалендарныеГрафики.ДатаГрафика >= &ДатаГрафика";
	Иначе	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 90
	               |	КалендарныеГрафики.Календарь КАК Календарь,
	               |	КалендарныеГрафики.Год КАК Год,
	               |	КалендарныеГрафики.ДатаГрафика КАК ДатаГрафика,
	               |	КалендарныеГрафики.ДеньВключенВГрафик КАК ДеньВключенВГрафик,
	               |	КалендарныеГрафики.КоличествоДнейВГрафикеСНачалаГода КАК КоличествоДнейВГрафикеСНачалаГода
	               |ИЗ
	               |	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	               |ГДЕ
	               |	КалендарныеГрафики.ДеньВключенВГрафик
	               |	И КалендарныеГрафики.ДатаГрафика >= &ДатаГрафика";
	КонецЕсли;
	Запрос.УстановитьПараметр("ДатаГрафика",ДатаНачалаЦикла);
	РабочиеДни = Запрос.Выполнить().Выгрузить();
	
	ТЗРасчет.Сортировать("Приоритет Возр");
	//СЧИТАЕМ ТАБЛИЦУ РАСЧЕТА
	РасчетДаты=ДатаНачалаЦикла;
	ВремяНакоплено=0;
	ТекущийВид="";
	ТекущаяТолщина=0;
	Для каждого Стр1 из ТЗРасчет Цикл
	МассивЗаказов=ПолучитьНоменклатуруПоЗаказу(Стр1.ВидыНоменклатуры);
	//Стр.Длина=ПолучитьДлину(Стр.ВидыНоменклатуры);
	Длина=0;
	пп=0;
	Количество=0;
	//Стр.ДатаВремяНачала=ДатаНачалаЦикла;
	Для каждого Стр2 из МассивЗаказов Цикл
			//Область = Макет.ПолучитьОбласть("строкатовара");
			//Область.Параметры.Длина=Стр2.Длина;
			//Область.Параметры.количество=Стр2.Количество;
			//Область.Параметры.Описание=Стр2.Описание;
			пп=пп+1;
			//Область.Параметры.пп=пп;
			Длина = Длина + Стр2.Длина*Стр2.Количество;
			Количество=Количество+Стр2.Количество;
		//	ТабДок.Вывести(Область);
	КонецЦикла;
	Стр1.Длина=Длина/1000;
	Стр1.Тонн=(Длина/1000)*7.85*Стр1.Толщина*Стр1.Развертка*0.000001;
	Стр1.Штрипсы=(Длина/1000)/(7/(1250*Стр1.Толщина*7.85)*1000000);
	Стр1.Количество=Количество;
	Стр1.Размеров=пп;
	Если Стр1.ВидНоменклатуры="Раскос 20" Тогда
	Стр1.Время=(Длина/1000)/(1500/8)*60*60;	
	Стр1.Смен=(Длина/1000)/1500;
	Стр1.ДатаВремяНачала=РасчетДаты;
	Стр1.ДатаВремяКонца=РабочиеДни[((ВремяНакоплено)/(60*60*24))].ДатаГрафика;
	Иначе
	Если ВремяНакоплено>0 И МассивЗаказов.Количество()>0 Тогда
		Если ТекущийВид<>Стр1.ВидНоменклатуры Тогда
			ВремяНакоплено=ВремяНакоплено+8*60*60;
			ТекущийВид=Стр1.ВидНоменклатуры;
			ТекущаяТолщина=Стр1.Толщина;
		ИначеЕсли ТекущаяТолщина<>Стр1.Толщина Тогда
			ВремяНакоплено=ВремяНакоплено+4*60*60;
			ТекущийВид=Стр1.ВидНоменклатуры;
			ТекущаяТолщина=Стр1.Толщина;
		КонецЕсли;
	КонецЕсли;		
	Стр1.Время=(Длина/1000)/(1500/8)*60*60;
	ВремяНакоплено=ВремяНакоплено+Стр1.Время;
	Стр1.Смен=(Длина/1000)/1500;
	Стр1.ДатаВремяНачала=РасчетДаты;
	Стр1.ДатаВремяКонца=РабочиеДни[((ВремяНакоплено)/(60*60*24))].ДатаГрафика;
	РасчетДаты=Стр1.ДатаВремяКонца;
	КонецЕсли;
	КонецЦикла;	
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = 
	//	"ВЫБРАТЬ
	//	|	ТЗ.ВидНоменклатуры КАК ВидНоменклатуры,
	//	|	ТЗ.Штрипсы КАК Штрипсы,
	//	|	ТЗ.Тонн как Тонн
	//	|	ТЗ.Время как Время
	//	|	ТЗ.ДатаВремяНачала как ДатаВремяНачала
	//	|	ТЗ.ДатаВремяКонца как ДатаВремяКонца
	//	|	ТЗ.
	//	|ПОМЕСТИТЬ ВнутренняяТаблица
	//	|ИЗ
	//	|	&ТЗ КАК ТЗ
	//	|;
	//	|
	//	|////////////////////////////////////////////////////////////////////////////////
	//	|ВЫБРАТЬ
	//	|	ВнутренняяТаблица.ВидНоменклатуры КАК ВидНоменклатуры,
	//	|	ВнутренняяТаблица.Штрипсы КАК Штрипсы
	//	|ИЗ
	//	|	ВнутренняяТаблица КАК ВнутренняяТаблица";
	////Передаем таблицу	
	//Запрос.УстановитьПараметр("ТЗ",ТЗРасчет);	
	//РезультатЗапроса = Запрос.Выполнить();
	//ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	//Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	//	// Обработка данных
	//КонецЦикла; 

	
	
	//ЗАПОЛНЯЕМ ЛИЦЕВЫЕ ЛИСТЫ
	//ТОННАЖ
	ТЗРасчет.Сортировать("Код Возр");            
	//Стойки 70
