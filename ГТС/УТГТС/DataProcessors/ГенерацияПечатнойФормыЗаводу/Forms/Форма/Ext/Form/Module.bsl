	Область.Параметры.К20=ТЗРасчет[31].Тонн+ТЗРасчет[32].Тонн;
	Область.Параметры.К21=ТЗРасчет[33].Тонн+ТЗРасчет[34].Тонн;
	Область.Параметры.К22=ТЗРасчет[35].Тонн+ТЗРасчет[36].Тонн;
	//Балка 150
	Область.Параметры.К23=ТЗРасчет[37].Тонн+ТЗРасчет[38].Тонн;
	Область.Параметры.К24=ТЗРасчет[39].Тонн+ТЗРасчет[40].Тонн; 
	Область.Параметры.К25=ТЗРасчет[41].Тонн+ТЗРасчет[42].Тонн; 
	//Балка 180
	Область.Параметры.К26=ТЗРасчет[43].Тонн+ТЗРасчет[44].Тонн;
	Область.Параметры.К27=ТЗРасчет[45].Тонн+ТЗРасчет[46].Тонн;
	Область.Параметры.К28=ТЗРасчет[47].Тонн;
	Область.Параметры.К29=ТЗРасчет[48].Тонн;
	
	Область.Параметры.Стойки70=ТЗРасчет[0].Тонн+ТЗРасчет[1].Тонн+ТЗРасчет[2].Тонн+ТЗРасчет[3].Тонн+ТЗРасчет[4].Тонн+ТЗРасчет[5].Тонн;
	Область.Параметры.Стойки85=ТЗРасчет[6].Тонн+ТЗРасчет[7].Тонн+ТЗРасчет[8].Тонн+ТЗРасчет[9].Тонн+ТЗРасчет[10].Тонн+ТЗРасчет[11].Тонн;
	Область.Параметры.Стойки100=ТЗРасчет[12].Тонн+ТЗРасчет[13].Тонн+ТЗРасчет[14].Тонн+ТЗРасчет[15].Тонн+ТЗРасчет[16].Тонн+ТЗРасчет[17].Тонн;
	Область.Параметры.Стойки130=ТЗРасчет[18].Тонн+ТЗРасчет[19].Тонн+ТЗРасчет[20].Тонн+ТЗРасчет[21].Тонн+ТЗРасчет[22].Тонн+ТЗРасчет[23].Тонн;
	Область.Параметры.Раскосы20=ТЗРасчет[24].Тонн+ТЗРасчет[25].Тонн+ТЗРасчет[26].Тонн;
	Область.Параметры.Балки90=ТЗРасчет[27].Тонн+ТЗРасчет[28].Тонн+ТЗРасчет[29].Тонн+ТЗРасчет[30].Тонн;
	Область.Параметры.Балки120=ТЗРасчет[31].Тонн+ТЗРасчет[32].Тонн+ТЗРасчет[33].Тонн+ТЗРасчет[34].Тонн+ТЗРасчет[35].Тонн+ТЗРасчет[36].Тонн;
	Область.Параметры.Балки150=ТЗРасчет[37].Тонн+ТЗРасчет[38].Тонн+ТЗРасчет[39].Тонн+ТЗРасчет[40].Тонн+ТЗРасчет[41].Тонн+ТЗРасчет[42].Тонн;
	Область.Параметры.Балки180=ТЗРасчет[43].Тонн+ТЗРасчет[44].Тонн+ТЗРасчет[45].Тонн+ТЗРасчет[46].Тонн;
	Область.Параметры.ЛОЖЕМЕНТ=ТЗРасчет[47].Тонн+ТЗРасчет[48].Тонн;
	
	//ШТРИПСЫ
