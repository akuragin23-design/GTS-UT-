		//Стр.Описание=Сред(Наименование,Найти(Наименование, ")")+1);
		
		Иначе

		
		КонецЕсли;
	КонецЦикла;
	КонецЕсли;
	Выборка.Сортировать("Длина Возр");
	Массив = ТаблицаЗначенийВМассив(Выборка);
	Возврат Массив;
