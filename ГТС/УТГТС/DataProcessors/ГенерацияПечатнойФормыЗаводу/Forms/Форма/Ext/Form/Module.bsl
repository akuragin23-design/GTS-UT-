		Если Лев(стр.Номенклатура,11) = "Стойка СЕТО" или Лев(стр.Номенклатура,11) = "Стойка СЕТП" или Лев(стр.Номенклатура,11) = "Стойка СЕТБ" тогда
		КонецДлины=Найти(Наименование, "(");
		Строка1=Сред(Наименование,13,КонецДлины-14);	
		стр.Номенклатура = ПривестиСтрокуКЧислу(Строка1,);
		Стр.Длина = число(ПривестиСтрокуКЧислу(Строка1,)); 
		Стр.ДлинаОб = Длина+стр.Номенклатура*стр.Количество;
		Стр.Описание=?(Стр.Комментарий<>"",Стр.Комментарий,Сред(Наименование,Найти(Наименование, ")")+1));
		//Балки
		ИначеЕсли Лев(стр.Номенклатура,10) = "Балка СЕТО" или Лев(стр.Номенклатура,10) = "Балка СЕТП" или Лев(стр.Номенклатура,10) = "Балка СЕТБ" Тогда
		КонецДлины1=Найти(Наименование, "(");
		КонецДлины2=Найти(Наименование, "/");
		Если КонецДлины2<КонецДлины1 И КонецДлины2>0 Тогда
		КонецДлины=КонецДлины2+1;
		Иначе 
		КонецДлины=КонецДлины1;
		КонецЕсли;
		Строка1=Сред(Наименование,12,КонецДлины-13);
		Стр.Номенклатура = ПривестиСтрокуКЧислу(Строка1,);
		Стр.Длина = число(ПривестиСтрокуКЧислу(Строка1,));
		Стр.ДлинаОб = Длина+стр.Номенклатура*стр.Количество;
		ДлинаПоиска=СтрДлина(Наименование)-(Найти(Наименование, ")")+1);
		ДлинаСтроки=СтрДлина(Наименование);
		Стр.Описание=?(Стр.Комментарий<>"",Стр.Комментарий,Сред(Наименование,Найти(Наименование, ")")+1));
		//Раскосы
		ИначеЕсли  Лев(стр.Номенклатура,11) = "Раскос СЕТО" или Лев(стр.Номенклатура,11) = "Раскос СЕТП" или Лев(стр.Номенклатура,11) = "Раскос СЕТБ" тогда
		КонецДлины=Найти(Наименование, "(");
		Строка1=Сред(Наименование,13,КонецДлины-14);
		стр.Номенклатура = ПривестиСтрокуКЧислу(Строка1,);
		Стр.Длина = число(ПривестиСтрокуКЧислу(Строка1,));
		Стр.ДлинаОб = Длина+стр.Номенклатура*стр.Количество;
		Стр.Описание=?(Стр.Комментарий<>"",Стр.Комментарий,Сред(Наименование,Найти(Наименование, ")")+1));
		//Связи
		//ИначеЕсли  Лев(стр.Номенклатура,10) = "Связь СЕТП" тогда
		//КонецДлины=Найти(Наименование, "(");
