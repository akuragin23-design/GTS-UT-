		ЗапросТоваров.Текст=СтрЗаменить(ЗапросТоваров.Текст,"&Атрибут6","""""");
	КонецЕсли;	
	
	Если (Атрибут7<>"")И(Атрибут7<>"!!! Ячейки !!!")И(Атрибут7<>"!!! Остатки !!!")  тогда
