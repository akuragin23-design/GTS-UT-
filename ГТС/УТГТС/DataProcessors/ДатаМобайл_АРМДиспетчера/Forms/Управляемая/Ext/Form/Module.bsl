		КаталогХраненияЛогов = "" + КаталогХраненияЛогов + РП;
	КонецЕсли;
		
	ДатаМобайл_ОбщийМодуль.НастройкиЗаписать(Новый Структура("КаталогХраненияЛогов", СокрЛП(КаталогХраненияЛогов)));
