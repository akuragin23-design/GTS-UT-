		Для Н = 0 По СтруктураОшибок.СодержанияОшибок.Количество() - 1 Цикл
			Сообщить(СтруктураОшибок.СодержанияОшибок[Н]);
			ПоказатьПредупреждение(,"Подключение не выполнено", 10, "Подключение не выполнено");
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

