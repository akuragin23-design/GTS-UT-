	Если ДанныеВыбора.Количество() > 0 Тогда		
		КаталогХраненияЛогов = СокрЛП(ДанныеВыбора[0]);		
		КаталогХраненияЛоговПриИзменении(Элементы.КаталогХраненияЛогов);
