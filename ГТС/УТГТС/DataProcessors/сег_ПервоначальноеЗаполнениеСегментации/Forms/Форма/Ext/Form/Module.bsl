
&НаСервере
Функция РаспределитьПоСегментам()
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = '20110101';
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаКонца) Тогда
		ДатаКонца = ТекущаяДата();
	КонецЕсли;
	
	// Один расчёт на конец периода. Если нужны исторические срезы на каждый день,
	// верните старый цикл, но он работает гораздо медленнее.
	сег_Сегментация.РаспределитьПоСегментам(КонецДня(ДатаКонца));
	
КонецФункции

&НаСервере
Функция ЗаполнитьПервоначальныеДанные()
	
	
	нз = РегистрыСведений.сег_ПоказателиСегментов.СоздатьНаборЗаписей();
	нз.Отбор.Подразделение.Установить(Справочники.СтруктураПредприятия.ПустаяСсылка());
	
	//Маркетинговый сегмент
	
	//лКритерий.Описание = "1 (A) оплаченный заказ или менее (возможно клиент обратился и его занесли в базу, но оплаты по тем или иным причинам не было)";
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.ПервичныйКлиент);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 0;
	зап.Показатель2 = 1;
	нз.Записать();
	
	//лКритерий.Описание = "более 1 (A), но менее 4 (B) оплаченных заказов";
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.НовыйКлиент);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 1;
	зап.Показатель2 = 3;
	нз.Записать();
	
	//лКритерий.Описание = "4 (B) и более оплаченных заказов, частота заказов менее 3 (С) в год";
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.СтарыйКлиент);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 3;
	зап.Показатель2 = 0;
	зап.Показатель3 = 3;
	нз.Записать();
	
	//лКритерий.Описание = "4 (B) и более оплаченных заказов, частота заказов 3 (С) и более в год";
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.ПостоянныйКлиент);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 3;
	зап.Показатель2 = 0;
	зап.Показатель3 = 3;
	зап.Показатель4 = 100;
	нз.Записать();
	
	//лКритерий.Описание = "4 (B) и более оплаченных заказов, частота заказов 3 (С) и более в год, время прошедшее с последнего заказа в 2 (D) раза больше чем средний интервал между заказами";
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.УснувшийКлиент);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 3;
	зап.Показатель2 = 0;
	зап.Показатель3 = 3;
	зап.Показатель4 = 100;
	нз.Записать();
	
	//----------------------------	
	
	//Сегмент по оборотам
	
	//лКритерий.Описание = "Оборот (рассчитывается как средний оборот в месяц за последние 12 месяцев от текущего момента, если клиент сотрудничает с нами меньше 12 месяцев, то средний оборот в месяц за период сотрудничества)";
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.Маленький);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 0;
	зап.Показатель2 = 100000;
	нз.Записать();
	
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.Средний);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 100000;
	зап.Показатель2 = 200000;
	нз.Записать();
	
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.Большой);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 200000;
	зап.Показатель2 = 300000;
	нз.Записать();
	
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.ОченьБольшой);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 300000;
	зап.Показатель2 = 0;
	нз.Записать();
	
	//----------------------------	
	
	// Сегмент по частоте заказов
	
	//лКритерий.Описание = "Частота заказов (количество заказов за последние 12 месяцев от текущего момента, если клиент сотрудничает с нами меньше 12 месяцев, то количество заказов за период сотрудничества)";
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.Редко);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 0;
	зап.Показатель2 = 4;
	нз.Записать();
	
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.Средне);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 4;
	зап.Показатель2 = 8;
	нз.Записать();
	
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.Часто);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 8;
	зап.Показатель2 = 12;
	нз.Записать();
	
	нз.Отбор.Сегмент.Установить(Справочники.сег_Сегменты.ОченьЧасто);
	нз.Очистить();
	зап = нз.Добавить();
	зап.Сегмент = нз.Отбор.Сегмент.Значение;
	зап.ВидСегмента = зап.Сегмент.Родитель;
	зап.Показатель1 = 12;
	зап.Показатель2 = 0;
	нз.Записать();
	
	сег_Сегментация.ЗапуститьОбработкуДилеров();
	
КонецФункции
	
&НаКлиенте
Процедура ПервоначальноеЗаполнение(Команда)
	
	ЗаполнитьПервоначальныеДанные();
	Сообщить("Выполнено первоначальное заполнение справочников", СтатусСообщения.Информация);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапуститьРаспределениеПоСегментам(Команда)
	
	РаспределитьПоСегментам();
	Сообщить("Выполнено распределение по сегментам", СтатусСообщения.Информация);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДвиженияПоСегментам(Команда)
	
	ЗаполнитьДвиженияНаСервере();
	Сообщить("Движения по сегментам заполнены", СтатусСообщения.Информация);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПоСегментамИЗаполнитьДвижения(Команда)
	
	РаспределитьПоСегментам();
	Сообщить("Выполнено распределение по сегментам", СтатусСообщения.Информация);
	
	ЗаполнитьДвиженияНаСервере();
	Сообщить("Движения по сегментам заполнены", СтатусСообщения.Информация);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДвиженияНаСервере()
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = '20110101';
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаКонца) Тогда
		ДатаКонца = ТекущаяДата();
	КонецЕсли;
	
	ПериодНач = НачалоДня(ДатаНачала);
	ПериодКон = КонецДня(ДатаКонца);
	ПустоеПодразделение = Справочники.СтруктураПредприятия.ПустаяСсылка();
	
	// Отбор контрагентов/партнёров
	Зап = Новый Запрос;
	Зап.Текст = "ВЫБРАТЬ
	            |   Партнеры.Ссылка КАК Партнер
	            |ИЗ
	            |   Справочник.Контрагенты КАК Контрагенты
	            |       ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Партнеры КАК Партнеры
	            |       ПО Контрагенты.Партнер = Партнеры.Ссылка
	            |ГДЕ
	            |   НЕ Партнеры.ПометкаУдаления
	            |   И НЕ Контрагенты.ПометкаУдаления";
	тзКонтры = Зап.Выполнить().Выгрузить();
	МассивПартнеров = тзКонтры.ВыгрузитьКолонку("Партнер");
	
	// Кэш дилерского сегмента по партнёру, чтобы не лезть к партнёру внутри цикла
	СоотвДилер = Новый Соответствие;
	Для Каждого стрК Из тзКонтры Цикл
		Если ЗначениеЗаполнено(стрК.Партнер.сег_Дилер) Тогда
			СоотвДилер.Вставить(стрК.Партнер, стрК.Партнер.сег_Дилер);
		Иначе
			СоотвДилер.Вставить(стрК.Партнер, Справочники.сег_Сегменты.НеДилер);
		КонецЕсли;
	КонецЦикла;
	
	// Один срез сегментации на конец периода для всех партнёров
	ЗапросСрез = Новый Запрос;
	ЗапросСрез.Текст = "ВЫБРАТЬ
	                   |   сег_СегментацияКонтрагентовСрезПоследних.Подразделение КАК Подразделение,
	                   |   сег_СегментацияКонтрагентовСрезПоследних.Партнер КАК Партнер,
	                   |   сег_СегментацияКонтрагентовСрезПоследних.ВидСегмента КАК ВидСегмента,
	                   |   сег_СегментацияКонтрагентовСрезПоследних.Сегмент КАК Сегмент
	                   |ИЗ
	                   |   РегистрСведений.сег_СегментацияКонтрагентов.СрезПоследних(&ПериодКон, Партнер В (&МассивПартнеров)) КАК сег_СегментацияКонтрагентовСрезПоследних";
	ЗапросСрез.УстановитьПараметр("ПериодКон", Новый Граница(ПериодКон, ВидГраницы.Включая));
	ЗапросСрез.УстановитьПараметр("МассивПартнеров", МассивПартнеров);
	тзСрез = ЗапросСрез.Выполнить().Выгрузить();
	тзСрез.Индексы.Добавить("Партнер, Подразделение");
	
	// Один запрос на всю выручку и все оплаты за период.
	// Менеджер/подразделение для оплат берутся из ОбъектовРасчетов.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |   Таб.Регистратор КАК Регистратор,
	               |   Таб.Период КАК Период,
	               |   Таб.Партнер КАК Партнер,
	               |   Таб.ПодразделениеФирмы КАК ПодразделениеФирмы,
	               |   Таб.Подразделение КАК Подразделение,
	               |   Таб.Менеджер КАК Менеджер,
	               |   Таб.Номенклатура КАК Номенклатура,
	               |   Таб.БизнесРегион КАК БизнесРегион,
	               |   Таб.СуммаВыручки КАК СуммаВыручки,
	               |   Таб.СуммаОплаты КАК СуммаОплаты,
	               |   Таб.ЭтоВыручка КАК ЭтоВыручка
	               |ИЗ
	               |   (ВЫБРАТЬ
	               |       Выручка.Регистратор КАК Регистратор,
	               |       Выручка.Период КАК Период,
	               |       АналитикаПартнеры.Партнер КАК Партнер,
	               |       Выручка.Подразделение КАК ПодразделениеФирмы,
	               |       Выручка.Подразделение КАК Подразделение,
	               |       ВЫБОР
	               |           КОГДА Выручка.ЗаказКлиента = ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
	               |               ТОГДА Выручка.Менеджер
	               |           ИНАЧЕ ЗаказКлиентаДок.Менеджер
	               |       КОНЕЦ КАК Менеджер,
	               |       Выручка.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	               |       АналитикаПартнеры.Партнер.БизнесРегион КАК БизнесРегион,
	               |       Выручка.СуммаВыручки КАК СуммаВыручки,
	               |       0 КАК СуммаОплаты,
	               |       ИСТИНА КАК ЭтоВыручка
	               |   ИЗ
	               |       РегистрНакопления.ВыручкаИСебестоимостьПродаж КАК Выручка
	               |           ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаПартнеры
	               |           ПО Выручка.АналитикаУчетаПоПартнерам = АналитикаПартнеры.КлючАналитики
	               |           ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиентаДок
	               |           ПО Выручка.ЗаказКлиента = ЗаказКлиентаДок.Ссылка
	               |   ГДЕ
	               |       Выручка.Период МЕЖДУ &ПериодНач И &ПериодКон
	               |       И Выручка.СуммаВыручки <> 0
	               |       И АналитикаПартнеры.Партнер В (&МассивПартнеров)
	               |   
	               |   ОБЪЕДИНИТЬ ВСЕ
	               |   
	               |   ВЫБРАТЬ
	               |       Расчеты.Регистратор,
	               |       Расчеты.Период,
	               |       АналитикаПартнеры.Партнер,
	               |       ОбъектыРасчетов.Подразделение,
	               |       ОбъектыРасчетов.Подразделение,
	               |       ОбъектыРасчетов.Менеджер,
	               |       ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	               |       АналитикаПартнеры.Партнер.БизнесРегион,
	               |       0,
	               |       Расчеты.Сумма,
	               |       ЛОЖЬ
	               |   ИЗ
	               |       РегистрНакопления.РасчетыСКлиентами КАК Расчеты
	               |           ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаУчетаПоПартнерам КАК АналитикаПартнеры
	               |           ПО Расчеты.АналитикаУчетаПоПартнерам = АналитикаПартнеры.КлючАналитики
	               |           ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыРасчетов КАК ОбъектыРасчетов
	               |           ПО Расчеты.ОбъектРасчетов = ОбъектыРасчетов.Ссылка
	               |   ГДЕ
	               |       Расчеты.Период МЕЖДУ &ПериодНач И &ПериодКон
	               |       И Расчеты.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	               |       И Расчеты.Сумма <> 0
	               |       И АналитикаПартнеры.Партнер В (&МассивПартнеров)) КАК Таб
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |   Таб.Регистратор,
	               |   Таб.Период";
	Запрос.УстановитьПараметр("ПериодНач", ПериодНач);
	Запрос.УстановитьПараметр("ПериодКон", ПериодКон);
	Запрос.УстановитьПараметр("МассивПартнеров", МассивПартнеров);
	тзДанные = Запрос.Выполнить().Выгрузить();
	
	// При флаге ТолькоБезДвижений заранее находим уже заполненные регистраторы
	ЗаполненныеРегистраторы = Новый Соответствие;
	Если ТолькоБезДвижений Тогда
		ЗапросДвиж = Новый Запрос;
		ЗапросДвиж.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		                   |   сег_ДвиженияПоСегментам.Регистратор КАК Регистратор
		                   |ИЗ
		                   |   РегистрНакопления.сег_ДвиженияПоСегментам КАК сег_ДвиженияПоСегментам
		                   |ГДЕ
		                   |   сег_ДвиженияПоСегментам.Регистратор В (&Регистраторы)";
		ЗапросДвиж.УстановитьПараметр("Регистраторы", тзДанные.ВыгрузитьКолонку("Регистратор"));
		Выборка = ЗапросДвиж.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ЗаполненныеРегистраторы.Вставить(Выборка.Регистратор, Истина);
		КонецЦикла;
	КонецЕсли;
	
	нз = РегистрыНакопления.сег_ДвиженияПоСегментам.СоздатьНаборЗаписей();
	тз = нз.ВыгрузитьКолонки();
	
	ТекРегистратор = Неопределено;
	Пропуск = Ложь;
	Для Каждого стр Из тзДанные Цикл
		Если ТекРегистратор <> стр.Регистратор Тогда
			Если ТекРегистратор <> Неопределено И НЕ Пропуск Тогда
				ЗаписатьДвиженияСегментации(нз, тз, ТекРегистратор);
			КонецЕсли;
			ТекРегистратор = стр.Регистратор;
			тз.Очистить();
			Пропуск = ТолькоБезДвижений И ЗаполненныеРегистраторы.Получить(ТекРегистратор) <> Неопределено;
		КонецЕсли;
		Если Пропуск Тогда
			Продолжить;
		КонецЕсли;
		
		Если стр.ЭтоВыручка Тогда
			// Срез по пустому подразделению, но ПодразделениеФирмы = фактическое
			ДобавитьСтрокиСегментации(тз, стр, тзСрез, ПустоеПодразделение, стр.Подразделение, Ложь, Истина, СоотвДилер);
			Если ЗначениеЗаполнено(стр.Подразделение) Тогда
				ДобавитьСтрокиСегментации(тз, стр, тзСрез, стр.Подразделение, стр.Подразделение, Истина, Истина, СоотвДилер);
			КонецЕсли;
		Иначе
			// Оплата: срез по пустому подразделению, ПодразделениеФирмы = подразделение объекта расчётов
			ДобавитьСтрокиСегментации(тз, стр, тзСрез, ПустоеПодразделение, стр.Подразделение, Ложь, Ложь, СоотвДилер);
			Если ЗначениеЗаполнено(стр.Подразделение) Тогда
				ДобавитьСтрокиСегментации(тз, стр, тзСрез, стр.Подразделение, стр.Подразделение, Истина, Ложь, СоотвДилер);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если ТекРегистратор <> Неопределено И НЕ Пропуск Тогда
		ЗаписатьДвиженияСегментации(нз, тз, ТекРегистратор);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВыполнитьПроверку(Команда)
	ВыполнитьПроверкуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВыполнитьПроверкуНаСервере()
	Если НЕ ЗначениеЗаполнено(ПроверкаПартнер) Тогда
		Возврат
	КонецЕсли;
	
	ПроверкаВсегоОплаченныхЗаказов = 0;
	ПроверкаОплаченныхЗаказовЗаГод = 0;
	ПроверкаДатаПервогоЗаказа = '00010101';
	ПроверкаДатаПоследнегоЗаказа = '00010101';
	ПроверкаСреднийИнтервалМеждуЗаказами = 0;
	ПроверкаВремяСПервогоЗаказа = 0;
	ПроверкаВремяСПоследнегоЗаказа = 0;
	ПроверкаОборотЗаГод = 0;
	ПроверкаОборот = 0;
	
	Если НЕ ЗначениеЗаполнено(ПроверкаДата) Тогда
		ПроверкаДата = ТекущаяДата();
	КонецЕсли;
	
	пДата = КонецДня(ПроверкаДата);
	масПодр = Новый Массив;
	масПодр.Добавить(ПроверкаПодразделение);
	
	тзПроверка = сег_Сегментация.ПолучитьОбработкуЗаказовЗапросом(пДата, -12, масПодр, ПроверкаПартнер);
	
	Если тзПроверка.Количество() > 0 Тогда
		стр = Неопределено;
		Для Каждого ТекСтр Из тзПроверка Цикл
			Если ТекСтр.Подразделение = ПроверкаПодразделение Тогда
				стр = ТекСтр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если стр = Неопределено Тогда Возврат КонецЕсли;
		
		Если ЗначениеЗаполнено(стр.ДатаПоследнегоЗаказа) Тогда
			лКоличествоДней = (НачалоДня(пДата) - НачалоДня(стр.ДатаПоследнегоЗаказа)) / 86400;
		Иначе
			лКоличествоДней = 0;
		КонецЕсли;
		Если ЗначениеЗаполнено(стр.ДатаПервогоЗаказа) Тогда
			лКоличествоДнейПервого = (НачалоДня(пДата) - НачалоДня(стр.ДатаПервогоЗаказа)) / 86400;
		Иначе
			лКоличествоДнейПервого = 0;
		КонецЕсли;
		Если стр.ЗаказовЗаГод > 1 Тогда
			лИнтервал = (лКоличествоДнейПервого - лКоличествоДней) / (стр.ЗаказовЗаГод - 1);
		Иначе
			лИнтервал = 0;
		КонецЕсли;
		
		Если стр.Заказ > стр.ЗаказовЗаГод Тогда
			лКоличествоМесяцев = 12;
		ИначеЕсли ЗначениеЗаполнено(стр.ДатаПервогоЗаказа) Тогда
			Месяц1 = Месяц(стр.ДатаПервогоЗаказа);
			Месяц2 = Месяц(пДата);
			Если Месяц1 >= Месяц2 И НачалоГода(стр.ДатаПервогоЗаказа) < НачалоГода(пДата) Тогда
				Месяц2 = Месяц2 + 12
			КонецЕсли;
			лКоличествоМесяцев = Месяц2 - Месяц1;
		Иначе
			лКоличествоМесяцев = 1;
		КонецЕсли;
		
		СредняяСумма = ?(ЗначениеЗаполнено(стр.СуммаЗаГод), стр.СуммаЗаГод, 0) / ?(лКоличествоМесяцев = 0, 1, лКоличествоМесяцев);
		
		ПроверкаВсегоОплаченныхЗаказов = стр.Заказ;
		ПроверкаОплаченныхЗаказовЗаГод = стр.ЗаказовЗаГод;
		ПроверкаДатаПервогоЗаказа = стр.ДатаПервогоЗаказа;
		ПроверкаДатаПоследнегоЗаказа = стр.ДатаПоследнегоЗаказа;
		ПроверкаСреднийИнтервалМеждуЗаказами = лИнтервал;
		ПроверкаВремяСПервогоЗаказа = лКоличествоДнейПервого;
		ПроверкаВремяСПоследнегоЗаказа = лКоличествоДней;
		ПроверкаКоличествоМесяцев = лКоличествоМесяцев;
		ПроверкаОборотЗаГод = стр.СуммаЗаГод;
		ПроверкаСредняяСумма = СредняяСумма;
		ПроверкаОборот = стр.Сумма;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДвиженияСегментации(нз, тз, Регистратор)
	
	нз.Отбор.Регистратор.Установить(Регистратор);
	нз.Очистить();
	Если тз.Количество() > 0 Тогда
		тз.Свернуть("Период, Партнер, Подразделение, ПодразделениеФирмы, Сегмент, Менеджер, БизнесРегион, Номенклатура, ВидСегмента", "СуммаВыручки, СуммаОплаты");
		Для Каждого сег Из тз Цикл
			зап = нз.Добавить();
			ЗаполнитьЗначенияСвойств(зап, сег);
			зап.Регистратор = Регистратор;
		КонецЦикла;
	КонецЕсли;
	нз.Записать();
	
КонецПроцедуры    

&НаСервере
Процедура ДобавитьСтрокиСегментации(тз, стр, тзСрез, ПодразделениеДляСреза, ПодразделениеФирмы, ЗаполнятьПодразделение, ЭтоВыручка, СоотвДилер)
	
	СегментДилера = СоотвДилер.Получить(стр.Партнер);
	Если СегментДилера = Неопределено Тогда
		СегментДилера = Справочники.сег_Сегменты.НеДилер;
	КонецЕсли;
	
	ДополнитьСрез(стр.Партнер, тзСрез, ПодразделениеДляСреза, СегментДилера);
	
	отбор = Новый Структура("Партнер, Подразделение", стр.Партнер, ПодразделениеДляСреза);
	масСег = тзСрез.НайтиСтроки(отбор);
	
	Для Каждого сег Из масСег Цикл
		зап = тз.Добавить();
		зап.Период = стр.Период;
		зап.Партнер = стр.Партнер;
		зап.ПодразделениеФирмы = ПодразделениеФирмы;
		зап.Подразделение = ?(ЗаполнятьПодразделение, ПодразделениеФирмы, Справочники.СтруктураПредприятия.ПустаяСсылка());
		зап.ВидСегмента = сег.ВидСегмента;
		зап.Сегмент = сег.Сегмент;
		зап.Менеджер = стр.Менеджер;
		зап.БизнесРегион = стр.БизнесРегион;
		Если ЭтоВыручка Тогда
			зап.СуммаВыручки = стр.СуммаВыручки;
			зап.Номенклатура = стр.Номенклатура;
		Иначе
			зап.СуммаОплаты = стр.СуммаОплаты;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ДополнитьСрез(партнер, срез, подр, СегментДилера = Неопределено)
	
	отборПодр = Новый Структура("Партнер, Подразделение", партнер, подр);
	масСег = срез.НайтиСтроки(отборПодр);
	
	естьДилер = Ложь;
	естьМаркетинг = Ложь;
	естьОборот = Ложь;
	естьПоЧастоте = Ложь;
	
	Для Каждого Тек Из масСег Цикл
		Если Тек.ВидСегмента = Справочники.сег_Сегменты.ДилерскийСегмент Тогда
			естьДилер = Истина;
		ИначеЕсли Тек.ВидСегмента = Справочники.сег_Сегменты.МаркетинговыйСегмент Тогда
			естьМаркетинг = Истина;
		ИначеЕсли Тек.ВидСегмента = Справочники.сег_Сегменты.ОборотныйСегмент Тогда
			естьОборот = Истина;
		ИначеЕсли Тек.ВидСегмента = Справочники.сег_Сегменты.СегментПоЧастотеЗаказов Тогда
			естьПоЧастоте = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если СегментДилера = Неопределено Тогда
		Если ЗначениеЗаполнено(партнер.сег_Дилер) Тогда
			СегментДилера = партнер.сег_Дилер;
		Иначе
			СегментДилера = Справочники.сег_Сегменты.НеДилер;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ естьДилер Тогда
		зап = срез.Добавить();
		зап.Подразделение = подр;
		зап.Партнер = партнер;
		зап.ВидСегмента = Справочники.сег_Сегменты.ДилерскийСегмент;
		зап.Сегмент = СегментДилера;
	КонецЕсли;
	Если НЕ естьМаркетинг Тогда
		зап = срез.Добавить();
		зап.Подразделение = подр;
		зап.Партнер = партнер;
		зап.ВидСегмента = Справочники.сег_Сегменты.МаркетинговыйСегмент;
		зап.Сегмент = Справочники.сег_Сегменты.ПервичныйКлиент;
	КонецЕсли;
	Если НЕ естьОборот Тогда
		зап = срез.Добавить();
		зап.Подразделение = подр;
		зап.Партнер = партнер;
		зап.ВидСегмента = Справочники.сег_Сегменты.ОборотныйСегмент;
		зап.Сегмент = Справочники.сег_Сегменты.Маленький;
	КонецЕсли;
	Если НЕ естьПоЧастоте Тогда
		зап = срез.Добавить();
		зап.Подразделение = подр;
		зап.Партнер = партнер;
		зап.ВидСегмента = Справочники.сег_Сегменты.СегментПоЧастотеЗаказов;
		зап.Сегмент = Справочники.сег_Сегменты.Редко;
	КонецЕсли;
	
КонецПроцедуры

