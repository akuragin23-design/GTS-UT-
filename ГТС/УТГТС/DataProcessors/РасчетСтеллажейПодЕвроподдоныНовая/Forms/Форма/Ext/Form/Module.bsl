	Если НЕ ДобавитьКомплектующую("Втулка 20", КолвоВтулок20, Ключ) Тогда
		ЕстьНеНайденныеКомплектующие = Истина;
	КонецЕсли;
	
	Если НЕ ДобавитьКомплектующую("Шайба спец.овал.6вэ.73.334.01", КолвоШайбМ8, Ключ) Тогда
		ЕстьНеНайденныеКомплектующие = Истина;
	КонецЕсли;
	
	НаименованиеПодпятника = "";
	РазмерыСтр = "";
	Если РамаПрофильСтойки = "70" Тогда
		РазмерыСтр = "80х90";
	ИначеЕсли РамаПрофильСтойки = "85" Тогда
		РазмерыСтр = "125х140";
	ИначеЕсли РамаПрофильСтойки = "100" Тогда
		РазмерыСтр = "140х150";
	Иначе
		РазмерыСтр = "155х155";
	КонецЕсли;		
		
	ОкраскаСтр = "";
	Если РамаТипОкраски = "Без покрытия" Тогда
		ОкраскаСтр = "СЕТБ";
	ИначеЕсли РамаТипОкраски = "Полимеризация" Тогда
		ОкраскаСтр = "СЕТП";
	Иначе 
		ОкраскаСтр = "СЕТО";
