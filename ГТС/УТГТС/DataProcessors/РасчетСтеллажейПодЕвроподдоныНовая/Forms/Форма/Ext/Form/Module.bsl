	ТабДок = Новый ТабличныйДокумент;
	
	ОбластьШапка.Параметры.ПредставлениеАвтора = СокрЛП(ПараметрыСеанса.ТекущийПользователь.Наименование);
	ОбластьШапка.Параметры.ТелефонАвтора = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыСеанса.ТекущийПользователь, Справочники.ВидыКонтактнойИнформации.ТелефонПользователя);
	ОбластьШапка.Параметры.ЭлПочтаАвтора = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыСеанса.ТекущийПользователь, Справочники.ВидыКонтактнойИнформации.EmailПользователя);
	ОбластьШапка.Параметры.ДатаРасчета = Формат(НаДату, "ДФ=; ДЛФ=DD");
	
	
	ОбластьШапка.Параметры.ПараметрыСтеллажа = "Высота стеллажа: " + РамаВысотаСтеллажа + " мм		Длина стеллажа: " + ДлинаСталлажа + " мм		Глубина стеллажа: " + РамаГлубинаСтеллажа + " мм";
	ОбластьШапка.Параметры.ПараметрыПролета = "Кол-во уровней в пролете: " + КолвоУровнейВПролете + " шт		Высота пролета: " + СекцииВысотаПролета + " мм		Превышение рамы: " + СекцииПревышениеРамы + " мм";
	
	ТабДок.Вывести(ОбластьШапка);
	ВесИтого = 0;
	Для каждого СтрокаТовары Из Объект.Товары Цикл
		ОбластьСтрока.Параметры.Заполнить(СтрокаТовары);
		ВесИтого = ВесИтого + (СтрокаТовары.Количество * СтрокаТовары.Вес);
		ТабДок.Вывести(ОбластьСтрока);
	КонецЦикла;
	
	ОбластьИтого.Параметры.ВесИтого = ВесИтого;
	ОбластьИтого.Параметры.СуммаИтого = Объект.Товары.Итог("Сумма");
	ТабДок.Вывести(ОбластьИтого);
	
	ТабДок.Вывести(ОбластьШапка2);
	
	Если СекцииКоличествоПролетов2 = 0 Тогда
		
		КолвоПоддоновВСекции =Цел(БалкаДлина1/900)*СекцииКоличествоПолок + ?(БудутСтавитьПоддоныНаПол,Цел(БалкаДлина1/900),0);
		ОбластьСтрока2.Параметры.ДлинаСекции = БалкаДлина1;
		ОбластьСтрока2.Параметры.КолвоСекций = СекцииКоличествоПролетов1;
		ОбластьСтрока2.Параметры.КолвоПоддоновВСекции = КолвоПоддоновВСекции;
		ОбластьСтрока2.Параметры.КолвоПоддоновВСтелаже = КолвоПоддоновВСекции * СекцииКоличествоПролетов1;
		ОбластьСтрока2.Параметры.ЦенаПоддономеста = ?(ОбластьСтрока2.Параметры.КолвоПоддоновВСтелаже = 0, 0, Объект.Товары.Итог("Сумма") / ОбластьСтрока2.Параметры.КолвоПоддоновВСтелаже);
		ТабДок.Вывести(ОбластьСтрока2); 
		
	Иначе	
		КолвоПоддоновВСекции1 = Цел(БалкаДлина1/900)*СекцииКоличествоПолок + ?(БудутСтавитьПоддоныНаПол, Цел(БалкаДлина1/900),0);
		ОбластьСтрока3.Параметры.ДлинаСекции1 = БалкаДлина1;
		ОбластьСтрока3.Параметры.КолвоСекций1 = СекцииКоличествоПролетов1;
		ОбластьСтрока3.Параметры.КолвоПоддоновВСекции1 = КолвоПоддоновВСекции1;
		
		КолвоПоддоновВСекции2 = Цел(БалкаДлина2/900)*СекцииКоличествоПолок + ?(БудутСтавитьПоддоныНаПол, Цел(БалкаДлина2/900), 0);
		ОбластьСтрока3.Параметры.ДлинаСекции2 = БалкаДлина2;
		ОбластьСтрока3.Параметры.КолвоСекций2 = СекцииКоличествоПролетов2;
		ОбластьСтрока3.Параметры.КолвоПоддоновВСекции2 = КолвоПоддоновВСекции2;
		
		ОбластьСтрока3.Параметры.КолвоПоддоновВСтелаже = (КолвоПоддоновВСекции1 * СекцииКоличествоПролетов1) + (КолвоПоддоновВСекции2 * СекцииКоличествоПролетов2);
		
		ОбластьСтрока3.Параметры.ЦенаПоддономеста = ?(ОбластьСтрока3.Параметры.КолвоПоддоновВСтелаже = 0, 0, Объект.Товары.Итог("Сумма") / ОбластьСтрока3.Параметры.КолвоПоддоновВСтелаже);
		ТабДок.Вывести(ОбластьСтрока3); 
		
	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции

