&НаСервере
Процедура ПодобратьРамыНаСервере()  
	
	// Катанные элементы рамы
	// Для стойки 70мм
	Если РамаПрофильСтойки = "70" Тогда
		k1 = 2*42;
	// Для стойки 85мм
    ИначеЕсли РамаПрофильСтойки = "85" Тогда
        k1 = 2*53.5;
	// Для стойки 100мм	
	ИначеЕсли РамаПрофильСтойки = "100" Тогда
		k1 = 2*68.5;
	// Для стойки 130мм	
	Иначе//Если РамаПрофильСтойки = "130" Тогда
		k1 = 2*86;
	КонецЕсли;
	
	МежОсРасст = РамаГлубинаСтеллажа - k1;
	ДлинаПрямогоРаскоса = МежОсРасст + 2*20;
	
	ДлинаКосогоРаскоса = Окр(Sqrt((МежОсРасст*МежОсРасст) + (600*600)) + 2*20);
	
	КолвоПрямыхРаскосов = 2;
	Если РамаВариантИсполнения = "Вариант 1" Тогда
		КолвоКосыхРаскосов = Цел((РамаВысотаСтеллажа - 200)/600);
		Если (РамаВысотаСтеллажа-200) > КолвоКосыхРаскосов*600 Тогда 
			КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов + 1;
		Иначе 
			КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов;
		КонецЕсли;
	Иначе
		КолвоКосыхРаскосов = 3 + Цел((РамаВысотаСтеллажа - 200)/600);
		Если (РамаВысотаСтеллажа >= 2000) и (РамаВысотаСтеллажа <= 2500)  Тогда
			КолвоПрямыхРаскосов = КолвоПрямыхРаскосов + 1;
		ИначеЕсли  (РамаВысотаСтеллажа > 2500) и (РамаВысотаСтеллажа <= 4300)  Тогда 
			КолвоПрямыхРаскосов = КолвоПрямыхРаскосов + 2;
		ИначеЕсли  (РамаВысотаСтеллажа > 4300) и (РамаВысотаСтеллажа <= 6100)  Тогда 
			КолвоПрямыхРаскосов = КолвоПрямыхРаскосов+3;  
		ИначеЕсли  РамаВысотаСтеллажа > 6100  Тогда 
			КолвоПрямыхРаскосов=КолвоПрямыхРаскосов + 4 + Цел((РамаВысотаСтеллажа - 6100)/1800);
		КонецЕсли;
		//------------------------------------------------------------------------------------------------------------------------------------------------------------
		Если (РамаВысотаСтеллажа - 144 - 56) > КолвоКосыхРаскосов*600 Тогда 
			КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов + 1;
		Иначе 
			КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов;
		КонецЕсли;
		
		//--------------------------------------------------------------------------------
		Если (РамаВысотаСтеллажа-144-56)-Цел((РамаВысотаСтеллажа-144-56)/600)*600=500 Тогда
			КолвоПрямыхРаскосов=КолвоПрямыхРаскосов+1;
			КолвоКрепежа = КолвоКрепежа + 1;
		КонецЕсли;
		
	КонецЕсли;
		
	СумДлинаСтоек = (РамаВысотаСтеллажа*2)/1000;
	
	СумДлинаРаскосов = (ДлинаПрямогоРаскоса*КолвоПрямыхРаскосов + ДлинаКосогоРаскоса*КолвоКосыхРаскосов)/1000;
	
	//	Некатаные элементы рам (КРЕПЕЖ)
	k2 = (РамаВысотаСтеллажа - 200)/600 = Цел((РамаВысотаСтеллажа - 200)/600);
	//  1. Определяем кол-во элементов Винт М8х55
	Если РамаВариантИсполнения = "Вариант 1" Тогда
		КолвоВинтовМ8х55 = КолвоКосыхРаскосов + 3 + ?(k2,0,1);	
	Иначе
		КолвоВинтовМ8х55 = КолвоКосыхРаскосов + 1 + ?(k2,0,1);	
	КонецЕсли;
	
	//  2. Определяем кол-во элементов Втулка 20
	КолвоВтулок20 = 2 + ?(k2,0,2);
	
	
	//  3. Определяем кол-во элементов Подпятников
	КолвоПодпятников = 2;
	
	//  4. Определяем кол-во элементов Болт М8х35
	КолвоБолтовМ8х35 = 4;
	
	//  5. Определяем кол-во элементов Втулка М8
	//Если РамаПрофильСтойки = "70" Тогда
	//	КолвоВтулокМ8 = 0;
	//Иначе
		КолвоВтулокМ8 = 4;
	//КонецЕсли;
	
	//  6. Определяем кол-во элементов Шайба М8
	КолвоШайбМ8 = КолвоВинтовМ8х55*2 + КолвоБолтовМ8х35*2;
	
	//  7. Определяем кол-во элементов Гайка М8
	КолвоГаекМ8 = КолвоВинтовМ8х55 + КолвоБолтовМ8х35;
	
	ОкраскаСтр = "";	
	Если РамаТипОкраски = "Без покрытия" Тогда
		ОкраскаСтр = "Б";
	ИначеЕсли РамаТипОкраски = "Оцинковка" Тогда
		ОкраскаСтр = "О";
	Иначе//Если РамаТипОкраски = "Полимеризация" Тогда
		ОкраскаСтр = "П";
	КонецЕсли;
	
	НаименованиеСтойки 	= "Стойка СЕТ";
	НаименованиеРамы 	= "Рама СЕТ";
	СтрВариант = "";
	Стр1 = "";
	Если РамаПрофильСтойки = "70" Тогда
		Стр1 = "175"; 
	ИначеЕсли  РамаПрофильСтойки = "85" Тогда
		Стр1 = ""; 
	ИначеЕсли  РамаПрофильСтойки = "100" Тогда
		Стр1 = "305"; 
	Иначе//Если  РамаПрофильСтойки = "130" Тогда
		Стр1 = "401"; 
	КонецЕсли;
	
	Если РамаВариантИсполнения = "Вариант 1" Тогда
		СтрВариант = "-1";
	Иначе
		СтрВариант = "-2";
	КонецЕсли;
	
	ЕстьНеНайденныеКомплектующие = Ложь;
	
	НаименованиеРамы = НаименованиеРамы + ОкраскаСтр + СтрВариант + " " + СтрЗаменить(СокрЛП(РамаВысотаСтеллажа), Символы.НПП, "") + "/" + СтрЗаменить(СокрЛП(РамаГлубинаСтеллажа), Символы.НПП, "") 
						+ " (" + РамаПрофильСтойки + "." + РамаТолщинаМеталла + ?(Стр1<>"",".","") + Стр1 + ")";
						
	НоменклатураРамы = НайтиНоменклатуруПоНаименованиюНаСервере(НаименованиеРамы);
	
	ВиртуальнаяРама = Ложь;
	Если Не ЗначениеЗаполнено(НоменклатураРамы) тогда
		ВиртуальнаяРама = Истина;
	КонецЕсли;
						
	КолвоРам = СекцииКоличествоПролетов1 + СекцииКоличествоПролетов2 + 1;
	
	Ключ = СокрЛП(Новый УникальныйИдентификатор);
	
	// Находим стойку по комплектации по имеющейся раме
	Если Не ВиртуальнаяРама тогда
		
			Запрос1 = Новый Запрос;
	Запрос1.Текст = 
		"ВЫБРАТЬ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка,
		|	ВариантыКомплектацииНоменклатурыТовары.НомерСтроки,
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Комплектующая,
		|	ВариантыКомплектацииНоменклатурыТовары.Характеристика,
		|	ВариантыКомплектацииНоменклатурыТовары.Упаковка,
		|	ВариантыКомплектацииНоменклатурыТовары.КоличествоУпаковок,
		|	ВариантыКомплектацииНоменклатурыТовары.ДоляСтоимости,
		|	ВариантыКомплектацииНоменклатурыТовары.Количество
		|ИЗ
		|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец = &Владелец
		|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Основной = ИСТИНА";

	Запрос1.УстановитьПараметр("Владелец", НоменклатураРамы);
     НЗ=Запрос1.Выполнить().Выгрузить();
	
		
		//НЗ = РегистрыСведений.КомплектующиеНоменклатуры.СоздатьНаборЗаписей();
		//НЗ.Отбор.Номенклатура.Установить(НоменклатураРамы);
