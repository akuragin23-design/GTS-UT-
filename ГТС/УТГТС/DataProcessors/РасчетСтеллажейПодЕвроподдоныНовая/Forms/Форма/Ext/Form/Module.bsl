	РезультатРасчета.Значение = ((БалкаДлина1 + 10)*СекцииКоличествоПролетов1) + ((БалкаДлина2 + 10)*СекцииКоличествоПролетов2) + (КолвоРам*РамаПрофильСтойки);
	
КонецПроцедуры  //ПодобратьРамыНаСервере()

&НаСервере
Процедура ПодобратьБалкиНаСервере()
	
	НаименованиеБалкиКомплектующей1 = "Балка СЕТ";
	НаименованиеБалки1 = "Балка СЕТ";
	
	Стр1 = "";
	Если БалкаВысотаПрофиля1 = "90" Тогда
		Стр1 = "179"; 
	ИначеЕсли БалкаВысотаПрофиля1 = "120" Тогда
		Стр1 = "272"; 
	ИначеЕсли БалкаВысотаПрофиля1 = "150" Тогда
		Стр1 = "299"; 
	Иначе//Если БалкаВысотаПрофиля1 = "180" Тогда
		Стр1 = "366"; 
	КонецЕсли;
		
	ОкраскаСтр = "";
	Если  БалкаТипОкраски1 = "Без покрытия" Тогда 
		ОкраскаСтр = "Б"; 
	Иначе//Если БалкаТипОкраски1 = "Полимеризация" Тогда
		ОкраскаСтр = "П"; 
