			СтрокаСтойки = ЗаписьСтойкиВКомплектации(НЗ);
			Если НЕ СтрокаСтойки = неопределено тогда
				СтрокаКомплектующая = Комплектующие.Добавить();
				СтрокаКомплектующая.Номенклатура 	= СтрокаСтойки.Комплектующая;
				СтрокаКомплектующая.НаименованиеНоменклатуры = СтрокаСтойки.Комплектующая.Наименование;
				СтрокаКомплектующая.Количество 		= СтрокаСтойки.Количество;
				СтрокаКомплектующая.Вес 			= СтрокаСтойки.Комплектующая.ВесЧислитель/?(ЗначениеЗаполнено(СтрокаСтойки.Комплектующая.ВесЗнаменатель),СтрокаСтойки.Комплектующая.ВесЗнаменатель,1) * СтрокаСтойки.Количество;
				СтрокаКомплектующая.ВнешнийКлюч 	= Ключ;		
			Иначе
				ЕстьНеНайденныеКомплектующие = Истина;
			Конецесли;
		Конецесли;
	КонецЕсли;
	//
	Если ВиртуальнаяРама тогда // стойку расчитываем по параметрам рамы
		НаименованиеСтойки = НаименованиеСтойки(НаименованиеРамы);
		СтрокаКомплектующая = Комплектующие.Добавить();
		СтрокаКомплектующая.НаименованиеНоменклатуры = НаименованиеСтойки;
		СтрокаКомплектующая.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(НаименованиеСтойки);
		СтрокаКомплектующая.Количество 		= 2;
		СтрокаКомплектующая.Вес 			= РасчетныйВесСтойки(НаименованиеРамы) * 2;
		СтрокаКомплектующая.ВнешнийКлюч 	= Ключ;		
	КонецЕсли;
	
	//Катанные элементы рамы (КРЕПЕЖ)
	НаименованиеРаскосаК = "Раскос СЕТ" + ОкраскаСтр + " " + Формат(ДлинаКосогоРаскоса, "ЧГ=0") + " (к)";
	
	НаименованиеРаскосаПр = "Раскос СЕТ" + ОкраскаСтр + " " + Формат(ДлинаПрямогоРаскоса, "ЧГ=0") + " (пр)";
	
	Если НЕ ДобавитьКомплектующую(НаименованиеРаскосаК, КолвоКосыхРаскосов, Ключ) Тогда
		//ЕстьНеНайденныеКомплектующие = Истина;
		СтрокаКомплектующая = Комплектующие.Добавить();
		СтрокаКомплектующая.НаименованиеНоменклатуры = НаименованиеРаскосаК;
		СтрокаКомплектующая.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(НаименованиеРаскосаК);
		СтрокаКомплектующая.Количество 		= КолвоКосыхРаскосов;
		СтрокаКомплектующая.Вес 			= ДлинаКосогоРаскоса*7.85*1.5*67*0.000001;
