&НаСервере
Функция ПолучитьГрузоподъемностьБалкиНаСервере(ДлинаБалки, ВысотаПрофиляБалки, ТолщинаМеталлаБалки,ТолщинаСтойкиВРаме=0)
    ОбработкаОбъект=РеквизитФормыВЗначение("Объект");
	
	
	
	//Асист-Про. Получаем необходимые для расчета макеты
	МакетРасчетаНагрузок=Константы.МакетРасчетаНагрузок.Получить().Получить();	
	Если МакетРасчетаНагрузок=Неопределено Тогда 
		МакетРасчетаНагрузок=ОбработкаОбъект.ПолучитьМакет("МакетРасчетаНагрузок");
	КонецЕсли;
	
	МакетРасчетаPmax=Константы.МакетРасчетаPmax.Получить().Получить();	
	Если МакетРасчетаPmax=Неопределено Тогда 
		МакетРасчетаPmax=ОбработкаОбъект.ПолучитьМакет("МакетРасчетаPmax");
	КонецЕсли;

	
	//Асист-про. Подбираем строку из макета МакетРасчетаНагрузок	
	Профиль = строка(ВысотаПрофиляБалки)+"."+ТолщинаМеталлаБалки;
	Область=МакетРасчетаНагрузок.НайтиТекст(Профиль);
	
	Если Область=Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена строка с данными в макете расчета нагрузок по профилю: "+Профиль+" Необходимо внести данные по указанному профилю в макет расчета нагрузок");
		Возврат 0;
	КонецЕсли;
	
	Строка = Лев(Область.Имя,Найти(Область.Имя,"C")-1);
	//Асист-про. Получаем данные из макета
	Pкритич = Число(МакетРасчетаНагрузок.Область(Строка+"C2").Текст);
	Lкритич = Число(МакетРасчетаНагрузок.Область(Строка+"C3").Текст);
	КоличествоЗацепов = Число(МакетРасчетаНагрузок.Область(Строка+"C4").Текст);
	
	//Асист-про. Расчет Pmax по формуле заложенной в макете
	Кмзапас=Константы.КМЗапас.Получить();
	Если Не ЗначениеЗаполнено(Кмзапас) Тогда
		Кмзапас=0.15;
	КонецЕсли;  
	//Асист-Про. Если передано 0 то расчитываем по формуле для прайс листа
	Если ТолщинаСтойкиВРаме<>0 Тогда
		ТипОкраски=?(РамаТипОкраски<>"Оцинковка","Остальные","Оцинковка");
		Ключ=""+КоличествоЗацепов+"."+Формат(Число(ТолщинаСтойкиВРаме),"ЧДЦ=1; ЧРД=,")+"."+ТипОкраски+"."+ВысотаПрофиляБалки+"."+Формат(Число(ТолщинаМеталлаБалки),"ЧДЦ=1; ЧРД=,");
		Область=МакетРасчетаPmax.НайтиТекст(Ключ);
		
		
		
		Если Область=Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена строка с данными в макете расчета P(max) по ключу: "+Ключ+" Необходимо внести данные по указанному ключу в макет расчета P(max)");
			Возврат 0;
		КонецЕсли;
		
		Строка =Лев(Область.Имя,Найти(Область.Имя,"C")-1);
		Pmax=0;
		Выполнить "Pmax="+МакетРасчетаPmax.Область(Строка+"C2").Текст+";";
	Иначе
		Выполнить "Pmax="+МакетРасчетаPmax.Область("R2C3").Текст+";";
	КонецЕсли;
	
	L = ДлинаБалки;  
	
	//-----------
	Если L <= Lкритич тогда
		Pрасч = Pкритич*(Lкритич/L);
	Иначе
		Pрасч = Pкритич*Pow((Lкритич/L), 2);
	КонецЕсли;
	
	P = Pрасч;
	Если Pрасч >= Pmax тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Расчетное значение нагрузки превышает значение Pmax для данного типа балок. Рекомендуется изменить параметры и повторить расчет");
	КонецЕсли;
	
	Если Pрасч >= Pкритич тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Внимание! Расчетное значение нагрузки превышает значение Pкритич для данного типа балок. Рекомендуется изменить параметры и повторить расчет");
	КонецЕсли;

	
	Результат = Цел(P/10)*10;
	
	возврат Результат;
	                             
КонецФункции //ПолучитьГрузподъемностьБалки	

