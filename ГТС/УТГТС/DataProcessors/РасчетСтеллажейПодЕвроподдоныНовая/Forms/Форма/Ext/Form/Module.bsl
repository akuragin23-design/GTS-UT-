&НаКлиенте
Процедура БалкаВысотаПрофиля1ПриИзменении(Элемент)
	
	Если ПустаяСтрока(БалкаВысотаПрофиля1) Тогда
		БалкаТолщинаМеталла1 = "";
		Элементы.БалкаТолщинаМеталла1.СписокВыбора.Очистить();
		Возврат;
	КонецЕсли;
	
	Элементы.БалкаТолщинаМеталла1.СписокВыбора.ЗагрузитьЗначения(СоответствиеВысотыПрофиляБалки_и_ТолщиныМеталла.НайтиСтроки(Новый Структура("ВысотаПрофиляБалки", БалкаВысотаПрофиля1))[0].ТолщиныБалки.ВыгрузитьЗначения());
	Если Элементы.БалкаТолщинаМеталла1.СписокВыбора.НайтиПоЗначению(БалкаТолщинаМеталла1) = Неопределено Тогда
		БалкаТолщинаМеталла1 = Элементы.БалкаТолщинаМеталла1.СписокВыбора[0].Значение;
	КонецЕсли;
	
	РасчитатьГрузоподъемностьБалокНаСервере();
	
	РамаГрузоподъемность = ПолучитьГрузоподъемностьРамыНаСервере();
	
	// Устанавливаем видимость переключателя в зависимости от высоты профиля
	Элементы.ФлагПолетная.Видимость = (БалкаВысотаПрофиля1 = "90");
	
КонецПроцедуры

