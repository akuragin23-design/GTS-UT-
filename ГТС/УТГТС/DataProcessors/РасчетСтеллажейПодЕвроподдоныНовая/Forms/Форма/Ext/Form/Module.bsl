&НаСервере
Функция ДобавитьКомплектующую(Наименование, Колво, Ключ)
	
	Комплектующая = НайтиНоменклатуруПоНаименованиюНаСервере(Наименование);
	Если Комплектующая.Пустая() Тогда
		Сообщить("Не найдена комплектующая: " + Наименование);
		Возврат Ложь;	
	КонецЕсли;
	
	Если Колво = 0 Тогда
		Возврат Истина;
	КонецЕсли;	
		
	СтрокаКомплектующая = Комплектующие.Добавить();
	СтрокаКомплектующая.Номенклатура 				= Комплектующая;
	СтрокаКомплектующая.НаименованиеНоменклатуры 	= Комплектующая.Наименование;
	СтрокаКомплектующая.Количество 					= Колво;
	СтрокаКомплектующая.Вес 						= СтрокаКомплектующая.Номенклатура.ВесЧислитель/?(ЗначениеЗаполнено(СтрокаКомплектующая.Номенклатура.ВесЗнаменатель),СтрокаКомплектующая.Номенклатура.ВесЗнаменатель,1) * Колво;
	СтрокаКомплектующая.ВнешнийКлюч 				= Ключ;
	
	Возврат Истина;
	
КонецФункции//ДобавитьКомплектующую	

&НаСервере
Функция СформироватьРасчетныйЛистНаСервере()
	
	ДлинаСталлажа = 0;
	КолвоУровнейВПролете = 0;
	
	Для Каждого РезультатРасчета Из РезультатыРасчета Цикл
		Если РезультатРасчета.Параметр = "ДлинаСтеллажа" Тогда
			ДлинаСталлажа = РезультатРасчета.Значение;
		ИначеЕсли РезультатРасчета.Параметр = "КолвоУровнейВПролете" Тогда
			КолвоУровнейВПролете = РезультатРасчета.Значение;
		КонецЕсли;	
	КонецЦикла;
	
