&НаКлиенте
Процедура СформироватьНовуюНоменклатуру(Команда)
	ПараметрыФормы = Новый Структура();
	Для каждого СтрокаТЧ из Объект.Товары цикл
		Если ЕстьНеобходимостьКомплектоватьНоменклатуру(СтрокаТЧ.Номенклатура, СтрокаТЧ.Ключ) тогда
			
			УИ = Новый УникальныйИдентификатор;
			//
			ПараметрыФормы.Вставить("НоменклатураСЕТ", СтрокаТЧ.Номенклатура);
			ПараметрыФормы.Вставить("НаименованиеНоменклатурыСЕТ", СтрокаТЧ.Наименование);
			//
			СтрокиКомплектующих = АдресСтрокКомплектующих(СтрокаТЧ.Ключ, УИ);
			ПараметрыФормы.Вставить("АдресСтрокКомплектующих", СтрокиКомплектующих);
			//
			//Ассист-Про. Добавил передачу веса
			ПараметрыФормы.Вставить("Вес", СтрокаТЧ.Вес);

			ОткрытьФорму("Обработка.РасчетСтеллажейПодЕвроподдоныНовая.Форма.СборкаНовойНоменклатуры", ПараметрыФормы, ЭтаФорма, УИ);
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыФормы.Вставить("НаименованиеСборки", "");
КонецПроцедуры

// Функция для расчета цен стоек и раскосов
&НаСервере
Функция ЦенаКомплектующего(Наименование)
	
	Если Найти(Наименование, "Стойка") = 0 
		И Найти(Наименование, "Раскос") = 0 тогда 
		возврат 0;
	Конецесли;
	
	//
	
	БазовоеНаименование = Альтерлого.БазовоеНаименованиеНоменклатуры(Наименование);
	//
	БазовоеНаименование = СокрЛП(БазовоеНаименование);
	БазоваяНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(БазовоеНаименование);
	Если БазоваяНоменклатура.Пустая() тогда
		ВызватьИсключение "Не найдена номенклатура "+БазовоеНаименование;
	КонецЕсли;
	//
	Длина = Альтерлого.ДлинаСтойкиРаскоса(Наименование)/1000;
	//
	БазоваяЦена = БазоваяЦена(БазоваяНоменклатура);
	Цена = БазоваяЦена*Длина;
	
	возврат Цена;
	
КонецФункции

&НаСервере
Функция БазоваяЦена(БазоваяНоменклатура)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаЦен,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних");
	Запрос.УстановитьПараметр("ДатаЦен", КонецДня(НаДату));
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("Номенклатура", БазоваяНоменклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		БазоваяЦена = Выборка.Цена;		
		возврат БазоваяЦена;
	Иначе
		возврат 0;
	КонецЕсли;
КонецФункции

