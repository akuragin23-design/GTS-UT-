&НаСервере
Функция КоэффициентыНаценки()
	
	Структура = Новый Структура("Балка1, Балка2", 1, 1);
	
	Для п = 1 по 2 цикл
		Если ЭтаФорма["БалкаДлина"+строка(п)] > Константы.ДлинаБалкиБезДопНаценки.Получить() тогда
			Если Лев(ЭтаФорма["БалкаТипОкраски"+п], 1) = "Б" тогда
				Структура["Балка"+строка(п)] = 1;
			Иначе
				Отбор = Новый Структура("ТолщинаМеталла, ВысотаПрофиля", ЭтаФорма["БалкаТолщинаМеталла"+строка(п)], ЭтаФорма["БалкаВысотаПрофиля"+строка(п)]);
				Рег = РегистрыСведений.КоэффициентыНаценкиКомплектующихРасчетаСтелажей.СрезПоследних(ТекущаяДата(), Отбор);
				Если Рег.Количество() > 0 тогда
					Структура["Балка"+строка(п)] = Рег[0].Коэффициент;
				Конецесли;
			КонецЕсли;
		КонецЕсли;
	Конеццикла;
	
	возврат Структура;
	
КонецФункции
	
&НаСервере
Функция ТипПокрытия(НаименованиеИзделия)
	
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаименованиеИзделия, " ");
	Покрытие = "";
	Для каждого е из Массив цикл
		Если Найти(е, "ГТС")>0 
			ИЛИ Найти(е, "СЕТ")>0 тогда
			Покрытие = Лев(е, 4);
		КонецЕсли;
	Конеццикла;
	
	возврат Покрытие;
	
КонецФункции

&НаСервере
Функция ПрофильКомплектующего(Наименование)
	ПозицияПервойСкобки = Найти(Наименование, "(");
	ПозицияВторойСкобки = Найти(Наименование, ")");
	КоличествоСимволов = ПозицияВторойСкобки-ПозицияПервойСкобки-1;
	Текст = Сред(Наименование, ПозицияПервойСкобки+1, КоличествоСимволов);
	возврат Текст;
КонецФункции

&НаСервере
Функция ДлинаСтойки(НаименованиеРамы)
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НаименованиеРамы, " ");
	СтрокаДлины = "";
	Для каждого е из Массив цикл
		Если Найти(е, "/") = 0 тогда продолжить конецесли;
		//
		Подмассив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(е, "/");
		СтрокаДлины = Подмассив[0];
	Конеццикла;
	возврат СтрокаДлины;
КонецФункции

&НаСервере
Функция РасчетныйВесСтойки(НаименованиеРамы)
	СтруктураСтоек = Новый Соответствие();
	СтруктураСтоек.Вставить("100.1.5", 0.0035207); 
	СтруктураСтоек.Вставить("100.2.0", 0.0046943); 
    СтруктураСтоек.Вставить("130.1.5", 0.0046982); 
    СтруктураСтоек.Вставить("130.2.0", 0.0062643); 
    СтруктураСтоек.Вставить("70.1.5", 0.0020959); 
    СтруктураСтоек.Вставить("70.2.0", 0.0027946);
	СтруктураСтоек.Вставить("85.1.5", 0.0029791);
    СтруктураСтоек.Вставить("85.2.0", 0.0039250);
	
	Профиль = ПрофильКомплектующего(НаименованиеРамы);
	Альтерлого.ОбработатьПрофиль(Профиль, Истина);
	
	Плотность = СтруктураСтоек[Профиль];
	
	Попытка
		Длина = Число(ДлинаСтойки(НаименованиеРамы));
	Исключение
		Длина = 0;
	КонецПопытки;
	
	Вес = Длина * Плотность;
	
	возврат Вес;
	
КонецФункции

&НаСервере
Функция НаименованиеСтойки(НаименованиеРамы)
	СтрокаПрофиля = ПрофильКомплектующего(НаименованиеРамы);
	АльтерЛОГО.ОбработатьПрофиль(СтрокаПрофиля, Истина);
	Текст = "Стойка "+ТипПокрытия(НаименованиеРамы)+" "+ДлинаСтойки(НаименованиеРамы)+" ("+СтрокаПрофиля+")";
	возврат Текст;
КонецФункции

&НаСервере
Функция СтруктураПараметровБалок()
	Структура = Новый Структура();
	Для п = 1 по 2 цикл
		ЗначениеСтруктуры = Формат(ЭтаФорма["БалкаДлина"+строка(п)], "ЧГ=0")+
											"/"+
											Формат(ЭтаФорма["БалкаГрузоподъемность"+строка(п)], "ЧГ=0");
		Если ЗначениеСтруктуры = "/" Тогда
			ЗначениеСтруктуры = "";
		КонецЕсли;
		Структура.Вставить("Балка"+строка(п), ЗначениеСтруктуры);
	Конеццикла;
	возврат Структура;									
КонецФункции

&НаСервере
Процедура РасчитатьГрузоподъемностьБалокНаСервере()
	Для п = 1 по 2 цикл
		Если НЕ ПрофильБалкиЗаполнен(п) тогда
			ЭтаФорма["БалкаГрузоподъемность"+строка(п)] = 0;
			продолжить;
		КонецЕсли;
		//
		ЭтаФорма["БалкаГрузоподъемность"+строка(п)] = ПолучитьГрузоподъемностьБалкиНаСервере(ЭтаФорма["БалкаДлина"+строка(п)], 
																		ЭтаФорма["БалкаВысотаПрофиля"+строка(п)], 
																		ЭтаФорма["БалкаТолщинаМеталла"+строка(п)],РамаТолщинаМеталла);
	Конеццикла;
КонецПроцедуры

&НаСервере
Функция ПрофильБалкиЗаполнен(индекс)
	Результат = ЗначениеЗаполнено(ЭтаФорма["БалкаВысотаПрофиля"+строка(индекс)])
				И ЗначениеЗаполнено(ЭтаФорма["БалкаТолщинаМеталла"+строка(индекс)])
				И ЗначениеЗаполнено(ЭтаФорма["БалкаДлина"+строка(индекс)]);
	возврат Результат;
КонецФункции

/////////////////// ФОРМИРОВАНИЕ НОВОЙ НОМЕНКЛАТУРЫ НА СТОРОНЕ СЕРВЕРА
&НаСервере
Функция ЕстьНеобходимостьКомплектоватьНоменклатуру(Номенклатура, Ключ)
	//ГТС проверка на наборы
	если лев(Номенклатура,4)="Рама" И НЕ ЗначениеЗаполнено(Справочники.Номенклатура.НайтиПоНаименованию(строка(Номенклатура) + " (набор)",истина)) 
	Тогда 
	Возврат Истина;				
	ИначеЕсли лев(Номенклатура,4)="Рама" И ЗначениеЗаполнено(Справочники.Номенклатура.НайтиПоНаименованию(строка(Номенклатура) + " (набор)",истина)) 
	тогда Возврат ложь;
	конецесли;
	
	Если НЕ ЗначениеЗаполнено(Номенклатура) тогда
		возврат Истина;
	ИначеЕсли НЕ ЗначениеЗаполнено(АльтерЛОГО.КомплектацияНоменклатуры(Номенклатура)) тогда
		возврат Истина;
	Иначе
		МассивКомплектующих = Комплектующие.НайтиСтроки(Новый Структура("ВнешнийКлюч", Ключ));
		Для каждого СтрокаКомплектующих из МассивКомплектующих цикл
			Если НЕ ЗначениеЗаполнено(СтрокаКомплектующих.Номенклатура) тогда 
				возврат Истина;
			Конецесли;
		Конеццикла;
	КонецЕсли;
	//
	возврат ЛОЖЬ;
КонецФункции

&НаСервере
Функция АдресСтрокКомплектующих(Ключ, УИ)
	
	Массив = Комплектующие.НайтиСтроки(Новый Структура("ВнешнийКлюч", Ключ));
	Адрес = ПоместитьВоВременноеХранилище(Массив, УИ);
	возврат Адрес;
	
КонецФункции

