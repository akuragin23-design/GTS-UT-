	ОбщЦенаКрепежа = ЦенаВинт*14 + ДопЦена + ЦенаШайба*36 + ЦенаГайка*18;
	ОбщЦенаРаскосов = 13.3*ЦенаРаскос;	
	ОбластьРамы.Параметры.р93 = Окр(ЦенаР*13 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*15 + ДопЦена + ЦенаШайба*38 + ЦенаГайка*19;
	ОбщЦенаРаскосов = 14.438*ЦенаРаскос;
	ОбластьРамы.Параметры.р94 = Окр(ЦенаР*14 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*16 + ДопЦена + ЦенаШайба*40 + ЦенаГайка*20;
	ОбщЦенаРаскосов = 15.576*ЦенаРаскос;
	ОбластьРамы.Параметры.р95 = Окр(ЦенаР*15 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*16 + ДопЦена1 + ЦенаШайба*40 + ЦенаГайка*20;
	ОбщЦенаРаскосов = 16.714*ЦенаРаскос;
	ОбластьРамы.Параметры.р96 = Окр(ЦенаР*16 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*17 + ДопЦена + ЦенаШайба*42 + ЦенаГайка*21;
	ОбщЦенаРаскосов = 16.714*ЦенаРаскос;
	ОбластьРамы.Параметры.р97 = Окр(ЦенаР*17 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*18 + ДопЦена + ЦенаШайба*44 + ЦенаГайка*22;
	ОбщЦенаРаскосов = 17.852*ЦенаРаскос;
	ОбластьРамы.Параметры.р98 = Окр(ЦенаР*18 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*19 + ДопЦена + ЦенаШайба*46 + ЦенаГайка*23;
	ОбщЦенаРаскосов = 18.99*ЦенаРаскос;
	ОбластьРамы.Параметры.р99 = Окр(ЦенаР*19 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*20 + ДопЦена + ЦенаШайба*48 + ЦенаГайка*24;
	ОбщЦенаРаскосов = 20.128*ЦенаРаскос;
	ОбластьРамы.Параметры.р100 = Окр(ЦенаР*20 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*21 + ДопЦена1 + ЦенаШайба*50 + ЦенаГайка*25;
	ОбщЦенаРаскосов = 22.404*ЦенаРаскос;
	ОбластьРамы.Параметры.р101 = Окр(ЦенаР*22 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	ОбщЦенаКрепежа = ЦенаВинт*23 + ДопЦена + ЦенаШайба*54 + ЦенаГайка*27;
	ОбщЦенаРаскосов = 23.542*ЦенаРаскос;
	ОбластьРамы.Параметры.р102 = Окр(ЦенаР*24 + ОбщЦенаКрепежа + ОбщЦенаРаскосов);
	
	ТабДок.Вывести(ОбластьРамы);
	
	Возврат ТабДок;
	
КонецФункции //СформироватьПрайЛистНаСервере	

&НаСервере
Функция СформироватьЦеныБалокНаСервере()
	
	ДлБалки = Новый Массив(26);
	
	ДлБалки[0]=1500;
	Для К=1 по 25 Цикл
		ДлБалки[К]=ДлБалки[К-1]+100; 	
	КонецЦикла; 
	
	СЗ_ПараметрыБалок = Новый СписокЗначений;
	СЗ_ПараметрыБалок.Добавить("90.1.5","(90)");
	СЗ_ПараметрыБалок.Добавить("90.2.0","(90)");
	СЗ_ПараметрыБалок.Добавить("120.1.5","(120)");
	СЗ_ПараметрыБалок.Добавить("120.2.0","(120)");
	СЗ_ПараметрыБалок.Добавить("120.2.5","(120)");
	СЗ_ПараметрыБалок.Добавить("150.2.0","(150)");
	СЗ_ПараметрыБалок.Добавить("150.2.5","(150)");
	СЗ_ПараметрыБалок.Добавить("150.3.0","(150)");
	СЗ_ПараметрыБалок.Добавить("180.2.5","(180)");
	СЗ_ПараметрыБалок.Добавить("180.3.0","(180)");
	
	СписокНоменклатуры = Новый СписокЗначений;
	СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Фиксатор СЕТ", Истина));
	//Асист-Про. В дальнейшем вызывает ошибку так как цены будут получаться только по ограниченному списку а формируется и по СЕТП И ПО СЕТБ
	//Если БалкаТипОкраски1 = "Полимеризация" тогда
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТП (90)", Истина));
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТП (120)", Истина));
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТП (150)", Истина));
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТП (180)", Истина));
	//Иначе
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТБ (90)", Истина));
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТБ (120)", Истина));
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТБ (150)", Истина));
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Зацеп СЕТБ (180)", Истина));
	//Конецесли;
	
	СписокБалок = Новый СписокЗначений;
	Для каждого ЭлементСписка Из СЗ_ПараметрыБалок Цикл
		СпрБалка = Справочники.Номенклатура.НайтиПоНаименованию("Балка СЕТБ (" + ЭлементСписка.Значение + ")",Истина);
		СписокБалок.Добавить(СпрБалка);
		СписокНоменклатуры.Добавить(СпрБалка);
		
		СпрБалка = Справочники.Номенклатура.НайтиПоНаименованию("Балка СЕТП (" + ЭлементСписка.Значение + ")",Истина);
		СписокБалок.Добавить(СпрБалка);
		СписокНоменклатуры.Добавить(СпрБалка);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура.Наименование КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаЦен,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура В (&СписокНоменклатуры)) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("ДатаЦен"	, КонецДня(НаДату));
	Запрос.УстановитьПараметр("ВидЦены"	, ВидЦены);
	Запрос.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	
	ТЗ_Цены = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаСписка Из СписокНоменклатуры Цикл
		Стр = ТЗ_Цены.Найти(СтрокаСписка.Значение, "Номенклатура");
		Если Стр = Неопределено Тогда
			Стр = ТЗ_Цены.Добавить();
			Стр.Номенклатура = СтрокаСписка.Значение;
			Стр.Цена = 0;
		КонецЕсли;
	КонецЦикла;	
	
	СтрокаЦены = ТЗ_Цены.Найти("Фиксатор СЕТ", "Номенклатура");
	ЦенаФиксатора = СтрокаЦены.Цена;
	
	Макет = Обработки.РасчетСтеллажейПодЕвроподдоныНовая.ПолучитьМакет("ЦеныБалок");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицыПрофиль = Макет.ПолучитьОбласть("ШапкаТаблицы|Профиль");
	ОбластьШапкаТаблицыЦена = Макет.ПолучитьОбласть("ШапкаТаблицы|Цена");
	ОбластьСтрокаПрофиль = Макет.ПолучитьОбласть("Строка|Профиль");
	ОбластьСтрокаЦена = Макет.ПолучитьОбласть("Строка|Цена");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Вывести(ОбластьШапка);
	
	ОбластьШапкаТаблицыПрофиль.Параметры.Покрытие = "Без покрытия";
	ТабДок.Вывести(ОбластьШапкаТаблицыПрофиль);
	
	Для К = 0 по 25 Цикл
		ОбластьШапкаТаблицыЦена.Параметры.ДлинаБалки = ДлБалки[К];
		ТабДок.Присоединить(ОбластьШапкаТаблицыЦена);
	КонецЦикла;
		
	Для каждого ЭлементСписка Из СЗ_ПараметрыБалок Цикл
		
		ОбластьСтрокаПрофиль.Параметры.Профиль = ЭлементСписка.Значение;
		ТабДок.Вывести(ОбластьСтрокаПрофиль);
		
		НаимБалки = "Балка СЕТБ (" + ЭлементСписка.Значение + ")";
		СтрокаЦены = ТЗ_Цены.Найти(НаимБалки, "Номенклатура");
		ЦенаБалки = СтрокаЦены.Цена;
		
		НаимЗацепа = "Зацеп СЕТБ " + ЭлементСписка.Представление;
		СтрокаЦены = ТЗ_Цены.Найти(НаимЗацепа,"Номенклатура");
		ЦенаЗацепа = СтрокаЦены.Цена;
		
		Для К = 0 по 25 Цикл
			Длина = ДлБалки[К]; 	
			Цена = Окр((ЦенаБалки*Длина / 1000) + ЦенаЗацепа + ЦенаФиксатора*2, 0);
			
			ОбластьСтрокаЦена.Параметры.Цена = Цена;
			ТабДок.Присоединить(ОбластьСтрокаЦена);
		КонецЦикла;
	КонецЦикла;
	
	ОбластьШапкаТаблицыПрофиль.Параметры.Покрытие = "Полимеризация";
	ТабДок.Вывести(ОбластьШапкаТаблицыПрофиль);
	
	Для К = 0 по 25 Цикл
		ОбластьШапкаТаблицыЦена.Параметры.ДлинаБалки = ДлБалки[К];
		ТабДок.Присоединить(ОбластьШапкаТаблицыЦена);
	КонецЦикла;
	
	Для каждого ЭлементСписка Из СЗ_ПараметрыБалок Цикл
		ОбластьСтрокаПрофиль.Параметры.Профиль = ЭлементСписка.Значение;
		ТабДок.Вывести(ОбластьСтрокаПрофиль);
		
		НаимБалки = "Балка СЕТП (" + ЭлементСписка.Значение + ")";
		СтрокаЦены = ТЗ_Цены.Найти(НаимБалки, "Номенклатура");
		ЦенаБалки = СтрокаЦены.Цена;
		
		НаимЗацепа = "Зацеп СЕТП " + ЭлементСписка.Представление;
		СтрокаЦены = ТЗ_Цены.Найти(НаимЗацепа,"Номенклатура");
		ЦенаЗацепа = СтрокаЦены.Цена;
		
		Для К = 0 по 25 Цикл
			Длина = Число(ДлБалки[К]); 	
			Цена = Окр((ЦенаБалки*Длина / 1000) + ЦенаЗацепа + ЦенаФиксатора*2, 0);
			
			ОбластьСтрокаЦена.Параметры.Цена = Цена;
			ТабДок.Присоединить(ОбластьСтрокаЦена);
		КонецЦикла;
	КонецЦикла;

	Возврат ТабДок;
	
КонецФункции//СформироватьЦеныБалокНаСервере

&НаСервере
Функция СформироватьЦеныРамНаСервере()
	
	ВРамы = Новый Массив(60); 
	
	Если РамаНачальнаяВысота = 0 Тогда
		ВРамы[0] = 2000; 
	иначе
		ВРамы[0] = РамаНачальнаяВысота;
	КонецЕсли;
	
	Для К = 1 по 59 Цикл
		ВРамы[К] = ВРамы[К-1]+100; 	
	КонецЦикла;
	
	ТипыПокрасок = Новый СписокЗначений;
	ТипыПокрасок.Добавить("Б","Без покрытия");
	ТипыПокрасок.Добавить("О","Оцинковка");
	ТипыПокрасок.Добавить("П","Полимеризация");
	
	ПрофилиСтоек = Новый СписокЗначений;
	ПрофилиСтоек.Добавить("70");
	ПрофилиСтоек.Добавить("100");
	ПрофилиСтоек.Добавить("130");
	
	ТолщиныМеталла = Новый СписокЗначений;
	ТолщиныМеталла.Добавить("1.5");
	ТолщиныМеталла.Добавить("2.0");
	
	ВариантыИсполнения = Новый СписокЗначений;
	ВариантыИсполнения.Добавить("Вариант 1");
	ВариантыИсполнения.Добавить("Вариант 2");
	
	СписокНоменклатуры = Новый СписокЗначений;
	СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Винт М8х55", Истина)); 
	СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Втулка 20", Истина)); 	
	СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Шайба спец.овал.6вэ.73.334.01", Истина)); 	
	СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Болт М8х35", Истина));
	СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Втулка М8", Истина));
	СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Гайка М8", Истина));
	
	Для каждого ЭлементТипПокраски Из ТипыПокрасок Цикл
		ОкраскаСтр = ЭлементТипПокраски.Значение;
		СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Раскос СЕТ" + ОкраскаСтр + " (100.1.5)", Истина));
		Для каждого ЭлементПрофильСтойки Из ПрофилиСтоек Цикл
			ПрофильСтойки = ЭлементПрофильСтойки.Значение;
			РазмерыСтр = "";
			Если ПрофильСтойки = "70" Тогда
				РазмерыСтр = "80х90";
			ИначеЕсли ПрофильСтойки = "100" Тогда
				РазмерыСтр = "140х150";
			Иначе//Если ПрофильСтойки = "130" Тогда
				РазмерыСтр = "155х155";
			КонецЕсли;
			
			Если ОкраскаСтр = "Б" Тогда
				ОкраскаСтрП = "СЕТБ";
			ИначеЕсли ОкраскаСтр="П" Тогда
				ОкраскаСтрП = "СЕТП";
			Иначе
				ОкраскаСтрП = "СЕТО";
			КонецЕсли;
	
			СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Подпятник " + ОкраскаСтрП + " " + РазмерыСтр, Истина));
			
			Для каждого ЭлементТолщинаМеталла Из ТолщиныМеталла Цикл
				СписокНоменклатуры.Добавить(Справочники.Номенклатура.НайтиПоНаименованию("Стойка СЕТ" + ОкраскаСтр + " (" + ПрофильСтойки + "." + ЭлементТолщинаМеталла.Значение + ")", Истина));	
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;	
	
	ЗапросЦены = Новый Запрос;
	ЗапросЦены.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура.Наименование КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаРасчета,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура В (&СписокНоменклатуры)) КАК ЦеныНоменклатурыСрезПоследних";
	ЗапросЦены.УстановитьПараметр("ДатаРасчета", КонецДня(НаДату));
	ЗапросЦены.УстановитьПараметр("ВидЦены", ВидЦены);
	ЗапросЦены.УстановитьПараметр("СписокНоменклатуры", СписокНоменклатуры);
	
	ТЗ_Цены = ЗапросЦены.Выполнить().Выгрузить();
	
	Для Каждого СтрокаСписка Из СписокНоменклатуры Цикл
		Стр = ТЗ_Цены.Найти(СтрокаСписка.Значение, "Номенклатура");
		Если Стр = Неопределено Тогда
			Стр = ТЗ_Цены.Добавить();
			Стр.Номенклатура = СтрокаСписка.Значение;
			Стр.Цена = 0;
		КонецЕсли;
	КонецЦикла;	
	
	СтрокаЦены = ТЗ_Цены.Найти("Винт М8х55", "Номенклатура");
	ЦенаВинтовМ8х55 = СтрокаЦены.Цена;
	
	СтрокаЦены = ТЗ_Цены.Найти("Втулка 20", "Номенклатура");
	ЦенаВтулок20 = СтрокаЦены.Цена;
	
	СтрокаЦены = ТЗ_Цены.Найти("Болт М8х35", "Номенклатура");
	ЦенаБолтовМ8х35 = СтрокаЦены.Цена;
	
	СтрокаЦены = ТЗ_Цены.Найти("Втулка М8", "Номенклатура");
	ЦенаВтулокМ8 = СтрокаЦены.Цена;
	
	СтрокаЦены = ТЗ_Цены.Найти("Шайба спец.овал.6вэ.73.334.01", "Номенклатура");
	ЦенаШайбМ8 = СтрокаЦены.Цена;
	
	СтрокаЦены = ТЗ_Цены.Найти("Гайка М8", "Номенклатура");
	ЦенаГаекМ8 = СтрокаЦены.Цена;
	
	Макет = Обработки.РасчетСтеллажейПодЕвроподдоныНовая.ПолучитьМакет("ЦеныРам");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаРам = Макет.ПолучитьОбласть("ШапкаРам");
	ОбластьСтрокаСтрока1 = Макет.ПолучитьОбласть("Строка|Колонка1");
	ОбластьСтрокаСтрока2 = Макет.ПолучитьОбласть("Строка|Колонка2");
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Вывести(ОбластьШапка);
	
	Для каждого ЭлементВИ Из ВариантыИсполнения Цикл
		Для каждого ЭлементПС из ПрофилиСтоек Цикл
			Для каждого ЭлементТМ из ТолщиныМеталла Цикл
				Для каждого ЭлементТП из ТипыПокрасок Цикл	
					
					
					ВариантИсполнения = ЭлементВИ.Значение;
					
					ОкраскаСтр = ЭлементТП.Значение;
					
					ПрофильСтойки = ЭлементПС.Значение;
					
					РазмерыСтр = "";
					Если ПрофильСтойки = "70" Тогда
						РазмерыСтр = "80х90";
					ИначеЕсли ПрофильСтойки = "100" Тогда
						РазмерыСтр = "140х150";
					Иначе//Если ПрофильСтойки = "130" Тогда
						РазмерыСтр = "155х155";
					КонецЕсли;
					
					Если ОкраскаСтр = "Б" Тогда
						ОкраскаСтрП = "СЕТБ";
					ИначеЕсли ОкраскаСтр = "П" Тогда
						ОкраскаСтрП = "СЕТП";
					Иначе
						ОкраскаСтрП = "СЕТО";
					КонецЕсли;
					
					СтрокаЦены = ТЗ_Цены.Найти("Подпятник " + ОкраскаСтрП + " " + РазмерыСтр, "Номенклатура");
					ЦенаПодпятников = СтрокаЦены.Цена;
					СуммаПодпятников = ЦенаПодпятников*2;
					
					// Катанные элементы рамы
					// Для стойки 70мм
					Если ПрофильСтойки = "70" Тогда
						k1 = 2*42;
					// Для стойки 100мм	
					ИначеЕсли ПрофильСтойки = "100" Тогда
						k1 = 2*68.5;
					// Для стойки 130мм	
					Иначе//Если ПрофильСтойки = "130" Тогда
						k1 = 2*86;
					КонецЕсли;
					
					МежОсРасст = РамаГлубинаСтеллажа - k1;
					ДлинаПрямогоРаскоса = МежОсРасст + 2*20;
					
					ДлинаКосогоРаскоса = Окр(Sqrt((МежОсРасст*МежОсРасст) + (600*600)) + 2*20);
					
					ОбластьШапкаРам.Параметры.ПараметрыРамы = "Ширина: " + РамаГлубинаСтеллажа + "; Исполнение: " + ВариантИсполнения + "; Профиль: " + ПрофильСтойки + "; Толщина металла: " 
															+ ЭлементТМ.Значение + "; Покраска: " + ЭлементТП.Представление;
					ОбластьШапкаРам.Параметры.ДлинаПрямогоРаскоса = ДлинаПрямогоРаскоса;
					ОбластьШапкаРам.Параметры.ДлинаКосогоРаскоса = ДлинаКосогоРаскоса;
                    ТабДок.Вывести(ОбластьШапкаРам);
					
					ТабДок.Вывести(ОбластьСтрокаСтрока1);
					
					НомСтроки = 0;
					
					Для каждого ВысотаСтеллажа из ВРамы Цикл
						НомСтроки = НомСтроки + 1;
						СтруктураПараметров = Новый Структура;
						//ASP. Строка исправлена для отвязки от выбранных параметров в форме 
						НаименованиеСтойки = "Стойка СЕТ" + ОкраскаСтр + " (" + ПрофильСтойки + "." + ЭлементТМ + ")";
					
						СтрокаЦены = ТЗ_Цены.Найти(НаименованиеСтойки, "Номенклатура");
						ЦенаСтойки = СтрокаЦены.Цена;
						ДлинаСтоек = (ВысотаСтеллажа*2)/1000;
						
						СуммаСтойки = Окр(ДлинаСтоек*ЦенаСтойки, 2);
						СтруктураПараметров.Вставить("СуммаСтойки", СуммаСтойки);
					
						КолвоПрямыхРаскосов = 2;
						Если ВариантИсполнения = "Вариант 1" Тогда
							КолвоКосыхРаскосов = Цел((ВысотаСтеллажа - 200)/600);
							Если (ВысотаСтеллажа-200) > КолвоКосыхРаскосов*600 Тогда 
								КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов + 1;
							Иначе 
								КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов;
							КонецЕсли;
						Иначе
							Если (ВысотаСтеллажа >= 2000) и (ВысотаСтеллажа <= 2500)  Тогда
								КолвоПрямыхРаскосов = КолвоПрямыхРаскосов + 1;
							ИначеЕсли  (ВысотаСтеллажа > 2500) и (ВысотаСтеллажа <= 4300)  Тогда 
								КолвоПрямыхРаскосов = КолвоПрямыхРаскосов + 2;
							ИначеЕсли  (ВысотаСтеллажа > 4300) и (ВысотаСтеллажа <= 6100)  Тогда 
								КолвоПрямыхРаскосов = КолвоПрямыхРаскосов+3;  
							ИначеЕсли  ВысотаСтеллажа > 6100  Тогда 
								КолвоПрямыхРаскосов=КолвоПрямыхРаскосов + 4 + Цел((ВысотаСтеллажа-6100)/1800);
							КонецЕсли;
							//------------------------------------------------------------------------------------------------------------------------------------------------------------
							Если (ВысотаСтеллажа - 144 - 56) > КолвоКосыхРаскосов*600 Тогда 
								КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов + 1;
							Иначе 
								КолвоКрепежа = КолвоКосыхРаскосов + 1 + КолвоПрямыхРаскосов;
							КонецЕсли;
							
							//--------------------------------------------------------------------------------
							Если (ВысотаСтеллажа-144-56)-Цел((ВысотаСтеллажа-144-56)/600)*600=500 Тогда
								КолвоПрямыхРаскосов=КолвоПрямыхРаскосов+1;
								КолвоКрепежа = КолвоКрепежа + 1;
							КонецЕсли;
							
						КонецЕсли;
						
						СтрокаЦены = ТЗ_Цены.Найти("Раскос СЕТ" + ОкраскаСтр + " (100.1.5)", "Номенклатура");
						ЦенаРаскоса = СтрокаЦены.Цена;
						
						СтруктураПараметров.Вставить("КолвоКрепежа", КолвоКрепежа);
						СтруктураПараметров.Вставить("КолвоПрямыхРаскосов", КолвоПрямыхРаскосов);
						СтруктураПараметров.Вставить("КолвоКосыхРаскосов", КолвоКосыхРаскосов);
						
						СуммаПрямыхРаскосов = Окр(ЦенаРаскоса*КолвоПрямыхРаскосов*ДлинаПрямогоРаскоса/1000, 2);
						СуммаКосыхРаскосов = Окр(ЦенаРаскоса*КолвоКосыхРаскосов*ДлинаКосогоРаскоса/1000, 2);
						СтруктураПараметров.Вставить("СуммаПрямыхРаскосов", СуммаПрямыхРаскосов);
						СтруктураПараметров.Вставить("СуммаКосыхРаскосов", СуммаКосыхРаскосов);
						
						//	Некатаные элементы рам (КРЕПЕЖ)
						k2 = (ВысотаСтеллажа - 200)/600 = Цел((ВысотаСтеллажа - 200)/600);
						//  1. Определяем кол-во элементов Винт М8х55
						Если ВариантИсполнения = "Вариант 1" Тогда
							КолвоВинтовМ8х55 = КолвоКосыхРаскосов + 3 + ?(k2,0,1);	
						Иначе
							КолвоВинтовМ8х55 = КолвоКосыхРаскосов + 1 + ?(k2,0,1);	
						КонецЕсли;
						
						//  2. Определяем кол-во элементов Втулка 20
						КолвоВтулок20 = 2 + ?(k2,0,2);
						
						//  4. Определяем кол-во элементов Болт М8х35
						КолвоБолтовМ8х35 = 4;
						
						//  5. Определяем кол-во элементов Втулка М8
						//Если ПрофильСтойки = "70" Тогда
						//	КолвоВтулокМ8 = 0;
						//Иначе
							КолвоВтулокМ8 = 4;
						//КонецЕсли;
						
						//  6. Определяем кол-во элементов Шайба М8
						КолвоШайбМ8 = КолвоВинтовМ8х55*2 + КолвоБолтовМ8х35*2;
						
						//  7. Определяем кол-во элементов Гайка М8
						КолвоГаекМ8 = КолвоВинтовМ8х55 + КолвоБолтовМ8х35;
						
						СуммаКрепежа = КолвоБолтовМ8х35*ЦенаБолтовМ8х35 + КолвоВинтовМ8х55*ЦенаВинтовМ8х55 + КолвоШайбМ8*ЦенаШайбМ8 + КолвоГаекМ8*ЦенаГаекМ8 + КолвоВтулокМ8*ЦенаВтулокМ8;
						СуммаВтулок = КолвоВтулок20*ЦенаВтулок20;
						СуммаРамы = СуммаСтойки + СуммаПрямыхРаскосов + СуммаКосыхРаскосов + СуммаВтулок + СуммаКрепежа + СуммаПодпятников;
						
						СтруктураПараметров.Вставить("СуммаРамы"		, СуммаРамы);
						СтруктураПараметров.Вставить("КолвоВтулок"		, КолвоВтулок20);
						СтруктураПараметров.Вставить("СуммаВтулок"		, СуммаВтулок);
						СтруктураПараметров.Вставить("КолвоПодпятников"	, 2);
						СтруктураПараметров.Вставить("СуммаПодпятников"	, СуммаПодпятников);
						СтруктураПараметров.Вставить("СуммаКрепежа"		, СуммаКрепежа);
						СтруктураПараметров.Вставить("ВысотаСтеллажа"	, ВысотаСтеллажа);
						ОбластьСтрокаСтрока2.Параметры.Заполнить(СтруктураПараметров);
						ТабДок.Присоединить(ОбластьСтрокаСтрока2);
						
						Если НомСтроки = 30 Тогда
							ТабДок.Вывести(ОбластьСтрокаСтрока1);
						КонецЕсли;	
					КонецЦикла;
				КонецЦикла;		
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат ТабДок;
	
КонецФункции//СформироватьЦенаРамНаСервере()	

&НаСервере
Функция ЗаписьСтойкиВКомплектации(НЗ)
	
	Для каждого стр из НЗ цикл
		Если Найти(ВРег(стр.Комплектующая.Наименование), "СТОЙКА") > 0 тогда
			возврат стр;
		Конецесли;
	Конеццикла;
	
КонецФункции

&НаСервере
Функция ПоместитьТоварыВХранилище()
	
	Товары = Объект.Товары.Выгрузить();
	
	АдресТоваровВХранилище = ПоместитьВоВременноеХранилище(Товары, УникальныйИдентификатор);
	
	Возврат АдресТоваровВХранилище;
	
КонецФункции

