&НаСервере
Процедура ПодобратьПрофильНаСервере() 
	
	Если ПрофильРасчитывать = Ложь Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ПрофильТолщина = "2.0" Тогда
	НаименованиеПрофиля = "Профиль СЕТО (2.0) несущий";
	Иначе НаименованиеПрофиля = "Профиль СЕТО (1.5) несущий";
	КонецЕсли;
	
	Ключ = СокрЛП(Новый УникальныйИдентификатор);
	Если ПрофильШаг=0 тогда 
		ПрофильШаг = РамаГлубинаСтеллажа;
	КонецЕсли;
	Если ПрофильКоличество=0 Тогда
		ПрофильКоличество=1;
	КонецЕсли;
	Если ПрофильДлина=0 тогда 
		Возврат;
	КонецЕсли;
	Если ПрофильТолщина="" тогда 
		ПрофильТолщина="1.5";
		Возврат;
	КонецЕсли;
	
	
	ЕстьНеНайденныеКомплектующие = Ложь;
	Если НЕ ДобавитьКомплектующую(НаименованиеПрофиля, ПрофильДлина/1000, Ключ) Тогда
		ЕстьНеНайденныеКомплектующие = Истина;
	КонецЕсли;	

	Если ЕстьНеНайденныеКомплектующие Тогда
		Возврат;
	КонецЕсли;
	
	ВесПрофиля = 0;
	
	СтрокиКомплектующие = Комплектующие.НайтиСтроки(Новый Структура("ВнешнийКлюч", Ключ));
	
	Для каждого СтрокаКомплектующая Из СтрокиКомплектующие Цикл
		ВесПрофиля = ВесПрофиля + СтрокаКомплектующая.Вес;
	КонецЦикла;	
	НаименованиеПрофиля = "Профиль СЕТО " + формат(ПрофильДлина,"ЧГ=0") + " ("+ПрофильТолщина+") несущий (шаг "+формат(ПрофильШаг,"ЧГ=0")+")";
	СтрокаКомплект = Объект.Товары.Добавить();
	СтрокаКомплект.Наименование = НаименованиеПрофиля;
	СтрокаКомплект.Количество 	= ПрофильКоличество;
	СтрокаКомплект.Вес 			= ВесПрофиля;
	СтрокаКомплект.Ключ 		= Ключ;
	СтрокаКомплект.ЕдиницаИзмерения = "м.";
		
КонецПроцедуры//ПодобратьНастилНаСервере	


&НаСервере
Процедура ПодобратьПластиныНаСервере()
	
	Если НЕ УслугиКреплениеКПолу Тогда
		Возврат;
	КонецЕсли;	
	
	Ключ = СокрЛП(Новый УникальныйИдентификатор);
	
	КолвоРам = СекцииКоличествоПролетов1 + СекцииКоличествоПролетов2 + 1;
	КолвоБолтов = КолвоРам * 2;
	КолвоПластин = КолвоРам * 2;
	
	Если РамаПрофильСтойки = "70" Тогда
		НаименованиеПластины = "Выравнивающая пластина СЕТО 80/90";
	ИначеЕсли РамаПрофильСтойки = "85" Тогда
		НаименованиеПластины = "Выравнивающая пластина СЕТО 125/140";
	ИначеЕсли РамаПрофильСтойки = "100" Тогда
		НаименованиеПластины = "Выравнивающая пластина СЕТО 140/150";
	Иначе//Если РамаПрофильСтойки = "130" Тогда
		НаименованиеПластины = "Выравнивающая пластина СЕТО 155/155";
	КонецЕсли;
	
	ЕстьНеНайданныеКомплектующие = Ложь;
	
	Если НЕ ДобавитьКомплектующую(НаименованиеПластины, 1, Ключ) Тогда
		ЕстьНеНайданныеКомплектующие = Истина;
	КонецЕсли;	
	
	ВесПластин = 0;
	СтрокиКомплектующие = Комплектующие.НайтиСтроки(Новый Структура("ВнешнийКлюч", Ключ));
	
	Для каждого СтрокаКомплектующая Из СтрокиКомплектующие Цикл
		ВесПластин = ВесПластин + СтрокаКомплектующая.Вес;
	КонецЦикла;	
	
	СтрокаКомплект = Объект.Товары.Добавить();
	СтрокаКомплект.Наименование = НаименованиеПластины;
	СтрокаКомплект.Количество 	= КолвоПластин;
	СтрокаКомплект.Вес 			= ВесПластин;
	СтрокаКомплект.Ключ 		= Ключ;
	СтрокаКомплект.ЕдиницаИзмерения = "шт";
	СтрокаКомплект.Номенклатура	= Справочники.Номенклатура.НайтиПоНаименованию(НаименованиеПластины);
	
	Ключ = СокрЛП(Новый УникальныйИдентификатор);
	
	ЕстьНеНайданныеКомплектующие = Ложь;
	
	Если НЕ ДобавитьКомплектующую("12х100 анкер-болт с гайкой", 1, Ключ) Тогда
		ЕстьНеНайданныеКомплектующие = Истина;
	КонецЕсли;
	
	ВесАнкерБолтов = 0;
	СтрокиКомплектующие = Комплектующие.НайтиСтроки(Новый Структура("ВнешнийКлюч", Ключ));
	
	Для каждого СтрокаКомплектующая Из СтрокиКомплектующие Цикл
		ВесАнкерБолтов = ВесАнкерБолтов + СтрокаКомплектующая.Вес;
	КонецЦикла;	
	
	СтрокаКомплект = Объект.Товары.Добавить();
	СтрокаКомплект.Наименование = "12х100 анкер-болт с гайкой";
	СтрокаКомплект.Количество 	= КолвоБолтов;
	СтрокаКомплект.Вес 			= ВесАнкерБолтов;
	СтрокаКомплект.Ключ 		= Ключ;
	СтрокаКомплект.ЕдиницаИзмерения = "шт";
	СтрокаКомплект.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(СтрокаКомплект.Наименование); 
		
КонецПроцедуры//ПодобратьПластиныНаСервере	

&НаСервере
Процедура ЗаполнитьЦеныСуммы()
	
	Если Не ЗначениеЗаполнено(ВидЦены) Тогда
		Сообщить("Укажите вид цен. Цены не будут рассчитаны автоматически!");
		Возврат;
	КонецЕсли;
	
	// Определим товар, чтобы знать, надо ли считать коэффициент при длине балки больше 2700
	ТЗТоваров = Объект.Товары.Выгрузить();
	СтруктураКоэффициентовНаценки = КоэффициентыНаценки();
	//
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаЦен,
	|			ВидЦены = &ВидЦены
	|				И Номенклатура В (&СписокКомплектующих)) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("ДатаЦен", КонецДня(НаДату));
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("СписокКомплектующих", Комплектующие.Выгрузить(,"Номенклатура"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокиКомплектующие = Комплектующие.НайтиСтроки(Новый Структура("Номенклатура", Выборка.Номенклатура));
		Для каждого СтрокаКомплектующая Из СтрокиКомплектующие Цикл
			//
			стТЗ = ТЗТоваров.Найти(СтрокаКомплектующая.ВнешнийКлюч);
			Если стТЗ = неопределено тогда продолжить конецесли;
			Наименование = стТЗ.Наименование;
			//
			КоэффициентНаценки = 1;
			Если Найти(СтрокаКомплектующая.НаименованиеНоменклатуры, "Балка")>0 тогда
				СтруктураДлинаГрузоподъемность = СтруктураПараметровБалок();
				Если Найти(Наименование, СтруктураДлинаГрузоподъемность.Балка1) > 0 тогда
					КоэффициентНаценки = СтруктураКоэффициентовНаценки.Балка1;
				ИначеЕсли Найти(Наименование, СтруктураДлинаГрузоподъемность.Балка2) > 0 тогда
					КоэффициентНаценки = СтруктураКоэффициентовНаценки.Балка2;
				КонецЕсли;
			КонецЕсли;
			//
			СтрокаКомплектующая.Цена = Выборка.Цена*КоэффициентНаценки;
			СтрокаКомплектующая.Сумма = СтрокаКомплектующая.Цена * СтрокаКомплектующая.Количество;
		КонецЦикла;	
	КонецЦикла;	
	
	// проверяем нулевые цены комплектующих
	Для каждого СтрокаКомплектующая Из Комплектующие Цикл
		Если СтрокаКомплектующая["Цена"] = 0 тогда
			СтрокаКомплектующая["Цена"] = ЦенаКомплектующего(СтрокаКомплектующая["НаименованиеНоменклатуры"]);
			СтрокаКомплектующая["Сумма"] = СтрокаКомплектующая["Цена"]*СтрокаКомплектующая["Количество"];
		КонецЕсли;
	Конеццикла;
	
	// теперь надо рассчитать цену комплектов
	Для каждого СтрокаКомплект из Объект.Товары Цикл
		СтрокиКомплектующие = Комплектующие.НайтиСтроки(Новый Структура("ВнешнийКлюч", СтрокаКомплект.Ключ));
		//ГТС 18.01 изменение расчета цен-сумм
		СтрокаКомплект.Цена=0;
		СтрокаКомплект.Сумма = 0;
		Для каждого СтрокаКомплектующая Из СтрокиКомплектующие Цикл
			СтрокаКомплект.Цена = СтрокаКомплект.Цена + СтрокаКомплектующая.Сумма;
		КонецЦикла;	
		СтрокаКомплект.Цена = Окр(СтрокаКомплект.Цена);
		СтрокаКомплект.Сумма = Окр(СтрокаКомплект.Цена * СтрокаКомплект.Количество,0);
	КонецЦикла;
	
	СуммаТоваров = Объект.Товары.Итог("Сумма");
	
	// расчет услуг
	Если УслугиНеобходимаСборкаИУстановкаСтеллажей и УслугиПроцентСборкаИУстановкаСтеллажей <> 0 Тогда
		СтрокаУслуга = Объект.Товары.Добавить();
		СтрокаУслуга.Наименование = "Услуги по сборке и установке стеллажей";
		СтрокаУслуга.Количество = УслугиПроцентСборкаИУстановкаСтеллажей;
		СтрокаУслуга.ЕдиницаИзмерения = "%";
		СтрокаУслуга.Сумма = Окр(СуммаТоваров * УслугиПроцентСборкаИУстановкаСтеллажей / 100, 0);
		СуммаТоваров = СуммаТоваров + Окр(СуммаТоваров * УслугиПроцентСборкаИУстановкаСтеллажей / 100, 0);
	КонецЕсли;
	
	// расчет скидки
	Если УслугиПредоставитьСкидки и УслугиПроцентСкидки <> 0 Тогда
		СтрокаУслуга = Объект.Товары.Добавить();
		СтрокаУслуга.Наименование = ?(УслугиПроцентСкидки > 0 ,"Скидка", "Наценка");
		СтрокаУслуга.Количество = ?(УслугиПроцентСкидки > 0, УслугиПроцентСкидки, -УслугиПроцентСкидки);
		СтрокаУслуга.ЕдиницаИзмерения = "%";
		СтрокаУслуга.Сумма = -Окр(СуммаТоваров * УслугиПроцентСкидки / 100, 0);
	КонецЕсли;	
	
КонецПроцедуры//ЗаполнитьЦеныСуммы	

