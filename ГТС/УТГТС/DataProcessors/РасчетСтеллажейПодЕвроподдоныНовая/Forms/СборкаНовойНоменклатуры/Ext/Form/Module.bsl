				Комплектующая = НовКомпл.Ссылка;
				МассивДляРасчетаВеса.Добавить(Комплектующая);
				СтрТЗ.Номенклатура = Комплектующая;
				СтрТЗ.Статус = "<имеется>";
			Иначе
				Комплектующая = СтрТЗ.Номенклатура;
			Конецесли;
			НовСтр = Нов.Товары.Добавить();
			НовСтр.Номенклатура = Комплектующая;
			НовСтр.Количество = СтрТЗ.Количество;
			НовСтр.КоличествоУпаковок = НовСтр.Количество;
			//ищем шайбу
			Если комплектующая=Справочники.Номенклатура.НайтиПоКоду("0--00000037") Тогда
				Нов.НоменклатураОсновногоКомпонента=комплектующая;
			КонецЕсли;
		Конеццикла;
		Нов.Записать();
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создали комплектацию номенклатуры: "+НоменклатураСЕТ.Наименование);
	Конецесли;
	// Комплектация ГТС
	Если Не ЗначениеЗаполнено(НаборГТС)
		И ЗначениеЗаполнено(НоменклатураГТС) тогда
		Нов = Справочники.ВариантыКомплектацииНоменклатуры.СоздатьЭлемент();
		Нов.Владелец = НоменклатураГТС;
		Нов.Наименование = "Основная комплектация";
		Нов.Основной = Истина;
		//
		Для каждого СтрТЗ из КомплектацияГТС цикл
			Если СтрТЗ.Статус = "<к созданию>"
				И ЗначениеЗаполнено(СтрТЗ.Группа) тогда
				ЭлементДляКопии = ЭлементыГруппыНоменклатуры(СтрТЗ.Группа);
				НовКомпл = ЭлементДляКопии.Скопировать();
				НовКомпл.Наименование = СтрТЗ.Номенклатура;
				НовКомпл.НаименованиеПолное = СтрТЗ.Номенклатура;
				НовКомпл.ВесЧислитель = Вес;
				НовКомпл.ВесИспользовать = Истина;
				НовКомпл.ВесЗнаменатель = 1;
				//НовКомпл.Количество=1;
				//НовКомпл.КоличествоУпаковок=1;
				//НовКомпл.СхемаОбеспечения=Справочники.СхемыОбеспечения.НайтиПоНаименованию("Промсвязь, паллетка");
				попытка
				НовКомпл.Записать();
				исключение
			//	сообщить("не удалось записать " + НовКомпл.НаименованиеПолное + " для позиции " +Нов.Владелец);  
				конецпопытки;
				//ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создали элемент номенклатуры: "+НовКомпл.Наименование);
				//
				Комплектующая = НовКомпл.Ссылка;
				МассивДляРасчетаВеса.Добавить(Комплектующая);
				СтрТЗ.Номенклатура = Комплектующая;
				СтрТЗ.Статус = "<имеется>";
			Иначе
				Комплектующая = СтрТЗ.Номенклатура;
			Конецесли;
			НовСтр = Нов.Товары.Добавить();
			НовСтр.Номенклатура = Комплектующая;
			НовСтр.Количество = СтрТЗ.Количество;
			НовСтр.КоличествоУпаковок = НовСтр.Количество;
		Конеццикла;
		попытка
		Нов.Записать();
		исключение 
		конецпопытки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создали комплектацию номенклатуры: "+НоменклатураГТС.Наименование);
	Конецесли;
	//
	СоответствиеГТС = Альтерлого.СоответствиеНоменклатуры(НоменклатураСЕТ);
	Если НЕ ЗначениеЗаполнено(СоответствиеГТС) 
		И ЗначениеЗаполнено(НоменклатураСЕТ)
		И ЗначениеЗаполнено(НоменклатураГТС) тогда
		Рег = РегистрыСведений.СоответствиеНоменклатурыСЕТ_ГТС.СоздатьМенеджерЗаписи();
		Рег.НоменклатураГТС = НоменклатураГТС;
		Рег.НоменклатураСЕТ = НоменклатураСЕТ;
		Рег.Записать();
	КонецЕсли;	
