				//НовКомпл.КоличествоУпаковок=1;
				//НовКомпл.СхемаОбеспечения=Справочники.СхемыОбеспечения.НайтиПоНаименованию("Промсвязь, паллетка");
				НовКомпл.Записать();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создали элемент номенклатуры: "+НовКомпл.Наименование);
