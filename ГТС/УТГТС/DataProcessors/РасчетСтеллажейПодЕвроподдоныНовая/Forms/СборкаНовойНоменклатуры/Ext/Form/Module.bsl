				НовКомпл.Наименование = СтрТЗ.Номенклатура;
				НовКомпл.НаименованиеПолное = СтрТЗ.Номенклатура;
				НовКомпл.ВесЧислитель = 0;
				НовКомпл.ВесЗнаменатель = 1;
