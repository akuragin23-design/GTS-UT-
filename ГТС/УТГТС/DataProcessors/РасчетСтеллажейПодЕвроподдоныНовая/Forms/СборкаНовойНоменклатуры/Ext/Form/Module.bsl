			Иначе
			Нов.Владелец = НоменклатураСЕТ;
			Нов.Наименование = "Основная комплектация";
			Нов.Основной = Истина;

			КонецЕсли;

		
		//
		Для каждого СтрТЗ из КомплектацияСЕТ цикл
			Если СтрТЗ.Статус = "<к созданию>"
				И ЗначениеЗаполнено(СтрТЗ.Группа) тогда
				ЭлементДляКопии = ЭлементыГруппыНоменклатуры(СтрТЗ.Группа);
