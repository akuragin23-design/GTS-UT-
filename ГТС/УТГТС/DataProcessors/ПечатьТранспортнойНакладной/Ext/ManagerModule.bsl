Функция РеквизитОтветственного(Ссылка)
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РеализацияТоваровУслуг") ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.КорректировкаРеализации") тогда
		возврат "Менеджер";
	Иначе
		возврат "Ответственный";
	Конецесли;
	
КонецФункции

Функция ПолучитьВерхнююГруппуНоменклатуры(Знач Группа)
	
	Пока истина цикл		
		Если Группа.Родитель = Справочники.Номенклатура.ПустаяСсылка() тогда
			возврат Группа;
		КонецЕсли;
		//
		Группа = Группа.Родитель;
	Конеццикла;
	
КонецФункции

Функция НаименованиеГрузов(Массив)
	
	Текст = "";
	Для каждого е из Массив цикл
		Текст = Текст + е.Наименование + ", ";
	Конеццикла;
	
	возврат Текст;
	
КонецФункции

