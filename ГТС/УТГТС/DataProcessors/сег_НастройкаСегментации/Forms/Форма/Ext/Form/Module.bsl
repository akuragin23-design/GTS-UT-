&НаКлиенте
Процедура Записать(Команда)

	лТекДанные	= Элементы.Подразделения.ТекущиеДанные;
	
	Если лТекДанные = Неопределено Тогда
	
		лПодразделение = ПредопределенноеЗначение("Справочник.СтруктураПредприятия.ПустаяСсылка");
		
	Иначе
		
		лПодразделение	= лТекДанные.ПодразделениеСсылка;
	
	КонецЕсли;
	
	Если СохранитьПрограммыСегментации(лПодразделение) Тогда
		Сообщить("Изменения сохранены!");
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Функция СохранитьПрограммыСегментации(пПодразделение)

	НачатьТранзакцию();
	
	Попытка
		ЗаполнитьПоказателиПрограммы(пПодразделение, Справочники.сег_Сегменты.МаркетинговыйСегмент);
		ЗаполнитьПоказателиПрограммы(пПодразделение, Справочники.сег_Сегменты.ОборотныйСегмент);
		ЗаполнитьПоказателиПрограммы(пПодразделение, Справочники.сег_Сегменты.СегментПоЧастотеЗаказов);
	Исключение
		
		Сообщить("Не удалось записать значения! " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		Возврат Ложь;
		
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	Возврат Истина;
	
КонецФункции // СохранитьПрограммыСегментации()

&НаСервере
Функция ЗаполнитьПоказателиПрограммы(пПодразделение, пВидСегмента)

	нз = РегистрыСведений.сег_ПоказателиСегментов.СоздатьНаборЗаписей();
	нз.Отбор.ВидСегмента.Установить(пВидСегмента);
	нз.Отбор.Подразделение.Установить(пПодразделение);
		
	Если пВидСегмента = Справочники.сег_Сегменты.МаркетинговыйСегмент Тогда
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.ПервичныйКлиент;
		стр.Показатель2 = ПервичныйКлиентПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.НовыйКлиент;
		стр.Показатель1 = НовыйКлиентПоказатель1;
		стр.Показатель2 = НовыйКлиентПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.СтарыйКлиент;
		стр.Показатель1 = СтарыйКлиентПоказатель1;
		стр.Показатель3 = СтарыйКлиентПоказатель3;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.ПостоянныйКлиент;
		стр.Показатель1 = ПостоянныйКлиентПоказатель1;
		стр.Показатель3 = ПостоянныйКлиентПоказатель3;
		стр.Показатель4 = УснувшийКлиентПоказатель4;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.УснувшийКлиент;
		стр.Показатель1 = УснувшийКлиентПоказатель1;
		стр.Показатель3 = УснувшийКлиентПоказатель3;
		стр.Показатель4 = УснувшийКлиентПоказатель4;
	
	ИначеЕсли пВидСегмента = Справочники.сег_Сегменты.ОборотныйСегмент Тогда
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.Маленький;
		стр.Показатель2 = МаленькийПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.Средний;
		стр.Показатель1 = СреднийПоказатель1;
		стр.Показатель2 = СреднийПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.Большой;
		стр.Показатель1 = БольшойПоказатель1;
		стр.Показатель2 = БольшойПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.ОченьБольшой;
		стр.Показатель1 = ОченьБольшойПоказатель1;
		
	ИначеЕсли пВидСегмента = Справочники.сег_Сегменты.СегментПоЧастотеЗаказов Тогда
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.Редко;
		стр.Показатель2 = РедкоПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.Средне;
		стр.Показатель1 = СреднеПоказатель1;
		стр.Показатель2 = СреднеПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.Часто;
		стр.Показатель1 = ЧастоПоказатель1;
		стр.Показатель2 = ЧастоПоказатель2;
		
		стр = нз.Добавить();
		стр.Сегмент = Справочники.сег_Сегменты.ОченьЧасто;
		стр.Показатель1 = ОченьЧастоПоказатель1;
		
	КонецЕсли;
	
	Для Каждого стр Из нз Цикл
		стр.ВидСегмента = пВидСегмента;
		стр.Подразделение = пПодразделение;
	КонецЦикла;
	
	нз.Записать();
КонецФункции // ЗаполнитьПоказателиПрограммы()
