&НаКлиенте
Процедура ПодразделенияПриАктивизацииСтроки(Элемент)
	
	лТекДанные	= Элементы.Подразделения.ТекущиеДанные;
	
	Если лТекДанные = Неопределено Тогда
	
		лПодразделение = ПредопределенноеЗначение("Справочник.СтруктураПредприятия.ПустаяСсылка");
		
	Иначе
		
		лПодразделение	= лТекДанные.ПодразделениеСсылка;
	
	КонецЕсли;
	
	ОтобразитьПрограммыСегментации(лПодразделение);
	
КонецПроцедуры

&НаСервере
Функция ОтобразитьПрограммыСегментации(пПодразделение)

	НачатьТранзакцию();
	
	Попытка
		ОтобразитьПоказателиПрограммы(пПодразделение, Справочники.сег_Сегменты.МаркетинговыйСегмент);
		ОтобразитьПоказателиПрограммы(пПодразделение, Справочники.сег_Сегменты.ОборотныйСегмент);
		ОтобразитьПоказателиПрограммы(пПодразделение, Справочники.сег_Сегменты.СегментПоЧастотеЗаказов);
	Исключение
		
		//Сообщить("Не удалось записать значения! " + ОписаниеОшибки());
		ОтменитьТранзакцию();
		Возврат Ложь;
		
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	Возврат Истина;
	
КонецФункции // ОтобразитьПрограммыСегментации()

&НаСервере
Функция ОтобразитьПоказателиПрограммы(пПодразделение, пВидСегмента)
	
	нз = РегистрыСведений.сег_ПоказателиСегментов.СоздатьНаборЗаписей();
	нз.Отбор.ВидСегмента.Установить(пВидСегмента);
	нз.Отбор.Подразделение.Установить(пПодразделение);
	нз.Прочитать();
	
	Если пВидСегмента = Справочники.сег_Сегменты.МаркетинговыйСегмент Тогда
		ПервичныйКлиентПоказатель2 = 0;
		НовыйКлиентПоказатель1 = 0;
		НовыйКлиентПоказатель2 = 0;
		СтарыйКлиентПоказатель1 = 0;
		СтарыйКлиентПоказатель3 = 0;
		ПостоянныйКлиентПоказатель1 = 0;
		ПостоянныйКлиентПоказатель3 = 0;
		УснувшийКлиентПоказатель1 = 0;
		УснувшийКлиентПоказатель3 = 0;
		УснувшийКлиентПоказатель4 = 0;
		
		Для Каждого стр Из нз Цикл
			Если стр.Сегмент = Справочники.сег_Сегменты.ПервичныйКлиент Тогда
				ПервичныйКлиентПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.НовыйКлиент Тогда
				НовыйКлиентПоказатель1 = стр.Показатель1;
				НовыйКлиентПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.СтарыйКлиент Тогда
				СтарыйКлиентПоказатель1 = стр.Показатель1;
				СтарыйКлиентПоказатель3 = стр.Показатель3;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.ПостоянныйКлиент Тогда
				ПостоянныйКлиентПоказатель1 = стр.Показатель1;
				ПостоянныйКлиентПоказатель3 = стр.Показатель3;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.УснувшийКлиент Тогда
				УснувшийКлиентПоказатель1 = стр.Показатель1;
				УснувшийКлиентПоказатель3 = стр.Показатель3;
				УснувшийКлиентПоказатель4 = стр.Показатель4;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли пВидСегмента = Справочники.сег_Сегменты.ОборотныйСегмент Тогда
		МаленькийПоказатель2 = 0;
		СреднийПоказатель1 = 0;
		СреднийПоказатель2 = 0;
		БольшойПоказатель1 = 0;
		БольшойПоказатель2 = 0;
		ОченьБольшойПоказатель1 = 0;
		
		Для Каждого стр Из нз Цикл
			Если стр.Сегмент = Справочники.сег_Сегменты.Маленький Тогда
				МаленькийПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.Средний Тогда
				СреднийПоказатель1 = стр.Показатель1;
				СреднийПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.Большой Тогда
				БольшойПоказатель1 = стр.Показатель1;
				БольшойПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.ОченьБольшой Тогда
				ОченьБольшойПоказатель1 = стр.Показатель1;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли пВидСегмента = Справочники.сег_Сегменты.СегментПоЧастотеЗаказов Тогда
		РедкоПоказатель2 = 0;
		СреднеПоказатель1 = 0;
		СреднеПоказатель2 = 0;
		ЧастоПоказатель1 = 0;
		ЧастоПоказатель2 = 0;
		ОченьЧастоПоказатель1 = 0;
		
		Для Каждого стр Из нз Цикл
			Если стр.Сегмент = Справочники.сег_Сегменты.Редко Тогда
				РедкоПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.Средне Тогда
				СреднеПоказатель1 = стр.Показатель1;
				СреднеПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.Часто Тогда
				ЧастоПоказатель1 = стр.Показатель1;
				ЧастоПоказатель2 = стр.Показатель2;
			ИначеЕсли стр.Сегмент = Справочники.сег_Сегменты.ОченьЧасто Тогда
				ОченьЧастоПоказатель1 = стр.Показатель1;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецФункции // ОтобразитьПоказателиПрограммы()

