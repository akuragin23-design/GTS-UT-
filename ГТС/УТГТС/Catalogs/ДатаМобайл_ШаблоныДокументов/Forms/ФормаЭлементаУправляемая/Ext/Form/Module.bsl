&НаСервере
Функция ПроверитьВозможностьАдресногоХранения(Вид, ШаблонДокумента, ИмяТЧПодбор, ИмяТчПриемка)
	
	Попытка 
		
		Если ШаблонДокумента = "" Тогда
			Возврат Истина;
		КонецЕсли;
		
		МетаданныеТекущегоДокумента = Метаданные.документы[ШаблонДокумента];
		
		ЕстьРеквизитЗонаОтгрузкиШапка =  НЕ МетаданныеТекущегоДокумента.Реквизиты.Найти("ЗонаОтгрузки") = Неопределено; 
		ЕстьРеквизитЗонаХраненияШапка = НЕ МетаданныеТекущегоДокумента.Реквизиты.Найти("ЗонаХранения") = Неопределено;; 
		ЕстьРеквизитЯчейкаШапка =  НЕ МетаданныеТекущегоДокумента.Реквизиты.Найти("Ячейка") = Неопределено;
		ЕстьРеквизитЗонаДоставкиШапка = НЕ МетаданныеТекущегоДокумента.Реквизиты.Найти("ЗонаДоставки") = Неопределено; 
		
		Если Вид = "Подбор" И Объект.ИспользованиеЯчеекПодбор > 0 Тогда
			
			Если Объект.ИмяТабличнойЧастиПодбор <> "" Тогда
				ЕстьРеквизитЯчейкаТЧ = ?(МетаданныеТекущегоДокумента.табличныеЧасти[ИмяТЧПодбор].Реквизиты.Найти("Ячейка") = Неопределено, ЛОЖЬ, Истина);  
				ЕстьРеквизитЗонаХраненияТЧ = ?(МетаданныеТекущегоДокумента.табличныеЧасти[ИмяТЧПодбор].Реквизиты.Найти("ЗонаХранения") = Неопределено, ЛОЖЬ, Истина);
				ЕстьРеквизитЗонаОтгрузкиТЧ = ?(МетаданныеТекущегоДокумента.табличныеЧасти[ИмяТЧПодбор].Реквизиты.Найти("ЗонаОтгрузки") = Неопределено, ЛОЖЬ, Истина);
			Иначе		
				ЕстьРеквизитЯчейкаТЧ = ЛОЖЬ;
				ЕстьРеквизитЗонаХраненияТЧ = Истина;
				ЕстьРеквизитЗонаОтгрузкиТЧ = Истина;
			КонецЕсли;
			
		ИначеЕсли Вид = "Приемка" И  Объект.ИспользованиеЯчеекПриемка > 0 Тогда
			
			Если Объект.ИмяТабличнойЧастиПриемка <> "" Тогда
				
				ЕстьРеквизитЯчейкаТЧ = ?(МетаданныеТекущегоДокумента.табличныеЧасти[ИмяТчПриемка].Реквизиты.Найти("Ячейка") = Неопределено, ЛОЖЬ, Истина);  
				ЕстьРеквизитЗонаХраненияТЧ = ?(МетаданныеТекущегоДокумента.табличныеЧасти[ИмяТчПриемка].Реквизиты.Найти("ЗонаХранения") = Неопределено, ЛОЖЬ, Истина);
				ЕстьРеквизитЗонаОтгрузкиТЧ = ?(МетаданныеТекущегоДокумента.табличныеЧасти[ИмяТчПриемка].Реквизиты.Найти("ЗонаОтгрузки") = Неопределено, ЛОЖЬ, Истина);
			Иначе
				ЕстьРеквизитЯчейкаТЧ = Истина;
				ЕстьРеквизитЗонаХраненияТЧ = Истина;
				ЕстьРеквизитЗонаОтгрузкиТЧ = Истина;
			КонецЕсли;
			
		Иначе
			
			ЕстьРеквизитЯчейкаТЧ = Истина;
			ЕстьРеквизитЗонаХраненияТЧ = Истина;
			ЕстьРеквизитЗонаОтгрузкиТЧ = Истина;
			
		КонецЕсли;
		
		Если ЕстьРеквизитЗонаХраненияШапка ИЛИ ЕстьРеквизитЯчейкаШапка ИЛИ ЕстьРеквизитЯчейкаТЧ ИЛИ ЕстьРеквизитЗонаХраненияТЧ ИЛИ ЕстьРеквизитЗонаОтгрузкиТЧ ИЛИ ЕстьРеквизитЗонаОтгрузкиШапка ИЛИ ЕстьРеквизитЗонаДоставкиШапка Тогда	
			
			Возврат Истина;
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
	Исключение 
		
		Возврат Истина;		
		
	КонецПопытки;
	
КонецФункции
&НаСервере
Процедура ПроверкаАдресногоХранения() 
	ЯчейкаЕсть = Ложь;
	Если Объект.ВидДокументаНового <> "" Тогда
		МетаДок = Метаданные.Документы.Найти(Объект.ВидДокументаНового);
		Если Объект.ВидДокументаНового <> "ОтборРазмещениеТоваров" Тогда
			Для Каждого стр Из Метадок.ТабличныеЧасти.Товары.Реквизиты Цикл
				Если стр.Имя = "Ячейка" Тогда
					ЯчейкаЕсть = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
		Иначе 
			Для Каждого стр Из Метадок.ТабличныеЧасти.ТоварыОтбор.Реквизиты Цикл
				Если стр.Имя = "Ячейка" Тогда
					ЯчейкаЕсть = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;	
	
	МетаДок = Метаданные.Документы.Найти(Объект.ВидДокумента);
	
	Если Объект.ВидДокумента = "ПеремещениеТоваров" И Объект.БыстроеПеремещение <> 0 Тогда
		ЯчейкаЕсть = Истина;	
	ИначеЕсли Объект.ВидДокумента <> "ОтборРазмещениеТоваров" Тогда
		Для Каждого стр Из Метадок.ТабличныеЧасти.Товары.Реквизиты Цикл
			Если стр.Имя = "Ячейка" Тогда
				ЯчейкаЕсть = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	Иначе 
		Для Каждого стр Из Метадок.ТабличныеЧасти.ТоварыОтбор.Реквизиты Цикл
			Если стр.Имя = "Ячейка" Тогда
				ЯчейкаЕсть = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;

	КонецЕсли;
	
	// документы - исключения
	Если Объект.ВидДокумента = "ПриходныйОрдерНаТовары" или Объект.ВидДокументаНового = "ПриходныйОрдерНаТовары"
		или Объект.ВидДокумента = "РасходныйОрдерНаТовары" или Объект.ВидДокументаНового = "РасходныйОрдерНаТовары" Тогда
		
		ЯчейкаЕсть = Истина;
	КонецЕсли; 
	
	ИспПодбор  = Объект.ИспользоватьПодбор;
	ИспПриемку = Объект.ИспользоватьПриемку;
	
	Если ЯчейкаЕсть Тогда
		Элементы.ИспользованиеЯчеекПодбор.Доступность = ИспПодбор;	
		Элементы.УчитыватьЯчеекВЗаданииПодбор.Доступность = ИспПодбор;
		Элементы.ОбработкаЯчейкиЦеликомПодбор.Доступность = ИспПодбор;
		Элементы.ЗагружатьCписокЯчеекССервераПодбор.Доступность = (ИспПодбор и НЕ Объект.ЯчейкиСправочноеРазмещениеПодбор); 
		Элементы.ВыгрузкаЯчеекПодбор.Доступность = ИспПодбор;
		
		Элементы.ИспользованиеЯчеекПриемка.Доступность = ИспПриемку;	
		Элементы.УчитыватьЯчеекВЗаданииПриемка.Доступность = ИспПриемку;
		Элементы.ОбработкаЯчейкиЦеликомПриемка.Доступность = ИспПриемку;
		Элементы.ЗагружатьCписокЯчеекССервераПриемка.Доступность = (ИспПриемку и НЕ Объект.ЯчейкиСправочноеРазмещениеПриемка); 
		Элементы.ВыгрузкаЯчеекПриемка.Доступность = ИспПриемку;

	Иначе 
		Элементы.ИспользованиеЯчеекПодбор.Доступность = Ложь;
		Элементы.УчитыватьЯчеекВЗаданииПодбор.Доступность = Ложь;
		Элементы.ОбработкаЯчейкиЦеликомПодбор.Доступность = Ложь;
		Элементы.ЗагружатьCписокЯчеекССервераПодбор.Доступность = Ложь; 
		Элементы.ВыгрузкаЯчеекПодбор.Доступность = Ложь;
		
		Элементы.ИспользованиеЯчеекПриемка.Доступность = Ложь;	
		Элементы.УчитыватьЯчеекВЗаданииПриемка.Доступность = Ложь;
		Элементы.ОбработкаЯчейкиЦеликомПриемка.Доступность = Ложь;
		Элементы.ЗагружатьCписокЯчеекССервераПриемка.Доступность = Ложь; 
		Элементы.ВыгрузкаЯчеекПриемка.Доступность = Ложь;
				
		Попытка
			Если Объект.ИспользованиеЯчеекПодбор<>0  тогда 				
				Объект.ИспользованиеЯчеекПодбор=0;			
			КонецЕсли;
			
			Если Объект.УчитыватьЯчеекВЗаданииПодбор тогда 				
				Объект.УчитыватьЯчеекВЗаданииПодбор=Ложь;			
			КонецЕсли;

			Если Объект.ОбработкаЯчейкиЦеликомПодбор тогда 				
				Объект.ОбработкаЯчейкиЦеликомПодбор=Ложь;			
			КонецЕсли;

			Если Объект.ЗагружатьCписокЯчеекССервераПодбор тогда 				
				Объект.ЗагружатьCписокЯчеекССервераПодбор=Ложь;			
			КонецЕсли;

			Если Объект.ВыгрузкаЯчеекПодбор<>0 тогда 				
				Объект.ВыгрузкаЯчеекПодбор=0;			
			КонецЕсли;

			Если Объект.ИспользованиеЯчеекПриемка<>0  тогда 				
				Объект.ИспользованиеЯчеекПриемка=0;			
			КонецЕсли;
			
			Если Объект.УчитыватьЯчеекВЗаданииПриемка тогда 				
				Объект.УчитыватьЯчеекВЗаданииПриемка=Ложь;			
			КонецЕсли;

			Если Объект.УчитыватьЯчеекВЗаданииПриемка тогда 				
				Объект.УчитыватьЯчеекВЗаданииПриемка=Ложь;			
			КонецЕсли;

			Если Объект.ЗагружатьCписокЯчеекССервераПриемка тогда 				
				Объект.ЗагружатьCписокЯчеекССервераПриемка=Ложь;			
			КонецЕсли;

			Если Объект.ВыгрузкаЯчеекПриемка<>0 тогда 				
				Объект.ВыгрузкаЯчеекПриемка=0;			
			КонецЕсли;

		Исключение КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры 
&НаКлиенте
Процедура РазвернутьГруппыГдеВыбраныПараметры()
	
	///////////////////////
	//ОБЩЕЕ
	Попытка
		Если Объект.ЗаполнениеТЧТолькоСобраннымиПозициямиПодбор
			или Объект.ЗаполнениеТЧТолькоСобраннымиЯчейкамиПодбор  тогда 
			
			Элементы.ГрБизнесПроцессы.Показать();
			Элементы.грПересчетТоваров.Показать();	
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ПроверкаОтборРазмещение
			или Объект.ПерезаполнятьРасходныйОрдерПоОтбору
			или ЗначениеЗаполнено(Объект.СтатусРасходногоОрдераПослеЗагрузкиОтбора) 
			или Объект.БыстраяПриемка
			или Объект.БыстраяОтгрузка тогда 
			
			Элементы.ГрБизнесПроцессы.Показать();
			Элементы.грДокументОтборРазмещениеТоваров.Показать();	
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ПерезаполнятьТЧТоварыПоРаспоряжениям тогда 
			
			Элементы.ГрБизнесПроцессы.Показать();
			Элементы.грДокументРасходныйОрдер.Показать();	
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ИспользоватьВторойСклад
			или Объект.БыстроеПеремещение<>0 тогда 
			
			Элементы.ГрБизнесПроцессы.Показать();
			Элементы.грДокументПеремещениеТоваров.Показать();	
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.БыстроеСканирование
			или Объект.СтоимостьЗаСтрокуДокумента<>0 
			или Объект.ТипБизнесПроцесса<>0 тогда 
			
			Элементы.ГрБизнесПроцессы.Показать();
			Элементы.грБизнесПроцессыПрочие.Показать();	
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.СоздаватьСерииЕслиНеНайдены
			или Объект.ЗагружатьСписокСерийССервера
			или Объект.КонтролироватьОстатокПоСериям 
			или Объект.СерииВОтдельнойТЧ тогда 
			
			Элементы.грСерии.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ГенерацияПаклистаНаСервере<>0 
			или Объект.РазрешитьПропускатьВводУпаковочногоЛиста 
			или Объект.ТабличнаяЧастьПриЗагрузкеУЛ<>0 тогда 
			
			Элементы.ГрУпаковочныеЛисты.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ЗапретитьРучноеИзменениеКлиента 
			или Объект.ЗапретитьРучноеИзменениеКомментария
			или Объект.ЗагружатьКомментарий<>0 
			или Объект.АвтоматическийКомментарийИспользовать 
			или Объект.АвтоматическийКомментарий<>"" тогда 
			
			Элементы.грКлиент.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ГрупповаяРабота 
			или Объект.ГрупповаяРаботаЗвуковоеОповещение 
			или Объект.ГрупповаяРаботаИнтервалОпроса<>0 тогда 
			
			Элементы.ГрМультиДок.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ИспользоватьГрупповойДокумент
			или Объект.МножествоДокументовКакЗадание 
			или Объект.ГрупповойДокумент 
			или Объект.ВыгружатьВыполненныйНаТСДДочернийДокументАвтоматически тогда 
			
			Элементы.грГрупповойДокумент.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	///////////////////////
	//ПОДБОР
	Попытка
		Если Объект.ИспользованиеЯчеекПодбор<>0
			или Объект.УчитыватьЯчеекВЗаданииПодбор			
			или Объект.ОбработкаЯчейкиЦеликомПодбор
			или Объект.ЗагружатьCписокЯчеекССервераПодбор
			или Объект.ВыгрузкаЯчеекПодбор<>0 тогда 
			
			Элементы.грАдрПодб.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ИспользованиеСерийниковПодбор<>0
			или Объект.УчитыватьСерийниковВЗаданииПодбор			
			или Объект.СерНомНеПустойПодбор
			или Объект.УникальныеСерийныеНомераПодбор
			или Объект.ПечатьЭтикеткиСерииПодбор тогда 
			
			Элементы.грСерПодб.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка 
		Если Объект.ИспользованиеУпаковочныхЛистовПодбор<>0
			или Объект.СоздаватьДокументыУпаковочныхЛистов
			или Объект.ИспользоватьТиповыеУпаковочныеЛисты
			или Объект.ПодборУпаковочнымиЛистами
			или Объект.ПроверкаУпаковочныхЛистовПоЗаданию тогда 
			
			Элементы.грУпакПодб.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ИспользоватьФотофиксациюПодбор
			или Объект.ПутьВыгрузкиИзображенияПодбор<>"" тогда 
			
			Элементы.грФотофиксацияПодбор.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	
	///////////////////////
	//РАЗМЕЩЕНИЕ	
	Попытка
		Если Объект.ИспользованиеЯчеекПриемка<>0
			или Объект.УчитыватьЯчеекВЗаданииПриемка			
			или Объект.ОбработкаЯчейкиЦеликомПриемка
			или Объект.ЗагружатьCписокЯчеекССервераПриемка
			или Объект.ВыгрузкаЯчеекПриемка<>0 тогда 
			
			Элементы.ГрАдрРазм.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ИспользованиеСерийниковПриемка<>0
			или Объект.УчитыватьСерийниковВЗаданииПриемка			
			или Объект.СерНомНеПустойПриемка
			или Объект.УникальныеСерийныеНомераПриемка тогда 
			
			Элементы.ГрСерРазм.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ИспользованиеУпаковочныхЛистовПриемка<>0 тогда 
			
			Элементы.ГрУпакРазм.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;
	
	Попытка
		Если Объект.ИспользоватьФотофиксациюПриемка
			или Объект.ПутьВыгрузкиИзображенияПриемка<>"" тогда 
			
			Элементы.грФотофиксацияПриемка.Показать();
			
		КонецЕсли;
	Исключение 
	КонецПопытки;		
		
КонецПроцедуры

#КонецОбласти


