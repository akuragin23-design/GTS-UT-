&НаСервере
Процедура ДобавитьСтрокуТовара(ТЗ, Товар, Количество, ВидЦен, Набор = Неопределено, ДобавитьСтроку, НомерСтроки = 999)
	
	//ASP_Crow 11.03.2026 000029567 В расширение
	//ASP_Dante 31/10/19
	Цен = ПолучитьЦены(Товар, ВидЦен);
	
	Если ДобавитьСтроку Тогда
		НовСтр=ТЗ.Добавить();
	ИначеЕсли Набор = Неопределено Тогда
		НовСтр = ТЗ.НайтиСтроки(Новый Структура("Номенклатура, НомерСтроки", Товар, НомерСтроки));
		Если НовСтр.Количество() > 0 Тогда
			НовСтр = НовСтр[0];
		Иначе
			Возврат;
		КонецЕсли;
	Иначе
		Стр = ТЗ.Найти(Набор, "Номенклатура");
		Если Не Стр = Неопределено Тогда
			ТЗ.Удалить(Стр);
		КонецЕсли;
		НовСтр=ТЗ.Добавить();
	КонецЕсли;
	
	НовСтр.Номенклатура = Товар;
	НовСтр.НоменклатураНабора = Набор;
	НовСтр.ИндексНабора=?(Набор = Неопределено,0,1);
	НовСтр.Количество = Количество;	 		
	НовСтр.Цена = Цен;
	НовСтр.Сумма = НовСтр.Цена * НовСтр.Количество;
	НДС=ПолучитьНДС(товар);
	НовСтр.СуммаНДС = НовСтр.Сумма * НДС;
	НовСтр.СтавкаНДС =  ЗаполнитьСтавкуНДС(Товар.СтавкаНДС);
	//ASP_Dante 31/10/19
	
КонецПроцедуры 


&НаСервере
Процедура ЗаполнитьНаборНоменклатуры(Набор, ТЗ, ВидЦен, ДобавитьСтроку, Количество=1) 
	//ASP_Crow 11.03.2026 000029567 В расширение

	//ASP_Dante 31/10/19	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВариантыКомплектацииНоменклатурыТовары.Номенклатура КАК Номенклатура,
		|	ВариантыКомплектацииНоменклатурыТовары.Количество КАК Количество
		|ИЗ
		|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ВариантыКомплектацииНоменклатурыТовары
		|ГДЕ
		|	ВариантыКомплектацииНоменклатурыТовары.Ссылка.Основной
		|	И НЕ ВариантыКомплектацииНоменклатурыТовары.Ссылка.ПометкаУдаления
		|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец = &НоменклатураОсновногоКомпонента
		|	И ВариантыКомплектацииНоменклатурыТовары.Ссылка.Владелец.ТипНоменклатуры = &ТипНоменклатуры";
	
	Запрос.УстановитьПараметр("НоменклатураОсновногоКомпонента", Набор);
	Запрос.УстановитьПараметр("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Набор);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДобавитьСтрокуТовара(ТЗ, Выборка.Номенклатура, Выборка.Количество*Количество, ВидЦен, Набор, ДобавитьСтроку);
	КонецЦикла;
	//ASP_Dante 31/10/19

КонецПроцедуры 

&НаКлиенте
Процедура ТоварыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)  
	//ASP_Crow 11.03.2026 000029567 В расширени
	
	//ASP_Dante 31/10/19
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Если Не ТекущиеДанные = Неопределено И ЗначениеЗаполнено(ТекущиеДанные.НоменклатураНабора) Тогда
		
		Соглашение = Объект.СоглашениеСКлиентом;
		
		ПараметрыНабора = Новый Структура;
        ПараметрыНабора.Вставить("НоменклатураНабора", ТекущиеДанные.НоменклатураНабора);
        ПараметрыНабора.Вставить("ХарактеристикаНабора", ПредопределенноеЗначение("Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка"));
        ПараметрыНабора.Вставить("КолонкиНабора", КолонкиНабора());
        ПараметрыНабора.Вставить("ИндексНабора",ТекущиеДанные.ИндексНабора);
        АдресНабораВоВременномХранилище = АдресНабораВоВременномХранилище(ПараметрыНабора);
        
        ПараметрыОткрытия = ПолучитьПараметрыФормыНабора(АдресНабораВоВременномХранилище, ТекущиеДанные.НоменклатураНабора, ТекущиеДанные.ИндексНабора, Соглашение, Объект.ДатаНачала, Объект.Ссылка);
        
        ОткрытьФорму("Обработка.РедактированиеНабора.Форма.Форма", ПараметрыОткрытия, ЭтаФорма, УникальныйИдентификатор);
		
	КонецЕсли;
	//ASP_Dante 31/10/19
	
