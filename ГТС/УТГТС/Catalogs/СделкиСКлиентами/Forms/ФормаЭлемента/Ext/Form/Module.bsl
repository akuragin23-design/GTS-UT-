Функция КоэффициентНаценки(Номенклатура) 
	//ASP_Crow 11.03.2026 000029567 В расширение
	Коэффициент = 1;
	Если Найти(ВРег(Номенклатура.Наименование), "БАЛКА")>0 тогда
		Профиль = АльтерЛого.ПрофильНоменклатуры(Номенклатура.Наименование);
		Структура = АльтерЛого.СтруктураПрофиляНоменклатуры(Профиль, Номенклатура.Наименование);
		Коэффициент = АльтерЛого.КоэффициентНаценкиНаНоменклатуруСБалкой(Структура.ДлинаБалки, Структура.ТолщинаМеталла, Структура.ВысотаПрофиля);
	КонецЕсли;
	возврат Коэффициент;
