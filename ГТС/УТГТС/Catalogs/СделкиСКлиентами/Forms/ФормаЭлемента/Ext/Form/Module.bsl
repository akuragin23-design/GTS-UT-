&НаКлиенте
Процедура ASP_ОтчетПоОстаткам(Команда) 
	//ASP_Crow 11.03.2026 000029567 В расширение
	СтрПараметры = Новый Структура;
    СтрПараметры.Вставить("Период", КонецДня(ТекущаяДата()));
        
    ПользовательскиеНастройки = УстановитьПользовательскиеНастройкиОтчета("ОстаткиПоСделке",СтрПараметры);
