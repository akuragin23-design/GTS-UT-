Функция ПолучитьПродажи() 
	//ASP_Crow 11.03.2026 000029567 В расширение
	НайденоПродаж = ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВыручкаИСебестоимостьПродаж.Подразделение КАК Подразделение,
