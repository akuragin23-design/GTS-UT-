&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)  
	//ASP_Crow 11.03.2026 000029567 В расширение
	
	Если ЗначениеЗаполнено(Параметры.Ключ) И ЗначениеЗаполнено(Объект.Партнер) Тогда
		Возврат;
	КонецЕсли;
	
	// пробуем найти по контактным данным клиентов
	НайтиКонтактыНаСервере();
	Если ASP_НайденныеКонтакты.Количество() > 0 Тогда
		ФормаВыбораКонтакта = ПолучитьФорму("Справочник.СделкиСКлиентами.Форма.ФормаВыбораКонтакта");
		Для каждого СтрокаКонтакта из ASP_НайденныеКонтакты Цикл
			НовСтрока = ФормаВыбораКонтакта.НайденныеКонтакты.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока, СтрокаКонтакта);
		КонецЦикла;
		РезультатВыбора = ФормаВыбораКонтакта.ОткрытьМодально();
		Если ЗначениеЗаполнено(РезультатВыбора) Тогда
			ДобавитьКонтактноеЛицоНаСервере(РезультатВыбора);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры
