&НаСервере
Функция ПолучитьЦены(Товар, ВидЦен) 
	//ASP_Crow 11.03.2026 000029567 В расширение
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ЦеныНоменклатурыСрезПоследних.Цена) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	0 КАК ВалЦена
	|ПОМЕСТИТЬ Подг
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Дат,
	|			Номенклатура = &Ном
	|				И ВидЦены = &ВидЦ) КАК ЦеныНоменклатурыСрезПоследних
	|ГДЕ
	|	ЦеныНоменклатурыСрезПоследних.Цена > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	СУММА(ЦеныНоменклатурыСрезПоследних.Цена * КурсыВалютСрезПоследних.Курс)
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Дат,
	|			Номенклатура = &Ном
	|				И ВидЦены = &ВидВЦ) КАК ЦеныНоменклатурыСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КурсыВалют.СрезПоследних(&Дат, ) КАК КурсыВалютСрезПоследних
	|		ПО ЦеныНоменклатурыСрезПоследних.Валюта = КурсыВалютСрезПоследних.Валюта
	|ГДЕ
	|	ЦеныНоменклатурыСрезПоследних.Цена > 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(Подг.Цена) КАК Цена,
	|	Подг.Номенклатура,
	|	МАКСИМУМ(Подг.ВалЦена) КАК ВалЦена
	|ИЗ
	|	Подг КАК Подг
	|
	|СГРУППИРОВАТЬ ПО
	|	Подг.Номенклатура";
	
	Запрос.УстановитьПараметр("ВидЦ", ВидЦен);//ASP_Dante 31/10/19Объект.СоглашениеСКлиентом.ВидЦен);
	Запрос.УстановитьПараметр("ВидВЦ", Справочники.ВидыЦен.НайтиПоНаименованию("Продажа в CNY"));
	
	Запрос.УстановитьПараметр("Дат", ТекущаяДата());
	Запрос.УстановитьПараметр("Ном", Товар);
	
	Цен = Запрос.Выполнить().Выгрузить();
	
	
	Цена=0;
	Если Цен.Количество()>0 Тогда
		Цена=Цен.Получить(0).ВалЦена;
		Если Цена=0 Тогда
			Цена=Цен.Получить(0).Цена;
		КонецЕсли;
		
	Иначе 
	Цена = 0;
	КонецЕсли;
	
		ЦенаПаллетка=0;
		Попытка
		Если АльтерЛого.РасчитатьЦенуПоКомплекту(Товар) тогда
		Коэффициент = КоэффициентНаценки(Товар);
		ЦенаПаллетка = АльтерЛого.ЦенаНоменклатурыПоКомплекту(Товар, ТекущаяДата(), ВидЦен, 0, Коэффициент);
		КонецЕсли;	
		Исключение
		ЦенаПаллетка=0;
		КонецПопытки;
		Если ЦенаПаллетка>0 и Цена=0 Тогда
		Цена=ЦенаПаллетка;
		КонецЕсли;

	Возврат Цена;
	
КонецФункции

