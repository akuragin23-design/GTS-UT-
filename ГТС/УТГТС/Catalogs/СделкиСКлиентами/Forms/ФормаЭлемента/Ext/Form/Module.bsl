	ASP_ТоварыВес = ОпределитьВесТовара(Товары);
	ASP_ТоварыОбъем=ОпределитьОбъемТовара(Товары);
	//ASP_Dante 30/08/19 
	//--ASP_Crow 11.03.2026 000029567 В расширени

КонецПроцедуры

