&НаСервереБезКонтекста
Функция ПолучитьПараметрыФормыНабора(АдресНабораВоВременномХранилище, НоменклатураНабора, ИндексНабора, Соглашение, ДатаНачала, Ссылка)
	//ASP_Crow 11.03.2026 000029567 В расширение
//ASP_Dante 31/10/19
	ПараметрыОткрытия = Новый Структура;                                        

	ПараметрыОткрытия.Вставить("АдресВоВременномХранилище", АдресНабораВоВременномХранилище);
	ПараметрыОткрытия.Вставить("НоменклатураНабора",  НоменклатураНабора);
	ПараметрыОткрытия.Вставить("ИндексНабора",  ИндексНабора);
	ПараметрыОткрытия.Вставить("ХарактеристикаНабора", Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка());
	ПараметрыОткрытия.Вставить("ЦенаВключаетНДС", Соглашение.ЦенаВключаетНДС);
	ПараметрыОткрытия.Вставить("НалогообложениеНДС", Соглашение.УдалитьНалогообложениеНДС);
	ПараметрыОткрытия.Вставить("Валюта", Соглашение.Валюта);
	ПараметрыОткрытия.Вставить("Соглашение", Соглашение);
	ПараметрыОткрытия.Вставить("Дата", ДатаНачала);
	ПараметрыОткрытия.Вставить("Ссылка", Ссылка);
	ПараметрыОткрытия.Вставить("Склад", Справочники.Склады.ПустаяСсылка());
	ПараметрыОткрытия.Вставить("СкрыватьКомандуОстаткиНаСкладах", Ложь);

	Возврат ПараметрыОткрытия;
//ASP_Dante 31/10/19	
КонецФункции

&НаСервере
Процедура ПриОкончанииРедактированияНабора(АдресВоВременномХранилище)   
	//ASP_Crow 11.03.2026 000029567 В расширение
	//ASP_Dante 31/10/19
	КэшированныеЗначения = ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения();
	
	СтруктураДействийСИзмененнымиСтроками = Новый Структура;	
	СтруктураДействийСДобавленнымиСтроками = Новый Структура;
	
	ПараметрыДанных = Новый Структура;
	ПараметрыДанных.Вставить("Данные", ПолучитьИзВременногоХранилища(АдресВоВременномХранилище));
	ПараметрыДанных.Вставить("СтруктураДействийСИзмененнымиСтроками", СтруктураДействийСИзмененнымиСтроками);
	ПараметрыДанных.Вставить("СтруктураДействийСДобавленнымиСтроками", СтруктураДействийСДобавленнымиСтроками);
	ПараметрыДанных.Вставить("КолонкиНабора", КолонкиНабора());
	
	НаборыСервер.ПриОкончанииРедактированияНабора(ЭтаФорма, "Товары", ПараметрыДанных);
	//ASP_Dante 31/10/19
