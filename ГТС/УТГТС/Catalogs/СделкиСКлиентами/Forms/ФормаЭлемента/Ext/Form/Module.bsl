&НаСервере
Функция ОпределитьВесТовара(Товары)
	//ASP_Crow 11.03.2026 000029567 В расширение
	Вес = 0;
	Для каждого Товар из Товары Цикл
		//Если Товар.ЭтоГруппа=Ложь Тогда
		если ?(ЗначениеЗаполнено(Товар.Номенклатура.ВесЗнаменатель),Товар.Номенклатура.ВесЗнаменатель,0) > 0 Тогда	
			Вес = Вес + Товар.Номенклатура.ВесЧислитель/Товар.Номенклатура.ВесЗнаменатель*Товар.Количество;
		иначе
			Вес = Вес + Товар.Номенклатура.ВесЧислитель/1;
		Конецесли;
		//Иначе
		//КонецЕсли;
	КонецЦикла;
	Возврат Вес;
	
КонецФункции

&НаСервере
Функция ОпределитьОбъемТовара(Товары) 
	//ASP_Crow 11.03.2026 000029567 В расширение
	Вес = 0;
	Для каждого Товар из Товары Цикл
		//Если Товар.ЭтоГруппа=Ложь Тогда
		если ?(ЗначениеЗаполнено(Товар.Номенклатура.ОбъемЗнаменатель),Товар.Номенклатура.ОбъемЗнаменатель,0) > 0 Тогда	
			Вес = Вес + Товар.Номенклатура.ОбъемЧислитель/Товар.Номенклатура.ОбъемЗнаменатель*Товар.Количество;
		иначе
			Вес = Вес + Товар.Номенклатура.ОбъемЧислитель/1;
		Конецесли;
		//Иначе
		//КонецЕсли;
	КонецЦикла;
	Возврат Вес;
	
КонецФункции


