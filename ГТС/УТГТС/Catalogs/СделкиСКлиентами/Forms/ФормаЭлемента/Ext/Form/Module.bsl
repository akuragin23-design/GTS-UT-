&НаСервере
Функция ЗаполнитьСтавкуНДС(Ставка)     
	//ASP_Crow 11.03.2026 000029567 В расширение
	Если Ставка = Справочники.СтавкиНДС.БезНДС Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;   
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("22%") Тогда
		Возврат Перечисления.СтавкиНДС.НДС22;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("22/122") Тогда
		Возврат Перечисления.СтавкиНДС.НДС22_122;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("20%") Тогда
		Возврат Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("20/120") Тогда
		Возврат Перечисления.СтавкиНДС.НДС20_120;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("10%") Тогда
		Возврат Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("10/110") Тогда
		Возврат Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("18%") Тогда
		Возврат Перечисления.СтавкиНДС.НДС18;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("18/118") Тогда
		Возврат Перечисления.СтавкиНДС.НДС18_118;
	ИначеЕсли Ставка = Справочники.СтавкиНДС.НайтиПоНаименованию("0%") Тогда
		Возврат Перечисления.СтавкиНДС.НДС0;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции


