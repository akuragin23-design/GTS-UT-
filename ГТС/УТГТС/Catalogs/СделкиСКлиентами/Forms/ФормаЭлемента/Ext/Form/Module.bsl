&НаСервере
Функция ПолучитьСписокКонтактныхЛицПартнераНаСервере()     
	//ASP_Crow 11.03.2026 000029567 В расширение
	
	ТипыКИ = Новый СписокЗначений;
	ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Другое);
	ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.ВебСтраница);
	ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Факс);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка,
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Наименование КАК Наименование,
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Представление,
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип КАК ТипКИ,
	|	КонтактныеЛицаПартнеровКонтактнаяИнформация.Вид КАК ВидКИ
	|ИЗ
	|	Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтактныеЛицаПартнеровКонтактнаяИнформация
	|ГДЕ
	|	(НЕ КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.ПометкаУдаления)
	|	И (КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.ДатаПрекращенияСвязи = &ПустаяДата
	|			ИЛИ КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.ДатаПрекращенияСвязи >= &ТекДата)
	|	И КонтактныеЛицаПартнеровКонтактнаяИнформация.Ссылка.Владелец = &Партнер
	|	И (НЕ КонтактныеЛицаПартнеровКонтактнаяИнформация.Тип В (&ТипыКИ))";
	Запрос.УстановитьПараметр("ТекДата", 	ТекущаяДата());
	Запрос.УстановитьПараметр("ПустаяДата", '00010101');
	Запрос.УстановитьПараметр("Партнер", 	Объект.Партнер);
	Запрос.УстановитьПараметр("ТипыКИ",     ТипыКИ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СписокКонтЛиц = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТипКИ = Перечисления.ТипыКонтактнойИнформации.Адрес 
			И (Найти(Выборка.ВидКИ.Наименование, "почт") = 0
			И Найти(Выборка.ВидКИ.Наименование, "Почт") = 0) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Выборка.ТипКИ = Перечисления.ТипыКонтактнойИнформации.Адрес Тогда
			Картинка = БиблиотекаКартинок.КИ_ПочтовыйКонверт;
		ИначеЕсли Выборка.ТипКИ = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
			Картинка = БиблиотекаКартинок.КИ_имейл;
		ИначеЕсли Выборка.ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон Тогда
			Картинка = БиблиотекаКартинок.КИ_телефон;
		Иначе
			Картинка = БиблиотекаКартинок.КИ_прочее;
		КонецЕсли;	
		СписокКонтЛиц.Добавить(Выборка.Ссылка, СокрЛП(Выборка.Наименование) + "// " + СокрЛП(Выборка.Представление),,Картинка);	
	КонецЦикла;
	
	Возврат СписокКонтЛиц;
	
КонецФункции //ПолучитьСписокКонтактныхЛицПартнераНаСервере
