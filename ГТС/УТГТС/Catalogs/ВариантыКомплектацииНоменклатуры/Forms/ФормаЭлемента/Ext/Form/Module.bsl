    ОписаниеТиповК = Новый ОписаниеТипов(Массив);

    Если ВвестиЗначение(ВыбЗнач, "Введите значение", ОписаниеТиповК) Тогда
	ПолучитьСоставДругогоНабора(ВыбЗнач);
        
    КонецЕсли;
	
	
КонецПроцедуры

