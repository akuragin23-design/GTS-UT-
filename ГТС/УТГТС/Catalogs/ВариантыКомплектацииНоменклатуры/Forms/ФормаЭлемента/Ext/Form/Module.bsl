// Альтер ЛОГО+ блок процедура распределения долей себестоимости по виду цен

&НаКлиенте
Процедура ПересчитатьДолиСтоимостиПоВидуЦен(Команда)  
	//ASP_Crow 11.03.2026 000029567 В расширение
	
	Если Объект.Товары.Количество() > 0 Тогда
		Ответ = Вопрос("Доли себестоимости текущей комплектации будут перезаполнены. Продолжить?", РежимДиалогаВопрос.ДаНетОтмена);
		Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	ВидЦен = Неопределено;
	Если ВвестиЗначение(ВидЦен,,Тип("СправочникСсылка.ВидыЦен")) Тогда
		ПересчитатьДолиСтоимостиНаСервере(Объект.Владелец, Объект.Характеристика, ВидЦен);	
	КонецЕсли;	
	
	Элементы.Товары.Обновить();
КонецПроцедуры

&НаСервере
Процедура ПересчитатьДолиСтоимостиНаСервере(Комплект, Характеристика, ВидЦен)
	//ASP_Crow 11.03.2026 000029567 В расширение
	
	ТЗ_ДляРасчета = Объект.Товары.Выгрузить();
	
	ТЗ_ДляРасчета.Колонки.Добавить("Сумма");
	
	ЗапросЦены = Новый Запрос;
	ЗапросЦены.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Характеристика,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ВидЦены = &ВидЦен
	|				И Номенклатура В (&Комплектующие)
	|				И Характеристика В (&ХарактеристикиКомплектующих)) КАК ЦеныНоменклатурыСрезПоследних";
	ЗапросЦены.УстановитьПараметр("ВидЦен", ВидЦен);
	ЗапросЦены.УстановитьПараметр("Комплектующие", ТЗ_ДляРасчета.ВыгрузитьКолонку("Номенклатура"));
	ЗапросЦены.УстановитьПараметр("ХарактеристикиКомплектующих", ТЗ_ДляРасчета.ВыгрузитьКолонку("Характеристика"));
	
	ТЗ_Цены = ЗапросЦены.Выполнить().Выгрузить();
	
	Для каждого СтрокаДляРасчета Из ТЗ_ДляРасчета Цикл
		СтрокиЦены = ТЗ_Цены.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", СтрокаДляРасчета.Номенклатура, СтрокаДляРасчета.Характеристика));
		Если СтрокиЦены.Количество() = 0 Тогда
			Сообщить("Не обнаружена цена для комплетующей: " + СтрокаДляРасчета.Номенклатура, СтатусСообщения.Важное);	
			СтрокаДляРасчета.Сумма = 0;
			Продолжить;
		КонецЕсли;	
		СтрокаДляРасчета.Сумма = СтрокаДляРасчета.Количество*СтрокиЦены[0].Цена;
	КонецЦикла;	
	
	СуммаИтого =  ТЗ_ДляРасчета.Итог("Сумма");
	РаспределятьПропорциональноКоличеству = Ложь;
	Если СуммаИтого = 0 Тогда
		РаспределятьПропорциональноКоличеству = Истина;
	КонецЕсли;
	
	НомерСтроки = 0;
	ОсталосьДоли = 100;
	ВсегоЗаписей = Объект.Товары.Количество();
	ТЗ_ДляРасчета.Сортировать("Сумма");
	Для каждого Запись Из ТЗ_ДляРасчета Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если НомерСтроки = ВсегоЗаписей Тогда
			Запись.ДоляСтоимости = ОсталосьДоли;
		Иначе
			Если РаспределятьПропорциональноКоличеству Тогда
				Запись.ДоляСтоимости = окр(100 / ВсегоЗаписей);
			Иначе	
				Запись.ДоляСтоимости = окр(Запись.Сумма * 100 / СуммаИтого);
			КонецЕсли;
		КонецЕсли;
		Если Запись.ДоляСтоимости = 0 Тогда
			Запись.ДоляСтоимости = 1;
		КонецЕсли;
		ОсталосьДоли = ОсталосьДоли - Запись.ДоляСтоимости;
	КонецЦикла;
	
	Объект.Товары.Загрузить(ТЗ_ДляРасчета);
КонецПроцедуры//ПересчитатьДолиСтоимостиНаСервере

&НаКлиенте
Процедура ASP_СкопироватьИзДругойКомплектации(Команда)  
	//ASP_Crow 11.03.2026 000029567 В расширение
	
	Перем ВыбЗнач;

    Массив = Новый Массив;
