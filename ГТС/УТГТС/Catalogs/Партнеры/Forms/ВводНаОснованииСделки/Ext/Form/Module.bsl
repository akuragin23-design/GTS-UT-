
&НаКлиенте
Процедура Создать(Команда)
	// Проверка заполнения
	Если НЕ ПроверитьЗаполнение() Тогда
		Предупреждение("Заполните необходимые реквизиты!!!");
		Возврат;
	ИначеЕсли ПустаяСтрока(ЕМайл) И ПустаяСтрока(Телефон) Тогда
		Предупреждение("Заполните хотя бы одно поле контактной информации партнера (телефон или e-mail)");
		Возврат;
	КонецЕсли;	
	
	// Проверка подобных реквизитов
	Если ЕстьПодобноеНаименование ИЛИ ЕстьПодобныйEmail ИЛИ ЕстьПодобныйТелефон Тогда
		Ответ = Вопрос("Обнаружены партнеры с подобными реквизитами (наименование, e-mail или телефон). Продолжить создание партнера?", РежимДиалогаВопрос.ДаНетОтмена);
		Если НЕ Ответ = КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;		
	КонецЕсли;
	
	// При создании контактного лица проверяем по физ. лицу
	Если СоздатьКонтактноеЛицо Тогда
		Если ИспользованиеФизЛица = 0
			И НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
			Предупреждение("Для создания контактного лица требуется указать физ.лицо");
			Возврат;
		ИначеЕсли ИспользованиеФизЛица = 1 
			И ПустаяСтрока(Фамилия+Имя+Отчество) Тогда
			Предупреждение("Для создания контактного лица укажите ФИО физ.лица");
			Возврат;
		КонецЕсли;
		//
		Если ПустаяСтрока(ЕмайлКонтактногоЛица) 
			И ПустаяСтрока(ТелефонКонтактногоЛица)
			И ПустаяСтрока(МобильныйТелефон) Тогда
			Предупреждение("Заполните хотя бы одно поле контактной информации контактного лица");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
		
	// Создание партнера
	Партнер = СозданиеПартнера();
	
	Структура = Новый Структура("Партнер, КаналПервичногоИнтереса, ИсточникПервичногоИнтереса", Партнер, КаналПервичногоИнтереса, ИсточникПервичногоИнтереса);
	ЭтаФорма.Закрыть(Структура);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("БизнесРегион", БизнесРегион);
	Параметры.Свойство("КаналПервичногоИнтереса", КаналПервичногоИнтереса);
	Параметры.Свойство("ИсточникПервичногоИнтереса", ИсточникПервичногоИнтереса);	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКонтактноеЛицоПриИзменении(Элемент)
	Если СоздатьКонтактноеЛицо Тогда
		Элементы.КонтактноеЛицо.Доступность = Истина;
	Иначе
		Элементы.КонтактноеЛицо.Доступность = Ложь;	
		Имя = Неопределено;
		Отчество = Неопределено;
		Фамилия = Неопределено;
		ЕмайлКонтактногоЛица = Неопределено;
		ТелефонКонтактногоЛица = Неопределено;
		МобильныйТелефон = Неопределено;
	КонецЕсли;	
КонецПроцедуры

