КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеФизЛицаПриИзменении(Элемент)
	Элементы.ФизЛицо.Видимость = (ИспользованиеФизЛица = 0);
КонецПроцедуры

&НаСервере
Функция СозданиеПартнера()
	Нов = Справочники.Партнеры.СоздатьЭлемент();
	Нов.Родитель = ГруппаПартнеров;
	Нов.Наименование = Наименование;
	Нов.НаименованиеПолное = Наименование;
	Нов.БизнесРегион = БизнесРегион;
	Нов.ДатаРегистрации = ТекущаяДата();
	Нов.Клиент = Истина;
	Нов.ОсновнойМенеджер = ПараметрыСеанса.ТекущийПользователь;
	Нов.Комментарий = Комментарий;
	
	// Контактная информация
	Если НЕ ПустаяСтрока(ЕМайл) Тогда
		СтрокаТЧ = Нов.КонтактнаяИнформация.Добавить();
		СтрокаТЧ.Вид = Справочники.ВидыКонтактнойИнформации.EmailПартнера;
		СтрокаТЧ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		СтрокаТЧ.АдресЭП = ЕМайл;
		СтрокаТЧ.Представление = ЕМайл;
	КонецЕсли;
	Если НЕ ПустаяСтрока(Телефон) Тогда
		СтрокаТЧ = Нов.КонтактнаяИнформация.Добавить();
		СтрокаТЧ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПартнера;
		СтрокаТЧ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
		СтрокаТЧ.НомерТелефона = Телефон;
		СтрокаТЧ.Представление = Телефон;
	КонецЕсли;
	
	Нов.Записать();
	
	// Контактное лицо
	Если СоздатьКонтактноеЛицо Тогда
		// Определимся с физ.лицом КЛ
		Если ИспользованиеФизЛица = 1 Тогда//Создаем физ.лицо
			НовФЛ = Справочники.ФизическиеЛица.СоздатьЭлемент();
			НовФЛ.Родитель = ГруппаФизЛиц;
			НовФЛ.Наименование = Фамилия + " " + Имя + " " + Отчество;
			НовФЛ.Записать();
			ФизЛицо = НовФЛ.Ссылка;
		КонецЕсли;
		
		НовКЛ = Справочники.КонтактныеЛицаПартнеров.СоздатьЭлемент();
		НовКЛ.Владелец = Нов.Ссылка;
		НовКЛ.ФизЛицо = ФизЛицо;
		НовКЛ.Наименование = ФизЛицо.Наименование;
		НовКЛ.ДатаРегистрацииСвязи = ТекущаяДата();
		НовКЛ.РолиКонтактногоЛица.Добавить().РольКонтактногоЛица = РольКонтактногоЛица;
		НовКЛ.Автор = ПараметрыСеанса.ТекущийПользователь;
		
		// Контактные данные контактного лица
		Если НЕ ПустаяСтрока(ЕмайлКонтактногоЛица) Тогда
			СтрокаТЧ = НовКЛ.КонтактнаяИнформация.Добавить();
			СтрокаТЧ.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица;
			СтрокаТЧ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
			СтрокаТЧ.АдресЭП = ЕмайлКонтактногоЛица;
			СтрокаТЧ.Представление = ЕмайлКонтактногоЛица;
		КонецЕсли;
		Если НЕ ПустаяСтрока(ТелефонКонтактногоЛица) Тогда
			СтрокаТЧ = НовКЛ.КонтактнаяИнформация.Добавить();
			СтрокаТЧ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица;
			СтрокаТЧ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			СтрокаТЧ.НомерТелефона = ТелефонКонтактногоЛица;
			СтрокаТЧ.Представление = ТелефонКонтактногоЛица;
		КонецЕсли;
		Если НЕ ПустаяСтрока(МобильныйТелефон) Тогда
			СтрокаТЧ = НовКЛ.КонтактнаяИнформация.Добавить();
			СтрокаТЧ.Вид = Справочники.ВидыКонтактнойИнформации.МобильныйТелефонКонтактногоЛица;
			СтрокаТЧ.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			СтрокаТЧ.НомерТелефона = МобильныйТелефон;
			СтрокаТЧ.Представление = МобильныйТелефон;
		КонецЕсли;
		
		НовКЛ.Записать();
	КонецЕсли;
	
	Возврат Нов.Ссылка;
	
КонецФункции	

&НаКлиенте
Процедура НаименованиеПолноеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Список = Новый СписокЗначений();
	Список.Добавить("ООО """+Наименование+"""");
	Список.Добавить("ОАО """+Наименование+"""");
	Список.Добавить("ЗАО """+Наименование+"""");
	Список.Добавить("ГУП """+Наименование+"""");
	
	Выбор = ВыбратьИзСписка(Список);
	Если Выбор = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	НаименованиеПолное = Выбор.Значение;
КонецПроцедуры

//// Проверка наличия партнеров с подобными характеристиками
&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
