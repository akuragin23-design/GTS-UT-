КонецПроцедуры

&НаСервере
Процедура ПроверитьНаименованиеНаСервере()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Партнеры.Ссылка) КАК КоличествоПодобныхПартнеров
	                      |ИЗ
	                      |	Справочник.Партнеры КАК Партнеры
	                      |ГДЕ
	                      |	Партнеры.Наименование ПОДОБНО &Наименование");
	Запрос.УстановитьПараметр("Наименование", "%"+Наименование+"%");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.КоличествоПодобныхПартнеров > 0 Тогда
		ЕстьПодобноеНаименование = Истина;
	Иначе
		ЕстьПодобноеНаименование = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьЕМайлНаСервере()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПартнерыКонтактнаяИнформация.Ссылка) КАК КоличествоПодобныхПартнеров
	                      |ИЗ
	                      |	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	                      |ГДЕ
	                      |	ПартнерыКонтактнаяИнформация.АдресЭП ПОДОБНО &АдресЭП");
	Запрос.УстановитьПараметр("АдресЭП", "%"+ЕМайл+"%");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.КоличествоПодобныхПартнеров > 0 Тогда
		ЕстьПодобныйEmail = Истина;
	Иначе
		ЕстьПодобныйEmail = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьТелефонНаСервере()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПартнерыКонтактнаяИнформация.Ссылка) КАК КоличествоПодобныхПартнеров
	                      |ИЗ
	                      |	Справочник.Партнеры.КонтактнаяИнформация КАК ПартнерыКонтактнаяИнформация
	                      |ГДЕ
	                      |	(ПартнерыКонтактнаяИнформация.НомерТелефона ПОДОБНО &Телефон
	                      |			ИЛИ ПартнерыКонтактнаяИнформация.НомерТелефонаБезКодов ПОДОБНО &Телефон)");
	Запрос.УстановитьПараметр("Телефон", "%"+Телефон+"%");
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Если Выборка.КоличествоПодобныхПартнеров > 0 Тогда
		ЕстьПодобныйТелефон = Истина;
	Иначе
		ЕстьПодобныйТелефон = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЮрЛицоПриИзменении(Элемент)
	Если ЮрЛицо=Истина Тогда
	СоздатьКонтактноеЛицо=Истина;
Если СоздатьКонтактноеЛицо Тогда
		Элементы.КонтактноеЛицо.Доступность = Истина;
	Иначе
		Элементы.КонтактноеЛицо.Доступность = Ложь;	
		Имя = Неопределено;
		Отчество = Неопределено;
		Фамилия = Неопределено;
		ЕмайлКонтактногоЛица = Неопределено;
		ТелефонКонтактногоЛица = Неопределено;
		МобильныйТелефон = Неопределено;
	КонецЕсли;	
	
	КонецЕсли;

КонецПроцедуры
