&НаСервере
Процедура СоздатьДокументТелефонныйЗвонокПоПараметрамЗвонка()
	//ASP. Для того что бы исключить дублирование проверяем что документ телефонный звонок не создан и создаем новый
	Если ДокументТелефонныйЗвонок=ПредопределенноеЗначение("Документ.ТелефонныйЗвонок.ПустаяСсылка") Тогда
		ДокументТелефонныйЗвонок=ПростыеЗвонки_ОбщийМодуль_Сервер.СоздатьДокументТелефонныйЗвонок(НомерТелефона,Параметры.НомерНа,Параметры.ПараметрыНаправление,Параметры.ДатаВремяНачала,Параметры.ДатаВремяОкончания);
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоследнююСделку(Партнер)
	
	ЗапросПолученияПоследнейСделки = Новый Запрос;
	ЗапросПолученияПоследнейСделки.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СделкиСКлиентами.Ссылка КАК Сделка
	|ИЗ
	|	Справочник.СделкиСКлиентами КАК СделкиСКлиентами
	|ГДЕ
	|	СделкиСКлиентами.Партнер = &Партнер
	|
	|УПОРЯДОЧИТЬ ПО
	|	СделкиСКлиентами.ДатаНачала УБЫВ";
	ЗапросПолученияПоследнейСделки.УстановитьПараметр("Партнер",Партнер);
	
	
	
	РезультатЗапросаПолученияПоследнейСделки = ЗапросПолученияПоследнейСделки.Выполнить();
	
	Если РезультатЗапросаПолученияПоследнейСделки.Пустой() Тогда
		Возврат Неопределено
	Иначе
		ВыборкаЗапросаПолученияПоследнейСделки=РезультатЗапросаПолученияПоследнейСделки.Выбрать();
		ВыборкаЗапросаПолученияПоследнейСделки.Следующий();
		Возврат ВыборкаЗапросаПолученияПоследнейСделки.Сделка;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	//ASP. После записи нового контактного лица запишем документ телефонный звонок в базу
	СоздатьДокументТелефонныйЗвонокПоПараметрамЗвонка();
