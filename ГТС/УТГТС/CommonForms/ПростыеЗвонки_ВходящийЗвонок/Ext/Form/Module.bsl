&НаКлиенте
Процедура СоздатьСделку(Команда)
	СоздатьДокументТелефонныйЗвонокПоПараметрамЗвонка();
	//ASP. Передаем в форму новой сделки партнера и ссылку на документ телефонный звонок
	ОткрытьФорму("Справочник.СделкиСКлиентами.Форма.ФормаЭлемента",Новый Структура("ДокументТелефонныйЗвонок,Партнер",ДокументТелефонныйЗвонок,Абонент));	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПоследнююСделку(Команда)
	СоздатьДокументТелефонныйЗвонокПоПараметрамЗвонка();
	
	ПоследняяСделка=ПолучитьПоследнююСделку(Абонент);
	Если ПоследняяСделка=Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдено сделок по партнеру");
	Иначе
		ОткрытьЗначение(ПоследняяСделка)
	КонецЕсли;
	
КонецПроцедуры

