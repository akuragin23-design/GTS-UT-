		//ТекстДляРуководителя = "Следующие заказы были отменены: ";
		
		ВыборкаМенеджер = ВыборкаРуководитель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаМенеджер.Следующий() Цикл
			Менеджер = ВыборкаМенеджер.Менеджер;
			ТекстДляМенеджера = "";
			ОтборСуммы = Новый Структура("Отдел", Менеджер.Подразделение);
