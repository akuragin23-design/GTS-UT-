// +ГТС АвтоматическоеЗакрытиеЗаказовБезРеализаций 07.11.2019
Процедура АвтоматическоеЗакрытиеЗаказовБезРеализации() Экспорт

	//ASP_Crow 11.03.2026 000029567 В расширени
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки КАК ДокументОтгрузки,
		|	СУММА(ТоварыКОтгрузкеОстатки.КОтгрузкеОстаток) КАК КОтгрузкеОстаток,
		|	СУММА(ТоварыКОтгрузкеОстатки.КОформлениюОстаток) КАК КОформлениюОстаток,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Менеджер КАК Менеджер,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Менеджер.Подразделение.ТекущийРуководитель КАК Руководитель,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Ссылка КАК Заказ
		|ИЗ
		|	РегистрНакопления.ТоварыКОтгрузке.Остатки КАК ТоварыКОтгрузкеОстатки
		|ГДЕ
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Дата > &Дата
		|	И ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Менеджер ЕСТЬ НЕ NULL 
		|
		|СГРУППИРОВАТЬ ПО
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Менеджер,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Менеджер.Подразделение.ТекущийРуководитель,
		|	ТоварыКОтгрузкеОстатки.ДокументОтгрузки.Ссылка
		|ИТОГИ ПО
		|	Руководитель,
		|	Менеджер";
	
		Запрос.УстановитьПараметр("Дата", ТекущаяДата()-60*60*24*30);  
	   	Результат =  Запрос.Выполнить();

	
		ВыборкаРуководитель = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Руководитель = Неопределено;
	Менеджер = Неопределено;
	Автор = ПараметрыСеанса.ТекущийПользователь;
	Пока ВыборкаРуководитель.Следующий() Цикл
		Руководитель = ВыборкаРуководитель.Руководитель;
		//ТекстДляРуководителя = "Следующие заказы были отменены: ";
		
		ВыборкаМенеджер = ВыборкаРуководитель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаМенеджер.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаМенеджер) Тогда
			Менеджер = ВыборкаМенеджер.Менеджер;
			ТекстДляМенеджера = "";
			Выборка = ВыборкаМенеджер.Выбрать();
			Пока Выборка.Следующий() Цикл
				Если ТипЗнч(Выборка.Заказ)=Тип("ДокументСсылка.ЗаказКлиента") Тогда
				МассивЗаказ = Новый Массив;
				МассивЗаказ.Добавить(Выборка.Заказ);
				ОбъектЗаказ = Выборка.Заказ.ПолучитьОбъект();
				Для каждого Стр из ОбъектЗаказ.Товары Цикл
					Стр.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
				КонецЦикла;
				попытка
				ОбъектЗаказ.Записать(РежимЗаписиДокумента.Проведение);
				Если ЗначениеЗаполнено(Менеджер) И НЕ ПустаяСтрока(ТекстДляМенеджера) Тогда								
				ТекстДляМенеджера = "Следующие заказы были установлены ""не обеспечивать"" из-за отсутствия реализации: " + ТекстДляМенеджера;
				БП = БизнесПроцессы.Задание.СоздатьБизнесПроцесс();
				БП.Автор = Автор;
				БП.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
				БП.Дата = ТекущаяДата();
				БП.СрокИсполнения = ТекущаяДата();
				БП.Исполнитель = Менеджер;
				БП.Наименование = "Автоматическое закрытие заказов клиентов из-за отсутствия реализации";
				БП.Содержание = ТекстДляМенеджера;
				Если ЗначениеЗаполнено(Руководитель) Тогда
					БП.НаПроверке = Истина;
					БП.Проверяющий = Руководитель;
					БП.СрокПроверки = ТекущаяДата();
				КонецЕсли;	
				БП.Записать();
				БП.Старт(); 
				КонецЕсли;
				
				исключение
				
				конецпопытки;
				
				КонецЕсли;
			КонецЦикла;
			КонецЕсли;
		
		КонецЦикла;
	КонецЦикла;

	
	
КонецПроцедуры
