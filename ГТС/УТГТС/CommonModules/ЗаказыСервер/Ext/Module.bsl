Процедура ЗаказыБезПричиныЗакрытия() Экспорт
	
	//ASP_Crow 11.03.2026 000029567 В расширени
	ДатаНачала = ТекущаяДата() - (8 * 86400);
	ДатаОкончания = ТекущаяДата() - (2 * 86400);
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗаказыИОповещения.Заказ.Ссылка КАК Ссылка,
	               |	ЗаказыИОповещения.Заказ.Менеджер.Подразделение КАК Подразделение,
	               |	ЗаказКлиентаТовары.ПричинаОтмены,
	               |	ЗаказыИОповещения.Заказ.Партнер КАК Партнер
	               |ИЗ
	               |	РегистрСведений.ЗаказыИОповещения КАК ЗаказыИОповещения,
	               |	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
	               |ГДЕ
	               |	ЗаказыИОповещения.ДатаАвтоматическогоЗакрытия МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.ПричинаОтмены,
	               |	ЗаказыИОповещения.Заказ.Ссылка,
	               |	ЗаказыИОповещения.Заказ.Менеджер.Подразделение
	               |
	               |ИМЕЮЩИЕ
	               |	МАКСИМУМ(ЗаказКлиентаТовары.ПричинаОтмены) = ЗНАЧЕНИЕ(Справочник.ПричиныОтменыЗаказовКлиентов.ПросроченГрафикПредоплаты)
	               |ИТОГИ ПО
	               |	Подразделение";
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	ВыборкаРуководитель = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРуководитель.Следующий() Цикл
		Руководитель =  ВыборкаРуководитель.Подразделение.ТекущийРуководитель;
		БП = БизнесПроцессы.Задание.СоздатьБизнесПроцесс();
		БП.Автор = ПараметрыСеанса.ТекущийПользователь;
		БП.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
		БП.Дата = ТекущаяДата();
		БП.СрокИсполнения = ТекущаяДата();
		БП.Исполнитель = Справочники.Пользователи.НайтиПоРеквизиту("ФизическоеЛицо", Руководитель);
		БП.Наименование = "Закрытые без указания причины заказы";
		БП.НаПроверке = Ложь;
		ТекстЗадания = "Для следующих заказов не указана причина отмены: ";
		ВыборкаЗаказов = ВыборкаРуководитель.Выбрать();
		Пока ВыборкаЗаказов.Следующий() Цикл
			ТекстЗадания = ТекстЗадания + Символы.ПС + ВыборкаЗаказов.Ссылка + Строка(ВыборкаЗаказов.Партнер);		
		КонецЦикла;
		БП.Содержание = ТекстЗадания;
		БП.Записать();
		БП.Старт();
	КонецЦикла;					   
КонецПроцедуры	




