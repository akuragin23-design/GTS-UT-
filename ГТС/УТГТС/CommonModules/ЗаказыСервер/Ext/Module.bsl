			Пока Выборка.Следующий() Цикл
				
				СтруктураКурсовВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Выборка.Заказ.Валюта, ТекущаяДата());
				лСумДок = Выборка.Заказ.СуммаДокумента * ?(ЗначениеЗаполнено(СтруктураКурсовВалюты.Курс), СтруктураКурсовВалюты.Курс, 1) / ?(ЗначениеЗаполнено(СтруктураКурсовВалюты.Кратность), СтруктураКурсовВалюты.Кратность, 1);
				
				ПревышениеЛимита = (лСумДок > СуммаЛимита);
				
				МассивЗаказ = Новый Массив;
				МассивЗаказ.Добавить(Выборка.Заказ);
				Разбираем=0;
				Если ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(МассивЗаказ, "Закрыт", Новый Структура("ПричинаОтмены, ОтменитьНеотработанныеСтроки, ПроверятьОстатки", ?(ПревышениеЛимита, Справочники.ПричиныОтменыЗаказовКлиентов.ПросроченГрафикПредоплаты, Справочники.ПричиныОтменыЗаказовКлиентов.ПросроченГрафикПредоплатыЛимит), Истина, Ложь)) = 1 Тогда
					//ТекстДляРуководителя = ТекстДляРуководителя + Символы.ПС + Выборка.Заказ;
					Разбираем=1;
					Если ПревышениеЛимита Тогда
						ТекстДляМенеджера = ТекстДляМенеджера + Символы.ПС + Выборка.Заказ;
						МассивОтмененных.Добавить(Выборка.Заказ);
					КонецЕсли;
					 //ОбщегоНазначенияУТ.УстановитьСтатусДокументов
					 
					   //+ASP_yulia_l_14/10/2021_000012854
					ДокЗаказ = Выборка.Заказ.ПолучитьОбъект();
					ДокЗаказ.СуммаОтменено = ДокЗаказ.Товары.Итог("СуммаСНДС");
