						ДокЗаказ.Записать();
					Исключение
					    ЗаписьЖурналаРегистрации("Ошибка записи при закрытии заказа", УровеньЖурналаРегистрации.Ошибка, Выборка.Заказ,,"Регл.задание АвтоматическоеЗакрытиеЗаказовКлиентов"+ Символы.ПС + ОписаниеОшибки());
					КонецПопытки;
					  //-ASP_yulia_l_14/10/2021_000012854
				КонецЕсли;

					
					   ВыборкаСборки=Выборка.Выбрать();
					   Пока ВыборкаСборки.Следующий() Цикл
					Если Разбираем=1 и ТипЗнч(ВыборкаСборки.СборкаТоваров) = Тип("ДокументСсылка.СборкаТоваров") Тогда
						Разборка = Документы.СборкаТоваров.СоздатьДокумент();
						Разборка.Дата = ТекущаяДата();
						Разборка.Заполнить(ВыборкаСборки.СборкаТоваров);
						Если Не ПустаяСтрока(Разборка.Номенклатура) Тогда
														
							Запрос1 = Новый Запрос;
							Запрос1.Текст = 
							"ВЫБРАТЬ
							|	ВариантыКомплектацииНоменклатуры.Ссылка
							|ИЗ
							|	Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
							|ГДЕ
							|	ВариантыКомплектацииНоменклатуры.Владелец = &Владелец
							|	И ВариантыКомплектацииНоменклатуры.Основной = ИСТИНА
							|
							|СГРУППИРОВАТЬ ПО
							|	ВариантыКомплектацииНоменклатуры.Ссылка";
							
							Запрос1.УстановитьПараметр("Владелец", Разборка.Номенклатура);
							
							Результат1 = Запрос1.Выполнить();
							
							Выборка1= Результат1.Выбрать();
							
							Пока Выборка1.Следующий() Цикл
								Разборка.ВариантКомплектации=Выборка1.Ссылка;
							КонецЦикла;
							
							
							
							
						КонецЕсли;
						Попытка
							Разборка.Записать(РежимЗаписиДокумента.Проведение);
							//ТекстДляМенеджера = ТекстДляМенеджера + " (разобран комплект по док-ту: " + Выборка.СборкаТоваров + ")";
						Исключение
							Попытка
								Разборка.Комментарий="Документ создан автоматическим закрытием заказов. Не смог провестись";
								Разборка.Записать(РежимЗаписиДокумента.Запись);
							Исключение
							КонецПопытки;
							//ТекстДляМенеджера = ТекстДляМенеджера + " (!!!! не удалось сформировать разборку комплекта по док-ту: " + Выборка.СборкаТоваров + "!!!)";
						КонецПопытки;
					//ТипЗнч(Выборка.СборкаТоваров)	
				КонецЕсли;
				//Пока ВыборкаСборки.Следующий() 								
				КонецЦикла;
							//выборкадетальныхзаписей	
			КонецЦикла;
			
			Если ЗначениеЗаполнено(Менеджер) И НЕ ПустаяСтрока(ТекстДляМенеджера) Тогда								
				ТекстДляМенеджера = "Следующие заказы были отменены из-за нарушения срока оплаты и требуют указания причины закрытия: " + ТекстДляМенеджера;
				БП = БизнесПроцессы.Задание.СоздатьБизнесПроцесс();
				БП.Автор = Автор;
				БП.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
				БП.Дата = ТекущаяДата();
				БП.СрокИсполнения = ТекущаяДата();
				БП.Исполнитель = Менеджер;
				БП.Наименование = "Автоматическое закрытие заказов клиентов по срокам оплаты";
				БП.Содержание = ТекстДляМенеджера;
				Если ЗначениеЗаполнено(Руководитель) Тогда
					БП.НаПроверке = Истина;
					БП.Проверяющий = Руководитель;
					БП.СрокПроверки = ТекущаяДата();
				КонецЕсли;	
				БП.Записать();
				Для Каждого Заказ Из МассивОтмененных Цикл
					ЗаписьРегистра = РегистрыСведений.ЗаказыИОповещения.СоздатьМенеджерЗаписи();
					ЗаписьРегистра.Задача = БП.Ссылка;
					ЗаписьРегистра.Заказ = Заказ;
					ЗаписьРегистра.ДатаАвтоматическогоЗакрытия = ТекущаяДата();
					ЗаписьРегистра.Записать();
					
					//ASP КАВ начало
					СтрТЗ = ТЗЗаказы.Добавить();
					СтрТЗ.Заказ = Заказ;
					//ASP КАВ конец
					
					//ГТС убираем очищение регистра, храним данные по закрытым - 25.05.2020
					//ASP__A.Zhel 02.04.2019 Очищаем данные о закрытых заказах
					//МЗ = РегистрыСведений.СрокиРезервирования.СоздатьМенеджерЗаписи();
					//МЗ.ЗаказКлиента = Заказ;
					//МЗ.Прочитать();
					//
					//Если МЗ.Выбран() Тогда
					//	МЗ.Удалить();
					//КонецЕсли;
					
					//__ASP
				КонецЦикла;	
				БП.Старт(); 
			КонецЕсли;
		//выборкаменеджер	
		КонецЦикла;
	//выборкаруководитель	
	КонецЦикла;

	
	//ASP КАВ начало
	//Закрытие сделок по заказам с указанием причины проигрыша (п.2.5)
	ТЗЗаказы.Свернуть("Заказ");
	
	ТЗСделки = Новый ТаблицаЗначений;
	ТЗСделки.Колонки.Добавить("Сделка");
	
	Для Каждого Стр Из ТЗЗаказы Цикл
		СтрТЗ = ТЗСделки.Добавить();
		СтрТЗ.Сделка = Стр.Заказ.Сделка;
	КонецЦикла;
	ТЗСделки.Свернуть("Сделка");
	МассивЗакрытых = Новый Массив;
	МассивСделок = Новый Массив;
	Для Каждого Стр Из ТЗСделки Цикл
		Сделка = Стр.Сделка.Ссылка;
		СтрукутраМассива = Новый Структура("Сделка, Заказ", Стр.Сделка.Ссылка, Документы.ЗаказКлиента.ПустаяСсылка());
		МассивЗакрытых.Добавить(СтрукутраМассива);

		Если Сделка.Статус = Перечисления.СтатусыСделок.Выиграна Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСделок.Добавить(Сделка);
	КонецЦикла;
	
	//Необходимо убедиться, что по сделкам из МассивСделок все заказы закрыты и проиграны, и только в этом случае закрывать сделки   	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗаказКлиента.Сделка КАК Сделка,
	|	ЗаказКлиента.Ссылка КАК Заказ,
	|	ЗаказКлиента.Статус,
	|	ЗаказКлиента.Товары.(
	|		ПричинаОтмены
	|	)
	|ИЗ
	|	Документ.ЗаказКлиента КАК ЗаказКлиента
	|ГДЕ
	|	ЗаказКлиента.Сделка В(&МассивСделок)
	|ИТОГИ ПО
	|	Сделка";
	Запрос.УстановитьПараметр("МассивСделок", МассивСделок);
	
	Результат = Запрос.Выполнить();
	ВыборкаСделка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСделка.Следующий() Цикл
		ЗакрываемСделку = Истина;
		
		ПричинаОтмены = "";
		
		Выборка = ВыборкаСделка.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не Выборка.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт Тогда
				ЗакрываемСделку = Ложь;
				Прервать;
			КонецЕсли;			
			
			Товары = Выборка.Товары;
			ВыборкаТовары = Товары.Выбрать();
			Если ВыборкаТовары.Следующий() Тогда
				ПричинаОтмены = ВыборкаТовары.ПричинаОтмены;
			КонецЕсли;
			
			Если СокрЛП(ПричинаОтмены) = "" Тогда
				ЗакрываемСделку = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗакрываемСделку Тогда
			Сделка = ВыборкаСделка.Сделка.ПолучитьОбъект();
			Сделка.Статус = Перечисления.СтатусыСделок.Проиграна;
			Сделка.Закрыта = Истина;
			Сделка.ПричинаПроигрышаСделки = Справочники.ПричиныПроигрышаСделок.ПустаяСсылка();

			Набор = РегистрыСведений.ASP_СоответствиеПричинЗакрытия.СоздатьНаборЗаписей();
			Набор.Отбор.ПричинаЗакрытияЗаказов.Установить(ПричинаОтмены);
			Набор.Прочитать();
			Если Набор.Количество() > 0 Тогда
				Сделка.ПричинаПроигрышаСделки = Набор[0].ПричинаЗакрытияСделок;
				Сделка.Статус = Перечисления.СтатусыСделок.Проиграна;
			    Сделка.Закрыта = Истина;

			КонецЕсли;
			
			Сделка.Записать(); 

			СтрукутраМассива = Новый Структура("Сделка, Заказ", Сделка.Ссылка, Выборка.Заказ);
			МассивЗакрытых.Добавить(СтрукутраМассива);
		КонецЕсли;
	КонецЦикла;
	//ASP КАВ конец
    ОбработатьСделкиПоЗакрытым(МассивЗакрытых);
	
	///////////////////////////////////////////
	//ASP
	АвтоматическоеЗакрытиеЗаказовКлиентовЗавершенных();
	
КонецПроцедуры//АвтоматическоеЗакрытиеЗаказовКлиентов

Процедура ОбработатьСделкиПоЗакрытым(Закрытые)
	//ASP_Crow 11.03.2026 000029567 В расширени
	Если Закрытые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;    
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НоменклатураСегмента.Сегмент КАК Сегмент
		|ИЗ
		|	РегистрСведений.НоменклатураСегмента КАК НоменклатураСегмента
		|ГДЕ
		|	НоменклатураСегмента.Номенклатура = &Номенклатура";

	ЗапросСделки = Новый Запрос;
	ЗапросСделки.Текст = 
		"ВЫБРАТЬ
		|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
		|	ЗаказКлиентаТовары.НоменклатураНабора КАК НоменклатураНабора
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|ГДЕ
		|	ЗаказКлиентаТовары.Ссылка.Сделка = &Сделка
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Номенклатура,
		|	ЗаказКлиентаТовары.НоменклатураНабора";
	
	Для каждого Строка из Закрытые Цикл 
		МассивДобавления = Новый Массив;
		Если Не Строка.Заказ = Документы.ЗаказКлиента.ПустаяСсылка() Тогда
			Попытка
				ТоварыЗаказа = Строка.Заказ.Товары.Выгрузить();
			Исключение 
				ЗапросСделки.УстановитьПараметр("Сделка", Строка.Сделка); 
				ТоварыЗаказа = ЗапросСделки.Выполнить().Выгрузить();
				ЗаписьЖурналаРегистрации("ASP_ПроверкаСделка", УровеньЖурналаРегистрации.Примечание,,,"" + Строка.Заказ + символы.пс + Строка.Сделка);
			КонецПопытки; 
		иначе
			ЗапросСделки.УстановитьПараметр("Сделка", Строка.Сделка); 
			ТоварыЗаказа = ЗапросСделки.Выполнить().Выгрузить();
			ЗаписьЖурналаРегистрации("ASP_ПроверкаСделка", УровеньЖурналаРегистрации.Примечание,,,"" + Строка.Заказ + символы.пс + Строка.Сделка);
		КонецЕсли;
		Для каждого СтрокаТовара из ТоварыЗаказа Цикл
			Запрос.УстановитьПараметр("Номенклатура", СтрокаТовара.Номенклатура);
			РЗ = Запрос.Выполнить();
			Если РЗ.Пустой() Тогда
				Продолжить;
			Иначе
				Выборка = РЗ.Выбрать();
				Пока Выборка.Следующий() Цикл
					МассивДобавления.Добавить(Выборка.Сегмент);	
				КонецЦикла;
			КонецЕсли;
			Запрос.УстановитьПараметр("Номенклатура", СтрокаТовара.НоменклатураНабора);
			РЗ = Запрос.Выполнить();
			Если РЗ.Пустой() Тогда
				Продолжить;
			Иначе
				Выборка = РЗ.Выбрать();
				Пока Выборка.Следующий() Цикл
					МассивДобавления.Добавить(Выборка.Сегмент);	
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;       
		Если МассивДобавления.Количество() > 0 Тогда
			СделкаОб = Строка.Сделка.ПолучитьОбъект(); 
			ЗаписыватьСделку = Ложь;
			Для Каждого СтрокаДобавления из МассивДобавления Цикл
				НайтиИнтересы = СделкаОб.ИнтересПоСегментамНоменклатуры.НайтиСтроки(Новый Структура("СегментНоменклатуры", СтрокаДобавления));
				Если НайтиИнтересы.Количество() > 0 Тогда
					Продолжить;
				КонецЕсли;
				СтрокаИнтереса = СделкаОб.ИнтересПоСегментамНоменклатуры.Добавить();
				СтрокаИнтереса.СегментНоменклатуры = СтрокаДобавления;  
				ЗаписыватьСделку = Истина;
			КонецЦикла;
			Если ЗаписыватьСделку Тогда
				СделкаОб.Записать();
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура АвтоматическоеЗакрытиеЗаказовКлиентовЗавершенных() Экспорт 
	//ASP_Crow 11.03.2026 000029567 В расширени
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЗаказовКлиентов.Заказ КАК Заказ,
	|	СостоянияЗаказовКлиентов.Состояние КАК Состояние,
	|	СостоянияЗаказовКлиентов.СуммаОплаты КАК СуммаОплаты,
	|	СостоянияЗаказовКлиентов.СуммаОтгрузки КАК СуммаОтгрузки
	|ИЗ
	|	РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
	|ГДЕ
	|	СостоянияЗаказовКлиентов.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.ГотовКЗакрытию)
	|	И СостоянияЗаказовКлиентов.Заказ.Проведен
	|	И СостоянияЗаказовКлиентов.Заказ ССЫЛКА Документ.ЗаказКлиента
	|	И СостоянияЗаказовКлиентов.Заказ.Дата >= ДАТАВРЕМЯ(2020, 1, 1)
	|	И (СостоянияЗаказовКлиентов.ПроцентОплаты = 100
	|				И СостоянияЗаказовКлиентов.ПроцентОтгрузки = 100
	|				И СостоянияЗаказовКлиентов.Заказ.СуммаДокумента = СостоянияЗаказовКлиентов.СуммаОтгрузки
	|			ИЛИ СостоянияЗаказовКлиентов.ПроцентОплаты = 0
	|				И СостоянияЗаказовКлиентов.ПроцентОтгрузки = 0)";
	
	Результат =  Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МассивЗаказ = Новый Массив;
		МассивЗаказ.Добавить(Выборка.Заказ);
		
		Если ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(МассивЗаказ, "Закрыт") = 1 Тогда
			ЗаписьРегистра = РегистрыСведений.ASP_АвтоматическиЗавершенныеЗаказы.СоздатьМенеджерЗаписи();
			ЗаписьРегистра.Заказ = Выборка.Заказ;
			ЗаписьРегистра.ДатаЗавершения = ТекущаяДата();
			ЗаписьРегистра.Записать();
		КонецЕсли;
	КонецЦикла;
	АвтоматическоеЗакрытиеЗаказовБезРеализации();
КонецПроцедуры//АвтоматическоеЗакрытиеЗаказовКлиентов
// +Альтер ЛОГО

Процедура АвтоматическоеЗакрытиеЗаказовКлиентов1() Экспорт 
	//ASP_Crow 11.03.2026 000029567 В расширени
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка КАК Заказ,
	|	ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.Менеджер КАК Менеджер,
	|	Пользователи.Ссылка КАК Руководитель
	|ПОМЕСТИТЬ ЗаказыКлиентов
	|ИЗ
	|	Документ.ЗаказКлиента.ЭтапыГрафикаОплаты КАК ЗаказКлиентаЭтапыГрафикаОплаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РасчетыСКлиентамиПоДокументам.Обороты(ДАТАВРЕМЯ(2011, 1, 1), , , ) КАК РасчетыСКлиентамиПоДокументамОбороты
	|		ПО ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка = РасчетыСКлиентамиПоДокументамОбороты.ЗаказКлиента
	|			И (РасчетыСКлиентамиПоДокументамОбороты.ПредоплатаРасход > 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.Менеджер.Подразделение.ТекущийРуководитель = Пользователи.ФизическоеЛицо
	|ГДЕ
	|	ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.Проведен
	|	И ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Котгрузке)
	|	И ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовКлиентов.Закрыт)
	|	И (ЗаказКлиентаЭтапыГрафикаОплаты.ВариантОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.ПредоплатаДоОтгрузки)
	|			ИЛИ ЗаказКлиентаЭтапыГрафикаОплаты.ВариантОплаты = ЗНАЧЕНИЕ(Перечисление.ВариантыОплатыКлиентом.АвансДоОбеспечения))
	|	И РасчетыСКлиентамиПоДокументамОбороты.ПредоплатаРасход ЕСТЬ NULL
	|	И ЗаказКлиентаЭтапыГрафикаОплаты.ДатаПлатежа < &ДатаПлатежа
	|	И ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.Дата >= ДАТАВРЕМЯ(2020, 1, 1)
	|	И ЕСТЬNULL(ЗаказКлиентаЭтапыГрафикаОплаты.Ссылка.НомерЦикла, 0) = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СборкаТоваров.Ссылка КАК СборкаТоваров,
	|	ЗаказыКлиентов.Заказ КАК Заказ,
	|	ЗаказыКлиентов.Менеджер КАК Менеджер,
	|	ЗаказыКлиентов.Руководитель КАК Руководитель
	|ИЗ
	|	ЗаказыКлиентов КАК ЗаказыКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СборкаТоваров КАК СборкаТоваров
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СборкаТоваров КАК РазборкаТоваров
	|			ПО СборкаТоваров.Ссылка = РазборкаТоваров.ДокументОснование
	|				И (РазборкаТоваров.Проведен)
	|				И (РазборкаТоваров.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СборкаТоваров))
	|		ПО ЗаказыКлиентов.Заказ = СборкаТоваров.ДокументОснование
	|			И (СборкаТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СборкаТоваров))
	|			И (СборкаТоваров.Проведен)
	|			И (РазборкаТоваров.Ссылка ЕСТЬ NULL)
	|ИТОГИ ПО
	|	Руководитель,
	|	Менеджер";
	
	Запрос.УстановитьПараметр("ДатаПлатежа", КонецДня(ТекущаяДата()));
	//ПричинаОтмены = Справочники.ПричиныОтменыЗаказовКлиентов.ПросроченГрафикПредоплаты;
	
	Результат =  Запрос.Выполнить();
	
	ВыборкаРуководитель = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Руководитель = Неопределено;
	Менеджер = Неопределено;
	Автор = ПараметрыСеанса.ТекущийПользователь;
	Пока ВыборкаРуководитель.Следующий() Цикл
		Руководитель = ВыборкаРуководитель.Руководитель;
		//ТекстДляРуководителя = "Следующие заказы были отменены: ";
		
		ВыборкаМенеджер = ВыборкаРуководитель.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаМенеджер.Следующий() Цикл
			Менеджер = ВыборкаМенеджер.Менеджер;
			ТекстДляМенеджера = "";
			ОтборСуммы = Новый Структура("Отдел", Менеджер.Подразделение);
			СуммаЛимита = РегистрыСведений.ЛимитыЗаказов.Получить(ОтборСуммы).Сумма;
			Выборка = ВыборкаМенеджер.Выбрать();
			МассивОтмененных = Новый Массив;
			Пока Выборка.Следующий() Цикл
				
				СтруктураКурсовВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Выборка.Заказ.Валюта, ТекущаяДата());
				лСумДок = Выборка.Заказ.СуммаДокумента * ?(ЗначениеЗаполнено(СтруктураКурсовВалюты.Курс), СтруктураКурсовВалюты.Курс, 1) / ?(ЗначениеЗаполнено(СтруктураКурсовВалюты.Кратность), СтруктураКурсовВалюты.Кратность, 1);
				
				ПревышениеЛимита = лСумДок > СуммаЛимита;
				
				МассивЗаказ = Новый Массив;
				МассивЗаказ.Добавить(Выборка.Заказ);
				Если ОбщегоНазначенияУТВызовСервера.УстановитьСтатусДокументов(МассивЗаказ, "Закрыт", Новый Структура("ОтменаНеотработанныхСтрок", ?(ПревышениеЛимита, Справочники.ПричиныОтменыЗаказовКлиентов.ПросроченГрафикПредоплаты, Справочники.ПричиныОтменыЗаказовКлиентов.ПросроченГрафикПредоплатыЛимит))) = 1 Тогда
					//ТекстДляРуководителя = ТекстДляРуководителя + Символы.ПС + Выборка.Заказ;
					Если ПревышениеЛимита Тогда
						ТекстДляМенеджера = ТекстДляМенеджера + Символы.ПС + Выборка.Заказ;
						МассивОтмененных.Добавить(Выборка.Заказ);
					КонецЕсли;
					Если ТипЗнч(Выборка.СборкаТоваров) = Тип("ДокументСсылка.СборкаТоваров") Тогда
						Разборка = Документы.СборкаТоваров.СоздатьДокумент();
						Разборка.Дата = ТекущаяДата();
						Разборка.Заполнить(Выборка.СборкаТоваров);
						Попытка
							Разборка.Записать(РежимЗаписиДокумента.Проведение);
							//ТекстДляМенеджера = ТекстДляМенеджера + " (разобран комплект по док-ту: " + Выборка.СборкаТоваров + ")";
						Исключение
							//ТекстДляМенеджера = ТекстДляМенеджера + " (!!!! не удалось сформировать разборку комплекта по док-ту: " + Выборка.СборкаТоваров + "!!!)";
						КонецПопытки;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(Менеджер) И НЕ ПустаяСтрока(ТекстДляМенеджера) Тогда								
				ТекстДляМенеджера = "Следующие заказы были отменены и требуют указания причины закрытия: " + ТекстДляМенеджера;
				БП = БизнесПроцессы.Задание.СоздатьБизнесПроцесс();
				БП.Автор = Автор;
				БП.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
				БП.Дата = ТекущаяДата();
				БП.СрокИсполнения = ТекущаяДата();
				БП.Исполнитель = Менеджер;
				БП.Наименование = "Автоматическое закрытие заказов клиентов";
				БП.Содержание = ТекстДляМенеджера;
				Если ЗначениеЗаполнено(Руководитель) Тогда
					БП.НаПроверке = Истина;
					БП.Проверяющий = Руководитель;
					БП.СрокПроверки = ТекущаяДата();
				КонецЕсли;	
				БП.Записать();
				Для Каждого Заказ Из МассивОтмененных Цикл
					ЗаписьРегистра = РегистрыСведений.ЗаказыИОповещения.СоздатьМенеджерЗаписи();
					ЗаписьРегистра.Задача = БП.Ссылка;
					ЗаписьРегистра.Заказ = Заказ;
					ЗаписьРегистра.ДатаАвтоматическогоЗакрытия = ТекущаяДата();
					ЗаписьРегистра.Записать();
					
					//
				КонецЦикла;	
				БП.Старт(); 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры//АвтоматическоеЗакрытиеЗаказовКлиентов
