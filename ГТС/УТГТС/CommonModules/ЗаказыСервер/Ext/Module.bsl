	|ИЗ
	|	ЗаказыКлиентов КАК ЗаказыКлиентов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СборкаТоваров КАК СборкаТоваров
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.СборкаТоваров КАК РазборкаТоваров
	|			ПО СборкаТоваров.Ссылка = РазборкаТоваров.ДокументОснование
	|				И (РазборкаТоваров.Проведен)
	|				И (РазборкаТоваров.ХозяйственнаяОперация <> ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СборкаТоваров))
	|		ПО ЗаказыКлиентов.Заказ = СборкаТоваров.ДокументОснование
	|			И (СборкаТоваров.ХозяйственнаяОперация = ЗНАЧЕНИЕ(Перечисление.ХозяйственныеОперации.СборкаТоваров))
	|			И (СборкаТоваров.Проведен)
	|			И (РазборкаТоваров.Ссылка ЕСТЬ NULL)
	|ИТОГИ ПО
	|	Руководитель,
	|	Менеджер,
	|	Заказ";
	
	Запрос.УстановитьПараметр("ДатаПлатежа", КонецДня(ТекущаяДата()));
	  
