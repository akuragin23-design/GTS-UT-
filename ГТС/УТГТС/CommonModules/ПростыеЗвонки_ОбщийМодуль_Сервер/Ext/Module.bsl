Процедура УстановитьЗначениеНастройки(ИмяНастройки,Значение) Экспорт
	
	ЗаписьНастройки = РегистрыСведений.ПростыеЗвонки_Настройки.СоздатьМенеджерЗаписи();
	ЗаписьНастройки.ИмяНастройки = СокрЛП(ИмяНастройки);
	ЗаписьНастройки.Значение = Значение;
	ЗаписьНастройки.Записать();
	
КонецПроцедуры

Функция ПолучитьЗначениеНастройки(ИмяНастройки) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПростыеЗвонки_Настройки.Значение
	               |ИЗ
	               |	РегистрСведений.ПростыеЗвонки_Настройки КАК ПростыеЗвонки_Настройки
	               |ГДЕ
	               |	ПростыеЗвонки_Настройки.ИмяНастройки = &ИмяНастройки";
				   
	Запрос.УстановитьПараметр("ИмяНастройки",ИмяНастройки);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Значение;
	КонецЕсли;
				   
КонецФункции

Функция ПроверитьПервыйЗапуск() Экспорт
	
	Если ПолучитьЗначениеНастройки("ПервыйЗапуск") = Неопределено Тогда
		
		ВидПростыеЗвонки = Справочники.ВидыКонтактнойИнформации.ПростыеЗвонкиТелефон;
		Если Не ЗначениеЗаполнено(ВидПростыеЗвонки.Тип) Тогда
			ВидПростыеЗвонкиОбъект = ВидПростыеЗвонки.ПолучитьОбъект();
			ВидПростыеЗвонкиОбъект.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон;
			ВидПростыеЗвонкиОбъект.Записать();
		КонецЕсли;
	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
	    	           |	ПрофилиГруппДоступаРоли.Ссылка
	        	       |ИЗ
	            	   |	Справочник.ПрофилиГруппДоступа.Роли КАК ПрофилиГруппДоступаРоли
	               	   |ГДЕ
		               |	ПрофилиГруппДоступаРоли.Роль = ""ПростыеЗвонки""";
				   
		РезультатЗапроса = Запрос.Выполнить();
	
		Если РезультатЗапроса.Пустой() Тогда
		
			НовыйПрофиль = Справочники.ПрофилиГруппДоступа.СоздатьЭлемент();
			НовыйПрофиль.Наименование = "Простые звонки";
			НовыйПрофиль.Родитель = Справочники.ПрофилиГруппДоступа.Прочее;
		
			НоваяСтрока = НовыйПрофиль.Роли.Добавить();
			НоваяСтрока.Роль = "ПростыеЗвонки";
		
			НовыйПрофиль.Записать();
		
			НоваяГруппаДоступа = Справочники.ГруппыДоступа.СоздатьЭлемент();
			НоваяГруппаДоступа.Наименование = "Простые звонки";
			НоваяГруппаДоступа.Профиль = НовыйПрофиль.Ссылка;
		
			НоваяГруппаДоступа.Записать();
		
		КонецЕсли;
		
		ИдентификаторБазы1С = СокрЛП(Новый УникальныйИдентификатор());
		УстановитьЗначениеНастройки("ИдентификаторБазы1С", ИдентификаторБазы1С);

		УстановитьЗначениеНастройки("ПервыйЗапуск", "1")
	КонецЕсли;
		
КонецФункции



Процедура ASP_ЗаполненияАбонентовВИсторииЗвонковПриЗаписи(Источник, Отказ) Экспорт
	Если Отказ Или Не ПростыеЗвонки_ОбщийМодуль_Сервер.ЕстьПраваНаПростыеЗвонки() Тогда
		Возврат;
	КонецЕсли;
	
	
	//ASP. Ищем в истории звонков по текущему номеру и пустому абоненту, и заполняем недостающую информацию	
	НомераТелефоновАбонента=Источник.КонтактнаяИнформация.Выгрузить(Новый Структура("Тип",Перечисления.ТипыКонтактнойИнформации.Телефон)).ВыгрузитьКолонку("НомерТелефона");
	
	ТипАбонента=Строка(ТипЗнч(Источник.Ссылка));
	
	Если ТипАбонента="Контактное лицо" Тогда
		ТипАбонента="КонтактноеЛицоПартнера";
	КонецЕсли;
	
	ЗапросИсторииЗвонковПоАбоненту = Новый Запрос;
	ЗапросИсторииЗвонковПоАбоненту.Текст = 
	"ВЫБРАТЬ
	|	ПростыеЗвонки_ИсторияЗвонков.УИД,
	|	ПростыеЗвонки_ИсторияЗвонков.Партнер,
	|	ПростыеЗвонки_ИсторияЗвонков.Пользователь,
	|	ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаС,
	|	ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаНа,
	|	ПростыеЗвонки_ИсторияЗвонков.Продолжительность,
	|	ПростыеЗвонки_ИсторияЗвонков.ДатаВремяНачала,
	|	ПростыеЗвонки_ИсторияЗвонков.ДатаВремяОкончания,
	|	ПростыеЗвонки_ИсторияЗвонков.НаправлениеЗвонка,
	|	ПростыеЗвонки_ИсторияЗвонков.ПутьКФайлу,
	|	ПростыеЗвонки_ИсторияЗвонков.Контрагент,
	|	ПростыеЗвонки_ИсторияЗвонков.КонтактноеЛицоПартнера,
	|	ПростыеЗвонки_ИсторияЗвонков.Сделка
	|ИЗ
	|	РегистрСведений.ПростыеЗвонки_ИсторияЗвонков КАК ПростыеЗвонки_ИсторияЗвонков
	|ГДЕ
	|	(ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаС В (&НомераТелефоновАбонента)
	|			ИЛИ ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаНа В (&НомераТелефоновАбонента))
	|	И ВЫБОР
	|			КОГДА &ТипАбонента = ""Партнер""
	|				ТОГДА ПростыеЗвонки_ИсторияЗвонков.Партнер = ЗНАЧЕНИЕ(Справочник.Партнеры.ПустаяСсылка)
	|			КОГДА &ТипАбонента = ""КонтактноеЛицоПартнера""
	|				ТОГДА ПростыеЗвонки_ИсторияЗвонков.КонтактноеЛицоПартнера = ЗНАЧЕНИЕ(Справочник.КонтактныеЛицаПартнеров.ПустаяСсылка)
	|			КОГДА &ТипАбонента = ""Контрагент""
	|				ТОГДА ПростыеЗвонки_ИсторияЗвонков.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ";
	
	ЗапросИсторииЗвонковПоАбоненту.УстановитьПараметр("НомераТелефоновАбонента", НомераТелефоновАбонента);
	ЗапросИсторииЗвонковПоАбоненту.УстановитьПараметр("ТипАбонента", ТипАбонента);
	
	РезультатЗапросаИсторииЗвонковПоАбоненту = ЗапросИсторииЗвонковПоАбоненту.Выполнить();
	
	ВыборкаИсторииЗвонковПоАбоненту = РезультатЗапросаИсторииЗвонковПоАбоненту.Выбрать();
	
	СтруктураЗаполнения=Новый Структура;
	СтруктураЗаполнения.Вставить(ТипАбонента,Источник.Ссылка);
	
	Если ТипАбонента="КонтактноеЛицоПартнера" Тогда
		СтруктураЗаполнения.Вставить("Партнер",Источник.Ссылка.Владелец);	
	ИначеЕсли ТипАбонента="Контрагент" Тогда
		СтруктураЗаполнения.Вставить("Партнер",Источник.Ссылка.Партнер);	
	КонецЕсли;
	

	
	Пока ВыборкаИсторииЗвонковПоАбоненту.Следующий() Цикл
		МенеджерЗаписиИсторииЗвонков=РегистрыСведений.ПростыеЗвонки_ИсторияЗвонков.СоздатьМенеджерЗаписи();
		
		//ASP. Удаляю старую запись регистра
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиИсторииЗвонков,ВыборкаИсторииЗвонковПоАбоненту);
		МенеджерЗаписиИсторииЗвонков.Удалить();
		
		//ASP.Запишу обновленную запись регистра
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиИсторииЗвонков,ВыборкаИсторииЗвонковПоАбоненту);
		ЗаполнитьЗначенияСвойств(МенеджерЗаписиИсторииЗвонков,СтруктураЗаполнения);
		МенеджерЗаписиИсторииЗвонков.Записать();
	КонецЦикла;
	

КонецПроцедуры

Процедура ASP_ЗаполнениеСделокВИсторииЗвонковПриЗаписи(Источник, Отказ) Экспорт
	Если Отказ Или Не ЗначениеЗаполнено(Источник.ТелефонныйЗвонок) Или Не ПростыеЗвонки_ОбщийМодуль_Сервер.ЕстьПраваНаПростыеЗвонки() Тогда
		Возврат;
	КонецЕсли;
	
	Сделка=Источник.Ссылка;
	Пользователь=ПараметрыСеанса.ТекущийПользователь;
	НомерТелефона=Источник.ТелефонныйЗвонок.АбонентКакСвязаться;
	
	ЗапросНаличияЗаписиВИсторииЗвонков = Новый Запрос;
	ЗапросНаличияЗаписиВИсторииЗвонков.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьЗаписьИстории
	|ИЗ
	|	РегистрСведений.ПростыеЗвонки_ИсторияЗвонков КАК ПростыеЗвонки_ИсторияЗвонков
	|ГДЕ
	|	ПростыеЗвонки_ИсторияЗвонков.Сделка = &Сделка
	|	И ПростыеЗвонки_ИсторияЗвонков.Пользователь = &Пользователь
	|	И ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаС = &НомерТелефона";
	
	ЗапросНаличияЗаписиВИсторииЗвонков.УстановитьПараметр("Сделка", Сделка);
	ЗапросНаличияЗаписиВИсторииЗвонков.УстановитьПараметр("Пользователь", Пользователь);
	ЗапросНаличияЗаписиВИсторииЗвонков.УстановитьПараметр("НомерТелефона", НомерТелефона);
	
	Если Не ЗапросНаличияЗаписиВИсторииЗвонков.Выполнить().Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	ЗапросПоследнегоЗвонкаБезСделки	 = Новый Запрос;
	ЗапросПоследнегоЗвонкаБезСделки.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПростыеЗвонки_ИсторияЗвонков.УИД,
	|	ПростыеЗвонки_ИсторияЗвонков.Партнер,
	|	ПростыеЗвонки_ИсторияЗвонков.Пользователь,
	|	ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаС,
	|	ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаНа,
	|	ПростыеЗвонки_ИсторияЗвонков.Продолжительность,
	|	ПростыеЗвонки_ИсторияЗвонков.ДатаВремяНачала,
	|	ПростыеЗвонки_ИсторияЗвонков.ДатаВремяОкончания,
	|	ПростыеЗвонки_ИсторияЗвонков.НаправлениеЗвонка,
	|	ПростыеЗвонки_ИсторияЗвонков.ПутьКФайлу,
	|	ПростыеЗвонки_ИсторияЗвонков.Контрагент,
	|	ПростыеЗвонки_ИсторияЗвонков.КонтактноеЛицоПартнера,
	|	ПростыеЗвонки_ИсторияЗвонков.Сделка
	|ИЗ
	|	РегистрСведений.ПростыеЗвонки_ИсторияЗвонков КАК ПростыеЗвонки_ИсторияЗвонков
	|ГДЕ
	|	ПростыеЗвонки_ИсторияЗвонков.Пользователь = &Пользователь
	|	И ПростыеЗвонки_ИсторияЗвонков.НомерТелефонаС = &НомерТелефона
	|	И ПростыеЗвонки_ИсторияЗвонков.Сделка = ЗНАЧЕНИЕ(Справочник.СделкиСКлиентами.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПростыеЗвонки_ИсторияЗвонков.ДатаВремяНачала УБЫВ";
	
	ЗапросПоследнегоЗвонкаБезСделки.УстановитьПараметр("НомерТелефона", НомерТелефона);
	ЗапросПоследнегоЗвонкаБезСделки.УстановитьПараметр("Пользователь", Пользователь);
	
	РезультатЗапросаПоследнегоЗвонкаБезСделки = ЗапросПоследнегоЗвонкаБезСделки.Выполнить();
	
	Если РезультатЗапросаПоследнегоЗвонкаБезСделки.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаЗапросаПоследнегоЗвонкаБезСделки = РезультатЗапросаПоследнегоЗвонкаБезСделки.Выбрать();
	ВыборкаЗапросаПоследнегоЗвонкаБезСделки.Следующий();
	
	//ASP. Поставляю в последнюю запись истории звонков текущую сделку
	МенеджерЗаписиИсторииЗвонков=РегистрыСведений.ПростыеЗвонки_ИсторияЗвонков.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МенеджерЗаписиИсторииЗвонков,ВыборкаЗапросаПоследнегоЗвонкаБезСделки);
	МенеджерЗаписиИсторииЗвонков.Сделка=Сделка;
	МенеджерЗаписиИсторииЗвонков.Записать();
	
	
КонецПроцедуры
