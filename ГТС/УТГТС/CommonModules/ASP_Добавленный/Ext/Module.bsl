											,РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
			КонецПопытки;
		
		КонецЕсли;
	КонецЦикла;
	
	
	
	Выборка = РезультатЗапроса[РезультатЗапроса.Количество() - 2].Выбрать();
	СтруктураПоиска = Новый Структура("АналитикаУчетаНоменклатуры, НомерГТД");
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию(РежимУправленияБлокировкойДанных.Управляемый);
		Попытка
			Если ЗначениеЗаполнено(Выборка.Регистратор)  Тогда
				ОбъектДокумент = Выборка.Регистратор.ПолучитьОбъект();
				НаборЗаписей = РегистрыНакопления.ТоварыОрганизаций.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
				НаборЗаписей.Прочитать();
				
				МассивЗаписей = Новый Массив;
				Для каждого Запись Из НаборЗаписей Цикл		
					Если Запись.АналитикаУчетаНоменклатуры = Выборка.АналитикаУчетаНоменклатуры 
							И Запись.НомерГТД = Выборка.НомерГТД Тогда
						МассивЗаписей.Добавить(Запись);
					КонецЕсли;		
				КонецЦикла;
				
				Для каждого Строка Из МассивЗаписей Цикл
					НаборЗаписей.Удалить(Строка);			
				КонецЦикла;
				НаборЗаписей.БлокироватьДляИзменения=Истина;
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать();
				
				ЗафиксироватьТранзакцию();
		    КонецЕсли;
		Исключение
			
			Сообщ = Новый СообщениеПользователю;
		    Сообщ.Текст = "Не удалось записать документ " + ВозвратТипаДокументаСтрока(ОбъектДокумент) 
						+ " № " + Строка(Выборка.Регистратор.Номер) + " от " + Строка(Выборка.Регистратор.Дата);
		    Сообщ.Сообщить();
		    ЗаписьЖурналаРегистрации("Не удалось записать документ"
										,УровеньЖурналаРегистрации.Ошибка,ОбъектДокумент
										,
										,ОписаниеОшибки()
										,РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
			ОтменитьТранзакцию();							
			
		КонецПопытки;
		
	КонецЦикла;
	
	
	
	Выборка = РезультатЗапроса[РезультатЗапроса.Количество() - 1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Отказ = Ложь;
		Если ЗначениеЗаполнено(Выборка.Регистратор)  Тогда
			ОбъектДокумент = Выборка.Регистратор.ПолучитьОбъект();
			ОбъектДокумент.ДополнительныеСвойства.Вставить("НеПерезаполнятьВидЗапасов"); 
			ОбъектДокумент.ДополнительныеСвойства.Вставить("ПерезаполнитьВидыЗапасов", Истина);
			Попытка
				ОбъектДокумент.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Сообщ = Новый СообщениеПользователю;
				Сообщ.Текст = "Не удалось записать документ " + ВозвратТипаДокументаСтрока(ОбъектДокумент) 
							+ " № " + Строка(Выборка.Регистратор.Номер) + " от " + Строка(Выборка.Регистратор.Дата);
				Сообщ.Сообщить();
				Сообщить(Выборка.Регистратор);
				
				ЗаписьЖурналаРегистрации("Не удалось записать документ"
											,УровеньЖурналаРегистрации.Ошибка,ОбъектДокумент
											,
											,ОписаниеОшибки()
											,РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
			КонецПопытки;
		КонецЕсли;								
	КонецЦикла;

КонецПроцедуры

