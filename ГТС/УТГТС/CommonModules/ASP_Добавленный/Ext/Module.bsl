Процедура ASP_ИзмененияСделкиПриПроведенииЗаказаКлиентаОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	// *** дополнение к 2.5. Текст ТЗ:
	//Ещё - если в заказе клиента все строчки в товаре  с заполненной причиной отмены и причина отмены в 1ой строчке не соответствует причине в сделке
	//то в сделке причину менять на причину из 1ой строчки заказа.
	
	Если ЗначениеЗаполнено(Источник.Сделка) Тогда
				
		ВсеСтрокиСПричинойОтмены = Истина;
		Для Каждого Стр Из Источник.Товары Цикл
			Если СокрЛП(Стр.ПричинаОтмены) = "" Тогда
				ВсеСтрокиСПричинойОтмены = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		СделкаСсылка = Источник.Сделка.Ссылка;
		СделкаОбъект = СделкаСсылка.ПолучитьОбъект();

		
		Если (ВсеСтрокиСПричинойОтмены = Истина) И (Источник.Товары.Количество() > 0) Тогда
			ПричинаВСделке = Источник.Сделка.ПричинаПроигрышаСделки;
			ПричинаВЗаказе = Источник.Товары[0].ПричинаОтмены;
			
			Набор = РегистрыСведений.ASP_СоответствиеПричинЗакрытия.СоздатьНаборЗаписей();
			Набор.Отбор.ПричинаЗакрытияЗаказов.Установить(ПричинаВЗаказе);
			Набор.Прочитать();
			
			ПричиныСоответствуют = Ложь;
			Для ин = 0 по Набор.Количество() - 1 Цикл
				Если Набор[ин].ПричинаЗакрытияСделок = ПричинаВСделке Тогда
					ПричинаСоответствуют = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ПричиныСоответствуют = Ложь Тогда
				Если Набор.Количество() > 0 Тогда
					СделкаОбъект.ПричинаПроигрышаСделки = Набор[0].ПричинаЗакрытияСделок;
					СделкаОбъект.Закрыта = Истина;
					СделкаОбъект.Статус=Перечисления.СтатусыСделок.Проиграна;
					//Попытка
					//	СделкаОбъект.Записать();
					//Исключение
					//	Сообщить(ОписаниеОшибки());
					//КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//*** Если сделка ещё не закрыта то закрывать. 
		Если СделкаОбъект.Закрыта = Ложь Тогда
			//СделкаСсылка = Источник.Сделка.Ссылка;
			//СделкаОбъект = СделкаСсылка.ПолучитьОбъект();
			СделкаОбъект.Статус=Перечисления.СтатусыСделок.ВыставленСчет;
			СделкаОбъект.Закрыта = Истина;
			//Попытка
			//	СделкаОбъект.Записать();
			//Исключение
			//	Сообщить(ОписаниеОшибки());
			//КонецПопытки;
		КонецЕсли;
		
		//++Ковровцев Интерволга
		//СделкаСсылка = Источник.Сделка.Ссылка;
		//СделкаОбъект = СделкаСсылка.ПолучитьОбъект();
		Если Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.КОбеспечению ИЛИ  Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.НеСогласован Тогда
			СделкаОбъект.Статус=Перечисления.СтатусыСделок.ВыставленСчет;
		    СделкаОбъект.Закрыта = Ложь;
			СделкаОбъект.ПричинаПроигрышаСделки = Неопределено;
			
		ИначеЕсли Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт и Источник.Товары.Количество() = 0 Тогда 
			СделкаОбъект.Статус=Перечисления.СтатусыСделок.Выиграна;
		    СделкаОбъект.Закрыта = Ложь;
			СделкаОбъект.ПричинаПроигрышаСделки = Неопределено;
		ИначеЕсли Источник.Статус = Перечисления.СтатусыЗаказовКлиентов.Закрыт и Источник.Товары[0].ПричинаОтмены = Справочники.ПричиныОтменыЗаказовКлиентов.ПустаяСсылка() Тогда
			СделкаОбъект.Статус=Перечисления.СтатусыСделок.Выиграна;
		    СделкаОбъект.Закрыта = Ложь;
			СделкаОбъект.ПричинаПроигрышаСделки = Неопределено;
		КонецЕсли;
		
		Попытка
			СделкаОбъект.Записать();
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;

		//--Ковровцев Интерволга
	КонецЕсли;
	
КонецПроцедуры
