Процедура ЗаполнениеРСДляЗаполненияРСБитрикс24(Отказ, Отбор) экспорт
// {{ ASP_DavydenkoDV 19.11.2019 15:14

	РегистраторВзять = Отбор.Регистратор.Значение;
	
	Если ( Отказ ИЛИ ТипЗнч(РегистраторВзять) <> Тип("ДокументСсылка.РеализацияТоваровУслуг" ) ) Тогда
		Возврат;
	ИначеЕсли ( РегистраторВзять.ЗаказКлиента = Документы.ЗаказКлиента.ПустаяСсылка() ) Тогда	
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = РегистрыСведений.ASP_ДляЗаполненияРСБитрикс24.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Документ = РегистраторВзять.ЗаказКлиента;
	МенеджерЗаписи.Прочитать();
	
	Если ( МенеджерЗаписи.Выбран() ) Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи.Документ = РегистраторВзять.ЗаказКлиента;
	МенеджерЗаписи.Записать();
	
	УстановитьФлагОбработкиЗаказаКлиента(МенеджерЗаписи.Документ, Истина); //+++ {{ ASP 10.03.2021 000010119 }}
	
