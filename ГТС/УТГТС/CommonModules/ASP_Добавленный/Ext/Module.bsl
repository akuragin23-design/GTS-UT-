		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		    
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТоварыОрганизацийОстаткиИОбороты.Период КАК Период,
			|	ТоварыОрганизацийОстаткиИОбороты.Регистратор КАК Регистратор,
			|	ТоварыОрганизацийОстаткиИОбороты.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
			|	ТоварыОрганизацийОстаткиИОбороты.НомерГТД КАК НомерГТД,
			|	ТоварыОрганизацийОстаткиИОбороты.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
			|ПОМЕСТИТЬ ВТДокументСотрицательнымОстатком
			|ИЗ
			|	РегистрНакопления.ТоварыОрганизаций.ОстаткиИОбороты(&ДатаНачала, , Регистратор, , АналитикаУчетаНоменклатуры.Номенклатура.ASP_Прослеживаемый) КАК ТоварыОрганизацийОстаткиИОбороты
			|ГДЕ
			|	ТоварыОрганизацийОстаткиИОбороты.КоличествоКонечныйОстаток < 0
			|	И НЕ ТоварыОрганизацийОстаткиИОбороты.Регистратор ССЫЛКА Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТоварыОрганизацийОбороты.Период КАК Период,
			|	ТоварыОрганизацийОбороты.Регистратор КАК Регистратор,
			|	ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
			|	ТоварыОрганизацийОбороты.НомерГТД КАК НомерГТД,
			|	0 КАК КоличествоКонечныйОстаток
			|ПОМЕСТИТЬ ВтДокументы
			|ИЗ
			|	РегистрНакопления.ТоварыОрганизаций.Обороты(, , Регистратор, ) КАК ТоварыОрганизацийОбороты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТДокументСотрицательнымОстатком КАК ВТДокументСотрицательнымОстатком
			|		ПО ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Номенклатура = ВТДокументСотрицательнымОстатком.АналитикаУчетаНоменклатуры.Номенклатура
			|			И ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Характеристика = ВТДокументСотрицательнымОстатком.АналитикаУчетаНоменклатуры.Характеристика
			|			И ТоварыОрганизацийОбороты.АналитикаУчетаНоменклатуры.Серия = ВТДокументСотрицательнымОстатком.АналитикаУчетаНоменклатуры.Серия
			|			И (НЕ ТоварыОрганизацийОбороты.Регистратор = ВТДокументСотрицательнымОстатком.Регистратор)
			|			И ТоварыОрганизацийОбороты.Период >= ВТДокументСотрицательнымОстатком.Период
			|ГДЕ
			|	НЕ ТоварыОрганизацийОбороты.Регистратор ССЫЛКА Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ВТДокументСотрицательнымОстатком.Период,
			|	ВТДокументСотрицательнымОстатком.Регистратор,
			|	ВТДокументСотрицательнымОстатком.АналитикаУчетаНоменклатуры,
			|	ВТДокументСотрицательнымОстатком.НомерГТД,
			|	ВТДокументСотрицательнымОстатком.КоличествоКонечныйОстаток
			|ИЗ
			|	ВТДокументСотрицательнымОстатком КАК ВТДокументСотрицательнымОстатком
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВтДокументы.Период КАК Период,
			|	ВтДокументы.Регистратор КАК Регистратор,
			|	ВтДокументы.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
			|	ВтДокументы.НомерГТД КАК НомерГТД,
			|	ВтДокументы.КоличествоКонечныйОстаток КАК КоличествоКонечныйОстаток
			|ИЗ
			|	ВтДокументы КАК ВтДокументы
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период,
			|	Регистратор
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВтДокументы.Период КАК Период,
			|	ВтДокументы.Регистратор КАК Регистратор
			|ИЗ
			|	ВтДокументы КАК ВтДокументы
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВтДокументы.Период,
			|	Регистратор";
		
		Запрос.УстановитьПараметр("ДатаНачала", '20210701');
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ЗафиксироватьТранзакцию();
	
