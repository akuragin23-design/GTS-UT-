//++000026792 ASP_Мочалина проверка был ли изменен документ перед постановкой его на регистрацию в БП.	
Функция СравнитьВерсииОбъекта(Объект)  Экспорт  
	
	
	
	Запр = новый Запрос("ВЫБРАТЬ 
	                    |	ВерсииОбъектов.ТабличныеДокументы КАК ТабличныеДокументы,
	                    |	ВерсииОбъектов.НомерВерсии КАК Версия,
	                    |	ВерсииОбъектов.ДатаВерсии КАК ДатаВерсии
	                    |ИЗ
	                    |	РегистрСведений.ВерсииОбъектов КАК ВерсииОбъектов
	                    |ГДЕ
	                    |	ВерсииОбъектов.ДатаВерсии <= &ДатаВерсии
	                    |	И ВерсииОбъектов.Объект = &Объект
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	Версия УБЫВ");
	Запр.УстановитьПараметр("Объект",Объект.Ссылка);
	Запр.УстановитьПараметр("ДатаВерсии",ТекущаяДата());
	ВыполненныйЗапрос = Запр.Выполнить();
	Если  ВыполненныйЗапрос.Пустой() Тогда
	
		Возврат Истина;	
	
	КонецЕсли;
	
	Результат = ВыполненныйЗапрос.Выгрузить();
	
	Объект1=неопределено;
	Объект2=неопределено;
	Для каждого РезультатСтрока Из Результат Цикл
		
		ДвоичныеДанные = ВерсионированиеОбъектов.СведенияОВерсииОбъекта(Объект.Ссылка, РезультатСтрока.Версия).ВерсияОбъекта;
		
		Если ДвоичныеДанные = неопределено Тогда
			
			продолжить;
			
		КонецЕсли; 
		Если	Объект1 = неопределено Тогда 
			Объект1 = Объект;//ASP_Козлов  12/12/2025  --000028927         //ВосстановитьОбъектПоXML(ДвоичныеДанные,"");
		Иначе
			Если	Объект2 = неопределено Тогда 
				Объект2 = ВосстановитьОбъектПоXML(ДвоичныеДанные,""); 
				прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Объект1 = неопределено или Объект2 = неопределено Тогда
		Возврат Истина;
	Иначе
    Ссылка1=Объект1.Ссылка;
    Ссылка2=Объект2.Ссылка;
    
    ЭтоСправочник=Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка1));
    ЭтоДокумент=Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Ссылка1));
    
    Если 
        ЭтоДокумент ИЛИ ЭтоСправочник
    Тогда  
        МДО=Метаданные.НайтиПоТипу(ТипЗнч(Ссылка1));
        
        СписокРеквизитов=Новый Массив();
        Если ЭтоСправочник Тогда
            СписокРеквизитов.Добавить("Наименование");
            СписокРеквизитов.Добавить("ПометкаУдаления");
            СписокРеквизитов.Добавить("Код");
            Если МДО.Иерархический Тогда
                СписокРеквизитов.Добавить("Родитель");
                Если МДО.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
                    СписокРеквизитов.Добавить("ЭтоГруппа");
                КонецЕсли;
            КонецЕсли;
            Если МДО.Владельцы.Количество() <> 0 Тогда 
                СписокРеквизитов.Добавить("Владелец");
            КонецЕсли;
        КонецЕсли;
        Если ЭтоДокумент Тогда
            СписокРеквизитов.Добавить("Дата");
            СписокРеквизитов.Добавить("Номер");
            СписокРеквизитов.Добавить("Проведен");
            СписокРеквизитов.Добавить("ПометкаУдаления");
        КонецЕсли;
        
        Для Каждого МДР ИЗ МДО.Реквизиты Цикл
            Реквизит=МДР.Имя;
            СписокРеквизитов.Добавить(Реквизит);
        КонецЦикла;
        Для Каждого Реквизит Из СписокРеквизитов Цикл
            Значение1=Объект1[Реквизит];
            Значение2=Объект2[Реквизит];
			Если Значение1<>Значение2 Тогда 
				возврат Истина;
            КонецЕсли;
        КонецЦикла;
        
        Для Каждого МДТЧ ИЗ МДО.ТабличныеЧасти Цикл
            ИмяТЧ=МДТЧ.Имя;
            ТЧ1=Объект1[ИмяТЧ];
            ТЧ2=Объект2[ИмяТЧ];
            Для Инд=0 По Макс(ТЧ1.Количество()-1,ТЧ2.Количество()-1) Цикл
                Для Каждого МДРТЧ ИЗ МДТЧ.Реквизиты Цикл
                    Реквизит=МДРТЧ.Имя;
                    Если Инд>=ТЧ1.Количество() Тогда
                        Значение1=Неопределено;
                    Иначе
                        Значение1=ТЧ1[Инд][Реквизит];
                    КонецЕсли;
                    Если Инд>=ТЧ2.Количество() Тогда
                        Значение2=Неопределено;
                    Иначе
                        Значение2=ТЧ2[Инд][Реквизит];
                    КонецЕсли;
					Если Значение1<>Значение2  Тогда 
						возврат Истина;
                    КонецЕсли;
                КонецЦикла;
            КонецЦикла;
        КонецЦикла;
    КонецЕсли;
    
    Возврат Ложь;
		
	КонецЕсли;	
КонецФункции

Функция ВосстановитьОбъектПоXML(ДанныеОбъекта, ТекстСообщенияОбОшибке = "")экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДвоичныеДанные = ДанныеОбъекта;
	Если ТипЗнч(ДанныеОбъекта) = Тип("Структура") Тогда
		ДвоичныеДанные = ДанныеОбъекта.Объект;
	КонецЕсли;
	
	ЧтениеFastInfoSet = Новый ЧтениеFastInfoSet;
	ЧтениеFastInfoSet.УстановитьДвоичныеДанные(ДвоичныеДанные);
	
	Попытка
		Объект = ПрочитатьXML(ЧтениеFastInfoSet);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Версионирование'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ТекстСообщенияОбОшибке = НСтр("ru = 'Не удалось перейти на выбранную версию.
											|Возможная причина: версия объекта была записана в другой версии программы.
											|Техническая информация об ошибке: %1'");
		ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщенияОбОшибке, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Объект;
	
КонецФункции
//--000026792		

 Процедура ASP_ДобавитьЗаписьСтатусаОбеспечения(ЗаказКлиента) Экспорт
	
	НаборЗаписей = РегистрыСведений.ASP_СостояниеОбеспеченияЗаказов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Заказ.Установить(ЗаказКлиента);
	НаборЗаписей.Прочитать();
	
	НеТребуетОбеспечения = Истина;
	Для каждого СтрТов из ЗаказКлиента.Товары Цикл
		Если СтрТов.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется
			или СтрТов.Отменено тогда
			Продолжить
		Иначе
			НеТребуетОбеспечения = ложь;	
		КонецЕсли;	
	КонецЦикла;
	
	//++ASP_Коваленко 24.10.24 000024974 Проверка что всё отгружено
	ВсёОтгружено = Истина;
	Для каждого СтрТов из ЗаказКлиента.Товары Цикл
		Если СтрТов.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить или СтрТов.Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда 
			Продолжить
		Иначе
			ВсёОтгружено = ложь;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	//--ASP_Коваленко 24.10.24 000024974
	
	//++ASP_Коваленко 24.10.24 000024974 неучитываемый массив номенклатур
	МассивЗапретРезервирования = ЗаказКлиента.Склад.ASP_Номенклатура.Выгрузить().ВыгрузитьКолонку("Номенклатура");
	//--ASP_Коваленко 24.10.24 000024974
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	&Заказ КАК Ссылка,
	               |	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказКлиентаТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения,
				   |	ЗаказКлиентаТовары.Сумма как Сумма
	               |ПОМЕСТИТЬ ВТ_ДанныеЗаказа
	               |ИЗ
	               |	&Товары КАК ЗаказКлиентаТовары
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
	               |	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
	               |	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
	               |	ЗаказКлиентаТовары.КоличествоУпаковок КАК КоличествоУпаковок,
	               |	ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения,
				   |	ЗаказКлиентаТовары.Сумма как Сумма
	               |ПОМЕСТИТЬ ВТ_ДанныеЗаказаПослеВыгр
	               |ИЗ
	               |	ВТ_ДанныеЗаказа КАК ЗаказКлиентаТовары
				   |ГДЕ
				   |	НЕ ЗаказКлиентаТовары.Номенклатура В (&МассивЗапретРезервирования)
				   |	И ЗаказКлиентатовары.ВариантОбеспечения <> &НеОбеспечивать
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЗаказКлиентаТовары.Ссылка КАК Заказ,
	               |	СУММА(ЗаказКлиентаТовары.КоличествоУпаковок) КАК КоличествоВсего,
	               |	0 КАК КоличествоОбеспечено,
				   |	Сумма(ЗаказКлиентаТовары.Сумма) Как СуммаВсего,
				   |	0 Как СуммаОбеспечено
	               |ПОМЕСТИТЬ Вт_ВсегоПоЗаказу
	               |ИЗ
	               |	ВТ_ДанныеЗаказаПослеВыгр КАК ЗаказКлиентаТовары
	               |ГДЕ
	               |	ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры <> &ТипНоменклатуры 
				   |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗаказКлиентаТовары.Ссылка,
	               |	0,
	               |	СУММА(ЗаказКлиентаТовары.КоличествоУпаковок),
				   |	0,
				   |	Сумма(ЗаказКлиентаТовары.Сумма)
	               |ИЗ
	               |	ВТ_ДанныеЗаказаПослеВыгр КАК ЗаказКлиентаТовары
	               |ГДЕ
	               |	ЗаказКлиентаТовары.ВариантОбеспечения В(&СтатусОбеспечено)
	               |	И ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры <> &ТипНоменклатуры
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЗаказКлиентаТовары.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Вт_ВсегоПоЗаказу.Заказ КАК Заказ,
	               |	СУММА(Вт_ВсегоПоЗаказу.КоличествоВсего) КАК КоличествоВсего,
	               |	СУММА(Вт_ВсегоПоЗаказу.КоличествоОбеспечено) КАК КоличествоОбеспечено,
				   |	СУММА(Вт_ВсегоПоЗаказу.СуммаВсего) КАК СуммаВсего,
				   |	СУММА(Вт_ВсегоПоЗаказу.СуммаОбеспечено) КАК СуммаОбеспечено
	               |ПОМЕСТИТЬ ВТ_ЗаказыГруппировка
	               |ИЗ
	               |	Вт_ВсегоПоЗаказу КАК Вт_ВсегоПоЗаказу
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Вт_ВсегоПоЗаказу.Заказ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ЗаказыГруппировка.Заказ КАК Заказ,
	               |	СУММА(ВЫБОР
	               |			КОГДА ВТ_ЗаказыГруппировка.КоличествоОбеспечено = 0
	               |					ИЛИ ВТ_ЗаказыГруппировка.КоличествоОбеспечено ЕСТЬ NULL
	               |				ТОГДА 0
	               |			КОГДА ВТ_ЗаказыГруппировка.КоличествоОбеспечено = ВТ_ЗаказыГруппировка.КоличествоВсего
	               |				ТОГДА 100
	               |			ИНАЧЕ 100 * ВТ_ЗаказыГруппировка.КоличествоОбеспечено / ВТ_ЗаказыГруппировка.КоличествоВсего
	               |		КОНЕЦ) КАК ПроцентОбеспечения,
				   |	СУММА(ВЫБОР
	               |			КОГДА ВТ_ЗаказыГруппировка.СуммаОбеспечено = 0
	               |					ИЛИ ВТ_ЗаказыГруппировка.СуммаОбеспечено ЕСТЬ NULL
	               |				ТОГДА 0
	               |			КОГДА ВТ_ЗаказыГруппировка.СуммаОбеспечено = ВТ_ЗаказыГруппировка.СуммаВсего
	               |				ТОГДА 100
	               |			ИНАЧЕ 100 * ВТ_ЗаказыГруппировка.СуммаОбеспечено / ВТ_ЗаказыГруппировка.СуммаВсего
	               |		КОНЕЦ) КАК ПроцентПоСумме
	               |ИЗ
	               |	ВТ_ЗаказыГруппировка КАК ВТ_ЗаказыГруппировка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТ_ЗаказыГруппировка.Заказ";
	Запрос.УстановитьПараметр("Товары", ЗаказКлиента.Товары);
	МассивВарОбеспечения = новый Массив;
	МассивВарОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.Отгрузить);
	МассивВарОбеспечения.Добавить(Перечисления.ВариантыОбеспечения.СоСклада);
	Запрос.УстановитьПараметр("СтатусОбеспечено", МассивВарОбеспечения);
	Запрос.УстановитьПараметр("Заказ", ЗаказКлиента);
	Запрос.УстановитьПараметр("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Услуга);
	Запрос.УстановитьПараметр("МассивЗапретРезервирования",МассивЗапретРезервирования);
	Запрос.УстановитьПараметр("НеОбеспечивать", Перечисления.ВариантыОбеспечения.НеТребуется);
	Рез = Запрос.Выполнить().Выгрузить();
	
	НаборЗаписей = Регистрысведений.ASP_СостояниеОбеспеченияЗаказов.СоздатьНаборЗаписей();
	
	Для каждого СтрРез из Рез Цикл
		СоздатьНапоминание = Ложь;
		НаборЗаписей.Отбор.Заказ.Установить(СтрРез.Заказ);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() = 0 Тогда //Может возникнуть ситуация, что старый заказ обеспечивается
			СтрокаЗаписи = НаборЗаписей.Добавить();
			СтрокаЗаписи.Заказ = СтрРез.Заказ;
			СтрокаЗАписи.ПроцентОбеспечения = СтрРез.ПроцентПоСумме;
			Если НеТребуетОбеспечения Тогда
				СтрокаЗаписи.СтатусОбеспечения = Перечисления.ASP_СтатусыОбеспеченияЗаказа.НеТребуетОбеспечения;	
			ИначеЕсли СтрРез.ПроцентОбеспечения = 100 Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаЗаписи.ДатаПолногоОбеспечения) Тогда
					СтрокаЗаписи.ДатаПолногоОбеспечения = ТекущаяДата();                             
					СоздатьНапоминание = Истина;
				КонецЕсли;
				СтрокаЗаписи.СтатусОбеспечения = Перечисления.ASP_СтатусыОбеспеченияЗаказа.Обеспечен;
			Иначе
				СтрокаЗаписи.СтатусОбеспечения = Перечисления.ASP_СтатусыОбеспеченияЗаказа.НеОбеспечен;
			КонецЕсли;	
		Иначе //В остальном запись всегда 1 и она перезаписывается
			СтрокаЗаписи = НаборЗаписей[0];
			СтрокаЗаписи.Заказ = СтрРез.Заказ;
			СтрокаЗАписи.ПроцентОбеспечения = СтрРез.ПроцентПоСумме;
			Если НеТребуетОбеспечения Тогда
				СтрокаЗаписи.СтатусОбеспечения = Перечисления.ASP_СтатусыОбеспеченияЗаказа.НеТребуетОбеспечения;	
			ИначеЕсли СтрРез.ПроцентОбеспечения = 100 Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаЗаписи.ДатаПолногоОбеспечения) Тогда
					СтрокаЗаписи.ДатаПолногоОбеспечения = ТекущаяДата();
					СоздатьНапоминание = Истина;
				КонецЕсли;
				СтрокаЗаписи.СтатусОбеспечения = Перечисления.ASP_СтатусыОбеспеченияЗаказа.Обеспечен;
			Иначе
				СтрокаЗаписи.СтатусОбеспечения = Перечисления.ASP_СтатусыОбеспеченияЗаказа.НеОбеспечен;
			КонецЕсли;	
		КонецЕсли;
		
		//++ASP_Коваленко 24.10.24 000024974  если все отгружено, то не создаем напоминание
		Если ВсёОтгружено Тогда 
			СоздатьНапоминание = ложь;			
		КонецЕсли;
		//--ASP_Коваленко 24.10.24 000024974
		
		Если СоздатьНапоминание и Пользователи.ТекущийПользователь() <> ЗаказКлиента.Менеджер Тогда
		//Если СоздатьНапоминание Тогда

			ТекстНапоминания = Строка(ЗаказКлиента) + " был полностью обеспечен" + Формат(СтрокаЗаписи.ДатаПолногоОбеспечения, "ДФ=dd.MM.yyyy")
			+ Символы.ПС + "Контрагент: " + ЗаказКлиента.Контрагент
			+ Символы.ПС + "Общая сумма заказа: " + ЗаказКлиента.СуммаДокумента;
			НапоминанияПользователяСлужебный.ASP_ПодключитьПроизвольноеНапоминание(ЗаказКлиента.Менеджер,ТекстНапоминания, ТекущаяДата(),,ЗаказКлиента);
			НастройкиОтпр = новый структура;
			НастройкиОтпр.Вставить("УчетнаяЗапись", Справочники.УчетныеЗаписиЭлектроннойПочты.ПустаяСсылка());
			НастройкиОтпр.Вставить("Тема", "Уведомление о полном обеспечении заказа №" + ЗаказКлиента.Номер);
			НастройкиОтпр.Вставить("Тело", ТекстНапоминания);
			ASP_ОтправитьПочтовоеПисьмо(ЗаказКлиента, НастройкиОтпр);
		КонецЕсли;
		
		НаборЗаписей.Записать(); 
		
		
		// ++ Петрова 1C_GTS-64 
		МенеджерЗаписи = РегистрыСведений.STOK_СинхронизацияЗаказКлиента.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.Объект = СтрРез.Заказ;
		МенеджерЗаписи.Статус = Перечисления.STOK_СтатусыСинхронизации.Изменен;
		МенеджерЗаписи.Записать(); 
					
		мСтруктураИзменений = Новый Структура;
		мСтруктураИзменений.Вставить("Модифицированность", Истина);
		мСтруктураИзменений.Вставить("Новый", Ложь);
		мСтруктураИзменений.Вставить("Статус", Ложь);
				
		мСтруктураСинхронизации = Новый Структура;
		мСтруктураСинхронизации.Вставить("Объект",СтрРез.Заказ);
		мСтруктураСинхронизации.Вставить("Статус",Перечисления.STOK_СтатусыСинхронизации.Изменен);
					
		//STOK_ОбщийМодуль.СинхронизацияОбъектов(мСтруктураСинхронизации, мСтруктураИзменений);
		// -- Петрова 1C_GTS-64
	КонецЦикла;
	
	
КонецПроцедуры   


Процедура ASP_ОтправитьПочтовоеПисьмо(ЗаказКлиента, Настройки)
    Адресат = ЗаказКлиента.Менеджер;
		
	Если НЕ Настройки.УчетнаяЗапись.Пустая() Тогда
		УчетнаяЗапись = Настройки.УчетнаяЗапись;
	Иначе
		УчетнаяЗапись = РаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
	КонецЕсли;
	
	Если НЕ РаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(УчетнаяЗапись) Тогда
		
		Комментарий = "Не удалось отправить электронное письмо - не настроена учетная запись электронной почты";
		ЗаписьЖурналаРегистрации("Уведомление об оплате заказа", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаказКлиента, ЗаказКлиента, Комментарий);
		Возврат;
		
	КонецЕсли;
	
	Попытка
		
		ПараметрыОтправки = Новый Структура;
		стрАдреса = "";
				
		АдресПочты = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Адресат, Справочники.ВидыКонтактнойИнформации.EmailПользователя);
		Если НЕ ПустаяСтрока(АдресПочты) Тогда
			стрАдреса = стрАдреса + АдресПочты + ";";
		КонецЕсли;
		
		
		
		Если ПустаяСтрока(стрАдреса) Тогда
			
			Комментарий = "Не найдены адреса получателей";
			ЗаписьЖурналаРегистрации("Уведомление об оплате заказа", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаказКлиента, ЗаказКлиента, Комментарий);	
			Возврат;
			
		Иначе
			СтроковыеФункцииКлиентСервер.УдалитьПоследнийСимволВСтроке(стрАдреса);
		КонецЕсли;
		
		ПараметрыОтправки.Вставить("Кому", стрАдреса);
		ПараметрыОтправки.Вставить("Тема", Настройки.Тема);
		ПараметрыОтправки.Вставить("Тело", Настройки.Тело);
		ПараметрыОтправки.Вставить("ТипТекста", ТипТекстаПочтовогоСообщения.ПростойТекст);
		РаботаСПочтовымиСообщениями.ОтправитьПочтовоеСообщение(УчетнаяЗапись, ПараметрыОтправки);
		
	Исключение
		
		Комментарий = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("Уведомление об оплате заказа", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаказКлиента, ЗаказКлиента, Комментарий);	
		
	КонецПопытки;	
	
КонецПроцедуры


