//sig 14/02/20 перенес в серверную функцию из клиентского общего модуля ИнтеграцияСЯндексКассойСлужебныйКлиент
Функция ASP_ИнтеграцияСЯндексКассойОткрытьФормуПлатежнойСсылкиДоп(ПараметрКоманды) экспорт
	
	Результат = ложь;
	
	//ASP_Dante 23/12/19
	Если ТипЗнч(ПараметрКоманды) = Тип("ДокументСсылка.ЗаказКлиента") и ПараметрКоманды.Проведен Тогда
		ОбъектДокумент = ПараметрКоманды.получитьОбъект();
		Товары = ОбъектДокумент.Товары;
		//ASP_Dante 18/12/19 пересчет для яндекс кассы
		Для каждого Строка Из Товары Цикл
			Строка.СуммаРучнойСкидки=Строка.СуммаРучнойСкидки+(Строка.Сумма-Окр(Строка.Сумма / Строка.Количество, 2) * Строка.Количество);
			Строка.Сумма = Окр(Строка.Сумма / Строка.Количество, 2) * Строка.Количество;
			Если ОбъектДокумент.ЦенаВключаетНДС Тогда
				Строка.СуммаСНДС = Строка.Сумма;
			Иначе
				Строка.СуммаСНДС = Строка.Сумма + Строка.СуммаНДС;
			КонецЕсли;
			
		КонецЦикла;
		ОбъектДокумент.СуммаДокумента = Товары.Итог("СуммаСНДС");
		ОбъектДокумент.Записать(РежимЗаписиДокумента.Проведение);
		//ASP_Dante 18/12/19
		
		Результат = истина;
		
	КонецЕсли;
	//ASP_Dante 23/12/19
	
	возврат Результат;

КонецФункции

Функция ПолучитьЗначениеНомераТелефона(ЭтотОбъект) Экспорт
	//ASP_Dante 12/03/20
	Для каждого Строка Из ЭтотОбъект.КонтактнаяИнформация Цикл 
		КодСтраны = "";
		КодГорода = "";
		НомерТелефона = "";
		Если Строка.Тип = Перечисления.ТипыКонтактнойИнформации.Телефон 
			И (ЗначениеЗаполнено(Строка.ЗначенияПолей) ИЛИ ЗначениеЗаполнено(Строка.Представление)) Тогда
			
			Если ПустаяСтрока(Строка.ЗначенияПолей) Тогда
				Данные = УправлениеКонтактнойИнформацией.ОписаниеНовойКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.Телефон);
				ЭтоНовый = Истина;
			ИначеЕсли УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(Строка.ЗначенияПолей) Тогда
				Данные = УправлениеКонтактнойИнформациейСлужебный.JSONВКонтактнуюИнформациюПоПолям(Строка.ЗначенияПолей, Перечисления.ТипыКонтактнойИнформации.Телефон);
			Иначе
		
				Если УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВXML(Строка.ЗначенияПолей) Тогда
					РезультатыЧтения = Новый Структура;
					КонтактнаяИнформация = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияИзXML(Строка.ЗначенияПолей, Перечисления.ТипыКонтактнойИнформации.Телефон, РезультатыЧтения);
					Если РезультатыЧтения.Свойство("ТекстОшибки") Тогда
						// Распознали с ошибками, сообщим при открытии.
						ТекстПредупрежденияПриОткрытии = РезультатыЧтения.ТекстОшибки;
						КонтактнаяИнформация.Представление   = Строка.Представление;
					КонецЕсли;
				Иначе
					КонтактнаяИнформация = УправлениеКонтактнойИнформациейСлужебный.ДесериализацияТелефона(Строка.ЗначенияПолей, Строка.Представление, Перечисления.ТипыКонтактнойИнформации.Телефон);
				КонецЕсли;
				
				Данные = УправлениеКонтактнойИнформациейСлужебный.КонтактнаяИнформацияВСтруктуруJSON(КонтактнаяИнформация, Перечисления.ТипыКонтактнойИнформации.Телефон);
				
			КонецЕсли;
			//МассивЗначений = СтрРазделить(Строка.ЗначенияПолей, "¶");
			//
			//Если МассивЗначений.Количество() > 2 Тогда
			//	КодСтраны = СтрЗаменить(МассивЗначений[0],"КодСтраны=","");
			//	КодГорода = СтрЗаменить(МассивЗначений[1],"КодГорода=","");
			//	НомерТелефона = СтрЗаменить(МассивЗначений[2],"НомерТелефона=","");
			//КонецЕсли;

			//Если НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
			//	НомерТелефона = Строка.Представление;
			//КонецЕсли;
			
			Представление = Данные.Value;
			Комментарий   = Данные.Comment;
			
			// Копия комментария для анализа измененности.
			КопияКомментария = Комментарий;
			
			КодСтраны     = Данные.CountryCode;
			КодГорода     = Данные.AreaCode;
			НомерТелефона = Данные.Number;
			Добавочный    = Данные.ExtNumber;
			
			Если НЕ ЗначениеЗаполнено(Строка.Значение) Тогда
				КонтактнаяИнформация = УправлениеКонтактнойИнформациейКлиентСервер.ОписаниеНовойКонтактнойИнформации(Перечисления.ТипыКонтактнойИнформации.Телефон);
				
				КонтактнаяИнформация.CountryCode = КодСтраны;
				КонтактнаяИнформация.AreaCode    = КодГорода;
				КонтактнаяИнформация.Number      = НомерТелефона;
				КонтактнаяИнформация.ExtNumber   = "";
				КонтактнаяИнформация.Value       = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(КодСтраны, КодГорода, НомерТелефона, "", "");
				КонтактнаяИнформация.Comment     = "";
				
				Строка.Значение = УправлениеКонтактнойИнформациейСлужебный.СтруктураВСтрокуJSON(КонтактнаяИнформация);
			КонецЕсли; 
			попытка	
				НомерСКодом = КодСтраны + КодГорода + НомерТелефона;
			исключение
				НомерСКодом = строка(КодСтраны) + строка(КодГорода) + строка(НомерТелефона);
			конецпопытки;
			Если НЕ ЗначениеЗаполнено(Строка.НомерТелефона) ИЛИ Не Строка.НомерТелефона = ИзбавитсяОтЛишнихСимволов(НомерСКодом) Тогда				
				Строка.НомерТелефона = ИзбавитсяОтЛишнихСимволов(НомерСКодом);
				Строка.НомерТелефонаБезКодов = ИзбавитсяОтЛишнихСимволов(НомерТелефона);
			КонецЕсли;
	    КонецЕсли;
	КонецЦикла;
	//ASP_Dante 12/03/20
КонецФункции // ПолучитьЗначениеНомераТелефона()

Функция ИзбавитсяОтЛишнихСимволов(Номер)

	Номер = СтрЗаменить(Номер,"(","");
	Номер = СтрЗаменить(Номер,")","");
	Номер = СтрЗаменить(Номер,"+","");
	Номер = СтрЗаменить(Номер,"-","");
	Номер = СтрЗаменить(Номер," ","");
	
	Возврат Номер;
	
КонецФункции // ИзбавитсяОтЛишнихСимволов()


Процедура ASP_РасчетВалютногоУчета() Экспорт
ДатаТекущая=ТекущаяДата();	
Для Счетчик = 1 По 2 Цикл
	ДокументЦен=Неопределено;
	Период=началомесяца(ДатаТекущая);
	Период1=началомесяца(началомесяца(ДатаТекущая)-3);
	Период2=КонецМесяца(началомесяца(ДатаТекущая)-3);
	ТЗНовыхЦен=Новый ТаблицаЗначений;
	ТЗНовыхЦен.Колонки.Добавить("Номенклатура");
    ТЗНовыхЦен.Колонки.Добавить("Характеристика");
	//ТЗНовыхЦен.Колонки.Добавить("Упаковка");
    ТЗНовыхЦен.Колонки.Добавить("ВидЦены");
	ТЗНовыхЦен.Колонки.Добавить("Цена");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановкаЦенНоменклатуры.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.УстановкаЦенНоменклатуры КАК УстановкаЦенНоменклатуры
		|ГДЕ
		|	УстановкаЦенНоменклатуры.Проведен = &Проведен
		|	И УстановкаЦенНоменклатуры.Дата = &Дата
		|	И УстановкаЦенНоменклатуры.Ответственный = &Ответственный";
	
	Запрос.УстановитьПараметр("Дата", Период);
	Запрос.УстановитьПараметр("Ответственный", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("Проведен", Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокументЦен=ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ASP_ВалютныеЦеныСрезПоследних.Цена КАК СтараяЦена,
		|	ASP_ВалютныеЦеныСрезПоследних.Номенклатура КАК Номенклатура,
		|	ASP_ВалютныеЦеныСрезПоследних.Характеристика КАК Характеристика,
		|	СУММА(ЕСТЬNULL(ТоварыНаСкладахОстатки.ВНаличииОстаток, 0)) КАК ВНаличииОстаток
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период, ) КАК ASP_ВалютныеЦеныСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыНаСкладах.Остатки(&Период, Склад.Наименование <> ""Склад В ПУТИ"") КАК ТоварыНаСкладахОстатки
		|		ПО ASP_ВалютныеЦеныСрезПоследних.Номенклатура = ТоварыНаСкладахОстатки.Номенклатура
		|			И ASP_ВалютныеЦеныСрезПоследних.Характеристика = ТоварыНаСкладахОстатки.Характеристика
		|ГДЕ
		|	ASP_ВалютныеЦеныСрезПоследних.ВидЦены = &ВидЦены
		|
		|СГРУППИРОВАТЬ ПО
		|	ASP_ВалютныеЦеныСрезПоследних.Цена,
		|	ASP_ВалютныеЦеныСрезПоследних.Номенклатура,
		|	ASP_ВалютныеЦеныСрезПоследних.Характеристика";
	
	Запрос.УстановитьПараметр("Период", Период1+1);
	Запрос.УстановитьПараметр("ВидЦены", Справочники.ВидыЦен.ВалютныйУчетCNY);

	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
	Запрос1 = Новый Запрос;
	Запрос1.Текст = 
		"ВЫБРАТЬ
		|	ASP_ВалютныйУчет.Номенклатура КАК Номенклатура,
		|	ASP_ВалютныйУчет.Характеристика КАК Характеристика,
		|	ASP_ВалютныйУчет.ЦенаВВалюте КАК ЦенаВВалюте,
		|	ЕСТЬNULL(ASP_ВалютныйУчет.Количество, 0) КАК Количество
		|ИЗ
		|	РегистрСведений.ASP_ВалютныйУчет КАК ASP_ВалютныйУчет
		|ГДЕ
		|	ASP_ВалютныйУчет.Номенклатура = &Номенклатура
		|	И ASP_ВалютныйУчет.Характеристика = &Характеристика
		|	И ASP_ВалютныйУчет.Период >= &Период1
		|	И ASP_ВалютныйУчет.Период <= &Период2
		|	И ASP_ВалютныйУчет.ВидЦены = &ВидЦены";
	
	Запрос1.УстановитьПараметр("Номенклатура", ВыборкаДетальныеЗаписи.Номенклатура);
	Запрос1.УстановитьПараметр("Период1", Период1);
	Запрос1.УстановитьПараметр("Период2", Период2);
	Запрос1.УстановитьПараметр("Характеристика", ВыборкаДетальныеЗаписи.Характеристика);
	Запрос1.УстановитьПараметр("ВидЦены", Справочники.ВидыЦен.ВалютныйУчетCNY);
	
	РезультатЗапроса1 = Запрос1.Выполнить();
	
	ВыборкаДетальныеЗаписи1 = РезультатЗапроса1.Выбрать();
	Сумма=0;
	Количество=0;  
	СуммаОтрицательного=0;
	КоличествоОтрицательного=0;	
	Пока ВыборкаДетальныеЗаписи1.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи1.Количество<0 Тогда
		СуммаОтрицательного=СуммаОтрицательного+ВыборкаДетальныеЗаписи1.ЦенаВВалюте*ВыборкаДетальныеЗаписи1.Количество;
		КоличествоОтрицательного=КоличествоОтрицательного+ВыборкаДетальныеЗаписи1.Количество;
		Иначе
		Сумма=ВыборкаДетальныеЗаписи1.ЦенаВВалюте*ВыборкаДетальныеЗаписи1.Количество+Сумма;
		Количество=ВыборкаДетальныеЗаписи1.Количество+Количество;
		КонецЕсли;
	КонецЦикла; 
	Если Сумма>0 Тогда
	СредняяЦенаНовая=Сумма/?(Количество>0,Количество,1);
	Если СуммаОтрицательного<0 Тогда
	СредняяЦенаНоваяОтриц=(Сумма+СуммаОтрицательного)/?(Количество>0,Количество-КоличествоОтрицательного,1);
	КонецЕсли;
	Иначе
	СредняяЦенаНовая=ВыборкаДетальныеЗаписи.СтараяЦена;
	КонецЕсли;
	Остаток=ВыборкаДетальныеЗаписи.ВНаличииОстаток;
	Если Остаток>0 Тогда
	НоваяЦена=(СредняяЦенаНовая*Количество+ВыборкаДетальныеЗаписи.СтараяЦена*Остаток-СуммаОтрицательного*КоличествоОтрицательного)/(Остаток+Количество+КоличествоОтрицательного);
	Иначе
	НоваяЦена=СредняяЦенаНовая;
	КонецЕсли;	
	Стр=ТЗНовыхЦен.Добавить();
	Стр.Номенклатура=ВыборкаДетальныеЗаписи.Номенклатура;
	Стр.Характеристика=ВыборкаДетальныеЗаписи.Характеристика;
	Стр.Цена=НоваяЦена;
	Стр.ВидЦены=Справочники.ВидыЦен.ВалютныйУчетCNY;
	
	КонецЦикла;

	
	//Рассчитываем цены для тех позиций, что закупаются впервые
	Запрос2 = Новый Запрос;
	Запрос2.Текст = 
		"ВЫБРАТЬ
		|	ASP_ВалютныйУчет.Номенклатура КАК Номенклатура,
		|	ASP_ВалютныйУчет.Характеристика КАК Характеристика,
		|	СУММА(ASP_ВалютныйУчет.ЦенаВВалюте) КАК ЦенаВВалюте,
		|	СУММА(ЕСТЬNULL(ASP_ВалютныйУчет.Количество, 0)) КАК Количество,
		|	СУММА(ЕСТЬNULL(ASP_ВалютныйУчет.Количество, 0) * ASP_ВалютныйУчет.ЦенаВВалюте) КАК Сумма
		|ПОМЕСТИТЬ ДвиженияНоменклатуры
		|ИЗ
		|	РегистрСведений.ASP_ВалютныйУчет КАК ASP_ВалютныйУчет
		|ГДЕ
		|	ASP_ВалютныйУчет.Период >= &Период1
		|	И ASP_ВалютныйУчет.Период <= &Период2
		|	И ASP_ВалютныйУчет.ВидЦены = &ВидЦены
		|
		|СГРУППИРОВАТЬ ПО
		|	ASP_ВалютныйУчет.Номенклатура,
		|	ASP_ВалютныйУчет.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДвиженияНоменклатуры.Номенклатура КАК Номенклатура,
		|	ДвиженияНоменклатуры.Характеристика КАК Характеристика,
		|	ДвиженияНоменклатуры.ЦенаВВалюте КАК ЦенаВВалюте,
		|	ЕСТЬNULL(ДвиженияНоменклатуры.Количество, 0) КАК Количество,
		|	ЕСТЬNULL(ДвиженияНоменклатуры.Сумма, 0) КАК Сумма,
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК СтараяЦена,
		|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура1,
		|	ЦеныНоменклатурыСрезПоследних.Характеристика КАК Характеристика1
		|ИЗ
		|	ДвиженияНоменклатуры КАК ДвиженияНоменклатуры
		|		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&Период1, ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ВалютныйУчетCNY)) КАК ЦеныНоменклатурыСрезПоследних
		|		ПО ДвиженияНоменклатуры.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
		|			И ДвиженияНоменклатуры.Характеристика = ЦеныНоменклатурыСрезПоследних.Характеристика";
	
	Запрос2.УстановитьПараметр("Период1", Период1);
	Запрос2.УстановитьПараметр("Период2", Период2);
	Запрос2.УстановитьПараметр("ВидЦены", Справочники.ВидыЦен.ВалютныйУчетCNY);
	
	
	РезультатЗапроса2 = Запрос2.Выполнить();
	
	ВыборкаДетальныеЗаписи2 = РезультатЗапроса2.Выбрать();
	Пока ВыборкаДетальныеЗаписи2.Следующий() Цикл
	Если ВыборкаДетальныеЗаписи2.СтараяЦена=0 тогда
	НоваяЦена=ВыборкаДетальныеЗаписи2.Сумма/?(ВыборкаДетальныеЗаписи2.Количество>0,ВыборкаДетальныеЗаписи2.Количество,1);
	      Если ВыборкаДетальныеЗаписи2.Количество<0 Тогда 
			СуммаОтрицательного=Сумма;
			КоличествоОтрицательного=Количество;
		КонецЕсли;

	Стр=ТЗНовыхЦен.Добавить();
	Стр.Номенклатура=ВыборкаДетальныеЗаписи2.Номенклатура;
	Стр.Характеристика=ВыборкаДетальныеЗаписи2.Характеристика;
	Стр.Цена=НоваяЦена;
	Стр.ВидЦены=Справочники.ВидыЦен.ВалютныйУчетCNY;
	КонецЕсли;	
	КонецЦикла;
	
	
	
	Если ДокументЦен=Неопределено Тогда
	Документ=Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
	Документ.Дата=Период;
	Документ.Статус=Перечисления.СтатусыУстановокЦенНоменклатуры.Согласован;
	Документ.Товары.Загрузить(ТЗновыхцен);
	Документ.Ответственный=Пользователи.ТекущийПользователь();
	Документ.Комментарий="Валютный учет CNY";
	ВидыЦены=Документ.ВидыЦен.Добавить();
	ВидыЦены.ВидЦены=Справочники.ВидыЦен.ВалютныйУчетCNY;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Иначе
	Документ=ДокументЦен.ПолучитьОбъект();
	Документ.Товары.Очистить();
	Документ.Товары.Загрузить(ТЗновыхцен);
	Документ.Ответственный=Пользователи.ТекущийПользователь();
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЕсли;
	ДатаТекущая=ДобавитьМесяц(ДатаТекущая,1);
	КонецЦикла;

КонецПроцедуры

Процедура ASP_РасчетСтоимостиРезерва() Экспорт
	СтавкаРефинансированияЦБ=7.5;
	
	ДатаК=Константы.ДатаРасчетаСтоимостиРезервов.Получить();
	Если НачалоДня(ТекущаяДата())>НачалоДня(ДатаК) Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 4
	               |	КалендарныеГрафики.Календарь,
	               |	КалендарныеГрафики.Год,
	               |	КалендарныеГрафики.ДатаГрафика,
	               |	КалендарныеГрафики.ДеньВключенВГрафик,
	               |	КалендарныеГрафики.КоличествоДнейВГрафикеСНачалаГода
	               |ИЗ
	               |	РегистрСведений.КалендарныеГрафики КАК КалендарныеГрафики
	               |ГДЕ
	               |	КалендарныеГрафики.ДеньВключенВГрафик
	               |	И КалендарныеГрафики.ДатаГрафика > &ДатаГрафика";
	Запрос.УстановитьПараметр("ДатаГрафика",ТекущаяДата());
	РабочиеДни3 = Запрос.Выполнить().Выгрузить();

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(СтоимостьТоваровСрезПоследних.Стоимость + СтоимостьТоваровСрезПоследних.СтоимостьДопРасходы, 0) * ЗаказКлиентаТовары.Количество) КАК СтоимостьТовара,
		|	ЗаказКлиентаТовары.Ссылка КАК Ссылка,
		|	ЕСТЬNULL(СрокиРезервирования.СуммаНачислено, 0) КАК СуммаНачислено,
		|	СрокиРезервирования.ДнейМакс КАК ДнейМакс,
		|	СрокиРезервирования.ОкончаниеРезервирования КАК ОкончаниеРезервирования,
		|	СрокиРезервирования.Продлено КАК Продлено,
		|	СрокиРезервирования.НачальнаяДатаРезерва КАК НачальнаяДатаРезерва,
		|	ЕСТЬNULL(СрокиРезервирования.СуммаРезерваМакс, 0) КАК СуммаРезерваМакс
		|ИЗ
		|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтоимостьТоваров.СрезПоследних(, ) КАК СтоимостьТоваровСрезПоследних
		|		ПО ЗаказКлиентаТовары.Номенклатура = СтоимостьТоваровСрезПоследних.АналитикаУчетаНоменклатуры.Номенклатура
		|			И ЗаказКлиентаТовары.Склад = СтоимостьТоваровСрезПоследних.АналитикаУчетаНоменклатуры.МестоХранения
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СрокиРезервирования КАК СрокиРезервирования
		|		ПО ЗаказКлиентаТовары.Ссылка = СрокиРезервирования.ЗаказКлиента
		|ГДЕ
		|	ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.ВАРИАНТЫОБЕСПЕЧЕНИЯ.СОСКЛАДА)
		|	И (ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.СТАТУСЫЗАКАЗОВКЛИЕНТОВ.КОБЕСПЕЧЕНИЮ)
		|			ИЛИ ЗаказКлиентаТовары.Ссылка.Статус = ЗНАЧЕНИЕ(ПЕРЕЧИСЛЕНИЕ.СТАТУСЫЗАКАЗОВКЛИЕНТОВ.КОТГРУЗКЕ))
		|	И ЗаказКлиентаТовары.Отменено = ЛОЖЬ
		|	И ЗаказКлиентаТовары.Ссылка.Проведен = ИСТИНА
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиентаТовары.Ссылка,
		|	СрокиРезервирования.ДнейМакс,
		|	СрокиРезервирования.ОкончаниеРезервирования,
		|	СрокиРезервирования.Продлено,
		|	СрокиРезервирования.НачальнаяДатаРезерва,
		|	ЕСТЬNULL(СрокиРезервирования.СуммаНачислено, 0),
		|	ЕСТЬNULL(СрокиРезервирования.СуммаРезерваМакс, 0)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		если ВыборкаДетальныеЗаписи.СуммаРезерваМакс < ВыборкаДетальныеЗаписи.СтоимостьТовара Тогда
			СуммаРезерваМакс=ВыборкаДетальныеЗаписи.СтоимостьТовара;
		Иначе 
			СуммаРезерваМакс=ВыборкаДетальныеЗаписи.СуммаРезерваМакс;
		КОНЕЦЕСЛИ;

		если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОкончаниеРезервирования) Тогда
		 	МЗ = РегистрыСведений.СрокиРезервирования.СоздатьМенеджерЗаписи();
			МЗ.ЗаказКлиента = ВыборкаДетальныеЗаписи.Ссылка;
			МЗ.ОкончаниеРезервирования = ВыборкаДетальныеЗаписи.ОкончаниеРезервирования;
			МЗ.ДнейМакс=ВыборкаДетальныеЗаписи.ДнейМакс+1;
			МЗ.Продлено=ВыборкаДетальныеЗаписи.Продлено;
			МЗ.СуммаНачислено=ВыборкаДетальныеЗаписи.СуммаНачислено+ВыборкаДетальныеЗаписи.СтоимостьТовара*(СтавкаРефинансированияЦБ/36500);
			МЗ.ПоследняяДатаРезерва=ТекущаяДата();
			если значениеЗаполнено(ВыборкаДетальныеЗаписи.НачальнаяДатаРезерва) Тогда
			МЗ.НачальнаяДатаРезерва=ВыборкаДетальныеЗаписи.НачальнаяДатаРезерва;
			Иначе 
			МЗ.НачальнаяДатаРезерва=ТекущаяДата();
			КОНЕЦЕСЛИ;
			МЗ.СуммаРезерваМакс=СуммаРезерваМакс;
			МЗ.Записать(Истина);
			
		ИНАЧЕ
			МЗ = РегистрыСведений.СрокиРезервирования.СоздатьМенеджерЗаписи();
			МЗ.ЗаказКлиента = ВыборкаДетальныеЗаписи.Ссылка;
			МЗ.ОкончаниеРезервирования = НачалоДня(РабочиеДни3[2].ДатаГрафика);
			МЗ.НачальнаяДатаРезерва=ТекущаяДата();
			МЗ.ПоследняяДатаРезерва=ТекущаяДата();
			МЗ.ДнейМакс=1;
			МЗ.Продлено=1;
			МЗ.СуммаНачислено=ВыборкаДетальныеЗаписи.СуммаНачислено+ВыборкаДетальныеЗаписи.СтоимостьТовара*(СтавкаРефинансированияЦБ/36500);
			МЗ.СуммаРезерваМакс=СуммаРезерваМакс;
			МЗ.Записать(Истина);
		КОНЕЦЕСЛИ
		
	КонецЦикла;
	ДатаКо=НачалоДня(ТекущаяДата());
	Константы.ДатаРасчетаСтоимостиРезервов.Установить(ДатаКо);
	Иначе
	КонецЕсли
	
КонецПроцедуры

//+++ {{ ASP 10.03.2021 000010119 }}
Процедура УстановитьФлагОбработкиЗаказаКлиента(ЗаказКлиента, ЗаписанВРегистрДляЗаполнения = Ложь, ЗаписанВРегистрСебестоимости = Ложь) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	МенеджерЗаписи = РегистрыСведений.ASP_ФлагиРасчетаСебестоимостиВРазрезеЗаказовДляБ24.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.ЗаказКлиента = ЗаказКлиента;
	МенеджерЗаписи.Прочитать();
	
	ЗаписанВРегистрДляЗаполненияТекущееЗначение = Ложь;
	ЗаписанВРегистрСебестоимостиТекущееЗначение = Ложь;
	
	Если МенеджерЗаписи.Выбран() Тогда
		ЗаписанВРегистрДляЗаполненияТекущееЗначение = МенеджерЗаписи.ЗаписанВРегистрДляЗаполнения;
		ЗаписанВРегистрСебестоимостиТекущееЗначение = МенеджерЗаписи.ЗаписанВРегистрСебестоимости;
	КонецЕсли;
	
	
	МенеджерЗаписи.ЗаказКлиента = ЗаказКлиента;
	МенеджерЗаписи.ЗаписанВРегистрДляЗаполнения = Макс(ЗаписанВРегистрДляЗаполненияТекущееЗначение, ЗаписанВРегистрДляЗаполнения);
	МенеджерЗаписи.ЗаписанВРегистрСебестоимости = Макс(ЗаписанВРегистрСебестоимостиТекущееЗначение, ЗаписанВРегистрСебестоимости);
	МенеджерЗаписи.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
