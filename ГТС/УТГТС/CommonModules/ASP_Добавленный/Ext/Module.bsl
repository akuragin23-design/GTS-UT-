		"ВЫБРАТЬ
		|	ОбеспечениеЗаказовОстатки.Номенклатура КАК Номенклатура,
		|	ОбеспечениеЗаказовОстатки.Характеристика КАК Характеристика,
		|	ОбеспечениеЗаказовОстатки.Склад КАК Склад,
		|	ОбеспечениеЗаказовОстатки.Назначение КАК Назначение,
		|	ОбеспечениеЗаказовОстатки.ПотребностьОстаток КАК ПотребностьОстаток,
		|	ОбеспечениеЗаказовОстатки.КЗаказуОстаток КАК КЗаказуОстаток,
		|	ОбеспечениеЗаказовОстатки.НаличиеПодЗаказОстаток КАК НаличиеПодЗаказОстаток
		|ПОМЕСТИТЬ ВременнаяТаблица
		|ИЗ
		|	РегистрНакопления.ОбеспечениеЗаказов.Остатки КАК ОбеспечениеЗаказовОстатки
		|ГДЕ
		|	ОбеспечениеЗаказовОстатки.КЗаказуОстаток < 0
		|	И ОбеспечениеЗаказовОстатки.ПотребностьОстаток = 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТоварыКПоступлениюОстатки.ДокументПоступления КАК ДокументПоступления,
		|	ТоварыКПоступлениюОстатки.Номенклатура КАК Номенклатура,
		|	ТоварыКПоступлениюОстатки.Назначение КАК Назначение,
		|	ТоварыКПоступлениюОстатки.КОформлениюНакладныхПоРаспоряжениюОстаток КАК КОформлениюНакладныхПоРаспоряжениюОстаток,
		|	ВременнаяТаблица.КЗаказуОстаток КАК КЗаказуОстаток
		|ПОМЕСТИТЬ ВременнаяТаблица1
		|ИЗ
		|	ВременнаяТаблица КАК ВременнаяТаблица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыКПоступлению.Остатки КАК ТоварыКПоступлениюОстатки
		|		ПО ВременнаяТаблица.Номенклатура = ТоварыКПоступлениюОстатки.Номенклатура
		|			И ВременнаяТаблица.Назначение = ТоварыКПоступлениюОстатки.Назначение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблица1.ДокументПоступления КАК ДокументПоступления,
		|	ВременнаяТаблица1.Номенклатура КАК Номенклатура,
		|	ВременнаяТаблица1.Назначение.Заказ КАК Заказ,
		|	ВременнаяТаблица1.Назначение КАК Назначение,
		|	ВременнаяТаблица1.КОформлениюНакладныхПоРаспоряжениюОстаток КАК КОформлениюНакладныхПоРаспоряжениюОстаток,
		|	ВременнаяТаблица1.КЗаказуОстаток КАК КЗаказуОстаток
		|ИЗ
		|	ВременнаяТаблица1 КАК ВременнаяТаблица1
		|ГДЕ
		|	ТИПЗНАЧЕНИЯ(ВременнаяТаблица1.ДокументПоступления) = ТИП(Документ.ЗаказПоставщику)
		|	И ТИПЗНАЧЕНИЯ(ВременнаяТаблица1.Назначение.Заказ) = ТИП(Документ.ЗаказКлиента)
		|	И ВременнаяТаблица1.ДокументПоступления.ASP_ОчищатьНазначенияРегламентнымЗаданием = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументПоступления";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Таблица=Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ЗаказПоставщику");
	Таблица.Колонки.Добавить("Назначение");
	Таблица.Колонки.Добавить("Номенклатура");
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
			
	//Проверяем что в заказе клиента реально нет потребности в товаре, так как по остаткам может быть повторное обеспечение	
		Запрос1 = Новый Запрос;
		Запрос1.Текст = 
			"ВЫБРАТЬ
			|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
			|	ЗаказКлиентаТовары.Отменено КАК Отменено,
			|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество,
			|	ЗаказКлиентаТовары.Ссылка.Статус КАК Статус,
			|	ЗаказКлиентаТовары.ВариантОбеспечения КАК ВариантОбеспечения
			|ИЗ
			|	Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
			|ГДЕ
			|	ЗаказКлиентаТовары.Ссылка = &Ссылка
			|	И ЗаказКлиентаТовары.Номенклатура = &Номенклатура
			|	И (ЗаказКлиентаТовары.ВариантОбеспечения = &ВариантОбеспечения и Заказклиентатовары.Обособленно)
			|	И ЗаказКлиентаТовары.Отменено = &Отменено
			|	И ЗаказКлиентаТовары.Ссылка.Статус = &Статус
			|
			|СГРУППИРОВАТЬ ПО
			|	ЗаказКлиентаТовары.Номенклатура,
			|	ЗаказКлиентаТовары.Отменено,
			|	ЗаказКлиентаТовары.Ссылка.Статус,
			|	ЗаказКлиентаТовары.ВариантОбеспечения";
		
		Запрос1.УстановитьПараметр("ВариантОбеспечения", Перечисления.ВариантыОбеспечения.КОбеспечению);
		Запрос1.УстановитьПараметр("Номенклатура", ВыборкаДетальныеЗаписи.Номенклатура);
		Запрос1.УстановитьПараметр("Отменено", Ложь);
		Запрос1.УстановитьПараметр("Ссылка", ВыборкаДетальныеЗаписи.Заказ);
		Запрос1.УстановитьПараметр("Статус", Перечисления.СтатусыЗаказовКлиентов.КОбеспечению);
		РезультатЗапроса1 = Запрос1.Выполнить();
		
		ВыборкаДетальныеЗаписи1 = РезультатЗапроса1.Выбрать();
		НайденаПотребность=Ложь;

		Пока ВыборкаДетальныеЗаписи1.Следующий() Цикл
			НайденаПотребность=Истина;
		КонецЦикла;
		Если НайденаПотребность=Ложь Тогда
			Стр= Таблица.Добавить();
			Стр.ЗаказПоставщику=ВыборкаДетальныеЗаписи.ДокументПоступления;
			Стр.Номенклатура=ВыборкаДетальныеЗаписи.Номенклатура;
			Стр.Назначение=ВыборкаДетальныеЗаписи.Назначение;
		КонецЕсли;
	КонецЦикла; 
		
	//Отбираем нужные документы заказов поставщикам и удаляем назначение, проводим его
	Счетчик=0;
	Если Таблица.Количество()>0 Тогда
		МассивЗаказов=Таблица.ВыгрузитьКолонку("ЗаказПоставщику");

        //Свертка массива заказов
		ВспомогательнаяТаблица = Новый ТаблицаЗначений;
		ВспомогательнаяТаблица.Колонки.Добавить("ЗаказПоставщику");
		Для Инд = 0 По МассивЗаказов.ВГраница() Цикл
			ВспомогательнаяТаблица.Добавить();
		КонецЦикла;
		ВспомогательнаяТаблица.ЗагрузитьКолонку(МассивЗаказов, "ЗаказПоставщику");
		ВспомогательнаяТаблица.Свернуть("ЗаказПоставщику");
		ВспомогательнаяТаблица.Сортировать("ЗаказПоставщику");
		СМассив = ВспомогательнаяТаблица.ВыгрузитьКолонку("ЗаказПоставщику");

		ТаблицаСвернутая = СМассив;
		
		Для каждого Стр2 из ТаблицаСвернутая Цикл
			ДокументОбъект=Стр2.ПолучитьОбъект();
			Для каждого Стр1 из Таблица Цикл
				Если Стр1.ЗаказПоставщику=Стр2 Тогда
					Отбор = Новый Структура();
					Отбор.Вставить("Номенклатура", Стр1.Номенклатура);
					Отбор.Вставить("Назначение", Стр1.Назначение);
					НайденноеЗначение = ДокументОбъект.Товары.НайтиСтроки(Отбор);
					Для каждого Строки из НайденноеЗначение Цикл
						Строки.Назначение=Справочники.Назначения.ПустаяСсылка()
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			ДокументОбъект.Согласован=Истина;
			ДокументОбъект.ДатаСогласования=ТекущаяДата();
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Счетчик=Счетчик+1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

