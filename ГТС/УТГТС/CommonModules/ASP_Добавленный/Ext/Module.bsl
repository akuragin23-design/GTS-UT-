	    ОтменитьТранзакцию();
	КонецПопытки;
	
	
	Выборка = РезультатЗапроса[РезультатЗапроса.Количество() - 2].Выбрать();
	СтруктураПоиска = Новый Структура("АналитикаУчетаНоменклатуры, НомерГТД");
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Регистратор)  Тогда
			ОбъектДокумент = Выборка.Регистратор.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(СтруктураПоиска, Выборка);
			
			Если ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.СборкаТоваров") ИЛИ 
				 ТипЗнч(Выборка.Регистратор) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда			
				МассивСтрок = ОбъектДокумент.ВидыЗапасовСписание.НайтиСтроки(СтруктураПоиска);
				Для каждого Строка Из МассивСтрок Цикл
					ОбъектДокумент.ВидыЗапасовСписание.Удалить(Строка);			
				КонецЦикла;			
			Иначе			
				МассивСтрок = ОбъектДокумент.ВидыЗапасов.НайтиСтроки(СтруктураПоиска);
				Для каждого Строка Из МассивСтрок Цикл
					ОбъектДокумент.ВидыЗапасов.Удалить(Строка);			
				КонецЦикла;
			КонецЕсли;
			
			ОбъектДокумент.ОбменДанными.Загрузка = Истина;
			Попытка
				ОбъектДокумент.Записать();
			Исключение
			    Сообщ = Новый СообщениеПользователю;
			    Сообщ.Текст = "Не удалось записать документ";
			    Сообщ.Сообщить();
