//получение констант с ссылками на сайт 
Функция ПолучитьСсылкуНаСайт(Ссылка)Экспорт 
	Если Ссылка = 1 Тогда
		СсылкаНаСайт = Константы.БаннерСсылкаНаТовар1.Получить();
		Возврат СсылкаНаСайт;
	ИначеЕСли Ссылка = 2 Тогда
		СсылкаНаСайт = Константы.БаннерСсылкаНаТовар2.Получить();
		Возврат СсылкаНаСайт;
	ИначеЕСли Ссылка = 3 Тогда
		СсылкаНаСайт = Константы.БаннерСсылкаНаАкцию.Получить();
		Возврат СсылкаНаСайт; 
	КонецЕсли;
КонецФункции // ПолучитьСсылкуНаСайт()

