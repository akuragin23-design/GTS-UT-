Функция ДанныеПоШтрихКодуПечатнойФормы(Штрихкод) Экспорт
	//Штрихкод = "293482266061277382568992904360782875929";
	УстановитьПривилегированныйРежим(Истина);
	ТЗДокументы = новый ТаблицаЗначений();
	ТЗДокументы.Колонки.Добавить("ПолноеИмяДокумента");
	ТЗДокументы.Колонки.Добавить("Отбор");
	МассивТипов = метаданные.регистрыСведений.РеестрДокументов.измерения.ссылка.тип.типы();
	Для каждого ЭлМТ Из МассивТипов Цикл
		ПС = новый(ЭлМТ);
		ПолноеИмя = ПС.Метаданные().ПолноеИмя();
		Если СтрНайти(ПолноеИмя, "Документ") > 0 Тогда
			СтрТЗ = ТЗДокументы.Добавить();
			СтрТЗ.ПолноеИмяДокумента = ПолноеИмя;
			СтрТЗ.Отбор = Истина;
		КонецЕсли;
	КонецЦикла;	
	
	ДанныеПоШтрихКоду = ОбщегоНазначенияУТ.ДанныеПоШтрихКодуПечатнойФормы(Штрихкод, ТЗДокументы);
	
	
	Возврат ДанныеПоШтрихКоду;
	
	
КонецФункции

