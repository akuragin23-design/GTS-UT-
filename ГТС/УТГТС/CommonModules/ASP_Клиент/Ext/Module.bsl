Процедура ASP_ОбработатьПоступлениеТоваровНаСклад() Экспорт

	ASP_ПараметрыНаКлиенте = ПараметрыПриложения["ASP_Доработки"];
	Если ASP_ПараметрыНаКлиенте = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ASP_ПараметрыНаКлиенте) <> Тип("Структура")
	 Или Не ASP_ПараметрыНаКлиенте.Свойство("ПоступлениеТоваровНаСкладКОбработке") Тогда
		Возврат;
	КонецЕсли;
	//ASP_Lebedev_000020594_08/09/2023 Параметры ожидания для отключения окна ожидания для длительной операции
	Форма = ASP_ПараметрыНаКлиенте.Форма;
	ПарОж = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
	ПарОж.ВыводитьОкноОжидания = Ложь;
	//ASP_Lebedev_000020594_08/09/2023
	ПоступлениеТоваровНаСкладКОбработке = ASP_ПараметрыНаКлиенте.ПоступлениеТоваровНаСкладКОбработке;
	
	Результат = ASP_ВызовСервера.ASP_ОбработатьПоступлениеТоваровНаСклад(ПоступлениеТоваровНаСкладКОбработке);
