Процедура ASP_ОбработатьПриобретениеТоваровУслуг() Экспорт
	
	ASP_ПараметрыНаКлиенте = ПараметрыПриложения["ASP_Доработки"];
	Если ASP_ПараметрыНаКлиенте = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ASP_ПараметрыНаКлиенте) <> Тип("Структура")
	 Или Не ASP_ПараметрыНаКлиенте.Свойство("ПриобретениеТоваровУслугКОбработке") Тогда
		Возврат;
	КонецЕсли;
	//ASP_Lebedev_000020594_08/09/2023 Параметры ожидания для отключения окна ожидания для длительной операции
	Форма = ASP_ПараметрыНаКлиенте.Форма;
	ПарОж = ДлительныеОперацииКлиент.ПараметрыОжидания(Форма);
	ПарОж.ВыводитьОкноОжидания = Ложь;
	//ASP_Lebedev_000020594_08/09/2023
	ПриобретениеТоваровУслугКОбработке = ASP_ПараметрыНаКлиенте.ПриобретениеТоваровУслугКОбработке;
	
	Результат = ASP_ВызовСервера.ASP_ОбработатьПриобретениеТоваровУслуг(ПриобретениеТоваровУслугКОбработке);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбработатьПриобретениеТоваровУслугЗавершение", ASP_Клиент);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(Результат, ОповещениеОЗавершении,ПарОж);
	
КонецПроцедуры

Процедура ОбработатьПриобретениеТоваровУслугЗавершение(Результат, ДопПараметры) Экспорт
	
	ТекстПредупреждения = Неопределено;
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Если Результат.Свойство("Статус") И Результат.Статус = "Выполнено" Тогда
			ВозвращенныйРезультат = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
			Если ТипЗнч(ВозвращенныйРезультат) <> Тип("Структура") Тогда
				Возврат;
			КонецЕсли;
			
			Если ВозвращенныйРезультат.Свойство("ИмяУведомления") Тогда
				Если ВозвращенныйРезультат.ИмяУведомления = "УжеСозданНаОснованииЗаказНаПеремещение" Тогда
					ПоказатьОповещениеПользователя("Пропущено", , "Обработка Приобретения уже выполнена ранее");
				ИначеЕсли ВозвращенныйРезультат.ИмяУведомления = "НетЗаказовПоставщикам" Тогда
					//
				ИначеЕсли ВозвращенныйРезультат.ИмяУведомления = "ПроверкаВыполнена" Тогда
					ПоказатьОповещениеПользователя("Проверено", , "доп. действие не требуется.");
				КонецЕсли;
			КонецЕсли;
			
			Если ВозвращенныйРезультат.Свойство("Уведомления") Тогда
				ОбщаяФорма = ПолучитьФорму("ОбщаяФорма.асп_ФормаУведомлений");
				ОбщаяФорма.Заголовок = "Результат обработки документа " + Строка(ВозвращенныйРезультат.ПриобретениеТоваровУслуг);
				ОбщаяФорма.Уведомления = ВозвращенныйРезультат.Уведомления;
				ОбщаяФорма.Открыть();
			КонецЕсли;
			
			Возврат;
		ИначеЕсли Результат.Свойство("КраткоеПредставлениеОшибки") И ТипЗнч(Результат.КраткоеПредставлениеОшибки) = Тип("Строка") Тогда
			ТекстПредупреждения = Результат.КраткоеПредставлениеОшибки;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ТекстПредупреждения) <> Тип("Строка") Тогда
		ТекстПредупреждения = "Произошла неизвестная ошибка. Вероятно, обработка была отменена. Подробности в журнале регистрации";
	КонецЕсли;
	
	ТекстПредупреждения = "Обработка Приобретения прервана
			|" + ТекстПредупреждения;
	
	
	ПоказатьПредупреждение( , ТекстПредупреждения);
	
	ОповеститьОбИзменении(Тип("ДокументСсылка.ЗаказНаПеремещение"));
	
КонецПроцедуры
