Процедура ПослеЗаписиИзФормы(Форма, ПараметрыЗаписи) Экспорт
	
	Объект = Форма.Объект;
	
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
		
		//++ASP_Crow 24.05.2024 000023121 Проверим на "Товары в пути" если эта схема, то данный механизм должен работать у постулпения товаров на скл
		ТоварыВПути = ASP_ВызовСервера.ПроверкаПриобретенияНаТоварыВПути(Объект.Ссылка);
		Если ТоварыВПути тогда
			Возврат
		КонецЕсли;
		//--ASP_Crow 24.05.2024 000023121
		
		//+++ {{ ASP 31.08.2020 000008181 }}
		Если ТипЗнч(ПараметрыЗаписи) = Тип("Структура")
		 И ПараметрыЗаписи.Свойство("РежимЗаписи")
		 И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ASP_ПараметрыНаКлиенте = ПараметрыПриложения["ASP_Доработки"];
			Если ASP_ПараметрыНаКлиенте = Неопределено Тогда
				ПараметрыПриложения.Вставить("ASP_Доработки", Новый Структура);
				ASP_ПараметрыНаКлиенте = ПараметрыПриложения["ASP_Доработки"];
			КонецЕсли;
			ASP_ПараметрыНаКлиенте.Вставить("ПриобретениеТоваровУслугКОбработке", Объект.Ссылка);
			ASP_ПараметрыНаКлиенте.Вставить("Форма", Форма); //ASP_Lebedev_000020594_08/09/2023 Нужно для параметров ожидания

			ПодключитьОбработчикОжидания("ASP_ОбработатьПриобретениеТоваровУслугГлоб", 0.1, Истина);
		КонецЕсли;
		//--- {{ ASP 31.08.2020 000008181 }}
			
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПоступлениеТоваровНаСклад") тогда
		//++ASP_Crow 30.01.2024 000023121 поступление товарво на ск
		Если ТипЗнч(ПараметрыЗаписи) = Тип("Структура")
		 И ПараметрыЗаписи.Свойство("РежимЗаписи")
		 И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
			ASP_ПараметрыНаКлиенте = ПараметрыПриложения["ASP_Доработки"];
			Если ASP_ПараметрыНаКлиенте = Неопределено Тогда
				ПараметрыПриложения.Вставить("ASP_Доработки", Новый Структура);
				ASP_ПараметрыНаКлиенте = ПараметрыПриложения["ASP_Доработки"];
			КонецЕсли;
			ASP_ПараметрыНаКлиенте.Вставить("ПоступлениеТоваровНаСкладКОбработке", Объект.Ссылка);
			ASP_ПараметрыНаКлиенте.Вставить("Форма", Форма); //ASP_Lebedev_000020594_08/09/2023 Нужно для параметров ожидания

			ПодключитьОбработчикОжидания("ASP_ОбработатьПоступлениеТоваровУслугГлоб", 0.1, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


Процедура УстановитьТекущуюСтрокуСписка(ИмяСобытия, Параметр, Источник, Список) Экспорт

	Если Источник = "ПодключаемоеОборудование" Тогда
		Если ИмяСобытия = "ScanData" Тогда
			Данные = МенеджерОборудованияУТКлиент.ПреобразоватьДанныеСоСканераВСтруктуру(Параметр);
			
			Состояние(НСтр("ru = 'Выполняется поиск документа по штрихкоду...'"));
			ДанныеПоШтрихКоду = ASP_ВызовСервера.ДанныеПоШтрихКодуПечатнойФормы(Данные.Штрихкод);
			
			Если ЗначениеЗаполнено(ДанныеПоШтрихКоду) Тогда
				Если ЗначениеЗаполнено(ДанныеПоШтрихКоду.КлючЗаписи) Тогда
					Список.ТекущаяСтрока = ДанныеПоШтрихКоду.КлючЗаписи;
				КонецЕсли;
			Иначе
				ШтрихкодированиеПечатныхФормКлиент.ОбъектНеНайден(Данные.Штрихкод);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

