		|			ТОГДА ЕСТЬNULL(Упаковки.НомерУпаковки, """")
		|		ИНАЧЕ ЕСТЬNULL(Марки.НомерКороба, """")
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(Марки.НомерКороба, """") = """"
		|			ТОГДА """"
		|		ИНАЧЕ ЕСТЬNULL(Упаковки.НомерУпаковки, """")
		|	КОНЕЦ
		|ИЗ
