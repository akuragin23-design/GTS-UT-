				limit_qty = ПолучитьОстаткиПоЯчейке(УзелПО, ТекущийСклад, СтрокаДока.Номенклатура, СтрокаДока.Характеристика, СтрокаДока.Ячейка);
			КонецЕсли;
			
			qty = СтрокаДока.Количество;
			
			СтруктураТекущейСтроки.Вставить("limit_qty", limit_qty);
