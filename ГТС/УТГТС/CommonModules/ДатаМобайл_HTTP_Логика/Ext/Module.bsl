	|	ДатаМобайл_ДокументыТСДСобранныеДанныеПодбор.Ссылка = &Ссылка
	|	И ДатаМобайл_ДокументыТСДСобранныеДанныеПодбор.УпаковочныйЛист <> """"
	|
