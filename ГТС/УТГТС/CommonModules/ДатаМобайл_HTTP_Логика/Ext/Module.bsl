	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕСТЬNULL(ДатаМобайл_ШаблоныДокументов.Ссылка.ДополнительныеФормыСТоваром, ЛОЖЬ)", "ВЫБОР
