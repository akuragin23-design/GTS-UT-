	Если ВерсияПО31ИлиВыше Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕСТЬNULL(ДатаМобайл_ШаблоныДокументов.Ссылка.ДополнительныеФормыСТоваром, ЛОЖЬ) КАК is_use_additional_forms", "ВЫБОР
