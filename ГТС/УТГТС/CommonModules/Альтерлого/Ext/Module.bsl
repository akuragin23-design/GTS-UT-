//+++ГТС 28.02.2021 - заполнение маркетинговых мероприятий по дополнительным сведениям в сделках, заказах, реализациях
Процедура ASP_ЗаполнениеМаркетинговыхМероприятий() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	СделкиСКлиентами.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ИсточникиПервичногоИнтереса.КаналПервичногоИнтереса) КАК КаналПервичногоИнтереса,
		|	МАКСИМУМ(ИсточникиПервичногоИнтереса.ИсточникПервичногоИнтереса) КАК ИсточникПервичногоИнтереса,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДополнительныеСведения.Свойство.Заголовок ПОДОБНО ""roistat_id""
		|				ТОГДА ДополнительныеСведения.Значение
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК roistat_id,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДополнительныеСведения.Свойство.Заголовок ПОДОБНО ""site_source""
		|				ТОГДА ДополнительныеСведения.Значение
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК site_source
		|ПОМЕСТИТЬ Сделки
		|ИЗ
		|	Справочник.СделкиСКлиентами КАК СделкиСКлиентами
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ИсточникиПервичногоИнтереса КАК ИсточникиПервичногоИнтереса
		|		ПО СделкиСКлиентами.Ссылка = ИсточникиПервичногоИнтереса.Сделка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО СделкиСКлиентами.Ссылка = ДополнительныеСведения.Объект
		|ГДЕ
		|	СделкиСКлиентами.ДатаНачала > &ДатаНачала
		|	И НЕ ДополнительныеСведения.Свойство ЕСТЬ NULL
		|	И ИсточникиПервичногоИнтереса.КаналПервичногоИнтереса ЕСТЬ NULL
		|
		|СГРУППИРОВАТЬ ПО
		|	СделкиСКлиентами.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сделки.Ссылка КАК Ссылка,
		|	Сделки.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
		|	Сделки.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
		|	Сделки.roistat_id КАК roistat_id,
		|	Сделки.site_source КАК site_source,
		|	СоответствиеМаркетинговыхМероприятий.МаркетинговоеМероприятие КАК МаркетинговоеМероприятие,
		|	СоответствиеМаркетинговыхМероприятий.КодСайта КАК КодСайта
		|ИЗ
		|	Сделки КАК Сделки
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеМаркетинговыхМероприятий КАК СоответствиеМаркетинговыхМероприятий
		|		ПО Сделки.site_source = СоответствиеМаркетинговыхМероприятий.КодСайта";
	
	Запрос.УстановитьПараметр("ДатаНачала", ТекущаяДата()-60*60*24*4);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СайтНеНашли=Справочники.МаркетинговыеМероприятия.НайтиПоКоду("0--00000001");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтереса <> ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтереса) 
		Тогда
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие)
		    Тогда
			НаборЗаписей = РегистрыСведений.ИсточникиПервичногоИнтереса.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Сделка.Установить(ВыборкаДетальныеЗаписи.Ссылка);

			Запись = НаборЗаписей.Добавить();
			Запись.Партнер                    = ВыборкаДетальныеЗаписи.Ссылка.Партнер;
			Запись.Сделка                     = ВыборкаДетальныеЗаписи.Ссылка;
			Запись.ИсточникПервичногоИнтереса = ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие;
			Запись.КаналПервичногоИнтереса    = ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие.Владелец;
			 НаборЗаписей.Записать();

		 ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.roistat_id) или ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.site_source) Тогда
			 НаборЗаписей = РегистрыСведений.ИсточникиПервичногоИнтереса.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Сделка.Установить(ВыборкаДетальныеЗаписи.Ссылка);

			Запись = НаборЗаписей.Добавить();
			Запись.Партнер                    = ВыборкаДетальныеЗаписи.Ссылка.Партнер;
			Запись.Сделка                     = ВыборкаДетальныеЗаписи.Ссылка;
			Запись.ИсточникПервичногоИнтереса = СайтНеНашли;
			Запись.КаналПервичногоИнтереса    = СайтНеНашли.Владелец;
			НаборЗаписей.Записать();

		Иначе
		КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	  Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ЗаказКлиента.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ЗаказКлиента.КаналПервичногоИнтереса) КАК КаналПервичногоИнтереса,
		|	МАКСИМУМ(ЗаказКлиента.ИсточникПервичногоИнтереса) КАК ИсточникПервичногоИнтереса,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДополнительныеСведения.Свойство.Заголовок ПОДОБНО ""roistat_id""
		|				ТОГДА ДополнительныеСведения.Значение
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК roistat_id,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ДополнительныеСведения.Свойство.Заголовок ПОДОБНО ""site_source""
		|				ТОГДА ДополнительныеСведения.Значение
		|			ИНАЧЕ NULL
		|		КОНЕЦ) КАК site_source
		|ПОМЕСТИТЬ ЗаказКлиента
		|ИЗ
		|	Документ.ЗаказКлиента КАК ЗаказКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|		ПО ЗаказКлиента.Ссылка = ДополнительныеСведения.Объект
		|ГДЕ
		|	ЗаказКлиента.Дата > &ДатаНачала
		|	И НЕ ДополнительныеСведения.Свойство ЕСТЬ NULL
		|	И ЗаказКлиента.КаналПервичногоИнтереса = ЗНАЧЕНИЕ(ПланВидовХарактеристик.КаналыРекламныхВоздействий.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗаказКлиента.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказКлиента.Ссылка КАК Ссылка,
		|	ЗаказКлиента.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
		|	ЗаказКлиента.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
		|	ЗаказКлиента.roistat_id КАК roistat_id,
		|	ЗаказКлиента.site_source КАК site_source,
		|	СоответствиеМаркетинговыхМероприятий.МаркетинговоеМероприятие КАК МаркетинговоеМероприятие,
		|	СоответствиеМаркетинговыхМероприятий.КодСайта КАК КодСайта
		|ИЗ
		|	ЗаказКлиента КАК ЗаказКлиента
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеМаркетинговыхМероприятий КАК СоответствиеМаркетинговыхМероприятий
		|		ПО ЗаказКлиента.site_source = СоответствиеМаркетинговыхМероприятий.КодСайта";

	Запрос.УстановитьПараметр("ДатаНачала", ТекущаяДата()-60*60*24*4);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	СайтНеНашли=Справочники.МаркетинговыеМероприятия.НайтиПоКоду("0--00000001");
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтереса <> ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие ИЛИ НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтереса) 
		Тогда
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие)
		    Тогда
			ОбъектСсылка=ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ОбъектСсылка.ИсточникПервичногоИнтереса = ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие;
			ОбъектСсылка.КаналПервичногоИнтереса    = ВыборкаДетальныеЗаписи.МаркетинговоеМероприятие.Владелец;
			ОбъектСсылка.Записать();
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.roistat_id) или ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.site_source) Тогда
			ОбъектСсылка=ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ОбъектСсылка.ИсточникПервичногоИнтереса = СайтНеНашли;
			ОбъектСсылка.КаналПервичногоИнтереса    = СайтНеНашли.Владелец;
			ОбъектСсылка.Записать();
		Иначе
		КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РеализацияТоваровУслуг.КаналПервичногоИнтереса КАК КаналПервичногоИнтереса,
		|	РеализацияТоваровУслуг.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтереса,
		|	ЗаказКлиента1.КаналПервичногоИнтереса КАК КаналПервичногоИнтересаЗаказ,
		|	ЗаказКлиента1.ИсточникПервичногоИнтереса КАК ИсточникПервичногоИнтересаЗаказ,
		|	РеализацияТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента КАК ЗаказКлиента1
		|		ПО РеализацияТоваровУслуг.ЗаказКлиента = ЗаказКлиента1.Ссылка
		|ГДЕ
		|	РеализацияТоваровУслуг.Дата > &Дата
		|	И РеализацияТоваровУслуг.ИсточникПервичногоИнтереса <> ЗаказКлиента1.ИсточникПервичногоИнтереса";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата()-60*60*24*4);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтереса <> ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтересаЗаказ И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтересаЗаказ) 
		Тогда
			ОбъектСсылка=ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ОбъектСсылка.ИсточникПервичногоИнтереса = ВыборкаДетальныеЗаписи.ИсточникПервичногоИнтересаЗаказ;
			ОбъектСсылка.КаналПервичногоИнтереса    = ВыборкаДетальныеЗаписи.КаналПервичногоИнтересаЗаказ;
			ОбъектСсылка.Записать();
		КонецЕсли;
	КонецЦикла;
	
		
КонецПроцедуры

