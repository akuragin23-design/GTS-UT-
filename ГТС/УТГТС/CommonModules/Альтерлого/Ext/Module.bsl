//Альтер ЛОГО Устанавливаем последнюю по дате сделку для партнера
Функция УстановитьСделку(Клиент) Экспорт
	ЗапросСделки = Новый Запрос;
	ЗапросСделки.Текст = "ВЫБРАТЬ
	|	СделкиСКлиентами.Ссылка
	|ИЗ
	|	Справочник.СделкиСКлиентами КАК СделкиСКлиентами
	|ГДЕ
	|	СделкиСКлиентами.Партнер = &Партнер
	|
	|УПОРЯДОЧИТЬ ПО
	|	СделкиСКлиентами.ДатаНачала УБЫВ";
	ЗапросСделки.УстановитьПараметр("Партнер", Клиент);
	ВыборкаСделок = ЗапросСделки.Выполнить().Выбрать();
	
	Если ВыборкаСделок.Количество() = 0 Тогда
		Возврат Неопределено
	Иначе
		ВыборкаСделок.Следующий();
		Возврат ВыборкаСделок.Ссылка;
	КонецЕсли;
КонецФункции	

/////////////////////// ПРОЧИЕ ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С КОМПЛЕКТАЦИЯМИ И СООТВЕТСТВИЯМИ СЕТ-ГТС
Функция СоответствиеНоменклатуры(Номенклатура) Экспорт
	
	Если Найти(Номенклатура.Наименование, "ГТС") > 0 тогда//находим соответствие СЕТ
		Отбор = Новый Структура("НоменклатураГТС", Номенклатура);
		Поле = "НоменклатураСЕТ";
	ИначеЕсли Найти(Номенклатура.Наименование, "СЕТ") > 0 тогда//находим соответствие ГТС
		Отбор = Новый Структура("НоменклатураСЕТ", Номенклатура);		
		Поле = "НоменклатураГТС";
	КонецЕсли;
	Рег = РегистрыСведений.СоответствиеНоменклатурыСЕТ_ГТС.Выбрать(Отбор);
	Если Рег.Следующий() тогда
		возврат Рег[Поле];
	КонецЕсли;
КонецФункции


//Асист-Про Начало Аграновский 2013-09-03
Процедура АСП_ИзменениеДатыПередЗаписьюДокументаПередЗаписью(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	// Если Дата документа конец дня 23:59:59, то откатим её на 23:59:58, для корректного обмена с БУ
	// При загрузке могут не правильно упорядочиваться документы и счет-фактуры могут загружаться не проведенные.
	Если Не Отказ И Источник.Дата = КонецДня(Источник.Дата) Тогда
		Источник.Дата = Источник.Дата - 1;		
	КонецЕсли;	
