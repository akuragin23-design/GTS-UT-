Функция ПолучитьДатуДокументаДС(Источник)
	Рез = Источник.Дата;
	
	Если Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ОплатаДенежныхСредствВДругуюОрганизацию
		ИЛИ Источник.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВозвратДенежныхСредствВДругуюОрганизацию Тогда
		
		Возврат Рез;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.ДатаПроведенияБанком) Тогда
		Рез=Источник.ДатаПроведенияБанком;
	КонецЕсли;
	
	Возврат Рез;
КонецФункции


//// КОРРЕКТИРОВКИ МЕХАНИЗМОВ ПРОВЕДЕНИЯ
Процедура ИнициироватьПерезаполнениеВидовЗапасов(Объект) Экспорт
	
	//ASP_Dante 06/10/21 Задача 000012771
	Если Объект.ДополнительныеСвойства.Свойство("НеПерезаполнятьВидЗапасов") ИЛИ Объект.ВидыЗапасовУказаныВручную Тогда 
		Возврат;
	КонецЕсли;
	//ASP_Dante 06/10/21
	// Альтер ЛОГО+:	некоторая корректировка связана с необходимостью при перепроведении 
	// ВСЕГДА перезаполнять ВидыЗапасов. Замедляет работу но делает более надежным механизм 
	// движений по регистрам ТоварыОрганизаций в разрезе ГТД
	Объект.ДополнительныеСвойства.Вставить("ПерезаполнитьВидыЗапасов", Истина);
	Объект.ВидыЗапасов.Очистить();
	// +Альтер ЛОГО
	
КонецПроцедуры

//// КОРРЕКТИРОВКА ЦЕНЫ БАЛКИ С УЧЕТОМ ДЛИНЫ
Функция КоэффициентНаценкиНаНоменклатуруСБалкой(БалкаДлина, БалкаТолщинаМеталла, БалкаВысотаПрофиля) Экспорт
	
	Коэффициент = 1;
	Если БалкаДлина <= Константы.ДлинаБалкиБезДопНаценки.Получить() тогда возврат(1) конецесли;
	
	Отбор = Новый Структура("ТолщинаМеталла, ВысотаПрофиля", БалкаТолщинаМеталла, БалкаВысотаПрофиля);
	Рег = РегистрыСведений.КоэффициентыНаценкиКомплектующихРасчетаСтелажей.СрезПоследних(ТекущаяДата(), Отбор);
	
	Если Рег.Количество() > 0 тогда
		Коэффициент = Рег[0].Коэффициент;
	Конецесли;
	
	возврат Коэффициент;
	
КонецФункции

Функция СтруктураПрофиляНоменклатуры(Профиль, Наименование) Экспорт
	
	Если ПустаяСтрока(СокрЛП(строка(Профиль))) тогда 
		возврат неопределено;
	Конецесли;
	//
	СтрокаПрофиля = Сред(Профиль, 2, СтрДлина(Профиль)-2);
	//
	ПервыйРазделитель = Найти(СтрокаПрофиля, ".");
	ВысотаПрофиля = Сред(СтрокаПрофиля, 1, ПервыйРазделитель-1);
	//
	ДлинаБалки 		= ДлинаСтойкиРаскоса(Наименование);
	МассивПрофиля 	= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаПрофиля, ".");
	ТолщинаМеталла 	= МассивПрофиля[1]+"."+МассивПрофиля[2];
	
	//
	возврат Новый Структура("ВысотаПрофиля, ТолщинаМеталла, ДлинаБалки", ВысотаПрофиля, ТолщинаМеталла, ДлинаБалки);
	
КонецФункции

Функция ЭтоПрофиль(е)
	Если Найти(е, "(")=0 ИЛИ Найти(е, ")")=0 тогда
		возврат Ложь;
	Конецесли;
	//	
	возврат СтрЧислоВхождений(е, ".") > 1;
КонецФункции

Функция ПрофильНоменклатуры(Наименование) Экспорт
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Наименование, " ");
	СтрокаПрофиля = "";
	ДлинаБалки = 0;
	Для каждого е из Массив цикл		
		Если ЭтоПрофиль(е) тогда
			возврат е;
		КонецЕсли;
	Конеццикла; 
КонецФункции

////////////////////////////////////////// РАБОТА С ЦЕНАМИ НА ИЗДЕЛИЯ С КОМПЛЕКТАЦИЯМИ ///////////////////////////////
Функция КомплектацияНоменклатуры(Номенклатура) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВариантыКомплектацииНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.ВариантыКомплектацииНоменклатуры КАК ВариантыКомплектацииНоменклатуры
	|ГДЕ
	|	ВариантыКомплектацииНоменклатуры.Основной
	|	И ВариантыКомплектацииНоменклатуры.Владелец = &Владелец
	|	И (НЕ ВариантыКомплектацииНоменклатуры.ПометкаУдаления)");
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		возврат Выборка.Ссылка;
	КонецЕсли;
КонецФункции

Функция ТаблицаЦенКомплекта(Дата, Комплектация, ВидЦены = неопределено) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТабЧасть.Ссылка.Владелец КАК Номенклатура,
	|	ТабЧасть.Номенклатура КАК Комплектующее,
	|	ТабЧасть.Характеристика,
	|	ТабЧасть.Количество
	|ИЗ
	|	Справочник.ВариантыКомплектацииНоменклатуры.Товары КАК ТабЧасть
	|ГДЕ
	|	ТабЧасть.Ссылка = &Комплектация");
	Запрос.УстановитьПараметр("Комплектация", Комплектация);
	ТаблицаКомплекта = Запрос.Выполнить().Выгрузить();
	Для каждого СтрокаКомплекта из ТаблицаКомплекта цикл
		Наименование = СтрокаКомплекта.Комплектующее.Наименование;
		Если (Найти(Наименование, "Стойка") > 0
			ИЛИ Найти(Наименование, "Раскос") > 0) И НЕ Найти(Наименование, "Связь Рама-Стойка 1000 мм под 70") >0  тогда
			БазовоеНаименование = БазовоеНаименованиеНоменклатуры(Наименование);
			БазоваяНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(БазовоеНаименование);
			Если Не ЗначениеЗаполнено(БазоваяНоменклатура) тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена базовая номенклатура (м.) для "+Наименование+". Цена на комплектующее не может быть расчитана");
				продолжить;
			Конецесли;
			//
			Длина = ДлинаСтойкиРаскоса(Наименование)/1000;
			СтрокаКомплекта.Комплектующее = БазоваяНоменклатура;
			СтрокаКомплекта.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПустаяСсылка();
			СтрокаКомплекта.Количество = Длина * СтрокаКомплекта.Количество;
		Конецесли;
	Конеццикла;
	//
	КоэффициентЦены = КоэффициентЦеныНоменклатурыСБалкой(Комплектация.Владелец);
	//
	Текст =
	"ВЫБРАТЬ
	|	ТаблицаКомплекта.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(ТаблицаКомплекта.Комплектующее КАК Справочник.Номенклатура) КАК Комплектующее,
	|	ТаблицаКомплекта.Характеристика,
	|	ТаблицаКомплекта.Количество
	|ПОМЕСТИТЬ ТаблицаКомплекта
	|ИЗ
	|	&ТаблицаКомплекта КАК ТаблицаКомплекта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКомплекта.Количество * ЕСТЬNULL(Цены.Цена, 0) * ВЫБОР
	|		КОГДА ТаблицаКомплекта.Комплектующее.Наименование ПОДОБНО ""Балка%""
	|			ТОГДА &КоэффициентЦены
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Цена,
	|	Цены.Цена КАК ЦенаЗаЕдиницу,
	|	Цены.ВидЦены,
	|	ТаблицаКомплекта.Количество КАК Количество,
	|	ТаблицаКомплекта.Комплектующее,
	|	Цены.Упаковка КАК Упаковка,
	|	Цены.Валюта КАК Валюта
	|ИЗ
	|	ТаблицаКомплекта КАК ТаблицаКомплекта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&ДатаСреза,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							ВТ.Комплектующее
	|						ИЗ
	|							ТаблицаКомплекта КАК ВТ)
	|					И ВЫБОР
	|						КОГДА &ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ВидЦены = &ВидЦены
	|					КОНЕЦ) КАК Цены
	|		ПО ТаблицаКомплекта.Комплектующее = Цены.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ТаблицаКомплекта.Количество * ЕСТЬNULL(Цены.Цена, 0) * ВЫБОР
	|			КОГДА ТаблицаКомплекта.Комплектующее.Наименование ПОДОБНО ""Балка%""
	|				ТОГДА &КоэффициентЦены
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК Цена,
	|	Цены.ВидЦены,
	|	ТаблицаКомплекта.Характеристика,
	|	ТаблицаКомплекта.Номенклатура,
	|	МАКСИМУМ(Цены.Упаковка) КАК Упаковка,
	|	МАКСИМУМ(Цены.Валюта) КАК Валюта
	|ИЗ
	|	ТаблицаКомплекта КАК ТаблицаКомплекта
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|				&ДатаСреза,
	|				Номенклатура В
	|						(ВЫБРАТЬ
	|							ВТ.Комплектующее
	|						ИЗ
	|							ТаблицаКомплекта КАК ВТ)
	|					И ВЫБОР
	|						КОГДА &ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|							ТОГДА ИСТИНА
	|						ИНАЧЕ ВидЦены = &ВидЦены
	|					КОНЕЦ) КАК Цены
	|		ПО ТаблицаКомплекта.Комплектующее = Цены.Номенклатура
	|
	|СГРУППИРОВАТЬ ПО
	|	Цены.ВидЦены,
	|	ТаблицаКомплекта.Характеристика,
	|	ТаблицаКомплекта.Номенклатура";
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("ДатаСреза", Дата);
	Запрос.УстановитьПараметр("ТаблицаКомплекта", ТаблицаКомплекта);
	Запрос.УстановитьПараметр("КоэффициентЦены", КоэффициентЦены);
	Запрос.УстановитьПараметр("ВидЦены", ?(ВидЦены = неопределено, Справочники.ВидыЦен.ПустаяСсылка(), ВидЦены));
	
	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаРезультат = Результат[2].Выгрузить();
	
	возврат ТаблицаРезультат;
	
КонецФункции

Функция БазовоеНаименованиеНоменклатуры(Наименование) Экспорт
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Наименование, " ");
	БазовоеНаименование = "";
	Для каждого е из Массив цикл
		Если ПустаяСтрока(СокрЛП(е)) тогда продолжить конецесли;
		//
		Если Найти(е, "Стойка")>0
			ИЛИ Найти(е, "Раскос")>0
			ИЛИ Найти(е, "СЕТ")>0
			ИЛИ Найти(е, "ГТС")>0
			ИЛИ (Найти(е, "(")>0 И Найти(е, ")")>0) тогда
			//
			ОбработатьПрофиль(е);
			//
			Если Найти(Наименование, "Раскос")>0
				И Найти(е, "(")>0 И Найти(е, ")")>0 тогда
				е = "(100.1.5)";
			КонецЕсли;
			БазовоеНаименование = БазовоеНаименование + е + " ";
		КонецЕсли;
	Конеццикла;
	//
	БазовоеНаименование = СокрЛП(БазовоеНаименование);
	// Замена СЕТ на ГТС
	БазовоеНаименование = СтрЗаменить(БазовоеНаименование, "ГТС", "СЕТ");
	//
	возврат БазовоеНаименование
КонецФункции

Процедура ОбработатьПрофиль(е, БезСкобок = ложь) Экспорт
	// является ли данное слово профилем
	Если НЕ БезСкобок тогда
		Если Найти(е, ")")=0 или Найти(е, "(")=0 тогда возврат конецесли;
	КонецЕсли;
	
	// разложим внутрянку на части
	Если БезСкобок тогда
		Профиль = е;
	Иначе
		Профиль = Сред(е, 2, СтрДлина(е)-2);
	КонецЕсли;
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Профиль, ".");
	Если Массив.Количество() < 3 тогда возврат конецесли;
	Строчка = "";
	Для п = 0 по 2 цикл
		Строчка = Строчка + Массив[п] + ?(п = 2, "", ".");
	КонецЦикла;
	
	Если БезСкобок тогда
		е = Строчка;
	Иначе
		е = "("+Строчка+")";
	КонецЕсли;
	
КонецПроцедуры

Функция ДлинаСтойкиРаскоса(Наименование) Экспорт
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Наименование, " ");
	СтрокаПараметра = Массив[2];
	Если Найти(СтрокаПараметра, "/")>0 тогда
		пм = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаПараметра, "/");
		Строкапараметра = пм[0];
	КонецЕсли;
	Попытка
		Длина = Число(СтрокаПараметра);
	Исключение
		Длина = 0;
	КонецПопытки;
	//	
	возврат Длина;
КонецФункции

Функция КоэффициентЦеныНоменклатурыСБалкой(Номенклатура) Экспорт
	КоэффициентЦены = 1;
	Наименование = Номенклатура.Наименование;
	Если Найти(ВРег(Наименование), "БАЛКА")>0 тогда
		Если НЕ (Найти(Наименование, "ГТСБ") > 0 ИЛИ Найти(Наименование, "СЕТБ") > 0) тогда
			Профиль = АльтерЛОГО.ПрофильНоменклатуры(Наименование);
			СтруктураПрофиля = АльтерЛого.СтруктураПрофиляНоменклатуры(Профиль, Номенклатура.Наименование);
			КоэффициентЦены = АльтерЛого.КоэффициентНаценкиНаНоменклатуруСБалкой(СтруктураПрофиля.ДлинаБалки, 
			СтруктураПрофиля.ТолщинаМеталла, 
			СтруктураПрофиля.ВысотаПрофиля);
		КонецЕсли;
	КонецЕсли;
	возврат КоэффициентЦены;																		
КонецФункции

Функция РасчитатьЦенуПоКомплекту(Номенклатура, Комплектация = неопределено) Экспорт
	Если Комплектация = неопределено тогда
		Комплектация = Альтерлого.КомплектацияНоменклатуры(Номенклатура);
	Конецесли;
	Наименование = Номенклатура.Наименование;
	//ГТС рассчитываем цену стойки
	Если Найти(Наименование, "Стойка СЕТ")>0  или Найти(Наименование, "Раскос СЕТ")>0 
		ИЛИ (Найти(Наименование, "Стеллаж металлический паллетный, ") > 0 )
		ИЛИ (Найти(Наименование, "Секция приставная стеллажа металлического паллетного, ") > 0 )
		ИЛИ (Найти(Наименование, "Две секции стеллажа металлического паллетного,") > 0 )
		Тогда 
		возврат истина;
	КонецЕсли;
		
		
	Если НЕ ЗначениеЗаполнено(Комплектация) тогда
		возврат ложь;
	Иначе
		Наименование = Номенклатура.Наименование;
		Если (
			(Найти(Наименование, "ГТС") > 0 ИЛИ  Найти(Наименование, "СЕТ") > 0)
			И Найти(ВРег(Наименование), "РЕАЛИЗАЦ") > 0
			)
			ИЛИ (
			Найти(Наименование, "ГТС") = 0 
			И Найти(Наименование, "СЕТ") = 0
			И Найти(Наименование, "Рама") = 0 
			И Найти(Наименование, "Балка") = 0 
			//ИЛИ 
			//(Найти(Наименование, "жесткости") > 0 И Найти(Наименование, "Балка") > 0)
			//ИЛИ (Найти(Наименование, "Ограничитель СЕТП") > 0 )
			ИЛИ
			(Найти(Наименование, "Настил") > 0 И Найти(Наименование, "СЕТ") > 0))
			ИЛИ (Найти(Наименование, "Отбойник СЕТП") > 0 И НЕ Найти(Наименование, "боковой") > 0 )
			ИЛИ (Найти(Наименование, "Связь СЕТО") > 0 )
			ИЛИ (Найти(Наименование, "Балка СЕТ") > 0 И Найти(Наименование, "(70.") > 0 )
			ИЛИ (Найти(Наименование, "Связь Рама-Стойка") > 0 )
			Тогда
			возврат ложь;
		Иначе
			возврат истина;
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция ЦенаСтойки(Дата, Номенклатура, ВидЦены = неопределено) Экспорт
		Наименование = Номенклатура.Наименование;
		Если Найти(Наименование, "Стойка") > 0
			ИЛИ Найти(Наименование, "Раскос") > 0 тогда
			БазовоеНаименование = БазовоеНаименованиеНоменклатуры(Наименование);
			БазоваяНоменклатура = Справочники.Номенклатура.НайтиПоНаименованию(БазовоеНаименование);
			Если Не ЗначениеЗаполнено(БазоваяНоменклатура) тогда 
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не найдена базовая номенклатура (м.) для "+Наименование+". Цена на комплектующее не может быть расчитана");
			Конецесли;
			//
			Длина = ДлинаСтойкиРаскоса(Наименование)/1000;
		Конецесли;
	
	//
	//КоэффициентЦены = КоэффициентЦеныНоменклатурыСБалкой(Комплектация.Владелец);
	//
	Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(Цены.Цена, 0) КАК Цена,
	|	Цены.ВидЦены КАК ВидЦены,
	|	Цены.Упаковка КАК Упаковка,
	|	Цены.Валюта КАК Валюта
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаСреза,
	|			Номенклатура = &Номенклатура
	|				И ВЫБОР
	|					КОГДА &ВидЦены = ЗНАЧЕНИЕ(Справочник.ВидыЦен.ПустаяСсылка)
	|						ТОГДА ИСТИНА
	|					ИНАЧЕ ВидЦены = &ВидЦены
	|				КОНЕЦ) КАК Цены";
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("ДатаСреза", Дата);
	Запрос.УстановитьПараметр("Номенклатура", БазоваяНоменклатура);
	Запрос.УстановитьПараметр("ВидЦены", ?(ВидЦены = неопределено, Справочники.ВидыЦен.ПустаяСсылка(), ВидЦены));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для каждого СтрокаРезультата из РезультатЗапроса цикл
	Возврат ?(значениезаполнено(СтрокаРезультата.Цена),СтрокаРезультата.Цена*Длина,0);
	КонецЦикла;
	Возврат 0;
КонецФункции


Функция ЦенаНоменклатурыПоКомплекту(Номенклатура, Дата, ВидЦены,Цен=0,Коэф=1) Экспорт
	//Проверяем и возвращаем установленную цену если она есть, ГТС 06.11.2020
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена
		|ИЗ
		|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
		|			&Дата,
		|			Номенклатура = &Номенклатура
		|				И Цена = &ВидЦены) КАК ЦеныНоменклатурыСрезПоследних";
	
	Запрос.УстановитьПараметр("ВидЦены", ВидЦены);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.Цена>0 Тогда
			возврат окр(ВыборкаДетальныеЗаписи.Цена);
		КонецЕсли;
	КонецЦикла;
	
	//КонецВозвратаТекЦены
	//ГТС добавляем расчет стойки отдельно без комплектаций уже
	Если Найти(Номенклатура.Наименование, "Стойка СЕТ")>0 или Найти(Номенклатура.Наименование, "Раскос СЕТ")>0 Тогда 
		ЦенаСтойки = АльтерЛОГО.ЦенаСтойки(Дата, Номенклатура, ВидЦены);
		Если ЦенаСтойки > 0 тогда
//		возврат окр(ЦенаСтойки);
		возврат окр(ЦенаСтойки,0);
		Иначе 
		возврат 0;
		КонецЕсли;
	КонецЕсли;
	
	Комплектация = Альтерлого.КомплектацияНоменклатуры(Номенклатура);
	ТЗ = АльтерЛОГО.ТаблицаЦенКомплекта(Дата, Комплектация, ВидЦены);
	Если ТЗ.Количество() > 0 тогда
	ТЗ.Сортировать("Цена УБЫВ");
	возврат окр(ТЗ[0].Цена);
	КонецЕсли;
КонецФункции

