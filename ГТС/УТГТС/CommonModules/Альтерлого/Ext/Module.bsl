
//// ВПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ РЕГИСТРАЦИИ ДАННЫХ ДЛЯ ОБМЕНА
Процедура ВыполнитьСверкуИРегистрациюОбъектовДляОбмена() экспорт
	//
	СтрокаПодключения = "Srvr=""gts-server6"";Ref=""buh82"";Usr=""COMUsr"";Pwd=""123456""";
	
	//
	Коннектор = Новый COMОбъект("V83.COMConnector");
	Подключение = Коннектор.Connect(СтрокаПодключения);
	Узел = ПланыОбмена.ОбменУправлениеТорговлейБухгалтерияПредприятия30.НайтиПоКоду("002");
	
	
	
	//
	Поля = СписокПолейЗапроса("Номенклатура");
	Массив = СверкаСправочника("Справочник.Номенклатура", Поля, "Наименование",,Подключение);
	ЗарегистрироватьСсылки(Массив,Узел);
	//
	Поля = СписокПолейЗапроса("НомераГТД");
	Массив = СверкаСправочника("Справочник.НомераГТД", Поля, "Код",,Подключение);
	ЗарегистрироватьСсылки(Массив,Узел);
	
	//
	Поля = СписокПолейЗапроса("Контрагенты");
	Массив = СверкаСправочника("Справочник.Контрагенты", Поля, "Наименование",,Подключение);
	ЗарегистрироватьСсылки(Массив,Узел);
	
	//
	Поля = СписокПолейЗапроса("СчетНаОплату");
	Массив = СверкаСправочника("Документ.СчетНаОплатуПокупателю", Поля, "Номер", "Документ.ЗаказКлиента",Подключение);
	ЗарегистрироватьСсылки(Массив,Узел);
	
	//
	Поля = СписокПолейЗапроса("СтатьиЗатрат");
	Массив = СверкаСправочника("Справочник.СтатьиЗатрат", Поля, "Наименование", "ПланВидовХарактеристик.СтатьиРасходов",Подключение);
	ЗарегистрироватьСсылки(Массив,Узел);
	
	
	// Сверка наличия документов
	ВидСверки=0;
	Массив = СверкаДокументов(ВидСверки,Подключение);
	ЗарегистрироватьСсылки(Массив,Узел);
	
	
КонецПроцедуры

Функция СписокПолейЗапроса(Таблица)
	
	Поля = Новый Массив();
	Если Таблица = "Номенклатура" тогда
		Поля.Добавить("Наименование");
		Поля.Добавить("Код");
	ИначеЕсли Таблица = "НомераГТД" тогда
		Поля.Добавить("Код");		
	ИначеЕсли Таблица = "Контрагенты" тогда
		Поля.Добавить("Наименование");
		Поля.Добавить("ИНН");
	ИначеЕсли Таблица = "СчетНаОплату" тогда
		Поля.Добавить("Номер");
		Поля.Добавить("Дата");
	ИначеЕсли Таблица = "СтатьиЗатрат" тогда
		Поля.Добавить("Наименование");
	Конецесли;
	
	возврат Поля;
	
КонецФункции

Функция СверкаСправочника(Таблица, Поля, ПолеНеопределенности, ТаблицаУТ = неопределено,Коннектор)
	
	//
	ПоляСтр = "";
	Для каждого е из Поля цикл
		ПоляСтр = ПоляСтр + "Таб." + е + ?(е = "Дата", " КАК ДатаДок", "") + ?(Поля.Найти(е)+1 = Поля.Количество(), "", ",");
	Конеццикла;
	//
	УсловиеСвязи = "";
	Для каждого е из Поля цикл
		УсловиеСвязи = УсловиеСвязи + "ВТ_УТ."+?(е = "Дата", "ДатаДок", е)+" = ВТ_БП."+?(е = "Дата", "ДатаДок", е)+?(Поля.Найти(е)+1 = Поля.Количество(), "", " И ");
	Конеццикла;
	//
	
	Текст = 
	"ВЫБРАТЬ
	|	"+ПоляСтр+", Ссылка
	|ИЗ
	|	"+Таблица+" КАК Таб";
	Если Найти(Таблица, "Документ") тогда
		Текст = Текст + "
		|ГДЕ
		|	Таб.Дата > &ДатаНачалаПроверки";
	КонецЕсли;
	Запрос = Коннектор.NewObject("Запрос");
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ДатаНачалаПроверки", КонецДня(Константы.ДатаКонтроляВыгрузкиДокументовВБП.Получить()));
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	
	ДанныеБП = Новый ТаблицаЗначений();
	Для каждого е из Поля цикл
		Если е = "Наименование" тогда
			Квалификатор = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100));
		Иначеесли (е = "Код" или е = "Номер") и НЕ(Таблица = "Справочник.НомераГТД") тогда
			Квалификатор = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(11));
		Иначеесли е = "Код" и (Таблица = "Справочник.НомераГТД") тогда
			Квалификатор = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30));
		Иначеесли е = "ИНН" тогда
			Квалификатор = Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(12));
		Иначеесли е = "Дата" тогда
			Квалификатор = Новый ОписаниеТипов("Дата");
		Иначе
			Квалификатор = неопределено;
		Конецесли;
		ДанныеБП.Колонки.Добавить(?(е = "Дата", "ДатаДок", е), Квалификатор);
	Конеццикла;
	
	Для каждого е из ТЗ цикл
		СтрокаТЗ = ДанныеБП.Добавить();
		Для каждого к из Поля цикл
			Имя = ?(к = "Дата", "ДатаДок", к);
			СтрокаТЗ[Имя] = е[Имя];
		Конеццикла;
	Конеццикла;
	//
	Если ЗначениеЗаполнено(ТаблицаУТ) тогда
		Текст = СтрЗаменить(Текст, Таблица, ТаблицаУТ);
	Конецесли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("ДатаНачалаПроверки", КонецДня(Константы.ДатаКонтроляВыгрузкиДокументовВБП.Получить()));
	ДанныеУТ = Запрос.Выполнить().Выгрузить();
	
	//
	ПоляСтр = "";
	Для каждого е из Поля цикл
		ПоляСтр = ПоляСтр + "Таб." + ?(е = "Дата", "ДатаДок", е) + ?(Поля.Найти(е)+1 = Поля.Количество(), "", ",");
	Конеццикла;
	
	//
	Текст = 
	"ВЫБРАТЬ
	|	"+ПоляСтр+"
	|ПОМЕСТИТЬ ВТ_БП
	|ИЗ
	|	&ДанныеБП КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	"+ПоляСтр+",
	|	Ссылка
	|ПОМЕСТИТЬ ВТ_УТ
	|ИЗ
	|	&ДанныеУТ КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Вложение.Ссылка,
	|	Вложение.Поле
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_УТ.Ссылка КАК Ссылка,
	|		ЕСТЬNULL(ВТ_БП."+ПолеНеопределенности+", НЕОПРЕДЕЛЕНО) КАК Поле
	|	ИЗ
	|		ВТ_УТ КАК ВТ_УТ
	|			ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БП КАК ВТ_БП
	|			ПО "+УсловиеСвязи+") КАК Вложение
	|ГДЕ
	|	Вложение.Поле = НЕОПРЕДЕЛЕНО";
	
	Запрос.Текст = Текст;
	Запрос.УстановитьПараметр("ДанныеБП", ДанныеБП);
	Запрос.УстановитьПараметр("ДанныеУТ", ДанныеУТ);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Мас = ТЗ.ВыгрузитьКолонку("Ссылка");
	
	///
	возврат Мас;
	
КонецФункции

//
Функция ЗарегистрироватьСсылки(Массив,Узел)
	
	Для каждого е из Массив цикл
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, е);
	Конеццикла;
	
КонецФункции

// Функции сверки наличия документов
Функция СверкаДокументов(ТипСверки=0,Подключение) Экспорт
	
	//
	Список = Новый СписокЗначений();
	Список.Добавить("АвансовыйОтчет",							"Авансовый отчет");
	Список.Добавить("ОтчетКомиссионера",						"Отчет комиссионера о продажах");
	Список.Добавить("ПеремещениеТоваров", 						"Перемещение товаров");
	Список.Добавить("ПересортицаТоваров", 						"Пересортица товаров");
	Список.Добавить("ПоступлениеБезналичныхДенежныхСредств",	"Поступление безналичных ден.средств");
	Список.Добавить("ПоступлениеТоваровУслуг", 					"Поступление товаров и услуг");
	Список.Добавить("ПриходныйКассовыйОрдер",					"Приходный кассовый ордер");
	Список.Добавить("РасходныйКассовыйОрдер", 					"Расходный кассовый ордер");
	Список.Добавить("РеализацияТоваровУслуг", 					"Реализация товаров и услуг");
	Список.Добавить("СборкаТоваров",							"Сборка (разборка) товаров");
	Список.Добавить("СписаниеБезналичныхДенежныхСредств", 		"Списание безналичных ден.средств");
	Список.Добавить("СписаниеНедостачТоваров",					"Списание товаров");
	Список.Добавить("СчетФактураВыданный", 						"Счет-фактура выданный");
	Список.Добавить("СчетФактураВыданныйАванс",					"Счет-фактура выданный на аванс");
	Список.Добавить("СчетФактураПолученный",				    "Счет-фактура полученный");
	Список.Добавить("СчетФактураПолученныйАванс",				"Счет-фактура полученный на аванс");
	Список.Добавить("ВозвратТоваровОтКлиента"	,				"Возврат товаров от клиента");
	Список.Добавить("ВнутреннееПотреблениеТоваров",				"Внутреннее потребление товаров");
	Список.Добавить("СписаниеЗадолженности",					"Списание задолженности");
	Список.Добавить("ОперацияПоПлатежнойКарте", 				"Операция по платежной карте"); //ASP__A.Zhel 24.01.2019  Добавлям эквайринговые операции__ASP 			
	//Список.Добавить("ВзаимозачетЗадолженности",					"КорректировкаДолга");
	
	
	
	//
	СтруктураСверки = Новый Структура();
	Для каждого СтрокаСписка из Список цикл
		ИмяМетаданных = СтрокаСписка.Значение;
		Структура = СтруктураДокументовБП(ИмяМетаданных, Подключение);
		//
		ПолеПроверкиСовпаденияСклада=" ";
		ПолеНаименованиеСкладаБП=" ";
		ПолеНаименованиеСкладаУТ=" ";
		ПоляНаименованийСкладов=" ";
		Если ТипСверки = 0 тогда
			//ASP. Добавлена сверка по складам в документах	
			Если ИмяМетаданных = "СборкаТоваров" Или  ИмяМетаданных = "РеализацияТоваровУслуг" Или  ИмяМетаданных = "ПеремещениеТоваров" Тогда
				СтрокаУсловия = " Вложение.ДокументНеНайден Или Вложение.СкладНеСовпадает ";
				ПолеПроверкиСовпаденияСклада=", ВЫБОР КОГДА НайденныеСсылки.НаименованиеСкладаУТ<>НайденныеСсылки.НаименованиеСкладаБП ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ  КАК СкладНеСовпадает ";
				ПолеНаименованиеСкладаБП=", ТаблицаДанных.НаименованиеСклада КАК НаименованиеСклада "; 
				ПолеНаименованиеСкладаУТ=", Выб.НаименованиеСклада КАК НаименованиеСклада "; 
				ПоляНаименованийСкладов=", ДанныеУТ.НаименованиеСклада КАК НаименованиеСкладаУТ,  ДанныеБП.НаименованиеСклада КАК НаименованиеСкладаБП  "; 
				
			Иначе
				СтрокаУсловия = "Вложение.ДокументНеНайден";				
			КонецЕсли;
		Иначе
			СтрокаУсловия = "(Вложение.ПометкаУдаления<>Вложение.Ссылка.ПометкаУдаления "+?(ИмяМетаданных = "СчетФактураВыданный", "","ИЛИ
			|	Вложение.Проведен<>Вложение.Ссылка.Проведен")+")
			|И (НЕ Вложение.ДокументНеНайден)";
		Конецесли;
		//
		СтрокаПроверкиПоТабЧасти =  ?(ИмяМетаданных = "ПриобретениеТоваровУслуг" ИЛИ ИмяМетаданных = "РеализацияТоваровУслуг"
		ИЛИ ИмяМетаданных = "ПеремещениеТоваров" ИЛИ ИмяМетаданных = "СборкаТоваров",
		"			И ДанныеБП.Количество = ДанныеУТ.Количество									
		|			И ДанныеБП.КодНоменклатуры = ДанныеУТ.КодНоменклатуры", "");
		//
		Если ИмяМетаданных = "ПересортицаТоваров" тогда
			СтрокаСоединения = "		ПО ДанныеБП.Дата = ДанныеУТ.Дата И ДанныеБП.Сумма = ДанныеУТ.Сумма";
		Иначе
			СтрокаСоединения = "		ПО ДанныеБП.ПроизводныйНомер = ДанныеУТ.ПроизводныйНомер
			|			И ДанныеБП.Сумма = ДанныеУТ.Сумма
			|			И НАЧАЛОПЕРИОДА(ДанныеБП.Дата, ДЕНЬ) = НАЧАЛОПЕРИОДА(ДанныеУТ.Дата, ДЕНЬ) "+СтрокаПроверкиПоТабЧасти;
		Конецесли;
		
		//
		Текст =
		"ВЫБРАТЬ
		|	ТаблицаДанных.Дата,
		|	ТаблицаДанных.Номер,
		|	ВЫРАЗИТЬ(ТаблицаДанных.ПроизводныйНомер КАК СТРОКА("+?(ИмяМетаданных = "СчетФактураПолученный", "30", "7") + ")) КАК ПроизводныйНомер,
		|	ТаблицаДанных.Проведен,
		|	ТаблицаДанных.ПометкаУдаления" + ?(ПустаяСтрока(СтрокаПроверкиПоТабЧасти), "", ",
		|	ТаблицаДанных.Количество КАК Количество, 
		|	ТаблицаДанных.КодНоменклатуры КАК КодНоменклатуры")+", 
		|	ТаблицаДанных.Сумма КАК Сумма "
		//ASP. Добавлена сверка по складам в документах		
		+ПолеНаименованиеСкладаБП+
		"ПОМЕСТИТЬ ДанныеБП
		|ИЗ
		|	&ТаблицаБП КАК ТаблицаДанных
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Выб.Ссылка,
		|	Выб.ПроизводныйНомер,
		|	Выб.Дата" + ?(ПустаяСтрока(СтрокаПроверкиПоТабЧасти), "", ",
		|	Выб.Количество КАК Количество, 
		|	Выб.КодНоменклатуры КАК КодНоменклатуры")+", 
		|	Выб.Сумма КАК Сумма "
		//ASP. Добавлена сверка по складам в документах		
		+ ПолеНаименованиеСкладаУТ+ 
		" ПОМЕСТИТЬ ДанныеУТ
		|ИЗ
		|	&ТаблицаУТ КАК Выб
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеУТ.Ссылка,
		|	ДанныеБП.Проведен,
		|	ДанныеБП.ПометкаУдаления" 
		+?(ПустаяСтрока(СтрокаПроверкиПоТабЧасти), " "," ,	ДанныеУТ.КодНоменклатуры ")
		+ПоляНаименованийСкладов+
		" ПОМЕСТИТЬ НайденныеСсылки
		|ИЗ
		|	ДанныеБП КАК ДанныеБП
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеУТ КАК ДанныеУТ
		|		"+СтрокаСоединения+"		
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Вложение.Ссылка,
		|	Вложение.ДокументНеНайден,
		|	Вложение.Проведен,
		| 	Вложение.ПометкаУдаления
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДанныеУТ.Ссылка КАК Ссылка,
		|		ВЫБОР
		|			КОГДА НайденныеСсылки.Ссылка ЕСТЬ NULL" + ?(ПустаяСтрока(СтрокаПроверкиПоТабЧасти), "", "
		|					ИЛИ НайденныеСсылки.КодНоменклатуры ЕСТЬ NULL")+"
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ КАК ДокументНеНайден,
		|		НайденныеСсылки.Проведен,
		|		НайденныеСсылки.ПометкаУдаления "
		//ASP. Добавлена сверка по складам в документах
		+ПолеПроверкиСовпаденияСклада+
		"	ИЗ
		|		ДанныеУТ КАК ДанныеУТ
		|			ЛЕВОЕ СОЕДИНЕНИЕ НайденныеСсылки КАК НайденныеСсылки
		|			ПО ДанныеУТ.Ссылка = НайденныеСсылки.Ссылка" + ?(ПустаяСтрока(СтрокаПроверкиПоТабЧасти), "", "
		|				И ДанныеУТ.КодНоменклатуры = НайденныеСсылки.КодНоменклатуры")+") КАК Вложение
		|ГДЕ
		|	"+СтрокаУсловия+"
		|СГРУППИРОВАТЬ ПО
		|	Вложение.Ссылка,
		|	Вложение.ДокументНеНайден,
		|	Вложение.Проведен,
		| 	Вложение.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО 
		|	Вложение.Ссылка.Дата
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		Запрос = Новый Запрос(Текст);
		Запрос.УстановитьПараметр("ТаблицаБП", Структура.ТаблицаБП);
		Запрос.УстановитьПараметр("ТаблицаУТ", Структура.ТаблицаУТ);
		
		ТЗ = Запрос.Выполнить().Выгрузить();
		СтруктураСверки.Вставить(ИмяМетаданных, ТЗ);
		//
	Конеццикла;
	
