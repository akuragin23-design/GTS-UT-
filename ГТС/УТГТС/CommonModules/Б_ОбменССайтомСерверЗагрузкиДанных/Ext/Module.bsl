Процедура ASP_ПересчитатьПропорционально(СтрокаЗаказа, ОстатокСв)
		СтрокаЗаказа.Сумма = ОстатокСв * СтрокаЗаказа.Цена ;
		СтрокаЗаказа.СуммаНДС = (СтрокаЗаказа.СуммаНДС*ОстатокСв)/СтрокаЗаказа.Количество ;
		СтрокаЗаказа.СуммаСНДС = (СтрокаЗаказа.СуммаСНДС*ОстатокСв)/СтрокаЗаказа.Количество ;
		СтрокаЗаказа.КоличествоУпаковок = (СтрокаЗаказа.КоличествоУпаковок *ОстатокСв)/СтрокаЗаказа.Количество ;
	КонецПроцедуры 
		
		
		
		
Функция ПодобранныеТовары(Номенклатура,Характеристика,ВидЦены,Валюта,Склад,КоличествоУпаковок,ДатаОтгрузки,Дата,Соглашение)
	
	ПараметрыКомплектующих = Новый Структура;
	ПараметрыКомплектующих.Вставить("НоменклатураНабора",              Номенклатура);
	ПараметрыКомплектующих.Вставить("ХарактеристикаНабора",            Характеристика);
	ПараметрыКомплектующих.Вставить("ВидЦены", ВидЦены);
	//ПараметрыКомплектующих.Вставить("Валюта", Валюта);
	//ПараметрыКомплектующих.Вставить("Склад", Склад);
	ПараметрыКомплектующих.Вставить("КоличествоУпаковок", КоличествоУпаковок);
	ПараметрыКомплектующих.Вставить("ДатаОтгрузки", ДатаОтгрузки);
	ПараметрыКомплектующих.Вставить("ВариантКомплектацииНоменклатуры", Неопределено);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Дата",    Дата);
	ДополнительныеПараметры.Вставить("Валюта",  Валюта);
	ДополнительныеПараметры.Вставить("Соглашение", Соглашение);
	
	ПодобранныеТовары = НаборыВызовСервера.Комплектующие(ПараметрыКомплектующих, ДополнительныеПараметры);
	
	Возврат ПодобранныеТовары;
	
КонецФункции

Процедура ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, Объект)
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	СтруктураДействий.Вставить("ПересчитатьКоличествоЕдиниц");
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	//СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	
КонецПроцедуры

// Функция - возвращает значение реквизита документа пришедшего с сайта
//
// Параметры:
//  ЗначенияРеквизитов	 - 	 Таблица значений с реквизитами документа 
//  ИмяРеквизита		 - 	 Наименование реквизита 
// Возвращаемое значение:
//   Значение реквизита 
Функция ASP_ПолучитьЗначениеРеквизитаДокумента(ЗначенияРеквизитов, ИмяРеквизита, ИмяКолонкиПоиска="Наименование", ИмяКолонкиЗначение="Значение")
	
	Если ЗначенияРеквизитов = Неопределено тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НайденнаяСтрока = ЗначенияРеквизитов.Найти(ИмяРеквизита, ИмяКолонкиПоиска);
	
	Если НайденнаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат НайденнаяСтрока[ИмяКолонкиЗначение];	
	КонецЕсли;
	
КонецФункции

Функция ASP_СложныйПоискКонтактногоЛица(ИмяКЛ,ИнформацияОКонтрагенте)
			
	КонтЛицо = Неопределено;
	ЭлПочта = "";
	Телефон = "";
	тзнКонтактактов = ИнформацияОКонтрагенте.Контакты;
	
	Если тзнКонтактактов <> Неопределено тогда
		Для каждого ТекКонтакт из тзнКонтактактов Цикл
			Если ТекКонтакт.ТипВидКонтактнойИнформации = "Почта" тогда
				ЭлПочта = ТекКонтакт.Представление;
			ИначеЕсли ТекКонтакт.ТипВидКонтактнойИнформации = "Телефон" тогда
				Телефон = ТекКонтакт.Представление;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если значениезаполнено(ЭлПочта) или ЗначениеЗаполнено(Телефон) Тогда
		Запрос = новый запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВложенныйЗапрос.КонтЛицо КАК КонтЛицо
		|ИЗ
		|	(ВЫБРАТЬ
		|		Контрагенты.Ссылка КАК КонтЛицо
		|	ИЗ
		|		Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров КАК Контрагенты
		|			ПО КонтрагентыКонтактнаяИнформация.Ссылка = Контрагенты.Ссылка
		|	ГДЕ
		|		КонтрагентыКонтактнаяИнформация.Тип = &ТипКИПочта
		|		И КонтрагентыКонтактнаяИнформация.Представление = &Почта
		|		И Контрагенты.Наименование = &Имя
		|		И &ПочтаНеПустая
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Контрагенты.Ссылка
		|	ИЗ
		|		Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров КАК Контрагенты
		|			ПО КонтрагентыКонтактнаяИнформация.Ссылка = Контрагенты.Ссылка
		|	ГДЕ
		|		КонтрагентыКонтактнаяИнформация.Тип = &ТипКИТелефон
		|		И КонтрагентыКонтактнаяИнформация.Представление = &Телефон
		|		И Контрагенты.Наименование = &Имя
		|		И &ТелефонНеПустая
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		КонтрагентыКонтактнаяИнформацияПочта.Ссылка
		|	ИЗ
		|		Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформацияПочта
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтактныеЛицаПартнеров.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформацияТелефон
		|			ПО КонтрагентыКонтактнаяИнформацияПочта.Ссылка = КонтрагентыКонтактнаяИнформацияТелефон.Ссылка
		|	ГДЕ
		|		КонтрагентыКонтактнаяИнформацияПочта.Тип = &ТипКИПочта
		|		И КонтрагентыКонтактнаяИнформацияПочта.Представление = &Почта
		|		И &ПочтаНеПустая
		|		И КонтрагентыКонтактнаяИнформацияТелефон.Тип = &ТипКИТелефон
		|		И КонтрагентыКонтактнаяИнформацияТелефон.Представление = &Телефон
		|		И &ТелефонНеПустая) КАК ВложенныйЗапрос
		|ГДЕ
		|	&ПочтаНеПустая
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВложенныйЗапрос.КонтЛицо.ДатаРегистрацииСвязи УБЫВ";
		Запрос.УстановитьПараметр("ТипКИПочта", Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты);
		Запрос.УстановитьПараметр("ТипКИТелефон", Перечисления.ТипыКонтактнойИнформации.Телефон);
		Запрос.УстановитьПараметр("ВидКИПочта", Справочники.ВидыКонтактнойИнформации.EmailКонтактногоЛица);
		Запрос.УстановитьПараметр("ВидКИТелефон", Справочники.ВидыКонтактнойИнформации.ТелефонКонтактногоЛица);
		Запрос.УстановитьПараметр("Почта", ЭлПочта);
		Запрос.УстановитьПараметр("Телефон", Телефон);
		Запрос.УстановитьПараметр("Имя", ИмяКЛ);
		Запрос.УстановитьПараметр("ТелефонНеПустая", ЗначениеЗаполнено(Телефон));
		Запрос.УстановитьПараметр("ПочтаНеПустая", ЗначениеЗаполнено(ЭлПочта));

		тзнКонтЛиц 	= Запрос.Выполнить().Выгрузить();
		
		Если тзнКонтЛиц.Количество() >= 1 тогда
			КонтЛицо = тзнКонтЛиц[0].КонтЛицо; 	   
		КонецЕсли;
		
	КонецЕсли;
	
	возврат КонтЛицо;
	
КонецФункции

#КонецОбласти

