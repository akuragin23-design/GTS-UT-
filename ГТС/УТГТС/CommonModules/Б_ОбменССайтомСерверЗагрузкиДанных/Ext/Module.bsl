					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ЗаписьСтатусовИУдалениеЗагруженныхДокументов(ПараметрыОбмена, ДокументXML, ОсновныеНастройкиДокумента, Документ, НовыйДокумент, ДокументОтменен); 
		
		///// +++ASP_Мочалина 000026488  принудительная постановка на регистрацию для обмена с ЛКД документа Заказ клиента после его проведения в рамках текущего обмена   
