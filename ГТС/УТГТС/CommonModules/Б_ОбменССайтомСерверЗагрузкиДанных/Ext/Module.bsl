// Функция - возвращает адрес строкой по списку полей
//
// Параметры:
//  АдресныеПоля - 	 адресные поля контактного адреса контаргента/партнера
// Возвращаемое значение:
//   Строка адреса 
Функция СтрокаПоСпискуПолей(АдресныеПоля)
	
	Результат = "";
	Для Каждого СтрТаблицы Из АдресныеПоля Цикл
		
		Значение 	= СтрТаблицы.Значение;
		ТипЗначения = СтрТаблицы.ТипЗначения;
		ТипЗначения = ?(ТипЗначения = "Почтовый индекс"	, "Индекс"			, ТипЗначения);
		ТипЗначения = ?(ТипЗначения = "Населенный пункт", "НаселенныйПункт"	, ТипЗначения);
		
		Если ПустаяСтрока(Значение) Тогда
			Продолжить;
		КонецЕсли;
		
		Результат = Результат + ?(Результат = "", "", Символы.ПС) + 
			ТипЗначения + "=" + СтрЗаменить(Значение, Символы.ПС, Символы.ПС + Символы.Таб);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

//НАЧАЛО ASP sig 08.10.2018 Изменения:
Процедура ASP_ЗаполнитьРевизитыКонтрагентаПоПолученнымДанным(Контрагент, РеквизитыКонтрагента)
	
	Контрагент.ИНН                  = РеквизитыКонтрагента.ИНН;
	
	Контрагент.НаименованиеПолное 	= РеквизитыКонтрагента.НаименованиеСокращенное;
	Контрагент.Наименование 		= РеквизитыКонтрагента.Наименование;
	Если РеквизитыКонтрагента.Свойство("КПП") Тогда
		Контрагент.КПП 				= РеквизитыКонтрагента.КПП;
	КонецЕсли;
	Если РеквизитыКонтрагента.Свойство("Телефон") И РеквизитыКонтрагента.Телефон <> Неопределено Тогда
		СтрокиКИ = Контрагент.КонтактнаяИнформация.НайтиСтроки(новый структура("Вид",Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента));
		Если СтрокиКИ.Количество() > 0 Тогда
			ЗаписьКИ = СтрокиКИ[0];
		Иначе
			ЗаписьКИ					 = Контрагент.КонтактнаяИнформация.Добавить();
			ЗаписьКИ.Тип				 = Перечисления.ТипыКонтактнойИнформации.Телефон;
			ЗаписьКИ.Вид				 = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагента;
		КонецЕсли;
		ЗаписьКИ.НомерТелефона       = РеквизитыКонтрагента.Телефон.Представление;
		ЗаписьКИ.Представление       = РеквизитыКонтрагента.Телефон.Представление;
		ЗаписьКИ.ЗначенияПолей 		 = РеквизитыКонтрагента.Телефон.КонтактнаяИнформация;
	КонецЕсли;
	
	Если РеквизитыКонтрагента.Свойство("ЮридическийАдрес") И РеквизитыКонтрагента.ЮридическийАдрес <> Неопределено Тогда
		СтрокиКИ = Контрагент.КонтактнаяИнформация.НайтиСтроки(новый структура("Вид",Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента));
		Если СтрокиКИ.Количество() > 0 Тогда
			ЗаписьКИ = СтрокиКИ[0];
		Иначе
			ЗаписьКИ					 = Контрагент.КонтактнаяИнформация.Добавить();
			ЗаписьКИ.Тип				 = Перечисления.ТипыКонтактнойИнформации.Адрес;
			ЗаписьКИ.Вид				 = Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента;
		КонецЕсли;
		ЗаписьКИ.Представление       = РеквизитыКонтрагента.ЮридическийАдрес.Представление;
		ЗаписьКИ.ЗначенияПолей 		 = РеквизитыКонтрагента.ЮридическийАдрес.КонтактнаяИнформация;
	КонецЕсли;
	
КонецПроцедуры

Процедура ASP_ПроверитьЗаменитьНаборЕгоСоставом(ЗаказКлиента)
	
	ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента = ПолучитьФункциональнуюОпцию("ИспользоватьПострочнуюОтгрузкуВЗаказеКлиента");
	ЗаполнитьОбособленно = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказКлиента.Соглашение, "ОбеспечиватьЗаказыОбособленно");
	КэшированныеЗначения = Неопределено;
	
	ДопСтроки = новый Соответствие;
	
	//++ASP Трунькин 000026179 26/02/25
	ЗаказССайта = Лев(ЗаказКлиента.НомерПоДаннымКлиента, 2);
	Если ЗаказССайта = "lk" Тогда 
		ОтвМенеджер = ЗаказКлиента.Партнер.ОсновнойМенеджер;
		ЗаказКлиента.ХозяйственнаяОперация  = ?(ЗаказКлиента.ХозяйственнаяОперация.Пустая(), Перечисления.ХозяйственныеОперации.РеализацияКлиенту,ЗаказКлиента.ХозяйственнаяОперация ); //000026179
		ЗаказКлиента.Организация = ?(ЗаказКлиента.Организация.Пустая(),Справочники.Организации.НайтиПоНаименованию("ООО ""Горторгснаб""") ,ЗаказКлиента.Организация); //000026179
		ЗаказКлиента.Менеджер = ?(ЗаказКлиента.Менеджер.Пустая(), ОтвМенеджер , ЗаказКлиента.Менеджер) ;  // 000026488
		ЗаказКлиента.Подразделение = ?(ЗаказКлиента.Подразделение.Пустая() ,ОтвМенеджер.Подразделение , ЗаказКлиента.Подразделение) ; //000026488
		
		ЗаказКлиента.Соглашение = ?(ЗаказКлиента.Соглашение.Пустая(), Справочники.СоглашенияСКлиентами.НайтиПоНаименованию("Предоплата 100% отсрочка 2 дня"), ЗаказКлиента.Соглашение) ;
	КонецЕсли; 
	//--ASP Трунькин 000026179 26/02/25 

	
	Для каждого СтрТовары Из ЗаказКлиента.Товары Цикл
		Если СтрТовары.Номенклатура.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Набор") Тогда
			ПодобранныеТовары = ПодобранныеТовары(СтрТовары.Номенклатура,СтрТовары.Характеристика,ЗаказКлиента.Соглашение.ВидЦен,
			ЗаказКлиента.Валюта,ЗаказКлиента.Склад,СтрТовары.КоличествоУпаковок,СтрТовары.ДатаОтгрузки,ЗаказКлиента.Дата,ЗаказКлиента.Соглашение);
			
			ДопСтроки.Вставить(СтрТовары,ПодобранныеТовары);
			
		КонецЕсли;
		
		//устанавливаем не обеспечивать
		//++ASP Трунькин 000026179 25/02/25
		//СтрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
		
		//Если заказ с ЛКД то ставим резерв		
		ЗаказССайта = Лев(ЗаказКлиента.НомерПоДаннымКлиента, 2);
		Если ЗаказССайта = "lk" Тогда					
			СтрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
		Иначе
			СтрТовары.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.НеТребуется;
		КонецЕсли; 	
		//--ASP Трунькин 000026179 25/02/25

		
	КонецЦикла;
	
	//проверить цену суммарных комплектующих набора с ценой набора с сайта. Если цена совпадает, тогда ок. Если не совпадает - распределять пропорционально суммам комплектующих.
	Для каждого ДопСтрока Из ДопСтроки Цикл
		СтоимостьНоменклатурыНабора = ДопСтрока.Ключ.Сумма + ДопСтрока.Ключ.СуммаРучнойСкидки + ДопСтрока.Ключ.СуммаАвтоматическойСкидки;
		СтоимостьКомплектующих      = 0;
		Для каждого ДопСтрокаКомпл Из ДопСтрока.Значение Цикл
			СтоимостьКомплектующих = СтоимостьКомплектующих+ДопСтрокаКомпл.Цена*ДопСтрокаКомпл.КоличествоУпаковок;
		КонецЦикла;
		Если СтоимостьНоменклатурыНабора <> СтоимостьКомплектующих Тогда
			//Доля 						= ?(СтоимостьНоменклатурыНабора=0,1,СтоимостьКомплектующих/СтоимостьНоменклатурыНабора);
			//Доля 						= ?(СтоимостьНоменклатурыНабора=0,1,СтоимостьНоменклатурыНабора/СтоимостьКомплектующих); 
			Доля 						= ?(СтоимостьКомплектующих=0,1,СтоимостьНоменклатурыНабора/СтоимостьКомплектующих);
			Для каждого ДопСтрокаКомпл Из ДопСтрока.Значение Цикл
				ДопСтрокаКомпл.ВидЦены 	= Справочники.ВидыЦен.ПустаяСсылка();//ASP_Dante 21/11/19
				ДопСтрокаКомпл.Цена 	= ДопСтрокаКомпл.Цена*Доля;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла; 
	
	СтоимостьНоменклатурыНаборов = 0;	
	СтоимостьВсехКомплектующих = 0;
	
	//заполнить составом набора (по виду цены заказа)
	Для каждого ДопСтрока Из ДопСтроки Цикл
		
		СтоимостьНоменклатурыНабора = ДопСтрока.Ключ.Сумма;
		СтоимостьРучнойСкидкиНоменклатурыНабора = ДопСтрока.Ключ.СуммаРучнойСкидки;
		СтоимостьКомплектующих      = 0;
		СтоимостьРучнойСкидкиКомплектующих      = 0;
		Для каждого СтрокаТовара Из ДопСтрока.Значение Цикл
			
			ТекущаяСтрока = ЗаказКлиента.Товары.Добавить();
			
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтрокаТовара, "НоменклатураНабора, ХарактеристикаНабора, Номенклатура, Характеристика, Упаковка, Склад, ДатаОтгрузки, ВидЦены, Цена, КоличествоУпаковок, СрокПоставки, ПроцентРучнойСкидки");
			//ASP_Dante 02/12/21 Задача 000013354
			ТекущаяСтрока.ПроцентРучнойСкидки = ДопСтрока.Ключ.ПроцентРучнойСкидки;
			
			СуммаБезСкидки = ТекущаяСтрока.Цена * ТекущаяСтрока.КоличествоУпаковок;			
			СуммаРучнойСкидки1 = Окр((СуммаБезСкидки) * ТекущаяСтрока.ПроцентРучнойСкидки / 100, 2);
			Окрцена=Окр((СуммаБезСкидки-СуммаРучнойСкидки1)/ ТекущаяСтрока.КоличествоУпаковок, 2);
			ТекущаяСтрока.СуммаРучнойСкидки=СуммаРучнойСкидки1+((СуммаБезСкидки-СуммаРучнойСкидки1)-Окрцена*ТекущаяСтрока.КоличествоУпаковок);
			//ASP_Dante 02/12/21			
			
			//ТекущаяСтрока.ИндексНабора = ?(ЗначениеЗаполнено(ТекущаяСтрока.НоменклатураНабора), 1, 0);
			
			СтруктураДействий = Новый Структура;
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата, ПоДатеОтгрузки, Организация", ЗаказКлиента.НалогообложениеНДС, ЗаказКлиента.Дата, Истина, ЗаказКлиента.Организация));//ASP_Dante 20/09/19ЗаказКлиента.НалогообложениеНДС);
			СтруктураДействий.Вставить("ЗаполнитьСодержание", ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруЗаполненияСодержанияУслугиВСтрокеТЧ(ЗаказКлиента, Ложь));
			//ПараметрыДействия = ОбеспечениеКлиентСервер.ПараметрыДействияПроверитьЗаполнитьОбеспечениеВДокументеПродажи(
			//ЗаполнитьОбособленно, ЗаказКлиента.Статус, ЗаказКлиента.ЖелаемаяДатаОтгрузки);
