Функция ПолучитьДокументМаркировки(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок) Экспорт

	Шаблон = ДокументТСД.Шаблон;
	
	МаркиУказаныПоставщиком = Ложь;
	Если Шаблон.ВидДокумента = "ВозвратТоваровОтКлиента" тогда
		Если ЭтоНовыйДокумент тогда
		Иначе
			Попытка
				Если ИсходныйДокумент.ШтрихкодыУпаковок.Количество()>0 Тогда
					МаркиУказаныПоставщиком = Истина;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;
	
	
	Если Шаблон.ВидДокумента = "ВозвратВОборотИСМП" 
		или Шаблон.ВидДокументаНового = "ВозвратВОборотИСМП" 
		Или Шаблон.ВидДокумента = "ПеремаркировкаТоваровИСМП" 
		или Шаблон.ВидДокументаНового = "ПеремаркировкаТоваровИСМП"Тогда
		
		Возврат ОбработатьВидДокументаВозвратВОборотИСМП(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок);

				
	ИначеЕсли Шаблон.ВидДокумента = "ЧекККМ" или Шаблон.ВидДокументаНового = "ЧекККМ"
		или Шаблон.ВидДокумента = "ЧекККМВозврат" или Шаблон.ВидДокументаНового = "ЧекККМВозврат" Тогда
		
		Возврат ОбработатьВидДокументаЧекККМ(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок);

	ИначеЕсли Шаблон.ВидДокумента = "ПриобретениеТоваровУслуг" 
		или (Шаблон.ВидДокумента = "ПриобретениеТоваровУслуг" И Шаблон.ВидДокументаНового = "ПриходныйОрдерНаТовары")
			или (Шаблон.ВидДокумента = "ПриемкаТоваровИСМП" И Шаблон.ТабличнуюЧастьПриЗагрузкеПодбор=0)
				или (Шаблон.ВидДокумента = "ВозвратТоваровОтКлиента" И (МаркиУказаныПоставщиком ИЛИ Шаблон.ТабличнуюЧастьПриЗагрузкеПодбор=0)) Тогда
		
		Возврат ОбработатьВидДокументаПриобретениеТоваровУслуг(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок);
		
	ИначеЕсли (Шаблон.ВидДокумента = "ПриемкаТоваровИСМП" И Шаблон.ТабличнуюЧастьПриЗагрузкеПодбор<>0) Тогда
		
		Возврат ОбработатьВидДокументаПриемкаТоваровИСМП(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок);
	
	ИначеЕсли Шаблон.ВидДокумента = "РеализацияТоваровУслуг" 
		или Шаблон.ВидДокумента = "ОтгрузкаТоваровИСМП" 
			или Шаблон.ВидДокумента = "ВозвратТоваровПоставщику" 
				или (Шаблон.ВидДокумента = "ВозвратТоваровОтКлиента" И (НЕ МаркиУказаныПоставщиком ИЛИ  Шаблон.ТабличнуюЧастьПриЗагрузкеПодбор<>0)) 
					или Шаблон.ВидДокументаНового = "РеализацияТоваровУслуг"
						или Шаблон.ВидДокумента = "ВыводИзОборотаИСМП" 
							или Шаблон.ВидДокументаНового = "ВыводИзОборотаИСМП"
								//или Шаблон.ВидДокумента = "ПеремещениеТоваров" 
									//или Шаблон.ВидДокументаНового = "ПеремещениеТоваров" 
										или Шаблон.ВидДокумента = "СписаниеКодовМаркировкиИСМП" 
											или Шаблон.ВидДокументаНового = "СписаниеКодовМаркировкиИСМП"
												или Шаблон.ВидДокумента = "ПередачаТоваровМеждуОрганизациями" 
													или Шаблон.ВидДокументаНового = "ПередачаТоваровМеждуОрганизациями" 
														или Шаблон.ВидДокумента = "ВозвратТоваровМеждуОрганизациями" 
															или Шаблон.ВидДокументаНового = "ВозвратТоваровМеждуОрганизациями" 
																или Шаблон.ВидДокумента = "КорректировкаРеализации"
																	Тогда

		Возврат ОбработатьВидДокументаРеализацияТоваровУслуг(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок);
		
	ИначеЕсли Шаблон.ВидДокумента = "МаркировкаТоваровИСМП" Тогда
		
		Возврат ОбработатьВидДокументаМаркировкаТоваровИСМП(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок);
		
	ИначеЕсли Шаблон.ВидДокумента = "ДатаМобайл_УпаковочныйЛист" Тогда
		
		ОбработатьВидДокументаДатаМобайл_УпаковочныйЛист(ИсходныйДокумент, ДокументТСД, ЭтоНовыйДокумент,СтрокаОшибок);
		Возврат "";
	
	КонецЕсли;

КонецФункции // ()

