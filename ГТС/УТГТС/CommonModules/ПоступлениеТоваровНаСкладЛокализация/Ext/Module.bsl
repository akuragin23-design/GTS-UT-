Функция ASP_СоздаватьЗаказыНаПеремещениеПриПроведении(ПриобретениеТоваровУслугОбъект)
	
	Если Не ПриобретениеТоваровУслугОбъект.ДополнительныеСвойства.Свойство("ЗаписьИзФормы")
	 Или ПриобретениеТоваровУслугОбъект.ДополнительныеСвойства.ЗаписьИзФормы <> "ФормаДокумента" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫБОР
		|		КОГДА ПриобретениеТоваровУслугТовары.ЗаказПоставщику = ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
		|			ТОГДА ЕСТЬNULL(ПриобретениеТоваровУслугТовары.Ссылка.ЗаказПоставщику.НомерПоДаннымПоставщика, """")
		|		ИНАЧЕ ПриобретениеТоваровУслугТовары.ЗаказПоставщику.НомерПоДаннымПоставщика
		|	КОНЕЦ КАК ВходящийНомерЗаказПоставщика
		|ИЗ
		|	Документ.ПриобретениеТоваровУслуг.Товары КАК ПриобретениеТоваровУслугТовары
		|ГДЕ
		|	ПриобретениеТоваровУслугТовары.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПриобретениеТоваровУслугОбъект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Не ПустаяСтрока(Выборка.ВходящийНомерЗаказПоставщика) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	
	Возврат Истина;
	
КонецФункции

Функция ASP_ДобавитьСтрокуВГТД(ГТД, СтрокаТаблицыВыгруженнойИзТЧ, ОчиститьНазначение)
	
	СтрокаЗаказа = ГТД.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаЗаказа, СтрокаТаблицыВыгруженнойИзТЧ);
	
	Если ОчиститьНазначение И ЗначениеЗаполнено(СтрокаТаблицыВыгруженнойИзТЧ.Назначение) Тогда
		//СтрокаЗаказа.ASP_ЗаказКлиента = СтрокаТаблицыВыгруженнойИзТЧ.Назначение.Заказ;
		СтрокаЗаказа.Назначение = Справочники.Назначения.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтрокаЗаказа;
	
КонецФункции

Функция НайтиТаможеннуюДекларацию(Поступление)

	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ТаможеннаяДекларацияИмпортТовары.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ТаможеннаяДекларацияИмпорт.Товары КАК ТаможеннаяДекларацияИмпортТовары
	               |ГДЕ
	               |	ТаможеннаяДекларацияИмпортТовары.ДокументПоступления = &Поступление
	               |	И ТаможеннаяДекларацияИмпортТовары.Ссылка.Проведен";
	Запрос.УстановитьПараметр("Поступление", Поступление);
	Рез = Запрос.Выполнить().Выгрузить();
	Возврат Рез.ВыгрузитьКолонку("Ссылка");
	
	
КонецФункции

