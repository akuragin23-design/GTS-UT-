					НайденнаяЗапись.АналитикаУчетаНоменклатуры = Товар.АналитикаУчетаНоменклатуры;	
					счНабор = счНабор + 1
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		НаборЗаписей.Записать(Истина);
