Процедура ASP_ОбработкаПроведения(Объект, Отказ, РежимПроведения) Экспорт
	
	Движения = Объект.Движения;
	ДополнительныеСвойства = Объект.ДополнительныеСвойства;
	
	//++ASP_Crow 16.10.2024 000024647 массив для отправки уведомлений
	МассивЗаказовДляУведомлений = новый Массив;
	//--ASP_Crow 16.10.2024 000024647

	//++ Локализация
	//ASP_Dante 28/11/19
	Если Не Отказ И ДополнительныеСвойства.Свойство("Товары") Тогда
		ТоварыПоступления = ДополнительныеСвойства.Товары.Скопировать();
		ТоварыПоступления.Свернуть("Номенклатура, Назначение", "Количество");
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Назначения.Ссылка КАК Ссылка,
		|	Назначения.Заказ КАК Заказ
		|ИЗ
		|	Справочник.Назначения КАК Назначения
		|ГДЕ
		|	Назначения.Ссылка В(&Ссылка)
		|ИТОГИ ПО
		|	Заказ";
		
		Запрос.УстановитьПараметр("Ссылка", ТоварыПоступления.ВыгрузитьКолонку("Назначение"));
		
		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Сообщить("Не найдено ни одного назначения!");
			Возврат;
		КонецЕсли;            
		ВыборкаЗаказ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ЕстьЗаказКлиента = Ложь;
		ТаблицаЗаказов = Документы.ЗаказКлиента.ПустаяСсылка().Товары.ВыгрузитьКолонки();
		ТаблицаЗаказов.Колонки.Добавить("ЗаказКлиента");
		ТаблицаЗаказов.Колонки.Добавить("КоличествоСписать");
		ТаблицаЗаказов.Колонки.Добавить("СкладОтправитель");
		
		Пока ВыборкаЗаказ.Следующий() Цикл
			
			ОбъектДокумент = ВыборкаЗаказ.Заказ.ПолучитьОбъект();
			ТоварыЗаказ = ОбъектДокумент.Товары;   		
			
			ВыборкаДетальныеЗаписи = ВыборкаЗаказ.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				МассивСтрок = ТоварыПоступления.НайтиСтроки(Новый Структура("Назначение", ВыборкаДетальныеЗаписи.Ссылка));
				Для каждого Строка Из МассивСтрок Цикл
					
					КоличествоСписать = Строка.Количество;
					Отбор = Новый Структура("Номенклатура, ВариантОбеспечения, Обособленно" + ?(ТипЗнч(ВыборкаДетальныеЗаписи.Заказ) = Тип("ДокументСсылка.ЗаказКлиента"), ", Склад", ""), Строка.Номенклатура, Перечисления.ВариантыОбеспечения.КОбеспечению, Истина, Объект.Склад);
					МассивСтрокЗаказ = ТоварыЗаказ.НайтиСтроки(Отбор);
					Для каждого СтрокаЗаказ Из МассивСтрокЗаказ Цикл
						
						Если КоличествоСписать = 0 Тогда
							Прервать;
						КонецЕсли;
						
						Списать = Мин(КоличествоСписать, СтрокаЗаказ.Количество);
						
						Если КоличествоСписать = СтрокаЗаказ.Количество Тогда
							СтрокаЗаказ.Обособленно = Ложь;
							СтрокаЗаказ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
							КоличествоСписать = 0;
							
						ИначеЕсли КоличествоСписать > СтрокаЗаказ.Количество Тогда
							СтрокаЗаказ.Обособленно = Ложь;	
							СтрокаЗаказ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
							КоличествоСписать = КоличествоСписать - СтрокаЗаказ.Количество;
							
						ИначеЕсли КоличествоСписать < СтрокаЗаказ.Количество Тогда
							
							НоваяСтрока = ТоварыЗаказ.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказ);
							НоваяСтрока.КодСтроки = ОбъектДокумент.МаксимальныйКодСтроки + 1;
							ОбъектДокумент.МаксимальныйКодСтроки = ОбъектДокумент.МаксимальныйКодСтроки + 1;
							
							СтрокаЗаказ.Обособленно = Ложь;
							СтрокаЗаказ.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
							СтрокаЗаказ.Количество = Списать;
							СтрокаЗаказ.КоличествоУпаковок = Списать;
							
							НоваяСтрока.Количество = НоваяСтрока.Количество - Списать;
							НоваяСтрока.КоличествоУпаковок = НоваяСтрока.КоличествоУпаковок - Списать;
							
							Если ТипЗнч(ВыборкаДетальныеЗаписи.Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда 
								СтруктураДействий = Новый Структура;
								asp_ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, ОбъектДокумент);	
								
								ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаЗаказ, СтруктураДействий, Неопределено);							
								
								НоваяСтрока.Сумма = НоваяСтрока.Сумма - СтрокаЗаказ.Сумма;
								НоваяСтрока.СуммаНДС = НоваяСтрока.СуммаНДС - СтрокаЗаказ.СуммаНДС;
								НоваяСтрока.СуммаСНДС = НоваяСтрока.СуммаСНДС - СтрокаЗаказ.СуммаСНДС;
								НоваяСтрока.СуммаРучнойСкидки = НоваяСтрока.СуммаРучнойСкидки - СтрокаЗаказ.СуммаРучнойСкидки;
								НоваяСтрока.СуммаАвтоматическойСкидки = НоваяСтрока.СуммаАвтоматическойСкидки - СтрокаЗаказ.СуммаАвтоматическойСкидки;
							КонецЕсли;
							
							КоличествоСписать = 0;
						КонецЕсли;
					КонецЦикла; 
					Если ТипЗнч(ВыборкаДетальныеЗаписи.Заказ) = Тип("ДокументСсылка.ЗаказКлиента") Тогда
						ЕстьЗаказКлиента = Истина;
						МассивСтрокЗаказ = ТоварыЗаказ.НайтиСтроки(Новый Структура("Номенклатура, ВариантОбеспечения, Обособленно", Строка.Номенклатура, Перечисления.ВариантыОбеспечения.КОбеспечению, Истина));
						Для каждого СтрокаЗаказ Из МассивСтрокЗаказ Цикл
							
							Если СтрокаЗаказ.Склад <> Объект.Склад И Не КоличествоСписать = 0 Тогда
								
								НоваяСтрока = ТаблицаЗаказов.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗаказ);
								
								НоваяСтрока.ЗаказКлиента = ВыборкаЗаказ.Заказ;
								
								Списать = Мин(КоличествоСписать, СтрокаЗаказ.Количество);
								
								Если Списать = СтрокаЗаказ.Количество Тогда
									
									КоличествоСписать = КоличествоСписать - Списать;
									
								ИначеЕсли Списать > СтрокаЗаказ.Количество Тогда
									
									Списать = Списать - СтрокаЗаказ.Количество;
									КоличествоСписать = КоличествоСписать - СтрокаЗаказ.Количество;
									
								ИначеЕсли Списать < СтрокаЗаказ.Количество Тогда								
									КоличествоСписать = 0;
								КонецЕсли;
								
								НоваяСтрока.КоличествоСписать = Списать;
