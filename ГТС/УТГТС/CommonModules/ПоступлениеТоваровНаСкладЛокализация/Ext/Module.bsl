КонецПроцедуры

// Вызывается из соответствующего обработчика документа
//
// Параметры:
//  Объект - ДокументОбъект - Обрабатываемый объект
//  Отказ - Булево - Признак отказа от записи.
//                   Если в теле процедуры-обработчика установить данному параметру значение Истина,
//                   то запись выполнена не будет и будет вызвано исключение.
//  РежимЗаписи - РежимЗаписиДокумента - В параметр передается текущий режим записи документа. Позволяет определить в теле процедуры режим записи.
//  РежимПроведения - РежимПроведенияДокумента - В данный параметр передается текущий режим проведения.
//
Процедура ПередЗаписью(Объект, Отказ, РежимЗаписи, РежимПроведения) Экспорт

	ЗаполнитьЗначенияСвойств(Объект, ИнтеграцияГИСМ_УТ.ЗаполнитьПризнакиЕстьМаркируемаяПродукцияИЕстьКиЗ(Объект, "Товары"));

	//ASP_Dante 28/11/19
	Если Не Отказ И РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ЕстьНазначение = Ложь;
		Для каждого Строка Из Объект.Товары Цикл
			Если ЗначениеЗаполнено(Строка.Назначение) Тогда
				Если Не ЕстьНазначение Тогда
					Объект.ДополнительныеСвойства.Вставить("Товары", Объект.Товары.Выгрузить(, "Номенклатура, Назначение, КодСтроки, Количество, ИдентификаторСтроки")); //+++ {{ ASP 01.02.2021 000009653 }} добавил ИдентификаторСтроки
					ЕстьНазначение = Истина;
				КонецЕсли; 
				Строка.ЗаказКлиента = Строка.Назначение.Заказ;
				Строка.Назначение = Справочники.Назначения.ПустаяСсылка();
				
			КонецЕсли;		
		КонецЦикла; 
		
		РаспоряжениеТребование = ТипЗнч(Объект.Распоряжение) = Тип("ДокументСсылка.ЗаказПоставщику");
		
		Если ЕстьНазначение И ЗначениеЗаполнено(Объект.Распоряжение) Тогда
			
			Если РаспоряжениеТребование Тогда
				ЗаказПоставщику = Объект.Распоряжение.ПолучитьОбъект();
				ПриобретениеТовара = НайтиПриобретениеПоТребованию(Объект.Распоряжение);
				Если ПриобретениеТовара.Количество() = 1 тогда
					ПриобретениеТовара = ПриобретениеТовара[0].ПолучитьОбъект();
				ИначеЕсли ПриобретениеТовара.Количество() = 0 Тогда
					Отказ = Истина; // Такой вариант по идее не должен быть, это некорректное поведение
				Иначе
					// пока такой вариант не обрабатываем
					Отказ = Истина;
				КонецЕсли;
			ИначеЕсли НЕ РаспоряжениеТребование и ТипЗнч(Объект.Распоряжение) = Тип("ДокументСсылка.ПриобретениеТоваровУслуг") Тогда
				ЗаказПоставщику = Объект.Распоряжение.ЗаказПоставщика.ПолучитьОбъект();
				ПриобретениеТовара = Объект.Распоряжение.ПолучитьОбъект();
			Иначе
				Отказ = Истина; // значит какой-то иной вариант, который придется придумать как обработать
			КонецЕсли;
			
			МаксКодСтрокиВЗаказеПоставщику = ЗаказПоставщику.МаксимальныйКодСтроки;
			МаксКодСтрокиВЗаказеПоставщикуДубль = ЗаказПоставщику.МаксимальныйКодСтроки; // Для  приобретения товаров услуг
			Если МаксКодСтрокиВЗаказеПоставщику = 0 И ЗаказПоставщику.Товары.Количество() > 0 Тогда
				ВсеКодыСтрок = ЗаказПоставщику.Товары.Выгрузить( , "КодСтроки");
				ВсеКодыСтрок.Сортировать("КодСтроки");
				МаксКодСтрокиВЗаказеПоставщику = ВсеКодыСтрок[ВсеКодыСтрок.Количество() - 1].КодСтроки;
				МаксКодСтрокиВЗаказеПоставщикуДубль = ВсеКодыСтрок[ВсеКодыСтрок.Количество() - 1].КодСтроки;
			КонецЕсли;
			//--- {{ ASP 01.02.2021 000009653 }}
			
			#Область ОбработкаТаможеннойДекларации
			//++ASP_Crow 10.07.2024 000023822 Найдем таможенную декларацию если они есть
			ГТД = НайтиТаможеннуюДекларацию(ПриобретениеТовара.Ссылка);
			
			Если ГТД.Количество() = 1 тогда
				ГТД = ГТД[0].ПолучитьОбъект();
			ИначеЕсли ГТД.Количество() = 0 Тогда
				Отказ = Истина; // возможно, такое будет, надеюсь нет
			Иначе
				// пока такой вариант не обрабатываем
				Отказ = Истина;
			КонецЕсли; 
			
			//++ASP_СмирновН 11.12.24 000025496
			Если ГТД <> Неопределено Тогда
			ТоварыГТД = ГТД.Товары.Выгрузить();
			ГТД.Товары.Очистить();
			
			ПараметрыПоиска = новый Структура("Номенклатура, Назначение");
			Для каждого СтрГТД из ТоварыГТД Цикл
				
				Если ЗначениеЗаполнено(СтрГТД.Назначение) Тогда
					ПараметрыПоиска.Номенклатура = СтрГТД.Номенклатура;
					ПараметрыПоиска.Назначение = СтрГТД.Назначение; 
					
					МассивСтрок = Объект.ДополнительныеСвойства.Товары.НайтиСтроки(ПараметрыПоиска);
					Если МассивСтрок.Количество() = 0 Тогда
						ASP_ДобавитьСтрокуВГТД(ГТД, СтрГТД, Ложь);
					Иначе
						ОставшеесяКоличество = СтрГТД.Количество;
						ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику = Истина;
						
						Для Каждого СтрокаПоступления Из МассивСтрок Цикл
							Если ОставшеесяКоличество = 0 Тогда
								Прервать;
							КонецЕсли;
							
							СтрокаЗаказа = ASP_ДобавитьСтрокуВГТД(ГТД, СтрГТД, Истина);
							
							Если ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику Тогда
								ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику = Ложь;
							Иначе
								МаксКодСтрокиВЗаказеПоставщикуДубль = МаксКодСтрокиВЗаказеПоставщикуДубль + 1;
								СтрокаЗаказа.КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
								СтрокаПоступления.КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
								Объект.Товары.Найти(СтрокаПоступления.ИдентификаторСтроки, "ИдентификаторСтроки").КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
							КонецЕсли;
							
							Если ОставшеесяКоличество > СтрокаПоступления.Количество Тогда
								ТекущееКоличество = СтрокаПоступления.Количество;
							Иначе
								ТекущееКоличество = ОставшеесяКоличество;
							КонецЕсли;
							
							ОставшеесяКоличество = Макс(0, ОставшеесяКоличество - ТекущееКоличество);
							ASP_ОбработатьПриНеобходимостиИзменениеКоличества(ГТД, СтрокаЗаказа, ТекущееКоличество);
						КонецЦикла;
						
						Если ОставшеесяКоличество > 0 Тогда
							СтрокаЗаказа = ASP_ДобавитьСтрокуВГТД(ГТД, СтрГТД, Ложь);
							
							МаксКодСтрокиВЗаказеПоставщикуДубль = МаксКодСтрокиВЗаказеПоставщикуДубль + 1;
							СтрокаЗаказа.КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
							
							ТекущееКоличество = ОставшеесяКоличество;
							
							ASP_ОбработатьПриНеобходимостиИзменениеКоличества(ГТД, СтрокаЗаказа, ТекущееКоличество);
						КонецЕсли;
					КонецЕсли;
					
				Иначе //Не ЗначениеЗаполнено(Строка.Назначение)
					
					СтрокаЗаказа = ГТД.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЗаказа, СтрГТД);
					
				КонецЕсли;
								
			КонецЦикла;
			
			Попытка
				ГТД.ДополнительныеСвойства.Вставить("ПропуститьПроверкуТоварыКОформлениюДокументовИмпорта", Истина);
				ГТД.ДополнительныеСвойства.Вставить("ПропуститьПерепроведениеПриобретений", Истина); //ASP_Crow 29.06.2026 000030362 ошибка двойного проведения
				ГТД.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Отказ = Истина;
				Сообщить("Не удалось провести ГТД " + ГТД);
			КонецПопытки;
			//++ASP_СмирновН 11.12.24 000025496
			Иначе
			КонецЕсли;
            //--ASP_СмирновН 11.12.24 000025496
			//--ASP_Crow 10.07.2024 000023822
			#КонецОбласти

			
			#Область ОбработкаПриобретения
	        ТоварыПТУ = ПриобретениеТовара.Товары.Выгрузить();
			ПриобретениеТовара.Товары.Очистить();
			
			ПараметрыПоиска = новый Структура("Номенклатура, Назначение");
			Для каждого СтрПТУ Из ТоварыПТУ Цикл

				Если ЗначениеЗаполнено(СтрПТУ.Назначение) Тогда
					
					ПараметрыПоиска.Номенклатура = СтрПТУ.Номенклатура;
					ПараметрыПоиска.Назначение = СтрПТУ.Назначение; 
					
					МассивСтрок = Объект.ДополнительныеСвойства.Товары.НайтиСтроки(ПараметрыПоиска);
					Если МассивСтрок.Количество() = 0 Тогда
						ASP_ДобавитьСтрокуВПриобретениеТоваров(ПриобретениеТовара, СтрПТУ, Ложь);
					Иначе
						ОставшеесяКоличество = СтрПТУ.Количество;
						ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику = Истина;
						
						Для Каждого СтрокаПоступления Из МассивСтрок Цикл
							Если ОставшеесяКоличество = 0 Тогда
								Прервать;
							КонецЕсли;
							
							СтрокаЗаказа = ASP_ДобавитьСтрокуВПриобретениеТоваров(ПриобретениеТовара, СтрПТУ, Истина);
							
							Если ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику Тогда
								ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику = Ложь;
							Иначе
								МаксКодСтрокиВЗаказеПоставщикуДубль = МаксКодСтрокиВЗаказеПоставщикуДубль + 1;
								СтрокаЗаказа.КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
								СтрокаПоступления.КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
								Объект.Товары.Найти(СтрокаПоступления.ИдентификаторСтроки, "ИдентификаторСтроки").КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
							КонецЕсли;
							
							Если ОставшеесяКоличество > СтрокаПоступления.Количество Тогда
								ТекущееКоличество = СтрокаПоступления.Количество;
							Иначе
								ТекущееКоличество = ОставшеесяКоличество;
							КонецЕсли;
							
							ОставшеесяКоличество = Макс(0, ОставшеесяКоличество - ТекущееКоличество);
							ASP_ОбработатьПриНеобходимостиИзменениеКоличества(ПриобретениеТовара, СтрокаЗаказа, ТекущееКоличество);
						КонецЦикла;
						
						Если ОставшеесяКоличество > 0 Тогда
							СтрокаЗаказа = ASP_ДобавитьСтрокуВПриобретениеТоваров(ПриобретениеТовара, СтрПТУ, Ложь);
							
							МаксКодСтрокиВЗаказеПоставщикуДубль = МаксКодСтрокиВЗаказеПоставщикуДубль + 1;
							СтрокаЗаказа.КодСтроки = МаксКодСтрокиВЗаказеПоставщикуДубль;
							
							ТекущееКоличество = ОставшеесяКоличество;
							
							ASP_ОбработатьПриНеобходимостиИзменениеКоличества(ПриобретениеТовара, СтрокаЗаказа, ТекущееКоличество);
						КонецЕсли;
					КонецЕсли;
					
				Иначе //Не ЗначениеЗаполнено(Строка.Назначение)
					
					СтрокаЗаказа = ПриобретениеТовара.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЗаказа, СтрПТУ);
					
				КонецЕсли;
				//--- {{ ASP 01.02.2021 000009653 }}
				
			КонецЦикла;
						
			Попытка
				ПриобретениеТовара.ДополнительныеСвойства.Вставить("ПропуститьПроверкуТоварыКОформлениюДокументовИмпорта", Истина);
				ПриобретениеТовара.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Отказ = Истина;
				Сообщить("Не удалось провести приобретение товаров услуг" + ПриобретениеТовара);
			КонецПопытки;
			#КонецОбласти
			
			#Область ОбработкаТребования
			Товары = ЗаказПоставщику.Товары.Выгрузить();
			ЗаказПоставщику.Товары.Очистить();
			
			ПараметрыПоиска = Новый Структура("Номенклатура, Назначение");
			Для каждого Строка Из Товары Цикл

				Если ЗначениеЗаполнено(Строка.Назначение) Тогда
					
					ПараметрыПоиска.Номенклатура = Строка.Номенклатура;
					ПараметрыПоиска.Назначение = Строка.Назначение; 
					
					МассивСтрок = Объект.ДополнительныеСвойства.Товары.НайтиСтроки(ПараметрыПоиска);
					Если МассивСтрок.Количество() = 0 Тогда
						ASP_ДобавитьСтрокуВЗаказПоставщику(ЗаказПоставщику, Строка, Истина); //ASP_Crow Проще будет перезаполнить полностью из-за кода строки
					Иначе
						ОставшеесяКоличество = Строка.Количество;
						ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику = Истина;
						
						Для Каждого СтрокаПоступления Из МассивСтрок Цикл
							Если ОставшеесяКоличество = 0 Тогда
								Прервать;
							КонецЕсли;
							
							СтрокаЗаказа = ASP_ДобавитьСтрокуВЗаказПоставщику(ЗаказПоставщику, Строка, Истина);
							
							Если ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику Тогда
								ЭтоПервоеДобавлениеСтрокиВЗаказПоставщику = Ложь;
							Иначе
								МаксКодСтрокиВЗаказеПоставщику = МаксКодСтрокиВЗаказеПоставщику + 1;
								СтрокаЗаказа.КодСтроки = МаксКодСтрокиВЗаказеПоставщику;
								СтрокаПоступления.КодСтроки = МаксКодСтрокиВЗаказеПоставщику;
								Объект.Товары.Найти(СтрокаПоступления.ИдентификаторСтроки, "ИдентификаторСтроки").КодСтроки = МаксКодСтрокиВЗаказеПоставщику;
							КонецЕсли;
							
							Если ОставшеесяКоличество > СтрокаПоступления.Количество Тогда
								ТекущееКоличество = СтрокаПоступления.Количество;
							Иначе
								ТекущееКоличество = ОставшеесяКоличество;
							КонецЕсли;
							
							ОставшеесяКоличество = Макс(0, ОставшеесяКоличество - ТекущееКоличество);
							ASP_ОбработатьПриНеобходимостиИзменениеКоличества(ЗаказПоставщику, СтрокаЗаказа, ТекущееКоличество);
						КонецЦикла;
						
						Если ОставшеесяКоличество > 0 Тогда
							СтрокаЗаказа = ASP_ДобавитьСтрокуВЗаказПоставщику(ЗаказПоставщику, Строка, Ложь);
							
							МаксКодСтрокиВЗаказеПоставщику = МаксКодСтрокиВЗаказеПоставщику + 1;
							СтрокаЗаказа.КодСтроки = МаксКодСтрокиВЗаказеПоставщику;
							
							ТекущееКоличество = ОставшеесяКоличество;
							
							ASP_ОбработатьПриНеобходимостиИзменениеКоличества(ЗаказПоставщику, СтрокаЗаказа, ТекущееКоличество);
						КонецЕсли;
					КонецЕсли;
					
				Иначе //Не ЗначениеЗаполнено(Строка.Назначение)
					
					СтрокаЗаказа = ЗаказПоставщику.Товары.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаЗаказа, Строка);
					
				КонецЕсли;
				//--- {{ ASP 01.02.2021 000009653 }}
				
			КонецЦикла;
			
			ЗаказПоставщику.МаксимальныйКодСтроки = МаксКодСтрокиВЗаказеПоставщику; //+++ {{ ASP 01.02.2021 000009653 }}
			
			Попытка
				ЗаказПоставщику.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				Отказ = Истина;
				Сообщить("Не удалось провести заказ поставщику " + Объект.ЗаказПоставщику);
			КонецПопытки;
			#КонецОбласти
		КонецЕсли;
	КонецЕсли	
	////ASP_Dante 28/11/19
	
	
КонецПроцедуры

Процедура ASP_ОбработатьПриНеобходимостиИзменениеКоличества(Документ, СтрокаЗаказа, ТекущееКоличество)
	
	Если СтрокаЗаказа.Количество <> ТекущееКоличество Тогда
		СтрокаЗаказа.Количество = ТекущееКоличество;
		СтрокаЗаказа.КоличествоУпаковок = ТекущееКоличество;
		
		СтруктураДействий = Новый Структура;
		asp_ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, Документ);	
	    ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаЗаказа, СтруктураДействий, Неопределено);
	КонецЕсли;
	
КонецПроцедуры

Процедура asp_ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, Объект)
	
	СтруктураПересчетаСуммы = ОбработкаТабличнойЧастиКлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Объект);
	СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
	СтруктураДействий.Вставить("ПересчитатьСумму");
	СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
	Если Не ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказПоставщику") Тогда 
		СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
	КонецЕсли;
	
КонецПроцедуры

Функция ASP_ДобавитьСтрокуВПриобретениеТоваров(Приобретение, СтрокаТаблицыВыгруженнойИзТЧ, ОчиститьНазначение)
	
	СтрокаЗаказа = Приобретение.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаЗаказа, СтрокаТаблицыВыгруженнойИзТЧ);
	
	Если ОчиститьНазначение И ЗначениеЗаполнено(СтрокаТаблицыВыгруженнойИзТЧ.Назначение) Тогда
		СтрокаЗаказа.ASP_ЗаказКлиента = СтрокаТаблицыВыгруженнойИзТЧ.Назначение.Заказ;
		СтрокаЗаказа.Назначение = Справочники.Назначения.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтрокаЗаказа;
	
КонецФункции

Функция ASP_ДобавитьСтрокуВЗаказПоставщику(ЗаказПоставщику, СтрокаТаблицыВыгруженнойИзТЧ, ОчиститьНазначение)
	
	СтрокаЗаказа = ЗаказПоставщику.Товары.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаЗаказа, СтрокаТаблицыВыгруженнойИзТЧ);
	
	Если ОчиститьНазначение И ЗначениеЗаполнено(СтрокаТаблицыВыгруженнойИзТЧ.Назначение) Тогда
		СтрокаЗаказа.ASP_ЗаказКлиента = СтрокаТаблицыВыгруженнойИзТЧ.Назначение.Заказ;
		СтрокаЗаказа.Назначение = Справочники.Назначения.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СтрокаЗаказа;
	
КонецФункции

Функция НайтиПриобретениеПоТребованию(Требование)
	
	Запрос = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПриобретениеТоваровУслуг.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПриобретениеТоваровУслуг КАК ПриобретениеТоваровУслуг
	               |ГДЕ
	               |	ПриобретениеТоваровУслуг.Проведен
	               |	И ПриобретениеТоваровУслуг.ЗаказПоставщику = &ЗаказПоставщику";
	Запрос.УстановитьПараметр("ЗаказПоставщику", Требование);
	Рез = Запрос.Выполнить().Выгрузить();
	Возврат Рез.ВыгрузитьКолонку("Ссылка");

