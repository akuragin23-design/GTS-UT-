&НаСервере
Процедура ПересчитатьДолиСтоимостиНаСервере(Комплект, Характеристика, ВидЦен)
	
	НаборЗаписей = РегистрыСведений.КомплектующиеНоменклатуры.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(Комплект);
	НаборЗаписей.Отбор.ХарактеристикаНоменклатуры.Установить(Характеристика);
	НаборЗаписей.Прочитать();
	
	ТЗ_ДляРасчета = НаборЗаписей.Выгрузить();
	
	ТЗ_ДляРасчета.Колонки.Добавить("Сумма");
	
	ЗапросЦены = Новый Запрос;
	ЗапросЦены.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Характеристика,
	|	ЦеныНоменклатурыСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			,
	|			ВидЦены = &ВидЦен
	|				И Номенклатура В (&Комплектующие)
	|				И Характеристика В (&ХарактеристикиКомплектующих)) КАК ЦеныНоменклатурыСрезПоследних";
	ЗапросЦены.УстановитьПараметр("ВидЦен", ВидЦен);
	ЗапросЦены.УстановитьПараметр("Комплектующие", НаборЗаписей.ВыгрузитьКолонку("Комплектующая"));
	ЗапросЦены.УстановитьПараметр("ХарактеристикиКомплектующих", НаборЗаписей.ВыгрузитьКолонку("ХарактеристикаКомплектующей"));
	
	ТЗ_Цены = ЗапросЦены.Выполнить().Выгрузить();
	
	Для каждого СтрокаДляРасчета Из ТЗ_ДляРасчета Цикл
		СтрокиЦены = ТЗ_Цены.НайтиСтроки(Новый Структура("Номенклатура, Характеристика", СтрокаДляРасчета.Комплектующая, СтрокаДляРасчета.ХарактеристикаКомплектующей));
		Если СтрокиЦены.Количество() = 0 Тогда
			Сообщить("Не обнаружена цена для комплетующей: " + СтрокаДляРасчета.Комплектующая, СтатусСообщения.Важное);	
			СтрокаДляРасчета.Сумма = 0;
			Продолжить;
		КонецЕсли;	
		СтрокаДляРасчета.Сумма = СтрокаДляРасчета.Количество*СтрокиЦены[0].Цена;
	КонецЦикла;	
	
	СуммаИтого =  ТЗ_ДляРасчета.Итог("Сумма");
	РаспределятьПропорциональноКоличеству = Ложь;
	Если СуммаИтого = 0 Тогда
		РаспределятьПропорциональноКоличеству = Истина;
	КонецЕсли;
	
	НомерСтроки = 0;
	ОсталосьДоли = 100;
	ВсегоЗаписей = НаборЗаписей.Количество();
	Для каждого Запись Из НаборЗаписей Цикл
		НомерСтроки = НомерСтроки + 1;
		
		СтрокиРасчета = ТЗ_ДляРасчета.НайтиСтроки(Новый Структура("Комплектующая, ХарактеристикаКомплектующей", Запись.Комплектующая, Запись.ХарактеристикаКомплектующей));
		Если НомерСтроки = ВсегоЗаписей Тогда
			Запись.ДоляСтоимости = ОсталосьДоли;
		Иначе
			Если РаспределятьПропорциональноКоличеству Тогда
				Запись.ДоляСтоимости = 100 / ВсегоЗаписей;
			Иначе	
				Запись.ДоляСтоимости = СтрокиРасчета[0].Сумма * 100 / СуммаИтого;	
			КонецЕсли;
		КонецЕсли;
		
		ОсталосьДоли = ОсталосьДоли - Запись.ДоляСтоимости;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры//ПересчитатьДолиСтоимостиНаСервере	

&НаКлиенте
Процедура КомплектПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Список.Отбор, "Номенклатура", Комплект, , , ЗначениеЗаполнено(Комплект)
	);


КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Номенклатура") Тогда

		Комплект = Параметры.Отбор.Номенклатура;

		Если Комплект.ВидНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			
			АвтоЗаголовок = Ложь;
			Заголовок = НСтр("ru = 'Для услуг комплектующие не используются'");

			Элементы.Список.ТолькоПросмотр = Истина;
			
		КонецЕсли;

		Элементы.Комплект.Видимость = Ложь;
		Элементы.Номенклатура.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьДолиСтоимостиПоВидуЦен(Команда)
	
	Если Элементы.Список.ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВидЦен = Неопределено;
	Если ВвестиЗначение(ВидЦен,,Тип("СправочникСсылка.ВидыЦен")) Тогда
		ПересчитатьДолиСтоимостиНаСервере(Элементы.Список.ТекущаяСтрока.Номенклатура, Элементы.Список.ТекущаяСтрока.ХарактеристикаНоменклатуры, ВидЦен);	
	КонецЕсли;	
	
	Элементы.Список.Обновить();
КонецПроцедуры
