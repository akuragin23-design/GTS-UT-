				КонецПопытки;
			КонецЕсли;
		//КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОстаткиВзаиморасчетов(Команда)
	Если НЕ ДатаПереходаЗаполнена() Тогда
		Возврат;
	КонецЕсли;
	КоличествоПар = КоличествоПарКОбнулениюНаСервере();
	Если КоличествоПар = 0 Тогда
		Предупреждение("На выбранную дату нет остатков для обнуления.");
		Возврат;
	КонецЕсли;
	ТекстВопроса = "Будут созданы корректировки по " + Строка(КоличествоПар)
		+ " парам контрагент/организация."
		+ " Списание дебиторки — на " + Формат(Дата, "ДФ=dd.MM.yyyy")
		+ ", кредиторки — на следующий день."
		+ " Операция изменит взаиморасчеты. Продолжить?";
	Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститьОстаткиВзаиморасчетовНаСервере();
	Предупреждение("Обнуление завершено. Проверьте документы ""Корректировка задолженности"" с комментарием 000030020.");
КонецПроцедуры

&НаСервере
Процедура ВключитьУчетДоговоровВРасчетахНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоглашенияСКлиентами.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СоглашенияСКлиентами КАК СоглашенияСКлиентами
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоглашенияСПоставщиками.Ссылка
		|ИЗ
		|	Справочник.СоглашенияСПоставщиками КАК СоглашенияСПоставщиками";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Соглашение = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Соглашение.ИспользуютсяДоговорыКонтрагентов = Истина;
		Соглашение.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПустаяСсылка();
		Попытка
			Соглашение.Записать();
		Исключение
			Сообщить("При записи соглашения " + Соглашение + " возникла ошибка: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Договор = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		Если Не Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов Тогда
			Договор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
			
			Если (Договор.ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов 
				И Договор.ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоДоговорамНакладным)
				ИЛИ (Договор.ТипДоговора = Перечисления.ТипыДоговоров.СКомиссионером
				И Договор.КомиссионныеПродажи25) Тогда
				Договор.ЗаданГрафикИсполнения = Ложь;
			КонецЕсли;
			Попытка
				Договор.Записать();
			Исключение
				Сообщить("При записи договора " + Договор + " возникла ошибка: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

