&НаСервере
Процедура ЗаполнитьНалогообложениеИВидДеятельности(ПерезаполнитьНалогообложениеИВидДеятельности = Истина, ОбъектДоговор)
	
	Если Перечисления.ТипыДоговоров.ЭтоДоговорПродажи(ОбъектДоговор.ТипДоговора) Тогда
		ПараметрыЗаполнения = Справочники.ДоговорыКонтрагентов.ПараметрыЗаполненияНалогообложенияНДСПродажи(ОбъектДоговор);
		Если ОбъектДоговор.НалогообложениеНДСОпределяетсяВДокументе
			И ЗначениеЗаполнено(ОбъектДоговор.НалогообложениеНДС) Тогда
			ОбъектДоговор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПустаяСсылка();
		ИначеЕсли Не ОбъектДоговор.НалогообложениеНДСОпределяетсяВДокументе
			И ПерезаполнитьНалогообложениеИВидДеятельности Тогда
			УчетНДСУП.ЗаполнитьНалогообложениеНДСПродажи(ОбъектДоговор.НалогообложениеНДС,
															ПараметрыЗаполнения);
		КонецЕсли;
		//УчетНДСУП.ЗаполнитьСписокВыбораНалогообложенияНДСПродажи(Элементы.НалогообложениеНДС,
		//															ОбъектДоговор.НалогообложениеНДС,
		//															ПараметрыЗаполнения); 
	ИначеЕсли Перечисления.ТипыДоговоров.ЭтоДоговорЗакупки(ОбъектДоговор.ТипДоговора) Тогда
		ПараметрыЗаполнения = Справочники.ДоговорыКонтрагентов.ПараметрыЗаполненияНалогообложенияНДСЗакупки(ОбъектДоговор);
		Если ОбъектДоговор.НалогообложениеНДСОпределяетсяВДокументе
			И ЗначениеЗаполнено(ОбъектДоговор.НалогообложениеНДС) Тогда
			ОбъектДоговор.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПустаяСсылка();
		ИначеЕсли Не ОбъектДоговор.НалогообложениеНДСОпределяетсяВДокументе
			И ПерезаполнитьНалогообложениеИВидДеятельности Тогда
			УчетНДСУП.ЗаполнитьНалогообложениеНДСЗакупки(ОбъектДоговор.НалогообложениеНДС,
															ПараметрыЗаполнения);
		КонецЕсли;
		//УчетНДСУП.ЗаполнитьСписокВыбораНалогообложенияНДСЗакупки(Элементы.НалогообложениеНДС,
		//															ОбъектДоговор.НалогообложениеНДС,
		//															ПараметрыЗаполнения);
		
		ПараметрыЗаполнения = Справочники.ДоговорыКонтрагентов.ПараметрыЗаполненияВидаДеятельностиНДС(ОбъектДоговор);
		Если ОбъектДоговор.ЗакупкаПодДеятельностьОпределяетсяВДокументе
			И ЗначениеЗаполнено(ОбъектДоговор.ЗакупкаПодДеятельность) Тогда
			ОбъектДоговор.ЗакупкаПодДеятельность = Перечисления.ТипыНалогообложенияНДС.ПустаяСсылка();
		ИначеЕсли Не ОбъектДоговор.ЗакупкаПодДеятельностьОпределяетсяВДокументе
			И ПерезаполнитьНалогообложениеИВидДеятельности Тогда
			УчетНДСУП.ЗаполнитьВидДеятельностиНДС(ОбъектДоговор.ЗакупкаПодДеятельность,
													ПараметрыЗаполнения);
		КонецЕсли;
		//УчетНДСУП.ЗаполнитьСписокВыбораВидаДеятельностиНДС(Элементы.ЗакупкаПодДеятельность,
		//													ОбъектДоговор.ЗакупкаПодДеятельность,
		//													ПараметрыЗаполнения);
		
		//ВыборВидаДеятельностиНДС = Элементы.ЗакупкаПодДеятельность.Видимость;
		//Элементы.РежимРаздельногоУчетаНДСОпределяетсяЗначением.Видимость = ВыборВидаДеятельностиНДС;
		//Элементы.РежимРаздельногоУчетаНДС.Видимость = ВыборВидаДеятельностиНДС;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗначенияРеквизитовДисконтирования(ОбъектДоговор)
	
	Если Перечисления.ТипыДоговоров.ЭтоДоговорЗакупки(ОбъектДоговор.ТипДоговора) Тогда
		НастройкиУчетнойПолитикиФинУчета = НастройкиНалоговУчетныхПолитик.ДействующиеПараметрыНалоговУчетныхПолитикНаДату(
			"УчетнаяПолитикаФинансовогоУчета",
			ОбъектДоговор.Организация);
		ОбъектДоговор.СтавкаДисконтирования = РегистрыСведений.СтавкиДисконтирования.ПолучитьСтавкуДисконтированияПоУмолчанию(
			НастройкиУчетнойПолитикиФинУчета.Период, 
			НастройкиУчетнойПолитикиФинУчета.Организация, 
			ОбъектДоговор.ВалютаВзаиморасчетов);
		ПрименитьСтавкуДисконтированияПоРассрочке = ОбъектДоговор.СтавкаДисконтирования <> 0;
		ОбъектДоговор.СрокДляПримененияДисконтирования = НастройкиУчетнойПолитикиФинУчета.СрокДляПримененияДисконтирования;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НалогообложениеНДСПриИзмененииСервер(ОбъектДоговор)
	
	Если ЗначениеЗаполнено(ОбъектДоговор.НалогообложениеНДС) Тогда
		Если ЗначениеЗаполнено(ОбъектДоговор.СтавкаНДС) Тогда
			Если Не УчетНДСУП.СтавкаНДСКорректна(ОбъектДоговор.СтавкаНДС, ОбъектДоговор.НалогообложениеНДС, ОбъектДоговор.Организация, ОбъектДоговор.ДатаОкончанияДействия) Тогда
				ОбъектДоговор.СтавкаНДС = Справочники.СтавкиНДС.ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		
		УчетНДСУП.ЗаполнитьСтавкуНДСДляПлатежей(ОбъектДоговор.СтавкаНДС,
			ОбъектДоговор.НалогообложениеНДС,
			ОбъектДоговор.Организация,
			ОбъектДоговор.ДатаОкончанияДействия
		);
	КонецЕсли;
	
	//УстановитьСвойстваЭлементовНалогообложенияИРаздельногоУчетаНДС();
	//ПриОкончанииИзмененияРеквизитаЛокализацииНаСервере("НалогообложениеНДС", Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ПорядокРасчетовПриИзмененииСервер(ОбъектДоговор)
	
	Если (ОбъектДоговор.ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов 
		И ОбъектДоговор.ПорядокРасчетов <> Перечисления.ПорядокРасчетов.ПоДоговорамНакладным)
		ИЛИ (ОбъектДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СКомиссионером
			И ОбъектДоговор.КомиссионныеПродажи25) Тогда
		ОбъектДоговор.ЗаданГрафикИсполнения = Ложь;
	КонецЕсли;
	
	//Если ОбъектДоговор.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.ФиксированныйНаДатуОтгрузки
	//	И Не ДоступностьФиксированногоКурсаНаДатуОтгрузки() Тогда
	//	ОбъектДоговор.ВариантКурсаДоговора = Перечисления.ВариантыКурсаДоговора.Переменный;
	//КонецЕсли;
	
	//УправлениеЭлементамиГрафикИсполнения();
	//УстановитьВидимостьЦентрализованногоДоговора();
	//УправлениеЭлементамиВариантКурсаДоговора();
	//ВзаиморасчетыСервер.ФормаПриИзмененииРеквизитов(ЭтаФорма, "ПорядокРасчетов");
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНачальныеОстаткиНаСервере()
	ПроверитьДатуПерехода();
	Если ТЗОстаткиНаФорме.Количество() = 0 Тогда
		ВызватьИсключение "Таблица остатков не заполнена. Сначала выполните выгрузку из БП.";
	КонецЕсли;
	
	ОшибкиЗаполнения = Новый Массив;
	Для Каждого ПроверяемаяСтрока Из ТЗОстаткиНаФорме Цикл
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Контрагент) Тогда
			ОшибкиЗаполнения.Добавить("не заполнен контрагент: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Договор) Тогда
			ОшибкиЗаполнения.Добавить("не заполнен договор: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Организация) Тогда
			ОшибкиЗаполнения.Добавить("не заполнена организация: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Валюта) Тогда
			ОшибкиЗаполнения.Добавить("не заполнена валюта: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если ПроверяемаяСтрока.Счет <> 60 И ПроверяемаяСтрока.Счет <> 62 Тогда
			ОшибкиЗаполнения.Добавить("неподдерживаемый счет: " + Строка(ПроверяемаяСтрока.Счет));
		КонецЕсли;
		Если ЗначениеЗаполнено(ПроверяемаяСтрока.Договор)
			И ЗначениеЗаполнено(ПроверяемаяСтрока.Организация)
			И (ПроверяемаяСтрока.Счет = 60 ИЛИ ПроверяемаяСтрока.Счет = 62)
			И НЕ ЗначениеЗаполнено(НайтиОбъектРасчетовПоДоговору(ПроверяемаяСтрока.Договор, ПроверяемаяСтрока.Организация, ПроверяемаяСтрока.Счет)) Тогда
			ОшибкиЗаполнения.Добавить("не найден объект расчетов: " + Строка(ПроверяемаяСтрока.Договор)
				+ " / " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
	КонецЦикла;
	
	Если ОшибкиЗаполнения.Количество() > 0 Тогда
		ТекстОшибок = СтрСоединить(ОшибкиЗаполнения, Символы.ПС);
		ВызватьИсключение "Загрузка запрещена. Исправьте ошибки:" + Символы.ПС + ТекстОшибок;
	КонецЕсли;
	
	КомментарийЗагрузки = КомментарийЗагрузкиОстатков();
	ЗапросПовторнойЗагрузки = Новый Запрос;
	ЗапросПовторнойЗагрузки.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Остатки.Ссылка
		|ИЗ
		|	Документ.ВводОстатковВзаиморасчетов КАК Остатки
		|ГДЕ
		|	Остатки.Проведен
		|	И (Остатки.Комментарий = &Комментарий
		|		ИЛИ Остатки.Комментарий = ""Ввод остатков из БП"")
		|	И Остатки.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	ЗапросПовторнойЗагрузки.УстановитьПараметр("Комментарий", КомментарийЗагрузки);
	ЗапросПовторнойЗагрузки.УстановитьПараметр("НачалоПериода", НачалоДня(Дата));
	ЗапросПовторнойЗагрузки.УстановитьПараметр("КонецПериода", КонецДня(Дата));
	Если НЕ ЗапросПовторнойЗагрузки.Выполнить().Пустой() Тогда
		ВызватьИсключение "Начальные остатки за выбранную дату уже загружены. Повторный запуск запрещен.";
	КонецЕсли;
	
	Организации = ТЗОстаткиНаФорме.Выгрузить(,"Организация");
	Организации.Свернуть("Организация");
	Для каждого ОрганизацияСтр Из Организации Цикл
		//Для 60 счета
		ВводОстатковДт60 = Документы.ВводОстатковВзаиморасчетов.СоздатьДокумент();
		ВводОстатковДт60.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковАвансовПоставщикам;
		ВводОстатковДт60.Организация = ОрганизацияСтр.Организация;
		ВводОстатковДт60.Комментарий = КомментарийЗагрузки;
		ВводОстатковДт60.ОтражатьВОперативномУчете = Истина;
		ВводОстатковДт60.ОтражатьВБУиНУ = Ложь;
		ВводОстатковДт60.ОтражатьВУУ = Ложь;
		
		ВводОстатковКт60 = Документы.ВводОстатковВзаиморасчетов.СоздатьДокумент();
		ВводОстатковКт60.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиПоставщикам;
		ВводОстатковКт60.Организация = ОрганизацияСтр.Организация;	
		ВводОстатковКт60.Комментарий = КомментарийЗагрузки;
		ВводОстатковКт60.ОтражатьВОперативномУчете = Истина;
		ВводОстатковКт60.ОтражатьВБУиНУ = Ложь;
		ВводОстатковКт60.ОтражатьВУУ = Ложь;
        //Для 62 счета
		ВводОстатковДт62 = Документы.ВводОстатковВзаиморасчетов.СоздатьДокумент();
		ВводОстатковДт62.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиКлиентов;
		ВводОстатковДт62.Организация = ОрганизацияСтр.Организация;
		ВводОстатковДт62.Комментарий = КомментарийЗагрузки;
		ВводОстатковДт62.ОтражатьВОперативномУчете = Истина;
		ВводОстатковДт62.ОтражатьВБУиНУ = Ложь;
		ВводОстатковДт62.ОтражатьВУУ = Ложь;
		
		ВводОстатковКт62 = Документы.ВводОстатковВзаиморасчетов.СоздатьДокумент();
		ВводОстатковКт62.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковАвансовКлиентов;
		ВводОстатковКт62.Организация = ОрганизацияСтр.Организация;	
		ВводОстатковКт62.Комментарий = КомментарийЗагрузки;
		ВводОстатковКт62.ОтражатьВОперативномУчете = Истина;
		ВводОстатковКт62.ОтражатьВБУиНУ = Ложь;
		ВводОстатковКт62.ОтражатьВУУ = Ложь;
		
		Для каждого СтрокаОстатки Из ТЗОстаткиНаФорме Цикл
			Если СтрокаОстатки.Счет = 60 И СтрокаОстатки.Организация = ОрганизацияСтр.Организация И НЕ СтрокаОстатки.Контрагент = Справочники.Контрагенты.ПустаяСсылка() И ЗначениеЗаполнено(СтрокаОстатки.Контрагент) Тогда
				
				//ВводОстатковДт60 = Документы.ВводОстатковВзаиморасчетов.СоздатьДокумент();
				//ВводОстатковДт60.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковАвансовПоставщикам;
				//ВводОстатковДт60.Организация = ОрганизацияСтр.Организация;
				//ВводОстатковДт60.Комментарий = "Ввод остатков из БП";
				//ВводОстатковДт60.ОтражатьВОперативномУчете = Истина;
				//ВводОстатковДт60.ОтражатьВБУиНУ = Ложь;
				//ВводОстатковДт60.ОтражатьВУУ = Ложь;
				//
				//ВводОстатковКт60 = Документы.ВводОстатков.СоздатьДокумент();
				//ВводОстатковКт60.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиПоставщикам;
				//ВводОстатковКт.Организация = ОрганизацияСтр.Организация;	
				//ВводОстатковКт.Комментарий = "Ввод остатков из БП";
				//ВводОстатковКт.ОтражатьВОперативномУчете = Истина;
				//ВводОстатковКт.ОтражатьВБУиНУ = Ложь;
				//ВводОстатковКт.ОтражатьВУУ = Ложь;

				
				Если СтрокаОстатки.ОстатокДт <> 0 Тогда
					
					Если СтрокаОстатки.ОстатокДт > 0 Тогда
						СтрокаВводаОстатковДТ = ВводОстатковДт60.РасчетыСПартнерами.Добавить();	
						СтрокаВводаОстатковДТ.Контрагент = СтрокаОстатки.Контрагент;
						СтрокаВводаОстатковДТ.Партнер = СтрокаОстатки.Контрагент.Партнер;
						СтрокаВводаОстатковДТ.ОбъектРасчетов = СтрокаОстатки.Договор;
						СтрокаВводаОстатковДТ.ОбъектРасчетовОтправитель = НайтиОбъектРасчетовПоДоговору(СтрокаОстатки.Договор, СтрокаОстатки.Организация, СтрокаОстатки.Счет);
						СтрокаВводаОстатковДТ.Договор = СтрокаОстатки.Договор;
						СтрокаВводаОстатковДТ.ВалютаВзаиморасчетов = СтрокаОстатки.Валюта;
						РасчетныйДокумент = Документы.ПервичныйДокумент.СоздатьДокумент();
						
						//РасчетныйДокумент.ТипПервичногоДокумента = Перечисления.ТипыПервичныхДокументов.ОплатаПоставщику;
						ДанныеЗаполнения = Новый Структура;
						ДанныеЗаполнения.Вставить("Контрагент", СтрокаВводаОстатковДТ.Контрагент);
						ДанныеЗаполнения.Вставить("Партнер", СтрокаВводаОстатковДТ.Партнер);
						ДанныеЗаполнения.Вставить("ОбъектРасчетов", СтрокаВводаОстатковДТ.ОбъектРасчетовОтправитель);
						ДанныеЗаполнения.Вставить("ОбъектРасчетовОтправитель", СтрокаВводаОстатковДТ.ОбъектРасчетовОтправитель);
						ДанныеЗаполнения.Вставить("Договор", СтрокаВводаОстатковДТ.Договор);
