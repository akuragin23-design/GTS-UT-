
#Область СлужебныеПроцедуры

&НаСервере
Процедура ПроверитьДатуПерехода()
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		ВызватьИсключение "Заполните дату на форме. Для перехода укажите 01.07.2026.";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ДатаПереходаЗаполнена()
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Предупреждение("Заполните дату на форме. Для перехода укажите 01.07.2026.");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаСервере
Функция КомментарийОбнуленияОстатков()
	Возврат "000030020 обнуление остатков " + Формат(НачалоДня(Дата), "ДФ=dd.MM.yyyy");
КонецФункции

&НаСервере
Функция КомментарийЗагрузкиОстатков()
	Возврат "000030020 ввод остатков из БП " + Формат(НачалоДня(Дата), "ДФ=dd.MM.yyyy");
КонецФункции

&НаСервере
Функция НайтиОбъектРасчетовПоДоговору(Договор, Организация, Счет)
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат Справочники.ОбъектыРасчетов.ПустаяСсылка();
	КонецЕсли;
	ТипРасчетов = ?(Счет = 62,
		Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом,
		Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком);
	ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Договор, Организация, ТипРасчетов);
	Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
		ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Договор, Организация);
	КонецЕсли;
	Возврат ОбъектРасчетов;
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуВводаОстатков(ДокументВвода, СтрокаОстатки, ТипПервичногоДокумента, СуммаРегл, ВалютнаяСумма, УстановитьДатуПлатежа)
	ОбъектРасчетовСправочник = НайтиОбъектРасчетовПоДоговору(СтрокаОстатки.Договор, СтрокаОстатки.Организация, СтрокаОстатки.Счет);
	Если НЕ ЗначениеЗаполнено(ОбъектРасчетовСправочник) Тогда
		ВызватьИсключение "Не найден объект расчетов по договору """ + СтрокаОстатки.Договор
			+ """ (счет " + Строка(СтрокаОстатки.Счет) + "). Откройте договор в УТ, чтобы система создала объект расчетов, и повторите загрузку.";
	КонецЕсли;
	СтрокаВвода = ДокументВвода.РасчетыСПартнерами.Добавить();
	СтрокаВвода.Контрагент = СтрокаОстатки.Контрагент;
	СтрокаВвода.Партнер = СтрокаОстатки.Контрагент.Партнер;
	СтрокаВвода.ОбъектРасчетов = СтрокаОстатки.Договор;
	СтрокаВвода.ОбъектРасчетовОтправитель = ОбъектРасчетовСправочник;
	СтрокаВвода.Договор = СтрокаОстатки.Договор;
	СтрокаВвода.ВалютаВзаиморасчетов = СтрокаОстатки.Валюта;
	РасчетныйДокумент = Документы.ПервичныйДокумент.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Контрагент", СтрокаВвода.Контрагент);
	ДанныеЗаполнения.Вставить("Партнер", СтрокаВвода.Партнер);
	ДанныеЗаполнения.Вставить("ОбъектРасчетов", ОбъектРасчетовСправочник);
	ДанныеЗаполнения.Вставить("Договор", СтрокаВвода.Договор);
	ДанныеЗаполнения.Вставить("ВалютаВзаиморасчетов", СтрокаВвода.ВалютаВзаиморасчетов);
	ДанныеЗаполнения.Вставить("Валюта", СтрокаВвода.ВалютаВзаиморасчетов);
	ДанныеЗаполнения.Вставить("Организация", ДокументВвода.Организация);
	ДанныеЗаполнения.Вставить("ТипПервичногоДокумента", ТипПервичногоДокумента);
	РасчетныйДокумент.Заполнить(ДанныеЗаполнения);
	РасчетныйДокумент.Дата = Дата;
	РасчетныйДокумент.СуммаДокумента = СуммаРегл;
	СуммаДокументаПриИзменении(РасчетныйДокумент);
	Если НЕ СтрокаОстатки.Валюта = Константы.ВалютаУправленческогоУчета.Получить() И ВалютнаяСумма <> 0 Тогда
		СтрокаВвода.Сумма = ВалютнаяСумма;
		СтрокаВвода.СуммаРегл = СуммаРегл;
		СтрокаВвода.СуммаУпр = СуммаРегл;
	Иначе
		СтрокаВвода.Сумма = СуммаРегл;
		СтрокаВвода.СуммаРегл = СуммаРегл;
		СтрокаВвода.СуммаУпр = СуммаРегл;
		СтрокаВвода.ВалютаВзаиморасчетов = Константы.ВалютаУправленческогоУчета.Получить();
	КонецЕсли;
	РасчетныйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	СтрокаВвода.ДокументРасчетов = РасчетныйДокумент.Ссылка;
	Если УстановитьДатуПлатежа Тогда
		СтрокаВвода.ДатаПлатежа = РасчетныйДокумент.Дата;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ВыполнитькорректировкуВзаиморасчетовНаСервере(ВыгрузитьСчет60, ВыгрузитьСчет62, ПарольБП)
ПроверитьДатуПерехода();
Если НЕ ВыгрузитьСчет60 И НЕ ВыгрузитьСчет62 Тогда
	ВызватьИсключение "Включите выгрузку счета 60 и/или 62.";
КонецЕсли;
Соединение = ПодключитьсяКбазе(ПарольБП);
Если ТипЗнч(Соединение) <> Тип("Неопределено") Тогда 
	ЗапросБПЗО = Соединение.NewObject("Запрос");
	ЗапросБПЗО.Текст =                      "ВЫБРАТЬ
	  	                                       |	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстаток, 0)) КАК СуммаОстаток,
	  	                                       |	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстатокДт, 0)) КАК СуммаОстатокДт,
	  	                                       |	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстатокКт, 0)) КАК СуммаОстатокКт,
	  	                                       |	ХозрасчетныйОстатки.Субконто1.Наименование КАК Контрагент,
											   |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто1.Ссылка) КАК КонтрагентСсылка,
	  	                                       |	ХозрасчетныйОстатки.Субконто2.Наименование КАК Договор,
											   |	ХозрасчетныйОстатки.Субконто2.Номер КАК ДоговорНомер,
	  	                                       |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто2.Ссылка) КАК ДоговорСсылка,
	  	                                       |	ВЫБОР
	  	                                       |		КОГДА ХозрасчетныйОстатки.Счет.Код ПОДОБНО ""62%""
	  	                                       |			ТОГДА 62
	  	                                       |		ИНАЧЕ 60
	  	                                       |	КОНЕЦ КАК Счет,
	  	                                       |	ЕСТЬNULL(ХозрасчетныйОстатки.Валюта.Наименование, ""Руб"") КАК Валюта,
	  	                                       |	ХозрасчетныйОстатки.Организация.Наименование КАК Организация,
	  	                                       |	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.ВалютнаяСуммаОстаток, 0)) КАК ВалютнаяСуммаОстаток,
	  	                                       |	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.ВалютнаяСуммаОстатокДт, 0)) КАК ВалютнаяСуммаОстатокДт,
	  	                                       |	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.ВалютнаяСуммаОстатокКт, 0)) КАК ВалютнаяСуммаОстатокКт,
	  	                                       |	ХозрасчетныйОстатки.Субконто1.ИНН КАК КонтрагентИНН,
	  	                                       |	ХозрасчетныйОстатки.Субконто1.КПП КАК КонтрагентКПП
	  	                                       |ИЗ
	  	                                       |	РегистрБухгалтерии.Хозрасчетный.Остатки(&дата, Счет В (&Счет), , ) КАК ХозрасчетныйОстатки
	  	                                       |
	  	                                       |СГРУППИРОВАТЬ ПО
	  	                                       |	ХозрасчетныйОстатки.Субконто1.Наименование,                  
											   |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто1.Ссылка),
	  	                                       |	ХозрасчетныйОстатки.Субконто2.Наименование,
											   |	ХозрасчетныйОстатки.Субконто2.Номер,
	  	                                       |	ВЫБОР
	  	                                       |		КОГДА ХозрасчетныйОстатки.Счет.Код ПОДОБНО ""62%""
	  	                                       |			ТОГДА 62
	  	                                       |		ИНАЧЕ 60
	  	                                       |	КОНЕЦ,
	  	                                       |	ХозрасчетныйОстатки.Организация.Наименование,
	  	                                       |	ЕСТЬNULL(ХозрасчетныйОстатки.Валюта.Наименование, ""Руб""),
	  	                                       |	ХозрасчетныйОстатки.Субконто1.ИНН,
	  	                                       |	ХозрасчетныйОстатки.Субконто1.КПП,
	  	                                       |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто2.Ссылка)"   ;
	ЗапросБПЗО.УстановитьПараметр("Дата", НачалоДня(Дата));
	
	МассивСчетов = Соединение.NewObject("Массив");
	Если ВыгрузитьСчет60 Тогда	
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.02"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.03"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.21"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.22"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.31"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.32"));
	КонецЕсли; 
	
	Если ВыгрузитьСчет62 Тогда	
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.01"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.02"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.03"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.21"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.22"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.31"));
		МассивСчетов.Добавить(Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("62.32"));
	КонецЕсли;
	
	ТЗОстатки = Новый ТаблицаЗначений;
	ТЗОстатки.Колонки.Добавить("Счет", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗОстатки.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТЗОстатки.Колонки.Добавить("ДоговорВБП", Новый ОписаниеТипов("Строка"));
	ТЗОстатки.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТЗОстатки.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТЗОстатки.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ОстатокДт", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ОстатокКт", Новый ОписаниеТипов("Число"));
   	ТЗОстатки.Колонки.Добавить("ВалютныйОстаток", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ВалютныйОстатокДт", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ВалютныйОстатокКт", Новый ОписаниеТипов("Число"));

	
	ЗапросБПЗО.УстановитьПараметр("Счет", МассивСчетов);
	//ЗапросБПЗО.УстановитьПараметр("Счет", Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду("6001"));
	Выборка = Соединение.ЗначениеВСтрокуВнутр(ЗапросБПЗО.Выполнить().Выгрузить()); 
	Выборка = ЗначениеИзСтрокиВнутр(Выборка);
	Для Каждого СтрокаCOM Из Выборка Цикл
		НоваяСтрока = ТЗОстатки.Добавить();
		НоваяСтрока.Счет = СтрокаCOM.Счет;
		
		//НоваяСтрока.Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(СтрокаCOM.Контрагент);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторИсточника КАК УникальныйИдентификаторИсточника
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК СоответствияОбъектовИнформационныхБаз
		|ГДЕ
		|	СоответствияОбъектовИнформационныхБаз.УникальныйИдентификаторПриемника = &УникальныйИдентификаторПриемника";
		
		Запрос.УстановитьПараметр("УникальныйИдентификаторПриемника", Строка(СтрокаCOM.КонтрагентСсылка));
		//Запрос.УстановитьПараметр("КПП", СтрокаCOM.КонтрагентКПП);
		//Запрос.УстановитьПараметр("Наименование", СтрокаCOM.Контрагент);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			НоваяСтрока.Контрагент = ВыборкаДетальныеЗаписи.УникальныйИдентификаторИсточника;
		КонецЕсли;
		//Добавил в первичный поиск Контрагента КПП и ИНН по аналогии с правилами обмена
		
		Если НоваяСтрока.Контрагент = Справочники.Контрагенты.ПустаяСсылка() ИЛИ НоваяСтрока.Контрагент = Неопределено Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ПометкаУдаления = ЛОЖЬ
			|	И Контрагенты.ИНН = &ИНН
			|	И Контрагенты.КПП = &КПП
			|	И Контрагенты.Наименование = &Наименование";
			
			Запрос.УстановитьПараметр("ИНН", СтрокаCOM.КонтрагентИНН);
			Запрос.УстановитьПараметр("КПП", СтрокаCOM.КонтрагентКПП);
			Запрос.УстановитьПараметр("Наименование", СтрокаCOM.Контрагент);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				НоваяСтрока.Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
		КонецЕсли;

		Если НоваяСтрока.Контрагент = Справочники.Контрагенты.ПустаяСсылка() ИЛИ НоваяСтрока.Контрагент = Неопределено Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Контрагенты.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ПометкаУдаления = ЛОЖЬ
			|	И Контрагенты.ИНН = &ИНН
			|	И Контрагенты.КПП = &КПП";
			
			Запрос.УстановитьПараметр("ИНН", СтрокаCOM.КонтрагентИНН);
			Запрос.УстановитьПараметр("КПП", СтрокаCOM.КонтрагентКПП);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				НоваяСтрока.Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
	    КонецЕсли;

		Если НоваяСтрока.Контрагент = Справочники.Контрагенты.ПустаяСсылка() Тогда	
			 Сообщить("Не найден контрагент: "+ СтрокаCOM.Контрагент);
		Иначе	
			
			//Договор = Справочники.ДоговорыКонтрагентов.НайтиПоРеквизиту(СтрокаCOM.Договор);
			ОрганизацияУТ = Справочники.Организации.НайтиПоНаименованию(СтрокаCOM.Организация);
			
			//Поиск договора
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
			|ГДЕ
			|	ДоговорыКонтрагентов.Контрагент = &Контрагент
			|	И ДоговорыКонтрагентов.Организация = &Организация
			|	И ДоговорыКонтрагентов.Наименование = &Наименование
			|	И ДоговорыКонтрагентов.Номер = &ДоговорНомер
			|
			|СГРУППИРОВАТЬ ПО
			|	ДоговорыКонтрагентов.Наименование,
			|	ДоговорыКонтрагентов.Контрагент,
			|	ДоговорыКонтрагентов.Ссылка";
			
			Запрос.УстановитьПараметр("Контрагент", НоваяСтрока.Контрагент);
			Запрос.УстановитьПараметр("Организация", ОрганизацияУТ);
			Запрос.УстановитьПараметр("Наименование", СтрокаCOM.Договор);
			Запрос.УстановитьПараметр("ДоговорНомер", СтрокаCOM.ДоговорНомер);
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
			
			Если ВыборкаДетальныеЗаписи.Количество() = 1 Тогда
				Договор = ВыборкаДетальныеЗаписи[0].Ссылка;
			ИначеЕсли ВыборкаДетальныеЗаписи.Количество() > 1 Тогда
				Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
				Сообщить("Найдено несколько договоров: " + СтрокаCOM.Договор
					+ ". Выберите договор вручную в таблице.");
			Иначе
				Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
			КонецЕсли;
			
			НоваяСтрока.Договор = Договор;
			Если НЕ ЗначениеЗаполнено(Договор) Тогда
				Сообщить("Не найден договор в УТ: " + СтрокаCOM.Договор
					+ ". Укажите договор вручную в таблице перед загрузкой.");
			КонецЕсли;
		КонецЕсли;
		//НоменклатураНов    = Справочники.ммр_Номенклатура.СоздатьЭлемент();
		//Если Объект = Неопределено Тогда
		//	НоменклатураНов.УстановитьСсылкуНового(РезСсылка);
		//КонецЕсли;
		//НоменклатураНов.Наименование = Номенклатура;
		//НоменклатураНов.Записать();
	
		НоваяСтрока.ДоговорВБП = СтрокаCOM.Договор;
		НоваяСтрока.Организация = Справочники.Организации.НайтиПоНаименованию(СтрокаCOM.Организация);
		НоваяСтрока.Валюта = Справочники.Валюты.НайтиПоНаименованию(СтрокаCOM.Валюта);
		
		НоваяСтрока.Остаток = СтрокаCOM.СуммаОстаток;
		НоваяСтрока.ОстатокДт = СтрокаCOM.СуммаОстатокДт;
		НоваяСтрока.ОстатокКт = СтрокаCOM.СуммаОстатокКт;
		
		НоваяСтрока.ВалютныйОстаток = СтрокаCOM.ВалютнаяСуммаОстаток;
		НоваяСтрока.ВалютныйОстатокДт = СтрокаCOM.ВалютнаяСуммаОстатокДт;
		НоваяСтрока.ВалютныйОстатокКт = СтрокаCOM.ВалютнаяСуммаОстатокКт;


	КонецЦикла;
	//ТЗОстатки = Соединение.ЗначениеВСтрокуВнутр(Соединение.ASP_ОстаткиВзаиморасчетов.ВыполнитькорректировкуВзаиморасчетовНаСервере(Ложь, Истина));
	//ТЗОстатки = ЗначениеИзСтрокиВнутр(ТЗОстатки);
	ТЗОстаткиНаФорме.Загрузить(ТЗОстатки);
	Сообщить("Выгрузка из БП завершена. Строк в таблице: " + ТЗОстаткиНаФорме.Количество()
		+ ". Пустые договоры не создаются автоматически — заполните их вручную перед загрузкой.");
КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитькорректировкуВзаиморасчетов(Команда)
	Если НЕ ДатаПереходаЗаполнена() Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ВыгрузитьСчет60 И НЕ ВыгрузитьСчет62 Тогда
		Предупреждение("Включите выгрузку счета 60 и/или 62.");
		Возврат;
	КонецЕсли;
	ПарольБП = "";
	Если НЕ ВвестиСтроку(ПарольБП, "Пароль COM-подключения к БП (пользователь Программист, база buh82_old4)", 50) Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ПарольБП) Тогда
		Предупреждение("Пароль не введен. Выгрузка отменена.");
		Возврат;
	КонецЕсли;
	ВыполнитькорректировкуВзаиморасчетовНаСервере(ВыгрузитьСчет60, ВыгрузитьСчет62, ПарольБП);
КонецПроцедуры

&НаСервере
Функция ПодключитьсяКбазе(ПарольБП) Экспорт
	Если ПустаяСтрока(ПарольБП) Тогда
		ВызватьИсключение "Не указан пароль пользователя БП.";
	КонецЕсли;
	СерверБП = "172.17.0.235";
	БазаБП = "buh82_old4";
	ПользовательБП = "Программист";
	ПараметрыПодключенияИБ = "Srvr=""" + СерверБП + """; Ref=""" + БазаБП + """; Usr=""" + ПользовательБП + """; Pwd=""" + ПарольБП + """";
	V83COMCon = Неопределено;
	Попытка
		V83COMCon = Новый COMОбъект("V83.COMConnector");
	Исключение
		Попытка
			V83COMCon = Новый COMОбъект("V82.COMConnector");
		Исключение
			ВызватьИсключение "Не удалось создать COM-коннектор 1С (V83.COMConnector / V82.COMConnector). Установите COM-компонент платформы на сервере 1С.";
		КонецПопытки;
	КонецПопытки;
	Попытка
		Возврат V83COMCon.Connect(ПараметрыПодключенияИБ);
	Исключение
		ВызватьИсключение "Не удалось подключиться к БП " + БазаБП + " на сервере " + СерверБП + ": " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Функция КоличествоПарКОбнулениюНаСервере()
	ПроверитьДатуПерехода();
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Количество
		|ИЗ
		|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		Остатки.ОбъектРасчетов.Контрагент КАК Контрагент,
		|		Остатки.ОбъектРасчетов.Организация КАК Организация
		|	ИЗ
		|		РегистрНакопления.РасчетыСПоставщиками.Остатки(&Дата, ) КАК Остатки
		|	ГДЕ
		|		(Остатки.СуммаОстаток <> 0
		|			ИЛИ Остатки.ОплачиваетсяОстаток <> 0
		|			ИЛИ Остатки.КОплатеОстаток <> 0
		|			ИЛИ Остатки.КПоступлениюОстаток <> 0)
		|	
		|	ОБЪЕДИНИТЬ
		|	
		|	ВЫБРАТЬ РАЗЛИЧНЫЕ
		|		Остатки.ОбъектРасчетов.Контрагент,
		|		Остатки.ОбъектРасчетов.Организация
		|	ИЗ
		|		РегистрНакопления.РасчетыСКлиентами.Остатки(&Дата, ) КАК Остатки
		|	ГДЕ
		|		(Остатки.СуммаОстаток <> 0
		|			ИЛИ Остатки.КОплатеОстаток <> 0
		|			ИЛИ Остатки.ОплачиваетсяОстаток <> 0
		|			ИЛИ Остатки.КОтгрузкеОстаток <> 0
		|			ИЛИ Остатки.ОтгружаетсяОстаток <> 0)) КАК Пары";
	Запрос.УстановитьПараметр("Дата", Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаСервере
Процедура ОчиститьОстаткиВзаиморасчетовНаСервере()
	ПроверитьДатуПерехода();
	КомментарийОбнуления = КомментарийОбнуленияОстатков();
	ЗапросПовторногоЗапуска = Новый Запрос;
	ЗапросПовторногоЗапуска.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Корректировки.Ссылка
		|ИЗ
		|	Документ.КорректировкаЗадолженности КАК Корректировки
		|ГДЕ
		|	Корректировки.Проведен
		|	И (Корректировки.Комментарий = &Комментарий
		|		ИЛИ Корректировки.Комментарий = ""Переход на расчеты по договорам: обнуление остатков"")
		|	И Корректировки.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
	ЗапросПовторногоЗапуска.УстановитьПараметр("Комментарий", КомментарийОбнуления);
	ЗапросПовторногоЗапуска.УстановитьПараметр("НачалоПериода", НачалоДня(Дата));
	ЗапросПовторногоЗапуска.УстановитьПараметр("КонецПериода", КонецДня(Дата + 86400));
	Если НЕ ЗапросПовторногоЗапуска.Выполнить().Пустой() Тогда
		ВызватьИсключение "Обнуление за выбранную дату уже выполнялось. Повторный запуск запрещен.";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РасчетыСПоставщикамиОстатки.ОбъектРасчетов.Контрагент КАК ОбъектРасчетовКонтрагент,
		|	РасчетыСПоставщикамиОстатки.ОбъектРасчетов.Организация КАК ОбъектРасчетовОрганизация
		|ПОМЕСТИТЬ ВТ_Контрагенты
		|ИЗ
		|	РегистрНакопления.РасчетыСПоставщиками.Остатки(&Дата, ) КАК РасчетыСПоставщикамиОстатки
		|ГДЕ
		|	(РасчетыСПоставщикамиОстатки.СуммаОстаток <> 0
		|			ИЛИ РасчетыСПоставщикамиОстатки.ОплачиваетсяОстаток <> 0
		|			ИЛИ РасчетыСПоставщикамиОстатки.КОплатеОстаток <> 0
		|			ИЛИ РасчетыСПоставщикамиОстатки.КПоступлениюОстаток <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСПоставщикамиОстатки.ОбъектРасчетов.Контрагент,
		|	РасчетыСПоставщикамиОстатки.ОбъектРасчетов.Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РасчетыСКлиентамиОстатки.ОбъектРасчетов.Контрагент,
		|	РасчетыСКлиентамиОстатки.ОбъектРасчетов.Организация
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами.Остатки(&Дата, ) КАК РасчетыСКлиентамиОстатки
		|ГДЕ
		|	(РасчетыСКлиентамиОстатки.СуммаОстаток <> 0
		|			ИЛИ РасчетыСКлиентамиОстатки.КОплатеОстаток <> 0
		|			ИЛИ РасчетыСКлиентамиОстатки.ОплачиваетсяОстаток <> 0
		|			ИЛИ РасчетыСКлиентамиОстатки.КОтгрузкеОстаток <> 0
		|			ИЛИ РасчетыСКлиентамиОстатки.ОтгружаетсяОстаток <> 0)
		|
		|СГРУППИРОВАТЬ ПО
		|	РасчетыСКлиентамиОстатки.ОбъектРасчетов.Контрагент,
		|	РасчетыСКлиентамиОстатки.ОбъектРасчетов.Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Контрагенты.ОбъектРасчетовКонтрагент КАК ОбъектРасчетовКонтрагент,
		|	ВТ_Контрагенты.ОбъектРасчетовОрганизация КАК ОбъектРасчетовОрганизация
		|ИЗ
		|	ВТ_Контрагенты КАК ВТ_Контрагенты
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_Контрагенты.ОбъектРасчетовКонтрагент,
		|	ВТ_Контрагенты.ОбъектРасчетовОрганизация";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыгрузкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Для каждого СтрокаКонтрагент из ВыгрузкаДетальныеЗаписи Цикл
		
		//Если СтрокаКонтрагент.ОбъектРасчетовКонтрагент = Контрагент	Тогда
			
			НовыйКЗДебет = Документы.КорректировкаЗадолженности.СоздатьДокумент();
			НовыйКЗДебет.Организация = СтрокаКонтрагент.ОбъектРасчетовОрганизация;
			НовыйКЗДебет.Контрагент = СтрокаКонтрагент.ОбъектРасчетовКонтрагент;
			НовыйКЗДебет.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.СписаниеДебиторскойЗадолженности;
			НовыйКЗДебет.РасчетыМеждуОрганизациями = Ложь;
			НовыйКЗДебет.Исправление = Ложь;
			НовыйКЗДебет.ЭтоНачисление = Ложь;
			НовыйКЗДебет.КорреспонденцияСДоходами = Ложь; 
			НовыйКЗДебет.СтарыйВариантПроводок = Ложь;
			НовыйКЗДебет.Комментарий = КомментарийОбнуления;
			НовыйКЗДебет.Дата = Дата;
			
			ТипЗадолженности = Перечисления.ТипыЗадолженности.Дебиторская;
			ВзаиморасчетыСервер.ЗаполнитьЗадолженностьПоОстаткам(
			НовыйКЗДебет.Организация, 
			НовыйКЗДебет.Контрагент,
			ТипЗадолженности, 
			Неопределено, //ТипРасчетов
			НовыйКЗДебет.Дата,
			Неопределено, // Валюта,
			НовыйКЗДебет.Задолженность);
			Если НовыйКЗДебет.Задолженность.Количество() > 0 Тогда
				НовыйДоходыРасходыДебет = НовыйКЗДебет.ДоходыРасходыАктивыПассивы.Добавить();
				НовыйДоходыРасходыДебет.Статья = ПланыВидовХарактеристик.СтатьиРасходов.НайтиПоКоду("000000008");
				НовыйДоходыРасходыДебет.АналитикаРасходов = Справочники.ПрочиеРасходы.НайтиПоНаименованию("прочие расходы");
				НовыйДоходыРасходыДебет.Валюта = НовыйКЗДебет.Задолженность[0].ВалютаВзаиморасчетов;
				НовыйДоходыРасходыДебет.Сумма = НовыйКЗДебет.Задолженность.Итог("Сумма");
				НовыйДоходыРасходыДебет.Подразделение = Справочники.СтруктураПредприятия.НайтиПоНаименованию("Бухгалтерия");
				Попытка
					НовыйКЗДебет.Записать(РежимЗаписиДокумента.Проведение);
				Исключение
					НовыйКЗДебет.Записать(РежимЗаписиДокумента.Запись);
					Сообщить("Ошибка при записи корректировки дебиторской задолженности по контрагенту; " + СтрокаКонтрагент.ОбъектРасчетовКонтрагент  + " /\ " + ОписаниеОшибки());
				КонецПопытки;
			КонецЕсли;
