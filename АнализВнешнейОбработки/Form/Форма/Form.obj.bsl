				ВводОстатковДт62.Записать(РежимЗаписиДокумента.Проведение); 
				Сообщить("Проведен документ задолженности клиентов: " + ВводОстатковДт62);
			Исключение
				ВводОстатковДт62.Записать(РежимЗаписиДокумента.Запись);
				Сообщить("Ошибка при вводе начальных остатков ДТ по счету 62, документ: " + ВводОстатковДт62 + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
		Если НЕ ВводОстатковКт62.РасчетыСПартнерами.Количество() = 0 Тогда
			Попытка
				ВводОстатковКт62.Дата = КонецДня(Дата);
				ВводОстатковКт62.Записать(РежимЗаписиДокумента.Проведение);
				Сообщить("Проведен документ авансов клиентов: " + ВводОстатковКт62);
			Исключение
				ВводОстатковКт62.Записать(РежимЗаписиДокумента.Запись);
				Сообщить("Ошибка при вводе начальных остатков КТ по счету 62, документ: " + ВводОстатковКт62 + ". Ошибка: " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	Сообщить("Загрузка начальных остатков завершена. Проверьте документы ""Ввод остатков взаиморасчетов"" с комментарием 000030020.");
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНачальныеОстатки(Команда)
	Если НЕ ДатаПереходаЗаполнена() Тогда
		Возврат;
	КонецЕсли;
	ТекстВопроса = "Будут созданы документы ввода остатков по строкам таблицы. Незаполненные договоры, контрагенты и объекты расчетов должны быть исправлены заранее. Продолжить?";
	Ответ = Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьНачальныеОстаткиНаСервере();
КонецПроцедуры

