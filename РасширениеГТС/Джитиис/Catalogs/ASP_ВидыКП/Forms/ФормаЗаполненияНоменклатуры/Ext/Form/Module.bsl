
&НаСервере
Процедура ЗаполнитьВидКПНаСервере()
	Если ЗначениеЗаполнено(ЭтотОбъект.ПапкаНоменклатуры) Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.ASP_ВидКП КАК ASP_ВидКП
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.Ссылка В ИЕРАРХИИ(&Ссылка) И Номенклатура.Ссылка.ЭтоГруппа=Ложь";
	
	Запрос.УстановитьПараметр("Ссылка", ЭтотОбъект.ПапкаНоменклатуры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Счетчик = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	ОбъектНоменклатуры=ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	ОбъектНоменклатуры.ASP_ВидКП=ЭтотОбъект.ВидКП;
	ОбъектНоменклатуры.Записать();
	Счетчик = Счетчик + 1;
	
	КонецЦикла;
	Сообщить("Обработано позиций: " + Счетчик);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВидКП(Команда)
	ЗаполнитьВидКПНаСервере();
КонецПроцедуры
