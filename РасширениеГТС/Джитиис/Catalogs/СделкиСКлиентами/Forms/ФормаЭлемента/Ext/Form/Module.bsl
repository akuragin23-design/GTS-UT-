
&НаКлиенте
&ИзменениеИКонтроль("КлиентПриИзменении")
Процедура асп_КлиентПриИзменении(Элемент)

	Если ИспользоватьСоглашенияСКлиентами Тогда
		Если Объект.Партнер.Пустая() Тогда
			Объект.СоглашениеСКлиентом = ПредопределенноеЗначение("Справочник.СоглашенияСКлиентами.ПустаяСсылка");
		Иначе

			СтруктураСоглашениеСКлиентом = ПолучитьУсловияПродажПоУмолчанию(Объект.Партнер);

			Если СтруктураСоглашениеСКлиентом = Неопределено Тогда
				Объект.СоглашениеСКлиентом = ПредопределенноеЗначение("Справочник.СоглашенияСКлиентами.ПустаяСсылка");
			Иначе
				Объект.СоглашениеСКлиентом = СтруктураСоглашениеСКлиентом.Соглашение;
			КонецЕсли;

		КонецЕсли;
	КонецЕсли;
	ИзменилисьПараметрыОкруженияСделки = Истина;  
	
	#Вставка
	// Альтер ЛОГО+
	Объект.БизнесРегион = ПолучитьЗначениеРеквизитаНаСервере(Объект.Партнер, "БизнесРегион");
	ВыборКонтЛица = Неопределено;
	СтрокиСПустымиКонтактами = Объект.ПартнерыИКонтактныеЛица.НайтиСтроки(Новый Структура("Партнер, КонтактноеЛицо", Объект.Партнер, ПредопределенноеЗначение("Справочник.КонтактныеЛицаПартнеров.ПустаяСсылка")));
	Если Объект.ПартнерыИКонтактныеЛица.Количество() = 0 
		ИЛИ СтрокиСПустымиКонтактами.Количество() = Объект.ПартнерыИКонтактныеЛица.Количество() Тогда
		// ищем контактные лица и даем на выбор пользователю
		СписокКонтЛиц = ПолучитьСписокКонтактныхЛицПартнераНаСервере();
		Если СписокКонтЛиц.Количество() > 0 Тогда
			ВыборКонтЛица = ВыбратьИзМеню(СписокКонтЛиц);
			Если ВыборКонтЛица <> Неопределено Тогда
				Если СтрокиСПустымиКонтактами.Количество() > 0 Тогда
					СтрокаКонтакта = СтрокиСПустымиКонтактами[0];
				Иначе
					СтрокаКонтакта = Объект.ПартнерыИКонтактныеЛица.Добавить();
					СтрокаКонтакта.Партнер = Объект.Партнер;
				КонецЕсли;	
				СтрокаКонтакта.КонтактноеЛицо = ВыборКонтЛица.Значение;	

				Картинка = ВыборКонтЛица.Картинка;

				Если Картинка = БиблиотекаКартинок.КИ_ПочтовыйКонверт Тогда
					Объект.СпособОбращения = ПредопределенноеЗначение("Перечисление.СпособыОбращения.Почта");
				ИначеЕсли Картинка = БиблиотекаКартинок.КИ_имейл Тогда
					Объект.СпособОбращения = ПредопределенноеЗначение("Перечисление.СпособыОбращения.ЭлектроннаяПочта");
				ИначеЕсли Картинка = БиблиотекаКартинок.КИ_телефон Тогда
					Объект.СпособОбращения = ПредопределенноеЗначение("Перечисление.СпособыОбращения.ТелефонныйЗвонок");
				Иначе
					Объект.СпособОбращения = ПредопределенноеЗначение("Перечисление.СпособыОбращения.Встреча");
				КонецЕсли;

			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	

	Если ПустаяСтрока(Объект.Наименование) Тогда
		Объект.Наименование = СокрЛП(Объект.Партнер) + ?(ВыборКонтЛица = Неопределено, "", "," + СокрЛП(ВыборКонтЛица.Представление))
		+ ", " + Формат(Объект.ДатаНачала, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Если ПустаяСтрока(Объект.ФИО) Тогда
		Объект.ФИО = ?(ВыборКонтЛица = Неопределено, "", СтрокаКонтакта.КонтактноеЛицо);
		Если Объект.СпособОбращения = ПредопределенноеЗначение("Перечисление.СпособыОбращения.ТелефонныйЗвонок") Тогда
			Объект.НомерТелефона = ?(ВыборКонтЛица = Неопределено, "", Прав(ВыборКонтЛица.Представление, СтрДлина(ВыборКонтЛица.Представление) - Найти(ВыборКонтЛица.Представление, "// ") - 2 ) );
		КонецЕсли;
		Если Объект.СпособОбращения = ПредопределенноеЗначение("Перечисление.СпособыОбращения.ЭлектроннаяПочта") и СписокКонтЛиц.Количество() > 0 Тогда
			Для каждого Контакт из СписокКонтЛиц Цикл
				Если Контакт.Картинка = БиблиотекаКартинок.КИ_телефон И Контакт.Значение = ВыборКонтЛица.Значение Тогда
					Объект.НомерТелефона = ?(ВыборКонтЛица = Неопределено, "", Прав(Контакт.Представление, СтрДлина(Контакт.Представление)  - Найти(Контакт.Представление, "// ") - 2 ) );
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.Партнер)  Тогда
		//++Непп 
		найденопродаж = ПолучитьПродажи();
		Если найденопродаж = истина тогда
			СтарКл=1;
			ТЗ= ПолучитьТЗСегм();

			Для Каждого Выборка из ТЗ Цикл
				Если Выборка=ПредопределенноеЗначение("Справочник.СегментыПартнеров.ВипКлиенты") Тогда
					СтарКл=0;	
					КаналПервичногоИнтереса = ПолучитьПВХ("СтарыйКлиент");
					//Элементы.КаналПервичногоИнтереса.Доступность = Ложь;
					ИсточникПервичногоИнтереса = Неопределено;
					Элементы.ИсточникПервичногоИнтереса.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.МаркетинговыеМероприятия");
					ЗаполнитьМаркетинговоеМероприятиеВип();
					Элементы.ИсточникПервичногоИнтереса.ТолькоПросмотр = Ложь;

				ИначеЕсли Выборка=ПредопределенноеЗначение("Справочник.СегментыПартнеров.Дилеры" )Тогда
					СтарКл=0;	
					КаналПервичногоИнтереса = ПолучитьПВХ("СтарыйКлиент");
					//Элементы.КаналПервичногоИнтереса.Доступность = Ложь;
					ИсточникПервичногоИнтереса = Неопределено;
					Элементы.ИсточникПервичногоИнтереса.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.МаркетинговыеМероприятия");
					ЗаполнитьМаркетинговоеМероприятиеДилер();
					Элементы.ИсточникПервичногоИнтереса.ТолькоПросмотр = Ложь;

				ИначеЕсли Выборка=ПредопределенноеЗначение("Справочник.СегментыПартнеров.КрупныеДилеры" )Тогда
					СтарКл=0;	
					КаналПервичногоИнтереса = ПолучитьПВХ("СтарыйКлиент");
					//Элементы.КаналПервичногоИнтереса.Доступность = Ложь;
					ИсточникПервичногоИнтереса = Неопределено;
					Элементы.ИсточникПервичногоИнтереса.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.МаркетинговыеМероприятия");
					ЗаполнитьМаркетинговоеМероприятиеКрупныеДилеры();
					Элементы.ИсточникПервичногоИнтереса.ТолькоПросмотр = Ложь;


				КонецЕсли;
			КонецЦикла;



			Если СтарКл=1 Тогда
				КаналПервичногоИнтереса = ПредопределенноеЗначение("ПланВидовХарактеристик.КаналыРекламныхВоздействий.СтарыйКлиент");
				//Элементы.КаналПервичногоИнтереса.Доступность = Ложь;
				ИсточникПервичногоИнтереса = Неопределено;
				Элементы.ИсточникПервичногоИнтереса.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.МаркетинговыеМероприятия");
				ЗаполнитьМаркетинговоеМероприятиеПоУмолчаниюСервер();
				Элементы.ИсточникПервичногоИнтереса.ТолькоПросмотр = Ложь;
			КонецЕсли;

		КонецЕсли;




	Иначе
		Элементы.КаналПервичногоИнтереса.Доступность = Истина;
		Элементы.ИсточникПервичногоИнтереса.ТолькоПросмотр = Истина;
		КаналПервичногоИнтереса = Неопределено;
		ИсточникПервичногоИнтереса = Неопределено;
	КонецЕсли;	
	// +Альтер ЛОГО
	Если Не ЗначениеЗаполнено(Объект.СоглашениеСКлиентом) Тогда
		Объект.СоглашениеСКлиентом=ПолучитьСоглашениеПоУмолчанию();
	КонецЕсли;
	//Асист KS	
	// Объект.КодКлиента = ПолучитьКодКлиента();
	//Асист KS
	#КонецВставки
КонецПроцедуры  


Функция ПолучитьПВХ(ИмяСвойства)

	Возврат ПланыВидовХарактеристик.КаналыРекламныхВоздействий.НайтиПоНаименованию(ИмяСвойства, Истина);	
	

КонецФункции
