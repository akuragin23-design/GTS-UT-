
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.Используется = Истина;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	isnull(МАКСИМУМ(ASP_СтруктураКП.Порядок), 0) КАК Порядок
		|ИЗ
		|	Справочник.ASP_СтруктураКП КАК ASP_СтруктураКП
		|ГДЕ
		|	ASP_СтруктураКП.Владелец = &Владелец
		|И
		|	ASP_СтруктураКП.Этогруппа";
		
		Запрос.УстановитьПараметр("Владелец", Объект.Владелец);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Объект.Порядок = ВыборкаДетальныеЗаписи.Порядок+1;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
