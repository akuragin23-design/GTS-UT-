&НаСервере
&После("ЗаполнитьПоляНаОснованииПараметров")
Процедура асп_ЗаполнитьПоляНаОснованииПараметров(ПараметрыФормы)
	Если ПараметрыФормы.Свойство("Номенклатура") Тогда
		Если Объект.НаименованиеНоменклатуры = "" Тогда
				Объект.НаименованиеНоменклатуры = Параметры.ТекстЗаполнения;  //yu
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры
