&НаСервере
Процедура ВалютнаяОтгрузкаОформление()
	
	НоваяГруппа = Элементы.Вставить("ГруппаВалютнаяОтгрузка", Тип("ГруппаФормы"), Элементы.ГруппаПараметрыПраво, Элементы.НалогообложениеНДС);
	НоваяГруппа.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	НоваяГруппа.Отображение = ОтображениеОбычнойГруппы.Нет;
	НоваяГруппа.ОтображатьЗаголовок = ЛОЖЬ; 
	НоваяГруппа.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	НоваяГруппа.Видимость = ЗначениеЗаполнено(Объект.Валюта) И Объект.Валюта.Код <> "643";
	
	НовыйЭлемент = Элементы.Добавить("РекВалютныйСчетВРубли", Тип("ПолеФормы"), Элементы.ГруппаВалютнаяОтгрузка);  
	НовыйЭлемент.ПутьКДанным = "Объект.ВалютныйСчетВРубли";
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеПереключателя;
	НовыйЭлемент.Списоквыбора.Добавить("Да", "Да");  
	НовыйЭлемент.Списоквыбора.Добавить("Нет", "Нет");
	НовыйЭлемент.ПоложениеЗаголовка    	   = ПоложениеЗаголовкаЭлементаФормы.Лево;
	НовыйЭлемент.Заголовок = "Валютный счет будет изменен в рубли"; 
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "РекВалютныйСчетВРублиПриИзменении");
	//НовыйЭлемент.Видимость = ЗначениеЗаполнено(Объект.Валюта) И Объект.Валюта.Код <> "643";
	
	НовыйЭлемент = Элементы.Добавить("Разделитель", Тип("ДекорацияФормы"),Элементы.ГруппаВалютнаяОтгрузка);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Ширина = 5; 
	
	НовыйЭлемент = Элементы.Добавить("ВалютнаяОтгрузка", Тип("ПолеФормы"), Элементы.ГруппаВалютнаяОтгрузка);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеПереключателя;
	НовыйЭлемент.ПоложениеЗаголовка    	   = ПоложениеЗаголовкаЭлементаФормы.Право;
	НовыйЭлемент.Заголовок = "Валютная отгрузка";
	НовыйЭлемент.ПутьКДанным = "Объект.ВалютнаяОтгрузка";
	//НовыйЭлемент.Видимость = ЗначениеЗаполнено(Объект.Валюта) И Объект.Валюта.Код <> "643"; 
	НовыйЭлемент.Доступность = РольДоступна("ASP_ВалютнаяОтгрузка");
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "ВалютнаяОтгрузкаПриИзменении");	
	
КонецПроцедуры // ВалютнаяОтгрузкаОформление()


