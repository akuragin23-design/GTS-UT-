&НаСервере
Процедура КС_ДобавитьКомандыКОтгрузкеСкладом()

	КС_ДобавитьКомандуВМенюЗаполнить(
		"КС_ОтметитьВсеКОтгрузкеСкладом",
		"Отметить все к отгрузке складом",
		"ОтметитьВсеКОтгрузкеСкладом");

	КС_ДобавитьКомандуВМенюЗаполнить(
		"КС_СнятьВсеОтметкиКОтгрузкеСкладом",
		"Снять отметки к отгрузке складом",
		"СнятьВсеОтметкиКОтгрузкеСкладом");

	КС_ДобавитьКомандуВМенюЗаполнить(
		"КС_УстановитьВариантКОтгрузке",
		"Отгрузить отмеченное для склада",
		"УстановитьВариантОбеспеченияКОтгрузке");

КонецПроцедуры

&НаСервере
Процедура КС_ДобавитьКомандуВМенюЗаполнить(
	ИмяКоманды,
	ЗаголовокКоманды,
	ИмяОбработчика)

	// Создаем команду формы.
	НоваяКоманда = Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Заголовок = ЗаголовокКоманды;
	НоваяКоманда.Действие  = ИмяОбработчика;

	// Создаем кнопку внутри меню:
	// Товары -> командная панель -> Заполнить.
	ИмяКнопки = "Товары_" + ИмяКоманды;

	НоваяКнопка = Элементы.Добавить(
		ИмяКнопки,
		Тип("КнопкаФормы"),
		Элементы.ТоварыГруппаЗаполнить);

	НоваяКнопка.ИмяКоманды = ИмяКоманды;
	НоваяКнопка.Заголовок  = ЗаголовокКоманды;
	НоваяКнопка.Отображение = ОтображениеКнопки.Текст;

КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсеКОтгрузкеСкладом(Команда)

	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		СтрокаТоваров.КОтгрузкеСкладом = Истина;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеОтметкиКОтгрузкеСкладом(Команда)

	Для Каждого СтрокаТоваров Из Объект.Товары Цикл
		СтрокаТоваров.КОтгрузкеСкладом = Ложь;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьВариантОбеспеченияКОтгрузке(Команда)

	ИдентификаторыСтрок = Новый Массив;

	Для Каждого СтрокаТоваров Из Объект.Товары Цикл

		Если СтрокаТоваров.КОтгрузкеСкладом Тогда
			ИдентификаторыСтрок.Добавить(
				СтрокаТоваров.ПолучитьИдентификатор());
		КонецЕсли;

	КонецЦикла;

	Если ИдентификаторыСтрок.Количество() = 0 Тогда
		ПоказатьПредупреждение(
			,
			"Не отмечены товары для установки варианта обеспечения.");
		Возврат;
	КонецЕсли;

	Результат = КС_УстановитьОтгрузкуДляОтмеченныхСтрок(
		ИдентификаторыСтрок);

	// Повторяем стандартную обработку вопросов обеспечения.
	ВопросЗадан =
		ОбеспечениеВДокументахКлиент.
			ПоказатьВопросЗаполнятьОбеспечениеЦелымиУпаковками(
				ЭтотОбъект,
				Объект.Товары,
				Результат,
				"ПослеВопросаЗаполнятьОбеспечениеЦелымиУпаковками");

	Если Не ВопросЗадан Тогда

		ОбеспечениеВДокументахКлиент.
			ПоказатьВопросСнятьФлагОтгружатьОднойДатой(
				ЭтотОбъект,
				Объект.Товары,
				Результат,
				"ПослеВопросаСнятьФлагОтгружатьОднойДатой");

	КонецЕсли;

КонецПроцедуры     

&НаСервере
Функция КС_УстановитьОтгрузкуДляОтмеченныхСтрок(
	ИдентификаторыСтрок)

	Результат =
		ОбеспечениеВДокументахСервер.
			ОбеспечениеУстановитьДействиеСтруктураРезультата();

	Изменения =
		ОбеспечениеВДокументахСервер.УстановитьДействие(
			"ДЕЙСТВИЕ_ОТГРУЗИТЬ",
			ЭтотОбъект,
			ИдентификаторыСтрок);

	ЗаполнитьЗначенияСвойств(Результат, Изменения);

	Если Изменения.ТаблицаИзменений <> Неопределено Тогда

		ПослеЗаполненияОбеспечения(
			Изменения.ТаблицаИзменений,
			ОбеспечениеВДокументахКлиентСервер.
				РежимВыборДействия(),
			Результат);

	КонецЕсли;

	Возврат Результат;

КонецФункции


