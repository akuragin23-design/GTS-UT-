//ASP__A.Zhel 03.04.2019
&НаСервере
Процедура УстановитьДоступностьНеограниченногоСрокаРезерва()
	УстановитьПривилегированныйРежим(Истина);
	Элементы.НеограниченныйСрокХранения.ТолькоПросмотр = НЕ (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава"));
	Элементы.КонтрольРезерва.ТолькоПросмотр = НЕ (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава"));
	Элементы.ЗапретРезервирования.ТолькоПросмотр = НЕ (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава"));
	Элементы.РазрешениеРезервирования.ТолькоПросмотр = НЕ (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава"));
	Элементы.ПродлитьРезервДо.Видимость = (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава"));
	//Элементы.ПродлитьРезерв.Видимость = (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава"));
	Элементы.НомерЦикла.ТолькоПросмотр = НЕ (РольДоступна("ASP_УправлениеЦиклом") ИЛИ РольДоступна("ПолныеПрава"));
	Элементы.КомментарийКЦиклу.ТолькоПросмотр = НЕ (РольДоступна("ASP_УправлениеЦиклом") ИЛИ РольДоступна("ПолныеПрава")); 
	//ГТС запрет менять номенклатуру и количество по отправленным в производство(в цикл) 18.11.2019    //Отключено 01.10.2025 Включено 19.08.2026
	если Объект.НомерЦикла>0 и НЕ (РольДоступна("ASP_УправлениеЦиклом") ИЛИ РольДоступна("ПолныеПрава")) тогда
	Элементы.ТоварыОткрытьПодбор.Видимость = ложь;
	Элементы.ТоварыASP_ОткрытьПодборИзРасчетаНовый.Видимость=ложь;
	Элементы.ТоварыНоменклатура.ТолькоПросмотр = истина;
	Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = истина;
	Элементы.ТоварыКомментарий.ТолькоПросмотр=истина;  
	Элементы.КомментарийКЦиклу.ТолькоПросмотр=истина;
	конецесли;
	//ГТС запрет менять номенклатуру и количество по установленному контролю резерва 21.01.2021
	если Объект.НомерЦикла=0 И (Объект.КонтрольРезерва = истина или Объект.ЗапретРезервирования=Истина)и НЕ (РольДоступна("ASP_НеограниченныйСрокРезервирования") ИЛИ РольДоступна("ПолныеПрава")) тогда
	Элементы.ТоварыОткрытьПодбор.Видимость = ложь;
	Элементы.ТоварыASP_ОткрытьПодборИзРасчетаНовый.Видимость=ложь;
	Элементы.ТоварыНоменклатура.ТолькоПросмотр = истина;
	Элементы.ТоварыКоличествоУпаковок.ТолькоПросмотр = истина;
	конецесли;

	//ГТС управление отгрузкой в долг
	Элементы.РазрешитьОтгрузку.ТолькоПросмотр=НЕ (РольДоступна("ASP_УправлениеЛимитомОтгрузкиИОтгрузкойВДолг") ИЛИ РольДоступна("ПолныеПрава"));
	
	//ГТС управление ценами ниже минимальных
	Элементы.РазрешенаЦенаНижеКолонки.ТолькоПросмотр=НЕ (РольДоступна("ASP_РазрешитьЦенуНижеКолонки") ИЛИ РольДоступна("ПолныеПрава"));
	//ГТС Управление отгрузкой без ЭДО
	Элементы.РазрешитьБезЭДО.ТолькоПросмотр=НЕ (РольДоступна("ASP_РазрешитьБезЭДО") ИЛИ РольДоступна("ПолныеПрава"));
	
	УстановитьПривилегированныйРежим(Ложь);
		
	
	
КонецПроцедуры
