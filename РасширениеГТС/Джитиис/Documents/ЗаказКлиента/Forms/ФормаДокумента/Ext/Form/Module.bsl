&НаКлиенте
Процедура ВидимостьФлагаВалютнойОтгрузки()
	ВидимостьРеквизитов = ЗначениеЗаполнено(Объект.Валюта) И ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Валюта, "Код") <> "643";
	//Элементы.ВалютнаяОтгрузка.Видимость = ВидимостьРеквизитов;
	//Элементы.РекВалютныйСчетВРубли.Видимость = ВидимостьРеквизитов; 
	Элементы.ГруппаВалютнаяОтгрузка.Видимость = ВидимостьРеквизитов;
	Если НЕ ВидимостьРеквизитов Тогда
		Объект.ВалютнаяОтгрузка = Ложь;	
		Объект.ВалютныйСчетВРубли = "";
	КонецЕсли;
КонецПроцедуры // ВидимостьФлагаВалютнойОтгрузки()

&НаКлиенте
Процедура асп_ПередЗаписьюПеред(Отказ, ПараметрыЗаписи)
	ВидимостьРеквизитов = ЗначениеЗаполнено(Объект.Валюта) И ОбщегоНазначенияУТВызовСервера.ЗначениеРеквизитаОбъекта(Объект.Валюта, "Код") <> "643";
	Если ВидимостьРеквизитов И НЕ ЗначениеЗаполнено(Объект.ВалютныйСчетВРубли) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Для валютного заказа, данное поле должно быть заполнено!";
		Сообщение.Поле = "Объект.ВалютныйСчетВРубли";
		Сообщение.Сообщить();	
	КонецЕсли;	
КонецПроцедуры

