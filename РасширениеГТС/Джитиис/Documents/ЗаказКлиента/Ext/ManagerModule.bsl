Функция ЗапретРезервирования(Номенклатура, Склад)
	
	//ASP_Dante 15/10/19
	Если (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("ASP_ЗапретРезервирования")) Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если Склад.ASP_ЗапретРезервирования И Склад.ASP_Номенклатура.Количество() = 0 Тогда
		Возврат Истина;
	ИначеЕсли Склад.ASP_ЗапретРезервирования Тогда
		Строка = Склад.ASP_Номенклатура.Найти(Номенклатура, "Номенклатура");
		Возврат Не Строка = Неопределено;
	КонецЕсли;		
	
	Возврат Ложь;
	//ASP_Dante 15/10/19
	
