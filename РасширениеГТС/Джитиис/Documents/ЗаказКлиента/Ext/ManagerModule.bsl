	|	ТаблицаСПризнакомПечати.Упаковка,
	|	ТаблицаСПризнакомПечати.Содержание,
	|	ТаблицаСПризнакомПечати.ХарактеристикаНабора,
	|	ТаблицаСПризнакомПечати.Цена
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаСПризнакомПечати.Номенклатура,
	|	ТаблицаСПризнакомПечати.Количество,
	|	ТаблицаСПризнакомПечати.Код,
	|	ТаблицаСПризнакомПечати.Артикул,
	|	ТаблицаСПризнакомПечати.Ссылка,
	|	ТаблицаСПризнакомПечати.НаименованиеПолное,
	|	ТаблицаСПризнакомПечати.ЕдиницаИзмерения,
	|	ТаблицаСПризнакомПечати.Цена,
	|	ТаблицаСПризнакомПечати.Сумма,
	|	ТаблицаСПризнакомПечати.СтавкаНДС,
	|	ТаблицаСПризнакомПечати.СуммаНДС,
	|	ТаблицаСПризнакомПечати.ДатаОтгрузки,
	|	ТаблицаСПризнакомПечати.Характеристика,
	|	ТаблицаСПризнакомПечати.Упаковка,
	|	ТаблицаСПризнакомПечати.СуммаСкидки,
	|	ТаблицаСПризнакомПечати.СуммаБезСкидки,
	|	ТаблицаСПризнакомПечати.Содержание,
	|	ТаблицаСПризнакомПечати.ХарактеристикаНабора,
	|	ТаблицаСПризнакомПечати.НоменклатураНабора,
	|	ТаблицаСПризнакомПечати.НомерСтроки
	|ИЗ
	|	ТаблицаСПризнакомПечати КАК ТаблицаСПризнакомПечати
	|ГДЕ
	|	ТаблицаСПризнакомПечати.ВариантПечатиНаборов <> ЗНАЧЕНИЕ(Перечисление.ВариантыПредставленияНаборовВПечатныхФормах.ТолькоКомплектующие)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НоменклатураНабора,
	|	НомерСтроки";
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	// tise добавил 2010-12-24
	Запрос.УстановитьПараметр("ВыводитьСкидки", ВыводитьСкидки);
	// /tise добавил 2010-12-24
	
	ПакетРезультатовЗапроса = Запрос.ВыполнитьПакет();
	
	СтруктураДанныхДляПечати = Новый Структура;
	СтруктураДанныхДляПечати.Вставить("РезультатПоШапке", ПакетРезультатовЗапроса[0]);
	СтруктураДанныхДляПечати.Вставить("РезультатПоЭтапамОплаты", ПакетРезультатовЗапроса[1]);
	СтруктураДанныхДляПечати.Вставить("РезультатПоТабличнойЧасти", ПакетРезультатовЗапроса[4]);
	СтруктураДанныхДляПечати.Вставить("ВыводитьСкидки", ВыводитьСкидки);
	
	Возврат СтруктураДанныхДляПечати;
	
