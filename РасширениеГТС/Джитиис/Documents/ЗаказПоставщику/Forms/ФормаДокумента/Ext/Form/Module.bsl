&НаСервере
Функция ПолучитьМаксимальныйКОдСтроки(Ссылка)
	ТЗКод = Объект.Товары.Выгрузить(,"КодСтроки");
	ТзКод.Сортировать("КодСтроки Убыв");
	КодСтроки = ТзКод[0].КодСтроки; 
	Объект.МаксимальныйКодСтроки = КодСтроки + 1;
	Возврат КодСтроки + 1;

КонецФункции

&НаСервере
функция ПолучитьМаксимальныйНомерСтроки()
	
	Возврат Объект.Ссылка.Товары.Количество();
	
КонецФункции	

&НаКлиенте
Процедура асп_ТоварыНазначениеОбработкаВыбораПосле(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтрокаНов = ПолучитьМаксимальныйНомерСтроки();
	Если не Объект.Товары.Количество() = СтрокаНов тогда
		СтрокаТЧ = Объект.Товары[Объект.Товары.Количество() - 1];
		СтрокаТч.Назначение = ВыбранноеЗначение;
		ВыбранноеЗначение = "";
	КонецЕсли;
КонецПроцедуры

