&НаКлиенте
Процедура асп_ОбработкаОповещенияПосле(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбработкаВыбораНазначения" Тогда
		
		ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
		Отбор = Новый Структура();
		Отбор.Вставить("КодСтроки",ТекущиеДанные.КодСтроки);
		НайденноеЗнч = Объект.Товары.НайтиСтроки(Отбор);
		Если ТекущиеДанные.КоличествоУпаковок > Параметр Тогда     //разбиваем строку
			//ASP_Petrov 01.11.2021 + 000013050
			КодСтроки = ПолучитьМаксимальныйКОдСтроки(Объект.Ссылка);
			//ASP_Petrov 01.11.2021 -  
			НовСтрока = Объект.Товары.Добавить() ;
			ЗаполнитьЗначенияСвойств(НовСтрока,ТекущиеДанные);
			ТекущиеДанные.КоличествоУпаковок = ТекущиеДанные.Количество - Параметр;
			ТекущиеДанные.Количество = ТекущиеДанные.Количество - Параметр;
			ТекущиеДанные.Ожидается = Параметр;
			НовСтрока.Назначение = ТекущиеДанные.Назначение;
			ТекущиеДанные.Назначение = "";
			НовСтрока.Количество = Параметр;
			НовСтрока.КоличествоУпаковок = НовСтрока.Количество;
			НовСтрока.Ожидается =  НовСтрока.Количество;
			НовСтрока.КодСтроки = КодСтроки; 
			//пересчитать сумму (типовое)
			СтруктураДействий = Новый Структура;
			ДобавитьВСтруктуруДействияПриИзмененииКоличестваУпаковок(СтруктураДействий, ЭтаФорма);
			
			ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(ТекущиеДанные, СтруктураДействий, КэшированныеЗначения);
			ПакетнаяОбработкаТабличнойЧастиКлиент.ОбработатьСтрокуТЧ(НовСтрока, СтруктураДействий, КэшированныеЗначения);
			
			РассчитатьИтоговыеПоказателиЗаказа(ЭтаФорма);
		КонецЕсли;
		Если НайденноеЗнч.Количество() >= 2 тогда
			Для каждого Строка из НайденноеЗнч цикл
				КодСтроки = ПолучитьМаксимальныйКОдСтроки(Объект.Ссылка);
				Строка.КодСтроки = КодСтроки;
			КонецЦикла;
		КонецЕсли;	
		КонецЕсли;	
КонецПроцедуры
