&НаСервере
Процедура ASP_ДобавитьЭлементыЗаказаКлиента()
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы(
			"ЗаказКлиента",
			Новый ОписаниеТипов("ДокументСсылка.ЗаказКлиента"),
			"",
			НСтр("ru = 'Заказ клиента'")));
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ПолеЗаказа = Элементы.Добавить(
		"ЗаказКлиента",
		Тип("ПолеФормы"),
		Элементы.ГруппаШапка);
	
	ПолеЗаказа.Вид = ВидПоляФормы.ПолеВвода;
	ПолеЗаказа.ПутьКДанным = "ЗаказКлиента";
	ПолеЗаказа.Заголовок = НСтр("ru = 'Заказ клиента'");
	
	КомандаЗаполнения = Команды.Добавить("ЗаполнитьПоЗаказуКлиента");
	КомандаЗаполнения.Заголовок = НСтр("ru = 'Заполнить по заказу'");
	КомандаЗаполнения.Действие = "ЗаполнитьПоЗаказуКлиента";
	КомандаЗаполнения.ИзменяетСохраняемыеДанные = Истина;
	КомандаЗаполнения.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
	КнопкаЗаполнения = Элементы.Добавить(
		"ЗаполнитьПоЗаказуКлиента",
		Тип("КнопкаФормы"),
		Элементы.ТоварыКоманднаяПанель);
	
	КнопкаЗаполнения.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	КнопкаЗаполнения.ИмяКоманды = "ЗаполнитьПоЗаказуКлиента";
	
КонецПроцедуры             

&НаКлиенте
Процедура ЗаполнитьПоЗаказуКлиента(Команда)
	
	Если Не ЗначениеЗаполнено(ЭтаФорма["ЗаказКлиента"]) Тогда
		ПоказатьПредупреждение(
			Неопределено,
			НСтр("ru = 'Выберите заказ клиента.'"));
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	
	КоличествоСтрок = ЗаполнитьПоЗаказуКлиентаНаСервере();
	
	Если КоличествоСтрок = 0 Тогда
		ПоказатьПредупреждение(
			Неопределено,
			НСтр("ru = 'В выбранном заказе клиента отсутствуют товары с ненулевым количеством.'"));
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция ЗаполнитьПоЗаказуКлиентаНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыЗаказа.Номенклатура КАК Номенклатура,
	|	ТоварыЗаказа.Характеристика КАК Характеристика,
	|	ТоварыЗаказа.Упаковка КАК Упаковка,
	|	СУММА(ТоварыЗаказа.КоличествоУпаковок) КАК Количество
	|ИЗ
	|	Документ.ЗаказКлиента.Товары КАК ТоварыЗаказа
	|ГДЕ
	|	ТоварыЗаказа.Ссылка = &ЗаказКлиента
	|
	|СГРУППИРОВАТЬ ПО
	|	ТоварыЗаказа.Номенклатура,
	|	ТоварыЗаказа.Характеристика,
	|	ТоварыЗаказа.Упаковка
	|
	|ИМЕЮЩИЕ
	|	СУММА(ТоварыЗаказа.КоличествоУпаковок) > 0";
	
	Запрос.УстановитьПараметр("ЗаказКлиента", ЭтаФорма["ЗаказКлиента"]);
	
	ТаблицаТоваровЗаказа = Запрос.Выполнить().Выгрузить();
	
	// Полностью удаляем прежние исходные и сформированные строки.
	Объект.ИсходныеДанныеТовары.Очистить();
	Объект.Товары.Очистить();
	
	Если ТаблицаТоваровЗаказа.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Объект.ИсходныеДанныеТовары.Загрузить(ТаблицаТоваровЗаказа);
	
	// Устанавливаем количество ценников и этикеток по количеству из заказа.
	ЗаполнитьКоличествоЭтикетокПоДокументу = Истина;
	ЗаполнитьКоличествоЭтикетокПоОстаткамНаСкладе = Ложь;
	ЗаполнитьКоличествоЦенниковПоДокументу = Истина;
	ЗаполнитьКоличествоЦенниковПоОстаткамНаСкладе = Ложь;
	
	// Штатный механизм заполнит Товары, цены, шаблоны и штрихкоды.
	ЗаполнитьТаблицуТоваровНаСервере(Ложь);
	
	Возврат Объект.Товары.Количество();
	
КонецФункции