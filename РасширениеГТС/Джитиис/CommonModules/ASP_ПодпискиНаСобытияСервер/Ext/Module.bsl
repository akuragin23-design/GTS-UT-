Процедура асп_ЗаполнитьТДРНПТПоступленияОбработкаПроведенияТДОбработкаПроведения(Источник, Отказ, РежимПроведения) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если Источник.Товары.Количество() > 0 И ЗначениеЗаполнено(Источник.Товары[0].ДокументПоступления)
		и НЕ Источник.ДополнительныеСвойства.Свойство("ПропуститьПерепроведениеПриобретений") Тогда
		//ASP_Crow 29.06.2026 000030362 Была ошибка из-за перепроведения поступления товарво на склад с обособкой
		ДокументПоступления = Источник.Товары[0].ДокументПоступления.ПолучитьОбъект(); 
		ДокументПоступленияПроведен = ДокументПоступления.Проведен; 
		ДокументПоступления.Комментарий = ?(ЗначениеЗаполнено(ДокументПоступления.Комментарий), 
		ДокументПоступления.Комментарий + Символы.ПС, "")
		+ ?(ДокументПоступленияПроведен, "Перепроведен ", "Перезаписан ") 
		+ Формат(ТекущаяДата(),"ДФ='дд.ММ.гггг чч:мм'")
		+ " автоматически после проведения таможенной декларации на импорт № " 
		+ Источник.Номер + " от " + Источник.Дата; 
		РежимЗаписи = ?(ДокументПоступленияПроведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);																	
		ДокументПоступления.Записать(РежимЗаписи);
	КонецЕсли;
КонецПроцедуры
