				|			И (ТЗРезультатаПроверки.СкладОприходования = СтрокиЗаказовНаПеремещенияПоАналитике.СкладОтправитель)
				|			И (ТЗРезультатаПроверки.СкладПродажи = СтрокиЗаказовНаПеремещенияПоАналитике.СкладПолучатель)
				|			И (ТЗРезультатаПроверки.Номенклатура = СтрокиЗаказовНаПеремещенияПоАналитике.Номенклатура)
				|			И (ТЗРезультатаПроверки.Характеристика = СтрокиЗаказовНаПеремещенияПоАналитике.Характеристика)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ВложенныйЗапрос.ЗаказКлиента КАК ЗаказКлиента,
				|	ВложенныйЗапрос.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
				|	КОЛИЧЕСТВО(*) КАК Колво
				|ПОМЕСТИТЬ КолвоРазличнойАналитики
				|ИЗ
				|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
				|		ЗаказыНаПеремещения.ЗаказКлиента КАК ЗаказКлиента,
				|		ЗаказыНаПеремещения.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
				|		ЗаказыНаПеремещения.Номенклатура КАК Номенклатура,
				|		ЗаказыНаПеремещения.Характеристика КАК Характеристика
				|	ИЗ
				|		СтрокиЗаказовНаПеремещенияКРезервированию КАК ЗаказыНаПеремещения) КАК ВложенныйЗапрос
				|
				|СГРУППИРОВАТЬ ПО
				|	ВложенныйЗапрос.ЗаказКлиента,
				|	ВложенныйЗапрос.ЗаказНаПеремещение
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ЗаказыНаПеремещения.ЗаказКлиента КАК ЗаказКлиента,
				|	ЗаказыНаПеремещения.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
				|	СУММА(ЗаказыНаПеремещения.Количество) КАК Колво
				|ПОМЕСТИТЬ ОбщееКоличество
				|ИЗ
				|	СтрокиЗаказовНаПеремещенияКРезервированию КАК ЗаказыНаПеремещения
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказыНаПеремещения.ЗаказКлиента,
				|	ЗаказыНаПеремещения.ЗаказНаПеремещение";
	
	ТекстЗапросаУничтоженияВременныхТаблицСЗаказамиНаПеремещения =
		"УНИЧТОЖИТЬ СтрокиЗаказовНаПеремещенияПоАналитикеБезСвязиСЗаказамиПоставщикам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СодержимоеВсехСвязанныхПТУ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СвязиПриобретенийСЗаказамиПоставщикам
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СтрокиЗаказовПоставщикамДляОстальнойАналитики
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СтрокиЗаказовНаПеремещенияПоАналитике
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СтрокиЗаказовНаПеремещенияКРезервированию
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ КолвоРазличнойАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ОбщееКоличество";
	ТекстЗапросаИтоговыхТаблиц =
		"ВЫБРАТЬ
		|	ПриобретенныеТовары.ЗаказКлиента КАК ЗаказКлиента,
		|	ПриобретенныеТовары.Номенклатура КАК Номенклатура,
		|	ПриобретенныеТовары.Характеристика КАК Характеристика,
		|	ПриобретенныеТовары.КРезервированию КАК КРезервированию
		|ИЗ
		//ASP_Hlopkov 20.11.2020+
		//|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику КАК ПриобретенныеТовары
		|	ТЗРезультатаПроверки КАК ПриобретенныеТовары
		//ASP_Hlopkov 20.11.2020-
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтрокиЗаказовНаПеремещения.ЗаказКлиента КАК ЗаказКлиента,
		|	СтрокиЗаказовНаПеремещения.ЗаказНаПеремещение КАК ЗаказНаПеремещение,
		|	СтрокиЗаказовНаПеремещения.Номенклатура КАК Номенклатура,
		|	СтрокиЗаказовНаПеремещения.Характеристика КАК Характеристика,
		|	СтрокиЗаказовНаПеремещения.КодСтроки КАК КодСтроки
		|ИЗ
		|	СтрокиЗаказовНаПеремещенияКРезервированию КАК СтрокиЗаказовНаПеремещения
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиента,
		|	ЗаказНаПеремещение,
		|	Номенклатура,
		|	Характеристика,
		|	КодСтроки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗаказыНаПеремещения.ЗаказКлиента КАК ЗаказКлиента,
		|	ЗаказыНаПеремещения.ЗаказНаПеремещение КАК ЗаказНаПеремещение
		|ИЗ
		|	СтрокиЗаказовНаПеремещенияКРезервированию КАК ЗаказыНаПеремещения
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КолвоРазличнойАналитики КАК КолвоРазличнойАналитики
		|		ПО (ЗаказыНаПеремещения.ЗаказКлиента = КолвоРазличнойАналитики.ЗаказКлиента)
		|			И (ЗаказыНаПеремещения.ЗаказНаПеремещение = КолвоРазличнойАналитики.ЗаказНаПеремещение)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбщееКоличество КАК ОбщееКоличество
		|		ПО (ЗаказыНаПеремещения.ЗаказКлиента = ОбщееКоличество.ЗаказКлиента)
		|			И (ЗаказыНаПеремещения.ЗаказНаПеремещение = ОбщееКоличество.ЗаказНаПеремещение)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиента,
		|	ЗаказыНаПеремещения.Приоритет,
		|	КолвоРазличнойАналитики.Колво УБЫВ,
		|	ОбщееКоличество.Колво УБЫВ
		|ИТОГИ ПО
		|	ЗаказКлиента,
		|	ЗаказНаПеремещение";
	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("СсылкаНаПТНС", ПоступлениеТоваровНаСклад);
	
	
	ИндексОбрабатываемогоЗаказаПоставщику = 0;
	ЭтоПерваяИтерацияПоЗаказуПоставщику = Истина;
	Пока ИндексОбрабатываемогоЗаказаПоставщику < МассивОбрабатываемыхЗаказовПоставщикам.Количество() Цикл
		
		ОбрабатываемыйЗаказПоставщику = МассивОбрабатываемыхЗаказовПоставщикам[ИндексОбрабатываемогоЗаказаПоставщику];
		
		Запрос.УстановитьПараметр("ЗаказПоставщику", ОбрабатываемыйЗаказПоставщику);
		Если ЭтоПерваяИтерацияПоЗаказуПоставщику Тогда
			Если ИндексОбрабатываемогоЗаказаПоставщику = 0 Тогда
				Запрос.Текст = ТекстЗапросаСодержимогоПриобретения;
			Иначе
				Запрос.Текст =
					"УНИЧТОЖИТЬ СодержимоеПТУДляПеремещенияПоЗаказуПоставщику
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|" + ТекстЗапросаСодержимогоПриобретения;
			КонецЕсли;
			
			
			Запрос.Выполнить();
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапросаЗаказовНаПеремещение;
		
		//ASP_Hlopkov 20.11.2020+
		Запрос.УстановитьПараметр("ТЗРезультатаПроверки", ТЗРезультатаПроверки);
		//ASP_Hlopkov 20.11.2020-
		
		Запрос.Выполнить();
		
		
		Запрос.Текст = ТекстЗапросаИтоговыхТаблиц;
		РезультатыЗапросов = Запрос.ВыполнитьПакет();
		
		Если ЭтоПерваяИтерацияПоЗаказуПоставщику Тогда
			ПриобретенныеТовары = РезультатыЗапросов[0].Выгрузить();
			
			Если ПриобретенныеТовары.Количество() = 0 Тогда
				ИндексОбрабатываемогоЗаказаПоставщику = ИндексОбрабатываемогоЗаказаПоставщику + 1;
				ЭтоПерваяИтерацияПоЗаказуПоставщику = Истина;
				
				Запрос.Текст = ТекстЗапросаУничтоженияВременныхТаблицСЗаказамиНаПеремещения;
				Запрос.Выполнить();
				
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтрокиЗаказовНаПеремещения = РезультатыЗапросов[1].Выгрузить();
		
		ВыборкаЗаказовКлиентов = РезультатыЗапросов[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		
		ПредварительноеСозданиеЗаказовНаПеремещение = Ложь;
		
		Если ВыборкаЗаказовКлиентов.Количество() = 0 И ЭтоПерваяИтерацияПоЗаказуПоставщику Тогда
			ПредварительноеСозданиеЗаказовНаПеремещение = Истина;
		КонецЕсли;
		
		Если ПредварительноеСозданиеЗаказовНаПеремещение Тогда
			СоздатьЗаказынаПеремещениеИзПоступления(ПоступлениеТоваровНаСклад, ОбрабатываемыйЗаказПоставщику, Результат);
			
			Запрос.Текст = ТекстЗапросаУничтоженияВременныхТаблицСЗаказамиНаПеремещения;
			Запрос.Выполнить();
			
			//ASP_Hlopkov 20.11.2020+
			Запрос.Текст =
				"УНИЧТОЖИТЬ ТЗРезультатаПроверки
				|;";
			Запрос.Выполнить();
			//ASP_Hlopkov 20.11.2020-
			
			Запрос.Текст = ТекстЗапросаЗаказовНаПеремещение;
			
			//ASP_Hlopkov 20.11.2020+
			Запрос.УстановитьПараметр("ТЗРезультатаПроверки", ТЗРезультатаПроверки);
			//ASP_Hlopkov 20.11.2020-
			
			Запрос.Выполнить();
			
			Запрос.Текст = ТекстЗапросаИтоговыхТаблиц;
			РезультатыЗапросов = Запрос.ВыполнитьПакет();
			//ПриобретенныеТовары = РезультатыЗапросов[0].Выгрузить();
			СтрокиЗаказовНаПеремещения = РезультатыЗапросов[1].Выгрузить();
			
			ВыборкаЗаказовКлиентов = РезультатыЗапросов[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		КонецЕсли;
		
		
		ЗарезервированныеВЗаказеНаПеремещение = ПриобретенныеТовары.СкопироватьКолонки();
		ЗарезервированныеВЗаказеНаПеремещение.Колонки.КРезервированию.Имя = "Зарезервировано";
		
		СтруктураОтбораПриобретенного = Новый Структура("ЗаказКлиента, Номенклатура, Характеристика");
		СтруктураОтбораСтрокЗаказаНаПеремещение = Новый Структура("ЗаказКлиента, ЗаказНаПеремещение");
		
		Пока ВыборкаЗаказовКлиентов.Следующий() Цикл
			
			ВыборкаЗаказовНаПеремещение = ВыборкаЗаказовКлиентов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЗаказовНаПеремещение.Следующий() Цикл
				
				ЗаполнитьЗначенияСвойств(СтруктураОтбораСтрокЗаказаНаПеремещение, ВыборкаЗаказовНаПеремещение);
				ОбрабатываемыеСтрокиЗаказаНаПеремещение = СтрокиЗаказовНаПеремещения.НайтиСтроки(СтруктураОтбораСтрокЗаказаНаПеремещение);
				
				ОбработатьДокумент = Ложь;
				Для Каждого ОбрабатываемаяСтрокаЗаказаНаПеремещение Из ОбрабатываемыеСтрокиЗаказаНаПеремещение Цикл
					ЗаполнитьЗначенияСвойств(СтруктураОтбораПриобретенного, ОбрабатываемаяСтрокаЗаказаНаПеремещение);
					СтрокиПриобретенного = ПриобретенныеТовары.НайтиСтроки(СтруктураОтбораПриобретенного);
					Если СтрокиПриобретенного.Количество() > 0 И СтрокиПриобретенного[0].КРезервированию > 0 Тогда
						ОбработатьДокумент = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если Не ОбработатьДокумент Тогда
					Продолжить;
				КонецЕсли;
				
				
				Попытка
					ЗаблокироватьДанныеДляРедактирования(ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение);
					ЗаказНаПеремещениеОбъект = ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение.ПолучитьОбъект();
				Исключение
					СодержимоеОшибки = Новый Структура("Документ, ТекстОшибки", ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение, "Не удалось заблокировать документ;
						|вероятно, он редактируется другим пользователем");
					Результат.Ошибки.Добавить(СодержимоеОшибки);
					
					//ASP_Hlopkov 21.10.2020+
					ЗаписьЖурналаРегистрации("Данные.Изменение", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаказНаПеремещение,, "Не удалось заблокировать документ вероятно, он редактируется другим пользователем" + Символы.ПС + ОписаниеОшибки()); 
					//ASP_Hlopkov 21.10.2020-
					
					Продолжить;
				КонецПопытки;
				
				
				ЗарезервированныеВЗаказеНаПеремещение.Очистить();
				
				ДокументИзменен = Ложь;
				Для Каждого ОбрабатываемаяСтрокаЗаказаНаПеремещение Из ОбрабатываемыеСтрокиЗаказаНаПеремещение Цикл
					
					СтрокаРедактируемогоДокумента = ЗаказНаПеремещениеОбъект.Товары.Найти(ОбрабатываемаяСтрокаЗаказаНаПеремещение.КодСтроки, "КодСтроки");
					Если СтрокаРедактируемогоДокумента = Неопределено
						//  ASP_Мочалина 27.02.24
					// Или СтрокаРедактируемогоДокумента.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.ОтгрузитьОбособленно
					 Или СтрокаРедактируемогоДокумента.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.Отгрузить
					 Или СтрокаРедактируемогоДокумента.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада Тогда
						Продолжить;
					КонецЕсли;
					
					
					ЗаполнитьЗначенияСвойств(СтруктураОтбораПриобретенного, ОбрабатываемаяСтрокаЗаказаНаПеремещение);
					
					СтрокиПриобретенного = ПриобретенныеТовары.НайтиСтроки(СтруктураОтбораПриобретенного);
					Если СтрокиПриобретенного.Количество() = 0 Тогда
						Продолжить;
					Иначе
						КРезервированию = СтрокиПриобретенного[0].КРезервированию;
					КонецЕсли;
					
					СтрокиЗарезервированного = ЗарезервированныеВЗаказеНаПеремещение.НайтиСтроки(СтруктураОтбораПриобретенного);
					Если СтрокиЗарезервированного.Количество() > 0 Тогда
						СтрокаЗарезервированного = СтрокиЗарезервированного[0];
						КРезервированию = КРезервированию - СтрокаЗарезервированного.Зарезервировано;
					Иначе
						СтрокаЗарезервированного = ЗарезервированныеВЗаказеНаПеремещение.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаЗарезервированного, СтруктураОтбораПриобретенного);
						СтрокаЗарезервированного.Зарезервировано = 0;
					КонецЕсли;
					
					Если Мин(КРезервированию, СтрокаРедактируемогоДокумента.Количество) <= 0 Тогда
						Продолжить;
					КонецЕсли;
					
					
					Если КРезервированию < СтрокаРедактируемогоДокумента.Количество Тогда
						ИндексРедактируемойСтроки = ЗаказНаПеремещениеОбъект.Товары.Индекс(СтрокаРедактируемогоДокумента);
						НоваяСтрокаРедактируемогоДокумента = ЗаказНаПеремещениеОбъект.Товары.Вставить(ИндексРедактируемойСтроки + 1);
						ЗаполнитьЗначенияСвойств(НоваяСтрокаРедактируемогоДокумента, СтрокаРедактируемогоДокумента);
						
						СтрокаРедактируемогоДокумента.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
						СтрокаРедактируемогоДокумента.Количество = КРезервированию;
						СтрокаРедактируемогоДокумента.КоличествоУпаковок = КРезервированию;
						
						НоваяСтрокаРедактируемогоДокумента.КодСтроки = 0;
						НоваяСтрокаРедактируемогоДокумента.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
						НоваяСтрокаРедактируемогоДокумента.Количество = НоваяСтрокаРедактируемогоДокумента.Количество - КРезервированию;
						НоваяСтрокаРедактируемогоДокумента.КоличествоУпаковок = НоваяСтрокаРедактируемогоДокумента.Количество;
					КонецЕсли;
					
					СтрокаРедактируемогоДокумента.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
					ДокументИзменен = Истина;
					
					СтрокаЗарезервированного.Зарезервировано = СтрокаЗарезервированного.Зарезервировано + СтрокаРедактируемогоДокумента.Количество;
				КонецЦикла;
				
				Если ДокументИзменен Тогда
					ПолучитьСообщенияПользователю(Истина);
					
					Попытка
						ЗаказНаПеремещениеОбъект.Записать(РежимЗаписиДокумента.Проведение);
						Если Результат.ДозаполненныеДокументы.Найти(ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение) = Неопределено Тогда
							Результат.ДозаполненныеДокументы.Добавить(ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение);
						КонецЕсли;
					Исключение
						КлючСообщений = ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение;
						ВесьТекстОшибки = "Не удалось дозаполнить Заказ на перемещение:";
						
						МассивСообщенийПользователю = ПолучитьСообщенияПользователю(Истина);
						СтрокаСообщений = "";
						Для Каждого Сообщение Из МассивСообщенийПользователю Цикл
							ПредставлениеКлючаСообщения = "";
							Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Сообщение.КлючДанных))
							 И Сообщение.КлючДанных <> КлючСообщений Тогда
								ПредставлениеКлючаСообщения = Строка(Сообщение.КлючДанных) + ": ";
							КонецЕсли;
							
							СтрокаСообщений = СтрокаСообщений + ПредставлениеКлючаСообщения + Сообщение.Текст + Символы.ПС;
						КонецЦикла;
						
						СтрокаСообщений = ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС + СтрокаСообщений);
						ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
						
						Если ПредставлениеОшибки = "Не удалось провести """ + Строка(КлючСообщений) + """!" Тогда
							ПредставлениеОшибки = "";
						Иначе
							ПредставлениеОшибки = Символы.ПС + ПредставлениеОшибки;
						КонецЕсли;
						
						ВесьТекстОшибки = ВесьТекстОшибки + ПредставлениеОшибки + СтрокаСообщений;
						СодержимоеОшибки = Новый Структура("Документ, ТекстОшибки", КлючСообщений, ВесьТекстОшибки);
						
						Результат.Ошибки.Добавить(СодержимоеОшибки);
						ЗарезервированныеВЗаказеНаПеремещение.Очистить();
					КонецПопытки;
				КонецЕсли;
				
				РазблокироватьДанныеДляРедактирования(ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение);
				
				ЗарезервированныеВЗаказеНаПеремещение.Свернуть("ЗаказКлиента, Номенклатура, Характеристика", "Зарезервировано");
				Для Каждого СтрокаЗарезервированного Из ЗарезервированныеВЗаказеНаПеремещение Цикл
					ЗаполнитьЗначенияСвойств(СтруктураОтбораПриобретенного, СтрокаЗарезервированного);
					СтрокиПриобретенного = ПриобретенныеТовары.НайтиСтроки(СтруктураОтбораПриобретенного);
					Если СтрокиПриобретенного.Количество() > 0 Тогда
						СтрокиПриобретенного[0].КРезервированию = Макс(0, СтрокиПриобретенного[0].КРезервированию - СтрокаЗарезервированного.Зарезервировано);
					КонецЕсли;
					
					
					МенеджерЗаписиВРегистр = РегистрыСведений.асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(МенеджерЗаписиВРегистр, СтрокаЗарезервированного);
					МенеджерЗаписиВРегистр.ДокументПриобретения = ПоступлениеТоваровНаСклад;
					МенеджерЗаписиВРегистр.ЗаказПоставщику = ОбрабатываемыйЗаказПоставщику;
					МенеджерЗаписиВРегистр.ЗаказНаПеремещение = ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение;
					МенеджерЗаписиВРегистр.Прочитать();
					
					Если МенеджерЗаписиВРегистр.Выбран() Тогда
						НовоеЗначениеЗарезервированного = МенеджерЗаписиВРегистр.Количество + СтрокаЗарезервированного.Зарезервировано;
					Иначе
						НовоеЗначениеЗарезервированного = СтрокаЗарезервированного.Зарезервировано;
						
						ЗаполнитьЗначенияСвойств(МенеджерЗаписиВРегистр, СтрокаЗарезервированного);
						МенеджерЗаписиВРегистр.ДокументПриобретения = ПоступлениеТоваровНаСклад;
						МенеджерЗаписиВРегистр.ЗаказПоставщику = ОбрабатываемыйЗаказПоставщику;
						МенеджерЗаписиВРегистр.ЗаказНаПеремещение = ВыборкаЗаказовНаПеремещение.ЗаказНаПеремещение;
					КонецЕсли;
					
					МенеджерЗаписиВРегистр.Количество = НовоеЗначениеЗарезервированного;
					МенеджерЗаписиВРегистр.Записать();
				КонецЦикла;
				
			КонецЦикла; //Пока ВыборкаЗаказовНаПеремещение.Следующий()
			
		КонецЦикла;
		
		ИндексСтрокиПриобретенного = 0;
		Пока ИндексСтрокиПриобретенного < ПриобретенныеТовары.Количество() Цикл
			СтрокаПриобретенного = ПриобретенныеТовары[ИндексСтрокиПриобретенного];
			Если СтрокаПриобретенного.КРезервированию = 0 Тогда
				ПриобретенныеТовары.Удалить(СтрокаПриобретенного);
			Иначе
				ИндексСтрокиПриобретенного = ИндексСтрокиПриобретенного + 1;
			КонецЕсли;
		КонецЦикла;
		
		
		Если ПриобретенныеТовары.Количество() > 0 И ЭтоПерваяИтерацияПоЗаказуПоставщику И Не ПредварительноеСозданиеЗаказовНаПеремещение Тогда
			КопияПриобретенныеТовары = ПриобретенныеТовары.Скопировать(); 
			ЗаписьЖурналаРегистрации("Проверка склада по заказу на перемещение", УровеньЖурналаРегистрации.Примечание,, "По приобретению", "По приобретению");
			СоздатьЗаказынаПеремещениеИзПоступления(ПоступлениеТоваровНаСклад, ОбрабатываемыйЗаказПоставщику, Результат, КопияПриобретенныеТовары);
			ЭтоПерваяИтерацияПоЗаказуПоставщику = Ложь;
		Иначе
			ИндексОбрабатываемогоЗаказаПоставщику = ИндексОбрабатываемогоЗаказаПоставщику + 1;
			ЭтоПерваяИтерацияПоЗаказуПоставщику = Истина;
		КонецЕсли;
		
		
		Запрос.Текст = ТекстЗапросаУничтоженияВременныхТаблицСЗаказамиНаПеремещения;
		Запрос.Выполнить();
		
	КонецЦикла;
	
	
	//+++ {{ ASP 10.09.2020 000008403 }}
	ЗапросПоОставшимсяЗаказамПоставщику = Новый Запрос;
	ЗапросПоОставшимсяЗаказамПоставщику.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросПоОставшимсяЗаказамПоставщику.УстановитьПараметр("ЗаказыПоставщику", МассивОставшихсяЗаказовПоставщику);
	ЗапросПоОставшимсяЗаказамПоставщику.Текст =
		"ВЫБРАТЬ
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.СкладОприходования КАК СкладОприходования,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказКлиента КАК ЗаказКлиента,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Номенклатура КАК Номенклатура,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Характеристика КАК Характеристика,
		|	СУММА(СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Количество) КАК Количество
		|ПОМЕСТИТЬ СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам
		|ИЗ
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам КАК СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам
		|ГДЕ
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказПоставщику В(&ЗаказыПоставщику)
		|
		|СГРУППИРОВАТЬ ПО
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.СкладОприходования,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказКлиента,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Номенклатура,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаТовары.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаТовары.Ссылка.Склад
		|		ИНАЧЕ ЗаказКлиентаТовары.Склад
		|	КОНЕЦ КАК СкладПродажи,
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.СкладОприходования КАК СкладОприходования,
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.ЗаказКлиента КАК ЗаказКлиента,
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.Номенклатура КАК Номенклатура,
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.Характеристика КАК Характеристика,
		|	МАКСИМУМ(СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.Количество) КАК КоличествоВПриобретении,
		|	СУММА(ЕСТЬNULL(ЗаказКлиентаТовары.Количество, 0)) КАК КоличествоВЗаказах
		|ИЗ
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам КАК СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
		|		ПО (СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.ЗаказКлиента = ЗаказКлиентаТовары.Ссылка)
		|			И (СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.Номенклатура = ЗаказКлиентаТовары.Номенклатура)
		|			И (СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.Характеристика = ЗаказКлиентаТовары.Характеристика)
		|			И (НЕ ЗаказКлиентаТовары.Отменено) 
		// ASP_Мочалина 27.02.24
		//|			И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно)) 
		|			И (ЗаказКлиентаТовары.Обособленно = ИСТИНА)
		|			И (ЗаказКлиентаТовары.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|					И СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.СкладОприходования <> ЗаказКлиентаТовары.Ссылка.Склад
		|				ИЛИ СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.СкладОприходования <> ЗаказКлиентаТовары.Склад)
		|
		|СГРУППИРОВАТЬ ПО
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.СкладОприходования,
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.ЗаказКлиента,
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.Номенклатура,
		|	СодержимоеПТУДляПеремещенияПоОставшимсяЗаказамПоставщикам.Характеристика,
		|	ВЫБОР
		|		КОГДА ЗаказКлиентаТовары.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|			ТОГДА ЗаказКлиентаТовары.Ссылка.Склад
		|		ИНАЧЕ ЗаказКлиентаТовары.Склад
		|	КОНЕЦ
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЕСТЬNULL(ЗаказКлиентаТовары.Количество, 0)) > 0
		|ИТОГИ
		|	МАКСИМУМ(СкладОприходования)
		|ПО
		|	СкладПродажи";
	
	ЗначенияРеквизитовПоступления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоступлениеТоваровНаСклад, "Организация, Подразделение, ВариантПриемкиТоваров");
	
	ВыборкаПоСкладамПродажи = ЗапросПоОставшимсяЗаказамПоставщику.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоСкладамПродажи.Следующий() Цикл
		
		Перемещение = Документы.ЗаказНаПеремещение.СоздатьДокумент();
		Перемещение.ДокументОснование = ПоступлениеТоваровНаСклад;
		Перемещение.Дата = ТекущаяДата();
		Перемещение.СкладОтправитель = ВыборкаПоСкладамПродажи.СкладОприходования;
		Перемещение.СкладПолучатель = ВыборкаПоСкладамПродажи.СкладПродажи;
		Перемещение.Ответственный = Пользователи.ТекущийПользователь();
		Перемещение.Статус = Перечисления.СтатусыВнутреннихЗаказов.КВыполнению;
		Перемещение.ВариантПриемкиТоваров = ЗначенияРеквизитовПоступления.ВариантПриемкиТоваров;
		ЗаписьЖурналаРегистрации("Проверка склада по заказу на перемещение", УровеньЖурналаРегистрации.Примечание,,"" + ВыборкаЗаказовКлиентов.СкладПродажи + Символы.ПС + ВыборкаЗаказовКлиентов.СкладОприходования, "Склад продажи / склад оприходования. ПроизвестиНакопление");
		Перемещение.Организация = ЗначенияРеквизитовПоступления.Организация;
		Перемещение.Подразделение = ЗначенияРеквизитовПоступления.Подразделение;
		Перемещение.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ПеремещениеТоваров;
		Перемещение.СпособДоставки = Перечисления.СпособыДоставки.Самовывоз;
		
		ВыборкаТоваров = ВыборкаПоСкладамПродажи.Выбрать();
		
		Пока ВыборкаТоваров.Следующий() Цикл
			КолвоКПеремещению = Мин(ВыборкаТоваров.КоличествоВПриобретении, ВыборкаТоваров.КоличествоВЗаказах);
			Если КолвоКПеремещению <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйТовар = Перемещение.Товары.Добавить();
			НовыйТовар.Количество = КолвоКПеремещению;
			НовыйТовар.КоличествоУпаковок = КолвоКПеремещению;
			НовыйТовар.ВариантОбеспечения = Перечисления.ВариантыОбеспечения.СоСклада;
			НовыйТовар.НачалоОтгрузки = ТекущаяДата() + ((24*60*60)*3);
			НовыйТовар.Номенклатура = ВыборкаТоваров.Номенклатура;
			НовыйТовар.Назначение = Справочники.Назначения.НайтиПоРеквизиту("Заказ", ВыборкаТоваров.ЗаказКлиента);
			НовыйТовар.Характеристика = ВыборкаТоваров.Характеристика;
		КонецЦикла;
		
		Если Перемещение.Товары.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПолучитьСообщенияПользователю(Истина);
		
		Попытка
			Перемещение.Записать(РежимЗаписиДокумента.Проведение);
			Результат.СозданныеДокументы.Добавить(Перемещение.Ссылка);
		Исключение
			ТекстОшибки = "Не удалось создать новый Заказ на перемещение на склад " + Строка(ВыборкаПоСкладамПродажи.СкладПродажи);
			Если Перемещение.Товары.Количество() > 0 Тогда
				ТекстОшибки = ТекстОшибки + " товара(ов) ";
				Для Каждого СтрокаТЧ Из Перемещение.Товары Цикл
					ТекстОшибки = ТекстОшибки + Строка(СтрокаТЧ.Номенклатура) + Символы.ПС;
				КонецЦикла;
			КонецЕсли;
			ТекстОшибки = ТекстОшибки + " по причине:" + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			
			МассивСообщенийПользователю = ПолучитьСообщенияПользователю(Истина);
			СтрокаСообщений = "";
			Для Каждого Сообщение Из МассивСообщенийПользователю Цикл
				СтрокаСообщений = СтрокаСообщений + Сообщение.Текст + Символы.ПС;
			КонецЦикла;
			
			СтрокаСообщений = ?(ПустаяСтрока(СтрокаСообщений), "", Символы.ПС + СтрокаСообщений);
			ВесьТекстОшибки = ТекстОшибки + СтрокаСообщений;
			
			Результат.Ошибки.Добавить(ВесьТекстОшибки);
			
			//ASP_Hlopkov 21.10.2020+
			ЗаписьЖурналаРегистрации("Данные.Изменение", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ЗаказНаПеремещение,, ВесьТекстОшибки + Символы.ПС + ОписаниеОшибки()); 
			//ASP_Hlopkov 21.10.2020-
			
		КонецПопытки;
		
	КонецЦикла;
	//--- {{ ASP 10.09.2020 000008403 }}
	
КонецПроцедуры

Процедура СоздатьЗаказынаПеремещениеИзПоступления(ПоступлениеТовараНаСклад, ЗаказПоставщику, Результат, ПриобретенныеТовары = Неопределено)
	
	ЗначенияРеквизитовПриобретения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПоступлениеТовараНаСклад, "Организация, Подразделение, ВариантПриемкиТоваров, Склад");
	
	ЗапросПотребностейКПеремещению = Новый Запрос;
	
	Если ПриобретенныеТовары = Неопределено Тогда
		
		ЗапросПотребностейКПеремещению.Текст =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗаказПоставщикуТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
		|				И ЗаказПоставщикуТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|			ТОГДА ЗаказПоставщикуТовары.Назначение.Заказ
		|		КОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
		|			ТОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ КАК ЗаказКлиента,
		|	ЗаказПоставщикуТовары.Номенклатура КАК Номенклатура,
		|	ЗаказПоставщикуТовары.Характеристика КАК Характеристика,
		|	СУММА(ЗаказПоставщикуТовары.Количество) КАК Количество
		|ПОМЕСТИТЬ СтрокиЗаказаПоставщику
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
		|ГДЕ
		|	ЗаказПоставщикуТовары.Ссылка = &ЗаказПоставщику
		|	И ЗаказПоставщикуТовары.Ссылка.Проведен
		|	И ЗаказПоставщикуТовары.Ссылка.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Закрыт)
		|	И ЗаказПоставщикуТовары.Склад = &СкладПТУ
		|	И НЕ ЗаказПоставщикуТовары.Отменено
		|	И ЗаказПоставщикуТовары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА ЗаказПоставщикуТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
		|				И ЗаказПоставщикуТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
		|			ТОГДА ЗаказПоставщикуТовары.Назначение.Заказ
		|		КОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
		|			ТОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента
		|		ИНАЧЕ НЕОПРЕДЕЛЕНО
		|	КОНЕЦ,
		|	ЗаказПоставщикуТовары.Номенклатура,
		|	ЗаказПоставщикуТовары.Характеристика
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СтрокиЗаказаПоставщику.ЗаказКлиента КАК ЗаказКлиента
		|ИЗ
		|	СтрокиЗаказаПоставщику КАК СтрокиЗаказаПоставщику
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЗаказовКлиентов КАК СостоянияЗаказовКлиентов
		|		ПО ((ВЫРАЗИТЬ(СтрокиЗаказаПоставщику.ЗаказКлиента КАК Документ.ЗаказКлиента)) = СостоянияЗаказовКлиентов.Заказ)
		|ГДЕ
		|	СтрокиЗаказаПоставщику.ЗаказКлиента <> НЕОПРЕДЕЛЕНО
		|	И СтрокиЗаказаПоставщику.ЗаказКлиента.Проведен
		|	И СостоянияЗаказовКлиентов.Состояние ЕСТЬ НЕ NULL 
		|	И СостоянияЗаказовКлиентов.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.ОжидаетсяОплатаПослеОтгрузки)
		|	И СостоянияЗаказовКлиентов.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.ГотовКЗакрытию)
		|	И СостоянияЗаказовКлиентов.Состояние <> ЗНАЧЕНИЕ(Перечисление.СостоянияЗаказовКлиентов.Закрыт)
		|";
			//ASP_Hlopkov 19.11.2020+
			//|
			//|////////////////////////////////////////////////////////////////////////////////
			ЗапросПотребностейКПеремещению.УстановитьПараметр("ЗаказПоставщику", ЗаказПоставщику);
			ЗапросПотребностейКПеремещению.УстановитьПараметр("СкладПТУ", ЗначенияРеквизитовПриобретения.Склад);
			
			ТЗСЗаказами = ЗапросПотребностейКПеремещению.Выполнить().Выгрузить();
			
			ЗапросПотребностейКПеремещениюПродолжение = Новый Запрос;
			
			ЗапросПотребностейКПеремещениюПродолжение.Текст =
			"ВЫБРАТЬ
			|	ТЗСЗаказами.ЗаказКлиента КАК ЗаказКлиента
			|ПОМЕСТИТЬ ВТЗаказыКлиентов
			|ИЗ
			|	&ТЗСЗаказами КАК ТЗСЗаказами
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТЗаказыКлиентов.ЗаказКлиента КАК ЗаказКлиента,
			|	ЗаказКлиентаТовары.Номенклатура КАК Номенклатура,
			|	ЗаказКлиентаТовары.Характеристика КАК Характеристика,
			|	ЗаказКлиентаТовары.Склад КАК СкладПродажи,
			|	&СкладПТУ КАК СкладОприходования,
			|	СУММА(ЗаказКлиентаТовары.Количество) КАК Количество
			|ИЗ
			|	ВТЗаказыКлиентов КАК ВТЗаказыКлиентов
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
			|		ПО (ВТЗаказыКлиентов.ЗаказКлиента = ЗаказКлиентаТовары.Ссылка)
			|			И (НЕ ЗаказКлиентаТовары.Отменено)
			
			// ASP_Мочалина 27.02.24
			//|			И (ЗаказКлиентаТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Обособленно))
			|			И (ЗаказКлиентаТовары.Обособленно = ИСТИНА)
			|			И (ЗаказКлиентаТовары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара)))
			|			И (ЗаказКлиентаТовары.Склад <> &СкладПТУ)
			|
			|СГРУППИРОВАТЬ ПО
			|	ВТЗаказыКлиентов.ЗаказКлиента,
			|	ЗаказКлиентаТовары.Номенклатура,
			|	ЗаказКлиентаТовары.Характеристика,
			|	ЗаказКлиентаТовары.Склад
			|	
			|УПОРЯДОЧИТЬ ПО
			|	ЗаказКлиента,
			|	СкладПродажи,
			|	Номенклатура,
			|	Характеристика
			|";
			
			ЗапросПотребностейКПеремещениюПродолжение.УстановитьПараметр("СкладПТУ", ЗначенияРеквизитовПриобретения.Склад);
			ЗапросПотребностейКПеремещениюПродолжение.УстановитьПараметр("ТЗСЗаказами", ТЗСЗаказами);
			
			РезПродолжения = ЗапросПотребностейКПеремещениюПродолжение.Выполнить();
			ТоварыЗаказовКлиентов = РезПродолжения.Выгрузить();
			ТоварыЗаказовКлиентов.Индексы.Добавить("ЗаказКлиента, Номенклатура, Характеристика");
			
		ЗапросПотребностейКПеремещению.Текст =
			"ВЫБРАТЬ
			|	ТоварыЗаказовКлиентов.ЗаказКлиента КАК ЗаказКлиента,
			|	ТоварыЗаказовКлиентов.СкладПродажи КАК СкладПродажи,
			|	ТоварыЗаказовКлиентов.СкладОприходования КАК СкладОприходования,
			|	ТоварыЗаказовКлиентов.Номенклатура КАК Номенклатура,
			|	ТоварыЗаказовКлиентов.Характеристика КАК Характеристика,
			|	ТоварыЗаказовКлиентов.Количество КАК Количество
			|ПОМЕСТИТЬ ТаблицаИсточник
			|ИЗ
			|	&ТоварыЗаказовКлиентов КАК ТоварыЗаказовКлиентов
			|;";
		ЗапросПотребностейКПеремещению.УстановитьПараметр("ТоварыЗаказовКлиентов", ТоварыЗаказовКлиентов);
		ЗаписьЖурналаРегистрации("Проверка склада по заказу на перемещение", УровеньЖурналаРегистрации.Примечание,,"По заказу клиента", "По заказу клиента");
		
	Иначе
		
		ЗапросПотребностейКПеремещению.Текст =
			"ВЫБРАТЬ
			|	ПриобретенныеТовары.ЗаказКлиента КАК ЗаказКлиента,
			|	ВЫБОР
			|		КОГДА ЗаказКлиентаТовары.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
			|			ТОГДА ЗаказКлиентаТовары.Ссылка.Склад
			|		ИНАЧЕ ЗаказКлиентаТовары.Склад
			|	КОНЕЦ КАК СкладПродажи,
			|	&СкладОприходования КАК СкладОприходования,
			|	ПриобретенныеТовары.Номенклатура КАК Номенклатура,
			|	ПриобретенныеТовары.Характеристика КАК Характеристика,
			|	ПриобретенныеТовары.КРезервированию КАК Количество
			|ПОМЕСТИТЬ ТаблицаИсточник
			|ИЗ
			|	&ПриобретенныеТовары КАК ПриобретенныеТовары
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказКлиента.Товары КАК ЗаказКлиентаТовары
			|		ПО (ПриобретенныеТовары.ЗаказКлиента = ЗаказКлиентаТовары.Ссылка
			|			И ЗаказКлиентаТовары.Номенклатура = ПриобретенныеТовары.Номенклатура
			|			И ЗаказКлиентаТовары.Характеристика = ПриобретенныеТовары.Характеристика)
			|;";
		ЗаписьЖурналаРегистрации("Проверка склада по заказу на перемещение", УровеньЖурналаРегистрации.Примечание,,"По приобретению", "По Приобретению");
		ЗапросПотребностейКПеремещению.УстановитьПараметр("СкладОприходования", ЗначенияРеквизитовПриобретения.Склад);
		ЗапросПотребностейКПеремещению.УстановитьПараметр("ПриобретенныеТовары", ПриобретенныеТовары);
		
	КонецЕсли;
	
	ЗапросПотребностейКПеремещению.Текст = ЗапросПотребностейКПеремещению.Текст +
		"
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаИсточник.ЗаказКлиента КАК ЗаказКлиента,
		|	ТаблицаИсточник.СкладПродажи КАК СкладПродажи,
		|	ТаблицаИсточник.СкладОприходования КАК СкладОприходования,
		|	ТаблицаИсточник.Номенклатура КАК Номенклатура,
		|	ТаблицаИсточник.Характеристика КАК Характеристика,
		|	СУММА(ТаблицаИсточник.Количество) КАК Количество
		|ИЗ
		|	ТаблицаИсточник КАК ТаблицаИсточник
		//ASP_Hlopkov 19.11.2020+
		|ГДЕ
		|	ТаблицаИсточник.СкладПродажи <> ТаблицаИсточник.СкладОприходования
		//ASP_Hlopkov 19.11.2020-
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаИсточник.ЗаказКлиента,
		|	ТаблицаИсточник.СкладПродажи,
		|	ТаблицаИсточник.СкладОприходования,
		|	ТаблицаИсточник.Номенклатура,
		|	ТаблицаИсточник.Характеристика
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЗаказКлиента,
		|	Номенклатура,
		|	Характеристика
		|ИТОГИ
		|	МАКСИМУМ(СкладОприходования)
		|ПО
		|	ЗаказКлиента,
		|	СкладПродажи";
	
	//ASP_Hlopkov 09.10.2020+
	Рез = ЗапросПотребностейКПеремещению.Выполнить();
	//ТЗРез = Рез.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);	
	//ASP_Hlopkov 09.10.2020-
	
	ВыборкаПервогоУровня = ЗапросПотребностейКПеремещению.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПервогоУровня.Следующий() Цикл
		
		ВыборкаЗаказовКлиентов = ВыборкаПервогоУровня.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		СтруктураОтбораПриобретенных = Новый Структура("Номенклатура, Характеристика");
		
		Пока ВыборкаЗаказовКлиентов.Следующий() Цикл
			
			
			
			//собственно, создание Заказа на перемещение
			
			Перемещение = Неопределено; //ASP_Dante 02/11/20 Для каждого заказа клиента свой заказ на перемещение.
			
			Если ПриобретенныеТовары <> Неопределено //ЭТОТ БЛОК УДАЛИТЬ
			 И ПриобретенныеТовары.Найти(ВыборкаЗаказовКлиентов.ЗаказКлиента, "ЗаказКлиента") = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
	#Область ПостановкаВРезервВСуществующихЗаказахНаПеремещениеИлиСозданиеЗаказаНаПеремещение //+++ {{ ASP 11.11.2020 000008970 }} обрамлено в область
			
			//ASP_Hlopkov 09.10.2020+ проверяем есть ли уже созданные заказы на перемещение с этим назначением
			Запрос = Новый Запрос;
			Запрос.Текст =
			
			    "ВЫБРАТЬ
				|	ЗаказНаПеремещениеТовары.Ссылка КАК Ссылка,
				|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
				|	ЗаказНаПеремещениеТовары.ВариантОбеспечения КАК ВариантОбеспечения,
				|	ЗаказНаПеремещениеТовары.Назначение.Заказ КАК ЗаказКлиента,
				|	ЗаказНаПеремещениеТовары.Назначение КАК Назначение,
				//ASP_Hlopkov 15.10.2020+
				|	СУММА(ЗаказНаПеремещениеТовары.Количество) КАК Количество
				//ASP_Hlopkov 15.10.2020-
				|ИЗ
				|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
				|ГДЕ
				|	ЗаказНаПеремещениеТовары.Назначение.Заказ = &Заказ
				|	И НЕ ЗаказНаПеремещениеТовары.Ссылка.ПометкаУдаления
				//ASP_Hlopkov 20.10.2020+
				//|	И НЕ ЗаказНаПеремещениеТовары.ВариантОбеспечения = ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада)
				//ASP_Hlopkov 20.10.2020-
				//ASP_Hlopkov 15.10.2020+
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказНаПеремещениеТовары.Ссылка,
				|	ЗаказНаПеремещениеТовары.Номенклатура,
				|	ЗаказНаПеремещениеТовары.ВариантОбеспечения,
				|	ЗаказНаПеремещениеТовары.Назначение.Заказ,
				|	ЗаказНаПеремещениеТовары.Назначение
				|
				//ASP_Hlopkov 15.10.2020-
				|УПОРЯДОЧИТЬ ПО
				//|	Ссылка,
				|	Номенклатура,
				|	ЗаказНаПеремещениеТовары.Ссылка.Дата
				|ИТОГИ
				|	СУММА(Количество)
				|ПО
				|	Номенклатура,
				|	Назначение";
			
			Запрос.УстановитьПараметр("Заказ", ВыборкаЗаказовКлиентов.ЗаказКлиента);
			
			РезультатЗапроса = Запрос.Выполнить();
			
			//ТЗРез = РезультатЗапроса.Выгрузить();
			//Если есть обходим товары и пытаемся поставить в резерв
			Если НЕ РезультатЗапроса.Пустой() Тогда
				
				ТЗНеПоставленых = Новый ТаблицаЗначений;
				
				ТЗНеПоставленых.Колонки.Добавить("ЗаказКлиента");
				ТЗНеПоставленых.Колонки.Добавить("Номенклатура");
				ТЗНеПоставленых.Колонки.Добавить("Назначение");
				ТЗНеПоставленых.Колонки.Добавить("Количество");
				ТЗНеПоставленых.Колонки.Добавить("НужноСоздаватьЗаказ");
				
