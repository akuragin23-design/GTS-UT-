		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам КАК СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.асп_ЗаказыНаПеремещениеСРезервамиПоПТУ КАК асп_ЗаказыНаПеремещениеСРезервамиПоПТУ
		|		ПО (асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.ДокументПриобретения = &СсылкаНаПТНС)
		|			И СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказПоставщику = асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.ЗаказПоставщику
		|			И СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказКлиента = асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.ЗаказКлиента
		|			И СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Номенклатура = асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.Номенклатура
		|			И СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Характеристика = асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.Характеристика
		|ГДЕ
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказПоставщику = &ЗаказПоставщику
		|
		|СГРУППИРОВАТЬ ПО
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказПоставщику,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.ЗаказКлиента,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Номенклатура,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Характеристика,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.СкладОприходования,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.СкладПродажи,
		|	СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Количество
		|
		|ИМЕЮЩИЕ
		|	ВЫБОР
		|		КОГДА СУММА(ЕСТЬNULL(асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.Количество, 0)) >= СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Количество
		|				ИЛИ СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Количество <= 0
		|			ТОГДА 0
		|		ИНАЧЕ СодержимоеПТУДляПеремещенияПоВсемЗаказамПоставщикам.Количество - СУММА(ЕСТЬNULL(асп_ЗаказыНаПеремещениеСРезервамиПоПТУ.Количество, 0))
		|	КОНЕЦ > 0";
	
	//ASP_Hlopkov 20.11.2020+ Добавил проверку на группу складов иначе дальнейшие таблицы будут рассчитываться некорректно
	ТекстЗапросаПроверкиСклада = 
		"
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.ЗаказПоставщику КАК ЗаказПоставщику,
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.ЗаказКлиента КАК ЗаказКлиента,
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.Номенклатура КАК Номенклатура,
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.Характеристика КАК Характеристика,
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.СкладОприходования КАК СкладОприходования,
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.СкладПродажи КАК СкладПродажи,
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.КРезервированию КАК КРезервированию,
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику.СкладПродажи.ЭтоГруппа КАК СкладПродажиЭтоГруппа
		|ИЗ
		|	СодержимоеПТУДляПеремещенияПоЗаказуПоставщику КАК СодержимоеПТУДляПеремещенияПоЗаказуПоставщику";
	
	ЗапросДляПроверкиСклада = Новый Запрос;
	ЗапросДляПроверкиСклада.Текст = ТекстЗапросаВТИзПроверкиНеобходимости + ТекстДобавочный + ТекстЗапросаСодержимогоПриобретения + ТекстЗапросаПроверкиСклада;
	
	//ЗапросДляПроверкиСклада.МенеджерВременныхТаблиц = МенеджерВТ;
	
	Если МассивОбрабатываемыхЗаказовПоставщикам.Количество() > 0 Тогда
	
		ЗапросДляПроверкиСклада.УстановитьПараметр("ЗаказПоставщику", МассивОбрабатываемыхЗаказовПоставщикам[0]);
		ЗапросДляПроверкиСклада.УстановитьПараметр("СсылкаНаПТНС", ПоступлениеТоваровНаСклад);
		
		ТЗРезультатаПроверки = ЗапросДляПроверкиСклада.Выполнить().Выгрузить();
		
		Для Каждого СтрокаРезультата Из ТЗРезультатаПроверки Цикл
			
			Если СтрокаРезультата.СкладПродажиЭтоГруппа Тогда
				СтруктураОтбора = Новый Структура("Номенклатура, Характеристика", СтрокаРезультата.Номенклатура, СтрокаРезультата.Характеристика);
				
				МассивНайденныхСтрок = СтрокаРезультата.ЗаказКлиента.Товары.НайтиСтроки(СтруктураОтбора);
				
				Если МассивНайденныхСтрок.Количество() > 0 Тогда
					Для Каждого СтрокаМассива Из МассивНайденныхСтрок Цикл
						Если СтрокаМассива.Склад <> СтрокаРезультата.СкладОприходования Тогда
							СтрокаРезультата.СкладПродажи = СтрокаМассива.Склад;		
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;	
					
			КонецЕсли;	
			
		КонецЦикла;
		
	КонецЕсли;	
	//ASP_Hlopkov 20.11.2020-
	
	ТекстЗапросаЗаказовНаПеремещение =
	//ASP_Hlopkov 20.11.2020+
					"ВЫБРАТЬ
				|	ТЗРезультатаПроверки.Номенклатура КАК Номенклатура,
				|	ТЗРезультатаПроверки.Характеристика КАК Характеристика,
				|	ТЗРезультатаПроверки.СкладПродажи КАК СкладПродажи,
				|	ТЗРезультатаПроверки.СкладОприходования КАК СкладОприходования,
				|	ТЗРезультатаПроверки.ЗаказПоставщику КАК ЗаказПоставщику,
				|	ТЗРезультатаПроверки.ЗаказКлиента КАК ЗаказКлиента,
				|	ТЗРезультатаПроверки.КРезервированию КАК КРезервированию
				|ПОМЕСТИТЬ ТЗРезультатаПроверки
				|ИЗ
				|	&ТЗРезультатаПроверки КАК ТЗРезультатаПроверки
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ЗаказНаПеремещениеТовары.Ссылка КАК ЗаказНаПеремещение,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование) = ТИП(Документ.ПриобретениеТоваровУслуг)
				|			ТОГДА ВЫРАЗИТЬ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование КАК Документ.ПриобретениеТоваровУслуг)
				|		КОГДА ТИПЗНАЧЕНИЯ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование) = ТИП(Документ.ПоступлениеТоваровНАСклад)
				|			ТОГДА ВЫРАЗИТЬ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование КАК Документ.ПоступлениеТоваровНаСклад)
				|	КОНЕЦ КАК ПриобретениеТоваровУслуг,
				|	ЗаказНаПеремещениеТовары.Ссылка.СкладОтправитель КАК СкладОтправитель,
				|	ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель КАК СкладПолучатель,
				|	ЗаказНаПеремещениеТовары.КодСтроки КАК КодСтроки,
				|	ЗаказНаПеремещениеТовары.Номенклатура КАК Номенклатура,
				|	ЗаказНаПеремещениеТовары.Характеристика КАК Характеристика,
				|	ВЫБОР
				|		КОГДА ЗаказНаПеремещениеТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
				|				И ЗаказНаПеремещениеТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ЗаказНаПеремещениеТовары.Назначение.Заказ
				|		КОГДА ЗаказНаПеремещениеТовары.ASP_ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ЗаказНаПеремещениеТовары.ASP_ЗаказКлиента
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК ЗаказКлиента,
				|	СУММА(ЗаказНаПеремещениеТовары.Количество) КАК Количество
				|ПОМЕСТИТЬ СтрокиЗаказовНаПеремещенияПоАналитикеБезСвязиСЗаказамиПоставщикам
				|ИЗ
				|	Документ.ЗаказНаПеремещение.Товары КАК ЗаказНаПеремещениеТовары
				|ГДЕ
				|	ЗаказНаПеремещениеТовары.Ссылка.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыЗаказовПоставщикам.Закрыт)
				|	И ЗаказНаПеремещениеТовары.Ссылка.Проведен
				|	И (ЗаказНаПеремещениеТовары.Номенклатура, ЗаказНаПеремещениеТовары.Характеристика, ЗаказНаПеремещениеТовары.Ссылка.СкладОтправитель, ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель) В
				|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
				|				ТЗРезультатаПроверки.Номенклатура,
				|				ТЗРезультатаПроверки.Характеристика,
				|				ТЗРезультатаПроверки.СкладОприходования,
				|				ТЗРезультатаПроверки.СкладПродажи
				|			ИЗ
				|				ТЗРезультатаПроверки КАК ТЗРезультатаПроверки)
				|	И НЕ ЗаказНаПеремещениеТовары.ВариантОбеспечения В (ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.Отгрузить), ЗНАЧЕНИЕ(Перечисление.ВариантыОбеспечения.СоСклада))
				|	И НЕ ЗаказНаПеремещениеТовары.Отменено
				|
				|СГРУППИРОВАТЬ ПО
				|	ЗаказНаПеремещениеТовары.Ссылка,
				|	ЗаказНаПеремещениеТовары.Ссылка.СкладОтправитель,
				|	ЗаказНаПеремещениеТовары.Ссылка.СкладПолучатель,
				|	ЗаказНаПеремещениеТовары.КодСтроки,
				|	ЗаказНаПеремещениеТовары.Номенклатура,
				|	ЗаказНаПеремещениеТовары.Характеристика,
				|	ВЫБОР
				|		КОГДА ЗаказНаПеремещениеТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
				|				И ЗаказНаПеремещениеТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ЗаказНаПеремещениеТовары.Назначение.Заказ
				|		КОГДА ЗаказНаПеремещениеТовары.ASP_ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ЗаказНаПеремещениеТовары.ASP_ЗаказКлиента
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование) = ТИП(Документ.ПриобретениеТоваровУслуг)
				|			ТОГДА ВЫРАЗИТЬ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование КАК Документ.ПриобретениеТоваровУслуг)
				|		КОГДА ТИПЗНАЧЕНИЯ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование) = ТИП(Документ.ПоступлениеТоваровНАСклад)
				|			ТОГДА ВЫРАЗИТЬ(ЗаказНаПеремещениеТовары.Ссылка.ДокументОснование КАК Документ.ПоступлениеТоваровНаСклад)
				|	КОНЕЦ
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	ПоступлениеТоваровНаСкладТовары.Ссылка КАК ПриобретениеТоваровУслуг,
				|	ВЫБОР
				|		КОГДА ТИПЗНАЧЕНИЯ(ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение) = ТИП(Документ.ЗаказПоставщику)
				|			ТОГДА ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение
				|		КОГДА ТИПЗНАЧЕНИЯ(ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение) = ТИП(Документ.ПриобретениеТоваровУслуг)
				|			ТОГДА ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение.ЗаказПоставщику
				|	КОНЕЦ КАК ЗаказПоставщику,
				|	ПоступлениеТоваровНаСкладТовары.Номенклатура КАК Номенклатура,
				|	ПоступлениеТоваровНаСкладТовары.Характеристика КАК Характеристика,
				|	ПоступлениеТоваровНаСкладТовары.Ссылка.Склад КАК Склад,
				|	ВЫБОР
				|		КОГДА ПоступлениеТоваровНаСкладТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
				|				И ПоступлениеТоваровНаСкладТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ПоступлениеТоваровНаСкладТовары.Назначение.Заказ
				|		КОГДА ПоступлениеТоваровНаСкладТовары.ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ПоступлениеТоваровНаСкладТовары.ЗаказКлиента
				|		КОГДА ЗаказПоставщикуТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
				|				И ЗаказПоставщикуТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ЗаказПоставщикуТовары.Назначение.Заказ
				|		КОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
				|				И ЗаказПоставщикуТовары.ASP_ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
				|			ТОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента
				|		ИНАЧЕ НЕОПРЕДЕЛЕНО
				|	КОНЕЦ КАК ЗаказКлиента
				|ПОМЕСТИТЬ СодержимоеВсехСвязанныхПТУ
				|ИЗ
				|	Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
				|		ПРАВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеТоваровНаСклад.Товары КАК ПоступлениеТоваровНаСкладТовары
				|		ПО (ВЫБОР
				|				КОГДА ТИПЗНАЧЕНИЯ(ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение) = ТИП(Документ.ЗаказПоставщику)
				|					ТОГДА ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение = ЗаказПоставщикуТовары.Ссылка
				|				КОГДА ТИПЗНАЧЕНИЯ(ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение) = ТИП(Документ.ПриобретениеТоваровУслуг)
				|					ТОГДА ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение.ЗаказПоставщику = ЗаказПоставщикуТовары.Ссылка
				|			КОНЕЦ)
				|			И (НЕ ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления)
				|			И (НЕ ЗаказПоставщикуТовары.Отменено)
				|			И (ПоступлениеТоваровНаСкладТовары.Номенклатура = ЗаказПоставщикуТовары.Номенклатура)
				|			И (ПоступлениеТоваровНаСкладТовары.Характеристика = ЗаказПоставщикуТовары.Характеристика)
				|ГДЕ
				|	ПоступлениеТоваровНаСкладТовары.Ссылка В
				|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
				|				СтрокиЗаказовНаПеремещенияПоАналитикеБезСвязиСЗаказамиПоставщикам.ПриобретениеТоваровУслуг
