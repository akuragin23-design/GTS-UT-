#Область ПоступлениеТоваровНаСклад

Процедура НакоплениеПоступившегоТовараВЗаказахНаПеремещение(ПоступлениеТоваровНаСклад, АдресРезультата) Экспорт
	
	Результат = Новый Структура("ДозаполненныеДокументы, СозданныеДокументы, Ошибки", Новый Массив, Новый Массив, Новый Массив);
	
	ПроизвестиНакоплениеПоступившегоТовараВЗаказахНаПеремещение(ПоступлениеТоваровНаСклад, Результат);
	
	ВозвращаемыйРезультат = Новый Структура;
	ИмяУведомления = "";
	Если Результат.Ошибки.Количество() = 1 Тогда
		ЕдинственнаяОшибка = Результат.Ошибки[0];
		Если ЕдинственнаяОшибка = "УжеСозданНаОснованииЗаказНаПеремещение"
		 Или ЕдинственнаяОшибка = "НетЗаказовПоставщикам" Тогда
			ИмяУведомления = ЕдинственнаяОшибка;
		КонецЕсли;
	ИначеЕсли Результат.ДозаполненныеДокументы.Количество() = 0
	 И Результат.СозданныеДокументы.Количество() = 0
	 И Результат.Ошибки.Количество() = 0 Тогда
		ИмяУведомления = "ПроверкаВыполнена";
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяУведомления) Тогда
		ВозвращаемыйРезультат.Вставить("ИмяУведомления", ИмяУведомления);
		ПоместитьВоВременноеХранилище(ВозвращаемыйРезультат, АдресРезультата);
		Возврат;
	КонецЕсли;
	
	
	ОбъектСДанными = Новый ТаблицаЗначений;
	ОбъектСДанными.Колонки.Добавить("Текст");
	ОбъектСДанными.Колонки.Добавить("Документ");
	ОбъектСДанными.Колонки.Добавить("Раздел");
	
	ПоказыватьРазделДозаполненныеДокументы = Ложь;
	Если Результат.ДозаполненныеДокументы.Количество() > 0 Тогда
		ПоказыватьРазделДозаполненныеДокументы = Истина;
		
		Для Каждого ДозаполненныйДокумент Из Результат.ДозаполненныеДокументы Цикл
			СтрокаТаблДокумента = ОбъектСДанными.Добавить();
			СтрокаТаблДокумента.Документ = ДозаполненныйДокумент;
			СтрокаТаблДокумента.Раздел = "ДозаполненныеДокументы";
		КонецЦикла;
	КонецЕсли;
	
	ПоказыватьРазделСозданныеДокументы = Ложь;
	Если Результат.СозданныеДокументы.Количество() > 0 Тогда
		ПоказыватьРазделСозданныеДокументы = Истина;
		
		Для Каждого СозданныйДокумент Из Результат.СозданныеДокументы Цикл
			СтрокаТаблДокумента = ОбъектСДанными.Добавить();
			СтрокаТаблДокумента.Документ = СозданныйДокумент;
			СтрокаТаблДокумента.Раздел = "СозданныеДокументы";
		КонецЦикла;
	КонецЕсли;
	
	ПоказыватьРазделОшибки = Ложь;
	Если Результат.Ошибки.Количество() > 0 Тогда
		ПоказыватьРазделОшибки = Истина;
		
		Для Каждого Ошибка Из Результат.Ошибки Цикл
			СтрокаТаблДокумента = ОбъектСДанными.Добавить();
			СтрокаТаблДокумента.Раздел = "Ошибки";
			Если ТипЗнч(Ошибка) = Тип("Структура") Тогда
				СтрокаТаблДокумента.Документ = Ошибка.Документ;
				СтрокаТаблДокумента.Текст = Ошибка.ТекстОшибки;
			Иначе
				СтрокаТаблДокумента.Текст = Строка(Ошибка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ОбъектСДанными", ОбъектСДанными);

	СхемаКомпоновкиДанных = ПолучитьОбщийМакет("асп_МакетУведомлений");
	
	НастройкиОсновногоВарианта = СхемаКомпоновкиДанных.ВариантыНастроек.Основной.Настройки.Структура;
	Если Не ПоказыватьРазделСозданныеДокументы Тогда
		НастройкиОсновногоВарианта[0].Использование = Ложь;
	КонецЕсли;
	Если Не ПоказыватьРазделДозаполненныеДокументы Тогда
		НастройкиОсновногоВарианта[1].Использование = Ложь;
	КонецЕсли;
	Если Не ПоказыватьРазделОшибки Тогда
		НастройкиОсновногоВарианта[2].Использование = Ложь;
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, СхемаКомпоновкиДанных.НастройкиПоУмолчанию);

	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных);

	ДокументРезультат = Новый ТабличныйДокумент;

	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ДокументРезультат.ТолькоПросмотр = Истина;
	ДокументРезультат.ОтображатьСетку = Ложь;
	ДокументРезультат.ОтображатьЗаголовки = Ложь;
		
	ВозвращаемыйРезультат.Вставить("Уведомления", ДокументРезультат);
	ВозвращаемыйРезультат.Вставить("ПоступлениеТоваровНаСклад", ПоступлениеТоваровНаСклад);
	
	ПоместитьВоВременноеХранилище(ВозвращаемыйРезультат, АдресРезультата);
	
КонецПроцедуры

Процедура ПроизвестиНакоплениеПоступившегоТовараВЗаказахНаПеремещение(ПоступлениеТоваровНаСклад, Результат)
	ЗаписьЖурналаРегистрации("Проверка склада по заказу на перемещение", УровеньЖурналаРегистрации.Примечание,, "Накопление начало", "Накопление начало");
	ЗафиксированнаяТекущаяДата = ТекущаяДатаСеанса();
	//проверим, надо ли обрабатывать
	
	ЗапросДляПроверкиНеобходимостиОбработки = Новый Запрос;
	ЗапросДляПроверкиНеобходимостиОбработки.УстановитьПараметр("СсылкаНаПТНС", ПоступлениеТоваровНаСклад);
	
	ЗапросДляПроверкиНеобходимостиОбработки.Текст =
		"ВЫБРАТЬ
		|	ЗаказНаПеремещение.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказНаПеремещение КАК ЗаказНаПеремещение
		|ГДЕ
		|	ЗаказНаПеремещение.ДокументОснование = &СсылкаНаПТНС
		|	И НЕ ЗаказНаПеремещение.ПометкаУдаления";
	Если Не ЗапросДляПроверкиНеобходимостиОбработки.Выполнить().Пустой() Тогда
		Результат.Ошибки.Добавить("УжеСозданНаОснованииЗаказНаПеремещение");
		
		//ASP_Hlopkov 21.10.2020+
		ЗаписьЖурналаРегистрации("Данные.Изменение", УровеньЖурналаРегистрации.Ошибка, Метаданные.Документы.ПриобретениеТоваровУслуг,, "Уже создан на основании заказ на перемещение" + Символы.ПС + ОписаниеОшибки()); 
		//ASP_Hlopkov 21.10.2020-
		ЗаписьЖурналаРегистрации("Проверка склада по заказу на перемещение", УровеньЖурналаРегистрации.Примечание,, "Есть заказы по ПТУ", "Есть заказы по ПТУ");
		Возврат; //обработка требовалась, и она уже была выполнена
	КонецЕсли;
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ЗапросДляПроверкиНеобходимостиОбработки.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ЗапросДляПроверкиНеобходимостиОбработки.Текст ="ВЫБРАТЬ
						|	ЗаказПоставщикуТовары.Ссылка КАК ЗаказПоставщику,
						|	ПоступлениеТоваровНаСкладТовары.Ссылка КАК ПоступлениеТоваровНаСклад,
						|	ПоступлениеТоваровНаСкладТовары.НомерСтроки КАК НомерСтроки,
						|	ПоступлениеТоваровНаСкладТовары.Номенклатура КАК Номенклатура,
						|	ПоступлениеТоваровНаСкладТовары.Характеристика КАК Характеристика,
						|	ПоступлениеТоваровНаСкладТовары.Ссылка.Склад КАК Склад,
						|	ВЫБОР
						|		КОГДА ПоступлениеТоваровНаСкладТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
						|				И ПоступлениеТоваровНаСкладТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ПоступлениеТоваровНаСкладТовары.Назначение.Заказ
						|		КОГДА ПоступлениеТоваровНаСкладТовары.ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
						|				И ПоступлениеТоваровНаСкладТовары.ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ПоступлениеТоваровНаСкладТовары.ЗаказКлиента
						|		КОГДА ЗаказПоставщикуТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
						|				И ЗаказПоставщикуТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ЗаказПоставщикуТовары.Назначение.Заказ
						|		КОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
						|				И ЗаказПоставщикуТовары.ASP_ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента
						|		ИНАЧЕ НЕОПРЕДЕЛЕНО
						|	КОНЕЦ КАК ЗаказКлиента,
						|	СУММА(ПоступлениеТоваровНаСкладТовары.Количество) КАК Количество
						|ПОМЕСТИТЬ ВТ_ДанныеПТУ
						|ИЗ
						|	Документ.ПоступлениеТоваровНаСклад.Товары КАК ПоступлениеТоваровНаСкладТовары
						|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЗаказПоставщику.Товары КАК ЗаказПоставщикуТовары
						|		ПО (ВЫБОР
						|				КОГДА ТИПЗНАЧЕНИЯ(ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение) = ТИП(Документ.ЗаказПоставщику)
						|					ТОГДА ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение = ЗаказПоставщикуТовары.Ссылка
						|				КОГДА ТИПЗНАЧЕНИЯ(ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение) = ТИП(Документ.ПриобретениеТоваровУслуг)
						|					ТОГДА ПоступлениеТоваровНаСкладТовары.Ссылка.Распоряжение.ЗаказПоставщику = ЗаказПоставщикуТовары.Ссылка
						|			КОНЕЦ)
						|			И (НЕ ЗаказПоставщикуТовары.Ссылка.ПометкаУдаления)
						|			И (НЕ ЗаказПоставщикуТовары.Отменено)
						|			И (ПоступлениеТоваровНаСкладТовары.Номенклатура = ЗаказПоставщикуТовары.Номенклатура)
						|			И (ПоступлениеТоваровНаСкладТовары.Характеристика = ЗаказПоставщикуТовары.Характеристика)
						|ГДЕ
						|	ПоступлениеТоваровНаСкладТовары.Ссылка = &СсылкаНаПТНС
						|	И ПоступлениеТоваровНаСкладТовары.Ссылка.Проведен
						|	И ПоступлениеТоваровНаСкладТовары.Номенклатура.ТипНоменклатуры В (ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Товар), ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.МногооборотнаяТара))
						|
						|СГРУППИРОВАТЬ ПО
						|	ЗаказПоставщикуТовары.Ссылка,
						|	ВЫБОР
						|		КОГДА ПоступлениеТоваровНаСкладТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
						|				И ПоступлениеТоваровНаСкладТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ПоступлениеТоваровНаСкладТовары.Назначение.Заказ
						|		КОГДА ПоступлениеТоваровНаСкладТовары.ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
						|				И ПоступлениеТоваровНаСкладТовары.ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ПоступлениеТоваровНаСкладТовары.ЗаказКлиента
						|		КОГДА ЗаказПоставщикуТовары.Назначение.Заказ ССЫЛКА Документ.ЗаказКлиента
						|				И ЗаказПоставщикуТовары.Назначение.Заказ <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ЗаказПоставщикуТовары.Назначение.Заказ
						|		КОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента ССЫЛКА Документ.ЗаказКлиента
						|				И ЗаказПоставщикуТовары.ASP_ЗаказКлиента <> ЗНАЧЕНИЕ(Документ.ЗаказКлиента.ПустаяСсылка)
						|			ТОГДА ЗаказПоставщикуТовары.ASP_ЗаказКлиента
						|		ИНАЧЕ НЕОПРЕДЕЛЕНО
						|	КОНЕЦ,
						|	ПоступлениеТоваровНаСкладТовары.Ссылка,
						|	ПоступлениеТоваровНаСкладТовары.Номенклатура,
						|	ПоступлениеТоваровНаСкладТовары.Характеристика,
						|	ПоступлениеТоваровНаСкладТовары.Ссылка.Склад,
						|	ПоступлениеТоваровНаСкладТовары.НомерСтроки
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ВТ_ДанныеПТУ.ЗаказПоставщику КАК ЗаказПоставщику,
						|	ВТ_ДанныеПТУ.Номенклатура КАК Номенклатура,
						|	ВТ_ДанныеПТУ.Характеристика КАК Характеристика,
						|	ВТ_ДанныеПТУ.ЗаказКлиента КАК ЗаказКлиента,
						|	ВТ_ДанныеПТУ.Склад КАК СкладОприходования,
						|	ВЫБОР
						|		КОГДА ЗаказКлиентаТовары.Склад = ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
						|			ТОГДА ЗаказКлиентаТовары.Ссылка.Склад
