////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки «Обнуление регистров» — исправленная версия.
// В форме: у поля регистра добавьте ПриИзменении = РегистрНакопленияПриИзменении.
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого ТекРег Из Метаданные.РегистрыНакопления Цикл
		Элементы.РегистрНакопления.СписокВыбора.Добавить(ТекРег.Имя);
	КонецЦикла;
	пКомментарий = "%Стандартная надпись%";
	ДелатьСторно = Истина;
	
	Если ЗначениеЗаполнено(РегистрНакопления) Тогда
		РегистрНакопленияОбработкаВыбораНаСервере(РегистрНакопления);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОновитьСписокПараметровЗапроса(Команда)
	ОновитьСписокПараметровЗапросаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Выполнить1(Команда)
	
	ТекстВопроса = СтрШаблон(
		"Будут записаны движения корректировки регистра ""%1"" на дату %2.
		|Остатки читаются и проверяются в правах текущего пользователя (RLS).
		|Продолжить?",
		РегистрНакопления,
		Формат(ДатаОбнуления, "ДЛФ=DT"));
	
	Оповещение = Новый ОписаниеОповещения("Выполнить1ПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура Выполнить1ПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ТестЗапроса(Команда)
	
	РезультатТеста = Неопределено;
	ВыполнитьНаСервере(Истина, РезультатТеста);
	Если РезультатТеста <> Неопределено Тогда
		РезультатТеста.Показать("Результат выполнения запроса");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НД(Команда)
	ДатаОбнуления = НачалоДня(ДатаОбнуления);
КонецПроцедуры

&НаКлиенте
Процедура КД(Команда)
	ДатаОбнуления = КонецДня(ДатаОбнуления);
КонецПроцедуры

&НаКлиенте
Процедура КонсольЗапросов(Команда)
	
	Текст = ПолеТекстЗапроса.ПолучитьТекст();
	Если ЗначениеЗаполнено(Текст) Тогда
		Конструктор = Новый КонструкторЗапроса(Текст);
	Иначе
		Конструктор = Новый КонструкторЗапроса();
	КонецЕсли;
	
	Конструктор.Показать(Новый ОписаниеОповещения("ОЗ_КонструкторЗапроса", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ОЗ_КонструкторЗапроса(Текст, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Текст) Тогда
		ПолеТекстЗапроса.УстановитьТекст(Текст);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура РегистрНакопленияПриИзменении(Элемент)
	РегистрНакопленияОбработкаВыбораНаСервере(РегистрНакопления);
КонецПроцедуры

&НаКлиенте
Процедура РегистрНакопленияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	РегистрНакопленияОбработкаВыбораНаСервере(ВыбранноеЗначение);
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЭтоВыражениеПриИзменении(Элемент)
	
	ТекДанные = Элементы.ПараметрыТЗ2.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ЭтоВыражение Тогда
		Если ТипЗнч(ТекДанные.ЗначениеПараметра) <> Тип("Строка") Тогда
			ТекДанные.ЗначениеПараметра = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	// колонка «выбирать тип» управляется свойством ЭтоВыражение на форме
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОновитьСписокПараметровЗапросаНаСервере()
	
	ТекстЗапроса = ПолеТекстЗапроса.ПолучитьТекст();
	
	Если ПустаяСтрока(ТекстЗапроса) Тогда
		Сообщить("Отсутствует текст запроса.");
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Попытка
		ПараметрыЗапроса = Запрос.НайтиПараметры();
	Исключение
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	
	ИменаИзЗапроса = Новый Соответствие;
	
	Для Каждого ПараметрЗапроса Из ПараметрыЗапроса Цикл
		
		ИмяПараметра = ПараметрЗапроса.Имя;
		ИменаИзЗапроса.Вставить(ИмяПараметра, Истина);
		
		Если ИмяПараметра = "Период" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПараметров = ПараметрыТЗ2.НайтиСтроки(Новый Структура("ИмяПараметра", ИмяПараметра));
		Если СтрокаПараметров.Количество() = 0 Тогда
			СтрокаПараметров = ПараметрыТЗ2.Добавить();
			СтрокаПараметров.ИмяПараметра = ИмяПараметра;
			СтрокаПараметров.ЗначениеПараметра = ПараметрЗапроса.ТипЗначения.ПривестиЗначение(СтрокаПараметров.ЗначениеПараметра);
		КонецЕсли;
		
	КонецЦикла;
	
	Индекс = ПараметрыТЗ2.Количество();
	Пока Индекс > 0 Цикл
		Индекс = Индекс - 1;
		Если ИменаИзЗапроса.Получить(ПараметрыТЗ2[Индекс].ИмяПараметра) = Неопределено Тогда
			ПараметрыТЗ2.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНаСервере(Тест = Ложь, РезультатТеста = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(РегистрНакопления) ИЛИ НЕ ЗначениеЗаполнено(ДатаОбнуления) Тогда
		Сообщить("Не все необходимые настройки выполнены!");
		Возврат;
	КонецЕсли;
	
	Если НЕ Тест И НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
		Сообщить("Не все необходимые настройки выполнены!");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьСпискиИзмеренийИРесурсов(РегистрНакопления);
	
	Если Метаданные.РегистрыНакопления[РегистрНакопления].ВидРегистра
		= Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		ОбнулитьРегистрОстатков(Тест, РезультатТеста);
	Иначе
		ОбнулитьРегистрОборотов(Тест, РезультатТеста);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РегистрНакопленияОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Элементы.ИнформацияОРегистре.Заголовок = "Информация о регистре:";
		ПолеТекстЗапроса.Очистить();
		ПараметрыТЗ2.Очистить();
		СпИзмерений.Очистить();
		СпРесурсов.Очистить();
		Возврат;
	КонецЕсли;
	
	Текст = "Информация о регистре: " + Символы.ПС
		+ "Синоним: " + Метаданные.РегистрыНакопления[ВыбранноеЗначение].Синоним + Символы.ПС
		+ "Вид: " + Метаданные.РегистрыНакопления[ВыбранноеЗначение].ВидРегистра + Символы.ПС
		+ "Измерения: ";
	
	Первый = Истина;
	СпИзмеренийСтр = "";
	Для Каждого ТекИзм Из Метаданные.РегистрыНакопления[ВыбранноеЗначение].Измерения Цикл
		Если Первый Тогда
			Первый = Ложь;
			СпИзмеренийСтр = ТекИзм.Имя;
		Иначе
			СпИзмеренийСтр = СпИзмеренийСтр + ", " + ТекИзм.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Текст = Текст + СпИзмеренийСтр + Символы.ПС + "Ресурсы: ";
	
	Первый = Истина;
	СпРесурсовСтр = "";
	Для Каждого ТекРес Из Метаданные.РегистрыНакопления[ВыбранноеЗначение].Ресурсы Цикл
		Если Первый Тогда
			Первый = Ложь;
			СпРесурсовСтр = ТекРес.Имя;
		Иначе
			СпРесурсовСтр = СпРесурсовСтр + ", " + ТекРес.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Текст = Текст + СпРесурсовСтр;
	Элементы.ИнформацияОРегистре.Заголовок = Текст;
	
	ЗаполнитьСпискиИзмеренийИРесурсов(ВыбранноеЗначение);
	ПолеТекстЗапроса.УстановитьТекст(ПолучитьТекстЗапроса(ВыбранноеЗначение));
	
	Элементы.ДелатьСторно.Доступность =
		(Метаданные.РегистрыНакопления[ВыбранноеЗначение].ВидРегистра
		= Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки);
	
КонецПроцедуры

&НаСервере
Функция ВернутьТабДокИзТЗ(тз)
	
	ТабДок = Новый ТабличныйДокумент;
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(тз);
	Построитель.Вывести(ТабДок);
	
	Возврат ТабДок;
	
КонецФункции

&НаСервере
Процедура ОбнулитьРегистрОстатков(Тест = Ложь, РезультатТеста = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолеТекстЗапроса.ПолучитьТекст();
	Запрос.УстановитьПараметр("Период", ГраницаОбнуления());
	УстановитьПараметры(Запрос);
	
	РезЗап = Запрос.Выполнить();
	
	Если Тест Тогда
		РезультатТеста = ВернутьТабДокИзТЗ(РезЗап.Выгрузить());
		Возврат;
	КонецЕсли;
	
	Если РезЗап.Пустой() Тогда
		Сообщить("Нет ненулевых остатков для обнуления.");
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ДокКор = СоздатьДокументКорректировки();
		
		Выборка = РезЗап.Выбрать();
		Пока Выборка.Следующий() Цикл
			ДобавитьДвиженияОстатков(ДокКор, Выборка);
		КонецЦикла;
		
		ДокКор.Движения[РегистрНакопления].Записывать = Истина;
		ДокКор.Движения[РегистрНакопления].Записать();
		ДокКор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Сообщить("Не удалось создать корректировку" + Символы.ПС
			+ "Причина: " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
		
	КонецПопытки;
	
	Сообщить("Записан документ " + ДокКор.Ссылка);
	Сообщить("Проверка остатков выполняется в правах текущего пользователя (RLS).");
	
	ОсталосьСтрок = КоличествоНенулевыхОстатковРегистра(РегистрНакопления);
	Если ОсталосьСтрок > 0 Тогда
		Сообщить("ВНИМАНИЕ: после обнуления регистра """ + РегистрНакопления
			+ """ осталось строк: " + ОсталосьСтрок, СтатусСообщения.Важное);
	Иначе
		Сообщить("Регистр """ + РегистрНакопления + """ обнулён полностью (в пределах видимых остатков).");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбнулитьРегистрОборотов(Тест = Ложь, РезультатТеста = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ПолеТекстЗапроса.ПолучитьТекст();
	Запрос.УстановитьПараметр("Период", ДатаОбнуления);
	УстановитьПараметры(Запрос);
	
	РезЗап = Запрос.Выполнить();
	
	Если Тест Тогда
		РезультатТеста = ВернутьТабДокИзТЗ(РезЗап.Выгрузить());
		Возврат;
	КонецЕсли;
	
	Если РезЗап.Пустой() Тогда
		Сообщить("Нет оборотов для сторнирования.");
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ДокКор = СоздатьДокументКорректировки();
		
		Выборка = РезЗап.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			НовЗап = ДокКор.Движения[РегистрНакопления].Добавить();
			НовЗап.Регистратор = ДокКор.Ссылка;
			НовЗап.Период = ДокКор.Дата;
			
			Для Каждого ТекИзм Из СпИзмерений Цикл
				Попытка
					НовЗап[ТекИзм.Значение] = Выборка[ТекИзм.Значение];
				Исключение
					Сообщить("Измерение """ + ТекИзм.Значение + """ не найдено", СтатусСообщения.Информация);
				КонецПопытки;
			КонецЦикла;
			
			Для Каждого ТекРес Из СпРесурсов Цикл
				Попытка
					НовЗап[ТекРес.Значение] = Выборка[ТекРес.Значение + "Оборот"] * (-1);
				Исключение
					Сообщить("Ресурс """ + ТекРес.Значение + """ не найден", СтатусСообщения.Информация);
				КонецПопытки;
			КонецЦикла;
			
		КонецЦикла;
		
		ДокКор.Движения[РегистрНакопления].Записывать = Истина;
		ДокКор.Движения[РегистрНакопления].Записать();
		ДокКор.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		Сообщить("Не удалось создать корректировку" + Символы.ПС
			+ "Причина: " + ОписаниеОшибки(), СтатусСообщения.Важное);
		Возврат;
		
	КонецПопытки;
	
	Сообщить("Записан документ " + ДокКор.Ссылка);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапроса(пРегистрНакопления)
	
	Если Метаданные.РегистрыНакопления[пРегистрНакопления].ВидРегистра
		= Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
		Возврат ПолучитьТекстЗапросаДляРегистраОстатков(пРегистрНакопления);
	Иначе
		Возврат ПолучитьТекстЗапросаДляРегистраОборотов(пРегистрНакопления);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаДляРегистраОстатков(пРегистрНакопления)
	
	ЗапросТекст =
	"ВЫБРАТЬ %СписокИзмеренийИРесурсов%
	|ИЗ
	|	РегистрНакопления.%ИмяРегистра%.Остатки(&Период, ) КАК Остатки
	|ГДЕ
	|	%УсловиеНенулевых%";
	
	Первый = Истина;
	СписокИзмеренийИРесурсов = "";
	
	Для Каждого ТекИзм Из Метаданные.РегистрыНакопления[пРегистрНакопления].Измерения Цикл
		Если Первый Тогда
			Первый = Ложь;
			СписокИзмеренийИРесурсов = "Остатки." + ТекИзм.Имя;
		Иначе
			СписокИзмеренийИРесурсов = СписокИзмеренийИРесурсов + ", Остатки." + ТекИзм.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекРес Из Метаданные.РегистрыНакопления[пРегистрНакопления].Ресурсы Цикл
		Если ПустаяСтрока(СписокИзмеренийИРесурсов) Тогда
			СписокИзмеренийИРесурсов = "Остатки." + ТекРес.Имя + "Остаток";
		Иначе
			СписокИзмеренийИРесурсов = СписокИзмеренийИРесурсов + ", Остатки." + ТекРес.Имя + "Остаток";
		КонецЕсли;
	КонецЦикла;
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "%СписокИзмеренийИРесурсов%", СписокИзмеренийИРесурсов);
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "%ИмяРегистра%", пРегистрНакопления);
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "%УсловиеНенулевых%", УсловиеНенулевыхОстатковРегистра(пРегистрНакопления));
	
	Возврат ЗапросТекст;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстЗапросаДляРегистраОборотов(пРегистрНакопления)
	
	ЗапросТекст =
	"ВЫБРАТЬ %СписокИзмеренийИРесурсов%
	|ИЗ
	|	РегистрНакопления.%ИмяРегистра%.Обороты(, &Период)
	|ГДЕ
	|	%УсловиеНенулевых%";
	
	Первый = Истина;
	СписокИзмеренийИРесурсов = "";
	
	Для Каждого ТекИзм Из Метаданные.РегистрыНакопления[пРегистрНакопления].Измерения Цикл
		Если Первый Тогда
			Первый = Ложь;
			СписокИзмеренийИРесурсов = ТекИзм.Имя;
		Иначе
			СписокИзмеренийИРесурсов = СписокИзмеренийИРесурсов + ", " + ТекИзм.Имя;
		КонецЕсли;
	КонецЦикла;
	
	ПервыйРесурс = Истина;
	Для Каждого ТекРес Из Метаданные.РегистрыНакопления[пРегистрНакопления].Ресурсы Цикл
		Если ПустаяСтрока(СписокИзмеренийИРесурсов) И ПервыйРесурс Тогда
			СписокИзмеренийИРесурсов = ТекРес.Имя + "Оборот";
		Иначе
			СписокИзмеренийИРесурсов = СписокИзмеренийИРесурсов + ", " + ТекРес.Имя + "Оборот";
		КонецЕсли;
		ПервыйРесурс = Ложь;
	КонецЦикла;
	
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "%СписокИзмеренийИРесурсов%", СписокИзмеренийИРесурсов);
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "%ИмяРегистра%", пРегистрНакопления);
	ЗапросТекст = СтрЗаменить(ЗапросТекст, "%УсловиеНенулевых%", УсловиеНенулевыхОборотовРегистра(пРегистрНакопления));
	
	Возврат ЗапросТекст;
	
КонецФункции

&НаСервере
Процедура УстановитьПараметры(Запрос)
	
	Для Каждого ТекПарам Из ПараметрыТЗ2 Цикл
		Запрос.УстановитьПараметр(ТекПарам.ИмяПараметра, ТекПарам.ЗначениеПараметра);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция УсловиеНенулевыхОстатковРегистра(пРегистрНакопления)
	
	УсловиеНенулевых = "";
	
	Для Каждого ТекРес Из Метаданные.РегистрыНакопления[пРегистрНакопления].Ресурсы Цикл
		Если ПустаяСтрока(УсловиеНенулевых) Тогда
			УсловиеНенулевых = "Остатки." + ТекРес.Имя + "Остаток <> 0";
		Иначе
			УсловиеНенулевых = УсловиеНенулевых + "
			|	ИЛИ Остатки." + ТекРес.Имя + "Остаток <> 0";
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(УсловиеНенулевых) Тогда
		УсловиеНенулевых = "ЛОЖЬ";
	КонецЕсли;
	
	Возврат УсловиеНенулевых;
	
КонецФункции

&НаСервере
Функция УсловиеНенулевыхОборотовРегистра(пРегистрНакопления)
	
	УсловиеНенулевых = "";
	
	Для Каждого ТекРес Из Метаданные.РегистрыНакопления[пРегистрНакопления].Ресурсы Цикл
		Если ПустаяСтрока(УсловиеНенулевых) Тогда
			УсловиеНенулевых = ТекРес.Имя + "Оборот <> 0";
		Иначе
			УсловиеНенулевых = УсловиеНенулевых + "
			|	ИЛИ " + ТекРес.Имя + "Оборот <> 0";
		КонецЕсли;
	КонецЦикла;
	
	Если ПустаяСтрока(УсловиеНенулевых) Тогда
		УсловиеНенулевых = "ЛОЖЬ";
	КонецЕсли;
	
	Возврат УсловиеНенулевых;
	
КонецФункции

&НаСервере
Функция КоличествоНенулевыхОстатковРегистра(пРегистрНакопления)
	
	УсловиеНенулевых = УсловиеНенулевыхОстатковРегистра(пРегистрНакопления);
	
	ЗапросПроверки = Новый Запрос;
	ЗапросПроверки.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Строк
	|ИЗ
	|	РегистрНакопления." + пРегистрНакопления + ".Остатки(&Период, ) КАК Остатки
	|ГДЕ
	|	" + УсловиеНенулевых;
	
	// После записи движения на ДатаОбнуления должны попасть в остаток.
	ЗапросПроверки.УстановитьПараметр("Период", Новый Граница(ДатаОбнуления, ВидГраницы.Включая));
	УстановитьПараметры(ЗапросПроверки);
	
	Возврат ЗапросПроверки.Выполнить().Выгрузить()[0].Строк;
	
КонецФункции

&НаСервере
Функция ГраницаОбнуления()
	
	Вид = ?(ВключаяДатуОбнуления = 0, ВидГраницы.Включая, ВидГраницы.Исключая);
	Возврат Новый Граница(ДатаОбнуления, Вид);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСпискиИзмеренийИРесурсов(пРегистрНакопления)
	
	СпИзмерений.Очистить();
	СпРесурсов.Очистить();
	
	Для Каждого ТекИзм Из Метаданные.РегистрыНакопления[пРегистрНакопления].Измерения Цикл
		СпИзмерений.Добавить(ТекИзм.Имя);
	КонецЦикла;
	
	Для Каждого ТекРес Из Метаданные.РегистрыНакопления[пРегистрНакопления].Ресурсы Цикл
		СпРесурсов.Добавить(ТекРес.Имя);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СоздатьДокументКорректировки()
	
	ДокКор = Документы[ВидДокумента].СоздатьДокумент();
	ДокКор.Дата = ДатаОбнуления;
	
	Если ВидДокумента = "ОперацияБух" Тогда
		НовСтр = ДокКор.ТаблицаРегистровНакопления.Добавить();
	Иначе
		НовСтр = ДокКор.ТаблицаРегистров.Добавить();
	КонецЕсли;
	НовСтр.Имя = Метаданные.РегистрыНакопления[РегистрНакопления].Имя;
	
	ДокКор.Комментарий = СтрЗаменить(пКомментарий, "%Стандартная надпись%",
		"Обнуление регистра """ + Метаданные.РегистрыНакопления[РегистрНакопления].Имя + """");
	
	Попытка
		ДокКор.Ответственный = Пользователи.ТекущийПользователь();
	Исключение
		// реквизит или БСП могут отсутствовать
	КонецПопытки;
	
	Если Метаданные.ОбщиеМодули.Найти("ДатыЗапретаИзменения") <> Неопределено Тогда
		Если ДатыЗапретаИзменения.ИзменениеЗапрещено(ДокКор) Тогда
			ВызватьИсключение "Изменение на указанную дату запрещено (дата запрета изменения).";
		КонецЕсли;
	КонецЕсли;
	
	ДокКор.Записать();
	Возврат ДокКор;
	
КонецФункции

&НаСервере
Процедура ДобавитьДвиженияОстатков(ДокКор, Выборка)
	
	ЗначенияИзмерений = Новый Структура;
	Для Каждого ТекИзм Из СпИзмерений Цикл
		ЗначенияИзмерений.Вставить(ТекИзм.Значение, Выборка[ТекИзм.Значение]);
	КонецЦикла;
	
	Если НЕ ДелатьСторно Тогда
		НовЗап = ДобавитьЗаписьОстатка(ДокКор, ЗначенияИзмерений, ВидДвиженияНакопления.Расход);
		Для Каждого ТекРес Из СпРесурсов Цикл
			НовЗап[ТекРес.Значение] = Выборка[ТекРес.Значение + "Остаток"];
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	ЕстьПлюс = Ложь;
	ЕстьМинус = Ложь;
	Для Каждого ТекРес Из СпРесурсов Цикл
		ОстатокРесурса = Выборка[ТекРес.Значение + "Остаток"];
		Если ОстатокРесурса > 0 Тогда
			ЕстьПлюс = Истина;
		ИначеЕсли ОстатокРесурса < 0 Тогда
			ЕстьМинус = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьПлюс Тогда
		НовЗап = ДобавитьЗаписьОстатка(ДокКор, ЗначенияИзмерений, ВидДвиженияНакопления.Расход);
		Для Каждого ТекРес Из СпРесурсов Цикл
			ОстатокРесурса = Выборка[ТекРес.Значение + "Остаток"];
			Если ОстатокРесурса > 0 Тогда
				НовЗап[ТекРес.Значение] = ОстатокРесурса;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьМинус Тогда
		НовЗап = ДобавитьЗаписьОстатка(ДокКор, ЗначенияИзмерений, ВидДвиженияНакопления.Приход);
		Для Каждого ТекРес Из СпРесурсов Цикл
			ОстатокРесурса = Выборка[ТекРес.Значение + "Остаток"];
			Если ОстатокРесурса < 0 Тогда
				НовЗап[ТекРес.Значение] = -ОстатокРесурса;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьЗаписьОстатка(ДокКор, ЗначенияИзмерений, ВидДвижения)
	
	НовЗап = ДокКор.Движения[РегистрНакопления].Добавить();
	НовЗап.Регистратор = ДокКор.Ссылка;
	НовЗап.Период = ДокКор.Дата;
	НовЗап.ВидДвижения = ВидДвижения;
	
	Для Каждого КлючИЗначение Из ЗначенияИзмерений Цикл
		НовЗап[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	КонецЦикла;
	
	Возврат НовЗап;
	
КонецФункции

#КонецОбласти
