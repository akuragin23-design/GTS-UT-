	Запрос.УстановитьПараметр("Наименование", НаименованиеБП);
	Запрос.УстановитьПараметр("Номер", НомерБП);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Договоры.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК Договоры
	|ГДЕ
	|	Договоры.Контрагент = &Контрагент
	|	И Договоры.Организация = &Организация
	|	И Договоры.ПометкаУдаления = ЛОЖЬ
	|	И (
	|		Договоры.Наименование = &Наименование
	|		ИЛИ (&Номер <> """" И Договоры.Номер = &Номер)
	|	)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ДатаДоговораИзНаименованияБП(НаименованиеБП)
	
	Поз = СтрНайти(ВРег(НаименованиеБП), " ОТ ");
	Если Поз = 0 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Хвост = СокрЛП(Сред(НаименованиеБП, Поз + 4));
	Если СтрДлина(Хвост) >= 10 Тогда
		Попытка
			Возврат Дата(Число(Сред(Хвост, 7, 4)), Число(Сред(Хвост, 4, 2)), Число(Лев(Хвост, 2)));
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат Дата(1, 1, 1);
	
КонецФункции

&НаСервере
Функция СоздатьДоговорПоДаннымБП(Контрагент, Организация, НаименованиеБП, НомерБП, Счет, Валюта)
	
	НовыйДоговор = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
	НовыйДоговор.Наименование = НаименованиеБП;
	Если ЗначениеЗаполнено(НомерБП) Тогда
		НовыйДоговор.Номер = НомерБП;
	КонецЕсли;
	
	ДатаДог = ДатаДоговораИзНаименованияБП(НаименованиеБП);
	Если ЗначениеЗаполнено(ДатаДог) Тогда
		НовыйДоговор.Дата = ДатаДог;
	Иначе
		НовыйДоговор.Дата = НачалоДня(Дата) - 86400;
	КонецЕсли;
	
	НовыйДоговор.Контрагент = Контрагент;
	НовыйДоговор.Партнер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "Партнер");
	НовыйДоговор.Организация = Организация;
	НовыйДоговор.ВалютаВзаиморасчетов = Валюта;
	НовыйДоговор.Комментарий = "000031404 автосоздание из БП";
	
	Попытка
		НовыйДоговор.Статус = Перечисления.СтатусыДоговоровКонтрагентов.Действует;
	Исключение
	КонецПопытки;
	
	ВалютаРегл = ВалютаРеглУчета();
	
	Если Счет = 62 Тогда
		НовыйДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем;
	ИначеЕсли ЗначениеЗаполнено(Валюта) И ЗначениеЗаполнено(ВалютаРегл) И Валюта <> ВалютаРегл Тогда
		НовыйДоговор.ТипДоговора = Перечисления.ТипыДоговоров.Импорт;
	Иначе
		НовыйДоговор.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком;
	КонецЕсли;
	
	ЗаполнитьРеквизитыДоговораПослеТипа(НовыйДоговор);
	
	НовыйДоговор.Записать();
	Сообщить("Создан договор: " + НовыйДоговор + " (" + НаименованиеБП + ")");
	Возврат НовыйДоговор.Ссылка;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРеквизитыДоговораПослеТипа(ОбъектДоговор)
	
	Попытка
		ОбъектДоговор.ХозяйственнаяОперация = Справочники.ДоговорыКонтрагентов.ХозяйственнаяОперация(
			ОбъектДоговор.ТипДоговора, ОбъектДоговор.ВариантОформленияЗакупок);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбъектДоговор.ПорядокРасчетов = Перечисления.ПорядокРасчетов.ПоДоговорамКонтрагентов;
	Исключение
	КонецПопытки;
	
	Попытка
		ЗаполнениеОбъектовПоСтатистике.ЗаполнитьПодчиненныеРеквизитыОбъекта(ОбъектДоговор, "ТипДоговора");
	Исключение
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПодобратьИлиСоздатьДоговорУТ(Контрагент, Организация, НаименованиеБП, НомерБП, УидДоговораБП, Счет, Валюта, СоздаватьЕслиНет)
	
	Результат = Новый Структура("Договор, Статус",
		Справочники.ДоговорыКонтрагентов.ПустаяСсылка(), "НеНайден");
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Или НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат Результат;
	КонецЕсли;
	
	КандидатыПоСоответствию = НайтиКандидатовДоговораПоСоответствиюБП(УидДоговораБП, НаименованиеБП);
	Если КандидатыПоСоответствию.Количество() > 0 Тогда
		Договор = ВыбратьДоговорИзКандидатов(КандидатыПоСоответствию, Счет, Валюта, НаименованиеБП, НомерБП);
		Если ЗначениеЗаполнено(Договор) Тогда
			Результат.Договор = Договор;
			Результат.Статус = "Найден";
			Возврат Результат;
		ИначеЕсли КандидатыПоСоответствию.Количество() > 1 Тогда
			Результат.Статус = "Неоднозначно";
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Кандидаты = НайтиКандидатовДоговора(Контрагент, Организация, НаименованиеБП, НомерБП);
	Договор = ВыбратьДоговорИзКандидатов(Кандидаты, Счет, Валюта, НаименованиеБП, НомерБП);
	Если ЗначениеЗаполнено(Договор) Тогда
		Результат.Договор = Договор;
		Результат.Статус = "Найден";
		Возврат Результат;
	КонецЕсли;
	Если Кандидаты.Количество() >= 1 Тогда
		Результат.Статус = "Неоднозначно";
		Возврат Результат;
	КонецЕсли;
	
	КандидатыШироко = НайтиКандидатовДоговораПоКонтрагентуИТипу(Контрагент, Организация, Счет, Валюта);
	Договор = ВыбратьДоговорИзКандидатов(КандидатыШироко, Счет, Валюта, НаименованиеБП, НомерБП);
	Если ЗначениеЗаполнено(Договор) Тогда
		Результат.Договор = Договор;
		Результат.Статус = "Найден";
		Возврат Результат;
	КонецЕсли;
	Если КандидатыШироко.Количество() >= 1 Тогда
		Результат.Статус = "Неоднозначно";
		Возврат Результат;
	КонецЕсли;
	
	Если СоздаватьЕслиНет Тогда
		Попытка
			Результат.Договор = СоздатьДоговорПоДаннымБП(
				Контрагент, Организация, НаименованиеБП, НомерБП, Счет, Валюта);
			Результат.Статус = "Найден";
		Исключение
			Сообщить("Не удалось создать договор """ + НаименованиеБП + """: " + ОписаниеОшибки());
			Результат.Статус = "НеНайден";
		КонецПопытки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОтобратьКандидатовПоРеквизиту(ТаблицаКандидатов, ИмяРеквизита, Значение)
	
	Результат = ТаблицаКандидатов.Скопировать();
	Результат.Очистить();
	
	Для Каждого Стр Из ТаблицаКандидатов Цикл
		Рекв = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Ссылка, ИмяРеквизита);
		Если Рекв = Значение Тогда
			НовСтр = Результат.Добавить();
			НовСтр.Ссылка = Стр.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОтфильтроватьКандидатовДоговораБезУдаленногоКонтрагента(ТаблицаКандидатов)
	
	Результат = ТаблицаКандидатов.Скопировать();
	Результат.Очистить();
	
	Для Каждого Стр Из ТаблицаКандидатов Цикл
		КонтрагентДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Стр.Ссылка, "Контрагент");
		Если ЗначениеЗаполнено(КонтрагентДоговора)
			И НЕ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КонтрагентДоговора, "ПометкаУдаления") Тогда
			НовСтр = Результат.Добавить();
			НовСтр.Ссылка = Стр.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НайтиКонтрагентаУТ(УидБП, ИНН, КПП, НаименованиеБП)
	
	Если ЗначениеЗаполнено(УидБП) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(Соответствия.УникальныйИдентификаторИсточника КАК Справочник.Контрагенты) КАК Ссылка
		|ИЗ
		|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствия
		|ГДЕ
		|	Соответствия.УникальныйИдентификаторПриемника = &Уид
		|	И Соответствия.УникальныйИдентификаторИсточника ССЫЛКА Справочник.Контрагенты
		|	И ВЫРАЗИТЬ(Соответствия.УникальныйИдентификаторИсточника КАК Справочник.Контрагенты).ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Уид", Строка(УидБП));
		
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() = 1 Тогда
			Возврат Таблица[0].Ссылка;
		ИначеЕсли Таблица.Количество() > 1 Тогда
			Сообщить("Неоднозначное соответствие контрагента в регистре обмена: " + НаименованиеБП);
			Возврат Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ПометкаУдаления = ЛОЖЬ
		|	И Контрагенты.ИНН = &ИНН
		|	И Контрагенты.КПП = &КПП
		|	И (&ПоНаименованию = ЛОЖЬ ИЛИ Контрагенты.Наименование = &Наименование)";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Запрос.УстановитьПараметр("Наименование", НаименованиеБП);
		Запрос.УстановитьПараметр("ПоНаименованию", ЗначениеЗаполнено(НаименованиеБП));
		
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() = 1 Тогда
			Возврат Таблица[0].Ссылка;
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ПоНаименованию", Ложь);
		Таблица = Запрос.Выполнить().Выгрузить();
		Если Таблица.Количество() = 1 Тогда
			Возврат Таблица[0].Ссылка;
		ИначеЕсли Таблица.Количество() > 1 Тогда
			Сообщить("Найдено несколько контрагентов по ИНН/КПП: " + НаименованиеБП);
			Возврат Справочники.Контрагенты.ПустаяСсылка();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция НайтиОрганизациюУТ(НаименованиеБП)
	
	Если НЕ ЗначениеЗаполнено(НаименованиеБП) Тогда
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ
	|	И Организации.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование", НаименованиеБП);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 1 Тогда
		Возврат Таблица[0].Ссылка;
	ИначеЕсли Таблица.Количество() > 1 Тогда
		Сообщить("Найдено несколько организаций с наименованием: " + НаименованиеБП);
		Возврат Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Справочники.Организации.НайтиПоНаименованию(НаименованиеБП, Истина);
	
КонецФункции

#КонецОбласти

#Область ВыгрузкаИзБП

&НаСервере
Процедура ВыполнитькорректировкуВзаиморасчетовНаСервере(ВыгрузитьСчет60, ВыгрузитьСчет62, ПарольБП)
	
	ПроверитьДатуПерехода();
	Если НЕ ВыгрузитьСчет60 И НЕ ВыгрузитьСчет62 Тогда
		ВызватьИсключение "Включите выгрузку счета 60 и/или 62.";
	КонецЕсли;
	
	Соединение = ПодключитьсяКбазе(ПарольБП);
	Если ТипЗнч(Соединение) = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросБПЗО = Соединение.NewObject("Запрос");
	ЗапросБПЗО.Текст =
	"ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстаток, 0)) КАК СуммаОстаток,
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстатокДт, 0)) КАК СуммаОстатокДт,
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.СуммаОстатокКт, 0)) КАК СуммаОстатокКт,
	|	ХозрасчетныйОстатки.Субконто1.Наименование КАК Контрагент,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто1.Ссылка) КАК КонтрагентСсылка,
	|	ХозрасчетныйОстатки.Субконто2.Наименование КАК Договор,
	|	ХозрасчетныйОстатки.Субконто2.Номер КАК ДоговорНомер,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто2.Ссылка) КАК ДоговорСсылка,
	|	ВЫБОР
	|		КОГДА ХозрасчетныйОстатки.Счет.Код ПОДОБНО ""62%""
	|			ТОГДА 62
	|		ИНАЧЕ 60
	|	КОНЕЦ КАК Счет,
	|	ЕСТЬNULL(ХозрасчетныйОстатки.Валюта.Наименование, ""Руб"") КАК Валюта,
	|	ХозрасчетныйОстатки.Организация.Наименование КАК Организация,
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.ВалютнаяСуммаОстаток, 0)) КАК ВалютнаяСуммаОстаток,
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.ВалютнаяСуммаОстатокДт, 0)) КАК ВалютнаяСуммаОстатокДт,
	|	СУММА(ЕСТЬNULL(ХозрасчетныйОстатки.ВалютнаяСуммаОстатокКт, 0)) КАК ВалютнаяСуммаОстатокКт,
	|	ХозрасчетныйОстатки.Субконто1.ИНН КАК КонтрагентИНН,
	|	ХозрасчетныйОстатки.Субконто1.КПП КАК КонтрагентКПП
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.Остатки(&дата, Счет В (&Счет), , ) КАК ХозрасчетныйОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ХозрасчетныйОстатки.Субконто1.Наименование,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто1.Ссылка),
	|	ХозрасчетныйОстатки.Субконто2.Наименование,
	|	ХозрасчетныйОстатки.Субконто2.Номер,
	|	ВЫБОР
	|		КОГДА ХозрасчетныйОстатки.Счет.Код ПОДОБНО ""62%""
	|			ТОГДА 62
	|		ИНАЧЕ 60
	|	КОНЕЦ,
	|	ХозрасчетныйОстатки.Организация.Наименование,
	|	ЕСТЬNULL(ХозрасчетныйОстатки.Валюта.Наименование, ""Руб""),
	|	ХозрасчетныйОстатки.Субконто1.ИНН,
	|	ХозрасчетныйОстатки.Субконто1.КПП,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ХозрасчетныйОстатки.Субконто2.Ссылка)";
	
	ЗапросБПЗО.УстановитьПараметр("Дата", НачалоДня(Дата));
	
	МассивСчетов = Соединение.NewObject("Массив");
	ДобавитьСчетБПЕслиНайден(Соединение, МассивСчетов, ВыгрузитьСчет60, "60.01,60.02,60.03,60.21,60.22,60.31,60.32");
	ДобавитьСчетБПЕслиНайден(Соединение, МассивСчетов, ВыгрузитьСчет62, "62.01,62.02,62.03,62.21,62.22,62.31,62.32");
	
	Если МассивСчетов.Количество() = 0 Тогда
		ВызватьИсключение "В БП не найдены выбранные счета 60/62.";
	КонецЕсли;
	
	ЗапросБПЗО.УстановитьПараметр("Счет", МассивСчетов);
	
	ТЗОстатки = Новый ТаблицаЗначений;
	ТЗОстатки.Колонки.Добавить("Счет", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТЗОстатки.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	ТЗОстатки.Колонки.Добавить("ДоговорВБП", Новый ОписаниеТипов("Строка"));
	ТЗОстатки.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТЗОстатки.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТЗОстатки.Колонки.Добавить("Остаток", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ОстатокДт", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ОстатокКт", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ВалютныйОстаток", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ВалютныйОстатокДт", Новый ОписаниеТипов("Число"));
	ТЗОстатки.Колонки.Добавить("ВалютныйОстатокКт", Новый ОписаниеТипов("Число"));
	
	Выборка = Соединение.ЗначениеВСтрокуВнутр(ЗапросБПЗО.Выполнить().Выгрузить());
	Выборка = ЗначениеИзСтрокиВнутр(Выборка);
	
	Для Каждого СтрокаCOM Из Выборка Цикл
		
		НоваяСтрока = ТЗОстатки.Добавить();
		НоваяСтрока.Счет = СтрокаCOM.Счет;
		НоваяСтрока.Контрагент = НайтиКонтрагентаУТ(
			СтрокаCOM.КонтрагентСсылка, СтрокаCOM.КонтрагентИНН, СтрокаCOM.КонтрагентКПП, СтрокаCOM.Контрагент);
		
		ВалютаСтроки = НайтиВалютуПоДаннымБП(СтрокаCOM.Валюта);
		ОрганизацияУТ = НайтиОрганизациюУТ(СтрокаCOM.Организация);
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Контрагент) Тогда
			Сообщить("Не найден контрагент: " + СтрокаCOM.Контрагент);
		ИначеЕсли НЕ ЗначениеЗаполнено(ОрганизацияУТ) Тогда
			Сообщить("Не найдена организация: " + СтрокаCOM.Организация);
		Иначе
			Подбор = ПодобратьИлиСоздатьДоговорУТ(
				НоваяСтрока.Контрагент,
				ОрганизацияУТ,
				СтрокаCOM.Договор,
				СтрокаCOM.ДоговорНомер,
				СтрокаCOM.ДоговорСсылка,
				СтрокаCOM.Счет,
				ВалютаСтроки,
				Ложь);
			
			НоваяСтрока.Договор = Подбор.Договор;
			Если Подбор.Статус = "Неоднозначно" Тогда
				Сообщить("Найдено несколько договоров: " + СтрокаCOM.Договор
					+ ". Выберите договор вручную в таблице.");
			ИначеЕсли НЕ ЗначениеЗаполнено(Подбор.Договор) Тогда
				Сообщить("Не подобран договор: " + СтрокаCOM.Договор
					+ ". Укажите вручную или создайте недостающие договоры отдельной командой.");
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрока.ДоговорВБП = СтрокаCOM.Договор;
		НоваяСтрока.Организация = ОрганизацияУТ;
		НоваяСтрока.Валюта = ВалютаСтроки;
		НоваяСтрока.Остаток = СтрокаCOM.СуммаОстаток;
		НоваяСтрока.ОстатокДт = СтрокаCOM.СуммаОстатокДт;
		НоваяСтрока.ОстатокКт = СтрокаCOM.СуммаОстатокКт;
		НоваяСтрока.ВалютныйОстаток = СтрокаCOM.ВалютнаяСуммаОстаток;
		НоваяСтрока.ВалютныйОстатокДт = СтрокаCOM.ВалютнаяСуммаОстатокДт;
		НоваяСтрока.ВалютныйОстатокКт = СтрокаCOM.ВалютнаяСуммаОстатокКт;
		
	КонецЦикла;
	
	ТЗОстаткиНаФорме.Загрузить(ТЗОстатки);
	Сообщить("Выгрузка из БП завершена. Строк в таблице: " + ТЗОстаткиНаФорме.Количество()
		+ ". Договоры при выгрузке не создаются. Пустые строки проверьте до загрузки.");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСчетБПЕслиНайден(Соединение, МассивСчетов, Добавлять, КодыЧерезЗапятую)
	
	Если НЕ Добавлять Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого КодСчета Из СтрРазделить(КодыЧерезЗапятую, ",") Цикл
		СчетБП = Соединение.ПланыСчетов.Хозрасчетный.НайтиПоКоду(СокрЛП(КодСчета));
		Если ЗначениеЗаполнено(СчетБП) Тогда
			МассивСчетов.Добавить(СчетБП);
		Иначе
			Сообщить("В БП не найден счет " + СокрЛП(КодСчета) + " — пропущен.");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитькорректировкуВзаиморасчетов(Команда)
	
	Если НЕ ДатаПереходаЗаполнена() Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ВыгрузитьСчет60 И НЕ ВыгрузитьСчет62 Тогда
		Сообщить("Включите выгрузку счета 60 и/или 62.");
		Возврат;
	КонецЕсли;
	
	ПарольБП = "";
	Если НЕ ВвестиСтроку(ПарольБП, "Пароль COM-подключения к БП", 50) Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ПарольБП) Тогда
		Сообщить("Пароль не введен. Выгрузка отменена.");
		Возврат;
	КонецЕсли;
	
	ВыполнитькорректировкуВзаиморасчетовНаСервере(ВыгрузитьСчет60, ВыгрузитьСчет62, ПарольБП);
	
КонецПроцедуры

&НаСервере
Функция ПодключитьсяКбазе(ПарольБП)
	
	Если ПустаяСтрока(ПарольБП) Тогда
		ВызватьИсключение "Не указан пароль пользователя БП.";
	КонецЕсли;
	
	СерверБП = "172.17.0.235";
	БазаБП = "buh82_old4";
	ПользовательБП = "Программист";
	ПараметрыПодключенияИБ = "Srvr=""" + СерверБП + """; Ref=""" + БазаБП
		+ """; Usr=""" + ПользовательБП + """; Pwd=""" + ПарольБП + """";
	
	V83COMCon = Неопределено;
	Попытка
		V83COMCon = Новый COMОбъект("V83.COMConnector");
	Исключение
		Попытка
			V83COMCon = Новый COMОбъект("V82.COMConnector");
		Исключение
			ВызватьИсключение "Не удалось создать COM-коннектор 1С (V83.COMConnector / V82.COMConnector). Установите COM-компонент платформы на сервере 1С.";
		КонецПопытки;
	КонецПопытки;
	
	Попытка
		Возврат V83COMCon.Connect(ПараметрыПодключенияИБ);
	Исключение
		ВызватьИсключение "Не удалось подключиться к БП " + БазаБП + " на сервере " + СерверБП + ".";
	КонецПопытки;
	
КонецФункции

&НаСервере
Процедура СоздатьНедостающиеДоговорыНаСервере()
	
	ПроверитьДатуПерехода();
	Создано = 0;
	
	Для Каждого СтрокаОстатки Из ТЗОстаткиНаФорме Цикл
		
		Если ЗначениеЗаполнено(СтрокаОстатки.Договор) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаОстатки.Контрагент)
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаОстатки.Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		Подбор = ПодобратьИлиСоздатьДоговорУТ(
			СтрокаОстатки.Контрагент,
			СтрокаОстатки.Организация,
			СтрокаОстатки.ДоговорВБП,
			"",
			"",
			СтрокаОстатки.Счет,
			СтрокаОстатки.Валюта,
			Истина);
		
		Если ЗначениеЗаполнено(Подбор.Договор) Тогда
			СтрокаОстатки.Договор = Подбор.Договор;
			Создано = Создано + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Сообщить("Создание договоров завершено. Заполнено строк: " + Создано + ".");
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНедостающиеДоговоры(Команда)
	
	Если ТЗОстаткиНаФорме.Количество() = 0 Тогда
		Сообщить("Сначала выполните выгрузку из БП.");
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("СоздатьНедостающиеДоговорыПослеПодтверждения", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Для строк без договора будут созданы элементы справочника договоров. Продолжить?",
		РежимДиалогаВопрос.ДаНет,,
		КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНедостающиеДоговорыПослеПодтверждения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СоздатьНедостающиеДоговорыНаСервере();
	
КонецПроцедуры

