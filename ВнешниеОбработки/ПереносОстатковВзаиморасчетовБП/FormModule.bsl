#Область ЗагрузкаОстатков

&НаСервере
Процедура ЗагрузитьНачальныеОстаткиНаСервере()
	
	ПроверитьДатуПерехода();
	Если ТЗОстаткиНаФорме.Количество() = 0 Тогда
		ВызватьИсключение "Таблица остатков не заполнена. Сначала выполните выгрузку из БП.";
	КонецЕсли;
	
	ОшибкиЗаполнения = Новый Массив;
	Для Каждого ПроверяемаяСтрока Из ТЗОстаткиНаФорме Цикл
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Контрагент) Тогда
			ОшибкиЗаполнения.Добавить("не заполнен контрагент: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Договор) Тогда
			ОшибкиЗаполнения.Добавить("не заполнен договор: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если ЗначениеЗаполнено(ПроверяемаяСтрока.Договор)
			И ЗначениеЗаполнено(ПроверяемаяСтрока.Контрагент) Тогда
			КонтрагентДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПроверяемаяСтрока.Договор, "Контрагент");
			Если КонтрагентДоговора <> ПроверяемаяСтрока.Контрагент Тогда
				ОшибкиЗаполнения.Добавить("договор не того контрагента: " + ПроверяемаяСтрока.ДоговорВБП);
			КонецЕсли;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Организация) Тогда
			ОшибкиЗаполнения.Добавить("не заполнена организация: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПроверяемаяСтрока.Валюта) Тогда
			ОшибкиЗаполнения.Добавить("не заполнена валюта: " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
		Если ПроверяемаяСтрока.Счет <> 60 И ПроверяемаяСтрока.Счет <> 62 Тогда
			ОшибкиЗаполнения.Добавить("неподдерживаемый счет: " + Строка(ПроверяемаяСтрока.Счет));
		КонецЕсли;
		Если ЗначениеЗаполнено(ПроверяемаяСтрока.Договор)
			И ЗначениеЗаполнено(ПроверяемаяСтрока.Организация)
			И (ПроверяемаяСтрока.Счет = 60 ИЛИ ПроверяемаяСтрока.Счет = 62)
			И НЕ ЗначениеЗаполнено(НайтиОбъектРасчетовПоДоговору(
				ПроверяемаяСтрока.Договор, ПроверяемаяСтрока.Организация, ПроверяемаяСтрока.Счет)) Тогда
			ОшибкиЗаполнения.Добавить("не найден объект расчетов: " + Строка(ПроверяемаяСтрока.Договор)
				+ " / " + ПроверяемаяСтрока.ДоговорВБП);
		КонецЕсли;
	КонецЦикла;
	
	Если ОшибкиЗаполнения.Количество() > 0 Тогда
		ТекстОшибок = СтрСоединить(ОшибкиЗаполнения, Символы.ПС);
		ВызватьИсключение "Загрузка запрещена. Исправьте ошибки:" + Символы.ПС + ТекстОшибок;
	КонецЕсли;
	
	КомментарийЗагрузки = КомментарийЗагрузкиОстатков();
	ЗагруженоОрг = 0;
	ПропущеноОрг = 0;
	ОшибкиОрг = Новый Массив;
	
	Организации = ТЗОстаткиНаФорме.Выгрузить(, "Организация");
	Организации.Свернуть("Организация");
	
	Для Каждого ОрганизацияСтр Из Организации Цикл
		
		ЗапросУжеЗагружено = Новый Запрос;
		ЗапросУжеЗагружено.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Остатки.Ссылка
		|ИЗ
		|	Документ.ВводОстатковВзаиморасчетов КАК Остатки
		|ГДЕ
		|	Остатки.Проведен
		|	И Остатки.Организация = &Организация
		|	И (ВЫРАЗИТЬ(Остатки.Комментарий КАК СТРОКА(200)) = &Комментарий
		|		ИЛИ ВЫРАЗИТЬ(Остатки.Комментарий КАК СТРОКА(200)) = ""Ввод остатков из БП"")
		|	И Остатки.Дата МЕЖДУ &НачалоПериода И &КонецПериода";
		ЗапросУжеЗагружено.УстановитьПараметр("Организация", ОрганизацияСтр.Организация);
		ЗапросУжеЗагружено.УстановитьПараметр("Комментарий", КомментарийЗагрузки);
		ЗапросУжеЗагружено.УстановитьПараметр("НачалоПериода", НачалоДня(Дата));
		ЗапросУжеЗагружено.УстановитьПараметр("КонецПериода", КонецДня(Дата));
		
		Если НЕ ЗапросУжеЗагружено.Выполнить().Пустой() Тогда
			ПропущеноОрг = ПропущеноОрг + 1;
			Сообщить("Организация """ + ОрганизацияСтр.Организация
				+ """ уже загружена (есть проведённые вводы с комментарием 000031404) — пропуск.");
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			
			ВводОстатковДт60 = НовыйДокументВводаОстатков(
				Перечисления.ХозяйственныеОперации.ВводОстатковАвансовПоставщикам, ОрганизацияСтр.Организация, КомментарийЗагрузки);
			ВводОстатковКт60 = НовыйДокументВводаОстатков(
				Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиПоставщикам, ОрганизацияСтр.Организация, КомментарийЗагрузки);
			ВводОстатковДт62 = НовыйДокументВводаОстатков(
				Перечисления.ХозяйственныеОперации.ВводОстатковЗадолженностиКлиентов, ОрганизацияСтр.Организация, КомментарийЗагрузки);
			ВводОстатковКт62 = НовыйДокументВводаОстатков(
				Перечисления.ХозяйственныеОперации.ВводОстатковАвансовКлиентов, ОрганизацияСтр.Организация, КомментарийЗагрузки);
			
			Для Каждого СтрокаОстатки Из ТЗОстаткиНаФорме Цикл
				
				Если СтрокаОстатки.Организация <> ОрганизацияСтр.Организация Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрокаОстатки.Контрагент) Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрокаОстатки.Счет = 60 Тогда
					ДобавитьПлечиСчета60(ВводОстатковДт60, ВводОстатковКт60, СтрокаОстатки);
				ИначеЕсли СтрокаОстатки.Счет = 62 Тогда
					ДобавитьПлечиСчета62(ВводОстатковДт62, ВводОстатковКт62, СтрокаОстатки);
				КонецЕсли;
				
			КонецЦикла;
			
			ПровестиВводЕслиЕстьСтроки(ВводОстатковДт60, "авансов поставщикам");
			ПровестиВводЕслиЕстьСтроки(ВводОстатковКт60, "задолженности поставщикам");
			ПровестиВводЕслиЕстьСтроки(ВводОстатковДт62, "задолженности клиентов");
			ПровестиВводЕслиЕстьСтроки(ВводОстатковКт62, "авансов клиентов");
			
			ЗафиксироватьТранзакцию();
			ЗагруженоОрг = ЗагруженоОрг + 1;
			
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ТекстОшибкиОрг = "Ошибка загрузки по организации """ + ОрганизацияСтр.Организация
				+ """. Изменения по этой организации откатаны. Причина: " + ОписаниеОшибки();
			ОшибкиОрг.Добавить(ТекстОшибкиОрг);
			Сообщить(ТекстОшибкиОрг);
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщить("Загрузка завершена. Загружено организаций: " + ЗагруженоОрг
		+ ", пропущено (уже были): " + ПропущеноОрг
		+ ", с ошибкой: " + ОшибкиОрг.Количество()
		+ ". Проверьте документы с комментарием 000031404.");
	Если ОшибкиОрг.Количество() > 0 Тогда
		ВызватьИсключение "Загрузка выполнена частично:" + Символы.ПС + СтрСоединить(ОшибкиОрг, Символы.ПС);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НовыйДокументВводаОстатков(ХозОперация, Организация, КомментарийЗагрузки)
	
	Док = Документы.ВводОстатковВзаиморасчетов.СоздатьДокумент();
	Док.ХозяйственнаяОперация = ХозОперация;
	Док.Организация = Организация;
	Док.Комментарий = КомментарийЗагрузки;
	Док.ОтражатьВОперативномУчете = Истина;
	Док.ОтражатьВБУиНУ = Ложь;
	Док.ОтражатьВУУ = Ложь;
	Возврат Док;
	
КонецФункции

&НаСервере
Процедура ДобавитьПлечиСчета60(ВводДт, ВводКт, СтрокаОстатки)
	
	Если СтрокаОстатки.ОстатокДт > 0 Тогда
		ДобавитьСтрокуВводаОстатков(ВводДт, СтрокаОстатки,
			Перечисления.ТипыПервичныхДокументов.ОплатаПоставщику,
			СтрокаОстатки.ОстатокДт, СтрокаОстатки.ВалютныйОстатокДт, Ложь);
	ИначеЕсли СтрокаОстатки.ОстатокДт < 0 Тогда
		ДобавитьСтрокуВводаОстатков(ВводКт, СтрокаОстатки,
			Перечисления.ТипыПервичныхДокументов.ПриобретениеУПоставщика,
			-СтрокаОстатки.ОстатокДт, -СтрокаОстатки.ВалютныйОстатокДт, Истина);
	КонецЕсли;
	
	Если СтрокаОстатки.ОстатокКт > 0 Тогда
		ДобавитьСтрокуВводаОстатков(ВводКт, СтрокаОстатки,
			Перечисления.ТипыПервичныхДокументов.ПриобретениеУПоставщика,
			СтрокаОстатки.ОстатокКт, СтрокаОстатки.ВалютныйОстатокКт, Истина);
	ИначеЕсли СтрокаОстатки.ОстатокКт < 0 Тогда
		ДобавитьСтрокуВводаОстатков(ВводДт, СтрокаОстатки,
			Перечисления.ТипыПервичныхДокументов.ОплатаПоставщику,
			-СтрокаОстатки.ОстатокКт, -СтрокаОстатки.ВалютныйОстатокКт, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПлечиСчета62(ВводДт, ВводКт, СтрокаОстатки)
	
	Если СтрокаОстатки.ОстатокДт > 0 Тогда
		ДобавитьСтрокуВводаОстатков(ВводДт, СтрокаОстатки,
