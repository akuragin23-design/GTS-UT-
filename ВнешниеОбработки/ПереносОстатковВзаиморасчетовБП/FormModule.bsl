КонецФункции

&НаСервере
Функция НайтиОбъектРасчетовПоДоговору(Договор, Организация, Счет)
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат Справочники.ОбъектыРасчетов.ПустаяСсылка();
	КонецЕсли;
	
	ТипРасчетов = ?(Счет = 62,
		Перечисления.ТипыРасчетовСПартнерами.РасчетыСКлиентом,
		Перечисления.ТипыРасчетовСПартнерами.РасчетыСПоставщиком);
	
	ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Договор, Организация, ТипРасчетов);
	Если НЕ ЗначениеЗаполнено(ОбъектРасчетов) Тогда
		ОбъектРасчетов = ОбъектыРасчетовСервер.ПолучитьОбъектРасчетовПоСсылке(Договор, Организация);
	КонецЕсли;
	
	Возврат ОбъектРасчетов;
	
КонецФункции

&НаСервере
Функция НайтиВалютуПоДаннымБП(НаименованиеВалютыБП)
	
	Если НЕ ЗначениеЗаполнено(НаименованиеВалютыБП) Тогда
		Возврат Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	Валюта = Справочники.Валюты.НайтиПоНаименованию(НаименованиеВалютыБП);
	Если ЗначениеЗаполнено(Валюта) Тогда
		Возврат Валюта;
	КонецЕсли;
	
	ИмяНорм = ВРег(СокрЛП(НаименованиеВалютыБП));
	Если ИмяНорм = "РУБ" ИЛИ ИмяНорм = "РУБ." ИЛИ ИмяНорм = "RUB" ИЛИ ИмяНорм = "RUR"
		ИЛИ ИмяНорм = "РОССИЙСКИЙ РУБЛЬ" Тогда
		
		Валюта = Справочники.Валюты.НайтиПоКоду("643");
		Если ЗначениеЗаполнено(Валюта) Тогда
			Возврат Валюта;
		КонецЕсли;
		
		Попытка
			Возврат Константы.ВалютаРегламентированногоУчета.Получить();
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Справочники.Валюты.ПустаяСсылка();
	
КонецФункции

