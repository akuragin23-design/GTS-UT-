КонецФункции

&НаСервере
Процедура ДобавитьСтрокуВводаОстатков(ДокументВвода, СтрокаОстатки, ТипПервичногоДокумента, СуммаРегл, ВалютнаяСумма, УстановитьДатуПлатежа)
	
	ОбъектРасчетовСправочник = НайтиОбъектРасчетовПоДоговору(
		СтрокаОстатки.Договор, СтрокаОстатки.Организация, СтрокаОстатки.Счет);
	Если НЕ ЗначениеЗаполнено(ОбъектРасчетовСправочник) Тогда
		ВызватьИсключение "Не найден объект расчетов по договору """ + СтрокаОстатки.Договор
			+ """ (счет " + Строка(СтрокаОстатки.Счет) + "). Откройте договор в УТ, чтобы система создала объект расчетов, и повторите загрузку.";
	КонецЕсли;
	
	СтрокаВвода = ДокументВвода.РасчетыСПартнерами.Добавить();
	РеквДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		СтрокаОстатки.Договор, "Контрагент, Партнер, ПорядокРасчетов");
	
	СтрокаВвода.Контрагент = РеквДоговора.Контрагент;
	СтрокаВвода.Партнер = РеквДоговора.Партнер;
	СтрокаВвода.ОбъектРасчетов = СтрокаОстатки.Договор;
	СтрокаВвода.ОбъектРасчетовОтправитель = ОбъектРасчетовСправочник;
	СтрокаВвода.Договор = СтрокаОстатки.Договор;
	СтрокаВвода.ВалютаВзаиморасчетов = СтрокаОстатки.Валюта;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаВвода, "ПорядокРасчетов") Тогда
		СтрокаВвода.ПорядокРасчетов = РеквДоговора.ПорядокРасчетов;
	КонецЕсли;
	
	РасчетныйДокумент = Документы.ПервичныйДокумент.СоздатьДокумент();
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Контрагент", СтрокаВвода.Контрагент);
	ДанныеЗаполнения.Вставить("Партнер", СтрокаВвода.Партнер);
	ДанныеЗаполнения.Вставить("ОбъектРасчетов", ОбъектРасчетовСправочник);
	ДанныеЗаполнения.Вставить("Договор", СтрокаВвода.Договор);
	ДанныеЗаполнения.Вставить("ВалютаВзаиморасчетов", СтрокаВвода.ВалютаВзаиморасчетов);
	ДанныеЗаполнения.Вставить("Валюта", СтрокаВвода.ВалютаВзаиморасчетов);
	ДанныеЗаполнения.Вставить("Организация", ДокументВвода.Организация);
	ДанныеЗаполнения.Вставить("ТипПервичногоДокумента", ТипПервичногоДокумента);
	РасчетныйДокумент.Заполнить(ДанныеЗаполнения);
	РасчетныйДокумент.Дата = НачалоДня(Дата);
	
	Если ВалютнаяСумма <> 0 Тогда
		РасчетныйДокумент.СуммаДокумента = ВалютнаяСумма;
		СтрокаВвода.Сумма = ВалютнаяСумма;
	Иначе
		РасчетныйДокумент.СуммаДокумента = СуммаРегл;
		СтрокаВвода.Сумма = СуммаРегл;
	КонецЕсли;
	
	СуммаДокументаПриИзменении(РасчетныйДокумент);
	РасчетныйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	СтрокаВвода.ДокументРасчетов = РасчетныйДокумент.Ссылка;
	
	РассчитанныеСуммы = РассчитатьСуммы(
		СтрокаВвода.Сумма,
		0,
		СтрокаВвода.ВалютаВзаиморасчетов,
		ВалютаРеглУчета(),
		ВалютаУпрУчета(),
		Дата,
		СтрокаВвода.ДокументРасчетов);
	ЗаполнитьЗначенияСвойств(СтрокаВвода, РассчитанныеСуммы, "СуммаРегл, СуммаУпр");
	
	Если СуммаРегл <> 0 Тогда
		СтрокаВвода.СуммаРегл = СуммаРегл;
	КонецЕсли;
	
	Если УстановитьДатуПлатежа Тогда
		СтрокаВвода.ДатаПлатежа = РасчетныйДокумент.Дата;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиКандидатовДоговораПоСоответствиюБП(УидДоговораБП, НаименованиеБП)
	
	РезультатПустой = Новый ТаблицаЗначений;
	РезультатПустой.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	
	Если НЕ ЗначениеЗаполнено(УидДоговораБП) Тогда
		Возврат РезультатПустой;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Уид", Строка(УидДоговораБП));
	Запрос.УстановитьПараметр("Наименование", НаименованиеБП);
	Запрос.УстановитьПараметр("ПоНаименованию", ЗначениеЗаполнено(НаименованиеБП));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(Соответствия.УникальныйИдентификаторИсточника КАК Справочник.ДоговорыКонтрагентов) КАК Ссылка
	|ИЗ
	|	РегистрСведений.СоответствияОбъектовИнформационныхБаз КАК Соответствия
	|ГДЕ
	|	Соответствия.УникальныйИдентификаторПриемника = &Уид
	|	И Соответствия.УникальныйИдентификаторИсточника ССЫЛКА Справочник.ДоговорыКонтрагентов
	|	И ВЫРАЗИТЬ(Соответствия.УникальныйИдентификаторИсточника КАК Справочник.ДоговорыКонтрагентов).ПометкаУдаления = ЛОЖЬ
	|	И (&ПоНаименованию = ЛОЖЬ
	|		ИЛИ ВЫРАЗИТЬ(Соответствия.УникальныйИдентификаторИсточника КАК Справочник.ДоговорыКонтрагентов).Наименование = &Наименование)";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция НайтиКандидатовДоговораПоКонтрагентуИТипу(Контрагент, Организация, Счет, Валюта)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
