			Перечисления.ТипыПервичныхДокументов.ОплатаОтКлиента,
			-СтрокаОстатки.ОстатокДт, -СтрокаОстатки.ВалютныйОстатокДт, Ложь);
	КонецЕсли;
	
	Если СтрокаОстатки.ОстатокКт > 0 Тогда
		ДобавитьСтрокуВводаОстатков(ВводКт, СтрокаОстатки,
			Перечисления.ТипыПервичныхДокументов.ОплатаОтКлиента,
			СтрокаОстатки.ОстатокКт, СтрокаОстатки.ВалютныйОстатокКт, Ложь);
	ИначеЕсли СтрокаОстатки.ОстатокКт < 0 Тогда
		ДобавитьСтрокуВводаОстатков(ВводДт, СтрокаОстатки,
			Перечисления.ТипыПервичныхДокументов.РеализацияКлиенту,
