&НаСервере
Функция ВыбратьДоговорИзКандидатов(ТаблицаКандидатов, Счет, Валюта, НаименованиеБП = "", НомерБП = "")
	
	Если ТаблицаКандидатов.Количество() = 0 Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	
	Отобранные = ОтфильтроватьКандидатовДоговораБезУдаленногоКонтрагента(ТаблицаКандидатов);
	Если Отобранные.Количество() = 0 Тогда
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
	Если Отобранные.Количество() = 1 Тогда
		Возврат Отобранные[0].Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеБП) Тогда
		ПоИмени = ОтобратьКандидатовПоРеквизиту(Отобранные, "Наименование", СокрЛП(НаименованиеБП));
		Если ПоИмени.Количество() = 1 Тогда
			Возврат ПоИмени[0].Ссылка;
		ИначеЕсли ПоИмени.Количество() > 1 Тогда
			Отобранные = ПоИмени;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерБП) Тогда
		ПоНомеру = ОтобратьКандидатовПоРеквизиту(Отобранные, "Номер", СокрЛП(НомерБП));
		Если ПоНомеру.Количество() = 1 Тогда
			Возврат ПоНомеру[0].Ссылка;
		ИначеЕсли ПоНомеру.Количество() > 1 Тогда
			Отобранные = ПоНомеру;
		КонецЕсли;
	КонецЕсли;
	
	Если Отобранные.Количество() = 1 Тогда
		Возврат Отобранные[0].Ссылка;
	КонецЕсли;
	
	ОтобранныеСсылки = Новый Массив;
	Для Каждого Стр Из Отобранные Цикл
		ОтобранныеСсылки.Добавить(Стр.Ссылка);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		Отфильтрованные = Новый Массив;
		Для Каждого СсылкаДог Из ОтобранныеСсылки Цикл
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаДог, "ВалютаВзаиморасчетов") = Валюта Тогда
				Отфильтрованные.Добавить(СсылкаДог);
			КонецЕсли;
		КонецЦикла;
		Если Отфильтрованные.Количество() = 1 Тогда
			Возврат Отфильтрованные[0];
		ИначеЕсли Отфильтрованные.Количество() > 1 Тогда
			ОтобранныеСсылки = Отфильтрованные;
		КонецЕсли;
	КонецЕсли;
	
	ВалютаРегл = ВалютаРеглУчета();
	
	Отфильтрованные = Новый Массив;
	Для Каждого СсылкаДог Из ОтобранныеСсылки Цикл
		Рекв = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДог, "ТипДоговора, ХозяйственнаяОперация");
		Подходит = Ложь;
		Если Счет = 62 Тогда
			Подходит = (Рекв.ТипДоговора = Перечисления.ТипыДоговоров.СПокупателем);
		Иначе
			Подходит = (Рекв.ТипДоговора = Перечисления.ТипыДоговоров.СПоставщиком)
				ИЛИ (Рекв.ТипДоговора = Перечисления.ТипыДоговоров.Импорт)
				ИЛИ (Рекв.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту);
		КонецЕсли;
		Если Подходит Тогда
			Отфильтрованные.Добавить(СсылкаДог);
		КонецЕсли;
	КонецЦикла;
	Если Отфильтрованные.Количество() = 1 Тогда
		Возврат Отфильтрованные[0];
	ИначеЕсли Отфильтрованные.Количество() > 1 Тогда
		ОтобранныеСсылки = Отфильтрованные;
	КонецЕсли;
	
	Если Счет = 60 И ЗначениеЗаполнено(Валюта) И ЗначениеЗаполнено(ВалютаРегл) И Валюта <> ВалютаРегл Тогда
		Отфильтрованные = Новый Массив;
		Для Каждого СсылкаДог Из ОтобранныеСсылки Цикл
			Рекв = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаДог, "ТипДоговора, ХозяйственнаяОперация");
			Если Рекв.ТипДоговора = Перечисления.ТипыДоговоров.Импорт
				ИЛИ Рекв.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ЗакупкаПоИмпорту Тогда
				Отфильтрованные.Добавить(СсылкаДог);
			КонецЕсли;
		КонецЦикла;
		Если Отфильтрованные.Количество() = 1 Тогда
			Возврат Отфильтрованные[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	
КонецФункции

&НаСервере
Функция НайтиКандидатовДоговора(Контрагент, Организация, НаименованиеБП, НомерБП)
	
