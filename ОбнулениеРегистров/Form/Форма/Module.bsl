// Обнуление остатков регистров накопления на дату документами "Корректировка регистров".
//
// Ожидаемые реквизиты объекта обработки:
//   ДатаОбнуления        - Дата
//   Организация          - СправочникСсылка.Организации (необязательно)
//   ОбнулятьКлиентов     - Булево
//   ОбнулятьПоставщиков  - Булево
//   ТаблицаРегистров     - ТабличнаяЧасть (Пометка - Булево, Имя - Строка)

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбнуление(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ДатаОбнуления) Тогда
		ПоказатьПредупреждение(, "Укажите дату обнуления!");
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = "Будут созданы документы ""Корректировка регистров"" на "
		+ Формат(Объект.ДатаОбнуления, "ДЛФ=DT")
		+ ", списывающие остатки выбранных регистров. Продолжить?";
	Оповещение = Новый ОписаниеОповещения("ВыполнитьОбнулениеЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбнулениеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	КоличествоДокументов = ВыполнитьОбнулениеНаСервере();
	
	Если КоличествоДокументов = 0 Тогда
		ПоказатьПредупреждение(, "На указанную дату нет остатков для обнуления.");
	Иначе
		ПоказатьОповещениеПользователя("Обнуление выполнено", ,
			"Создано документов: " + Формат(КоличествоДокументов, "ЧГ=0"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ВыполнитьОбнулениеНаСервере()
	
	ДатаСреза = Объект.ДатаОбнуления;
	Организация = Объект.Организация;
	Маркер = МаркерОбнуления(ДатаСреза);
	
	ПроверитьПовторныйЗапуск(ДатаСреза, Маркер);
	
	РегистрыВзаиморасчетов = Новый Массив;
	Если Объект.ОбнулятьКлиентов Тогда
		РегистрыВзаиморасчетов.Добавить("РасчетыСКлиентами");
		РегистрыВзаиморасчетов.Добавить("РасчетыСКлиентамиПоСрокам");
		РегистрыВзаиморасчетов.Добавить("РасчетыСКлиентамиПоДокументам");
	КонецЕсли;
	Если Объект.ОбнулятьПоставщиков Тогда
		РегистрыВзаиморасчетов.Добавить("РасчетыСПоставщиками");
		РегистрыВзаиморасчетов.Добавить("РасчетыСПоставщикамиПоСрокам");
		РегистрыВзаиморасчетов.Добавить("РасчетыСПоставщикамиПоДокументам");
	КонецЕсли;
	
	ИсключенияИзПрочих = Новый Соответствие;
	Для Каждого ИмяРег Из РегистрыВзаиморасчетовВсе() Цикл
		ИсключенияИзПрочих.Вставить(ИмяРег, Истина);
	КонецЦикла;
	
	ПрочиеРегистры = Новый Массив;
	Для Каждого СтрРег Из Объект.ТаблицаРегистров Цикл
		Если СтрРег.Пометка И ИсключенияИзПрочих[СтрРег.Имя] = Неопределено Тогда
			ПрочиеРегистры.Добавить(СтрРег.Имя);
		КонецЕсли;
	КонецЦикла;
	
	КоличествоДокументов = 0;
	
	НачатьТранзакцию();
	Попытка
		
		// Взаиморасчеты списываются одним документом, чтобы первичный регистр
		// (РасчетыС...) и производные (ПоСрокам, ПоДокументам) обнулялись синхронно.
		Если РегистрыВзаиморасчетов.Количество() > 0 Тогда
			Док = НовыйДокументКорректировки(ДатаСреза, Организация,
				Маркер + " взаиморасчеты (клиенты и поставщики)");
			Если ЗаполнитьДвиженияОбнуления(Док, РегистрыВзаиморасчетов, ДатаСреза, Организация) Тогда
				Док.Записать(РежимЗаписиДокумента.Запись);
				КоличествоДокументов = КоличествоДокументов + 1;
				Сообщить("Сформирован документ корректировки взаиморасчетов: " + Строка(Док.Ссылка));
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ИмяРег Из ПрочиеРегистры Цикл
			СписокОдного = Новый Массив;
			СписокОдного.Добавить(ИмяРег);
			Док = НовыйДокументКорректировки(ДатаСреза, Организация, Маркер + " " + ИмяРег);
			Если ЗаполнитьДвиженияОбнуления(Док, СписокОдного, ДатаСреза, Организация) Тогда
				Док.Записать(РежимЗаписиДокумента.Запись);
				КоличествоДокументов = КоличествоДокументов + 1;
				Сообщить("Сформирован документ корректировки регистра " + ИмяРег + ": " + Строка(Док.Ссылка));
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат КоличествоДокументов;
	
КонецФункции

&НаСервереБезКонтекста
Функция РегистрыВзаиморасчетовВсе()
	
	Результат = Новый Массив;
	Результат.Добавить("РасчетыСКлиентами");
	Результат.Добавить("РасчетыСКлиентамиПоСрокам");
	Результат.Добавить("РасчетыСКлиентамиПоДокументам");
	Результат.Добавить("РасчетыСПоставщиками");
	Результат.Добавить("РасчетыСПоставщикамиПоСрокам");
	Результат.Добавить("РасчетыСПоставщикамиПоДокументам");
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция МаркерОбнуления(ДатаСреза)
	
	Возврат "Обнуление остатков на " + Формат(ДатаСреза, "ДФ=dd.MM.yyyy HH:mm:ss") + ":";
	
КонецФункции

&НаСервереБезКонтекста
Процедура ПроверитьПовторныйЗапуск(ДатаСреза, Маркер)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Корректировки.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРегистров КАК Корректировки
	|ГДЕ
	|	НЕ Корректировки.ПометкаУдаления
	|	И Корректировки.Дата = &Дата
	|	И Корректировки.Комментарий ПОДОБНО &Маркер";
	Запрос.УстановитьПараметр("Дата", ДатаСреза);
	Запрос.УстановитьПараметр("Маркер", Маркер + "%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "Обнуление на " + Формат(ДатаСреза, "ДЛФ=DT")
			+ " уже выполнялось (документ " + Строка(Выборка.Ссылка)
			+ "). Пометьте его на удаление, если требуется повторить.";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НовыйДокументКорректировки(ДатаСреза, Организация, Комментарий)
	
	Док = Документы.КорректировкаРегистров.СоздатьДокумент();
	// Заполнить() вызывает ОбработкаЗаполнения: Операция = РучнаяКорректировка, Ответственный.
	// Без операции документ не распознается механизмами УТ как ручная корректировка.
	Док.Заполнить(Неопределено);
	Док.Операция    = Перечисления.ОперацииКорректировкиРегистров.РучнаяКорректировка;
	Док.Дата        = ДатаСреза;
	Док.Организация = Организация;
	Док.Комментарий = Комментарий;
	Док.УстановитьНовыйНомер();
	
	Возврат Док;
	
КонецФункции

// Добавляет в документ движения, списывающие остатки всех ресурсов по всем измерениям
// каждого регистра из списка. Возвращает Истина, если добавлено хотя бы одно движение.
&НаСервереБезКонтекста
Функция ЗаполнитьДвиженияОбнуления(Док, ИменаРегистров, ДатаСреза, Организация)
	
	ЕстьЗаписи = Ложь;
	ГраницаСреза = Новый Граница(ДатаСреза, ВидГраницы.Включая);
	
	Для Каждого ИмяРег Из ИменаРегистров Цикл
		
		МетаРег = Метаданные.РегистрыНакопления.Найти(ИмяРег);
		Если МетаРег = Неопределено Тогда
			Сообщить("Регистр накопления """ + ИмяРег + """ не найден, пропущен.");
			Продолжить;
		КонецЕсли;
		Если МетаРег.ВидРегистра <> Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки Тогда
			Сообщить("Регистр """ + ИмяРег + """ оборотный, остатков не имеет, пропущен.");
			Продолжить;
		КонецЕсли;
		Если Не МетаРег.Регистраторы.Содержит(Метаданные.Документы.КорректировкаРегистров) Тогда
			Сообщить("Документ ""Корректировка регистров"" не является регистратором """ + ИмяРег + """, пропущен.");
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос(ТекстЗапросаОстатков(МетаРег, Организация));
		Запрос.УстановитьПараметр("Граница", ГраницаСреза);
		Если ЗначениеЗаполнено(Организация) Тогда
			Запрос.УстановитьПараметр("Организация", Организация);
		КонецЕсли;
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрТЧ = Док.ТаблицаРегистров.Добавить();
		СтрТЧ.Имя = ИмяРег;
		Набор = Док.Движения[ИмяРег];
		Набор.Записывать = Истина;
		
		// Положительные остатки (долг) закрываются Расходом, отрицательные (аванс) - Приходом
		// по модулю. Ресурсы с разными знаками в одной строке остатков пишутся двумя записями,
		// чтобы вид движения не зависел от порядка ресурсов и обороты не искажались минусом.
		Пока Выборка.Следующий() Цикл
			ДобавитьДвижениеПоЗнаку(Набор, Выборка, МетаРег, ДатаСреза, ВидДвиженияНакопления.Расход);
			ДобавитьДвижениеПоЗнаку(Набор, Выборка, МетаРег, ДатаСреза, ВидДвиженияНакопления.Приход);
		КонецЦикла;
		
		Сообщить(ИмяРег + ": списывается строк остатков - " + Формат(Выборка.Количество(), "ЧГ=0"));
		ЕстьЗаписи = Истина;
		
	КонецЦикла;
	
	Возврат ЕстьЗаписи;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьДвижениеПоЗнаку(Набор, Выборка, МетаРег, ДатаСреза, ВидДвижения)
	
	ДляРасхода = (ВидДвижения = ВидДвиженияНакопления.Расход);
	Движение = Неопределено;
	
	Для Каждого Рес Из МетаРег.Ресурсы Цикл
		Остаток = Выборка[Рес.Имя + "Остаток"];
		Если Остаток = 0 Или (Остаток > 0) <> ДляРасхода Тогда
			Продолжить;
		КонецЕсли;
		Если Движение = Неопределено Тогда
			Движение = Набор.Добавить();
			Движение.Период      = ДатаСреза;
			Движение.Активность  = Истина;
			Движение.ВидДвижения = ВидДвижения;
			Для Каждого Изм Из МетаРег.Измерения Цикл
				Движение[Изм.Имя] = Выборка[Изм.Имя];
			КонецЦикла;
		КонецЕсли;
		Движение[Рес.Имя] = ?(ДляРасхода, Остаток, -Остаток);
	КонецЦикла;
	
КонецПроцедуры

// Текст запроса остатков по всем измерениям и ресурсам регистра.
// Отбор по организации накладывается через измерение Организация или
// АналитикаУчетаПоПартнерам.Организация, если такое измерение есть.
&НаСервереБезКонтекста
Функция ТекстЗапросаОстатков(МетаРег, Организация)
	
	Поля = Новый Массив;
	Для Каждого Изм Из МетаРег.Измерения Цикл
		Поля.Добавить("	Р." + Изм.Имя + " КАК " + Изм.Имя);
	КонецЦикла;
	УсловияНеНоль = Новый Массив;
	Для Каждого Рес Из МетаРег.Ресурсы Цикл
		Поля.Добавить("	Р." + Рес.Имя + "Остаток КАК " + Рес.Имя + "Остаток");
		УсловияНеНоль.Добавить("Р." + Рес.Имя + "Остаток <> 0");
	КонецЦикла;
	
	УсловиеОрг = "";
	Если ЗначениеЗаполнено(Организация) Тогда
		Если МетаРег.Измерения.Найти("Организация") <> Неопределено Тогда
			УсловиеОрг = ", Организация = &Организация";
		ИначеЕсли МетаРег.Измерения.Найти("АналитикаУчетаПоПартнерам") <> Неопределено Тогда
			УсловиеОрг = ", АналитикаУчетаПоПартнерам.Организация = &Организация";
		Иначе
			Сообщить("Регистр """ + МетаРег.Имя + """ не имеет отбора по организации, остатки списываются по всем организациям.");
		КонецЕсли;
	КонецЕсли;
	
	Возврат "ВЫБРАТЬ
	|" + СтрСоединить(Поля, "," + Символы.ПС) + "
	|ИЗ
	|	РегистрНакопления." + МетаРег.Имя + ".Остатки(&Граница" + УсловиеОрг + ") КАК Р
	|ГДЕ
	|	" + СтрСоединить(УсловияНеНоль, " ИЛИ ");
	
КонецФункции

#КонецОбласти
